[Unit]
Description=Stop HDW4S desktops nobody has connected to
Documentation=man:hdw4s(8)

[Service]
ExecStart=/usr/lib/hdw4s/hdw4s reap
Type=oneshot
# This runs every few minutes, because noticing that somebody is connected
# cannot wait for a nightly sample. Left alone, systemd would write three lines
# each time it did -- started, deactivated, finished -- which is several hundred
# a day saying nothing happened, in front of anyone reading the journal for an
# unrelated reason.
#
# Filtering at warning drops those, and the command's ordinary output with them,
# because both are logged as info. What matters opts back in: systemd reads a
# "<N>" prefix on a line as a priority, and "hdw4s reap" writes the few messages
# worth keeping -- that a desktop was stopped, and why -- at warning.
#
# This used to cost the text of an unexpected error, which the shell wrote at
# info and this threshold then discarded -- so a failing run reported that it
# failed and nothing about why. The mitigation offered here was "run it by hand",
# which is exactly what cannot work for an intermittent fault: by hand it
# succeeds. "hdw4s" now reports an unexpected fault at ERROR priority, above this
# threshold, so the diagnosis survives. Do not lower that without raising this.
LogLevelMax=warning
