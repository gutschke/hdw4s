#!/usr/bin/make -f

%:
	dh $@

# The firewall table and the updater timer are the only units the package turns
# on by itself. hdw4s@.service is a template and cannot be enabled without an
# instance name; which accounts get a desktop is the administrator's decision,
# made with "hdw4s enable".
override_dh_installsystemd:
	dh_installsystemd hdw4s-firewall.service
	dh_installsystemd --no-start hdw4s-updater.timer
	dh_installsystemd --no-enable --no-start hdw4s-updater.service
	dh_installsystemd --no-enable --no-start hdw4s@.service
