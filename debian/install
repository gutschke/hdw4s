hdw4s                    usr/lib/hdw4s
hdw4s-session            usr/lib/hdw4s
hdw4s-run-session        usr/lib/hdw4s
hdw4s-firewall           usr/lib/hdw4s
hdw4s-ephemeral-slots    usr/lib/hdw4s
hdw4s-refuse             usr/lib/hdw4s
hdw4s-incarnation        usr/lib/hdw4s
hdw4s-update             usr/lib/hdw4s
hdw4s-wait             usr/lib/hdw4s
# The idle window's grammar. Installed BESIDE the components rather than under
# a library directory, because hdw4s-demux finds it by its own location and
# hdw4s runs it as a command: two callers, one file, and nothing to configure.
hdw4s-duration           usr/lib/hdw4s
hdw4s.xorg.conf          usr/lib/hdw4s
wrappers/*               usr/lib/hdw4s/wrappers
hdw4s.conf               usr/share/hdw4s
dconf/profile            usr/share/hdw4s/dconf
dconf/10-policy          usr/share/hdw4s/dconf
dconf/locks/10-policy    usr/share/hdw4s/dconf/locks
chrome-policies/hdw4s-ephemeral.json  etc/hdw4s/chrome-policies
# Every unit file, by glob. The list this replaces was one of four places that
# each named a subset of the units by hand, and the four disagreed. A glob
# cannot: adding a unit file to the tree is the whole of shipping it.
hdw4s*.service           usr/lib/systemd/system
hdw4s*.socket            usr/lib/systemd/system
hdw4s*.timer             usr/lib/systemd/system
hdw4s*.slice             usr/lib/systemd/system
hdw4s-webroot            usr/lib/hdw4s
hdw4s-gate-index         usr/lib/hdw4s
hdw4s-demux              usr/lib/hdw4s
