hdw4s                    usr/lib/hdw4s
hdw4s-session            usr/lib/hdw4s
hdw4s-run-session        usr/lib/hdw4s
hdw4s-firewall           usr/lib/hdw4s
hdw4s-ephemeral-slots    usr/lib/hdw4s
hdw4s-refuse             usr/lib/hdw4s
hdw4s-teardown           usr/lib/hdw4s
hdw4s-start              usr/lib/hdw4s
hdw4s-incarnation        usr/lib/hdw4s
hdw4s-stream-dir         usr/lib/hdw4s
# Loaded by /opt/selkies/bin/python (not executed), so 0644 and no shebang run.
hdw4s-selkies-webrtc     usr/lib/hdw4s
# The relay's system group. sysusers.d wants a ".conf" name, and debian/install
# cannot rename, so the tree carries it under the name it is installed as.
hdw4s-sysusers.conf      usr/lib/sysusers.d
# The per-session background generator. Shipped rather than kept beside the
# measurements it came from, because the SESSION has to run it at every start:
# a tool that lives only in a private tree is a feature that works on one
# machine. python3 is already a dependency and nothing here renders, so this
# costs no package.
hdw4s-background         usr/lib/hdw4s
hdw4s-update             usr/lib/hdw4s
hdw4s-wait             usr/lib/hdw4s
hdw4s-stage-wait         usr/lib/hdw4s
# hdw4s-duration, the idle window's grammar, is shipped by hdw4s-shared-sweep
# (debian/hdw4s-shared-sweep.install says why); this package depends on it.
hdw4s-template           usr/lib/hdw4s
hdw4s-is-slot            usr/lib/hdw4s
hdw4s-slot-scrub         usr/lib/hdw4s
# /shared's expose step: binds the guarded table where desktops see it, or
# takes it away. Asks hdw4s-shared-sweep --guard; holds no rule of its own.
hdw4s-shared-expose      usr/lib/hdw4s
# The directory desktops bind as /shared, made at every boot. debian/install
# cannot rename, so the tree carries it under the name it is installed as;
# dh_installtmpfiles finds it in the package and adds the boot-time snippet.
hdw4s-tmpfiles.conf      usr/lib/tmpfiles.d
# polkit's vendor directory: a package's own rules live here and go with it.
60-hdw4s-slots.rules     usr/share/polkit-1/rules.d
# Tab completion. debian/install cannot rename, so the tree keeps it in a
# directory of its own under the name bash-completion looks it up by.
bash-completion/hdw4s    usr/share/bash-completion/completions
hdw4s.xorg.conf          usr/lib/hdw4s
wrappers/*               usr/lib/hdw4s/wrappers
hdw4s.conf               usr/share/hdw4s
dconf/profile            usr/share/hdw4s/dconf
dconf/profile-author     usr/share/hdw4s/dconf
dconf/10-policy          usr/share/hdw4s/dconf
dconf/locks/10-policy    usr/share/hdw4s/dconf/locks
dconf/named-lock         usr/share/hdw4s/dconf
dconf/locks/named-lock   usr/share/hdw4s/dconf/locks
chrome-policies/hdw4s-ephemeral.json  etc/hdw4s/chrome-policies
chrome-policies/hdw4s-author.json     etc/hdw4s/chrome-policies
chrome-author-policy.json etc/hdw4s
# Every unit file, by glob. The list this replaces was one of four places that
# each named a subset of the units by hand, and the four disagreed. A glob
# cannot: adding a unit file to the tree is the whole of shipping it.
hdw4s*.service           usr/lib/systemd/system
hdw4s*.socket            usr/lib/systemd/system
hdw4s*.timer             usr/lib/systemd/system
hdw4s*.path              usr/lib/systemd/system
hdw4s*.slice             usr/lib/systemd/system
hdw4s-webroot            usr/lib/hdw4s
hdw4s-gate-index         usr/lib/hdw4s
# How a browser names its desktops. Read, not run, by the two components above
# and below it, which find it beside themselves -- one copy, inlined by both.
hdw4s-names.js           usr/lib/hdw4s
# What the tab strip says on a session page. Read, not run, by hdw4s-gate-index,
# which inlines it into the head of every session page it builds, named or pooled.
hdw4s-title.js           usr/lib/hdw4s
hdw4s-demux              usr/lib/hdw4s
