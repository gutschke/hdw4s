#!/bin/sh
set -e

if [ "$1" = 'configure' ]; then
  # HDW4S_WEBRTC=yes NOW STOPS A SESSION FROM STARTING (hdw4s-run-session says
  # why: Selkies' WebRTC signalling reaches its own server over TCP, which no
  # longer listens there). Said at the upgrade, where an administrator is
  # looking, rather than only at the next start of a desktop.
  for f in /etc/hdw4s/*.conf; do
    [ -f "${f}" ] || continue
    if grep -qs '^[[:space:]]*HDW4S_WEBRTC=["'"'"']\{0,1\}yes' "${f}"; then
      echo "hdw4s: WARNING: ${f} sets HDW4S_WEBRTC=yes. Sessions reading it" >&2
      echo '       will now REFUSE TO START; set HDW4S_WEBRTC=no.' >&2
    fi
  done

  # The relay's system group, before anything below (or debhelper's own start of
  # the slot minter) hands the stream root to it. Idempotent.
  systemd-sysusers hdw4s-sysusers.conf || {
    echo 'hdw4s: could not create the hdw4s-relay group; no desktop can be' >&2
    echo '       reached until "systemd-sysusers" succeeds.' >&2
  }
  # Created here rather than shipped into /etc, because "hdw4s set" edits it.
  # A file dpkg owns and a tool rewrites means an interactive conffile prompt on
  # every upgrade after the first change -- which, in a non-interactive install,
  # is a package that hangs rather than one that asks.
  if [ ! -e /etc/hdw4s/hdw4s.conf ]; then
    mkdir -p /etc/hdw4s
    cp /usr/share/hdw4s/hdw4s.conf /etc/hdw4s/hdw4s.conf
    chmod 0644 /etc/hdw4s/hdw4s.conf
  fi

  # Drop-ins written by an earlier version carry only ReadWritePaths=. The
  # mount ordering used to live in the template unit as RequiresMountsFor=/home
  # and now lives here, per instance, because a home directory is not always
  # under /home -- so without this an upgrade would leave every existing
  # session with no ordering at all, which is worse than the assumption it
  # replaced. Rewriting the drop-in is what "hdw4s enable" already does.
  if [ -r /etc/hdw4s/instances ]; then
    while read -r idx inst; do
      case "${idx}" in ''|\#*) continue;; esac
      d="/etc/systemd/system/hdw4s@${inst}.service.d"
      [ -e "${d}/40-home.conf" ] || continue
      grep -q '^RequiresMountsFor=' "${d}/40-home.conf" && continue
      # An instance is the account name. The strip is for instances named
      # "<user>:<session>" by a version that still created them: this loop runs
      # over what is already installed, so it has to read names this version
      # will not issue.
      user="${inst%%:*}"
      home="$(getent passwd -- "${user}" | cut -d: -f6)"
      [ -n "${home}" ] || continue
      printf '%s\n' \
        '# Written by "hdw4s enable". Re-run it if the home directory moves.' \
        '[Unit]' \
        "RequiresMountsFor=${home}" \
        '' \
        '[Service]' \
        "ReadWritePaths=${home}" \
        > "${d}/40-home.conf"
    done < /etc/hdw4s/instances
    systemctl daemon-reload || :
  fi

  # The relay used to name its session unit itself; it no longer can, because
  # there is more than one kind of session and a template's dependency cannot be
  # overridden by a drop-in. Without this, an upgrade would leave every existing
  # relay with no session dependency at all -- it would start, find nothing
  # listening, and sit in hdw4s-wait until it timed out, which reads as a broken
  # desktop rather than a missing drop-in.
  #
  # An existing file is never overwritten: it may name a unit this loop has no
  # way to work out.
  # BEGIN session-dropin-backfill (.github/tests.sh executes this block verbatim)
  # The two roots are variables so the test can run this against a fixture
  # rather than against a copy of it, which would only ever prove the copy works.
  : "${ETCDIR:=/etc/hdw4s}"
  : "${UNITDIR:=/etc/systemd/system}"
  if [ -r "${ETCDIR}/instances" ]; then
    # The third field is the type. Reading only two of them wrote
    # "Requires=hdw4s@ephemeral0.service" for an ephemeral slot -- a named unit
    # that does not exist -- and the relay then failed every start with
    # "result 'dependency'" while the front door went on listening. A slot that
    # accepts connections and can never serve one is the worst shape available.
    while read -r idx inst type; do
      case "${idx}" in ''|\#*) continue;; esac
      d="${UNITDIR}/hdw4s-proxy@${inst}.service.d"
      [ -d "${d}" ] || continue
      # THE STREAM IS A PATH NOW, NOT A PORT (hdw4s-stream-dir), and the relay
      # template names it. An earlier "hdw4s enable" wrote the port as a drop-in
      # that REPLACES the relay's ExecStart=, so one left in place would put this
      # relay back on TCP -- the squattable shape the move exists to end, with
      # nothing to show it. Removed wherever it names a loopback port; the
      # instance file's HDW4S_PORT line, which nothing reads any more, goes too.
      if grep -qs '^ExecStart=.*systemd-socket-proxyd 127\.0\.0\.1:' "${d}/50-port.conf"; then
        rm -f -- "${d}/50-port.conf"
      fi
      [ ! -f "${ETCDIR}/${inst}.conf" ] ||
        sed -i '/^[[:space:]]*HDW4S_PORT=/d' "${ETCDIR}/${inst}.conf"
      # Both ephemeral-shaped types take the ephemeral unit. The CLI decides this
      # in ephemeral_shaped(); an installer cannot call it -- it may be repairing
      # a tree that has no working hdw4s yet -- so the list is spelled out, and
      # .github/tests.sh compares the two spellings so they cannot drift apart.
      # A "template" row left on the default arm got BindsTo=hdw4s@<inst>, which
      # is a named-desktop unit that will never run an authoring session: the
      # relay listens, every start fails on the dependency, and the front door
      # goes on accepting connections it can never serve.
      # An ephemeral-shaped relay is Requisite= on its session, a named one
      # BindsTo=: see "hdw4s enable". Requisite= starts nothing, so a connection
      # to a pool slot can never start a desktop -- only the router's start
      # request can (hdw4s-start@).
      case "${type}" in
        ephemeral|template) sunit="hdw4s-ephemeral@${inst}.service"; dep='Requisite';;
        *)                  sunit="hdw4s@${inst}.service"; dep='BindsTo';;
      esac
      # Existing drop-ins are migrated, not skipped, because nothing else rewrites
      # the file: "hdw4s enable" is not re-run on a machine that is already
      # enabled. Two older shapes: "Requires=", which does not end a relay whose
      # session EXITS ON ITS OWN (measured HTTP 000 against HTTP 200 with
      # BindsTo=); and, for a pool slot, "BindsTo=", which starts a desktop on
      # every connection. Anything else was written by somebody on purpose.
      if [ -e "${d}/30-session.conf" ]; then
        if ! grep -q '^Requires=' "${d}/30-session.conf" 2>/dev/null; then
          [ "${dep}" = 'Requisite' ] || continue
          grep -q '^BindsTo=' "${d}/30-session.conf" 2>/dev/null || continue
        fi
      fi
      printf '%s\n' \
        '# Written by "hdw4s enable": the session unit behind this relay.' \
        '[Unit]' \
        "${dep}=${sunit}" \
        "After=${sunit}" \
        > "${d}/30-session.conf"
    done < "${ETCDIR}/instances"
  fi
  # END session-dropin-backfill
  systemctl daemon-reload || :

  # The settings layer every ephemeral session starts from. Package-owned and
  # rewritten on every install: the administrator's own additions belong in the
  # hdw4s-template database above these ("hdw4s template edit"), and an upgrade
  # that left a stale lockdown behind would be the kind of difference nobody
  # thinks to look for.
  mkdir -p /etc/dconf/profile /etc/dconf/db/hdw4s-ephemeral.d/locks \
           /etc/dconf/db/hdw4s-template.d
  cp /usr/share/hdw4s/dconf/profile         /etc/dconf/profile/hdw4s-ephemeral
  cp /usr/share/hdw4s/dconf/profile-author  /etc/dconf/profile/hdw4s-author
  cp /usr/share/hdw4s/dconf/10-policy       /etc/dconf/db/hdw4s-ephemeral.d/10-policy
  cp /usr/share/hdw4s/dconf/locks/10-policy /etc/dconf/db/hdw4s-ephemeral.d/locks/10-policy
  # The template's settings half is the ADMINISTRATOR'S, kept with the rest of
  # the template in /var/lib/hdw4s-template; removing the package takes the
  # compiled copy, so reinstalling puts it back.
  if [ -f /var/lib/hdw4s-template/current/dconf/50-template ]; then
    cp /var/lib/hdw4s-template/current/dconf/50-template \
       /etc/dconf/db/hdw4s-template.d/50-template
  fi
  chmod 0644 /etc/dconf/profile/hdw4s-ephemeral /etc/dconf/profile/hdw4s-author \
             /etc/dconf/db/hdw4s-ephemeral.d/10-policy \
             /etc/dconf/db/hdw4s-ephemeral.d/locks/10-policy

  # The mount point the ephemeral unit binds its Chrome policy over. It has to
  # exist or the namespace fails to build, and it has to stay EMPTY: a policy
  # file here would apply to every Chrome on the machine, which is the opposite
  # of what the bind is for. Chrome does not create this directory itself.
  mkdir -p /etc/opt/chrome/policies/managed

  # Compiles the text into the database dconf memory-maps. A missing database is
  # not an error: dconf warns on stderr, exits 0, and falls back to schema
  # defaults -- so this failing has to be said out loud rather than swallowed.
  if command -v dconf >/dev/null 2>&1; then
    dconf update 2>/dev/null || {
      echo 'hdw4s: "dconf update" failed; ephemeral sessions will start from' >&2
      echo '  stock GNOME defaults rather than the shipped policy.' >&2
    }
  else
    echo 'hdw4s: dconf is not installed, so the ephemeral policy database was' >&2
    echo '  not compiled. Install dconf-cli and run "dconf update".' >&2
  fi

  # On an upgrade the firewall unit is already active, and it is Type=oneshot
  # with RemainAfterExit=yes, so debhelper's "start" below is a no-op --
  # deliberately, because --no-stop-on-upgrade is what keeps live sessions from
  # being torn down by a restart. The consequence is that a version shipping a
  # corrected rule would keep the old table until someone rebooted, and the
  # 15-minute check timer cannot help because --restore only acts on a table
  # that is missing entirely. Re-applying is a single delete-and-add in one nft
  # transaction; it does not touch the unit and does not disturb a session.
  if [ -n "$2" ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    if nft list table inet hdw4s >/dev/null 2>&1; then
      /usr/lib/hdw4s/hdw4s-firewall --apply >/dev/null || {
        echo 'hdw4s: could not re-apply the firewall; the table still holds' >&2
        echo '       the previous rules. Run "hdw4s firewall --apply".' >&2
      }
    fi
  fi

  # The ephemeral slots, for exactly the reason spelled out above the firewall.
  #
  # hdw4s-ephemeral-slots.service is Type=oneshot with RemainAfterExit=yes and
  # WantedBy=sysinit.target, so it runs once at boot -- which was written here
  # while debian/rules still passed --no-enable for it, and was therefore false.
  # An [Install] section is inert until enabling creates the wants symlink, so the
  # unit never ran at boot at all, and this block was the only thing that ever ran
  # the minter: a repair that lasted until the next reboot and hid the defect
  # behind itself. The rules file enables it now; this block stays, for the
  # refresh an upgrade needs. debhelper's "start" is a
  # no-op on an upgrade and "restart" is refused outright, because the unit sets
  # RefuseManualStop=yes. Until this was added, everything the minter writes --
  # the userdb records, the namespaced passwd, the drop-ins, and now each slot's
  # gated web client -- kept whatever the running system happened to have.
  #
  # That stopped being cosmetic when the session began to refuse to start
  # without a gated client. An upgrade left every existing slot without one,
  # and every ephemeral desktop was dead until the machine was rebooted --
  # reproduced, not theorised. The minter is idempotent by construction, so
  # running the script directly is the whole fix; it is not the unit, so
  # RefuseManualStop does not apply and no live session is stopped.
  if [ -n "$2" ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    # ENABLE IT HERE TOO, AND THIS IS THE UPGRADE PATH'S OWN DEFECT rather than a
    # belt on the one debian/rules already fastens.
    #
    # dh_installsystemd honours a unit's RECORDED state on upgrade: a unit dpkg
    # last saw disabled stays disabled, deliberately, so that packaging cannot
    # overrule an administrator. That is right in general and wrong here, because
    # the state it is honouring is not an administrator's -- it is OUR OWN, left
    # behind by a build in which this unit was wrongly in the --no-enable list.
    # Those machines never get the symlink, from any later version, for ever.
    #
    # MEASURED ON A PRODUCTION CONTAINER, 2026-09-26, on a machine upgraded from
    # such a build: the unit was "disabled", there was no wants symlink, and
    # "journalctl -b" for it was empty. The first boot after that upgrade came up
    # with ZERO slot identities but the full set of typed rows and doors bound in
    # the kernel -- open doors onto accounts that do not exist -- and with the
    # slice's memory limit at infinity, because this unit is what writes both the
    # userdb records and the drop-in, and both live in tmpfs.
    #
    # THE SHAPE IS WHY IT IS WORTH A LINE HERE: it does not fail at install. The
    # block below runs the script directly, so the pool works immediately and
    # keeps working, and the missing symlink is hidden behind that repair until
    # the machine next reboots -- which may be months, and by then nobody
    # connects the two. It is the same hiding the comment above this one
    # describes, one layer further out.
    #
    # It announces itself rather than acting silently, because it IS overriding a
    # local state: an administrator who disabled this on purpose has to be able
    # to find out that a package turned it back on. "is-enabled" first, so the
    # message appears only where something was actually wrong. Disabling this
    # unit is not the supported way to decline the ephemeral pool -- leaving it
    # off leaves the doors bound and the brake off -- and the supported way is to
    # configure no slots.
    if [ "$(systemctl is-enabled hdw4s-ephemeral-slots.service 2>/dev/null)" \
         = 'disabled' ]; then
      echo 'hdw4s: re-enabling hdw4s-ephemeral-slots.service, which an older' >&2
      echo '       version of this package left disabled. Without it a reboot' >&2
      echo '       brings the machine up with no slot accounts and no memory' >&2
      echo '       limit on the desktop slice.' >&2
      systemctl enable hdw4s-ephemeral-slots.service >/dev/null 2>&1 || {
        echo 'hdw4s: could not enable hdw4s-ephemeral-slots.service. Run' >&2
        echo '       "systemctl enable hdw4s-ephemeral-slots.service".' >&2
      }
    fi
    /usr/lib/hdw4s/hdw4s-ephemeral-slots >/dev/null || {
      echo 'hdw4s: could not refresh the ephemeral slots; existing slots keep' >&2
      echo '       the previous client and may refuse to start. Run' >&2
      echo '       "/usr/lib/hdw4s/hdw4s-ephemeral-slots".' >&2
    }
  fi

  # Move any ephemeral slot this machine already has off TCP.
  #
  # The code change alone does not repair a deployment: "hdw4s enable" writes
  # the listener drop-in once, and nothing re-reads it. So an upgraded machine
  # would keep every slot it already has on a port -- which is the defect, not
  # a leftover. Measured on the test container 2026-09-22: ports 7304 and 7305
  # answered HTTP 200 to an anonymous caller and started a real GNOME session.
  #
  # Only ephemeral rows, and only on an upgrade. A named desktop keeps its
  # transport: its reverse proxy is routinely on another machine, where a
  # filesystem socket cannot be reached, and changing that underneath a running
  # deployment would take somebody's desktop away.
  #
  # Each slot's front door goes down and comes back during this, which for an
  # ephemeral session means the desktop behind it ends -- its home is a tmpfs
  # and goes with it. That is what stopping an ephemeral session always means,
  # and it is the cost of not leaving the port open.
  if [ -n "$2" ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ] &&
     [ -r /etc/hdw4s/instances ]; then
    # The comment marker is in the FIRST field, which is the slot index, so
    # that is the field the skip tests. Reading the type into its own variable
    # rather than letting it land in the name is the shape every other reader
    # of this table uses, and for the same reason.
    while read -r idx inst type; do
      case "${idx}" in ''|\#*) continue;; esac
      # Ephemeral-shaped, not "ephemeral": an authoring session is reachable
      # only through the front door on this machine, so a port serves no caller
      # it has and every caller it must not have.
      case "${type:-desktop}" in ephemeral|template) ;; *) continue;; esac
      if grep -qs '^[[:space:]]*HDW4S_TRANSPORT=.*unix' \
              "/etc/hdw4s/${inst}.conf"; then
        continue
      fi
      hdw4s transport "${inst}" unix >/dev/null || {
        echo "hdw4s: could not move ${inst} off TCP; it is still reachable on" >&2
        echo "       its port. Run \"hdw4s transport ${inst} unix\"." >&2
      }
    done < /etc/hdw4s/instances
  fi

  # A compiled copy of a module that no longer exists.
  #
  # Versions before the 2.0 port shipped hdw4s_signalling.py into this
  # directory, and running it left __pycache__/hdw4s_signalling.cpython-3*.pyc
  # beside it. dpkg removes the .py it owns on upgrade and knows nothing about
  # the .pyc, so the stale bytecode stays -- in the package's own directory,
  # with no owner, for ever. Nothing imports it today, which is exactly why it
  # would go unnoticed until somebody asked whether the installed tree is what
  # was shipped and could not answer.
  #
  # The whole directory goes, not one file: this package ships no Python into
  # /usr/lib/hdw4s and never has, so anything CPython wrote there is a
  # by-product of a module that has since been deleted.
  if [ -n "$2" ] && [ -d /usr/lib/hdw4s/__pycache__ ]; then
    rm -rf /usr/lib/hdw4s/__pycache__
  fi

  # Fetching Selkies, which cannot be done from here.
  #
  # It used to be: the updater built a virtualenv and ran pip, and a maintainer
  # script is allowed to do that. Selkies 2.0 is a .deb, and installing a .deb
  # from inside a maintainer script is not possible -- dpkg is holding both of
  # its own locks for the transaction this script is part of, and a nested dpkg
  # exits 2 with "dpkg frontend lock was locked by another process". Written
  # with "|| :" after it, as the removal in postrm once was, that reads as a
  # success and installs nothing.
  #
  # So the updater is handed to systemd instead, which starts it outside this
  # transaction. It waits for dpkg to let go and then installs. --no-block
  # because the service cannot finish while this script is still running, and
  # daemon-reload first because on a first install the unit has been unpacked
  # but debhelper's own snippet, which reloads systemd, has not run yet.
  #
  # That token is described rather than written out on purpose: dh_installdeb
  # substitutes it wherever it appears, comments included, and the first draft
  # of this comment became the debhelper block followed by four loose words,
  # which dpkg ran and which failed the install with "has: not found".
  if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || :
    if systemctl start --no-block hdw4s-updater.service; then
      echo 'hdw4s: fetching the Selkies streaming server in the background.'
      echo '       Watch it with "journalctl -fu hdw4s-updater.service".'
    else
      echo 'hdw4s: could not start the Selkies updater; the daily timer will' >&2
      echo '       retry. Run "/usr/lib/hdw4s/hdw4s-update" to do it now.' >&2
    fi
  else
    echo 'hdw4s: no systemd here, so Selkies was not fetched. Run'
    echo '       "/usr/lib/hdw4s/hdw4s-update" once the network is up.'
  fi
fi

#DEBHELPER#
