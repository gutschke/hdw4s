#!/bin/sh
set -e

if [ "$1" = 'configure' ]; then
  # Created here rather than shipped into /etc, because "hdw4s set" edits it.
  # A file dpkg owns and a tool rewrites means an interactive conffile prompt on
  # every upgrade after the first change -- which, in a non-interactive install,
  # is a package that hangs rather than one that asks.
  if [ ! -e /etc/hdw4s/hdw4s.conf ]; then
    mkdir -p /etc/hdw4s
    cp /usr/share/hdw4s/hdw4s.conf /etc/hdw4s/hdw4s.conf
    chmod 0644 /etc/hdw4s/hdw4s.conf
  fi

  # Drop-ins written by an earlier version carry only ReadWritePaths=. The
  # mount ordering used to live in the template unit as RequiresMountsFor=/home
  # and now lives here, per instance, because a home directory is not always
  # under /home -- so without this an upgrade would leave every existing
  # session with no ordering at all, which is worse than the assumption it
  # replaced. Rewriting the drop-in is what "hdw4s enable" already does.
  if [ -r /etc/hdw4s/instances ]; then
    while read -r idx inst; do
      case "${idx}" in ''|\#*) continue;; esac
      d="/etc/systemd/system/hdw4s@${inst}.service.d"
      [ -e "${d}/40-home.conf" ] || continue
      grep -q '^RequiresMountsFor=' "${d}/40-home.conf" && continue
      user="${inst%%:*}"
      home="$(getent passwd -- "${user}" | cut -d: -f6)"
      [ -n "${home}" ] || continue
      printf '%s\n' \
        '# Written by "hdw4s enable". Re-run it if the home directory moves.' \
        '[Unit]' \
        "RequiresMountsFor=${home}" \
        '' \
        '[Service]' \
        "ReadWritePaths=${home}" \
        > "${d}/40-home.conf"
    done < /etc/hdw4s/instances
    systemctl daemon-reload || :
  fi

  # Fetching Selkies needs the network, which an installer cannot assume it
  # has, and must not wait on indefinitely if it does not. The timer retries.
  if ! timeout 600 /usr/lib/hdw4s/hdw4s-update; then
    echo 'hdw4s: could not fetch Selkies now; the daily timer will retry.' >&2
    echo '       Run "/usr/lib/hdw4s/hdw4s-update" once the network is up.' >&2
  fi
fi

#DEBHELPER#
