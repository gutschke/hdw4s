#!/bin/sh
set -e

if [ "$1" = 'configure' ]; then
  # Created here rather than shipped into /etc, because "hdw4s set" edits it.
  # A file dpkg owns and a tool rewrites means an interactive conffile prompt on
  # every upgrade after the first change -- which, in a non-interactive install,
  # is a package that hangs rather than one that asks.
  if [ ! -e /etc/hdw4s/hdw4s.conf ]; then
    mkdir -p /etc/hdw4s
    cp /usr/share/hdw4s/hdw4s.conf /etc/hdw4s/hdw4s.conf
    chmod 0644 /etc/hdw4s/hdw4s.conf
  fi

  # Drop-ins written by an earlier version carry only ReadWritePaths=. The
  # mount ordering used to live in the template unit as RequiresMountsFor=/home
  # and now lives here, per instance, because a home directory is not always
  # under /home -- so without this an upgrade would leave every existing
  # session with no ordering at all, which is worse than the assumption it
  # replaced. Rewriting the drop-in is what "hdw4s enable" already does.
  if [ -r /etc/hdw4s/instances ]; then
    while read -r idx inst; do
      case "${idx}" in ''|\#*) continue;; esac
      d="/etc/systemd/system/hdw4s@${inst}.service.d"
      [ -e "${d}/40-home.conf" ] || continue
      grep -q '^RequiresMountsFor=' "${d}/40-home.conf" && continue
      user="${inst%%:*}"
      home="$(getent passwd -- "${user}" | cut -d: -f6)"
      [ -n "${home}" ] || continue
      printf '%s\n' \
        '# Written by "hdw4s enable". Re-run it if the home directory moves.' \
        '[Unit]' \
        "RequiresMountsFor=${home}" \
        '' \
        '[Service]' \
        "ReadWritePaths=${home}" \
        > "${d}/40-home.conf"
    done < /etc/hdw4s/instances
    systemctl daemon-reload || :
  fi

  # On an upgrade the firewall unit is already active, and it is Type=oneshot
  # with RemainAfterExit=yes, so debhelper's "start" below is a no-op --
  # deliberately, because --no-stop-on-upgrade is what keeps live sessions from
  # being torn down by a restart. The consequence is that a version shipping a
  # corrected rule would keep the old table until someone rebooted, and the
  # 15-minute check timer cannot help because --restore only acts on a table
  # that is missing entirely. Re-applying is a single delete-and-add in one nft
  # transaction; it does not touch the unit and does not disturb a session.
  if [ -n "$2" ] && [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    if nft list table inet hdw4s >/dev/null 2>&1; then
      /usr/lib/hdw4s/hdw4s-firewall --apply >/dev/null || {
        echo 'hdw4s: could not re-apply the firewall; the table still holds' >&2
        echo '       the previous rules. Run "hdw4s firewall --apply".' >&2
      }
    fi
  fi

  # A compiled copy of a module that no longer exists.
  #
  # Versions before the 2.0 port shipped hdw4s_signalling.py into this
  # directory, and running it left __pycache__/hdw4s_signalling.cpython-3*.pyc
  # beside it. dpkg removes the .py it owns on upgrade and knows nothing about
  # the .pyc, so the stale bytecode stays -- in the package's own directory,
  # with no owner, for ever. Nothing imports it today, which is exactly why it
  # would go unnoticed until somebody asked whether the installed tree is what
  # was shipped and could not answer.
  #
  # The whole directory goes, not one file: this package ships no Python into
  # /usr/lib/hdw4s and never has, so anything CPython wrote there is a
  # by-product of a module that has since been deleted.
  if [ -n "$2" ] && [ -d /usr/lib/hdw4s/__pycache__ ]; then
    rm -rf /usr/lib/hdw4s/__pycache__
  fi

  # Fetching Selkies, which cannot be done from here.
  #
  # It used to be: the updater built a virtualenv and ran pip, and a maintainer
  # script is allowed to do that. Selkies 2.0 is a .deb, and installing a .deb
  # from inside a maintainer script is not possible -- dpkg is holding both of
  # its own locks for the transaction this script is part of, and a nested dpkg
  # exits 2 with "dpkg frontend lock was locked by another process". Written
  # with "|| :" after it, as the removal in postrm once was, that reads as a
  # success and installs nothing.
  #
  # So the updater is handed to systemd instead, which starts it outside this
  # transaction. It waits for dpkg to let go and then installs. --no-block
  # because the service cannot finish while this script is still running, and
  # daemon-reload first because on a first install the unit has been unpacked
  # but debhelper's own snippet, which reloads systemd, has not run yet.
  #
  # That token is described rather than written out on purpose: dh_installdeb
  # substitutes it wherever it appears, comments included, and the first draft
  # of this comment became the debhelper block followed by four loose words,
  # which dpkg ran and which failed the install with "has: not found".
  if [ -z "${DPKG_ROOT:-}" ] && [ -d /run/systemd/system ]; then
    systemctl daemon-reload || :
    if systemctl start --no-block hdw4s-updater.service; then
      echo 'hdw4s: fetching the Selkies streaming server in the background.'
      echo '       Watch it with "journalctl -fu hdw4s-updater.service".'
    else
      echo 'hdw4s: could not start the Selkies updater; the daily timer will' >&2
      echo '       retry. Run "/usr/lib/hdw4s/hdw4s-update" to do it now.' >&2
    fi
  else
    echo 'hdw4s: no systemd here, so Selkies was not fetched. Run'
    echo '       "/usr/lib/hdw4s/hdw4s-update" once the network is up.'
  fi
fi

#DEBHELPER#
