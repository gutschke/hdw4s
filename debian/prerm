#!/bin/sh
set -e

# dh_installsystemd stops only the units it knows by name, which are the static
# ones. The instances -- hdw4s@<name>.service and their relay sockets -- are
# left running with their unit files deleted underneath them, so the sockets go
# on holding the public ports open with nothing behind them.
if [ "$1" = 'remove' ] || [ "$1" = 'upgrade' ]; then
  for u in $(systemctl list-units --plain --no-legend 'hdw4s-proxy@*' 2>/dev/null |
             awk '{print $1}'); do
    systemctl stop "${u}" >/dev/null 2>&1 || :
  done
fi
if [ "$1" = 'remove' ]; then
  for u in $(systemctl list-units --plain --no-legend 'hdw4s@*' 2>/dev/null |
             awk '{print $1}'); do
    systemctl stop "${u}" >/dev/null 2>&1 || :
  done
fi

#DEBHELPER#
