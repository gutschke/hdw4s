#!/bin/sh
set -e

# The port reservation is ours and is meaningless once the package is gone, so
# it goes on plain remove rather than waiting for a purge that may never come.
if [ "$1" = 'remove' ] || [ "$1" = 'purge' ]; then
  # Bytecode left by a module an older version shipped here. dpkg has removed
  # its own files by the time this runs, so without this the directory survives
  # the removal and keeps /usr/lib/hdw4s alive around it. See the longer note
  # in postinst.
  rm -rf /usr/lib/hdw4s/__pycache__
  rmdir --ignore-fail-on-non-empty /usr/lib/hdw4s 2>/dev/null || true

  if [ -e /etc/sysctl.d/60-hdw4s.conf ]; then
    rm -f /etc/sysctl.d/60-hdw4s.conf
    sysctl -q --system 2>/dev/null || :
  fi
fi

if [ "$1" = 'purge' ]; then
  rm -f /etc/hdw4s/nftables.conf
  # Session slots, per-session overrides and the desktop profiles are the
  # administrator's configuration and the users' state. Purge removes ours.
  rm -f /etc/hdw4s/instances /etc/hdw4s/hdw4s.conf
  # Per-instance overrides, and the credentials sealed to this machine. Leaving
  # the credentials contradicted the sentence above, and leaving the drop-ins
  # meant a reinstall came back up with stale User= and port assignments
  # attached to slots that had been handed out again in the meantime.
  rm -rf /etc/hdw4s/*.conf /etc/hdw4s/*.cred
  rm -rf /etc/systemd/system/hdw4s@*.service.d \
         /etc/systemd/system/hdw4s-proxy@*.service.d \
         /etc/systemd/system/hdw4s-proxy@*.socket.d
  rm -f /etc/systemd/system/sockets.target.wants/hdw4s-proxy@*.socket
  rmdir --ignore-fail-on-non-empty /etc/hdw4s 2>/dev/null || true
  # The streaming server is a separate package now, and this cannot remove it.
  #
  # A maintainer script runs inside dpkg, which is holding both of its own
  # locks, so a nested "dpkg -P selkies" cannot run: it exits 2 with "dpkg
  # frontend lock was locked by another process". The version of this file that
  # tried it wrote "|| :" after the call, so purging hdw4s reported success,
  # said nothing, and left the package exactly where it was -- a removal that
  # silently did not happen, which is worse than one that never claimed to.
  #
  # Removing /opt/selkies with rm is not the alternative. dpkg owns every file
  # under that prefix and would go on believing 153MB of them were present.
  # So say what is left and who has to remove it.
  if command -v dpkg-query >/dev/null 2>&1 &&
     dpkg-query -W -f='${Status}' selkies 2>/dev/null |
       grep -q 'install ok installed'; then
    echo 'hdw4s: the Selkies streaming server is a separate package and is'
    echo '       still installed. Remove it with "apt-get purge selkies".'
  fi

  # These are ours. /opt/gst-web is the browser client an hdw4s before 2.0
  # unpacked, /opt/selkies.pre-2.0 is a virtualenv the updater moved aside
  # during the migration, and /var/lib/hdw4s/selkies is the .deb it keeps so an
  # upgrade has something to roll back to. None of them has another owner.
  rm -rf /opt/gst-web /opt/gst-web.bak /opt/selkies.bak /opt/selkies.pre-2.0
  rm -rf /var/lib/hdw4s/selkies
  echo 'hdw4s: /var/lib/hdw4s still holds each session profile; remove it by'
  echo '       hand if those desktops are not wanted again.'
fi

#DEBHELPER#
