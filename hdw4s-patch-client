# ------------------------------------------------------- cache invalidation

TS_RE = re.compile(r"\?ts=([0-9]+)(?:-hdw4s[0-9]+)?")
CACHEVER_RE = re.compile(r'(cacheVersion\s*=\s*")([0-9]+)(?:-hdw4s[0-9]+)?(")')


def _suffix(m, groups):
    """Rewrite a frozen build token so caches treat the patched files as new."""
    if groups == "ts":
        return "?ts=%s-hdw4s%d" % (m.group(1), PATCH_REVISION)
    return "%s%s-hdw4s%d%s" % (m.group(1), m.group(2), PATCH_REVISION, m.group(3))


def retoken(src, name):
    if name == "sw.js":
        src = CACHEVER_RE.sub(lambda m: _suffix(m, "ver"), src)
    return TS_RE.sub(lambda m: _suffix(m, "ts"), src)


def _has_token(src, name):
    """Is there anything here we recognise as a build token?"""
    if TS_RE.search(src):
        return True
    return name == "sw.js" and CACHEVER_RE.search(src) is not None


def _needs_retoken(src, name):
    """Does this file still carry a build token we have not stamped?

    A file with no recognisable token at all is not "already stamped" -- it is a
    file we no longer understand, and saying otherwise would report the cache
    bust as done while it had silently done nothing. That is the one drift in
    this patcher that would not announce itself, so it returns True and lets the
    caller treat it as a mismatch.
    """
    want = "-hdw4s%d" % PATCH_REVISION
    found = 0
    for m in TS_RE.finditer(src):
        found += 1
        if not m.group(0).endswith(want):
            return True
    if name == "sw.js":
        for m in CACHEVER_RE.finditer(src):
            found += 1
            if not m.group(0).rstrip('"').endswith(want):
                return True
    # A file with no token at all is caught by _has_token before reaching here.
    return False


# ------------------------------------------------------------------ driving

# app.js is here because line 27 registers the service worker by URL, and a
# worker is only re-fetched when its registration URL changes. Miss this and an
# installed app keeps the old worker, and with it the old cached scripts,
# indefinitely.
TOKEN_FILES = ("index.html", "sw.js", "app.js")
BACKUP_SUFFIX = ".pre-handover"


def _state_of(root, name, edits):
    path = os.path.join(root, name)
    if not os.path.isfile(path):
        return "missing", None
    src = _read(path)
    if name in TOKEN_FILES and not _has_token(src, name):
        # Nothing here looks like a build token any more. Re-tokening would do
        # nothing and report success, which would leave the cache bust silently
        # undone -- and the cache bust is the difference between this patch
        # landing on disk and reaching a browser at all.
        return "mismatch", src
    if edits is None:
        # A file we only re-token (sw.js): there is no marker to look for, so
        # the token itself is the evidence.
        return ("patched" if not _needs_retoken(src, name) else "applicable"), src
    if MARKER in src:
        return ("patched" if not _needs_retoken(src, name) else "applicable"), src
    if any(src.count(old) != 1 for _, old, _ in edits):
        return "mismatch", src
    return "applicable", src


def analyse(root):
    """One verdict for the whole client.

    'partial' matters: a tree where one file is patched and another is not is
    not merely unfinished, it is worse than either end state -- a patched
    signalling.js against a stock app.js leaves onbusy unset, so a refusal
    returns without reconnecting and the page hangs with no UI at all.
    """
    seen = {}
    for name, edits in FILES:
        seen[name] = _state_of(root, name, edits)[0]
    for name in TOKEN_FILES:
        if name not in seen:
            seen[name] = _state_of(root, name, None)[0]
    values = set(seen.values())
    if "missing" in values or "mismatch" in values:
        return "mismatch", seen
    if values == {"patched"}:
        return "patched", seen
    if "patched" in values:
        return "partial", seen
    return "applicable", seen


def _read(path):
    """Always UTF-8. The client files carry non-ASCII, and relying on the
    locale means the updater's own LC_ALL=C decides whether they survive."""
    with open(path, "r", encoding="utf-8") as fh:
        return fh.read()


def _write_atomic(path, text):
    """Write via a temporary file and rename, so an interrupted run never
    leaves a half-written webroot that the next run would mark as patched."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".hdw4s-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            os.fsync(fh.fileno())
        shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise


def _validate(name, text, original):
    """Cheap integrity floor, before anything is written.

    Pattern presence is not integrity: a truncated file can still hold one copy
    of each anchor, and the next run would then see its marker and call it
    patched forever.

    Two properties, both relative to the text we started from. Size, because
    every edit here adds; and bracket balance for JavaScript, because an
    unbalanced brace is the mistake a hand-written fragment actually makes.
    Balance is checked as a *change* rather than as an absolute: a minified or
    differently-quoted file can be unbalanced by literal braces inside strings,
    and demanding balance outright would refuse to patch it at all. An HTML
    clause was tried and dropped -- counting tags caught none of 99 truncations,
    which is worse than no check because it reads like one.
    """
    if len(text) < len(original) * 0.9:
        return False
    if name.endswith(".js"):
        for opener, closer in (("{", "}"), ("(", ")"), ("[", "]")):
            if (text.count(opener) - text.count(closer)
                    != original.count(opener) - original.count(closer)):
                return False
    return True


def patch(root):
    """Build every file first, then swap them in. Nothing is written until all
    of them are ready, so an error part way through leaves the tree alone."""
    staged = {}
    originals = {}
    for name, edits in FILES:
        path = os.path.join(root, name)
        src = _read(path)
        originals[name] = src
        if MARKER not in src:
            for _, old, new in edits:
                src = src.replace(old, new)
        staged[name] = src
    for name in TOKEN_FILES:
        path = os.path.join(root, name)
        if not os.path.isfile(path):
            continue
        src = staged.get(name)
        if src is None:
            src = _read(path)
        originals.setdefault(name, src)
        staged[name] = retoken(src, name)

    for name, text in staged.items():
        if not _validate(name, text, originals[name]):
            print("  refusing to write %s: failed a sanity check" % name)
            return 1

    for name, text in staged.items():
        path = os.path.join(root, name)
        backup = path + BACKUP_SUFFIX
        if not os.path.exists(backup):
            shutil.copyfile(path, backup)
        _write_atomic(path, text)
        print("  patched %s" % name)
    return 0


def revert(root):
    """Put back what was there before, and leave nothing behind.

    The backups are removed as they are used: they sit inside a directory that
    is served to browsers, and a revert that leaves four copies of the client
    lying there has not put the tree back, however identical the files it did
    restore.
    """
    restored = 0
    for name in set([n for n, _ in FILES] + list(TOKEN_FILES)):
        path = os.path.join(root, name)
        backup = path + BACKUP_SUFFIX
        if os.path.isfile(backup):
            shutil.copyfile(backup, path)
            os.unlink(backup)
            restored += 1
            print("  restored %s" % name)
    if not restored:
        print("  nothing to revert: no saved originals")
        return 1
    return 0


USAGE = """usage: hdw4s-patch-client [--check|--revert] WEBROOT

  (no flag)  apply the session hand-over patch, if it applies cleanly
  --check    print patched / applicable / partial / mismatch and say no more
  --revert   restore the files saved before the patch was applied
"""

KNOWN_FLAGS = ("--check", "--revert")


def main(argv):
    # An unknown flag must not fall through to patching. This program's whole
    # job is not touching things it should not, and a typo'd --chek reaching
    # the apply path is the opposite of that.
    unknown = [a for a in argv if a.startswith("--") and a not in KNOWN_FLAGS]
    paths = [a for a in argv if not a.startswith("--")]
    if unknown or len(paths) != 1:
        if unknown:
            print("unrecognised option: %s" % " ".join(unknown))
        sys.stdout.write(USAGE)
        return 2
    root = paths[0]
    if not os.path.isdir(root):
        print("no such webroot: %s" % root)
        return 2
    state, detail = analyse(root)
    if "--check" in argv:
        print(state)
        for name in sorted(detail):
            print("  %-16s %s" % (name, detail[name]))
        return 0 if state in ("patched", "applicable") else 1
    if "--revert" in argv:
        return revert(root)
    if state == "mismatch":
        print("  skipping: client source does not match")
        return 0
    if state == "patched":
        print("  already patched; nothing to do")
        return 0
    return patch(root)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
