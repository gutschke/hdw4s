# ------------------------------------------------------- cache invalidation

TS_RE = re.compile(r"\?ts=([0-9]+)(?:-hdw4s[0-9]+)?")
CACHEVER_RE = re.compile(r'(cacheVersion\s*=\s*")([0-9]+)(?:-hdw4s[0-9]+)?(")')


def _suffix(m, groups):
    """Rewrite a frozen build token so caches treat the patched files as new."""
    if groups == "ts":
        return "?ts=%s-hdw4s%d" % (m.group(1), PATCH_REVISION)
    return "%s%s-hdw4s%d%s" % (m.group(1), m.group(2), PATCH_REVISION, m.group(3))


def retoken(src, name):
    if name == "sw.js":
        src = CACHEVER_RE.sub(lambda m: _suffix(m, "ver"), src)
    return TS_RE.sub(lambda m: _suffix(m, "ts"), src)


def _installed_revision(src):
    """Which revision of this patch the file carries, if any."""
    m = VERSION_RE.search(src)
    return int(m.group(1)) if m else None


def _recorded_original(src):
    """The digest of the file this one replaced, as recorded when it was
    patched."""
    m = VERSION_RE.search(src)
    return m.group(2) if m else None


def _sentinels(name):
    """One distinctive line from each edit, so every edit is accounted for.

    The hand-written EVIDENCE below is per *file*, and several edits to the same
    file contribute overlapping words -- so deleting a whole replacement left
    every listed token still present, and the file still read as patched. These
    are derived from the edits themselves, so they cannot drift out of step with
    them, and an edit that is removed takes its own evidence with it.
    """
    edits = dict(FILES).get(name) or ()
    # All the lines each edit adds, longest first so the most distinctive is
    # preferred.
    candidates = []
    for _label, old_text, new_text in edits:
        old_lines = set(old_text.split("\n"))
        added = [l.strip() for l in new_text.split("\n")
                 if len(l.strip()) > 12 and l not in old_lines]
        candidates.append(sorted(added, key=len, reverse=True))
    # Assign each edit a line no other edit also adds. Several edits here say
    # the same short thing -- "see above", a section banner -- and picking one
    # of those would let a deleted edit go unnoticed, because a sibling still
    # supplies the token.
    shared = set()
    seen = set()
    for added in candidates:
        for line in added:
            if line in seen:
                shared.add(line)
            seen.add(line)
    found, used = [], set()
    for added in candidates:
        pick = next((l for l in added if l not in shared and l not in used), None)
        if pick is None:
            pick = next((l for l in added if l not in used), None)
        if pick is None:
            pick = added[0] if added else None
        if pick is not None:
            used.add(pick)
            found.append(pick)
    return found


def _evidence_present(src, name):
    if not all(token in src for token in EVIDENCE.get(name, ())):
        return False
    return all(token in src for token in _sentinels(name))


def _stamp(name, body, original):
    """Append the stamp, naming both what was replaced and what this now is."""
    orig = hashlib.sha256(original.encode("utf-8")).hexdigest()
    stamped = body.rstrip("\n").rstrip() + "\n"
    mine = hashlib.sha256(stamped.encode("utf-8")).hexdigest()
    tag = "%s v%d orig:%s body:%s" % (VERSION_TAG, PATCH_REVISION, orig, mine)
    line = ("<!-- %s -->\n" % tag) if name.endswith(".html") else ("// %s\n" % tag)
    return stamped + line


def _strip_marker(src):
    """The file without its stamp, which is what the stamp is a digest of.

    Whole lines, not just the matched text: removing only the match left the
    comment syntax around it behind, so the file never hashed back to what was
    recorded and every patched tree read as damaged.
    """
    kept = [line for line in src.split("\n") if VERSION_TAG not in line]
    return "\n".join(kept).rstrip("\n").rstrip() + "\n"


def _body_matches(src):
    """Is this file exactly what we would have produced?

    The evidence tokens say the right words appear somewhere; this says the
    bytes are ours. It is the difference between a tree that looks patched and
    one that is, and it is what makes an accidental collision with upstream
    text impossible rather than merely unlikely.
    """
    m = VERSION_RE.search(src)
    if m is None:
        return False
    return hashlib.sha256(_strip_marker(src).encode("utf-8")).hexdigest() == m.group(3)




def _has_token(src, name):
    """Is there anything here we recognise as a build token?"""
    if TS_RE.search(src):
        return True
    return name == "sw.js" and CACHEVER_RE.search(src) is not None


def _needs_retoken(src, name):
    """Does this file still carry a build token we have not stamped?

    A file with no recognisable token at all is not "already stamped" -- it is a
    file we no longer understand, and saying otherwise would report the cache
    bust as done while it had silently done nothing. That is the one drift in
    this patcher that would not announce itself, so it returns True and lets the
    caller treat it as a mismatch.
    """
    want = "-hdw4s%d" % PATCH_REVISION
    found = 0
    for m in TS_RE.finditer(src):
        found += 1
        if not m.group(0).endswith(want):
            return True
    if name == "sw.js":
        for m in CACHEVER_RE.finditer(src):
            found += 1
            if not m.group(0).rstrip('"').endswith(want):
                return True
    # A file with no token at all is caught by _has_token before reaching here.
    return False


# ------------------------------------------------------------------ driving

# app.js is here because line 27 registers the service worker by URL, and a
# worker is only re-fetched when its registration URL changes. Miss this and an
# installed app keeps the old worker, and with it the old cached scripts,
# indefinitely.
TOKEN_FILES = ("index.html", "sw.js", "app.js")
BACKUP_SUFFIX = ".pre-handover"

# Kept outside the webroot. Left inside it, every applied patch parked a
# world-readable copy of the stock client in a directory served to browsers,
# and only --revert ever cleared them. Outside, they also survive the webroot
# being replaced wholesale on upgrade -- which is safe because the digest the
# patched file records is what decides whether a backup may be used, not where
# it came from.
BACKUP_DIR = os.environ.get("HDW4S_HANDOVER_BACKUPS", "/var/lib/hdw4s/handover")

# Written by --revert, and honoured by the updater. Without it a rollback lasts
# until the updater next runs, which is at most a day: the files go back, the
# tree reads as applicable again, and the patch is re-applied. Somebody reverting
# at two in the morning would find it back by breakfast with nothing to say why.
# Kept outside the webroot because the webroot is replaced wholesale on upgrade.
DISABLE_MARKER = os.environ.get("HDW4S_HANDOVER_OFF", "/etc/hdw4s/handover.off")


def _state_of(root, name, edits):
    path = os.path.join(root, name)
    if not os.path.isfile(path):
        return "missing", None
    src = _read(path)
    if name in TOKEN_FILES and not _has_token(src, name):
        # Nothing here looks like a build token any more. Re-tokening would do
        # nothing and report success, which would leave the cache bust silently
        # undone -- and the cache bust is the difference between this patch
        # landing on disk and reaching a browser at all.
        return "mismatch", src

    rev = _installed_revision(src)
    if rev is not None:
        if rev != PATCH_REVISION or not _evidence_present(src, name):
            # Either an older revision of this patch, or a file stamped as
            # patched that does not actually contain the patch. Both need the
            # stock file back before anything is applied to it -- so this is
            # only repairable if there is a usable original to start from.
            # Without one it is not stale, it is a tree we cannot work with,
            # and saying so stops the updater retrying it every day and
            # reporting a reason that is not the real one.
            if stock_from_backup(root, name)[0] is None:
                return "mismatch", src
            return "stale", src
        if not _body_matches(src):
            # Stamped, current revision, right words present -- and not the
            # bytes we produce. Something edited it afterwards, or the stamp was
            # copied onto something else.
            if stock_from_backup(root, name)[0] is None:
                return "mismatch", src
            return "stale", src
        return ("patched" if not _needs_retoken(src, name) else "applicable"), src

    if edits is None:
        return "applicable", src
    if any(src.count(old) != 1 for _, old, _ in edits):
        return "mismatch", src
    return "applicable", src


def _is_backup_source(src, name):
    """Is this file safe to save as the way back?

    Being unstamped is not enough. A patched file that has lost its stamp is
    unstamped too, and saving that over a good backup replaces the way back
    with a copy of the thing being reverted -- silently, because the digest the
    patched file records would then match the damaged backup and the rollback
    would report success.

    A genuinely untouched file still carries its original build token, so a file
    that has already been re-tokenised is not one to save. Files with edits are
    covered by their anchors, which a patched file no longer matches.
    """
    if _installed_revision(src) is not None:
        return False
    if name in TOKEN_FILES and not _needs_retoken(src, name):
        return False
    return True


def _backup_path(root, name):
    del root                      # kept for symmetry with the callers
    return os.path.join(BACKUP_DIR, name + BACKUP_SUFFIX)


def stock_from_backup(root, name):
    """The saved original for a file, if there is one that can be trusted.

    Returns (content, None) or (None, reason). Both the repair path and the
    rollback path go through here: they ask the same question, and answering it
    twice is how one of them ends up trusting a backup the other would refuse.
    """
    path = os.path.join(root, name)
    backup = _backup_path(root, name)
    if not os.path.isfile(backup):
        return None, "no saved original"
    stock = _read(backup)
    if _installed_revision(stock) is not None:
        return None, "it is a copy of a patched file"
    recorded = _recorded_original(_read(path)) if os.path.isfile(path) else None
    if recorded is not None:
        if hashlib.sha256(stock.encode("utf-8")).hexdigest() != recorded:
            return None, "it is not the file that was replaced"
    else:
        # No digest to check against means the patched file is gone or damaged.
        # The anchor check that used to stand in here accepts the exact
        # truncation it was added to catch, because every anchor sits in the
        # first two thirds of the file.
        return None, "there is no record of what it should be"
    return stock, None




def _all_files():
    """Every file this touches, with the edits for it if it has any.

    sw.js is only re-tokenised, so it appears with no edits -- but it still
    needs a stamp and a backup like the rest, and leaving it out of one of the
    three loops that walk this list is how it ended up ungated.
    """
    named = dict(FILES)
    return list(FILES) + [(n, None) for n in TOKEN_FILES if n not in named]


def analyse(root):
    """One verdict for the whole client.

    'partial' matters: a tree where one file is patched and another is not is
    not merely unfinished, it is worse than either end state -- a patched
    signalling.js against a stock app.js leaves onbusy unset, so a refusal
    returns without reconnecting and the page hangs with no UI at all.
    """
    seen = {}
    for name, edits in _all_files():
        seen[name] = _state_of(root, name, edits)[0]
    values = set(seen.values())
    if "missing" in values or "mismatch" in values:
        return "mismatch", seen
    if "stale" in values:
        return "stale", seen
    if values == {"patched"}:
        return "patched", seen
    if "patched" in values:
        return "partial", seen
    return "applicable", seen


def _read(path):
    """Always UTF-8. The client files carry non-ASCII, and relying on the
    locale means the updater's own LC_ALL=C decides whether they survive."""
    with open(path, "r", encoding="utf-8") as fh:
        return fh.read()


def _write_atomic(path, text):
    """Write via a temporary file and rename, so an interrupted run never
    leaves a half-written webroot that the next run would mark as patched."""
    d = os.path.dirname(path) or "."
    fd, tmp = tempfile.mkstemp(dir=d, prefix=".hdw4s-", suffix=".tmp")
    try:
        with os.fdopen(fd, "w", encoding="utf-8") as fh:
            fh.write(text)
            fh.flush()
            # The rename below is atomic, but only orders against data that has
            # reached the disk. Without this a crash can leave the new name
            # pointing at an empty file -- which for a backup means the rollback
            # installs nothing.
            os.fsync(fh.fileno())
        if os.path.exists(path):
            shutil.copymode(path, tmp)
        os.replace(tmp, path)
    except Exception:
        try: os.unlink(tmp)
        except OSError: pass
        raise


def _validate(name, text, original):
    """Cheap integrity floor, before anything is written.

    Pattern presence is not integrity: a truncated file can still hold one copy
    of each anchor, and the next run would then see its marker and call it
    patched forever.

    Two properties, both relative to the text we started from. Size, because
    every edit here adds; and bracket balance for JavaScript, because an
    unbalanced brace is the mistake a hand-written fragment actually makes.
    Balance is checked as a *change* rather than as an absolute: a minified or
    differently-quoted file can be unbalanced by literal braces inside strings,
    and demanding balance outright would refuse to patch it at all. An HTML
    clause was tried and dropped -- counting tags caught none of 99 truncations,
    which is worse than no check because it reads like one.
    """
    if len(text) < len(original) * 0.9:
        return False
    if name.endswith(".js"):
        for opener, closer in (("{", "}"), ("(", ")"), ("[", "]")):
            if (text.count(opener) - text.count(closer)
                    != original.count(opener) - original.count(closer)):
                return False
    return True


def patch(root):
    """Build every file first, then swap them in.

    Nothing is written until all of them are ready, so an error part way
    through leaves the tree as it was.
    """
    # A file carrying an older revision, or stamped as patched without actually
    # containing the patch, has to go back to stock before anything is applied
    # to it. Editing on top would layer one revision over another; skipping it
    # is what shipped new URLs pointing at old code.
    for name, edits in _all_files():
        path = os.path.join(root, name)
        if not os.path.isfile(path):
            continue
        state, _src = _state_of(root, name, edits)
        if state != "stale":
            continue
        stock, why = stock_from_backup(root, name)
        if stock is None:
            print("  cannot refresh %s: %s" % (name, why), file=sys.stderr)
            return 1
        _write_atomic(path, stock)
        print("  restored %s to stock before re-applying" % name)

    staged = {}
    originals = {}
    for name, edits in FILES:
        path = os.path.join(root, name)
        src = _read(path)
        originals[name] = src
        if _installed_revision(src) is None:
            for _, old, new_text in edits:
                src = src.replace(old, new_text)
        staged[name] = src
    for name in TOKEN_FILES:
        path = os.path.join(root, name)
        if not os.path.isfile(path):
            continue
        src = staged.get(name)
        if src is None:
            src = _read(path)
        originals.setdefault(name, src)
        staged[name] = retoken(src, name)

    for name in list(staged):
        if _installed_revision(staged[name]) is None:
            staged[name] = _stamp(name, staged[name], originals[name])

    for name, text in staged.items():
        if not _validate(name, text, originals[name]):
            print("  refusing to write %s: failed a sanity check" % name,
                  file=sys.stderr)
            return 1
        if not _evidence_present(text, name):
            # The stamp would otherwise say patched over a file the edits did
            # not reach, which reads as healthy for ever.
            print("  refusing to write %s: the edits did not take" % name,
                  file=sys.stderr)
            return 1

    # Backups before contents, and only ever taken from a stock file: a backup
    # written from an already-patched one is not a way back. Atomically, because
    # a truncated backup is worse than none -- it reports success and then
    # installs a broken client when it is used.
    try:
        os.makedirs(BACKUP_DIR, exist_ok=True)
    except OSError as exc:
        # Without somewhere to put the way back, applying would leave a tree
        # that cannot be rolled back. Refusing is the safer half of that choice.
        print("  cannot write backups to %s (%s); nothing was changed."
              % (BACKUP_DIR, exc), file=sys.stderr)
        return 1
    for name in staged:
        if _is_backup_source(originals[name], name):
            _write_atomic(_backup_path(root, name), originals[name])

    for name, text in staged.items():
        _write_atomic(os.path.join(root, name), text)
        print("  patched %s" % name)
    # Applying deliberately overrides an earlier rollback; leaving the marker
    # would say hand-over is off while it is plainly on.
    try:
        os.unlink(DISABLE_MARKER)
    except OSError:
        pass
    return 0


def revert(root):
    """Put back what was there before, and leave nothing behind.

    Backups are removed as they are used, and the switch that keeps the updater
    from re-applying is written last -- so a rollback that could not be made to
    stick is reported as a failure rather than as a success that quietly comes
    undone at the next timer run.
    """
    restored = []
    for name in sorted(set([n for n, _ in FILES] + list(TOKEN_FILES))):
        path = os.path.join(root, name)
        patched = os.path.isfile(path) and _installed_revision(_read(path)) is not None
        if not os.path.isfile(_backup_path(root, name)):
            if patched:
                # Skipping this left three files restored and one still patched
                # -- a client with no working screen -- and reported success.
                print("  refusing: %s is patched and has no saved original."
                      % name, file=sys.stderr)
                print("  nothing was changed.", file=sys.stderr)
                return 1
            continue
        stock, why = stock_from_backup(root, name)
        if stock is None:
            print("  refusing %s: %s" % (name, why), file=sys.stderr)
            print("  nothing was changed.", file=sys.stderr)
            return 1
        restored.append((name, stock))

    if not restored:
        print("  nothing to revert: no saved originals")
        return 1

    # Every file is checked before any of them is written, so a bad backup
    # among them leaves the tree as it was rather than half rolled back.
    for name, stock in restored:
        _write_atomic(os.path.join(root, name), stock)
        os.unlink(_backup_path(root, name))
        print("  restored %s" % name)

    try:
        os.makedirs(os.path.dirname(DISABLE_MARKER), exist_ok=True)
        with open(DISABLE_MARKER, "w", encoding="utf-8") as fh:
            fh.write("Session hand-over was rolled back by hdw4s-patch-client.\n"
                     "Delete this file to let the updater apply it again.\n")
        print("  session hand-over will stay off; delete %s to allow it again"
              % DISABLE_MARKER)
    except OSError as exc:
        # The files are back, which is the part that mattered. Say plainly that
        # only the switch failed, rather than reporting the whole rollback as a
        # failure over a tree that is already stock.
        print("  the client is rolled back, but %s could not be written (%s)."
              % (DISABLE_MARKER, exc))
        print("  The updater will apply it again within a day unless that file"
              " exists.")
        return 1
    return 0


USAGE = """usage: hdw4s-patch-client [--check|--revert] WEBROOT

  (no flag)  apply the session hand-over patch, if it applies cleanly
  --check    print the tree's state and say no more:
               patched     the current revision is installed
               applicable  it can be installed
               partial     some files are patched and some are not
               stale       an older revision, or a stamp over files the edits
                           did not reach; re-applying repairs it
               mismatch    the client is not what this patch was written for
  --revert   restore the files saved before the patch was applied
"""

KNOWN_FLAGS = ("--check", "--revert")


def main(argv):
    # An unknown flag must not fall through to patching. This program's whole
    # job is not touching things it should not, and a typo'd --chek reaching
    # the apply path is the opposite of that.
    unknown = [a for a in argv if a.startswith("--") and a not in KNOWN_FLAGS]
    paths = [a for a in argv if not a.startswith("--")]
    if unknown or len(paths) != 1:
        if unknown:
            print("unrecognised option: %s" % " ".join(unknown))
        sys.stdout.write(USAGE)
        return 2
    root = paths[0]
    if not os.path.isdir(root):
        print("no such webroot: %s" % root)
        return 2
    state, detail = analyse(root)
    disabled = os.path.exists(DISABLE_MARKER)
    if "--check" in argv:
        # Two separate facts. Reporting only the marker said "disabled" over a
        # tree that was fully patched and being served, which is the same shape
        # of contradiction as claiming hand-over active for a client that could
        # not ask for it.
        print(state)
        if disabled:
            print("disabled")
        for name in sorted(detail):
            print("  %-16s %s" % (name, detail[name]))
        return 0 if state in ("patched", "applicable", "partial", "stale") else 1
    if "--revert" in argv:
        return revert(root)
    if disabled:
        # The marker means hand-over should not be installed. A patched tree
        # with the marker present is not "off", so make it so -- otherwise
        # creating the file by hand, which is what its own message invites,
        # would turn nothing off.
        if state in ("patched", "partial", "stale"):
            print("  hand-over is switched off; rolling the client back")
            return revert(root)
        print("  hand-over is switched off by %s; nothing to do" % DISABLE_MARKER)
        return 0
    if state == "mismatch":
        print("  skipping: client source does not match")
        return 0
    if state == "patched":
        print("  already patched; nothing to do")
        return 0
    return patch(root)


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
