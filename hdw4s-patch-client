#!/usr/bin/env python3
"""Teach the browser client that a session can be held elsewhere, and give the
user a way to take it.

The client is a build artifact with no extension point, so unlike the server
half this has to be a patch. It therefore follows the rules the other webroot
patches already follow: idempotent, backed up before it writes, atomic, and
silent when the source it expects has changed underneath.
"""
import hashlib
import os
import re
import shutil
import sys
import tempfile

MARKER = "HDW4S takeover"

# Stamped into every file this touches, and the only thing trusted to mean
# "already patched".
#
# Two things went wrong with testing for MARKER instead. A future upstream that
# happens to contain that phrase -- likely on the day upstream adopts this --
# reads as already patched, so the edits are skipped while the file is still
# re-tokenised, and the tree sits half-patched forever while reporting itself
# healthy. And a bump of PATCH_REVISION shipped new URLs pointing at old code,
# because a file carrying the marker was never edited again: every browser
# refetched, and got the previous version back.
VERSION_TAG = "HDW4S-PATCH"
VERSION_RE = re.compile(r"HDW4S-PATCH v([0-9]+)(?: orig:([0-9a-f]{64}))?")

# What must be present for a file to count as patched, beyond the stamp. The
# stamp says an attempt was made; these say it took effect. Checking that the
# anchors are gone would not work -- several edits keep their anchor and add
# around it -- so each file names something only the patched version contains.
EVIDENCE = {
    "signalling.js": ("this.client_id", "this.onbusy", "4003"),
    "app.js": ("hdw4sClientId", "takeOver()", "reconnectBoth"),
    "index.html": ("status === 'busy'", "takeOver()"),
    "sw.js": (),
}

# Bumped whenever the patched client changes behaviour, so that browsers and
# installed apps holding a cached copy fetch the new one. Without this the
# patch lands on disk and reaches nobody: index.html pins every script with a
# frozen ?ts=, and sw.js caches those exact URLs under a frozen cacheVersion.
PATCH_REVISION = 1


