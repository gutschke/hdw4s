#!/bin/bash -e
export LC_ALL='C'
# The wrappers come first, exactly as hdw4s@.service sets it. Pinning PATH here
# without them silently un-did the redirection for every program that ignores
# the XDG variables -- Firefox and Thunderbird above all, which is the one case
# profile isolation cannot handle on its own.
export PATH='/usr/lib/hdw4s/wrappers:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

# Runs one desktop session. Invoked only by hdw4s@.service, which has already
# selected the account with User=, created XDG_RUNTIME_DIR and the profile
# directories, and put the instance name in argv.

instance="${1:?usage: hdw4s-session <instance>}"

# The unit names no account; "hdw4s enable" writes one into a drop-in. If that
# drop-in is missing -- someone ran "systemctl enable hdw4s@name" by hand --
# this would otherwise be a desktop running as root, reachable from a browser.
# Refuse, and say what to run instead.
[ "$(id -u)" -ne 0 ] || {
  echo 'hdw4s: refusing to run a desktop as root.' >&2
  echo "  Enable the session with 'hdw4s enable ${instance}', which records" >&2
  echo '  which account it belongs to, rather than starting the unit by hand.' >&2
  exit 1
}

: "${XDG_RUNTIME_DIR:?must be set by the unit}"

CONF='/etc/hdw4s/hdw4s.conf'
SLOTS='/etc/hdw4s/instances'
# shellcheck source=/dev/null
if [ -r "${CONF}" ]; then . "${CONF}" || :; fi
# shellcheck source=/dev/null
if [ -r "/etc/hdw4s/${instance}.conf" ]; then . "/etc/hdw4s/${instance}.conf" || :; fi

# The port comes from the slot table, where it was allocated and where the
# firewall and any proxy configuration read it from. Deriving it here rather
# than copying it into an environment file keeps one authoritative answer: a
# copy would be free to drift, and the copy is what would be wrong. An explicit
# HDW4S_PORT in a configuration file still wins, for the administrator who
# needs a session on a particular port.
if [ -z "${HDW4S_PORT:-}" ]; then
  : "${HDW4S_BASE_PORT:=7300}"
  slot="$(awk -v i="${instance}" \
          '$1 !~ /^#/ && $2 == i { print $1; exit }' "${SLOTS}" 2>/dev/null)"
  [ -n "${slot}" ] || {
    echo "hdw4s: ${instance} has no slot in ${SLOTS}." >&2
    echo "  Run 'hdw4s enable ${instance}' rather than starting the unit" >&2
    echo "  directly, so that a port is allocated for it." >&2
    exit 1
  }
  # The internal port, matching internal_port_of in the CLI and hdw4s-wait.
  # The external one belongs to the socket unit, which already holds it, so
  # deriving that here made the streaming server fight the relay for it.
  HDW4S_PORT=$(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE + slot ))
fi
export HDW4S_PORT

: "${HDW4S_PROFILE_DIR:=/var/lib/hdw4s}"
: "${HDW4S_ISOLATION:=none}"
# Loopback only. The socket unit owns the address the outside world
# connects to and forwards here, which is what lets a desktop exist only
# while somebody is using it.
: "${HDW4S_ADDR:=127.0.0.1}"
: "${HDW4S_FRAMERATE:=30}"
: "${HDW4S_ENCODER:=x264enc}"

profile="${HDW4S_PROFILE_DIR}/${instance}"

# Everything started here belongs to this unit's control group, and
# KillMode=control-group tears it down on stop. The trap only exists to make an
# interactive run behave the same way.
children=()
cleanup() {
  trap '' INT TERM QUIT HUP EXIT ERR
  [ "${#children[@]}" -eq 0 ] || kill "${children[@]}" 2>/dev/null || :
}
trap cleanup INT TERM QUIT HUP EXIT

# --- shared home directory isolation ---------------------------------------
#
# A GNOME session assumes it is the only one using its home directory. When the
# same home is mounted on several machines -- the case this exists for -- two
# desktops write the same dconf database, the same keyring and the same
# gvfs-metadata store, none of which have any locking that survives a network
# filesystem.
#
# With HDW4S_ISOLATION=profile the session keeps the shared home for the user's
# data but takes its settings, state and cache from a private directory on
# local disk. That fixes three problems at once, because dconf's database and
# the SQLite stores behind tracker and gvfs-metadata are all documented not to
# work over NFS.
#
# All four XDG base directories move together. Splitting them was tried and
# abandoned; the reasoning is with the redirection itself, below.
if [ "${HDW4S_ISOLATION}" = 'profile' ]; then
  export XDG_CONFIG_HOME="${profile}/config"
  export XDG_DATA_HOME="${profile}/data"
  export XDG_STATE_HOME="${profile}/state"
  export XDG_CACHE_HOME="${profile}/cache"
  install -d -m0700 "${XDG_CONFIG_HOME}" "${XDG_DATA_HOME}" \
                    "${XDG_STATE_HOME}" "${XDG_CACHE_HOME}"

  # XDG_CONFIG_HOME is redirected along with the rest, which is what puts the
  # settings database on local disk. That is the whole point: dconf's default
  # database is memory-mapped and is documented as unsuitable on NFS, and the
  # stores behind gvfs and the desktop indexer are journalled SQLite, which is
  # documented as not working there either. Moving them off the network
  # filesystem removes the problem rather than working around it.
  #
  # The alternative -- leaving the config home shared and pointing dconf at its
  # keyfile back end instead -- was tried and abandoned. It needs a service
  # that has to answer before any setting can be read, so when it does not, the
  # desktop does not start at all; and it leaves a lock beside its database
  # that a killed session does not clean up, which blocks the next one.
  # Trading a documented filesystem limitation for a new startup dependency is
  # not an improvement.
  #
  # What this does not cover: applications that hardcode ~/.config regardless
  # of the variable, which for practical purposes means some Qt input-method
  # configuration. Those stay shared.

  # No CHROME_USER_DATA_DIR here. Chrome's search order ends at
  # XDG_CONFIG_HOME, which is redirected above, so it lands in the profile with
  # everything else. Setting it explicitly would put the browser somewhere
  # different from the rest of the profile, which is worse than not setting it:
  # it splits the profile in two and hides half of it from anything that copies
  # or backs one up. Firefox does need the wrapper in /usr/lib/hdw4s/wrappers,
  # because it ignores the XDG variables entirely.

  # Indexing a shared home once per machine is wasted work and multiplies the
  # write load on the file server for no benefit.
  export TRACKER_DISABLE_MINERS='all'
fi

# gvfs exposes one FUSE mount per runtime directory. Two sessions for the same
# account would otherwise fight over the same mount point.
export GVFS_DISABLE_FUSE=1

export PULSE_RUNTIME_PATH="${XDG_RUNTIME_DIR}/pulse"
export PULSE_SERVER="unix:${XDG_RUNTIME_DIR}/pulse/native"
export PIPEWIRE_RUNTIME_DIR="${XDG_RUNTIME_DIR}"

# --- X server ---------------------------------------------------------------

# A per-session cookie in the runtime directory, never ~/.Xauthority. Sharing
# that file across sessions is what breaks when a home directory is shared, and
# its lock is taken with link(), which is unreliable over NFS and stalls for
# twenty seconds when contended.
export XAUTHORITY="${XDG_RUNTIME_DIR}/Xauthority"
export ICEAUTHORITY="${XDG_RUNTIME_DIR}/ICEauthority"
install -m0600 /dev/null "${XAUTHORITY}"

# The cookie has to be in the file before the server starts, not after it
# reports a display. An auth file that exists but holds no entry for the display
# is not partial protection: the server falls back to allowing every local
# connection, so the session would be readable by any account on the machine.
# Adding the entry once the server has reported leaves precisely that gap open
# for as long as the server takes to come up -- and X checks authorization only
# when a connection is made, so a connection opened inside the gap keeps working
# for the rest of the session. Sessions restart often enough (on failure, after
# an idle reap, and once a day behind the updater) for that to be worth winning.
#
# -displayfd means the number is not known in advance, so authorise every
# display the server could take and drop the rest once it says which one it did.
# The entries go in on stdin: an argument would be visible in
# /proc/<pid>/cmdline to every account on the machine for as long as xauth runs.
auth_displays=99
cookie="$(mcookie)"
for n in $(seq 0 "${auth_displays}"); do
  printf 'add :%d MIT-MAGIC-COOKIE-1 %s\n' "${n}" "${cookie}"
done | xauth -f "${XAUTHORITY}" source -
unset cookie

# Let the server pick the display. It creates the lock file itself with O_EXCL
# and retries until it wins, which is the only race-free way to claim one, and
# it reports the result only once it is accepting connections. Nothing outside
# this machine ever sees the display number, so it does not need to be
# predictable -- only the TCP port does.
fifo="${XDG_RUNTIME_DIR}/displayfd"
rm -f "${fifo}"
mkfifo -m0600 "${fifo}"

/usr/lib/xorg/Xorg -noreset -nolisten tcp \
  +extension GLX +extension RANDR +extension RENDER \
  -config /usr/lib/hdw4s/hdw4s.xorg.conf \
  -auth "${XAUTHORITY}" \
  -logfile "${XDG_RUNTIME_DIR}/Xorg.log" \
  -displayfd 3 3>"${fifo}" &
xorg_pid="$!"
children+=("${xorg_pid}")

if ! IFS= read -r -t 30 display_num < "${fifo}"; then
  if kill -0 "${xorg_pid}" 2>/dev/null; then
    echo 'hdw4s: the X server is running but never reported a display' >&2
  else
    wait "${xorg_pid}" && rc=0 || rc="$?"
    echo "hdw4s: the X server exited with status ${rc} during startup" >&2
  fi
  # The server's own errors say far more than the timeout does.
  grep -E '^\[? *[0-9.]*\]? *\(EE\)' "${XDG_RUNTIME_DIR}/Xorg.log" >&2 || :
  exit 1
fi
rm -f "${fifo}"

case "${display_num}" in
  ''|*[!0-9]*)
    echo "hdw4s: the X server reported '${display_num}' as a display number." >&2
    exit 1;;
esac
if [ "${display_num}" -gt "${auth_displays}" ]; then
  # No entry was pre-authorised for this one, which is the permissive case
  # described above. Refuse rather than serve a desktop with no access control.
  echo "hdw4s: the X server took display :${display_num}, beyond the range this" \
       "session authorised (0-${auth_displays}). Refusing to continue without" \
       'access control.' >&2
  exit 1
fi

export DISPLAY=":${display_num}"
printf '%s\n' "${display_num}" > "${XDG_RUNTIME_DIR}/display"

# Drop the entries for the displays the server did not take.
for n in $(seq 0 "${auth_displays}"); do
  [ "${n}" = "${display_num}" ] || printf 'remove :%d\n' "${n}"
done | xauth -f "${XAUTHORITY}" source -

# --- session ----------------------------------------------------------------

export XDG_SESSION_TYPE='x11'
export XDG_SESSION_CLASS='user'

# Only claim to be GNOME when GNOME is what is being started. Another desktop
# reads XDG_CURRENT_DESKTOP to decide which autostart files apply, and telling
# it the wrong thing starts the wrong set of services.
case "${HDW4S_SESSION:-gnome-session}" in
  *gnome-session*)
    export XDG_CURRENT_DESKTOP='ubuntu:GNOME'
    export GNOME_SHELL_SESSION_MODE='ubuntu'
    ;;
esac

# dbus-run-session, not dbus-launch: the bus is owned by this process and dies
# with it, rather than being left behind for nothing to reap.
#
# It is also what makes a second desktop for the same account possible at all.
# On a private bus the systemd manager is not reachable, so gnome-session
# cannot start its components as user units -- there is only ever one systemd
# user manager per account, and it belongs to whichever session got there
# first. gnome-session falls back to its own service manager, and the check
# that would otherwise refuse to start a second session is bypassed with it.
# Choose the session's locale here, before the bus exists.
#
# LC_ALL=C at the top of this script keeps its own parsing predictable and is
# worth keeping for that. It must not reach the desktop: parts of it, the
# terminal among them, refuse to run in a non-UTF-8 locale and exit rather than
# degrade, and text through the clipboard would be mangled besides. That is
# upstream behaviour, not something to argue with.
#
# It has to happen before dbus-run-session rather than inside it. Everything
# the bus launches by activation inherits the bus's own environment, so an
# LC_ALL set at this point would reach programs that never see this script --
# which is exactly how a terminal that nothing could start went unexplained.
unset LC_ALL
if [ -z "${HDW4S_LANG:-}" ] && [ -r /etc/default/locale ]; then
  HDW4S_LANG="$(sed -n 's/^LANG=//p' /etc/default/locale | tr -d \" | head -n1)"
fi
: "${HDW4S_LANG:=C.UTF-8}"
case "${HDW4S_LANG}" in
  *[Uu][Tt][Ff]*) :;;
  *)
    echo "hdw4s: ${HDW4S_LANG} is not a UTF-8 locale; using C.UTF-8 instead," >&2
    echo '  because parts of the desktop refuse to run without one.' >&2
    HDW4S_LANG='C.UTF-8'
    ;;
esac
export LANG="${HDW4S_LANG}"

exec dbus-run-session -- /usr/lib/hdw4s/hdw4s-run-session "${instance}"
