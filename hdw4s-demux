def describe_window(secs):
    """An idle window as a person would say it, for a line a person reads."""
    if secs is None:
        return "unreadable"
    if secs <= 0:
        return "none (never reaped)"
    for size, name in ((86400, "d"), (3600, "h"), (60, "m")):
        if secs >= size and secs % size == 0:
            return "%d%s" % (secs // size, name)
    return "%ds" % secs

