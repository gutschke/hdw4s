def asked_marker_header(sid):
    """The marker for a session THIS request minted or was pressed to resume,
    for the redirect to carry.

    A function rather than a line at each site, because the three sites (two
    mints and the directory's Resume) must not drift into three spellings --
    and the page-side reader is in another file, which is why the name is
    asserted across them by tests.sh.
    """
    return ("Set-Cookie",
            "%s=%s; Path=/; SameSite=Lax; Secure; Max-Age=%d"
            % (FRESH_COOKIE, sid, FRESH_COOKIE_SECONDS))

