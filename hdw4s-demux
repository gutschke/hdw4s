def fresh_mint_header(sid):
    """The marker for a session THIS request minted, for the redirect to carry.

    A function rather than a line at each site, because the two minting sites
    must not drift into two spellings -- and the page-side reader is in a third
    file, which is why the name is asserted across all three by tests.sh.
    """
    return ("Set-Cookie",
            "%s=%s; Path=/; SameSite=Lax; Secure; Max-Age=%d"
            % (FRESH_COOKIE, sid, FRESH_COOKIE_SECONDS))

