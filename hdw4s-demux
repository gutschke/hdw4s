def load_names_js():
    """hdw4s-names.js, the one copy of how this browser names its desktops.

    BESIDE THIS FILE for the reason hdw4s-duration is (see load_duration()),
    and read once, at start. UNLIKE that one it has a fallback, and the
    difference is the point: a missing grammar would be a wrong number, a
    missing name script is the plain word "Desktop" on every row -- which is
    exactly what a browser with scripts off or storage blocked sees anyway."""
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "hdw4s-names.js")
    try:
        with open(path, "r", encoding="utf-8") as f:
            js = f.read()
    except OSError:
        return ""
    # An inlined script ends at the first "</script", wherever it is.
    return "" if "</script" in js.lower() else js


