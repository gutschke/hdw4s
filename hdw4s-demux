def load_credential():
    """user:password, root-only. Absent means REFUSE TO START.

    Failing closed matters more than it looks: this is the one leg where a
    credential does any work, and a demultiplexer that quietly served without
    one would present every session on the box to anything that can reach the
    port, while every green check downstream kept passing.
    """
    path = CRED_FILE or credential_path("demux.auth.cred")
    try:
        with open(path, "rb") as f:
            raw = f.read().strip()
    except OSError as e:
        log("no credential at %s (%s)." % (path, e.strerror))
        log("refusing to start: this is the only leg where a credential works.")
        raise SystemExit(1)
    if b":" not in raw:
        log("credential in %s is not user:password; refusing to start." % path)
        raise SystemExit(1)
    # Compared, never printed, and never placed in argv.
    return base64.b64encode(raw)


def authorized(headers, expected_b64):
    got = header_value(headers, "Authorization")
    if not got or not got.lower().startswith(b"basic "):
        return False
    # Constant time, and on the encoded form so no decode can leak by length.
    return hmac.compare_digest(got.split(None, 1)[1].strip(), expected_b64)


