def load_refusal_page():
    """hdw4s-refuse's page, exactly as that responder sends it, or None.

    WHY THE ROUTER NEEDS IT. A connection to a pool slot whose desktop is not
    running no longer starts one: the relay is Requisite= on the session, so it
    fails, and hdw4s-refuse@ answers the connection with this page. For a
    letting whose desktop HAD answered, that refusal is systemd's own account
    that the desktop is gone -- recorded when the relay's start was refused, not
    guessed from how soon a port closed -- and the visitor must meet the ended
    page, not a page saying a desktop "could not be started".

    READ, NOT IMPORTED: the literal is taken from the file's syntax tree, so
    nothing in it runs in this process. Beside this file for the reason
    hdw4s-duration is. None when it cannot be read, and then a refusal is
    relayed as the 503 it is, which is what happened before this existed.
    """
    import ast
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "hdw4s-refuse")
    try:
        with open(path, "r", encoding="utf-8") as f:
            tree = ast.parse(f.read())
        for node in tree.body:
            if isinstance(node, ast.Assign) and any(
                    isinstance(t, ast.Name) and t.id == "PAGE"
                    for t in node.targets):
                value = ast.literal_eval(node.value)
                return value if isinstance(value, bytes) and value else None
    except (OSError, SyntaxError, ValueError):
        return None
    return None


REFUSAL_PAGE = load_refusal_page()

