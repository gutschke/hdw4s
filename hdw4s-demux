# Connection
# --------------------------------------------------------------------------

def serve(sock, own, expected_b64):
    sock.settimeout(IDLE_TIMEOUT)
    rf = sock.makefile("rb")
    wf = sock.makefile("wb")
    try:
        while True:
            try:
                line = read_line(rf)
            except (Closed, socket.timeout, OSError):
                return
            bits = line.split()
            if len(bits) != 3:
                respond(wf, 400, page("Bad request", "That was not HTTP."))
                return
            method, target, _ = bits
            try:
                headers = read_headers(rf)
            except (Closed, OSError):
                return

            if not authorized(headers, expected_b64):
                respond(wf, 401, page(
                    "Not authorised",
                    "This front door is reached through the reverse proxy."),
                    [("WWW-Authenticate", 'Basic realm="%s"' % REALM)])
                return

            # Identity is resolved BEFORE the first response that a browser
            # keeps, and that ordering is load bearing rather than tidy: the
            # trailing-slash redirect below used to be answered without one, so
            # a tab whose only traffic for a while was that redirect got no
            # cookie back and its window did not slide.
            sid, rest, query = parse_target(target)
            identity = identity_of(headers)
            new_identity = False
            if identity is None:
                identity = own.mint_identity()
                new_identity = True

            if needs_trailing_slash(target):
                path, _, q = target.partition(b"?")
                loc = path.decode("latin-1") + "/" + (("?" + q.decode("latin-1")) if q else "")
                respond(wf, 302, b"", [("Location", loc)] +
                        refresh_headers(own, identity, new_identity))
                continue

            if sid is None:
                # THE CONSOLE IS CLAIMED BEFORE THE ARRIVAL, and the order is
                # the whole safety of it. Everything this dispatch does not
                # claim falls through to arrival(), which MINTS A DESKTOP -- so
                # a console address that stopped being recognised would not 404,
                # it would hand somebody a new desktop every time they tried to
                # end one. That is why console_target() has a start-up guard of
                # its own rather than being trusted to keep working.
                what, csid = console_target(rest)
                if what is not None:
                    console(own, wf, identity, new_identity, what, csid, method)
                    continue
                arrival(own, wf, identity, query, new_identity)
                continue

            rec = own.lookup(sid)
            if rec is not None:
                # RESOLVING IS NOT ENOUGH, and that gap is why the gate below
                # was unreachable by the one visitor it was written for.
                #
                # The table knows nothing about reaping. A visitor whose desktop
                # the sweep stopped presents a sid that resolves PERFECTLY, so
                # they fell straight past the gate to the proxy -- and the slot
                # socket is still listening and socket-activated, so the connect
                # succeeded and started a brand-new empty desktop under their
                # old address, in about two seconds. Not a 502, not a stall:
                # their in-memory home was gone and the screen looked fine.
                #
                # So the person the 410 page was written for was the only person
                # who could never see it, while it was shown to strangers whose
                # ids had simply expired.
                why = session_replaced(rec, rec["instance"])
                if why is not None:
                    own.forget(sid)
                    log("gated a returning visitor at %s: %s"
                        % (rec["instance"], why))
                    # AND THE SLOT IS RECLAIMED IF WE LET IT. Gating alone
                    # leaves a full desktop running in that slot for nobody --
                    # which is the leak: one visitor ending four sessions
                    # correctly consumed four slots in seven minutes. The
                    # qualifier is everything here; reclaim_slot() declines,
                    # out loud, for anything this router cannot say it let.
                    reclaim_slot(own, sid, rec, why)
                    rec = None
            if rec is None:
                # GATE. Not a mint, and the difference is the whole point.
                #
                # A tab presenting an id that no longer exists is by definition
                # RETURNING rather than arriving -- nothing else produces that
                # state -- so this needs no clock, no age threshold and no
                # guess. And MINTING IS A DAMAGE, not a neutral default: a
                # machine whose tabs are restored lazily after a reboot presents
                # a dead id from EVERY restored tab, and minting on each one
                # hands back one unwanted desktop per tab. That is the second of
                # the two damages the gate exists for, alongside taking over
                # somebody else's session.
                #
                # It must also never fall through to whatever now holds the
                # slot, which is the recycling hazard the ownership keying
                # guards.
                #
                # The shape to keep: an input we cannot resolve produces a
                # QUESTION, never an ACTION. A failure that degrades toward
                # doing something is the same defect as a signal that degrades
                # toward "safe".
                #
                # The cookie rides on the gate. A browser whose tabs are being
                # restored after a reboot presents a dead id from every one of
                # them, and those gates may be the only thing it says to us for
                # days -- letting its identity lapse there would cost it the
                # OTHER sessions it still owns.
                respond(wf, 410, gate_page(
                    "This desktop has ended",
                    "The session this tab was showing is no longer running. "
                    "Nothing has been started for you.",
                    "Start a new desktop"),
                    refresh_headers(own, identity, new_identity))
                continue
            if rec["identity"] != identity:
                # The invariant, refusing: different identities never see each
                # other's sessions. This is the negative the close is tested with.
                respond(wf, 403, page(
                    "Not your desktop",
                    "This address belongs to a different browser."),
                    refresh_headers(own, identity, new_identity))
                continue

            served = forward_request(rec["instance"], method, rest, query,
                                     headers, rf, wf, sock,
                                     refresh_headers(own, identity,
                                                     new_identity))
            # A DESKTOP IS NOW THERE, so there is at last a start to attach to.
            # This is the earliest moment such a thing exists: before it, the
            # slot's published token belongs to whoever held it last -- it
            # survives a reap, measured -- and the session about to start will
            # replace it. Recording here rather than at mint is the difference
            # between a check that refuses a stranger and one that refuses
            # everybody, which is what the first version did to every test at
            # once.
            #
            # ASKED OF THE AUTHORITY, not inferred from the return value above.
            # forward_request() answers False for "this downstream connection
            # cannot carry another request" AND for the 502 it writes when the
            # session could not be reached, and those must not attach alike --
            # treating a 502 as an attachment would pin a record to a desktop
            # that never existed. One stat settles it and cannot be confused.
            if occupancy_readable() and slot_occupied(rec["instance"]):
                own.attach(sid, slot_incarnation(rec["instance"]))
                # The desktop has answered, so the authority now speaks for
                # this slot and is more current than we are. Our reservation
                # has nothing left to say and holding it would only delay the
                # slot's return when the session stops.
                release_slot(rec["instance"])
            if not served:
                return
    finally:
        for f in (rf, wf):
            try:
                f.close()
            except OSError:
                pass
        try:
            sock.close()
        except OSError:
            pass


def assert_an_ended_letting_is_never_proxied(factory=Ownership,
                                            replaced=session_replaced,
                                            in_use=slots_in_use,
                                            asked=teardown_requested):
    """Prove a discarded letting cannot be proxied, and that a live one still can.

    Runs at every start beside the others. WHAT IT CATCHES IS INVISIBLE FROM THE
    OUTPUT, which is why it is here and not only in a test file: a request
    proxied into a slot whose desktop is stopping starts a FRESH desktop in that
    slot, and the visitor sees a perfectly ordinary screen while a production
    slot is consumed for the length of the idle window -- seven days on the
    shipped default. Nothing fails, nothing logs, and the reaper is right to say
    nothing.

    THE PERMIT ARM IS NOT DECORATION. A version of this gate that refused
    everything would stop the leak and also gate every living visitor, which is
    the more expensive defect of the two: [[restarting-sessions-is-usually-safe]]
    and the 503-vs-gate history both say a refusal that should have been a resume
    costs more than a leak. So the same record, with the same healthy world
    around it, must be permitted while it has not ended.

    AND THE WORLD IS BUILT TO LIE, on purpose. Every instrument the gate would
    otherwise consult is given the HEALTHY answer: the runtime directory exists,
    the token matches, and the door is stubbed open. That is the production
    state at the moment of the defect -- the teardown has been asked for and
    nothing in the world has caught up. A fixture where the directory was already
    gone would pass against the old code too, which is the arm this project has
    got wrong before.
    """
    import shutil
    import tempfile

    d = tempfile.mkdtemp(prefix="hdw4s-demux-ended-")
    try:
        rundir = os.path.join(d, "run", "hdw4s")
        web = os.path.join(d, "web")
        os.makedirs(os.path.join(rundir, "ephemeral0"))
        os.makedirs(os.path.join(web, "ephemeral0"))
        with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"), "w") as f:
            f.write("same-token")
        open_door = lambda inst: True

        def rec(ended=None):
            return {"live": True, "incarnation": "same-token", "minted": 0.0,
                    "instance": "ephemeral0", "ended": ended}

        # PERMIT ARM, first, so a gate that refuses everything cannot satisfy
        # this function by passing the arm below.
        why = replaced(rec(), "ephemeral0", rundir=rundir, webroot=web,
                       door=open_door)
        assert why is None, \
            "a live letting was gated although nothing about it had ended: %r" % why

        # REFUSE ARM. The same record, the same healthy world, and the one thing
        # that differs is the act we performed ourselves.
        why = replaced(rec("the visitor discarded it"), "ephemeral0",
                       rundir=rundir, webroot=web, door=open_door)
        assert why is not None, \
            "a DISCARDED letting was permitted to proxy. The next request for" \
            " it socket-activates a fresh desktop in that slot, for nobody, for" \
            " the length of the idle window"

        # AND IT MUST NOT NEED AN INSTRUMENT TO SAY SO. The whole point is that
        # this answer precedes the world: with the occupancy authority absent --
        # where every other reason withholds itself, correctly -- the act must
        # still speak.
        why = replaced(rec("the visitor discarded it"), "ephemeral0",
                       rundir=os.path.join(d, "no-such-rundir"), webroot=web,
                       door=open_door)
        assert why is not None, \
            "the discard was answered only when the occupancy authority could" \
            " be read, so the gate is behind an instrument rather than in front" \
            " of one"

        # THE OTHER HALF OF THE PAIR: a slot mid-teardown must not be re-let.
        # Without this, the gate above could fire on a FRESH letting that had been
        # minted onto the slot while the previous one was still being torn down.
        tdir = os.path.join(d, "teardown")
        os.makedirs(os.path.join(tdir, "ending"))
        pool = ["ephemeral0", "ephemeral1"]
        seen = asked("ephemeral1", root=tdir)
        assert seen is False, \
            "a slot with no teardown marker was reported as being torn down"
        open(os.path.join(tdir, "ending", "ephemeral1"), "w").close()
        assert asked("ephemeral1", root=tdir) is True, \
            "the in-progress marker hdw4s-teardown leaves for the WHOLE of a" \
            " teardown was not seen; the only thing this router could see was" \
            " the request file, which the teardown clears before it does any work"
        # AND IT EXPIRES, because the marker is cleared by another process and a
        # marker that outlived a SIGKILL would take the slot out of the pool
        # until the next reboot.
        assert asked("ephemeral1", root=tdir,
                     now=time.time() + TEARDOWN_MARKER_MAX + 1) is False, \
            "the in-progress marker never expires, so one killed teardown" \
            " retires a slot permanently"
        _ = pool
    finally:
        shutil.rmtree(d, ignore_errors=True)


def listening_socket():
    """systemd's fd if we were socket-activated, otherwise our own bind."""
    if os.environ.get("LISTEN_FDS") and os.environ.get("LISTEN_PID") == str(os.getpid()):
        s = socket.socket(fileno=3)
        s.setblocking(True)
        log("listening on the socket unit's fd")
        return s
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind((BIND, PORT))
    s.listen(128)
    log("listening on %s:%d" % (BIND, PORT))
    return s


def main():
    global COOKIE_LIFETIME

    # Both arms, at every start, before anything can arrive.
    assert_ownership_keying(Ownership)
    assert_cookie_outlives_idle(derive_cookie_lifetime)
    # And the third, for the same reason and with a sharper history: the probe
    # this guards used to CONNECT, and a connect on a socket-activated slot is
    # not a question, it is an instruction to start a desktop. That was silent
    # for as long as it existed, because what the probe reported became true the
    # moment it asked.
    assert_probe_does_not_activate(slot_unreachable, listening_paths)
    # And the fourth, which is the routing decision itself: that occupancy is
    # observed rather than created, that a missing authority is withheld rather
    # than spent, and that the incarnation token can only ever refuse.
    assert_occupancy_is_read_not_created(slot_occupied, occupancy_readable,
                                         session_replaced)
    # And the one that DESTROYS. Every other guard here refuses somebody a
    # desktop when it fires wrongly; this one ends a desktop somebody is
    # using, with nobody watching, and the only thing standing between those
    # two outcomes is whether this router can produce the letting it is acting
    # on. Proved at every start, in both directions.
    assert_reclaim_needs_a_letting(reclaimable, Ownership)
    # And the door, which is the other half of the same leak: the reclaim ENDS
    # a desktop the slot was left running, this stops one being started. Its
    # dangerous direction is the quiet one -- a false OPEN keeps the leak while
    # looking like a working repair -- so the TIME_WAIT case is built from a
    # real fixture rather than reasoned about.
    assert_door_only_refuses_what_it_measured(listening_tcp_ports,
                                              slot_door_open, session_replaced,
                                              Ownership)
    # And the fifth, which is WHICH SLOTS EXIST at all -- the question the four
    # above all take an answer to. It was computed from a directory listing for
    # as long as this file has existed, and was sighted three times without
    # being fixed, because the function's name promised the pool while its body
    # returned filenames.
    assert_pool_is_typed(slot_table, ephemeral_slots)
    # And the newest one, which is the ORDER rather than a condition: what this
    # router DID must be asked before anything it can observe, because everything
    # it can observe is late by seconds and a request landing in those seconds is
    # proxied into a dying slot and starts a desktop there.
    assert_an_ended_letting_is_never_proxied(Ownership, session_replaced,
                                            slots_in_use, teardown_requested)
    # And the fifth: the only fact this process holds whose LOSS can permit
    # something, and therefore the only one written to disk. That it holds,
    # that it expires, and that it has no way to say yes to anybody.
    assert_reservation_only_refuses(reserve_slot, reserved_slots, release_slot,
                                    reservation_fresh)
    # And the console's address parsing, for the reason given in its own
    # docstring: what this does not claim is MINTED, so a parser that quietly
    # stopped matching would turn "end my desktop" into "give me another one".
    assert_console_shows_only_your_own(console_target)

    # The third guard REPORTS and does not refuse, and the asymmetry with the
    # two above is deliberate. Those two fail closed because what they catch is
    # a router that would hand somebody a stranger's desktop or lock somebody
    # out of their own. This one catches a container nobody wrote a purpose
    # for, which is a mistake made while editing this file -- no visitor and no
    # administrator can create it -- so the person who will see this line is
    # the person who just caused it, on their first run. Taking the front door
    # down for that would be a bookkeeping slip paid for with an outage, and a
    # guard that does that is removed within the week.
    #
    # It is still a real guard because the suite calls the refusing face:
    # .github/live/demux.py asserts on the refusal itself, so this cannot
    # quietly become a line nobody reads.
    examined = []
    unclassified = uninventoried_state(globals(), Ownership, STATE_INVENTORY,
                                       examined=examined)
    for complaint in unclassified:
        log("WARNING: %s" % complaint)
    # SAID OUT LOUD EVEN WHEN CLEAN, and that is not a banner. A guard whose
    # green is silence cannot be told apart from a guard nobody called -- which
    # is this project's own recorded defect, a whole suite believed green that
    # had never been invoked by anything at all. The suite asserts on this
    # line, so deleting the call above turns a test red instead of turning a
    # check into decoration.
    #
    # It counts what the sweep LOOKED AT, not what the inventory holds, and
    # that distinction was measured rather than reasoned: the first version
    # printed len(STATE_INVENTORY), and a main() with the call ripped out
    # printed the same reassuring number while the suite stayed green.
    log("state inventory: %d name(s) examined, %d unclassified"
        % (len(examined), len(unclassified)))

    expected_b64 = load_credential()
    own = Ownership()

    # DERIVED AT START, from the pool as it stands. Said out loud with both
    # halves, because the whole reason this is not a knob is the relationship
    # between the two numbers, and a reader who sees only one cannot check it.
    windows = idle_windows()
    COOKIE_LIFETIME = derive_cookie_lifetime(windows)
    log("an identity lasts %d day(s), derived from %d ephemeral slot(s): %s"
        % (COOKIE_LIFETIME // 86400, len(windows),
           ", ".join("%s=%s" % (i, describe_window(s))
                     for i, s in sorted(windows, key=lambda r: r[0]))
           or "none configured"))
    standing = cookie_policy_complaints(COOKIE_LIFETIME, windows)
    for complaint in standing:
        log("WARNING: %s" % complaint)
        log("  While that holds, a desktop can outlive the identity that owns"
            " it -- and its owner then cannot reach it or close it.")

    # AND ASKED AGAIN WHILE WE RUN. The lifetime above is pinned and the
    # configuration is not, so an administrator who widens an idle window on a
    # live box moves one clock and not the other. Until now the only thing that
    # ever noticed was log_refusal(), which fires when the pool is exhausted --
    # so on a box with a spare slot the warning had no trigger at all and the
    # gap could stand indefinitely. Seeded with what was just printed, so the
    # first thing this says is a CHANGE and not an echo.
    threading.Thread(target=watch_cookie_policy,
                     args=(COOKIE_LIFETIME, set(standing)),
                     daemon=True).start()
    # For the same reason as above: a thread that was never started is silent
    # in exactly the way a thread with nothing to report is silent.
    log("the identity lifetime is re-checked against the pool every %d minute(s)"
        % int(COOKIE_POLICY_EVERY // 60))

    # The sweep's record is the second of the two columns the refusal log
    # prints. Whether it can be read at all is a property of this process, not
    # of the sweep, so it is settled here rather than discovered by an operator
    # reading a column of question marks during an outage.
    if windows:
        probe = os.path.join(REAP_STAMP_DIR, sorted(windows)[0][0])
        _, why = stamp_age(probe)
        if why and why.startswith("unreadable"):
            log("WARNING: the idle sweep's record under %s cannot be read here"
                " (%s)." % (REAP_STAMP_DIR, why))
            log("  Refusals will still be logged, and the last-request column"
                " is unaffected, but the sweep's own column will be blank.")

    # SAID OUT LOUD, BOTH HALVES, because each degrades quietly.
    #
    # If the authority is missing, this router cannot tell an occupied slot from
    # a free one and will re-let a running desktop after a restart. That is the
    # defect this change exists to remove, so it must not be reachable by a
    # silent path -- and its symptom on a live box is somebody else's desktop,
    # which nobody traces back to a directory that was not there.
    # THE POOL, READ ONCE FOR THE WHOLE BANNER. Every line below used to call
    # the socket-directory listing again, so the banner described a set the mint
    # path does not use and re-read it four times while it did. An operator
    # sizing a pool from "routing to 4 slot(s)" was being told about a named
    # desktop's leftover socket.
    pool = ephemeral_slots()
    if pool is None:
        log("WARNING: the slot table at %s cannot be read, so this router does"
            " not know which slots are ephemeral." % SLOTS_FILE)
        log("  It will refuse every arrival until that is fixed. It will NOT"
            " fall back to the sockets under %s: every instance on this box"
            " binds into that directory, named desktops included, and handing"
            " one of those to a visitor is the defect this refuses to repeat."
            % PROXY_RUNDIR)
        pool = []
    if occupancy_readable():
        busy = [n for n in pool if slot_occupied(n)]
        log("%d of %d slot(s) already have a desktop running: %s"
            % (len(busy), len(pool), ", ".join(busy) or "none"))
        log("  Read from the sessions' own runtime directories under %s, which"
            " survive a restart of this service. Nothing was opened to find"
            " out." % SESSION_RUNDIR)
    else:
        log("WARNING: %s does not exist, so nothing here can tell a slot with a"
            " desktop behind it from a free one." % SESSION_RUNDIR)
        log("  Every slot will be treated as available. After a restart of this"
            " service that re-lets desktops that never stopped, and the visitor"
            " already using one is not told.")
        log("  It is created by hdw4s-ephemeral-slots at boot; if that has not"
            " run, this router is routing without the fact it routes on.")
    # The corroborator, reported separately because "no opinion" and "agrees"
    # are different states and only one of them is evidence.
    published = [n for n in pool if slot_incarnation(n)]
    if not published:
        log("no slot publishes an incarnation under %s, so a returning visitor"
            " is judged on occupancy alone." % WEBROOT_DIR)
        log("  That still refuses a reaped desktop. What it cannot see is a"
            " slot reaped and re-let to somebody else between two visits.")

    # THE ORPHANS, NAMED. Said before the pool rather than after it, because the
    # sighting that started this was an operator reading a socket file's name in
    # the routing line and concluding the pool had a slot it does not have. A
    # name here is either a named desktop's socket -- correct, and none of this
    # router's business -- or a leftover nothing will ever serve.
    stray = [n for n in socket_filenames() if n not in pool]
    if stray:
        log("%d socket(s) in %s are not ephemeral rows in %s and will never be"
            " offered: %s"
            % (len(stray), PROXY_RUNDIR, SLOTS_FILE, ", ".join(stray)))
        log("  A named desktop's socket belongs here and is not a fault. One"
            " that belongs to nothing is a leftover and can be removed.")

    slots = pool
    if not slots:
        log("no ephemeral slots in %s; nothing can be minted here."
            % SLOTS_FILE)
    else:
        log("routing to %d slot(s): %s" % (len(slots), ", ".join(slots)))
        # Read ONCE for the whole pool rather than once per slot, so the banner
        # describes one instant instead of N of them.
        listening = listening_paths()
        if listening is None:
            log("WARNING: /proc/net/unix could not be read, so whether anything"
                " is listening on each slot is unknown here.")
            log("  The names below are what the pool is configured with. They"
                " are not a claim that any of them can be served.")
        # A slot with its own Basic credential answers 401 to EVERYTHING that
        # comes through here, including its index -- and it does so alone, while
        # its neighbours work, which reads as a routing fault rather than as
        # configuration. Say it at startup instead of letting one slot in the
        # pool fail silently.
        for name in slots:
            # REACHABILITY, before anything about credentials. The banner above
            # names what this router will hand to visitors, and it used to
            # announce slots it could not open -- a socket left behind by an
            # earlier configuration, with nothing bound to it, was listed as
            # routable and then given to the first arrival, which got no
            # response at all.
            #
            # THIS LOOP USED TO BE THE MOST EXPENSIVE LINE IN THE FILE. It ran
            # one connect-and-close per slot, and on a socket-activated pool a
            # connect starts a desktop. Measured on a three-slot pool: every
            # session stopped, one `systemctl restart hdw4s-demux`, and eleven
            # milliseconds after this banner printed, all three incarnation
            # units and all three GNOME sessions had started -- with no arrival
            # and nobody on the box. A restart of the front door consumed the
            # whole pool, every time, and said nothing, because by the time
            # anyone read "routing to 3 slot(s)" it was true.
            #
            # NOT keyed on a particular errno. The failure measured in the field
            # was EACCES, not ENOENT or ECONNREFUSED, because the leftover socket
            # was owned by a different user than the one this runs as. Anything
            # written against "the file is missing" would have stayed silent
            # through exactly the case that produced the defect.
            why = slot_unreachable(name, listening)
            if why:
                log("WARNING: %s is listed as a slot but cannot be reached: %s"
                    % (name, why))
                log("  A visitor minted onto it gets a failed request and the"
                    " slot is consumed.")
                log("  If no session owns this name, the socket is a leftover"
                    " and can be removed.")
            elif slot_carries_own_credential(name):
                log("WARNING: %s has a credential of its own, so it will refuse"
                    " every request routed to it." % name)
                log("  On a filesystem socket that credential protects nothing:"
                    " reachability is already")
                log("  decided by the socket's mode. Turn it off with"
                    " 'hdw4s noauth %s'." % name)

    srv = listening_socket()
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)

    while True:
        try:
            conn, _ = srv.accept()
        except OSError as e:
            log("accept failed: %s" % e)
            continue
        threading.Thread(target=serve, args=(conn, own, expected_b64),
                         daemon=True).start()


if __name__ == "__main__":
    main()
