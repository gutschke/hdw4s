# --------------------------------------------------------------------------
# How long an identity lasts
# --------------------------------------------------------------------------
#
# THE COOKIE IS A FUSE AND MUST NOT BE. Set-Cookie used to be attached on one
# arrival only -- the one that found no valid cookie -- and nothing anywhere
# refreshed it. Max-Age therefore ran from a browser's FIRST EVER contact,
# regardless of how much it used the pool since.
#
# The failure that produces is closed and silent. A visitor who comes back daily
# loses their identity at exactly Max-Age, mid-use. Their next request carries no
# cookie, so a throwaway identity is minted, so their own live desktop answers
# 403 -- and the 403 path set no cookie either, so every retry minted another
# throwaway. Their desktop stays running, unreachable and unkillable by the only
# person entitled to kill it, holding a slot until the sweep takes it. Found by
# three reviewers independently, which is what a defect looks like when the code
# reads correctly line by line.
#
# So two changes, and they are separate: the window SLIDES (refresh_headers
# below, applied on every response we write, not only on a mint), and the
# lifetime is DERIVED rather than configured.
#
# WHY IT IS NOT A KNOB, because "make it configurable" is the obvious review
# comment and it is wrong here. The whole adjustment range on one side is the
# single indefensible state above: a desktop alive with its owner locked out.
# An administrator lowering the number gets nothing they wanted and one thing
# nobody wants. The two clocks are also not the same clock -- the cookie counts
# from first contact, the sweep counts from last connection -- so setting them
# equal, which is what shipped, composes into nothing at all: the identity
# expires at the exact moment a desktop that has been in constant use is still
# running and still owned.
#
# The derivation is therefore max(30 days, 2 x the longest idle window in the
# pool). The doubling is the headroom between the two clocks; the floor is so
# that a pool configured to reap aggressively does not drag identities down with
# it, since an identity costs nothing to keep and a desktop costs a slot.


def conf_value(path, key):
    """The last assignment of KEY in a shell-ish conf file, or None.

    Mirrors how the CLI reads the same files -- last line wins, a trailing
    comment is not part of the value, quotes are stripped -- because a second
    reader that parses the same file differently is a second configuration.
    """
    try:
        with open(path, "r", errors="replace") as f:
            lines = f.readlines()
    except OSError:
        return None
    found = None
    for line in lines:
        s = line.strip()
        if s.startswith("#") or not s.startswith(key + "="):
            continue
        found = s[len(key) + 1:].split("#")[0].strip().strip("'\"")
    return found


def idle_seconds_of(text):
    """Whole seconds for one written-down idle window, or raise.

    THE CONTRACT .github/setting-grammar.py COMPARES AGAINST, and the reason it
    is spelled in seconds. What stood here read the value with int() and caught
    the failure:

        try:
            days = int(v) if v is not None else 7
        except ValueError:
            days = 7

    Three things were wrong with that and only one of them is the exception.
    "30d" -- the value our own sample configuration and manual tell an
    administrator to type -- raised and became a week. So did a typo like
    "30x", which means a rejected value and a chosen one produced the same
    number and the same silence, and nothing downstream could tell them apart.
    And the unit was WHOLE DAYS, so "12h" had no representation here even in
    principle: had the parsing been fixed alone, a half-day window would have
    truncated to zero and read as "never reaped", which inverts the setting
    rather than mis-stating it.

    So the grammar is not here either. hdw4s-duration is the one copy, the CLI
    calls the same file, and there is no fallback on this path: a value that
    cannot be read raises, and every caller says so out loud.
    """
    return DURATION.parse(text)


def read_idle_window(inst):
    """(seconds, why) for one slot. seconds is None when it cannot be read.

    None is NOT zero and must never be folded into it. Zero is a person saying
    "never reap this"; None is us saying "we do not know what this says", and
    the difference is the whole of the defect this replaced -- which answered
    a confident seven days to both.
    """
    path = os.path.join(ETC_DIR, inst + ".conf")
    v = conf_value(path, "HDW4S_IDLE_DAYS")
    if v is None:
        path = SITE_CONF
        v = conf_value(path, "HDW4S_IDLE_DAYS")
    if v is None:
        # The one value that is not written down anywhere, and it is the
        # documented default rather than a fallback: hdw4s.conf documents 7,
        # the CLI's own table defaults to 7, and .github/checks.sh compares the
        # three. An absent setting is not an unreadable one.
        return DEFAULT_IDLE_SECONDS, None
    try:
        return idle_seconds_of(v), None
    except DURATION.DurationError as e:
        return None, "%s says HDW4S_IDLE_DAYS=%s, which cannot be read: %s" \
            % (path, v, e)


# The "you read it" sentinel. NOT None, because None is the answer that means
# "the table could not be read", and a parameter whose default shares a value
# with a real answer cannot tell a caller who passed nothing from one who passed
# the failure. Caught by assert_pool_is_typed() at the first start after it was
# written; see ephemeral_slots().
_READ_IT = object()


def slot_table(path=None):
    """[(instance, type)] exactly as the slot table declares them, or None.

    THE ONE PARSER FOR THAT FILE. There were two readings of it in this module
    -- idle_windows() here, and nothing at all on the mint path, which read a
    directory listing instead -- and the whole of the defect below was that the
    typed authority was consulted only where being wrong was harmless.

    A row is "<index> <instance> [<type>]". The type defaults to "desktop" when
    the column is absent, which is the CLI's own reading of the same file; a
    table written before the column existed describes named desktops, and
    guessing "ephemeral" for them would put a person's long-lived session into
    the pool a stranger is minted onto.

    None, NOT an empty list, when the file cannot be read. The two mean opposite
    things to a caller deciding whether to hand a slot out -- "this box has no
    ephemeral slots configured" is a reason to refuse politely, and "I could not
    read the file that says" is a reason to say so loudly -- and returning [] for
    both is how an unreadable table would have become a silent, permanent 503
    with nothing in the log naming the file.
    """
    path = SLOTS_FILE if path is None else path
    try:
        with open(path, "r", errors="replace") as f:
            raw = f.readlines()
    except OSError:
        return None
    rows = []
    for line in raw:
        bits = line.split()
        if len(bits) < 2 or bits[0].startswith("#"):
            continue
        rows.append((bits[1], bits[2] if len(bits) > 2 else "desktop"))
    return rows


def ephemeral_slots(table=_READ_IT):
    """The names a visitor may be minted onto. None if the table is unreadable.

    THE POOL, and the reason this exists rather than a directory listing is the
    defect it replaces. The mint path used to compute free capacity from
    socket_filenames() below -- os.listdir() on the proxy run directory, filtered
    on a ".sock" suffix -- and EVERY proxy instance on the box binds into that
    one directory, named and ephemeral alike. Measured 2026-09-22 and recorded in
    that function's own docstring: "a named session's leftover socket is
    enumerated into the ephemeral pool". Three separate seats sighted it; nothing
    was built on it until now, and a provisioning slot that must be reachable by
    an administrator and never offered to a visitor is exactly the thing that
    directory listing cannot express.

    WHAT IS DELIBERATELY NOT FILTERED HERE: whether anything is listening. The
    brief that asked for this called the pool an intersection of the typed rows
    with listening_paths(), and that is one condition too many -- it would undo
    pick_slot()'s reap-window reasoning, which is correct and predates this. A
    slot the sweep has just reaped has no desktop behind it and is momentarily
    unreachable, and it is precisely the capacity we want to hand out: its
    socket unit is still listening and the next letting's first request starts
    a fresh desktop. Refusing a visitor while such a slot stood free is the exhaustion
    defect wearing a reachability check. So reachability stays where it already
    was -- a PREFERENCE ORDER inside pick_slot() and a warning in the banner --
    and the table is the only thing that decides membership.

    The asymmetry that follows, stated because it is the whole behaviour: a name
    in the socket directory that is not in the table is never offered; a name in
    the table with nothing listening still is.

    A SENTINEL RATHER THAN None FOR "READ IT YOURSELF", and the first version of
    this did use None for both. That collision means ephemeral_slots(None) --
    "here is the table, and it could not be read" -- returns the whole pool of
    whatever is on disk instead of None. assert_pool_is_typed() below went red on
    it at the first start, which is the only reason it is not in this file: the
    two meanings are indistinguishable at every call site and the wrong one
    permits.
    """
    table = slot_table() if table is _READ_IT else table
    if table is None:
        return None
    return sorted(inst for inst, kind in table if kind == "ephemeral")


def assert_pool_is_typed(read_table=slot_table, pool=ephemeral_slots):
    """Prove the mint pool comes from the typed table, at every start.

    Takes both halves as parameters for the same reason the other three do: a
    version that built its own reader could not go red for any implementation
    but the one it already trusted.

    THE ARM THAT CATCHES THE PREDECESSOR is the last one, and it is the whole
    reason this exists. Against the code this replaces -- os.listdir() on the
    proxy run directory, filtered on a ".sock" suffix -- "named0" and "zz-probe"
    are both in the pool, because the directory is where the answer came from
    and every instance on the box binds into it. Against this code they are not,
    because the answer comes from the file that carries the type. Both names are
    the measured cases from socket_filenames()'s own docstring, 2026-09-22.

    THE PERMIT ARM IS NOT OPTIONAL. A pool that returned nothing at all would
    satisfy every refusal below and would refuse every visitor on a healthy box,
    which is the exhaustion defect arriving as a fix.

    Four refusals, each a different way the old answer was wrong:

      named0     typed "desktop"  -- a person's long-lived session, in the same
                                     socket directory, offered to a stranger
      legacy     no type column   -- a table written before the column existed;
                                     defaulting it to "ephemeral" would do the
                                     same damage to every row of an old file
      zz-probe   only a filename  -- the "touch zz-probe.sock" case; it is in no
                                     table at all
      unreadable table            -- must be None and not [], because [] says
                                     "no slots are configured" and a caller
                                     cannot tell that from "I could not look"

    WHAT IT DOES NOT SEE, written down because an unlisted blind spot is read as
    exhaustive: nothing here opens a socket, reads /proc/net/unix or asks
    systemd. It is entirely about which names the pool contains. Whether one of
    them can be served is slot_unreachable()'s question and deliberately does
    NOT filter the pool -- see ephemeral_slots().
    """
    import tempfile

    d = tempfile.mkdtemp(prefix="hdw4s-demux-pool-")
    try:
        path = os.path.join(d, "instances")
        with open(path, "w") as f:
            f.write("# an administrator's comment, and a blank line follows\n\n")
            f.write("0 eph0 ephemeral\n")
            f.write("1 named0 desktop\n")
            f.write("2 eph1 ephemeral\n")
            f.write("3 legacy\n")
            f.write("4 tmpl template\n")
        table = read_table(path)
        assert table is not None, \
            "a readable slot table was reported unreadable, so every refusal" \
            " below would pass for the wrong reason"
        got = pool(table)

        # PERMIT ARM, inside the space searched.
        assert got == ["eph0", "eph1"], \
            "the ephemeral rows of a table are %r, and the pool said %r" \
            % (["eph0", "eph1"], got)
        # REFUSE ARMS.
        assert "named0" not in got, \
            "a row typed 'desktop' was offered as ephemeral capacity: a named" \
            " desktop can be handed to a stranger"
        assert "legacy" not in got, \
            "a row with no type column was treated as ephemeral; every row of" \
            " a table written before that column existed is a named desktop"
        assert "zz-probe" not in got, \
            "a name that is in no table at all reached the pool, so the pool" \
            " is still being computed from something other than the table"
        # THE ARM THIS FEATURE RESTS ON. The administrator's authoring slot is
        # ephemeral in every mechanical respect the CLI cares about -- same
        # unit, same tmpfs home, same filesystem socket -- and the ONE thing
        # that keeps it away from strangers is that this filter names
        # "ephemeral" exactly rather than "ephemeral-shaped". Handing it out
        # gives a visitor the desktop the template is authored in, with the
        # submit control in it. There is no second check behind this one.
        assert "tmpl" not in got, \
            "a row typed 'template' was offered as ephemeral capacity: the" \
            " next visitor at the well-known hostname is handed the" \
            " administrator's authoring desktop"

        # The unreadable case, and it must be told apart from an empty one.
        missing = read_table(os.path.join(d, "no-such-file"))
        assert missing is None, \
            "an unreadable slot table was reported as a table with no rows;" \
            " a caller cannot tell 'none configured' from 'I could not look'"
        assert pool(None) is None, \
            "the pool turned an unreadable table into an empty pool, which" \
            " refuses every visitor with nothing in the log naming the file"

        # An EMPTY table is a different fact again, and must survive as one.
        empty = os.path.join(d, "empty")
        with open(empty, "w") as f:
            f.write("# nothing but a comment\n")
        assert pool(read_table(empty)) == [], \
            "an empty but readable table did not produce an empty pool"
    finally:
        import shutil
        shutil.rmtree(d, ignore_errors=True)


def idle_windows(complain=None):
    """[(instance, seconds)] for every EPHEMERAL slot the pool is configured
    with; seconds is 0 for "never reaped" and None for "cannot be read".

    Zero is kept as 0 rather than folded into a large number, because the two
    need different handling and a large number would let an unbounded case
    masquerade as a bounded one. None is kept apart from both for the same
    reason one step further along.

    Read from the instance table and the conf files rather than asked of the
    service manager. That is the CLI's precedence for THIS key -- the ephemeral
    unit sets several values in Environment=, but not this one -- and it is the
    reason cookie_policy_complaints() re-reads and re-checks at runtime instead
    of trusting the start-time answer forever.

    complain is where an unreadable value is reported. It defaults to log()
    because the one thing this must never do is read a value it cannot parse
    and say nothing; pass a collector where the caller wants to place the
    message itself.
    """
    complain = log if complain is None else complain
    rows = []
    names = ephemeral_slots()
    if names is None:
        # Unchanged behaviour on purpose: this function's callers derive a
        # cookie lifetime and a refusal report, and an empty set degrades both
        # safely. The mint path asks ephemeral_slots() directly, where the
        # difference between "none configured" and "cannot read" is the
        # difference between a 503 and a 503 with the file named in the log.
        return rows
    for inst in names:
        secs, why = read_idle_window(inst)
        if why:
            complain("WARNING: %s: %s" % (inst, why))
            complain("  Nothing here will guess a window for it. Until it is"
                     " fixed this slot is treated as one that is never reaped,"
                     " which is the cautious reading and not a default.")
        rows.append((inst, secs))
    return rows


def derive_cookie_lifetime(windows):
    """Seconds an identity lasts, from the pool's own idle windows.

    A window of None -- unreadable -- contributes nothing, exactly as 0 does.
    Neither may SHORTEN the identity: an unknown window could be longer than
    any guess, so the honest answer is the floor plus a complaint, not a
    number derived from something nobody read.
    """
    longest = 0
    for _, secs in windows:
        if secs:
            longest = max(longest, secs)

    # CLAMPED TO WHAT A BROWSER WILL ACTUALLY KEEP. Without the min() this
    # returned 2 * longest unbounded, so a 500d window produced "an identity
    # lasts 1000 day(s)" -- a sentence about a cookie that has never existed.
    # Everything downstream then reasoned from it, including the check whose
    # whole job is to notice the owner being locked out.
    #
    # Clamping does not FIX a window past the crossover; nothing here can. It
    # makes the number honest, which is what lets cookie_policy_complaints()
    # see the gap -- it compares each window against this value, so handed the
    # true ceiling it reports the lockout unprompted. The repair is one
    # subtraction from the same place the defect came from.
    return min(BROWSER_COOKIE_CAP_SECONDS,
               max(COOKIE_FLOOR_SECONDS, 2 * longest))


def cookie_policy_complaints(lifetime, windows):
    """Every slot whose desktop can outlive the identity that owns it.

    This is the arm that can actually go red, and the derivation above is not.
    derive_cookie_lifetime() cannot return a value smaller than twice its own
    input, so pointing this at its own output at the same instant proves
    nothing -- a check that cannot fail by construction, which is the shape this
    file already keeps one example of on purpose.

    What makes it a real check is that the lifetime is PINNED AT START and the
    windows are not: a conf file edited afterwards, or a slot added to the pool,
    moves one clock and not the other. So this takes a lifetime and a freshly
    read set of windows and is run again later, where the two can disagree.
    """
    out = []
    for inst, secs in sorted(windows, key=lambda r: r[0]):
        if secs is None:
            out.append("%s has an idle window nobody can read, so how long its "
                       "desktop is kept is unknown and may exceed any identity;"
                       " fix the value rather than leaving it to be guessed"
                       % inst)
        elif secs <= 0:
            out.append("%s is never reaped for idleness, so its desktop can "
                       "outlive any identity; give it a nonzero idle window"
                       % inst)
        elif secs >= lifetime:
            out.append("%s keeps a desktop for %s, which is not shorter "
                       "than the %d-day identity pinned at start; restart the "
                       "front door to pick the new window up"
                       % (inst, describe_window(secs), lifetime // 86400))
    return out


# How often the check above is asked again on a running box. Not a tuning
# number: the condition it looks for is a person editing a conf file, and the
# response is a person restarting the front door, so anything inside the human
# loop is fast enough. Fifteen minutes re-reads a handful of small files on a
# tmpfs and costs nothing measurable.
COOKIE_POLICY_EVERY = 900.0


def poll_cookie_policy(seen, lifetime, windows=None, say=None):
    """Ask cookie_policy_complaints() again, and say only what CHANGED.

    THE GAP THIS CLOSES. The complaint is real, it can genuinely go red, and
    until now the only two things that ever asked it were main() at start and
    log_refusal() when the pool was exhausted. So an administrator who raises
    HDW4S_IDLE_DAYS on a running box moves the desktop clock and not the
    identity clock -- the single state this file's own essay calls
    indefensible, a desktop alive with its owner locked out -- and nothing says
    so until somebody is turned away. On a box with a spare slot that is never.
    A check whose trigger is a second failure is not a check on the first one.

    WHY IT SAYS ONLY WHAT CHANGED, and this is the whole of the design rather
    than a politeness. A timer that restated a standing complaint every fifteen
    minutes would put the same line in the log four times an hour for as long
    as the condition lasted, and a check that fires on an ordinary state gets
    turned off -- after which it protects nothing at all, which is strictly
    worse than the gap it was written for. So the state is carried in SEEN and
    only the difference is printed: silent while nothing moves, loud once at
    the moment it moves, and loud again when it clears.

    A complaint DISAPPEARING is reported too. The instrument that raised a
    question is the one that should close it; leaving the log with a warning
    and no retraction teaches a reader that the warnings do not mean anything.

    WHAT WAS REJECTED.

      An external timer unit. There is already an hdw4s-check.timer and it
      looks like the tidy home for this, and it cannot do the job: the
      comparison is between a lifetime PINNED INSIDE THIS PROCESS and the
      configuration on disk. Another process would have to guess the pinned
      value, and a check that guesses one of its two inputs is answering a
      different question. That is decisive, and it is why this is a thread.

      Firing on every arrival, rate limited. Cheaper to reason about, but it
      makes the trigger a visitor again -- a quieter visitor than a refused
      one, but the box this is written for is the box nobody is visiting.

      Watching the files for changes instead of re-reading them. It fires
      exactly when the condition can newly become true, which is elegant, and
      it buys nothing here: the answer is wanted within minutes, not
      milliseconds, and a watch adds descriptors, a failure mode when a file is
      replaced rather than written, and a second mechanism to keep true.

      Making it fatal, or restarting ourselves when the configuration moves.
      The warning's own text says the repair is to restart the front door.
      Doing that unasked would drop every live session to fix a number that
      only matters to arrivals, and the operator is the one who gets to choose
      the moment.

    Takes the windows and the reporter as parameters so it can be handed a pool
    it did not read and a collector that is not the log -- the arms below are
    exercised without a conf file, and a version that read its own inputs could
    not have been.
    """
    say = log if say is None else say
    if windows is None:
        # The default reporter is swallowed here and nowhere else. idle_windows()
        # shouts about an unreadable value, which is right on a path that runs
        # once; on a path that runs every fifteen minutes forever it is the
        # repetition this function exists to avoid. Nothing is lost: an
        # unreadable window has its own complaint in the set below, and that one
        # is printed on the transition like any other.
        windows = idle_windows(complain=lambda _m: None)
    now = set(cookie_policy_complaints(lifetime, windows))
    for complaint in sorted(now - seen):
        say("WARNING: %s" % complaint)
        say("  Nobody was turned away to produce this line. The pool's"
            " configuration has moved under an identity lifetime that was"
            " pinned at start, so a desktop can now outlive the identity that"
            " owns it -- and its owner then cannot reach it or close it.")
    gone = seen - now
    if gone:
        say("the identity-lifetime warning no longer applies (%d cleared):"
            " every configured window is now shorter than the pinned"
            " identity." % len(gone))
    return now


def watch_cookie_policy(lifetime, seen=None, every=COOKIE_POLICY_EVERY):
    """Run poll_cookie_policy() forever. Started as a daemon thread by main().

    SEEN is seeded with what main() already printed, so a standing complaint is
    stated once at start rather than again fifteen minutes later.

    It sleeps FIRST and swallows nothing but its own failure to read: this runs
    beside the accept loop, and a thread that dies takes the check with it
    silently, which is the shape of defect the whole file is about. A failure
    to read the pool is therefore reported and the loop continues.
    """
    seen = set() if seen is None else set(seen)
    while True:
        time.sleep(every)
        try:
            seen = poll_cookie_policy(seen, lifetime)
        except Exception as e:      # noqa: BLE001 -- see above
            log("WARNING: the identity-lifetime re-check failed: %r" % e)
            log("  It will be tried again, but until it succeeds nothing is"
                " watching for a widened idle window.")


def assert_cookie_outlives_idle(derive=derive_cookie_lifetime):
    """Prove the derivation, in BOTH directions, at every start.

    Takes the derivation as a PARAMETER for the same reason
    assert_ownership_keying() takes a factory: a version that built its own
    answer and checked that could not fail for any implementation but the one it
    already trusted. Handed the value that ships today -- a flat seven days,
    equal to the default idle window -- this goes red, and that is how it was
    seen to go red rather than merely written.
    """
    # THE SHARP ONE FIRST, deliberately. The floor checks below are also real,
    # but a broken derivation usually trips both, and whichever runs first is
    # the message the reader gets. "Under the floor" is a tuning complaint;
    # "the owner is locked out of a running desktop" is the defect, and that is
    # what a red arm here should say.
    #
    # For every window a pool could plausibly carry, the identity must outlive
    # the desktop -- strictly, not equally. Equal is the shipped defect: the
    # person is locked out at the moment the desktop is still there.
    # In SECONDS, and the sub-day probes are not decoration. The windows were
    # whole days here, so 12h and 90m -- forms the tool accepts and the manual
    # names -- could not be represented at all: they truncated to zero, which
    # this file reads as "never reaped". A repair that only fixed the parsing
    # would have turned a silent week into a silent forever.
    # THE CEILING OF THIS LIST WAS THE SECOND HALF OF THE DEFECT. It stopped at
    # 31536000 -- 365 days -- which sits BELOW the 400-day browser cap, so every
    # probe landed in the region where the derivation happens to be unclamped
    # and the check could not reach the case it exists to find. A guard whose
    # inputs all avoid the failing region passes forever without being wrong
    # about any of them.
    for secs in (5400, 43200, 86400, 604800, 1209600, 2592000, 7776000,
                 31536000, 34560000, 43200000):
        got = derive([("probe", secs)])
        # THE CROSSOVER IS THE CAP ITSELF, not half of it. Written first as
        # `secs * 2 <= cap`, which is where the clamp starts BITING -- but a
        # clamped 400-day identity still outlives a 365-day desktop perfectly
        # well. That version demanded a complaint about a pool that is fine,
        # and the suite said so. The guarantee survives right up to the cap.
        if secs < BROWSER_COOKIE_CAP_SECONDS:
            assert got > secs, (
                "an identity lasting %d second(s) does not outlive a desktop "
                "kept for %d second(s): the owner is locked out of a session "
                "that is still running" % (got, secs))
            continue

        # PAST THE CROSSOVER THE GUARANTEE IS NOT AVAILABLE, and saying so is
        # the honest arm rather than a weaker one. No value we return can make
        # an identity outlive a desktop kept longer than the browser will hold
        # the cookie. Two things must then be true, and BOTH are checked
        # because either alone is satisfiable by a broken derivation:
        #
        #   the number must be clamped -- claiming more is describing a cookie
        #   that does not exist, which is precisely what shipped;
        #   and the operator must be TOLD -- a clamp on its own converts a loud
        #   wrong number into a quiet right one, which is worse.
        assert got <= BROWSER_COOKIE_CAP_SECONDS, (
            "the derivation claimed an identity of %d second(s), longer than "
            "the %d second(s) a browser will keep the cookie: a promise about "
            "a cookie that does not exist"
            % (got, BROWSER_COOKIE_CAP_SECONDS))
        assert cookie_policy_complaints(got, [("probe", secs)]), (
            "a desktop kept for %d second(s) outlives the %d second(s) the "
            "browser keeps the identity, and nothing complained"
            % (secs, got))

    # PERMIT ARM. A pool with nothing to derive from, one whose slots are never
    # reaped at all, and one whose window cannot be read, must each still
    # produce a lifetime rather than zero.
    assert derive([]) >= COOKIE_FLOOR_SECONDS, \
        "an empty pool produced no identity lifetime at all"
    assert derive([("a", 0)]) >= COOKIE_FLOOR_SECONDS, \
        "a pool that is never reaped produced no identity lifetime at all"
    assert derive([("a", None)]) >= COOKIE_FLOOR_SECONDS, \
        "a pool with an unreadable window produced no identity lifetime at all"

    # And the floor is a floor, not a value: a pool with a long window must
    # raise it rather than be clamped to it.
    assert derive([("probe", 90 * 86400)]) > COOKIE_FLOOR_SECONDS, \
        "a long idle window was clamped to the floor"


# --------------------------------------------------------------------------
# Ownership
# --------------------------------------------------------------------------

OWNERSHIP_FILE = os.path.join(STATE_DIR, "ownership.json")

# The fields of a letting that are written down. Everything else a record may
# carry is about this process's own connections and means nothing to the next one.
OWNERSHIP_FIELDS = ("identity", "instance", "minted", "live", "incarnation",
                    "ended", "ended_at")


class Ownership:
    """identity -> the sessions it owns, and sid -> the slot behind it.

    Append-only by construction, because the ruling is that sharing is additive
    and nothing is ever revoked. The only pruning is of sids whose session is
    gone, and pruning one NEVER hands its slot to the sid's old owner.

    WRITTEN DOWN, SO THAT IT OUTLIVES THIS PROCESS AND NOT THE BOOT. It used to
    live in memory alone, and every restart of this service -- a deploy, a
    package upgrade, Restart=on-failure -- cut every visitor off from a desktop
    that went on running. Measured on production 2026-09-27: after a deploy
    restarted the router at 16:02:50, the owner's own running desktop answered
    410 to every request its tab made, and would have run unowned for the full
    seven-day idle window. PATH is a file under this service's RuntimeDirectory=,
    which hdw4s-demux.service preserves across a restart and /run loses at a
    reboot -- the same two lifetimes the reservation needs, and for the same
    reason: after a reboot no desktop is running, so a table describing them
    would describe nothing.

    WHAT A STALE ROW COSTS is the gate, not a desktop. A row whose desktop ended
    while the router was down resolves, is judged by session_replaced() against
    the authority on its first request, and is forgotten there -- which is what
    happens to a row whose desktop is reaped while the router is up.

    PATH None is a table that lives in this process only, which is what every
    start-up self-check builds.
    """

    def __init__(self, path=None):
        self._lock = threading.Lock()
        # HELD ACROSS "WHICH SLOT IS FREE" AND "IT IS NOW LET", by let_slot()
        # and by reclaim_slot(), and by nothing else. Not self._lock, which
        # guards the table for the length of one method and is taken INSIDE
        # the pick (pending_mints()); this one is always taken first and
        # never while self._lock is held, so the two cannot deadlock.
        self.letting = threading.Lock()
        # sid -> {"identity", "instance", "minted"}
        self._by_sid = {}
        # identity -> [sid, ...] in mint order
        self._by_identity = {}
        # identity -> when we last wound its cookie on. Purely a rate limit on
        # Set-Cookie headers, never an authority on anything: losing it on a
        # restart costs one extra header per identity and nothing else, which is
        # why it is allowed to live here rather than on disk.
        self._refreshed = {}
        self._path = path
        if path is not None:
            self._load()

    def _load(self):
        """Take back the lettings a previous run of this router wrote down.

        A table that cannot be read is an EMPTY one, said out loud: that is the
        state every restart used to produce, and the cost is the gate for every
        tab that was open -- the designed damage, never a desktop handed to the
        wrong browser. A row that is not the shape this file writes is dropped
        for the same reason, and counted.
        """
        try:
            with open(self._path, "r", encoding="utf-8") as f:
                data = json.load(f)
        except FileNotFoundError:
            return
        except (OSError, ValueError) as e:
            log("WARNING: the ownership table at %s could not be read (%s); "
                "starting without it. Every tab that was open meets the "
                "ended page." % (self._path, e))
            return
        rows = data.get("sessions") if isinstance(data, dict) else None
        if not isinstance(rows, dict):
            log("WARNING: the ownership table at %s is not one this router "
                "wrote; starting without it." % self._path)
            return
        # CHECKED BEFORE SORTED. Sorting first compared "minted" across rows,
        # and one row with a string there raised TypeError at start -- a router
        # that crash-loops on its own state file, for as long as the file lives.
        try:
            good = [(sid, rec) for sid, rec in rows.items()
                    if _letting_is_well_formed(sid, rec)]
            dropped = len(rows) - len(good)
            for sid, rec in sorted(good, key=lambda kv: kv[1]["minted"]):
                row = {k: rec.get(k) for k in OWNERSHIP_FIELDS}
                self._by_sid[sid] = row
                self._by_identity.setdefault(row["identity"], []).append(sid)
        except Exception as e:
            # Whatever the file held, it must not stop the front door starting.
            self._by_sid.clear()
            self._by_identity.clear()
            log("WARNING: the ownership table at %s could not be taken back "
                "(%r); starting without it." % (self._path, e))
            return
        log("took back %d letting(s) from %s%s"
            % (len(self._by_sid), self._path,
               "" if not dropped else "; %d malformed row(s) dropped" % dropped))
        # A TABLE WRITTEN BY A ROUTER THAT DID NOT DO THIS AT MINT carries
        # lettings whose desktops ended with no tab coming back to say so, and
        # each of them disarmed every later reclaim of its slot. Settled here,
        # once, by the same rule mint_session() now applies as it goes -- so an
        # upgrade cleans the table it inherits and nobody has to wipe it.
        settled = 0
        with self._lock:
            newest = {}
            for sid, r in self._by_sid.items():
                if r["minted"] > newest.get(r["instance"], (None, -1.0))[1]:
                    newest[r["instance"]] = (sid, r["minted"])
            for inst, (sid, minted) in newest.items():
                settled += self._supersede_locked(inst, sid, minted)
            if settled:
                self._save()
        if settled:
            log("marked %d letting(s) ended: a later letting of the same slot "
                "was made after each, so its desktop had already gone"
                % settled)

    def _save(self):
        """Write the table down. Called with self._lock HELD, after a change.

        Written beside the file and renamed over it, so a reader -- the next run
        of this router -- sees the old table or the new one and never half of
        either. Opening the real file for writing would truncate it first, and a
        crash in between would lose every letting at once.

        A failure is logged and changes nothing else: the table in memory is
        still right, and what is lost is only what a restart would have kept.
        """
        if self._path is None:
            return
        rows = {sid: {k: rec.get(k) for k in OWNERSHIP_FIELDS}
                for sid, rec in self._by_sid.items()}
        tmp = self._path + ".new"
        try:
            fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o600)
            with os.fdopen(fd, "w", encoding="utf-8") as f:
                json.dump({"version": 1, "sessions": rows}, f)
            os.replace(tmp, self._path)
        except OSError as e:
            log("WARNING: could not write the ownership table to %s: %s. A "
                "restart of this router now would cut visitors off from their "
                "desktops." % (self._path, e))

    def due_for_refresh(self, identity, now=None, every=COOKIE_REFRESH_EVERY):
        """True when the next response to this identity should carry a cookie.

        Says yes the first time it is asked about an identity, so a browser
        whose cookie predates a restart is wound on immediately rather than
        after an hour of holding a cookie nobody here has refreshed.
        """
        now = time.time() if now is None else now
        with self._lock:
            last = self._refreshed.get(identity)
            if last is not None and now - last < every:
                return False
            # Bounded, because an open front door can be handed an unlimited
            # number of distinct cookies by anything that can reach it, and this
            # dict is the only structure here that a stranger can grow without
            # owning a session. Dropping the table costs one redundant header.
            if len(self._refreshed) > 20000:
                self._refreshed.clear()
            self._refreshed[identity] = now
            return True

    def mint_identity(self):
        return secrets.token_hex(16)

    def mint_session(self, identity, instance):
        """Record that IDENTITY now holds INSTANCE. No desktop exists yet."""
        sid = secrets.token_hex(16)
        with self._lock:
            self._by_sid[sid] = {
                "identity": identity,
                "instance": instance,
                "minted": time.time(),
                # Filled in by attach() once a desktop has actually answered.
                "live": False,
                "incarnation": None,
                # WHY A SESSION ENDED, SET BY US, AND WHY IT IS NOT DERIVED.
                # Every other signal that a letting is over is read from the
                # world -- a runtime directory, a listening port, a published
                # token -- and every one of them goes on saying "healthy" for
                # seconds after a teardown has been asked for. Measured on
                # production 2026-09-26: a discard at 14:33:45, the session
                # gone at 14:33:48, and in between the visitor's own tab
                # retried, was proxied, and SOCKET-ACTIVATED A FRESH DESKTOP in
                # the slot it had just released. This field is the one fact no
                # instrument can be late about, because it is the act itself.
                "ended": None,
            "ended_at": None,
            }
            self._by_identity.setdefault(identity, []).append(sid)
            self._supersede_locked(instance, sid, self._by_sid[sid]["minted"])
            self._save()
        return sid

    def _supersede_locked(self, instance, sid, minted):
        """Mark every earlier letting of INSTANCE ended. Called with _lock HELD.

        A RECORDED FACT, NOT AN INFERENCE FROM AN INSTRUMENT. A slot is let only
        when nothing holds it -- no desktop in it, no fresh mint on it, no
        teardown under way (slots_in_use(), under the letting lock) -- so by the
        time a later letting exists, the desktop of every earlier one had
        already gone. Nothing else ever says so when no tab comes back: such a
        letting stayed live and un-ended in this table for as long as the table
        lived, and holders_of() counted it. Measured on a development box
        2026-09-28: three lettings whose desktops had logged out with no tab
        open, and the reclaim of a desktop later started in that slot for
        nobody answered "has been let to somebody else since" and gave up. It
        then ran for nobody until the idle sweep, seven days on a stock box.

        ended_at stays None: this is not a discard, and the directory lists an
        ended row only while a discard is plausibly still under way.
        """
        n = 0
        for s, r in self._by_sid.items():
            if s != sid and r["instance"] == instance and \
                    r["minted"] < minted and not r.get("ended"):
                r["ended"] = ("%s was let again after this letting, so the "
                              "desktop it had was already gone" % instance)
                n += 1
        return n

    def attach(self, sid, incarnation):
        """Record that a desktop has answered for SID, and which start it is.

        NOT DONE AT MINT, and the first version did it there and gated every
        visitor in the pool. A mint precedes its session: the redirect is what
        sends the browser at the slot, and the session is started at that first
        request. So at mint time the token on disk belongs to the
        PREVIOUS occupant -- it survives a reap, measured -- and the session
        that is about to start will publish a different one. Comparing against
        the value read at mint therefore refused every brand-new session as
        "replaced", which is the check working perfectly on the wrong instant.

        Written once and then left alone. Refreshing it would make it agree
        with whatever is there now, which is the question and not the answer.
        """
        with self._lock:
            rec = self._by_sid.get(sid)
            if rec is None:
                return False
            if rec["live"]:
                return True
            # NOT AN ENDED OR RE-LET LETTING: its slot's desktop is somebody
            # else's, and recording that desktop's token against this letting
            # would make it this letting's. False tells the caller.
            if rec.get("ended") or any(
                    r["instance"] == rec["instance"] and
                    r["minted"] > rec["minted"]
                    for s, r in self._by_sid.items() if s != sid):
                return False
            rec["live"] = True
            rec["incarnation"] = incarnation
            self._save()
            return True

    def end_session(self, sid, why):
        """Record that this letting is OVER, from here on, whatever the box says.

        THE ORDERING DEFECT THIS EXISTS FOR, and it is why the record is marked
        rather than dropped. A visitor who discards their desktop has a tab
        still open on it, and that tab retries about every five seconds by
        design. The teardown is asynchronous -- the router may not perform it,
        see request_teardown() -- so for a second or three the slot's runtime
        directory is still there, its port is still listening and its published
        token still matches. Every guard in session_replaced() therefore reads
        HEALTHY, the request is proxied, and under the relay's old BindsTo= the
        proxy's connect() was an INSTRUCTION to systemd rather than a question:
        it started a whole new GNOME session for nobody. (A connection can no
        longer start one; the record still gates the tab at once, with the
        ended page rather than a refused round trip.) On production, where nothing sets
        HDW4S_IDLE_DAYS and the shipped default is seven days, that desktop
        then holds a slot for a week with the reaper correctly saying nothing.

        MARKED, NOT FORGOTTEN, so the visitor's own session directory can still
        say "discarding" about it. The record is dropped at the gate, on the
        first request that presents it, exactly as a reaped one is.
        """
        with self._lock:
            rec = self._by_sid.get(sid)
            if rec is not None and not rec["ended"]:
                rec["ended"] = why
                # WHEN it ended, because the two readers of this flag need
                # different lifetimes and sharing one was a defect. The
                # resurrection guard must never forget -- a stale tab may return
                # at any time, and forgetting is what let it mint. The visitor's
                # directory must forget, because a row that says "discarding"
                # for ever is a row about work that finished in seconds.
                # Measured on production 2026-09-26: a slot discarded at 19:51
                # was still listed as discarding twenty-one minutes later, with
                # its teardown long complete and the marker directory empty.
                rec["ended_at"] = time.time()
                self._save()
            return rec is not None

    def pending_mints(self, since):
        """[(instance, minted)] for slots handed out whose desktop has not
        answered yet, and only while that is still plausible.

        The half of occupancy that is ours, and it is deliberately BOTH narrow
        and short. A mint precedes the session it starts, so for a few seconds a
        slot is legitimately held on our word alone. Two bounds, and leaving out
        either one reintroduces a defect:

          not live   Once a desktop has answered, the authority says so and our
                     word is not merely unnecessary, it is WRONG. Without this
                     a slot the sweep reaped seconds after it was let stayed
                     held for the rest of the grace window, so a pool that had
                     just been freed still answered 503 -- measured against the
                     arm for exactly that, which went red with the whole window
                     applied rather than only its pending part.
          recent     Without this the table grows forever, which is how
                     instances_in_use() became monotonic and why every visitor
                     past the Nth got 503 for the life of the process.
        """
        with self._lock:
            return [(r["instance"], r["minted"]) for r in self._by_sid.values()
                    if not r["live"] and r["minted"] >= since]

    def lookup(self, sid):
        with self._lock:
            rec = self._by_sid.get(sid)
            return dict(rec) if rec else None

    def owned_by(self, identity):
        with self._lock:
            return list(self._by_identity.get(identity, ()))

    def instances_in_use(self):
        """The slots this router has a LIVE letting for. Never the ones it had.

        ENDED LETTINGS ARE NOT LETTINGS, and leaving them in was visible in
        production: the line "3 slot(s) now let" counted a slot whose desktop
        had been discarded seconds earlier and was already stopping. Nothing
        admits a visitor on this number -- slots_in_use() does that, from the
        authority -- but an operator reads it, and a count that only ever goes
        up is the monotonic defect this table has had once already, wearing a
        log line instead of a 503.
        """
        with self._lock:
            return {r["instance"] for r in self._by_sid.values()
                    if not r.get("ended")}

    def holders_of(self, instance, besides=None, since=None, now=None):
        """Every sid whose letting names INSTANCE, other than BESIDES, and
        that may still have a desktop in it.

        SINCE, when given, is the mint time of the letting asking: only a
        letting made AFTER it can be "somebody else since". One made before it
        had lost its desktop before the asker was let the slot (see
        _supersede_locked()), and counting it is what disarmed the reclaim.
        A letting that never had a desktop answer it and is past MINT_GRACE
        holds nothing either: that is session_replaced()'s own bound.

        ASKED RATHER THAN INFERRED FROM CALL ORDER, and that is the whole reason
        it is a method here instead of a set difference at the call site. The
        one caller wants "has anybody ELSE been let this slot", and it runs
        beside a forget() of its own sid -- so a version written as "is this
        instance in instances_in_use()" would answer correctly only while the
        forget stayed on the right side of it, and would start answering "yes,
        me" the day somebody moved one line. The answer it would then give
        permits nothing, but the call site that depends on it DESTROYS a
        desktop, and a guard whose correctness is a property of statement order
        is not a guard.
        """
        now = time.time() if now is None else now
        with self._lock:
            return [s for s, r in self._by_sid.items()
                    if r["instance"] == instance and s != besides
                    and (since is None or r["minted"] > since)
                    and (r.get("live") or now - r["minted"] < MINT_GRACE)
                    # AN ENDED LETTING DOES NOT HOLD A SLOT, and counting one
                    # disarmed the reclaim completely. Measured on production
                    # 2026-09-26: "did not reclaim a slot: ephemeral0 has been
                    # let to somebody else since", about a slot let twice to the
                    # SAME visitor, where the somebody else was their own
                    # discarded session still sitting in this table. Nothing
                    # ever removed it, so every slot that had been let twice was
                    # permanently unreclaimable -- the leak's second half, and
                    # it hid behind a refusal that reads like the guard working.
                    and not r.get("ended")]

    def superseded(self, sid):
        """True when the slot SID names has been let AGAIN since SID was minted.

        A letting whose slot was re-let is never the current one, whatever the
        slot shows: the desktop in it, if any, belongs to the later letting. The
        pool holds a slot for a pending letting for MINT_GRACE, so this should
        be unreachable while the time bound in session_replaced() holds; it is
        asked anyway, because the damage if it is reached is a stranger's
        desktop with full input.
        """
        with self._lock:
            rec = self._by_sid.get(sid)
            if rec is None:
                return False
            return any(r["instance"] == rec["instance"] and
                       r["minted"] > rec["minted"]
                       for s, r in self._by_sid.items() if s != sid)

    def forget(self, sid):
        """Drop a sid whose session is gone. Its slot is NOT reassigned here."""
        with self._lock:
            rec = self._by_sid.pop(sid, None)
            if rec:
                owned = self._by_identity.get(rec["identity"])
                if owned and sid in owned:
                    owned.remove(sid)
                self._save()
            return rec


_SID_SHAPE = r"^[0-9a-f]{32}$"
_SLOT_SHAPE = r"^[A-Za-z0-9._-]+$"


def _letting_is_well_formed(sid, rec):
    """True when a row read back from disk is one this file could have written.

    Checked because the row decides whose desktop a request reaches, and a row
    that is not the shape mint_session() makes is not evidence of anything --
    it is dropped, which sends its tab to the gate.
    """
    if not isinstance(sid, str) or not re.match(_SID_SHAPE, sid):
        return False
    if not isinstance(rec, dict):
        return False
    if not isinstance(rec.get("identity"), str) or not rec["identity"]:
        return False
    if not isinstance(rec.get("instance"), str) or \
            not re.match(_SLOT_SHAPE, rec["instance"]):
        return False
    if not isinstance(rec.get("minted"), (int, float)) or \
            isinstance(rec.get("minted"), bool):
        return False
    if not isinstance(rec.get("live"), bool):
        return False
    for k in ("incarnation", "ended"):
        if rec.get(k) is not None and not isinstance(rec.get(k), str):
            return False
    if rec.get("ended_at") is not None and \
            not isinstance(rec.get("ended_at"), (int, float)):
        return False
    return True


def assert_ownership_keying(factory=Ownership):
    """Prove the recycling guard, in BOTH directions, at every start.

    A guard that has never rejected anything is not known to reject anything --
    and a guard that refuses everything would also look green, so this asserts
    the permit arm as well as the refuse arm. It runs at startup rather than
    only in a test file, because the failure it prevents is silent and
    unrecoverable: a stranger's desktop handed over by our own ownership check.

    It takes a FACTORY rather than nothing, and that is the whole point. The
    first version of this function built its own Ownership() and ignored what it
    was handed, so it could not fail for any implementation but the one it
    already trusted -- a check that cannot fail by construction, which is the
    exact defect it exists to catch. It was caught by pointing it at a
    deliberately slot-keyed table and finding it still green. Keep the
    parameter: without it this is decoration.
    """
    probe = factory()

    a = probe.mint_identity()
    b = probe.mint_identity()
    assert a != b, "two identities minted the same value"

    # A owns a session on a slot.
    sid_a = probe.mint_session(a, "ephemeral0")

    # PERMIT ARM. A's own sid must still resolve to A's session. Without this a
    # guard that simply refused everything would pass the arm below.
    rec = probe.lookup(sid_a)
    assert rec and rec["identity"] == a and rec["instance"] == "ephemeral0", \
        "the owner of a live session was not routed to it"

    # The session is reaped and the SLOT is recycled to B.
    probe.forget(sid_a)
    sid_b = probe.mint_session(b, "ephemeral0")

    # REFUSE ARM. A returns with its cookie and its old address.
    assert probe.lookup(sid_a) is None, \
        "a reaped session's address still resolves"
    assert sid_a not in probe.owned_by(a), \
        "a reaped session is still listed as owned"

    # And the sharp one: A must not reach B's desktop, although B is now on the
    # very slot A used to hold. This is the assertion that goes red the moment
    # anyone keys the table on the slot instead of the session instance.
    assert sid_b != sid_a, "a recycled slot reissued the same session address"
    rec_b = probe.lookup(sid_b)
    assert rec_b["identity"] == b, "the recycled slot's session is not B's"
    for sid in probe.owned_by(a):
        assert probe.lookup(sid)["identity"] == a, \
            "identity A owns a session belonging to someone else"


# --------------------------------------------------------------------------
# Everything this process remembers, and what each piece of it is FOR
# --------------------------------------------------------------------------
#
# The two guards above each prove one invariant. This one proves something
# weaker and broader, and it exists because of what the two of them cannot see:
# they say nothing at all about state that did not exist when they were written.
#
# THE FAILURE IT IS AIMED AT. Every defect this file carries a paragraph about
# is the same shape -- two records of one fact drifting apart, or one record
# being read as a different kind of thing than it is. The cookie was a fuse
# because a lifetime was read as a sliding window. The ownership table was
# nearly keyed on the slot because an address was read as an identity. A
# desktop's last-request time and the sweep's sample of it are two clocks that
# disagree, and saying so out loud is the whole of log_refusal(). In each case
# the code was correct line by line and the mistake was in what the state MEANT.
#
# So the inventory below records the meaning, in three kinds, and the kinds are
# not decoration -- they are what tells a reader whether losing the thing is a
# cost or a catastrophe:
#
#   authority     Somebody is refused or admitted on the strength of it. Losing
#                 it loses a person their desktop. It may never be rebuilt from
#                 a guess, and a second copy of it is a second answer.
#   cache         An answer we could recompute. Losing it costs time and
#                 nothing else. If losing one can change a decision it was
#                 never a cache, and calling it one is how the mistake starts.
#   rate limiter  A record of when we last did something, kept only to avoid
#                 doing it too often. Losing it costs one redundant action.
#                 The tell is that clearing it wholesale must be harmless --
#                 due_for_refresh() does exactly that when it grows too large,
#                 which is only sound BECAUSE it is this kind.
#
#   not state     Listed although it records nothing, because the alternative
#                 to listing it is an exemption no reader can see, and an
#                 unwritten exemption is the same defect as an unlisted
#                 container. Two of them: the one write this module makes into
#                 somebody else's namespace, and this table itself, which is a
#                 dict and was duly reported by its own first run.
#
# WHY A LIST AND NOT A CONVENTION. Whoever adds the next container will also be
# correct line by line. The list is cheap to satisfy and impossible to satisfy
# by accident: it cannot be filled in without answering "which of the three is
# this", and that question is the one nobody asked about the cookie or the
# ownership key.
#
# WHAT THIS DELIBERATELY DOES NOT CLAIM, because a list read as exhaustive is
# worse than no list -- it silently permits whatever it forgot:
#
#   * Only module-level and class-level state is inventoried, plus the
#     attributes one instance of the ownership table is born with. State a
#     function builds and hands to something that keeps it is invisible here.
#   * An imported module's namespace is not walked. DURATION is the grammar
#     this file reads its idle windows with; nothing here writes to it, and
#     nothing here would notice if something did.
#   * A lock is not state and is skipped by type. A lock guards an answer, it
#     never holds one, and losing one costs no answer -- but note what that
#     means: this cannot see a lock protecting the wrong table.
#   * It is a bookkeeping check. It asks whether somebody wrote down what a
#     piece of state is for. It cannot tell whether what they wrote is TRUE.

STATE_KINDS = ("authority", "cache", "rate limiter", "not state")

STATE_INVENTORY = {
    # Who owns which session. The refusal in serve() is decided from this, and
    # it is the reason a reaped slot does not hand a stranger a desktop.
    "Ownership._by_sid": "authority",
    # The other direction of the same fact, and the one arrival() resumes from.
    "Ownership._by_identity": "authority",
    # When each identity's cookie was last wound on. Cleared wholesale above
    # the bound; the cost of that is one redundant Set-Cookie header.
    "Ownership._refreshed": "rate limiter",
    # When each slot's last-request file was last rewritten. Losing it costs
    # one extra write to a tmpfs.
    "_touched": "rate limiter",
    # Which refusals have been logged. Cleared wholesale above its bound; the
    # cost of that is one repeated log line per session still being refused.
    "_SAID": "rate limiter",
    # Rebound once, by main(), from the pool the box is configured with. An
    # authority: it is the Max-Age a browser is handed, so a wrong value locks
    # somebody out of a running desktop. Pinned on purpose -- and pinned is
    # exactly why cookie_policy_complaints() has to be asked again against a
    # freshly read pool rather than against the value it was derived from.
    "COOKIE_LIFETIME": "authority",
    # Set by load_duration() so that importing the grammar beside this script
    # cannot leave a .pyc behind. An interpreter flag, not a record of
    # anything, and listed rather than exempted.
    "sys.dont_write_bytecode": "not state",
    # This table. It is a dict, so the sweep found it on its first run and said
    # so -- which is the sweep working, not a nuisance: any command that
    # searches for its own subject can match itself, and the cheap escape
    # would have been a special case that also hid the next table somebody
    # adds. Written once at import and never assigned to afterwards.
    "STATE_INVENTORY": "not state",
    # A default-argument sentinel for ephemeral_slots(). An identity to compare
    # against and nothing else: nothing is ever written into it and nothing
    # reads anything out of it. It is a bare object() rather than a string or
    # None precisely so that it cannot collide with a real answer -- which is
    # the defect it was introduced to fix.
    "_READ_IT": "not state",
    # The same for slot_door_open(): "ask the kernel" as distinct from a table
    # the caller passed in, which may be None -- the answer for "could not be
    # read" -- and must not be mistaken for "go and read it".
    "_ASK_KERNEL": "not state",
}


def _frozen(value):
    """True when nothing can be written into VALUE.

    A tuple is only as immutable as what is in it, so this recurses rather than
    trusting the outer type: a tuple of dicts is a mutable container wearing an
    immutable label, and that is precisely the disguise this check exists to
    see through.
    """
    if isinstance(value, (bool, int, float, complex, str, bytes, bytearray,
                          type(None), range, slice)):
        return not isinstance(value, bytearray)
    if isinstance(value, (tuple, frozenset)):
        return all(_frozen(v) for v in value)
    return False


def _not_state(value):
    """True for things that are code or a lock rather than a record.

    Functions, classes and modules are what the file IS; a lock is how a record
    is guarded rather than a record. Classes are walked separately for the
    attributes hung on them, so skipping them here is not skipping them.
    """
    import types
    if isinstance(value, (types.FunctionType, types.BuiltinFunctionType,
                          types.MethodType, types.ModuleType, type)):
        return True
    return isinstance(value, (type(threading.Lock()), type(threading.RLock()),
                              threading.Condition, threading.Event,
                              threading.Semaphore))


def uninventoried_state(ns, cls=None, inventory=None, source=None,
                        examined=None):
    """Every piece of this module's state that nobody has said the purpose of.

    REPORTS rather than refuses, and that split is deliberate. The test tier
    asserts on what comes back and goes red; the router logs it and starts.
    Those are opposite needs and the wrong way to serve them is a mode flag,
    because the flag is then a check that can be wired wrong in the quiet
    direction -- set to "warn" in the suite, which would go green while this
    printed violations into a log nobody reads. There is no flag. There is one
    function that returns a list, and each caller is visibly one or the other.

    It takes the NAMESPACE rather than finding its own, for the same reason
    assert_ownership_keying() takes a factory and assert_cookie_outlives_idle()
    takes a derivation: a version that inspected only itself could not fail for
    any module but the one it already trusted. Handed a namespace with an extra
    dict in it, this goes red, and that is how it was seen to go red.

    A dict is also the right handle for the caller to be given. Building a
    module with an unlisted container in it, to prove the check can see one,
    should not require editing the module under test -- we have already had a
    red arm on this project that mutated the checker along with the code and
    proved nothing.

    EXAMINED, if a list is given, collects every name this actually looked
    at. It exists so the caller can say out loud that the sweep RAN rather
    than that it found nothing -- and so that sentence cannot be written
    without calling this. A count of the inventory's own length would have
    been restatable by a main() that had deleted the call, and was:
    measured, by deleting it and watching the suite stay green.
    """
    import ast
    cls = ns.get("Ownership") if cls is None else cls
    inventory = STATE_INVENTORY if inventory is None else inventory
    out = []
    found = set()
    examined = [] if examined is None else examined

    def check(name, value):
        found.add(name)
        examined.append(name)
        if _frozen(value) or _not_state(value):
            return
        if name not in inventory:
            out.append("%s is a %s that nothing has classified; add it to "
                       "STATE_INVENTORY as one of %s, or it is state nobody "
                       "has decided the meaning of"
                       % (name, type(value).__name__, ", ".join(STATE_KINDS)))

    # 1. Module globals, as they stand after import.
    mod_name = ns.get("__name__")
    for k, v in sorted(ns.items()):
        if k.startswith("__"):
            continue
        check(k, v)

    # 2. Attributes hung on the classes this module defines. A dict in a class
    #    body is shared by every instance ever made, which is the sharpest
    #    version of the defect and the one a globals walk cannot see: it does
    #    not look like a global and it does not look like instance state.
    for k, v in sorted(ns.items()):
        if isinstance(v, type) and getattr(v, "__module__", None) == mod_name:
            for a, av in sorted(vars(v).items()):
                if a.startswith("__") or callable(av):
                    continue
                check("%s.%s" % (k, a), av)

    # 3. What one ownership table is born with. Built rather than read off the
    #    class, because these attributes exist only once __init__ has run.
    if cls is not None:
        probe = cls()
        for a, av in sorted(vars(probe).items()):
            # Matched against every name in the inheritance chain, so a
            # subclass inherits its base's classifications and only an
            # attribute NOBODY has classified is reported. Without this a
            # harness that subclasses Ownership to add one dict would be told
            # about all four.
            label = "%s.%s" % (type(probe).__name__, a)
            for base in type(probe).__mro__:
                if "%s.%s" % (base.__name__, a) in inventory:
                    label = "%s.%s" % (base.__name__, a)
                    break
            check(label, av)

    # 4 and 5 read the SOURCE, because two kinds of mutable state leave no
    #   trace in a namespace walk: a global that is rebound at run time (its
    #   value may be an ordinary number) and a write into another module's
    #   namespace. The file parsed is the one this namespace was loaded from,
    #   derived and never named -- a constant path here would be the "which
    #   copy is running" trap inside the check written to notice it.
    path = ns.get("__file__") if source is None else source
    tree = None
    if path:
        try:
            with open(path, "r") as f:
                tree = ast.parse(f.read(), filename=path)
        except (OSError, SyntaxError) as e:
            # A detector that could not run says so. Silence here would read
            # exactly like a clean sweep, which is the one thing it must not.
            out.append("the source at %s could not be read or parsed (%s), so "
                       "rebound globals and writes into other modules were not "
                       "checked at all -- this is not a clean result" % (path, e))
    else:
        out.append("this namespace does not say which file it came from, so "
                   "rebound globals and writes into other modules were not "
                   "checked at all -- this is not a clean result")

    if tree is not None:
        imported = set()
        for n in ast.walk(tree):
            if isinstance(n, ast.Import):
                for a in n.names:
                    imported.add((a.asname or a.name).split(".")[0])
            elif isinstance(n, ast.ImportFrom):
                for a in n.names:
                    imported.add(a.asname or a.name)
        for n in ast.walk(tree):
            # 4. A global that some function rebinds. COOKIE_LIFETIME is a
            #    number, so no walk of values could ever have found it.
            if isinstance(n, ast.Global):
                for name in n.names:
                    found.add(name)
                    examined.append(name)
                    if name not in inventory:
                        out.append("%s is a module global rebound at run time "
                                   "(line %d) and nothing has classified it; "
                                   "a value that changes after start is state "
                                   "however simple it looks"
                                   % (name, n.lineno))
            # 5. A write into an imported module's namespace. That state
            #    outlives this module and is shared with everything else in
            #    the interpreter, so it is the least visible of the lot.
            targets = []
            if isinstance(n, ast.Assign):
                targets = n.targets
            elif isinstance(n, (ast.AugAssign, ast.AnnAssign)):
                targets = [n.target]
            for t in targets:
                if isinstance(t, ast.Attribute) and \
                        isinstance(t.value, ast.Name) and \
                        t.value.id in imported:
                    name = "%s.%s" % (t.value.id, t.attr)
                    found.add(name)
                    examined.append(name)
                    if name not in inventory:
                        out.append("%s is written at line %d, which puts state "
                                   "in another module's namespace; nothing has "
                                   "classified it" % (name, n.lineno))

    # 6. THE OTHER DIRECTION, and it is the one that rots quietly. An entry
    #    naming something that has been removed or renamed still reads as a
    #    considered decision about a live piece of state. Nothing else will
    #    ever surface it: the thing it describes is simply not there to
    #    contradict it, so every check keeps passing.
    for name in sorted(inventory):
        if name not in found:
            out.append("STATE_INVENTORY classifies %s as %r, and no such state "
                       "exists any more; the classification is describing "
                       "something that has been removed or renamed"
                       % (name, inventory[name]))

    # 7. And a classification has to be one of the kinds, or the list records
    #    a word rather than a decision.
    for name, kind in sorted(inventory.items()):
        if kind not in STATE_KINDS:
            out.append("STATE_INVENTORY classifies %s as %r, which is not one "
                       "of %s" % (name, kind, ", ".join(STATE_KINDS)))
    return out


def assert_state_is_inventoried(ns, cls=None, inventory=None):
    """The refusing face of uninventoried_state(), for the test tier.

    The router does NOT call this; it logs what the reporter returns and
    starts. An unclassified container is a mistake made while editing this
    file, not a condition a visitor or an administrator can create, so paying
    for it with a front door that will not come up is the wrong direction --
    and a guard that takes the service down over bookkeeping is removed inside
    a week, after which it guards nothing.

    That is only safe because the suite runs THIS, and asserts on the refusal
    itself rather than on an exit status. If it did not, the two faces would be
    a mode selector with nobody watching the quiet setting.
    """
    complaints = uninventoried_state(ns, cls, inventory)
    assert not complaints, "state nobody has classified:\n  " + \
        "\n  ".join(complaints)


# --------------------------------------------------------------------------
# Slots
# --------------------------------------------------------------------------

def socket_path(instance):
    return os.path.join(PROXY_RUNDIR, "%s.sock" % instance)


# --------------------------------------------------------------------------
# When a slot was last used, and by which of two witnesses
# --------------------------------------------------------------------------
#
# There are two records of that, they do not measure the same thing, and the
# difference between them is itself evidence.
#
# The sweep's stamp is written by a poll every few minutes. A client that
# connects, does something brief and disconnects inside one gap is invisible to
# every sample it takes -- so the stamp can say "nobody since yesterday" about a
# desktop somebody used twenty minutes ago, in a confident, well-formed, wrong
# sentence. Shortening the idle window is exactly what makes that reachable.
#
# The record below is written where the connection is actually ACCEPTED, so it
# cannot miss one: the rate stops mattering and the claim becomes true by
# construction rather than by the sampler being lucky. It is kept in this
# service's own runtime directory, which no other component writes, so it costs
# nobody a permission and cannot be pointed at a file it should not truncate.
#
# WHAT IT DOES NOT DO, and this is the honest half: it does not decide when a
# desktop is reaped. The sweep still does that, from its own stamp. Both are
# printed side by side on a refusal, because an operator judging the idle window
# needs the true figure AND the figure the sweep will act on, and a gap between
# them is the measurement that says the poll is missing connections.

TOUCH_DIR = os.path.join(STATE_DIR, "last-request")
_touched = {}
_touch_lock = threading.Lock()


def touch_slot(instance, now=None):
    """Record that a request reached this slot. Rate limited, never required."""
    now = time.time() if now is None else now
    with _touch_lock:
        if now - _touched.get(instance, 0.0) < TOUCH_EVERY:
            return
        _touched[instance] = now
    try:
        os.makedirs(TOUCH_DIR, mode=0o700, exist_ok=True)
        tmp = os.path.join(TOUCH_DIR, ".%s.new" % instance)
        with open(tmp, "w") as f:
            f.write("%d\n" % int(now))
        os.replace(tmp, os.path.join(TOUCH_DIR, instance))
    except OSError:
        # Bookkeeping, not routing. A failure here must never cost a visitor a
        # request; it costs the refusal log one column, which says so itself.
        pass


# --------------------------------------------------------------------------
# A mint held across our own death
# --------------------------------------------------------------------------
#
# THE ONE FACT THIS PROCESS HOLDS WHOSE LOSS CAN PERMIT SOMETHING, and that is
# why it was the first one written down.
#
# Everything else the router remembers fails toward a refusal. Lose the
# ownership table and a returning visitor reaches the gate, which is the
# arrival rule's designed damage -- and which a deploy made the common case,
# cutting every visitor off from a running desktop, so the table is written
# down too now (see Ownership); losing it is still only a refusal. Lose the cookie-refresh timestamps and
# somebody gets one redundant header. But a MINT is a claim on a slot made
# BEFORE the session behind it exists -- the redirect is what sends the browser
# at the slot, and that first request is what asks for the desktop --
# so for a few seconds the slot is held on this process's word alone, and
# losing that word lets a second visitor be handed a slot the first is still
# walking to. That is the double-booking confirmed at the pixels, arriving by
# a crash instead of by a forgotten table, and Restart=on-failure with
# RestartSec=1s is the mechanism that makes it reachable.
#
# So the reservation is EMBODIED rather than remembered: a file that outlives
# the process that made it.
#
# IT IS STRICTLY WEAKER THAN THE OCCUPANCY AUTHORITY AND MUST STAY THAT WAY.
# It may only ever ADD to the set of slots that must not be let. It is never
# consulted to resolve a sid, never to permit a resume, never to decide that a
# desktop is alive. A stale one costs a slot for at most MINT_GRACE; a stale
# one that could PERMIT would cost somebody their desktop. Same refuse-only
# wiring as slot_incarnation(), sound for the same reason: it does not depend
# on anyone having enumerated the stale cases correctly.
#
# IT IS AN ADDITION TO pending_mints(), NOT A REPLACEMENT. The in-memory half
# still runs, so a failure to write here -- a full tmpfs, a permission fault --
# degrades to exactly the behaviour before this existed rather than costing a
# visitor a desktop. The file's whole job is to cross a restart, which memory
# cannot do, and memory's whole job is to work when the filesystem does not.
#
# NOT flock, AND THIS IS THE REFLEX TO RESIST. An exclusive lock is the obvious
# primitive for "reserve a slot" and it is exactly wrong here: the kernel
# releases it when the holder dies, and surviving this process's death is the
# entire purpose. It would be a guard that unlocks precisely when it is needed.
#
# ABANDONMENT IS EVALUATED BY THE READER, from the file's mtime against
# MINT_GRACE. No sweeper, no second daemon, and no new grace window in a new
# place -- it is the same window the in-memory half already uses, read instead
# of held.
#
# WHAT THIS FILE'S HOME MUST DO, stated as a property because the directory is
# replaceable and the property is not:
#
#   it must outlive the router process, and it must not outlive the boot.
#
# /run is a tmpfs, which gives the second half for nothing. The first half is
# NOT free and is not a property of /run: RuntimeDirectory= removes its tree
# whenever the unit stops, and a restart is a stop, so the default destroys this
# file at precisely the event it exists to cross. hdw4s-demux.service therefore
# says RuntimeDirectoryPreserve=yes, and that line and this code are a matched
# pair -- remove it and every guard here still passes while the thing it guards
# is gone. The unit carries the reasoning; this carries the requirement.
#
# READ THE NEXT PARAGRAPH BEFORE MOVING THIS FILE ANYWHERE. The reflex refused
# just above -- flock, because the kernel drops a lock when the holder dies --
# and the default that had to be overridden here are THE SAME MISTAKE at two
# levels: both hand you something that disappears exactly when its holder does.
# The first was refused on sight and the second was walked into anyway, in this
# same round, by people who had already measured the wipe happening. Checking
# the primitive is not the same as checking the lifetime of the place you put
# its result, and only one of those two is obvious.

RESERVE_DIR = os.path.join(STATE_DIR, "reserved")


def reservation_fresh(age):
    """True when a reservation of this age still holds its slot.

    Takes an AGE rather than a path so that the rule can be exercised without a
    filesystem, and takes the absolute value on purpose. A reservation whose
    mtime is in the FUTURE -- a clock step, a tmpfs oddity -- would otherwise
    never expire, and a slot that can never be re-let is the pool-exhaustion
    defect wearing a safety check. Treating a wildly-wrong stamp as abandoned
    costs at most one double-booking inside the grace window, which is the
    bounded failure; treating it as fresh forever is the unbounded one.
    """
    return abs(age) < MINT_GRACE


def reserved_slots(now=None, root=None):
    """Slots held by a reservation that has not expired. OBSERVES ONLY.

    os.listdir and os.stat, and nothing that opens or creates. This is called
    from slots_in_use() on every arrival, which puts it on the path that must
    never actuate anything: these slots are socket-activated, so a reader here
    that opened a socket would start a desktop on every free slot, which is the
    measured defect this whole file is arranged against.

    An unreadable directory yields the EMPTY SET, and that is sound only
    because this half may only ever ADD to the taken set -- an empty answer
    here means "no reservation is known", which is the same thing the in-memory
    half says after a restart, and it falls back to it rather than overriding
    it. Do not copy this pattern to the occupancy reader, where an empty result
    read as "nothing is occupied" hands every slot away twice.
    """
    now = time.time() if now is None else now
    base = RESERVE_DIR if root is None else root
    try:
        names = os.listdir(base)
    except OSError:
        return set()
    out = set()
    for name in names:
        try:
            age = now - os.stat(os.path.join(base, name)).st_mtime
        except OSError:
            continue
        if reservation_fresh(age):
            out.add(name)
    return out


def reserve_slot(instance, now=None, root=None):
    """Write down that this slot has been let. Never called from a reader.

    O_EXCL, and the stale-takeover path below is race-free only because there
    is exactly one router process: hdw4s-demux.socket is Accept=no and the
    service it activates is a single instance. STATE THAT AS A DEPENDENCY
    SOMEBODY CAN REMOVE, not as a reassurance -- the day this is run twice
    against one directory, the unlink-then-create here is a window in which two
    arrivals can both succeed. The O_EXCL is kept anyway, because it costs
    nothing and it is a real refusal rather than an argument.

    Returns nothing and raises nothing. A failure to reserve is not a reason to
    refuse a visitor: the in-memory half of the mint still holds the slot for
    this process's lifetime, so the cost of losing this file is confined to a
    restart inside the grace window -- which is the case it exists for, but not
    a case worth turning into an outage on a full tmpfs.
    """
    now = time.time() if now is None else now
    base = RESERVE_DIR if root is None else root
    path = os.path.join(base, instance)
    try:
        os.makedirs(base, mode=0o700, exist_ok=True)
        try:
            os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
            return
        except FileExistsError:
            pass
        # Already there. Ours to take over only if it has expired -- an
        # unexpired one belongs to a mint that is still walking to its slot,
        # and pick_slot() should never have offered this name at all.
        try:
            age = now - os.stat(path).st_mtime
        except OSError:
            return
        if reservation_fresh(age):
            return
        # SAID OUT LOUD, because this is the one moment where the backstop
        # chooses for us and it cannot tell the two cases apart. An expired
        # reservation means either a visitor who walked away before their
        # desktop came up -- ordinary, and returning the slot is right -- or a
        # session start that is WEDGED and still on its way, in which case this
        # line is the last warning before two people share a desktop. A clock
        # cannot distinguish them; a human reading this can go and look.
        log("re-letting %s: its reservation expired after %ds without a "
            "desktop answering. If that session was still starting, this is "
            "the moment a second visitor can be sent to it."
            % (instance, int(age)))
        os.unlink(path)
        os.close(os.open(path, os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o600))
    except OSError:
        pass


def assert_reservation_only_refuses(reserve=None, reserved=None, release=None,
                                    fresh=None):
    """Prove the reservation holds a slot, expires, and can do nothing else.

    Runs at every start beside the other four, because every property it checks
    fails silently in one direction or the other: a reservation that does not
    hold lets a restart double-book a live desktop, and one that never expires
    empties the pool a slot at a time with no error anywhere.

    TAKES ITS FOUR FUNCTIONS AS PARAMETERS for the reason the rest of this file
    does: a version that called the module's own would be green for the only
    implementation it already trusted, which is a check that cannot fail by
    construction. Pointed at a reservation that never expires, the third arm
    below goes red.
    """
    reserve = reserve_slot if reserve is None else reserve
    reserved = reserved_slots if reserved is None else reserved
    release = release_slot if release is None else release
    fresh = reservation_fresh if fresh is None else fresh

    # Imported here rather than at module scope, as the other guards do: these
    # are used only by code that runs at start-up and never on a request path.
    import shutil
    import tempfile

    d = tempfile.mkdtemp(prefix="hdw4s-reserve-")
    try:
        now = time.time()

        # NEGATIVE CONTROL FIRST. Without it every "is held" below would pass
        # against a reader that simply returned every name it could think of.
        assert reserved(now, d) == set(), \
            "an empty reservation directory reported slots as held"

        # HOLD ARM.
        reserve("ephemeral0", now, d)
        assert "ephemeral0" in reserved(now, d), \
            "a slot that was just let is not held"
        assert "ephemeral1" not in reserved(now, d), \
            "a slot nobody let is held"

        # EXPIRY ARM, asked of the rule rather than by sleeping: a guard that
        # needs three minutes to prove itself would be deleted by whoever runs
        # this next.
        assert fresh(0.0), "a reservation made now had already expired"
        assert not fresh(MINT_GRACE + 1), \
            "a reservation older than the grace window still holds its slot"
        # And the sharp one: a stamp in the FUTURE must not read as eternally
        # fresh, or the slot can never be re-let.
        assert not fresh(-(MINT_GRACE + 1)), \
            "a reservation dated in the future holds its slot forever"

        # RELEASE ARM.
        release("ephemeral0", d)
        assert "ephemeral0" not in reserved(now, d), \
            "a released reservation still holds its slot"

        # AND THE ONE THAT MATTERS MOST: this thing has no way to permit. It
        # answers a set of names and nothing else -- no sid, no identity, no
        # liveness -- so there is no path by which a stale file can hand
        # somebody a desktop. Asserted as a TYPE rather than as a value,
        # because the day someone makes it return a record is the day it
        # becomes capable of the failure it was built to avoid.
        reserve("ephemeral2", now, d)
        held = reserved(now, d)
        assert isinstance(held, set) and all(isinstance(n, str) for n in held), \
            "the reservation reader answers something richer than slot names"
    finally:
        shutil.rmtree(d, ignore_errors=True)


def renew_reservation(instance, now=None, root=None):
    """Hold INSTANCE for MINT_GRACE from NOW: the letting whose desktop is being
    started is still walking to it. Only ever extends a hold; never permits."""
    now = time.time() if now is None else now
    base = RESERVE_DIR if root is None else root
    path = os.path.join(base, instance)
    try:
        os.makedirs(base, mode=0o700, exist_ok=True)
        os.close(os.open(path, os.O_CREAT | os.O_WRONLY, 0o600))
        os.utime(path, (now, now))
    except OSError:
        pass


def release_slot(instance, root=None):
    """Drop a reservation once the authority can speak for the slot itself.

    NOT REQUIRED FOR CORRECTNESS, and saying so matters: the mtime bound
    already retires an abandoned reservation, so this only returns capacity
    sooner. It is called where a desktop has answered -- from that moment the
    session's own runtime directory says the slot is taken and is more current
    than we are -- and where a mint is dropped as dead.

    Losing the call is a slot held for the rest of the grace window. Losing the
    BOUND would be a slot held forever, which is why the bound is the guarantee
    and this is the optimisation.
    """
    try:
        os.unlink(os.path.join(RESERVE_DIR if root is None else root, instance))
    except OSError:
        pass


def stamp_age(path, now=None):
    """(seconds, None) for a readable stamp, or (None, why) -- never a number
    we made up. An unreadable stamp rendered as "0" or as "never" is the wrong
    answer wearing the right shape, and the whole point of the refusal log is
    that somebody sets an idle window from what it prints."""
    now = time.time() if now is None else now
    try:
        with open(path, "r") as f:
            raw = f.read().strip()
    except FileNotFoundError:
        return None, "no record"
    except OSError as e:
        return None, "unreadable (%s)" % (e.strerror or e)
    try:
        return max(0.0, now - float(raw)), None
    except ValueError:
        return None, "unreadable (not a timestamp)"


def describe_age(seconds):
    if seconds is None:
        return "?"
    if seconds < 3600:
        return "%dm" % int(seconds // 60)
    if seconds < 86400:
        return "%dh%02dm" % (int(seconds // 3600), int(seconds % 3600 // 60))
    return "%dd%02dh" % (int(seconds // 86400), int(seconds % 86400 // 3600))


def log_refusal(reason, now=None):
    """The one event that means we turned a person away, said out loud.

    It was silent. Exhaustion rendered a 503 to the visitor and wrote nothing
    anywhere, so the way an operator learned the pool was full was that somebody
    told them -- which means the idle window was being set from no evidence at
    all. This line is the instrument that number is judged by, and it outranks
    the number: seven days with this line beats a day without it.
    """
    now = time.time() if now is None else now
    # Kept in BOTH shapes on purpose, and the names say which is which. The
    # first version read the pool once and passed the lookup table to something
    # that wanted the pairs; it raised inside the request thread, so the visitor
    # got an empty reply instead of the 503 -- the refusal path made the refusal
    # worse. Caught by the test that asserts on the log rather than on the
    # status code, which is the only oracle that could have seen it.
    pairs = idle_windows()
    windows = dict(pairs)
    # THE COUNT IS THE POOL; THE LIST IS WIDER, and the difference is the point
    # of this report. What was refused is capacity, and capacity is the typed
    # rows -- counting socket files alongside them told an operator the pool was
    # bigger than anything a visitor could be given, which is the wrong number
    # to size an idle window from. The extra names stay in the listing below,
    # marked "not in the pool table", because a leftover socket in that
    # directory is one of the things an operator reading a 503 is looking for.
    names = sorted(set(list(windows) + socket_filenames()))
    log("turned an arrival away: %s (%d slot(s) in the pool)"
        % (reason, len(windows)))
    if not names:
        log("  no slots are configured, so nothing can be served here.")
        return
    for name in names:
        seen, seen_why = stamp_age(os.path.join(TOUCH_DIR, name), now)
        swept, swept_why = stamp_age(os.path.join(REAP_STAMP_DIR, name), now)
        if name not in windows:
            window = "not in the pool table"
        else:
            window = describe_window(windows[name])
        log("  %s: last request %s; idle sweep last saw %s; idle window %s"
            % (name,
               seen_why or ("%s ago" % describe_age(seen)),
               swept_why or ("%s ago" % describe_age(swept)),
               window))
    # A remedy is only worth naming if it can actually be carried out, so this
    # names the two settings and stops there rather than reciting a procedure
    # nobody has run. How many slots exist is HDW4S_EPHEMERAL_SLOTS; how long
    # each is held is HDW4S_IDLE_DAYS, per slot or for the machine.
    log("  Ages above are what the idle window should be judged against."
        " A gap between the two columns means the periodic sweep is missing"
        " connections that this line is not.")
    # RE-CHECKED HERE, against windows read a moment ago rather than at start.
    # This is the arm of the derivation that can go red: the lifetime is pinned
    # and the configuration is not, so a conf file edited after this started --
    # or a slot added to the pool -- moves one clock without moving the other.
    # A refusal is also the right moment to say it, because it is the moment
    # somebody is about to go and change an idle window.
    for complaint in cookie_policy_complaints(COOKIE_LIFETIME, pairs):
        log("  WARNING: %s" % complaint)


def visitor_tag(identity):
    """A short, stable, non-reversible name for one browser, for the log.

    The identity cookie itself is never written to the log. The one place it is
    written is the router's own ownership table, mode 0600 in a directory only
    root and the router can read. It is what decides
    whose desktop a request reaches, so a log line carrying it is a log line
    that hands somebody else's session to whoever can read the journal -- and on
    this box the journal has already been read across occupants once.

    COMPUTED, not truncated. Printing the first eight characters of the cookie
    would be the print-then-redact shape: it narrows the search for the rest by
    exactly the part that was printed, and it looks just as anonymous. A digest
    of the whole value does not.

    Eight hex characters, because the question an operator asks of this is "are
    these two lines the same browser or two different ones", over a handful of
    lines, and not "which browser is this".
    """
    return hashlib.sha256(identity.encode("ascii", "replace")).hexdigest()[:8]


# WHICH REFUSALS HAVE BEEN SAID. A tab that is refused does not ask once: it asks
# for its page, its script, its manifest, its stylesheet and its identity, and it
# retries every few seconds -- measured on production after a restart of this
# router, where every one of those was answered 410 and the log said NOTHING, so
# an administrator could not see a visitor being turned away at all. One line per
# refused session is what an operator can read; one per request is what would be
# silenced by the next person to be annoyed by it.
_SAID = set()
_said_lock = threading.Lock()


def say_once(key, msg=None):
    """Log MSG the first time KEY is seen by this process, and never again.

    MSG None marks KEY as said without saying anything -- for an event that has
    already been logged in other words, so that its follow-up requests are not
    reported as a second event. Bounded like Ownership._refreshed, because a
    stranger can present unlimited made-up session ids; clearing it costs one
    repeated line per session still being refused.
    """
    with _said_lock:
        if key in _SAID:
            return False
        if len(_SAID) > 20000:
            _SAID.clear()
        _SAID.add(key)
    if msg is not None:
        log(msg)
    return True


def log_arrival(what, identity, instance, sid, why=None):
    """A session was minted, or resumed. Said out loud, because NOTHING DID.

    This was the missing instrument, and its absence is why every defect around
    it was silent. A visitor arrived, a slot was taken, and the only trace on
    the box was a file mtime under the runtime directory that systemd deletes on
    every restart. There was no record that a slot had been let at all.

    Three readers, and the middle one is the reason this is not a debug line:

      * the pool filling up. log_refusal() says the pool is full; nothing said
        how it got that way, so the idle window was being judged from one end.
      * A SLOT LET TWICE. The router's table is lost when its file is -- at a
        reboot, or if it cannot be read -- and then nothing here knows who
        holds what. Two mints on one instance, with two different visitor
        tags and no reap between them, is one person being handed the desktop
        another person is sitting in -- and there is no other way for an
        operator to find that out, because to both visitors it looks fine.
      * anything watching this box for contamination during a measurement. That
        currently reads last-request files by path, which makes it blind the
        moment those records move or are wiped; a log line is not a path.

    The sid is written and the identity is NOT. A sid is an address: the session
    it names can read it out of its own environment, so it is in somebody else's
    access log already. An identity is what authorises reaching that address.
    """
    log("%s: slot %s, session %s, visitor %s%s"
        % (what, instance, sid, visitor_tag(identity),
           "" if why is None else " (%s)" % why))


def slot_carries_own_credential(instance):
    """True when a slot was configured with a Basic credential of its own.

    Existence, not content. The file is a systemd-creds ENCRYPTED blob, not a
    password -- reading it raw and presenting it upstream produces "Invalid
    Credentials" and a 401 on that slot alone, which reads as a routing fault
    and is not one. That was built here first and it was wrong.

    Nothing decrypts it here, because on a filesystem transport it should not
    exist: reachability is already decided by the socket's mode and its
    directory's permissions, before any HTTP exchange. A credential checked
    after that adds nothing -- anyone who could present it could already
    connect, and anyone who could not connect never gets to present it.

    So this exists only to say so loudly at startup, because the alternative is
    one slot in the pool silently refusing every request.
    """
    d, _ = credential_dir()
    return os.path.exists(os.path.join(d, "%s.auth.cred" % instance))


def socket_filenames():
    """The names in the socket directory. NOT the pool, and NOT what can be served.

    RENAMED FROM available_slots(). The old name is the reason this was still
    here to be found three times: it promised the thing every caller wanted, so
    a docstring underneath saying the opposite got read as a caveat rather than
    as a correction, and the mint path went on computing free capacity from a
    filename. The name now asks the question the body answers, and a caller who
    wants the pool has to type ephemeral_slots() to get it.

    This docstring used to claim it read "the authority that defines the set --
    the bound sockets -- rather than from a configured count", and ended "a count
    in a file is a claim; a socket a request can reach is the thing itself". It
    reads neither. It lists a DIRECTORY and filters on a suffix, which is a third
    thing: a filename. The author rejected the weaker evidence and then
    implemented something weaker still, and the sentence stopped anyone noticing.

    Measured 2026-09-22, three ways it is wrong at once. A regular file made with
    "touch zz-probe.sock" is enumerated. A socket with nothing bound to it is
    enumerated, handed to a visitor, and consumes a slot permanently. A named
    session's leftover socket is enumerated into the ephemeral pool.

    Reachability is now reported at startup by slot_unreachable(), which does ask
    the kernel -- but this function still answers the filesystem question, so
    callers must not read its result as "these can be served".
    """
    try:
        names = os.listdir(PROXY_RUNDIR)
    except OSError as e:
        log("cannot read %s: %s" % (PROXY_RUNDIR, e))
        return []
    return sorted(n[:-5] for n in names if n.endswith(".sock"))


def listening_paths(proc_net_unix="/proc/net/unix"):
    """Every AF_UNIX path the kernel currently has a LISTENING socket on.

    The kernel's own answer to "is anything bound and accepting here", asked
    without opening anything. Field 4 of /proc/net/unix is the socket's flags
    and 0x10000 is SO_ACCEPTCON, which is set by listen() and by nothing else.

    Controlled in both directions rather than reasoned about, because a parser
    that returned the empty set would make every slot look dead and one that
    returned everything would make every slot look live:

        a socket that called listen()      Flags 00010000  -> in this set
        a socket bound and never listened  Flags 00000000  -> NOT in this set
        a regular file made with "touch"   absent from the file entirely

    That middle row is the orphan this project has already enumerated as a live
    slot, and the third is the "touch zz-probe.sock" case measured on 2026-09-22.
    assert_probe_does_not_activate() below builds all three and checks them.

    A failure to read is NOT an empty set. Returning one would say "nothing is
    listening anywhere", which is the confident wrong sentence this whole file
    is about, so the caller is handed None and says so.
    """
    try:
        with open(proc_net_unix, "r") as f:
            rows = f.readlines()[1:]
    except OSError:
        return None
    out = set()
    for row in rows:
        bits = row.split()
        if len(bits) < 8:
            continue
        try:
            if int(bits[3], 16) & 0x10000:
                out.add(bits[7])
        except ValueError:
            continue
    return out


def slot_unreachable(instance, listening=None, path=None):
    """Why this slot cannot be reached, or None if it can.

    Answers the question available_slots() only appears to answer. A name in the
    socket directory is a filename; whether a request can be served through it is
    a fact about the kernel, and the two came apart in the field -- a regular file
    created with "touch" was enumerated as a slot, and a socket with nothing bound
    to it was handed to a visitor.

    IT USED TO CONNECT, AND THAT WAS NOT AN OBSERVATION. IT WAS AN ACTION.
    /run/hdw4s-proxy/<instance>.sock belongs to hdw4s-proxy@<instance>.socket,
    which is socket-activated and which the sweep deliberately leaves listening
    when it reaps a desktop. So a bare connect() -- no bytes sent, no HTTP --
    starts the relay AND a whole GNOME session behind it. Measured on a stock
    install: with a session stopped and its socket unit still up, one connect()
    took hdw4s-ephemeral@<instance> from inactive to active and created its
    runtime tree.

    The consequence was the startup banner, which calls this once per slot:
    three desktops stopped, the router restarted, and ten milliseconds after it
    printed "routing to 3 slot(s)" all three incarnation units and all three
    sessions started, with nobody on the box and no arrival. A restart of the
    front door consumed the entire pool. The check written to report what the
    pool could serve was manufacturing the answer it reported -- and it would
    have gone on looking right forever, because what it says is true by the time
    anybody reads it.

    So nothing here opens the socket. Three questions, none of which activates
    anything, and between them they cover every failure this was written for:

      * is it a socket at all       -- stat, which catches the touched file
      * is anything listening on it -- /proc/net/unix, which catches the orphan
      * may we open it              -- os.access, which catches the EACCES case
                                       that a leftover socket owned by another
                                       user produced in the field

    LISTENING is passed in so the caller can read /proc/net/unix once for a
    whole pool instead of once per slot, and so the arms below can hand this a
    set they built. A caller that passes nothing gets a fresh read. PATH is
    there for the same reason and for one more: the arms build their slots in a
    private directory, and a version that could only ever look in PROXY_RUNDIR
    would have had to be proved by mutating the module it was proving.

    Deliberately returns the reason rather than a boolean: an operator reading
    "cannot be reached" wants to know whether it is a leftover file, a permission
    problem or a session that is down, and those want different actions.
    """
    path = socket_path(instance) if path is None else path
    try:
        st = os.stat(path)
    except OSError as e:
        return "%s (%s)" % (e.strerror or e, errno.errorcode.get(e.errno, e.errno))
    if not stat.S_ISSOCK(st.st_mode):
        return "not a socket, it is an ordinary file left in the pool directory"
    if not os.access(path, os.R_OK | os.W_OK):
        # The measured field failure: a socket left by an earlier configuration,
        # owned by a different user than this service runs as. connect() gave
        # EACCES; this says the same thing without the side effect.
        return "no permission to open it (EACCES); it belongs to %d:%d" \
            % (st.st_uid, st.st_gid)
    if listening is None:
        listening = listening_paths()
    if listening is None:
        # NOT "it is unreachable", and not "it is fine" either. The instrument
        # did not run, and an instrument that did not run must never be read as
        # a result -- in either direction.
        return None
    if path not in listening:
        return "nothing is listening on it (the socket unit is down, or this is" \
               " an orphan left behind by a session that stopped)"
    return None


def assert_probe_does_not_activate(probe=slot_unreachable,
                                   enumerate_listening=listening_paths):
    """Prove the reachability probe reports without CONNECTING, at every start.

    Takes both halves as parameters for the same reason assert_ownership_keying()
    takes a factory: a version that built its own probe could not fail for any
    implementation but the one it already trusted, and this file has already
    caught exactly that mistake once.

    THE REFUSE ARM IS THE POINT, and it is the one that would have gone red
    against the code this replaces: a slot that is bound but never listened to
    must be reported as unreachable. The old probe connect()ed, which on a
    socket-activated path SUCCEEDS and starts a desktop, so it returned None --
    "this slot is fine" -- about a slot with no session behind it, having just
    created one.

    Four slots are built in a private directory: one listening, one bound and
    never listened to, one a plain file, and one LISTENING WITH A WITNESS BEHIND
    IT. Each of the first three must be classified differently, and the
    listening one must still be permitted, because a probe that refused
    everything would satisfy the refuse arm on its own.

    The fourth is the arm that catches the predecessor, and it took two goes to
    get right. The first version of this function had only the three
    classification arms -- and the connecting probe PASSES all three, because
    nothing in a temporary directory is socket-activated: connect() to the
    orphan is refused there, so the old code returned the right answer for the
    right reason and the guard went green against the exact defect it was named
    for. A check that cannot fail for the implementation it replaced is not a
    check. So the fourth slot is listening, with a thread that records having
    been ACCEPTED on, which is the local stand-in for systemd holding a slot
    socket open and starting a desktop for whoever knocks. The probe must leave
    that witness untouched.

    WHAT IT STILL CANNOT SEE, because an unwritten blind spot reads as
    exhaustive: it does not observe systemd. The witness proves nothing was
    connected to; that a connection would have started a GNOME session is a fact
    about the shipped units, measured on a box and written up beside
    slot_unreachable(), not something this reproduces.
    """
    import shutil
    import tempfile

    d = tempfile.mkdtemp(prefix="hdw4s-demux-probe-")
    keep = []
    try:
        live = os.path.join(d, "live.sock")
        orphan = os.path.join(d, "orphan.sock")
        plain = os.path.join(d, "plain.sock")

        a = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        a.bind(live)
        a.listen(4)
        keep.append(a)
        b = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        b.bind(orphan)              # bound, never listen()ed
        keep.append(b)
        with open(plain, "w"):
            pass

        # The stand-in for a socket-activated slot: listening, and it notices.
        witnessed = os.path.join(d, "witnessed.sock")
        w = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
        w.bind(witnessed)
        w.listen(4)
        keep.append(w)
        accepted = []

        def watch():
            while True:
                try:
                    c, _ = w.accept()
                except OSError:
                    return
                accepted.append(1)
                c.close()

        threading.Thread(target=watch, daemon=True).start()

        seen = enumerate_listening()
        assert seen is not None, \
            "the listening-socket enumeration could not run at all, so it" \
            " cannot distinguish a live slot from an orphan"
        # THE CONTROL, INSIDE THE SPACE SEARCHED. An enumeration that came back
        # empty would make every slot below look dead, and the refuse arms would
        # all pass for the wrong reason.
        assert live in seen, \
            "a socket this process is listening on was not found among the" \
            " listening sockets, so an empty answer here means nothing"
        assert orphan not in seen, \
            "a socket that was bound and never listened to was counted as" \
            " listening: the flag being read is not SO_ACCEPTCON"

        # PERMIT ARM.
        assert probe("live", listening=seen, path=live) is None, \
            "a slot with a listening socket was reported unreachable"
        # REFUSE ARMS, and each names a different repair to an operator.
        assert probe("orphan", listening=seen, path=orphan) is not None, \
            "a socket with nothing listening on it was reported reachable --" \
            " a visitor minted onto it gets no answer and the slot is consumed"
        assert probe("plain", listening=seen, path=plain) is not None, \
            "an ordinary file in the pool directory was reported reachable"
        assert probe("gone", listening=seen,
                     path=os.path.join(d, "no-such.sock")) is not None, \
            "a name with no file at all was reported reachable"
        # THE ARM THAT CATCHES THE PREDECESSOR. A probe that connects here gets
        # a perfectly good answer -- this slot is listening and is reachable --
        # and in the field that same connect starts a desktop. The verdict is
        # therefore not evidence either way; the side effect is.
        assert probe("witnessed", listening=seen, path=witnessed) is None, \
            "a listening slot was reported unreachable"
        # The accept happens on another thread, so give it a moment rather than
        # racing it: a check that can be beaten by scheduling reports clean at
        # random, which is worse than not checking.
        for _ in range(50):
            if accepted:
                break
            time.sleep(0.01)
        assert not accepted, \
            "the reachability probe CONNECTED to a slot. On this box that is" \
            " only a wasted syscall; on a socket-activated pool it starts a" \
            " desktop, and the startup banner does it once per slot -- which" \
            " is how restarting the front door consumed the whole pool"

        # AND IT MUST NOT HAVE OPENED ANYTHING. The orphan is the only slot here
        # that a connect() would have changed -- on a socket-activated path it
        # would have started a session. Nothing bound it to a listener, so if
        # the probe had connected, it would still not be listening; what this
        # can check is the weaker, true thing: the probe left the pool exactly
        # as it found it.
        after = enumerate_listening()
        assert after is not None and orphan not in after and live in after, \
            "the probe changed which sockets are listening, so it acted on the" \
            " pool rather than observing it"
    finally:
        for s in keep:
            s.close()
        shutil.rmtree(d, ignore_errors=True)


# --------------------------------------------------------------------------
# Is the session still answering on its own door?
# --------------------------------------------------------------------------
#
# THE WINDOW THIS CLOSES, measured on a container 2026-09-25 and recorded in
# private/evidence/slot-recycle/2026-09-25-window-instruments.txt:
#
#     t      relay      session       rundir   door
#     3.71   active     active        present  open
#     4.45   INACTIVE   deactivating  present  OPEN
#     4.69   inactive   deactivating  present  SHUT
#     5.22   inactive   failed        ABSENT   shut
#
# A GNOME logout -- the documented, correct way to finish -- stops the session,
# but its RuntimeDirectory survives for another half second or more, and
# slot_occupied() reads that directory. So for that interval this router still
# believes the letting is healthy and PROXIES, and the proxy connection lands in
# a socket unit that is still listening, whose BindsTo= then started a FRESH
# desktop in the slot -- under the relay's old shape. Now the relay refuses it
# (Requisite=) and the refusal gates the visitor; this check gates them first. The disconnected client reloads every five seconds by
# design, so something lands in that window essentially every time: four slots
# consumed in seven minutes by one person behaving correctly four times.
#
# The runtime directory is therefore the right authority for "is anything
# there" and the wrong one for "is it still serving". This asks the kernel the
# second question instead, one hop further in than the slot socket that
# listening_paths() already asks about, and it opens nothing: a socket-activated
# slot treats a connection as an instruction, never as a question.
#
# WHAT IS ASKED: whether the session's stream socket is LISTENING, in the
# kernel's own table of unix sockets -- the table listening_paths() already reads
# for the slot sockets. The path is not configured anywhere, and that is the
# point: it is /run/hdw4s-stream/<instance>/s/stream.sock for every session, the
# one the relay's ExecStart= names and the one hdw4s-session hands the server, so
# there is no per-instance setting for this router to read and get wrong. (It
# used to be a TCP port read out of the instance's config file. A port is a name
# any desktop on the machine may take first, which is why the stream moved; see
# hdw4s-stream-dir.) The candidate that was rejected -- the relay unit's cgroup
# directory -- would have required constructing
# /sys/fs/cgroup/system.slice/system-hdw4s\x2dproxy.slice/hdw4s-proxy@<slot>.service,
# carrying systemd's own escaping and its per-prefix slice grouping, which this
# service cannot ask systemd for because it has no bus.
#
# THE RESIDUAL, AND IT IS 0.25 SECONDS WIDE. Read the table again: the relay is
# already gone at 4.45 while the door is still open, and it shuts at 4.69. A
# request landing in that quarter second passes this check and is proxied --
# and, since a connection can no longer start a pool desktop, the relay refuses
# it and the visitor is gated on that refusal (REFUSED). What the quarter second
# still costs is a round trip, not a desktop. The cgroup instrument closes it
# because it goes in the same sample as the relay; asking both -- gate if EITHER
# says the session is going -- would close it while degrading to this 0.25 s
# when the cgroup could not be found.
#
# THAT IS NOT BUILT, AND THE REASON IS A PRECONDITION RATHER THAN A PREFERENCE:
# nobody has shown how the router DISCOVERS that cgroup path instead of spelling
# it. Graceful degradation protects us from the path being ABSENT, not from it
# being WRONG -- a constructed path that silently matches nothing looks exactly
# like this check working, and one that matches the wrong cgroup is worse than
# having no second instrument at all. So: add the cgroup arm the day somebody
# can discover the path without spelling systemd's convention, and not before.
# What is left uncovered here is covered by the reclaim, which ends the desktop
# the slot was left running: one in twenty rather than one in one, and then
# healed.
#
# WHAT IS UNMEASURED: that a healthy session's door is open CONTINUOUSLY for the
# whole of its life. It was open on every sample of the healthy period in the
# runs above -- eleven samples over 3.7 s -- which is a positive, not a
# lifetime. The experiment that would settle it is to sample one session's port
# from start to logout and show no gap. If there are gaps, this gates a live
# visitor, which is the expensive direction; that is why it may only speak for a
# record whose desktop ALREADY ANSWERED us, below.

def stream_socket_path(instance, root=None):
    """Where INSTANCE's streaming server listens. Spelled once, here."""
    return os.path.join(STREAM_DIR if root is None else root, instance, "s",
                        "stream.sock")


_ASK_KERNEL = object()


def slot_door_open(instance, listening=_ASK_KERNEL, root=None):
    """True, False, or None when the question could not be asked.

    THREE-VALUED ON PURPOSE. False is "this desktop has stopped answering" and
    it costs a visitor their session, so it may only be returned when the
    instrument actually ran: an unreadable /proc/net/unix is None and not
    False. An empty result is not a negative, and here the empty result is what
    a missing instrument produces.

    LISTENING AND NOTHING ELSE, which listening_paths() already enforces: a
    socket that is bound but not accepting -- what a dying server leaves for an
    instant, and what a file left at the path looks like -- is not an open door.
    """
    live = listening_paths() if listening is _ASK_KERNEL else listening
    if live is None:
        return None
    return stream_socket_path(instance, root) in live


def occupancy_readable(rundir=None):
    """True when the occupancy authority is present and can be consulted.

    ASKED SEPARATELY FROM "IS THIS SLOT OCCUPIED", and that separation is the
    whole guard. If the directory the sessions hang their runtime trees off does
    not exist at all, then every slot reads "not occupied" -- which is a
    perfectly formed answer meaning "I could not look", and reading it as "the
    pool is empty" would hand every slot away twice. An empty result is not a
    negative, and here the empty result is the DEFAULT one.
    """
    return os.path.isdir(SESSION_RUNDIR if rundir is None else rundir)


def slot_occupied(instance, rundir=None):
    """True when a desktop is running behind this slot. A STAT, never an open.

    THE AUTHORITY IS THE SESSION'S OWN RuntimeDirectory, and it was chosen over
    every other candidate because each of those is wrong in a way that is
    invisible:

      * OUR OWN TABLE says who was LET a slot, not whether anything is running
        there. It survives a restart of this service now (see Ownership), but a
        desktop can stop, be reaped or be torn down without this router being
        told, so a row is a claim about the past. Read as occupancy, a stale row
        would hold a free slot out of the pool for as long as the row lives.
      * SYSTEMD UNIT STATE reads "active" for every slot moments after any
        restart, because the thing that asked is what started them.
      * A connect() PROBE is not an observation at all. These slots are
        socket-activated, so opening one starts a desktop: measured, and it is
        why the startup banner no longer connects. A check that creates the
        state it reports is worse than no check.

    So: os.path.isdir, and nothing else. It opens nothing, activates nothing and
    can be run on every arrival for free. SAY THAT AT THE CALL SITE and keep it
    true -- the next person here will reach for something that opens, because
    opening is the obvious way to ask whether something is alive, and on this
    pool it is the way to make it alive. A rig built against this warning still
    created its stand-in directory on accept and had the router's own startup
    connection bring all three slots into existence occupied.

    Contents are never read and could not be: the directory is 0700 and owned by
    the session's user. Existence is all that is wanted and all that is legible,
    which is the right amount of both.
    """
    root = SESSION_RUNDIR if rundir is None else rundir
    return os.path.isdir(os.path.join(root, instance))


def slot_incarnation(instance, root=None):
    """The identity this slot publishes for its CURRENT start, or None.

    A CORROBORATOR AND NEVER AN AUTHORITY, and the distinction is load bearing
    rather than a shade of meaning. This file on disk can outlive the session it
    describes: the authoritative record lives in /run and dies at a boot, while
    this published copy does not, and two slots have been measured serving
    tokens minted before a reboot. The record that would contradict it is
    root-only and this service cannot read it.

    So it is wired so that a stale value cannot do any harm THAT DOES NOT DEPEND
    ON MY HAVING ENUMERATED THE STALE CASES CORRECTLY. It may only ever cause a
    refusal, never a resume. Every case I could construct where it is stale also
    has occupancy false -- but that is a claim about what I could imagine, and
    refuse-only is sound whether or not the enumeration was complete. Same shape
    as failing closed on a credential.

    None means "nothing published here", which is NOT "the same as before".
    It is the normal state of a slot whose web root has just been rebuilt --
    hdw4s-webroot copies a fresh tree and the token is absent until the next
    session start -- so absent is common, and a comparison that treated it as a
    match would resume a visitor onto whatever now holds the slot.
    """
    base = WEBROOT_DIR if root is None else root
    try:
        with open(os.path.join(base, instance, "hdw4s-incarnation"), "r") as f:
            v = f.read().strip()
    except OSError:
        return None
    return v or None


def session_replaced(rec, instance, at=None, rundir=None, webroot=None,
                     door=None):
    """Why this record no longer describes the desktop behind INSTANCE, or None.

    The two questions in one place, in the order that matters: is anything there
    at all, and if so is it the same thing. Occupancy decides; the token may only
    add a refusal on top.

    Takes its two roots as parameters for the same reason every other guard in
    this file takes a factory: a version that read only the module globals could
    not be proved against anything but the machine it was already running on,
    and proving it by mutating those globals is a red arm that edits the checker.
    """
    # WHAT WE DID OURSELVES, ASKED FIRST, AND BEFORE ANY INSTRUMENT. Everything
    # below reads the world, and the world is LATE: for seconds after a teardown
    # has been asked for, the runtime directory is still there, the port is still
    # listening and the published token still matches. A request landing in that
    # interval is proxied, only to be refused by the relay -- see
    # Ownership.end_session(). This needs no instrument, so it cannot be gated on
    # one being readable, which is why it is above the early return rather than
    # beside the other reasons.
    ended = rec.get("ended")
    if ended:
        return ended
    here = time.time() if at is None else at
    # A LETTING THAT NEVER HAD A DESKTOP IS GOOD FOR MINT_GRACE AND NO LONGER,
    # whatever the slot shows -- also asked before any instrument, because it
    # needs none. This used to be permitted for as long as the slot was OCCUPIED,
    # with no bound, and after MINT_GRACE the slot leaves slots_in_use() and is
    # re-let: so a visitor minted onto a slot who never came back could return
    # later and be proxied, with full input, into the desktop of whoever the slot
    # was let to next -- and attach() would then record that stranger's start
    # against their letting. Found by the threat review at function level, and it
    # survived a restart once the table was written down.
    if not rec.get("live") and here - rec["minted"] >= MINT_GRACE:
        return "no desktop ever came up on %s for this letting" % instance
    if not occupancy_readable(rundir):
        # The instrument is missing. It may not answer, in either direction --
        # "I could not look" must not be spent as either a permit or a refusal.
        return None
    occupied = slot_occupied(instance, rundir)

    if not rec.get("live"):
        # NOTHING HAS ANSWERED FOR THIS RECORD YET, so an empty slot is the
        # EXPECTED state rather than a reaped one. The mint comes first, the
        # redirect sends the browser, and that request is what starts the
        # session -- so between those two moments a perfectly healthy session
        # has no runtime directory. Gating there refuses every visitor at the
        # exact instant they arrive, which is what the first version of this
        # did to all thirty-one tests at once.
        #
        # Inside MINT_GRACE, so the only desktop that can be in the slot is the
        # one this letting's own first request is starting: the slot is held
        # out of the pool (slots_in_use) for exactly that long. Past it, see the
        # refusal above.
        return None

    if not occupied:
        return "the desktop behind %s has stopped" % instance
    # THE WINDOW, CLOSED. Occupancy says something is there; this says whether
    # it is still SERVING. The runtime directory outlives the session by half a
    # second or more, and proxying into that gap reaches only a relay that
    # refuses -- this answers the visitor at once instead. See the table above
    # slot_door_open().
    #
    # ONLY FOR A RECORD WHOSE DESKTOP ALREADY ANSWERED US. A session that is
    # STARTING has a runtime directory and no listener yet -- hdw4s-wait exists
    # precisely because the relay must wait for it -- so asking this of a
    # pending record would gate every visitor at the instant they arrive, which
    # is what an earlier version of the check two lines down did to thirty-one
    # tests at once. rec["live"] means a desktop answered a request of ours
    # through that very socket, so the door has been seen open for this letting.
    #
    # WHAT ACTUALLY PROTECTS THE PENDING CASE IS ITS EARLY RETURN ABOVE, not
    # this conjunct, and saying so is the point: a pending record never reaches
    # this line. The test proves the ORDER rather than the condition, by moving
    # this check above that branch and watching every arrival get gated. Keep
    # both -- the condition costs nothing and survives somebody rearranging the
    # function -- but do not read it as the thing standing between us and
    # gating the whole pool.
    ask_door = slot_door_open if door is None else door
    if rec.get("live") and ask_door(instance) is False:
        return "the desktop behind %s has stopped answering on its own stream socket" \
            % instance
    was = rec.get("incarnation")
    now = slot_incarnation(instance, webroot)
    if was is None and now is None:
        # Nothing published this token when the session was minted and nothing
        # publishes one now. No opinion -- said out loud at startup rather than
        # silently, so nobody reads this pair as corroboration that happened.
        return None
    if was != now:
        return "%s is running a different desktop than the one minted here" \
            % instance
    return None


def slots_in_use(own, slots=None):
    """Every slot that must not be minted onto, from BOTH halves of the fact.

    Two sources with different lifetimes, deliberately not merged into one
    record:

      the authority   a session runtime directory that exists. Survives our
                      restart, disappears when the sweep stops a desktop, and
                      is nobody's copy of anything.
      our own mint    a slot we handed out in the last few minutes whose
                      session has NOT YET ANSWERED. Ours to lose, and losing it
                      costs at most one double-booking inside the grace window
                      rather than a permanent one. It stops counting the moment
                      a desktop answers, because from then on the authority is
                      both sufficient and more current than we are.

    The union is what may not be re-let, and the ASYMMETRY is the point: losing
    "whose" sends a returning visitor to the gate, which is the designed damage;
    losing "in use" double-books a live desktop, which must never happen. So the
    half that must not be lost is the half we do not own.

    This is also what makes instances_in_use() stop being monotonic. It grew
    forever because nothing ever removed an entry -- forget() had one call site,
    inside an assertion -- so after one arrival per slot every later visitor got
    503 for as long as the process lived, whatever the sweep had stopped. Here a
    slot the sweep stopped simply stops appearing, because the authority stopped
    saying so.
    """
    now = time.time()
    taken = set()
    if occupancy_readable():
        # SLOTS IS PASSED BY THE ONE CALLER THAT MATTERS. pick_slot() has
        # already read the table and already refused if it could not, so the
        # default below is a fallback for nothing on the live path -- it is
        # kept because a future caller reaching this without a pool must not
        # get a directory listing, which is the substitution this change
        # removed everywhere else.
        if slots is None:
            slots = ephemeral_slots()
            if slots is None:
                slots = []
        for name in slots:
            if slot_occupied(name):
                taken.add(name)
    for inst, minted in own.pending_mints(now - MINT_GRACE):
        taken.add(inst)
    # THE SAME HALF, WRITTEN DOWN. pending_mints() above is this process's
    # memory of what it let; this is the part of that memory that survives our
    # own death, which is the one thing memory cannot do and the one case where
    # losing it PERMITS rather than refuses. A union, never a substitution: if
    # the filesystem half is empty because nothing could be written, the
    # in-memory half still holds every mint this process made.
    taken |= reserved_slots(now)
    # AND A SLOT THAT IS BEING TORN DOWN, which none of the three sources above
    # can see. A teardown is asynchronous and takes seconds; part way through it
    # the runtime directory is gone -- so the authority says FREE -- while the
    # session's processes are still being killed and its socket unit is still
    # listening. Minting onto that hands a visitor a slot whose desktop is about
    # to be shot, and it is also what made the gate above unsafe: if the slot can
    # be re-let mid-teardown then a fresh letting could be gated by the marker
    # that belongs to the previous one. The two halves are a matched pair and
    # neither is sound alone.
    for name in (slots or ()):
        if teardown_requested(name):
            taken.add(name)
    return taken


def assert_occupancy_is_read_not_created(occupied=slot_occupied,
                                         readable=occupancy_readable,
                                         replaced=session_replaced):
    """Prove the occupancy check observes, and prove the token can only refuse.

    Runs at every start beside the other three. What it catches is silent in
    both directions: an occupancy reader that creates what it reports makes
    every slot look taken, and one that reads a missing authority as "nothing
    is taken" makes every slot look free -- and both answers are well formed.

    Handed the real functions rather than building its own, and each of them
    takes its root as a parameter, so this exercises the shipping code against
    directories it builds. A red arm that has to edit the module under test
    proves nothing, and this project has already had one.
    """
    import shutil
    import tempfile

    # THIS GUARD IS ABOUT OCCUPANCY AND THE TOKEN, so the door is given no
    # opinion here rather than left to consult the real /proc/net/tcp, where it
    # would answer about whatever this machine happens to be listening on and
    # refuse every record below. Stubbed rather than removed: the door has its
    # own guard, assert_door_only_refuses_what_it_measured(), with both arms.
    # A guard that silently started testing two things would fail for the wrong
    # reason, which is the failure that looks most like success.
    _replaced = replaced

    def replaced(*a, **kw):
        kw.setdefault("door", lambda inst: None)
        return _replaced(*a, **kw)

    def LIVE(token, minted=0.0):
        """A record that has ATTACHED: a desktop answered and we noted which."""
        return {"live": True, "incarnation": token, "minted": minted}

    def PENDING(minted):
        """A record that has been minted and whose session has not answered."""
        return {"live": False, "incarnation": None, "minted": minted}

    d = tempfile.mkdtemp(prefix="hdw4s-demux-occ-")
    try:
        rundir = os.path.join(d, "run", "hdw4s")
        web = os.path.join(d, "webroot")

        # 1. A MISSING AUTHORITY IS NOT AN EMPTY ONE. Before anything is built,
        #    nothing may report a free pool -- "I could not look" and "nobody is
        #    here" are the same shape and must not be the same answer.
        assert not readable(rundir), \
            "an authority that does not exist reported itself present"
        assert replaced(LIVE(None), "ephemeral0", rundir=rundir, webroot=web) is None, \
            "a missing authority was spent as a verdict rather than withheld"

        os.makedirs(rundir)
        assert readable(rundir), "a present authority reported itself missing"

        # 2. READING MUST NOT CREATE. The property the whole design rests on.
        assert not occupied("ephemeral0", rundir), \
            "an unoccupied slot reported occupied"
        assert not os.path.exists(os.path.join(rundir, "ephemeral0")), \
            "ASKING whether a slot was occupied CREATED its runtime directory:" \
            " the reader is acting on the pool instead of observing it, which" \
            " is how a connect() probe started a desktop on every slot"

        # 3. PERMIT ARM. A running session with a matching token resumes.
        os.makedirs(os.path.join(rundir, "ephemeral0"))
        os.makedirs(os.path.join(web, "ephemeral0"))
        with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"), "w") as f:
            f.write("aaaa\n")
        assert occupied("ephemeral0", rundir), \
            "a slot with a live runtime directory reported free"
        assert replaced(LIVE("aaaa"), "ephemeral0", rundir=rundir, webroot=web) is None, \
            "a live session with its own token was refused to its owner"

        # 4. REFUSE ARM, occupancy. The sweep stops the desktop.
        shutil.rmtree(os.path.join(rundir, "ephemeral0"))
        assert replaced(LIVE("aaaa"), "ephemeral0", rundir=rundir, webroot=web), \
            "a reaped desktop still resolved for the visitor who held it --" \
            " they are routed to whatever starts on that slot next"

        # 5. REFUSE ARM, token. Reaped AND re-let: occupancy is true again, and
        #    only the token can tell that it is somebody else's desktop.
        os.makedirs(os.path.join(rundir, "ephemeral0"))
        with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"), "w") as f:
            f.write("bbbb\n")
        assert replaced(LIVE("aaaa"), "ephemeral0", rundir=rundir, webroot=web), \
            "a slot reaped and re-let to somebody else was resumed by the" \
            " previous holder: the token is not being compared"

        # 6. ABSENT IS NOT EQUAL, both ways round. A rebuilt web root publishes
        #    no token for a running session, and a slot that published none at
        #    mint may publish one later. Neither is a match.
        os.unlink(os.path.join(web, "ephemeral0", "hdw4s-incarnation"))
        assert replaced(LIVE("aaaa"), "ephemeral0", rundir=rundir, webroot=web), \
            "a token that has VANISHED was read as unchanged -- absent is not" \
            " equal, and it is the ordinary state of a rebuilt web root"
        with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"), "w") as f:
            f.write("cccc\n")
        assert replaced(LIVE(None), "ephemeral0", rundir=rundir, webroot=web), \
            "a token APPEARING where none was recorded was read as unchanged"

        # 6b. THE WINDOW BETWEEN A MINT AND ITS SESSION. A slot handed out a
        #     moment ago has no desktop yet -- the redirect has not been
        #     followed, and following it is what starts one. Refusing there
        #     refuses every visitor at the instant of arrival, which is what
        #     the first version of this did to the whole suite at once.
        shutil.rmtree(os.path.join(rundir, "ephemeral0"))
        assert replaced(PENDING(time.time()), "ephemeral0",
                        rundir=rundir, webroot=web) is None, \
            "a slot minted moments ago was gated for having no desktop yet --" \
            " the mint precedes the session, so this refuses on arrival"
        # And the window CLOSES. A slot handed out long ago with nothing ever
        # behind it is a dead address, and holding it costs the pool a slot for
        # the life of the process.
        assert replaced(PENDING(time.time() - 10 * MINT_GRACE), "ephemeral0",
                        rundir=rundir, webroot=web), \
            "a slot minted long ago with no desktop on it was held anyway"
        os.makedirs(os.path.join(rundir, "ephemeral0"))

        # 7. AND WHERE NO SLOT PUBLISHES ONE AT ALL, the token has no opinion
        #    and occupancy alone decides. Demanding a token nobody publishes
        #    would gate every visitor on a pool that has none.
        shutil.rmtree(web)
        assert replaced(LIVE(None), "ephemeral0", rundir=rundir, webroot=web) is None, \
            "a pool that publishes no tokens gated a live session anyway"
    finally:
        shutil.rmtree(d, ignore_errors=True)


# --------------------------------------------------------------------------
# Reclaiming a slot this router knows it let
# --------------------------------------------------------------------------
#
# THE RULING, AND THE PERMISSION IS IN THE QUALIFIER RATHER THAN THE VERB:
# "yes, the router can reclaim a slot it KNOWS IT LET." Its own letting record
# is the licence, and nothing else is. A slot that merely LOOKS wrong is not
# covered, and the difference is not a shade of meaning -- it is a live
# visitor's desktop.
#
# WHAT IS BEING RECLAIMED, because the word was got wrong once already and the
# wrong word produces the wrong repair. A GNOME logout stops the session; the
# slot's socket unit keeps listening, so the first connection after that starts
# a FRESH desktop in the same slot -- measured, with its control: 45 seconds
# with nothing connecting produced no desktop, and one connection produced a new
# incarnation. The client reloads every five seconds on stream loss, so that
# connection is the visitor's own browser, essentially every time. What is left
# behind is NOT AN EMPTY SLOT. It is a full desktop running for nobody, burning
# memory and CPU, and a repair shaped as "mark it free" would hand the next
# visitor a live stranger's desktop -- the one outcome this exists to prevent.
# So the act is a TEARDOWN, and only then is the slot free.
#
# WHY THE LICENCE HAS TO BE THE RECORD AND NOT THE MISMATCH. Between the logout
# and the runtime directory going away there is a window, measured at roughly
# 0.7 to 2 seconds, in which the slot reads FREE to slots_in_use(). A second
# visitor can be minted onto it in that window. If they are, the first
# visitor's stale record still points at that slot, and the desktop there still
# fails to match it -- so a repair that reclaimed on mismatch alone would
# destroy the second visitor's desktop, seconds old, while they were looking at
# it. The same is true after a restart of this service, where the table is empty
# and every returning tab presents a letting we no longer hold.
#
# Hence: a letting we can still produce, that we SAW a desktop answer for, whose
# slot NOBODY ELSE now holds. Any one of those missing and we decline. Every
# decline is logged, because a guard whose refusal is silent cannot be told from
# one that never ran.

TEARDOWN_DIR = os.environ.get("HDW4S_TEARDOWN_DIR", "/run/hdw4s-teardown")


# HOW LONG A TEARDOWN IN PROGRESS MAY HOLD A SLOT OUT OF THE POOL. Bounded
# because the marker is removed by another process: hdw4s-teardown clears it from
# a trap on exit, so it survives only a SIGKILL -- and an unbounded marker after
# one of those would take a slot out of the pool until the next reboot, which is
# a capacity leak of exactly the kind this file was changed to stop. The bound is
# read from the marker's own mtime, the way a reservation is.
#
# THE NUMBER IS NOT FREE-CHOSEN: hdw4s-teardown@.service carries
# TimeoutStartSec=120, so systemd itself gives up at two minutes and nothing can
# still legitimately be tearing down after that. Doubling it leaves room for a
# box so loaded that systemd's own clock is the least of its problems, and the
# failure mode of being too generous is one slot, briefly.
TEARDOWN_MARKER_MAX = 240.0


def teardown_requested(instance, root=None, now=None):
    """True when this slot is being ended -- asked for, or part way through.

    TWO FILES, AND THE SECOND ONE IS THE REPAIR. The request file is removed by
    hdw4s-teardown BEFORE it does any work, and it has to be: the path unit fires
    on the file existing, so a teardown that left it in place would be started
    again forever. The consequence was that this function answered yes for a few
    milliseconds and no for the several SECONDS in which the desktop was actually
    dying -- the whole interval anybody needed it for. A guard that is true only
    outside the window it guards is not a guard.

    So hdw4s-teardown leaves a marker in "ending/<slot>" instead and clears it
    from a trap when it is done. A SUBDIRECTORY rather than a suffix on the same
    name: instance names may legally contain a dot -- hdw4s's own validator
    permits "A-Za-z0-9._-" -- so "<slot>.ending" is a name a slot could in
    principle have, and a marker that can be spelled as a request is a marker
    that can trigger the path unit. The one name this shape collides with is a
    slot called "ending", and hdw4s-teardown refuses that name outright rather
    than the comment asking anybody to avoid it.
    """
    base = TEARDOWN_DIR if root is None else root
    try:
        if os.path.exists(os.path.join(base, instance)):
            return True
    except OSError:
        return False
    try:
        st = os.stat(os.path.join(base, "ending", instance))
    except OSError:
        return False
    here = time.time() if now is None else now
    return (here - st.st_mtime) < TEARDOWN_MARKER_MAX


def request_teardown(instance, root=None):
    """Ask for this slot to be torn down. Returns None, or why it could not.

    THE ROUTER CANNOT DO THIS ITSELF AND MUST NOT BE ABLE TO. It runs as a
    DynamicUser with an empty CapabilityBoundingSet; stopping a unit or writing
    to a cgroup needs privilege this component deliberately does not have, and
    giving it any would put the box's teardown behind an HTTP surface that
    strangers reach. So the router's whole part is to write a file whose NAME is
    the slot, into a directory it can reach because of the same group membership
    that lets it reach the slot sockets -- the access story this component
    already has, rather than a second one.
    """
    base = TEARDOWN_DIR if root is None else root
    try:
        os.makedirs(base, exist_ok=True)
    except OSError:
        pass
    try:
        # O_EXCL so a second request is not a second teardown. An existing file
        # is success: what was asked for is already happening.
        os.close(os.open(os.path.join(base, instance),
                         os.O_CREAT | os.O_EXCL | os.O_WRONLY, 0o660))
        return None
    except FileExistsError:
        return None
    except OSError as e:
        return e.strerror or str(e)


def reclaimable(own, sid, rec, rundir=None, webroot=None):
    """None when this router may tear down what is in REC's slot, else why not.

    Every branch below returns a REASON rather than False, and the reasons are
    logged, because this is the one caller of the teardown that fires with
    nobody watching. The visitor's own discard has a person who clicked it and
    will notice if nothing happens; this one runs on a returning tab's request
    and nobody is reading the answer. So its refusals have to be legible after
    the fact or they are not evidence of anything.

    Takes its two roots as parameters for the same reason every other guard in
    this file does: a version that read only the module globals could be proved
    against nothing but the machine it was already running on.
    """
    if rec is None:
        # A LOST TABLE LANDS HERE, and it is the case the qualifier was written
        # for. The table survives a restart of this service, but not a file
        # that cannot be read, and not a row forgotten at the gate; a tab then
        # presents a letting this router cannot produce while the desktop it
        # names may go on running. "I do not know this session" must never
        # become "so I will destroy what is in its slot".
        return "there is no letting on record for that session"
    instance = rec.get("instance")
    if not instance:
        return "the letting on record names no slot"
    if not occupancy_readable(rundir):
        # The instrument is missing, so "nothing is there" and "I could not
        # look" are the same answer. An empty result is not a negative, and
        # here the empty result is the default one.
        return "%s could not be read, so nothing here knows what is in %s" \
            % (SESSION_RUNDIR if rundir is None else rundir, instance)
    if not rec.get("live"):
        # WE NEVER SAW A DESKTOP ANSWER FOR THIS LETTING, so we cannot say which
        # one we let -- only that we let the slot. Whatever is in it now may be
        # the session our own redirect started and which simply has not come
        # back to us yet, and tearing that down would end a desktop in the
        # seconds between handing it out and its first request.
        return "this router never saw a desktop answer for %s, so it cannot " \
            "say which one it let" % instance
    if not slot_occupied(instance, rundir):
        # Nothing is running, so there is nothing to reclaim. Said rather than
        # done: asking for a teardown here would put a line in the log claiming
        # a desktop was ended when none existed.
        return "no desktop is running in %s, so there is nothing to reclaim" \
            % instance
    was = rec.get("incarnation")
    now = slot_incarnation(instance, webroot)
    if was is None or now is None:
        # ABSENT IS NOT EQUAL, and it is not DIFFERENT either. Without a token
        # on both sides there is no way to tell the desktop we let from the one
        # that replaced it, and the safe direction for THIS act is the opposite
        # of the safe direction for resuming: there, absence refuses to hand
        # somebody a desktop; here, absence refuses to destroy one.
        return "%s cannot be told apart from the desktop this letting is for" \
            % instance
    if was == now:
        return "%s is still running the desktop this letting is for" % instance
    others = own.holders_of(instance, besides=sid, since=rec.get("minted"))
    if others:
        # RE-LET IN THE INTERVAL. The window between a logout and the runtime
        # directory going away is wide enough to mint onto, measured at roughly
        # 0.7 to 2 seconds, so this is not a theoretical ordering -- it is the
        # case the measuring seat was worried about, and it is exactly where a
        # mismatch-only repair evicts a real person.
        return "%s has been let to somebody else since" % instance
    return None


def reclaim_slot(own, sid, rec, why, request=None, rundir=None, webroot=None):
    """Tear down what is in REC's slot if this router let it. True when asked.

    WHY IT IS NOT DONE HERE. The teardown is privileged -- it stops a unit and
    writes to another cgroup -- and this process is a DynamicUser with no
    capabilities on purpose. It writes one file whose name is a slot, and
    hdw4s-teardown@<slot>.service does the rest, keyed by the instance name
    systemd fills in rather than by anything written here.

    SO THE RECLAIM IS ASYNCHRONOUS AND THE VISITOR IN FRONT OF US DOES NOT WAIT
    FOR IT. They are gated in the same breath, which is the right answer for
    them whether or not the slot ever comes back; the slot returns to the pool a
    second or two later, for whoever arrives next.
    """
    # UNDER THE LETTING LOCK, for the race let_slot() closes, seen from the
    # other side. reclaimable() says "a desktop is running here and nobody
    # else has been let this slot"; between that answer and the request below,
    # the desktop can stop and the slot be let to a new visitor, whose fresh
    # desktop the request would then end. Held here, a letting lands either
    # before the question (holders_of() sees it, and this declines) or after
    # the request (teardown_requested() makes the slot taken, and it is not
    # offered).
    with own.letting:
        return _reclaim_slot(own, sid, rec, why, request, rundir, webroot)


def _reclaim_slot(own, sid, rec, why, request, rundir, webroot):
    no = reclaimable(own, sid, rec, rundir=rundir, webroot=webroot)
    if no is not None:
        log("did not reclaim a slot: %s" % no)
        return False
    instance = rec["instance"]
    if teardown_requested(instance):
        log("%s is already being torn down; not asking twice." % instance)
        return True
    err = (request_teardown if request is None else request)(instance)
    if err is not None:
        # Loud, and it changes nothing else: the visitor was gated either way.
        # The failure this most likely is -- a read-only filesystem because the
        # ReadWritePaths= line went missing -- reports itself here rather than
        # succeeding and ending nothing.
        log("could not ask for %s to be reclaimed: %s" % (instance, err))
        return False
    log("reclaiming %s: %s, and this router is the one that let it"
        % (instance, why))
    return True


def assert_reclaim_needs_a_letting(judge=None, factory=None):
    """Prove the reclaim acts on OUR letting and on nothing else, at every start.

    Runs beside the other guards. What it catches is silent and expensive in one
    direction only: a reclaim that fires without a letting ends a desktop
    somebody is using, and the visitor sees a black screen and a gate, with
    nothing anywhere saying that we did it. The permit arm is not optional
    either -- a version that refused everything would leave the leak in place
    and look perfectly well behaved.

    Handed the real functions and given real directories to read, because a red
    arm that has to edit the module under test proves nothing.
    """
    import shutil
    import tempfile

    judge = reclaimable if judge is None else judge
    factory = Ownership if factory is None else factory

    d = tempfile.mkdtemp(prefix="hdw4s-reclaim-")
    try:
        rundir = os.path.join(d, "run")
        web = os.path.join(d, "web")
        os.makedirs(os.path.join(rundir, "ephemeral0"))
        os.makedirs(os.path.join(web, "ephemeral0"))

        def publish(token):
            with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"),
                      "w") as f:
                f.write(token + "\n")

        def let(live_as=None):
            """A letting, minted the way the front door mints one."""
            own = factory()
            sid = own.mint_session("visitor", "ephemeral0")
            if live_as is not None:
                own.attach(sid, live_as)
            return own, sid

        publish("SECOND")

        # 1. THE CASE THE RULING PERMITS. We let the slot, we saw a desktop
        #    answer and noted which, something else is in there now, and no
        #    other letting names it.
        own, sid = let(live_as="FIRST")
        assert judge(own, sid, own.lookup(sid), rundir=rundir,
                     webroot=web) is None, \
            "the router would not reclaim a slot it let and watched be replaced"

        # 2. NO LETTING ON RECORD. This is what a restart of this service leaves
        #    behind for every tab on the box, and it must never reclaim.
        assert judge(own, "nosuchsid", None, rundir=rundir, webroot=web), \
            "a session with NO letting on record was reclaimed anyway"

        # 3. RE-LET TO SOMEBODY ELSE IN THE INTERVAL. The stale letting still
        #    points here and still mismatches; the slot is not ours to end.
        own2, sid2 = let(live_as="FIRST")
        stale = own2.lookup(sid2)
        own2.forget(sid2)
        own2.mint_session("a different visitor", "ephemeral0")
        assert judge(own2, sid2, stale, rundir=rundir, webroot=web), \
            "a slot re-let to somebody else was reclaimed out from under them"

        # 4. MINTED BUT NEVER ANSWERED. The desktop in there may be the one our
        #    own redirect started moments ago.
        own3, sid3 = let()
        assert judge(own3, sid3, own3.lookup(sid3), rundir=rundir,
                     webroot=web), \
            "a slot whose desktop had never answered us was reclaimed"

        # 5. STILL OURS. The commonest case, and the most expensive to get
        #    wrong: this is a healthy session being routed to.
        own4, sid4 = let(live_as="SECOND")
        assert judge(own4, sid4, own4.lookup(sid4), rundir=rundir,
                     webroot=web), \
            "a slot still running the desktop it was let for was reclaimed"

        # 6. NOTHING RUNNING. Nothing to end, so nothing is claimed to be.
        shutil.rmtree(os.path.join(rundir, "ephemeral0"))
        assert judge(own, sid, own.lookup(sid), rundir=rundir, webroot=web), \
            "a slot with no desktop in it produced a teardown request"
        os.makedirs(os.path.join(rundir, "ephemeral0"))

        # 7. NO TOKEN TO COMPARE. A pool that publishes nothing cannot tell the
        #    two desktops apart, and must not guess in the destroying direction.
        shutil.rmtree(web)
        assert judge(own, sid, own.lookup(sid), rundir=rundir, webroot=web), \
            "a slot was reclaimed on a comparison that could not be made"
        os.makedirs(os.path.join(web, "ephemeral0"))
        publish("SECOND")

        # 8. THE INSTRUMENT MISSING. "I could not look" is spent as neither a
        #    permit nor a refusal anywhere else in this file, and least of all
        #    here.
        gone = os.path.join(d, "no-such-run")
        assert judge(own, sid, own.lookup(sid), rundir=gone, webroot=web), \
            "a slot was reclaimed while the occupancy authority was unreadable"
    finally:
        shutil.rmtree(d, ignore_errors=True)


def assert_door_only_refuses_what_it_measured(paths=None, door=None,
                                              replaced=None, factory=None):
    """Prove the door instrument, in both directions, at every start.

    THE ONE IT EXISTS FOR IS THE FALSE OPEN. A check that looked for the stream
    socket's path anywhere in /proc/net/unix would find a socket that is bound
    there and not accepting -- what a dying server leaves for an instant -- and
    report the door open, keeping the leak while looking like a working repair.
    That is the quiet direction, so it is the first case below and it is built
    from a real fixture rather than reasoned about.

    The loud direction is guarded too, because it costs a person their desktop:
    a missing instrument must answer None and never False, and a session that
    is STARTING must not be gated for not listening yet.
    """
    import shutil
    import tempfile

    paths = listening_paths if paths is None else paths
    door = slot_door_open if door is None else door
    replaced = session_replaced if replaced is None else replaced
    factory = Ownership if factory is None else factory

    d = tempfile.mkdtemp(prefix="hdw4s-door-")
    try:
        root = os.path.join(d, "stream")
        mine = stream_socket_path("ephemeral0", root)
        other = stream_socket_path("ephemeral1", root)

        head = "Num       RefCount Protocol Flags    Type St Inode Path\n"
        LISTENING, BOUND = "00010000", "00000000"

        def netfile(name, rows):
            path = os.path.join(d, name)
            with open(path, "w") as f:
                f.write(head)
                for i, (sock, flags) in enumerate(rows):
                    f.write("0000000000000000: 00000002 00000000 %s 0001 01"
                            " %d %s\n" % (flags, 1000 + i, sock))
            return path

        # 1. THE FALSE OPEN. The session's own path is present, and NOT
        #    listening; a different path is. A check that matched the path
        #    anywhere in the table would call this door open.
        f1 = netfile("unix-bound", [(mine, BOUND), (other, LISTENING)])
        got = paths(f1)
        assert mine not in got, \
            "a socket that was bound and not listening was counted as an open " \
            "door -- the door would read OPEN for a session that has gone"
        assert other in got, \
            "a genuinely listening socket was missed, so this parser cannot " \
            "find a positive and none of its negatives mean anything"

        # 2. THE PERMIT ARM. The same path, actually listening.
        f2 = netfile("unix-listen", [(mine, LISTENING)])
        assert mine in paths(f2), "a listening stream socket was not found"

        # 3. A FAILURE TO READ IS NOT AN EMPTY SET.
        assert paths(os.path.join(d, "no-such-file")) is None, \
            "an unreadable /proc/net/unix was reported as 'nothing is " \
            "listening', which would gate every visitor on the box"

        # 4. THE DOOR ITSELF, three-valued, and about THIS slot only: another
        #    slot listening does not open this one's door.
        assert door("ephemeral0", listening=paths(f2), root=root) is True
        assert door("ephemeral0", listening=paths(f1), root=root) is False, \
            "another slot's listener, or this slot's bound-but-shut socket, " \
            "opened this slot's door"
        assert door("ephemeral0", listening=None, root=root) is None, \
            "a table that could not be read answered a question nobody could " \
            "ask -- a missing instrument must never refuse"
        # 5. AND IN session_replaced, WHERE IT COSTS SOMETHING. The door may
        #    only speak for a record whose desktop already answered us.
        rundir = os.path.join(d, "run")
        web = os.path.join(d, "web")
        os.makedirs(os.path.join(rundir, "ephemeral0"))
        os.makedirs(os.path.join(web, "ephemeral0"))
        with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"), "w") as f:
            f.write("TOKEN\n")

        LIVE = {"live": True, "incarnation": "TOKEN", "minted": 0.0}
        PENDING = {"live": False, "incarnation": None, "minted": time.time()}
        SHUT, OPEN, CANNOT = (lambda i: False), (lambda i: True), (lambda i: None)

        why = replaced(LIVE, "ephemeral0", rundir=rundir, webroot=web, door=SHUT)
        assert why and "own stream socket" in why, \
            "a session that had stopped answering was routed to anyway, which " \
            "is a wasted connection the relay refuses: %r" % why
        assert replaced(LIVE, "ephemeral0", rundir=rundir, webroot=web,
                        door=OPEN) is None, \
            "a healthy session was gated by the door check"
        assert replaced(LIVE, "ephemeral0", rundir=rundir, webroot=web,
                        door=CANNOT) is None, \
            "a door that could not be asked was spent as a refusal"
        # THE ONE THAT COSTS EVERY VISITOR IF IT IS WRONG. A session that is
        # starting has a runtime directory and is not listening yet.
        assert replaced(PENDING, "ephemeral0", rundir=rundir, webroot=web,
                        door=SHUT) is None, \
            "a session that was still STARTING was gated for not listening " \
            "yet -- that gates every visitor at the instant they arrive"
    finally:
        shutil.rmtree(d, ignore_errors=True)


def pick_slot(own):
    """A slot with no desktop behind it and no fresh mint on it, or None.

    "Free" means UNMINTED CAPACITY, not an idle desktop: under the identity
    ruling every session that has been arrived at is owned by the browser that
    arrived, so there is no pool of free sessions to balance across. "Pick a free
    one" and "mint one" are the same act here.

    REACHABLE SLOTS FIRST, but an unreachable one is still offered rather than
    withheld. A slot the sweep has just reaped is momentarily unreachable and is
    exactly the capacity we want to hand out -- its socket unit is still
    listening and the next letting's first request starts a fresh desktop.
    Refusing a visitor
    while such a slot stood free would be the exhaustion defect wearing a
    reachability check.

    THE POOL IS THE TABLE, not the socket directory. Every proxy instance on the
    box binds into one directory, so a listing of it offered a named desktop's
    leftover socket to a stranger; ephemeral_slots() asks the file that carries
    the type instead. None from it is "the table could not be read", which
    refuses -- and says which file -- rather than falling back to the listing
    that was the defect.
    """
    pool = ephemeral_slots()
    if pool is None:
        log("cannot read the slot table at %s, so nothing here knows which"
            " slots are ephemeral." % SLOTS_FILE)
        log("  No slot will be minted until it can be read. The sockets under"
            " %s are NOT a substitute: every instance on this box binds into"
            " that one directory, named desktops included." % PROXY_RUNDIR)
        return None
    taken = slots_in_use(own, pool)
    free = [n for n in pool if n not in taken]
    if not free:
        return None
    listening = listening_paths()
    if listening is not None:
        for name in free:
            if slot_unreachable(name, listening) is None:
                return name
    return free[0]


def let_slot(own, identity):
    """(instance, sid) for a slot now let to IDENTITY, or (None, None) if none is free.

    THE PICK AND THE RECORD ARE ONE ACT, and they were two. Every connection is
    served on its own thread, and pick_slot() decides "free" from what the
    table and the reservations say; the mint and the reservation were written
    only after it returned. So every arrival that picked before the first one
    recorded saw the SAME slot free. Measured on a development container
    2026-09-27: nine new visitors at one instant, nine mints, TWO slots -- six
    on one, three on the other -- inside a second. Against stand-in slots a
    slot let twice gates the EARLIER letting as superseded, so a burst's
    visitors were told their brand-new desktop had ended; a visitor whose first
    request reached the desktop before the second mint would instead share it
    with a stranger, and an ephemeral desktop runs untrusted code with full
    input. Whether that happened on the box was not established.

    A LOCK, NOT A RE-CHECK AFTER THE FACT. Minting, then asking whether anybody
    else minted the same slot and backing out, has a loser who must be told
    something and a window in which both are recorded; holding one lock across
    the question and the answer has neither. What it costs is that mints are
    served one at a time, and a mint is a stat or two and one small write to a
    tmpfs -- nothing here waits on a desktop.

    THE LOCK IS THE TABLE'S, not the module's, so a start-up self-check that
    builds its own table cannot contend with a live one. Its reach ends at this
    process: two routers against one state directory would race exactly as
    before, which reserve_slot() already names as a dependency (one socket
    unit, Accept=no, one service instance).
    """
    with own.letting:
        instance = pick_slot(own)
        if instance is None:
            return None, None
        sid = own.mint_session(identity, instance)
        # WRITTEN DOWN BEFORE THE REDIRECT, and the order is the point. The
        # redirect leads to the letting's first request, which is what asks
        # for the desktop to be started (start_for_first_request()), so a
        # reservation recorded after it would leave the slot unheld across
        # exactly the window where this process can die and forget it.
        reserve_slot(instance)
    return instance, sid


# --------------------------------------------------------------------------
# Starting a desktop: the router asks, and nothing else can
# --------------------------------------------------------------------------
#
# ONLY THE ROUTER STARTS AN EPHEMERAL DESKTOP, and only for a letting it made. It used to be the first CONNECTION to
# the slot's socket that started it -- socket activation, with the relay bound to
# the session -- and that made every connection a start instruction: a stale tab
# reconnecting after a logout, a request landing in the seconds a dying desktop
# still listened, a prefetch, anything that could reach the socket. Four rounds
# of guards (a three-second wait after a hang-up, a port check, and on an
# unmerged branch two records of a desktop's end) each narrowed that race and
# none closed it; measured on a
# development box 2026-09-28, a reconnect was still proxied 29 ms before the last
# of those records existed. So the race is removed instead of won: the relay of
# an ephemeral slot is Requisite= on its session (a connection to a slot with no
# desktop is refused, never a start), and the one act that starts a desktop is
# this request, written by the one component that decides a visitor gets one.
#
# WHEN: AT THE LETTING'S FIRST REQUEST, not at the mint. Only for a letting whose
# desktop has never answered (so never a desktop that has ended, and never a
# resurrection), only while the slot shows no desktop, and under the letting
# lock. Not at the mint because a mint whose redirect is never followed -- a
# client that does not follow redirects, a tab closed at once -- would then start
# a desktop that runs for nobody until the idle sweep, seven days on a stock box,
# where today such a mint holds its slot for MINT_GRACE and starts nothing. The
# first request is the moment the visitor is known to be there, and it is the
# same moment the desktop started under the old shape.
#
# THE REQUEST, as an interface other code builds on:
#
#   <START_DIR>/<slot>   a regular file, written by this router only (the
#                        directory is root's, mode 0770, group www-data, which
#                        this service joins; no session user is in it). The
#                        FILE NAME IS THE SLOT and is the whole instruction, as
#                        for a teardown request. Written beside and renamed
#                        over, under the letting lock, at the letting's first
#                        request (start_for_first_request()).
#   its content          zero or more LF-terminated lines "<key> <value...>",
#                        at most 4 KiB, ASCII. Nothing is defined yet and every
#                        reader must ignore a key it does not know. RESERVED for
#                        the start size, written by this router in the same
#                        write, under the same lock: exactly one of
#                          measured <W> <H>
#                          invalid <rule>
#                          absent <why>
#                        No component may interpolate any field into a shell
#                        command; each reader re-validates what it uses.
#
# WHO CONSUMES IT, AS ROOT, AND IN WHAT ORDER -- which is what makes a field in
# it belong to exactly one start:
#
#   1. hdw4s-start@<slot>.path sees the file (PathExists=) and runs
#      hdw4s-start@<slot>.service, root, which RENAMES it to
#      /run/hdw4s-start-taken/<slot> (root, 0700 directory) -- so a request is
#      taken at most once, and a second one for the slot is a new file -- and
#      only then asks systemd to start hdw4s-ephemeral@<slot>.
#   2. That start runs hdw4s-incarnation@<slot> first (After=), which mints
#      THIS start's token. A consumer that must bind a field to this start
#      does so there, as root, and DELETES the taken request as it reads it:
#      exactly once per start, and a start nobody asked for through this path
#      (an administrator's systemctl start) finds no request and no field.
#   3. Only then does the session itself start.

START_DIR = os.environ.get("HDW4S_START_DIR", "/run/hdw4s-start")

# HOW LONG A REQUEST THAT IS NOT A PAGE WAITS FOR A DESKTOP BEING STARTED. The
# same thirty seconds forward_request() already gives an upstream to answer, so
# nothing that used to be served is now refused sooner. A page does not wait
# this long: it gets the starting page after STARTING_PAGE_AFTER, as before.
FIRST_ANSWER_WAIT = 30.0


def await_desktop(instance, navigation, door=None, clock=time.monotonic,
                  sleep=time.sleep):
    """Wait for the desktop a MINT asked for to be listening. Before a letting's
    first connection, never after.

    WHY THE ROUTER WAITS INSTEAD OF CONNECTING. A connection no longer starts a
    desktop; the relay of an ephemeral slot is Requisite= on its session, so a
    connection that arrives before the start request has become a running unit
    is refused -- and the first request after a mint is always that early,
    because the redirect is milliseconds and a start is seconds. So the first
    connection is made only once the desktop's own stream socket is listening,
    which is the moment it can answer. That is read from the kernel's table
    (slot_door_open()), which opens nothing.

    WHEN THE TABLE CANNOT BE READ the session's runtime directory stands in
    for it: it exists
    from the moment the unit starts activating, and the relay's After= then
    holds the connection until the session is active. Connecting before even
    that is the race a refusal loses: measured in the stand-in, a slot whose
    door could not be read had its first request refused about half the time.

    Returns "up", "starting" (a page navigation that has waited
    STARTING_PAGE_AFTER: it gets the starting page, exactly when it used to),
    "late" (anything else, after FIRST_ANSWER_WAIT: the answer a desktop that
    never answered always got), or "unknown" when neither the door nor the
    runtime directory can be read -- then the request is forwarded as before.
    """
    ask = slot_door_open if door is None else door
    end = clock() + (STARTING_PAGE_AFTER if navigation else FIRST_ANSWER_WAIT)
    while True:
        up = ask(instance)
        if up is None:
            if not occupancy_readable():
                return "unknown"
            up = slot_occupied(instance)
        if up:
            return "up"
        if clock() >= end:
            return "starting" if navigation else "late"
        sleep(0.05)


def still_this_letting(own, sid, grace=True):
    """Why SID's letting may no longer use its slot, or None. Asked of the
    TABLE, by sid, never of a copy of the record a handler read earlier.

    Called under own.letting, so no mint can change the answer between the
    question and what the caller does with it. GRACE says whether a letting
    that never had a desktop and is past MINT_GRACE is refused too: at the
    start request, yes (the slot may be let again from that instant); after
    the wait for the desktop, no -- the start request renewed the hold, so the
    slot cannot have been let since.
    """
    rec = own.lookup(sid)
    if rec is None:
        return "there is no letting on record for it"
    if rec.get("ended"):
        return rec["ended"]
    if own.superseded(sid):
        return "%s has been let again since this letting" % rec["instance"]
    if grace and not rec.get("live") and \
            time.time() - rec["minted"] >= MINT_GRACE:
        return "no desktop ever came up on %s for this letting" \
            % rec["instance"]
    return None


def start_for_first_request(own, sid):
    """Ask for SID's desktop to be started if this is the moment. None to go
    on, or why this letting may not (the caller gates the visitor).

    Asked for a letting whose desktop has never answered, and only while its
    slot shows no desktop at all -- a desktop already starting or running is
    left alone, which is what makes a second first-request (a browser opens two
    connections) and a router restart harmless.

    THE CHECK AND THE ACT UNDER ONE LOCK, and the hold RENEWED. Found by the
    threat review at function level: a letting whose first request came just
    inside MINT_GRACE passed the gate, asked for its start, and the grace then
    ran out before the session's runtime directory existed -- so for that gap
    nothing held the slot (not pending, reservation stale, not occupied), a
    second visitor was let it, and the first visitor's request was forwarded
    into the second visitor's desktop. So the letting is re-read here by sid,
    under the letting lock, and refused if it is no longer this slot's; and the
    reservation is renewed as the start is asked for, so the slot stays held
    for MINT_GRACE from THIS moment -- until the desktop is up and occupancy
    speaks for it.
    """
    with own.letting:
        why = still_this_letting(own, sid)
        if why is not None:
            return why
        rec = own.lookup(sid)
        if rec.get("live"):
            return None
        instance = rec["instance"]
        renew_reservation(instance)
        if occupancy_readable() and slot_occupied(instance):
            return None
        request_start(instance)
        return None


def request_start(instance, root=None, lines=()):
    """Ask for the desktop in INSTANCE to be started. True when asked.

    A failure is logged and the letting stands: its visitor meets the starting
    page and then the router's own answer that the desktop never came, which is
    what a start that fails for any other reason also produces -- not a
    connection that starts it behind the router's back, which is what this
    replaced.
    """
    base = START_DIR if root is None else root
    body = "".join("%s\n" % l for l in lines).encode("ascii", "replace")[:4096]
    tmp = os.path.join(base, ".%s.%d" % (instance, os.getpid()))
    try:
        fd = os.open(tmp, os.O_WRONLY | os.O_CREAT | os.O_TRUNC, 0o660)
        with os.fdopen(fd, "wb") as f:
            f.write(body)
        os.replace(tmp, os.path.join(base, instance))
        return True
    except OSError as e:
        log("could not ask for %s to be started: %s. Its visitor will wait on "
            "the starting page for a desktop that is not coming."
            % (instance, e.strerror or e))
        try:
            os.unlink(tmp)
        except OSError:
            pass
        return False


# --------------------------------------------------------------------------
# HTTP
# --------------------------------------------------------------------------

class Closed(Exception):
    pass


def read_line(rf):
    line = rf.readline()
    if not line:
        raise Closed()
    return line


def read_headers(rf):
    headers = []
    while True:
        line = read_line(rf)
        if line in (b"\r\n", b"\n"):
            return headers
        if len(headers) > 200:
            raise Closed()
        headers.append(line)


def header_value(headers, name):
    want = name.lower().encode()
    for h in headers:
        if h.lower().startswith(want + b":"):
            return h.split(b":", 1)[1].strip()
    return None


# NO PAGE OF THE ROUTER'S MAY BE FRAMED. The directory's Discard, Resume and
# New desktop are presses on this origin, so a page elsewhere that framed
# /sessions/ under something that looks clickable would get a SAME-ORIGIN press
# out of the visitor, which the cross-site refusal passes by design. Nothing of
# ours frames these pages. Both headers, because frame-ancestors is the
# standard and X-Frame-Options is what a browser that predates it reads.
# On every response this router writes itself. A desktop's responses carry what
# the desktop wrote of these, if anything: both are on RESPONSE_FIELDS.
FRAME_HEADERS = (("Content-Security-Policy", "frame-ancestors 'none'"),
                 ("X-Frame-Options", "DENY"))


def carries_our_cookie(extra):
    """Does this response carry a Set-Cookie of the router's?

    If it does, NO SHARED CACHE MAY KEEP IT: a cache between the browser and
    here that stored it would hand one browser's identity to the next one
    that asked for the same address. So such a response is always marked
    private -- the router's own pages here, and a desktop's in
    response_head(), where the desktop's own Cache-Control (a "public" rode
    along before, noted by the Round D threat review) is replaced."""
    return any(k.lower() == "set-cookie" for k, _ in extra)


def respond(wf, status, body=b"", extra=()):
    reason = {
        200: "OK", 302: "Found", 400: "Bad Request", 401: "Unauthorized",
        303: "See Other",
        403: "Forbidden", 404: "Not Found", 410: "Gone",
        502: "Bad Gateway", 503: "Service Unavailable",
    }.get(status, "Error")
    out = [b"HTTP/1.1 %d %s\r\n" % (status, reason.encode())]
    out.append(b"Content-Length: %d\r\n" % len(body))
    out.append(b"Content-Type: text/html; charset=utf-8\r\n")
    if carries_our_cookie(extra) and \
            not any(k.lower() == "cache-control" for k, _ in extra):
        extra = tuple(extra) + (("Cache-Control", "private"),)
    for k, v in tuple(FRAME_HEADERS) + tuple(extra):
        out.append(b"%s: %s\r\n" % (k.encode(), v.encode()))
    out.append(b"\r\n")
    wf.write(b"".join(out))
    if body:
        wf.write(body)
    wf.flush()


