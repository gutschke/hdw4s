def parse_target(target):
    """Split a request target into (sid, remainder, query).

    /s/<sid>/rest?q -> (sid, "/rest", "q");  anything else -> (None, path, query)
    """
    path, _, query = target.partition(b"?")
    parts = path.split(b"/")
    if len(parts) >= 3 and parts[1] == b"s" and parts[2]:
        sid = parts[2].decode("ascii", "replace")
        rest = b"/" + b"/".join(parts[3:])
        return sid, rest, query
    return None, path, query


def needs_trailing_slash(target):
    """True for /s/<sid> exactly, which must be redirected to /s/<sid>/.

    Not cosmetic, and the failure it prevents is confusing rather than loud: the
    web client takes its base URL from the DIRECTORY part of its own
    location.pathname. Loaded from /s/<sid> that base is "/s", so every asset
    and both WebSocket routes are then requested from the wrong place, and the
    first symptom is a desktop that never appears rather than a 404 on the page
    you asked for. Measured: the client computes its prefix from the URL it was
    loaded from, and the server registers its index at exactly one path.
    """
    path = target.partition(b"?")[0]
    parts = path.split(b"/")
    return len(parts) == 3 and parts[1] == b"s" and bool(parts[2])


def is_front_door(path):
    """The only path that may reach arrival(), which mints: / itself, with or
    without a query (the query is not part of PATH). See serve()."""
    return path == b"/"


# THE IDENTITY COOKIE'S NAME CARRIES THE __Host- PREFIX, and the prefix is the
# point rather than decoration. Every desktop serves script on this origin, and
# script can write cookies. Under the old bare name one line of it --
# document.cookie = "hdw4s_id=<attacker's>; path=/; secure; domain=<host>" --
# set a DOMAIN cookie beside the router's host-only HttpOnly one, the browser
# sent both, and the parser here (SimpleCookie) took the last: measured by the
# threat review in Chrome 153, end to end, the victim's directory then listed
# the attacker's identity and the victim's next New desktop was the attacker's
# to open. A __Host- cookie must be Secure, Path=/ and carry no Domain, so the
# browser refuses a domain twin and a path shadow of it (measured, same
# review). What it cannot refuse is a script that first evicts ours by
# flooding the jar and then writes its own: that route is known and open by
# the owner's ruling of 2026-09-28 (a separate origin for desktops is the only
# fix, and it is filed, not built).
#
# Changing the name drops every existing browser's identity at the upgrade:
# its desktops are no longer listed to it and end on their idle window.
IDENTITY_COOKIE = "__Host-hdw4s_id"


def identity_of(headers):
    """This browser's identity, or None.

    Read from EVERY Cookie line, by name, exactly. The bare legacy name, and
    every other name a script could set, is never looked at. If more than one
    distinct value arrives under our name -- which a __Host- cookie should
    make impossible short of the flood above -- NONE of them is believed:
    picking one is how a planted twin won, and the cost of refusing is only a
    fresh identity for a browser whose jar has been tampered with."""
    found = set()
    for h in headers:
        name, sep, value = h.partition(b":")
        if not sep or name.strip().lower() != b"cookie":
            continue
        for pair in value.decode("latin-1").split(";"):
            k, eq, v = pair.partition("=")
            if eq and k.strip() == IDENTITY_COOKIE:
                found.add(v.strip())
    if len(found) != 1:
        if len(found) > 1:
            say_once(("identities", len(found)),
                     "a browser presented %d different identity cookies; "
                     "none was believed. Said once per count." % len(found))
        return None
    v = found.pop()
    # Our own mint is 32 hex characters. Anything else is somebody's guess.
    if len(v) != 32 or any(c not in "0123456789abcdef" for c in v):
        return None
    return v


def gate_arm(query):
    """The arm for this arrival. The query string wins over the built default,
    exactly as the page-side gate in hdw4s-gate-index already behaves, so the
    two layers agree about which arm is in force."""
    try:
        q = urllib.parse.parse_qs(query.decode("latin-1"))
    except Exception:
        return GATE_DEFAULT
    want = (q.get("gate") or [GATE_DEFAULT])[0]
    return want if want in GATE_ARMS else GATE_DEFAULT


def set_cookie_header(identity, lifetime=None):
    # Secure is set unconditionally: the browser reaches this through nginx over
    # TLS, and Chrome treats http://127.0.0.1 as a trustworthy origin, so the
    # harness's loopback tab accepts it too.
    #
    # Max-Age is the DERIVED lifetime, and this header is written on refreshes
    # as well as on mints, which is what makes it a sliding window rather than
    # a fuse lit at first contact.
    if lifetime is None:
        lifetime = COOKIE_LIFETIME
    # No Domain, Path=/ and Secure: all three are what IDENTITY_COOKIE's
    # prefix requires, and a browser drops the cookie if any is missing.
    return ("%s=%s; Path=/; HttpOnly; SameSite=Lax; Secure; Max-Age=%d"
            % (IDENTITY_COOKIE, identity, lifetime))


def refresh_headers(own, identity, new_identity):
    """The Set-Cookie to attach to whatever we are about to write, if any.

    Called from EVERY response this component composes and from every response
    it relays, because the tab that most needs its identity kept alive is the
    one sitting at /s/<sid>/ that never goes near the front door again. A window
    that only slides at the front door is a fuse for exactly that tab.
    """
    if new_identity or own.due_for_refresh(identity):
        return [("Set-Cookie", set_cookie_header(identity))]
    return []


def arrival_dest(headers):
    """What the browser says it is fetching at the front door, for arrival().

    Its Sec-Fetch-Dest, EXCEPT that a prefetch or prerender is not a page
    anybody opened, whatever it calls itself. Chrome sends those as a
    "document" and marks them with Sec-Purpose (older ones: Purpose), so an
    unopened speculation would otherwise hold a slot for the whole grace
    window for a visitor who may never come.
    """
    purpose = header_value(headers, "Sec-Purpose") or \
        header_value(headers, "Purpose") or b""
    if purpose.strip().lower().startswith(b"prefetch"):
        return b"prefetch"
    return header_value(headers, "Sec-Fetch-Dest")


def arrival(own, wf, identity, query, new_identity, dest=None):
    """Decide where this tab goes, and send it there. One place, per §13.

    DEST is the request's Sec-Fetch-Dest, None when the browser sent none.
    """
    extra = refresh_headers(own, identity, new_identity)

    arm = gate_arm(query)
    owned = own.owned_by(identity)

    sid = None
    # Whether the session this arrival lands on was created by THIS request.
    # Kept as its own fact rather than inferred from "owned was empty": the
    # resume loop below can drop every candidate it finds and fall through to
    # the mint, and an inference would then be wrong in the one direction that
    # matters -- skipping the gate on a desktop somebody may be watching.
    minted_here = False
    # A BARE ARRIVAL FROM A BROWSER THAT HAS A LIVE DESKTOP IS SHOWN ITS
    # DESKTOPS, not handed the newest one. Opening the address again is how
    # people ask for a SECOND desktop -- two novice walks, independently, did
    # exactly that -- and resuming answered a question they had not asked, on
    # a card whose only button took the desktop back from the other tab. The
    # owner's rule for a returning browser is the same: one that owns sessions
    # gets the session manager. The liveness walk below is unchanged, so dead
    # records are still dropped and a browser whose desktops are ALL gone still
    # gets a new one; only where a live one sends the visitor changes.
    #
    # ANY QUERY KEEPS THE RESUME. ?gate= chooses the arm for the test rigs,
    # and a query is never what a person types; the directory is for the bare
    # address. Asserted by test_the_bare_address_shows_your_desktops.
    to_directory = False
    if owned and arm in ("takeover", "off"):
        # Resume the most recent session this identity owns -- IF IT IS STILL
        # THERE. Not a slot lookup: the sid is what is resumed, so a reaped
        # session is absent here rather than resolving to whoever now holds its
        # slot. But the table alone cannot tell a live session from a reaped
        # one, which is how the front door came to hand a visitor back the same
        # dead address it had just told them to come here to escape.
        #
        # Walked from the most recent backwards, because an identity may own
        # several and the newest one being gone says nothing about the others.
        for candidate in reversed(owned):
            rec = own.lookup(candidate)
            if rec is None:
                continue
            why = session_replaced(rec, rec["instance"])
            if why is None:
                sid = candidate
                to_directory = not query
                log_arrival("sent to the directory" if to_directory
                            else "resumed a session", identity,
                            rec["instance"], sid,
                            "arm %s, %d owned" % (arm, len(owned)))
                break
            # DROPPED HERE, and this is forget()'s first real call site. It has
            # existed since the table did, with exactly one caller inside a
            # start-up assertion -- so nothing in a running router ever removed
            # an entry, and a slot the sweep had freed stayed "in use" until the
            # process died.
            own.forget(candidate)
            # A mint that never became a desktop still has its reservation on
            # disk. Dropping the record without it would hold the slot for the
            # rest of the grace window for no reason.
            release_slot(rec["instance"])
            log_arrival("dropped a dead session", identity, rec["instance"],
                        candidate, why)
            # The same reclaim as the gate's, and for the same reason: a
            # visitor who comes back to the FRONT DOOR rather than to their
            # session address reaches this path instead, and the slot they left
            # behind is in exactly the same state either way.
            reclaim_slot(own, candidate, rec, why)
    if sid is None:
        # MINTING IS RIGHT HERE AND ONLY HERE. This is the front door: the
        # visitor has asked for a desktop, so starting one is the thing they
        # came for. The gate belongs on /s/<sid>/, where an unresolvable address
        # is a QUESTION rather than an instruction -- a browser restoring twenty
        # tabs presents twenty dead addresses and must not be handed twenty
        # desktops.
        #
        # AND ONLY FOR A PAGE. A browser that says what it is fetching and says
        # it is not a document -- an <img>, an <iframe>, a fetch() -- is a page
        # somewhere spending this browser on a slot, and minting is a damage.
        # A link to the front door is still a document, so it still works; a
        # client that sends no Sec-Fetch-Dest (curl, the rigs, an old browser)
        # is judged as before. No cookie on this answer: a stranger's <img>
        # must not hand a browser an identity either.
        if dest is not None and dest.lower() != b"document":
            respond(wf, 403, page(
                "Not a page",
                "Open this address in a tab to get a desktop."))
            return
        instance, sid = let_slot(own, identity)
        if instance is None:
            # Logged BEFORE the response, and with the cookie still attached:
            # refusing a visitor is not a reason to let their identity lapse --
            # doing that is how a full pool turns into a person locked out of
            # the desktop they already had.
            log_refusal("no free slot")
            respond(wf, 503, page(
                "Every desktop is in use",
                "This machine has no free slot right now. Close a tab you are "
                "finished with, or try again shortly."), extra)
            return
        # AFTER the mint and before the redirect, so the line exists even if the
        # visitor never comes back for it. A record written only once a request
        # reached the session would miss exactly the mint that went nowhere,
        # which is the one that quietly consumed a slot.
        log_arrival("minted a session", identity, instance, sid,
                    "arm %s, %d slot(s) now let" % (arm,
                                                    len(own.instances_in_use())))
        minted_here = True

    if to_directory:
        # Nothing is resumed and nothing is marked: the directory is a GET that
        # never mints. Its rows' Resume is a POST (console(), "resume"), so the
        # only way from here to a desktop without its card is a press.
        extra.append(("Location", "/sessions/"))
        respond(wf, 302, b"", extra)
        return

    location = "/s/%s/" % sid
    if query:
        location += "?" + query.decode("latin-1")
    extra.append(("Location", location))
    # ONLY WHERE THIS REQUEST MINTED. A RESUMED session (an arrival carrying a
    # query) -- which may well have a viewer on it -- meets the card.
    if minted_here:
        extra.append(asked_marker_header(sid))
    respond(wf, 302, b"", extra)


# --------------------------------------------------------------------------
# The rescue console
# --------------------------------------------------------------------------
#
# WHY THIS EXISTS. The owner, describing what the product is for when a machine
# goes wrong: *"it would be helpful if we still had enough resources to allow a
# user to open a new tab to the door, find their misbehaving session, and kill
# it from the door."* Measured on this tree before any of it was written: NO
# VISITOR-FACING CONTROL ENDS A SESSION. hdw4s-gate-index says so in as many
# words and deliberately does not tell anybody to close their desktop, because
# anything documented must be possible to do. The door he was describing did
# not exist.
#
# THE RULING THIS IS BUILT AROUND, and it separates two things that had been
# fused: *"never block the door. but potentially block new session creation."*
# Reaching the door, seeing your sessions and ending one must work when the box
# is unwell -- that is the rescue path, and the person who most needs it is the
# person who already has a desktop, because theirs may be the one misbehaving.
# Minting a NEW desktop is the expensive act we are permitted to decline.
#
# SCOPE IS ENFORCED HERE, NOT BY WHAT THE PAGE RENDERS. The list is built from
# own.owned_by(identity) and from nothing else -- it cannot enumerate the pool,
# so there is no version of this page that shows a stranger's desktop by
# accident. The end action re-checks ownership against the record on the way in
# rather than trusting the sid it was handed. A session list is the obvious way
# to reopen the cross-occupant reach that the commit this branch stands on
# closed, and "the page does not render it" is not a boundary.
#
# ENDING IS A POST. A GET that destroys a desktop is one browser prefetch, one
# link preview or one crawler away from doing it unasked, and the visitor would
# have no idea what happened.

TEARDOWN_DIR = os.environ.get("HDW4S_TEARDOWN_DIR", "/run/hdw4s-teardown")


def console_target(path):
    """(what, sid) for a console request, or (None, None).

    Parsed here rather than in parse_target() because parse_target answers a
    different question -- "is this a session address" -- and every caller of it
    treats a None sid as "this is an arrival". Adding a second meaning to that
    return value is how a path that must never mint comes to mint.
    """
    if path in (b"/sessions", b"/sessions/"):
        return "list", None
    parts = path.split(b"/")
    # /sessions/<sid>/discard  ->  ['', 'sessions', '<sid>', 'discard']
    #
    # DISCARD is the word, and it is not a synonym chosen here. It comes from
    # the session directory mock this page is a refinement of, where it is one
    # word, used nowhere else in the product, at the opposite end of the row
    # from the thing you click. "End" and "Close" were both in use elsewhere
    # for softer things; a destructive verb that is also an ordinary one is how
    # a reflex trained somewhere else lands on the irreversible half.
    if len(parts) == 4 and parts[1] == b"sessions" and parts[2] and parts[3] == b"discard":
        return "discard", parts[2].decode("ascii", "replace")
    # /sessions/new -- ASK FOR ANOTHER ONE.
    #
    # It is claimed HERE, or a press of New desktop is a 404. (Before only the
    # front door reached arrival(), an unclaimed path WAS an arrival, and a GET
    # of this address handed the visitor a desktop nobody had pressed for.)
    #
    # NEW, not "create" or "mint", because it is the word a person would type
    # and it is not a verb: a verb in a URL reads as something the address
    # itself does, and this address does nothing until a POST arrives.
    if path in (b"/sessions/new", b"/sessions/new/"):
        return "create", None
    # /sessions/<sid>/resume -- GO BACK TO ONE OF MINE, AND MEAN IT.
    #
    # A separate address from /s/<sid>/ for the same reason create is separate
    # from the front door: that address is what a reload, a restored tab and a
    # bookmark present, so a page served there cannot tell a press from any of
    # them and has to ask. This one is only ever reached by pressing Resume,
    # because only a POST here does anything (console()).
    if len(parts) == 4 and parts[1] == b"sessions" and parts[2] and parts[3] == b"resume":
        return "resume", parts[2].decode("ascii", "replace")
    return None, None


# Where a session's own cgroup lives. Derived from the instance name because
# that is what systemd derives it from; a constant here would be a wrong answer
# waiting for a second slot layout to exist.
SESSION_CGROUP_ROOT = os.environ.get("HDW4S_SESSION_CGROUP_ROOT",
                                     "/sys/fs/cgroup/hdw4s.slice")


def slot_name(instance, root=None):
    """What this desktop calls ITSELF, read from the page it serves, or None.

    THE SAME OBJECT UNDER ONE NAME. The visible name is baked into the slot's
    gated index.html by hdw4s-webroot at provisioning time, and it is what the
    person sees on the card when they open the desktop. Reading it back is how
    the directory and the desktop cannot disagree -- any other source here would
    be a second copy of a rule that lives somewhere else, and the failure mode
    is not a crash, it is two numbers for one desktop on the screen where
    somebody decides which one to destroy.

    Cheap enough for a page that must work on a sick machine: one bounded read
    of a file the kernel has in cache, and every failure answers None.
    """
    base = WEBROOT_DIR if root is None else root
    try:
        with open(os.path.join(base, instance, "index.html"), "r",
                  encoding="utf-8", errors="replace") as f:
            head = f.read(200000)
    except OSError:
        return None
    m = re.search(r"<h1>([^<]{1,60})</h1>", head)
    if m is None:
        return None
    # RETURNED AS THE PAGE HOLDS IT, still HTML-escaped, and it is written into
    # this page without a second pass. hdw4s-gate-index escaped it once for
    # exactly this purpose, so escaping again would show a person "1 &amp;
    # Desktop" and unescaping would undo the one thing protecting a name an
    # administrator chose. One escape, at the point it was applied.
    return m.group(1).strip() or None


def slot_memory_kb(instance, root=None):
    """What this slot's session is ALREADY charged, in kB, or None.

    Read from the cgroup the product itself puts the session in, not from a sum
    over ps: a process sum needs a rule for whose process is whose and gets it
    wrong for anything shared. None is "no reading", and every caller here
    treats it as "we cannot say" rather than as zero -- which is the same rule
    this page follows everywhere else, because a page that admits what it
    cannot know beats one that mislabels a person's own desktop back to them.
    """
    base = SESSION_CGROUP_ROOT if root is None else root
    path = os.path.join(base, "hdw4s-%s.slice" % instance, "memory.current")
    try:
        with open(path, "r") as f:
            return int(f.read().strip()) // 1024
    except (OSError, ValueError):
        return None


def slot_pids(instance, root=None):
    """How many processes this slot's session is running, or None."""
    base = SESSION_CGROUP_ROOT if root is None else root
    path = os.path.join(base, "hdw4s-%s.slice" % instance, "pids.current")
    try:
        with open(path, "r") as f:
            return int(f.read().strip())
    except (OSError, ValueError):
        return None


# NOTE: teardown_requested() and request_teardown() used to be defined a SECOND
# time here, identically, three hundred lines below the copies beside
# reclaim_slot(). Python kept the later pair and the earlier one was dead, so an
# edit to the documented copy would have changed nothing -- the shape this
# project calls a stale citation, except that here both copies were live-looking.
# Removed rather than kept in step: two copies of a rule are two rules the
# moment one is edited.


def describe_session(rec, sid, now=None):
    """One row's worth of what this router can HONESTLY say about a session.

    WHAT IS DELIBERATELY NOT HERE: any column that says idle, active, in use or
    unused. 2026-09-25, measured on the only real visitor's session anybody has
    observed on this product: its desktop ran for TWENTY-FOUR MINUTES with
    nothing connected to it, between being started and its owner's browser first
    reaching the picture -- while being the freshest session on the box. Both
    cheap readings of "in use" score that as idle. A page that confidently
    mislabels a person's own desktop back to them is worse than one that admits
    what it cannot know, and this page is shown to somebody who is already
    having a bad time.

    WHAT IS HERE INSTEAD, AND WHY IT IS THE RIGHT COLUMN FOR HIS VERB. He said
    FIND the misbehaving session, and he described what makes it findable:
    *"a program that surprisingly uses way more memory than the user expected...
    and when that happens, it's not just by a little but by a lot."* Memory is
    therefore not a diagnostic dressed up for a visitor -- it is the actual
    subject, it is readable from the cgroup the product itself puts the session
    in, and "by a lot" is a comparison a person makes at a glance between two
    rows without being taught anything. Crude, stated, and no heuristic.
    """
    now = time.time() if now is None else now
    inst = rec["instance"]
    kb = slot_memory_kb(inst)
    # WHEN IT GOES BY ITSELF, read PER SLOT and never pinned. The mock calls
    # this the promise that abandonment needs no cleanup, made before the fact
    # rather than after it -- and it is the only claim on this page about the
    # future, so it has to be this machine's answer rather than the shipped
    # default. The windows genuinely differ between slots on a box under
    # experiment, and a page quoting one number for the pool would be telling
    # some visitors something untrue about their own desktop.
    window = dict(idle_windows()).get(inst)
    return {
        "sid": sid,
        "instance": inst,
        "name": slot_name(inst),
        "age": max(0.0, now - rec.get("minted", now)),
        "memory_mb": None if kb is None else kb // 1024,
        "pids": slot_pids(inst),
        "started": bool(rec.get("live")) or slot_occupied(inst),
        # ASKED OF OUR OWN RECORD FIRST, because the FILE is not the state.
        # hdw4s-teardown removes the request before it does any work -- it must,
        # or the path unit refires forever -- so a column that only read the
        # directory was false for all but the first few milliseconds of a
        # teardown, and a visitor who had just pressed Discard was shown a row
        # claiming nothing was happening. The marker the teardown itself keeps
        # for the duration is the second source; either one means discarding.
        "discarding": bool(rec.get("ended")) or teardown_requested(inst),
        "idle_window": window,
    }


def create_form(disabled=False):
    """THE ONE PRESSABLE OBJECT, and it is a FORM rather than a link.

    THE RULING THIS EXISTS FOR, 2026-09-25: *"instead of just offering me to
    take back the session, this should also be the place where i can create a
    brand new one."* Before this, a visitor who already had a desktop had no
    way to ask for a second: the front door resumed the one they had, which was
    the arrival rule working correctly and was also the thing that blocked him
    from exercising most of the product. (The bare front door now shows such a
    browser this directory; see arrival().)

    IT IS NOT A CONTRADICTION OF THE ARRIVAL RULE and must not be read as a
    softening of it. "Minting is a damage" is about minting WITHOUT BEING
    ASKED -- a restored tab costing a visitor a desktop and the pool a slot.
    A button somebody presses is active intent, which is the distinction the
    gate exists to draw in the first place. The two rules meet in the METHOD,
    which is why this is a form and not an <a href>: a link is fetched by
    prefetchers, link previews, crawlers, pinned tabs and session restore, and
    every one of those would be a mint nobody asked for. Asserted in
    test_asking_for_a_second_desktop_takes_a_GESTURE, which was watched minting
    on a GET before this address was claimed.

    The mock's rule, kept in its strong form: this is the only FILLED object
    on the page. The rows' Resume is outlined and their Discard is small and
    bordered, so both read as pressable -- a Resume drawn as a default blue
    link read as broken to a visitor -- while the habitual click still lands
    here, on the one act that cannot cost anybody anything.
    """
    if disabled:
        # Rendered as PLAIN TEXT rather than a disabled control. A disabled
        # button invites the reflex and then swallows it, and a person on an
        # unwell machine reads that as the page being broken. Saying the
        # machine has no room is a fact about the machine; a greyed-out button
        # is a fact about the page.
        return ("<p class=\"note create\">"
                "There is no room for another desktop right now.</p>")
    return ("<form class=\"create\" method=\"post\" action=\"/sessions/new\">"
            "<button class=\"btn primary\" type=\"submit\">New desktop</button>"
            "<span class=\"note\">"
            "A clean desktop. Nothing from any of the others.</span>"
            "</form>")


def create_refused_page(rows, pool):
    """A NO, ON THE SURFACE THE PERSON PRESSED, with their own desktops kept.

    TWO HALVES OF ONE PAGE, and that is the reason this is not a separate
    screen: the place a visitor asks for another desktop is the place the
    answer has to appear, and this surface is also the rescue console. A
    refusal rendered anywhere else is a dead end, and the one action that would
    make the refusal stop being true -- ending a desktop they are finished
    with -- is on this page and nowhere else. So the list stays.

    ITS AUDIENCE IS THE ADMINISTRATOR, WITH THE VISITOR AS MESSENGER. It names
    what ran out and how much of it there was, because that is what saves an
    operator a tracing session when somebody forwards them this screen. It
    names no unit, no path, no process and no address: a stranger is reading
    it. And it does not suggest the reader did anything wrong or can fix the
    machine -- the only thing offered is authority over their own desktops,
    which they already had.

    WHAT IT DELIBERATELY DOES NOT SAY: which of these desktops is idle, or
    which one to end. Every signal that would answer that was falsified on
    2026-09-25 -- a probe that could not observe a connection at all, a census
    that read the freshest session on the box as idle, and an emptiness check
    that authorised destroying a visitor's desktops. A page that admits what it
    cannot know beats one that confidently mislabels a person's own desktop
    back to them.
    """
    note = ("This machine has no room for another desktop. All %d of its "
            "desktop slots are in use." % pool) if pool else \
           ("This machine has no room for another desktop, and could not "
            "read how many slots it has.")
    body = "<p>%s</p>" % note
    if rows:
        body += ("<p>Nothing you have has changed. These are still yours, and "
                 "discarding one you are finished with frees a slot.</p>")
        body += rows_html(rows)
    body += create_form(disabled=True)
    body += ("<p class=\"note\" style=\"margin-top:1.5rem\">If this keeps "
             "happening, tell whoever runs this machine: its pool of "
             "ephemeral desktops is full, and the refusal is recorded in its "
             "log with the time and the size of the pool.</p>")
    return card("No desktop could be started", body, names_script())


def console_page(rows, note=None):
    """The visitor's own desktops. A REFINEMENT of the session-directory mock.

    WHAT IS TAKEN FROM THE MOCK AND WHY, because these are decisions somebody
    already made carefully and re-deriving them would have lost the reasons:

      * ROWS, NOT CARDS, inside the one card every page of ours sits on. "One
        FILLED object on this page" is the mechanism for leading the habitual
        click; Resume is outlined and Discard is small, so neither competes
        with the thing a person pressing by habit should land on.
      * EVERY ROW CARRIES WHEN IT DISAPPEARS. That line is the promise that
        abandonment needs no cleanup, made before the fact rather than after it.
      * DISCARD SITS IN THE OPPOSITE CORNER OF THE ROW from Resume, on the
        line that says how the desktop ends by itself, and it asks first (the
        ellipsis on its label is the platform's sign for that). Its confirmation's prominent button is KEEP IT, and
        deliberately not the accent colour, so the reflex trained by the big
        button lands on the safe half.

    WHERE CREATE WILL GO, and it is left as a place rather than built: ruled
    2026-09-25, this surface is the product's control surface rather than a
    doorway -- see what you have, resume one, discard one, and ask for another.
    Create is not in this round. The layout puts it after the list, on its own,
    because that is also where a REFUSAL has to render when the machine cannot
    make one: the deferred question "what does the create button do when there
    is nothing to create" and the refusal page being designed elsewhere are the
    same page for the same reason.

    IT MUST RENDER ON AN UNWELL MACHINE, so it is static HTML with no font, no
    image and no request after the first: a rescue that needs anything to load
    is not a rescue. The numbers are three small reads of files the kernel
    keeps in memory. ITS ONE SCRIPT IS INLINE AND OPTIONAL: names_script()
    replaces each row's plain "Desktop" with the name this browser keeps for
    it. The names live in the browser because the owner ruled they should
    (per-browser ids, 2026-09-27), so the server has nothing to render them
    from; with scripts off or storage blocked every row says "Desktop" and
    the page still does its whole job.

    WHAT IS DELIBERATELY NOT TAKEN FROM THE MOCK: its "Resume" versus "Move
    here" distinction, which turns on whether you are connected somewhere else.
    That is a true and valuable difference and this page cannot tell it today.
    Every signal we have for "connected" has been falsified twice over in one
    day -- once by a tool that could not observe a connection at all, and once
    by a real visitor's session reading as having nobody on it for its first
    twenty-four minutes. Offering "Move here" on a reading that wrong would say
    out loud what it costs and then be wrong about whether it costs anything.
    One verb until the signal is real.
    """
    if not rows:
        body = ("<p>You have no desktops on this machine right now.</p>"
                + create_form())
    else:
        # SAYS WHAT THE SCOPE IS TIED TO. "These are yours. Nobody else can
        # see them." left a visitor asking: mine by what? The answer is the
        # identity model -- a cookie in this browser -- so the line names the
        # browser, which is also what explains the list being empty elsewhere.
        body = ("<p>Started from this browser. Only this browser can see "
                "them.</p>")
        body += rows_html(rows)
        body += create_form()
        if any(r["memory_mb"] is not None for r in rows) and len(rows) > 1:
            body += ("<p class=\"note\">If one of these is using far "
                     "more memory than the others, that is the one "
                     "misbehaving.</p>")
    if note:
        body = "<p><b>%s</b></p>" % note + body
    return card("Your desktops", body, names_script())


def describe_span(seconds):
    """A length of time in words, for a person.

    NOT describe_age(), and the near-miss is the point: that one renders
    "30d00h" and "0m", which is an operator's format in an operator's log. This
    page is read by somebody whose machine is misbehaving, so it says "30 days"
    and "less than a minute". The two were briefly one function -- the second
    definition silently replaced the first, every number on this page came out
    in the log's format, and a test caught it only because it asserted on the
    WORDS a visitor sees rather than on the value behind them.

    Coarse on purpose: nobody rescuing a machine needs seconds.
    """
    if seconds is None:
        return "an unknown time"
    seconds = int(seconds)
    if seconds < 90:
        return "less than a minute"
    if seconds < 5400:
        return "%d minutes" % (seconds // 60)
    if seconds < 172800:
        return "%d hours" % (seconds // 3600)
    return "%d days" % (seconds // 86400)


def row_html(r):
    """One row: the desktop's name as its heading, Resume beside it, and the
    two ways it ends -- Discard, or by itself -- on one line underneath.

    RESUME IS A BUTTON AND DISCARD IS IN THE OTHER CORNER, and both are
    structure rather than wording. A visitor read the old Resume, a default
    blue link, as broken; and the old Discard, grey text on Resume's own line,
    as one careless click from losing a desktop. So Resume is an outlined
    button on the name's line, and Discard is a small bordered button at the
    start of the line below, beside the sentence saying the desktop also ends
    by itself -- the two endings read as one decision, away from the press
    that continues. Discard is a GET of the confirmation page.

    RESUME IS A POST, since 2026-09-27, to /sessions/<sid>/resume. It was a
    link to /s/<sid>/, which is what a reload or a restored tab presents, so
    the desktop's page could not tell the press from them and showed the
    Connect card after it: the owner renamed a desktop, pressed Resume, and
    "had to click connect on another card". The POST is answered with the
    one-shot marker (console(), "resume"), so the press lands on the desktop.

    THE ROW NAMES ITS DESKTOP, and it did not until a visitor could have two.
    With one row there was nothing to tell apart and "Resume" was enough; the
    first photograph of two rows, taken the day create landed, showed two rows
    reading identically apart from seven megabytes. A person cannot choose
    between those, and choosing is now the whole point of the page.

    THE NAME IS READ FROM THE DESKTOP'S OWN PAGE, not computed here, and that is
    the part worth defending. The obvious version derives a number from the
    instance name -- ephemeral1 is "desktop 1" -- and it is WRONG: the slots are
    named from zero and the card the session puts on itself is written
    "$(( i + 1 )) - Desktop", so the row would have called ephemeral1 "1" while
    the desktop it opens says "2". Two numbers for one thing, disagreeing, on
    the screen where somebody chooses which desktop to end. Computing i+1 here
    instead would agree today and would be a second copy of a rule that lives in
    hdw4s-ephemeral-slots, kept in step by nobody.

    So it is read from the page the slot actually serves. Absent or unreadable
    answers None and the row is headed with the bare word, because a name is
    a convenience and this page has to render on a machine that is unwell.

    AND FOR A POOL SLOT THAT PAGE NOW SAYS ONLY "Desktop". The slot number was
    the name until 2026-09-27, and a slot is reused, so a visitor was handed
    "19" again after being told everything in 19 was gone. What tells a
    visitor's rows apart is the per-browser name that names_script() fills in
    from data-hdw4s-sid (hdw4s-names.js); this text is what shows without it.
    """
    facts = []
    facts.append("started %s ago" % describe_span(r["age"]))
    if r["memory_mb"] is not None:
        facts.append("using %d MB" % r["memory_mb"])
    if r["pids"] is not None:
        facts.append("%d processes" % r["pids"])
    if not r["started"]:
        facts.append("still starting")
    if r["discarding"]:
        ends = "<span>discarding</span>"
    else:
        ends = ("<a href=\"/sessions/%s/discard\" class=\"btn small\">"
                "Discard&hellip;</a>" % r["sid"])
        if r["idle_window"] is not None:
            ends += ("<span>or it ends by itself after %s with nobody "
                     "connected.</span>" % describe_span(r["idle_window"]))
    return ("<div class=\"row\"><div class=\"top\"><div>"
            "<div class=\"name\" data-hdw4s-sid=\"%s\">%s</div>"
            "<div class=\"facts\">%s</div></div>"
            "<form method=\"post\" action=\"/sessions/%s/resume\">"
            "<button class=\"btn secondary\">Resume</button></form></div>"
            "<div class=\"ends\">%s</div></div>"
            % (r["sid"], r["name"] or "Desktop", ", ".join(facts), r["sid"],
               ends))


def rows_html(rows):
    return "<div class=\"rows\">%s</div>" % "".join(row_html(r) for r in rows)


def discard_confirmation_page(r):
    """ASK FIRST, and put the reflex on the safe half.

    The confirmation IS the information: it names what dies. The prominent
    button is "Keep it" and it is not the accent colour, because the reflex a
    person arrives with was trained by the big button on the page before.

    WHAT IS MISSING AND IS NOT AN OVERSIGHT: the mock also has a ten-second
    UNDO after the act, on the grounds that a confirmation is the first thing
    habit learns to defeat. It is not here, and the reason is that it cannot be
    a page trick. The request this page produces is a file the router writes and
    a privileged unit acts on the moment it appears, so an undo has to be
    cancellable on the FAR side of that line -- which means either holding the
    write for ten seconds in a router that may die, or a two-file protocol where
    the privileged half honours a stamp and re-checks before acting. The second
    is right and is a small piece of work; it is named here rather than
    half-built, because a "Undo" that sometimes silently does nothing is worse
    than no undo at all.
    """
    return card(
        "Discard this desktop?",
        "<p>It has been running for %s and is using %s. Everything in it goes: "
        "anything open, anything downloaded, and anything you are signed in to."
        "</p><p><b style=\"color:#eee\">This cannot be undone.</b></p>"
        "<div class=\"actions\">"
        "<a href=\"/sessions/\" class=\"btn secondary\">Keep it</a>"
        "<form method=\"post\" action=\"/sessions/%s/discard\">"
        "<button class=\"btn small\" type=\"submit\">Discard</button></form>"
        "</div>"
        % (describe_span(r["age"]),
           "an unknown amount of memory" if r["memory_mb"] is None
           else "%d MB of memory" % r["memory_mb"],
           r["sid"]))



def ended_page(rows, gone):
    """The page a tab gets once its desktop has ended: the directory, headed
    with the one fact the visitor came for.

    IT IS THE SESSION MANAGER, NOT A ONE-BUTTON CARD, because what a person
    needs next depends on what else they have, and one button in front of
    everybody was a guess. Someone with another desktop still running needs
    that one -- a visitor who logged out of one of two said they would simply
    close this tab -- and for them the list is the next thing; someone with
    nothing left needs New desktop. Both are here, and the ended desktop is
    not listed: its record was forgotten on the way in.

    "EVERYTHING THAT WAS IN IT IS GONE" ONLY WHEN GONE, which is when this
    router saw the desktop stop (session_replaced() gave a reason). An
    ephemeral desktop's home and /tmp live and die with its unit, so there it
    is simply true, and it is the reassurance the visitor was looking for. When
    the address is merely UNKNOWN to this router, the desktop may still be
    running -- a router whose table could not be read knows none of the
    lettings it made -- so that branch says only that the tab's desktop is no longer running here.

    THE ONE FILLED BUTTON IS THE DIRECTORY'S OWN CREATE, POST /sessions/new,
    and never a link to the front door. It was once a link to "/", which
    resumed the newest desktop this browser owns: with a second desktop open in
    another tab, "Start a new desktop" took that one over. A POST also keeps a
    prefetch, a reload or a restored tab from pressing it. Asserted by
    test_the_ended_pages_button_starts_a_NEW_desktop and, for the rows, by
    test_the_ended_page_lists_what_is_still_running.
    """
    if gone:
        body = "<p>Everything that was in it is gone.</p>"
    else:
        body = "<p>The desktop this tab was showing is no longer running.</p>"
    # A row that is being discarded is not "still running", and saying so on
    # the page about a desktop that ended would be the one false line on it.
    running = [r for r in rows if not r["discarding"]]
    if running:
        body += "<h2>Still running in this browser</h2>" + rows_html(running)
    body += create_form()
    return card("This desktop has ended", body, names_script())


def owned_rows(own, identity):
    """The rows of IDENTITY's own desktops, for the directory and for the
    ended page. Built from own.owned_by(identity) and nothing else, which is
    the directory's whole scope rule: there is no version of this that
    lists a stranger's desktop."""
    out = []
    now = time.time()
    for s in own.owned_by(identity):
        rec = own.lookup(s)
        if rec is None:
            continue
        # A DISCARD THAT IS OVER IS NOT A DESKTOP THE VISITOR HAS. The
        # record survives -- end_session() explains why, and the
        # resurrection guard depends on it -- but it stops being listed once
        # the teardown has had its whole window. Without this the row sat
        # there saying "discarding" indefinitely, because the record is
        # dropped only by a request that PRESENTS that session id, and a
        # visitor who discards from this page has no tab left to present it.
        #
        # BOUNDED IN TIME rather than by asking whether a teardown is
        # running. Reading the marker alone was the obvious repair and is
        # wrong: the request file is removed before the work starts, so the
        # row would blink out and back at the moment the person is watching
        # it -- which is the very flicker describe_session() was written to
        # stop. Same bound as the marker, for one reason rather than two.
        if rec.get("ended"):
            ended_at = rec.get("ended_at")
            if ended_at is None or (now - ended_at) > TEARDOWN_MARKER_MAX:
                continue
        out.append(describe_session(rec, s))
    return out


def console(own, wf, identity, new_identity, what, sid, method):
    """Serve the directory. Mints on a POST to one address, and NOWHERE ELSE.

    THE DOCSTRING THIS REPLACES SAID "NEVER MINTS", and it was true when it was
    written. It stopped being true on 2026-09-25, when the owner ruled that
    this surface is also where a person asks for another desktop. Left as it
    was it would have been a comment citing a shape that is gone -- the class
    of defect that passes every test, because what it describes is simply not
    there to contradict it.

    What the rule became, rather than what it was: NOTHING THIS SURFACE SERVES
    ON A GET MAY START A DESKTOP. That keeps the property the original was
    protecting -- somebody reaches this page when the machine is already in
    trouble, and the front door one path away mints on sight -- while allowing
    the one act the owner asked for. The method is the whole boundary, and it
    is asserted rather than described: test_asking_for_a_second_desktop_takes_a_GESTURE.
    """
    extra = refresh_headers(own, identity, new_identity)

    def rows():
        return owned_rows(own, identity)

    if what == "create":
        if method != b"POST":
            # A GET ASKS, and here asking is simply the directory again: the
            # button is on it. Rendering the list rather than a 405 means a
            # bookmarked or shared /sessions/new is a screen somebody can use
            # instead of an error -- and it is still not a mint, which is the
            # property that matters and the one the test watches.
            respond(wf, 200, console_page(rows()), extra)
            return

        instance, new_sid = let_slot(own, identity)
        if instance is None:
            # THE REFUSAL RENDERS WHERE CREATE LIVES. Logged first and with the
            # cookie still attached, for the same reason the front door's
            # refusal is: refusing somebody a NEW desktop is not a reason to
            # let their identity lapse, and doing that would lock them out of
            # the ones they already have -- on the very page whose job is to
            # let them end one.
            log_refusal("no free slot for a requested new session")
            respond(wf, 503, create_refused_page(rows(), len(ephemeral_slots())),
                    extra)
            return

        # THE SECOND MINTING SITE, and it is deliberate rather than a leak of
        # the one in arrival(). They are not the same event: arrival() mints
        # for somebody who has nothing, on a GET, because asking for the front
        # door IS asking for a desktop. This mints for somebody who already has
        # one and pressed a button saying so. Keeping them apart is what lets
        # the arrival rule stay exactly as it was -- nothing about a returning
        # tab, a stale id or a restored window reaches this line, because
        # nothing but a POST does.
        #
        # THE LETTING IS arrival()'S, the same call: one lock across the pick
        # and the record, and the reservation on disk before the redirect.
        log_arrival("minted a session on request", identity, instance, new_sid,
                    "asked for from the directory, %d slot(s) now let"
                    % len(own.instances_in_use()))
        # 303 rather than 302, for the reason the discard uses one: the browser
        # must not repeat the POST if the person reloads where they land, and
        # repeating THIS one costs a slot.
        respond(wf, 303, b"",
                [("Location", "/s/%s/" % new_sid),
                 asked_marker_header(new_sid)] + extra)
        return

    if what == "resume":
        rec = own.lookup(sid)
        if rec is None or rec["identity"] != identity:
            # REFUSED EXACTLY AS A DISCARD IS, and for the same reasons: one
            # answer for "no such session" and "not yours", on the GET as well
            # as the POST. What this refusal protects is sharper than the
            # discard's: a resume that let a stranger through would hand them
            # the marker below, which connects without asking -- on top of
            # whoever is watching.
            log("refused a resume of %s: it is not this visitor's session"
                % sid)
            respond(wf, 403, page(
                "Not your desktop",
                "This address belongs to a different browser."), extra)
            return
        if method != b"POST":
            # A GET IS NOT A PRESS. A prefetch, a restored tab or a pasted
            # link reaches this address too, and a marker handed to any of them
            # is a silent connect nobody chose. The directory is what a GET
            # gets, as it is for /sessions/new: its Resume is on it.
            respond(wf, 200, console_page(rows()), extra)
            return
        # NOTHING IS MINTED AND NOTHING IS RESERVED: the desktop is the one the
        # table already holds for this browser. A desktop that has since ended
        # is sent to its address unmarked, where the ended page explains; the
        # marker could not act there anyway, and not writing it keeps "marked"
        # meaning "live, and asked for".
        #
        # 303 for the reason create uses one, and the marker is a cookie, not a
        # query string, for the reason given at FRESH_COOKIE: a URL goes
        # into history, and a reload, a back button or a restored tab carrying
        # it would connect without asking. The page consumes the marker on
        # first read, and it expires on its own.
        out = [("Location", "/s/%s/" % sid)]
        if not rec.get("ended"):
            out.append(asked_marker_header(sid))
            log("resumed a session on request: slot %s, session %s"
                % (rec["instance"], sid))
        respond(wf, 303, b"", out + extra)
        return

    if what == "discard":
        rec = own.lookup(sid)
        if rec is None or rec["identity"] != identity:
            # THE INVARIANT, REFUSING, AND IT IS CHECKED HERE RATHER THAN BY THE
            # PAGE. The same answer for "no such session" and "not yours", on
            # purpose: distinguishing them tells a stranger which sids exist.
            # Checked on the GET as well as the POST, so the confirmation page
            # cannot be used to find out whether a session is real either.
            log("refused a discard of %s: it is not this visitor's session"
                % sid)
            respond(wf, 403, page(
                "Not your desktop",
                "This address belongs to a different browser."), extra)
            return

        if method != b"POST":
            # A GET ASKS; only a POST acts. One browser prefetch, link preview
            # or crawler is otherwise enough to destroy somebody's desktop
            # without them asking, and they would have no idea what happened.
            respond(wf, 200, discard_confirmation_page(
                describe_session(rec, sid)), extra)
            return

        why = request_teardown(rec["instance"])
        if why is not None:
            log("could not record a discard of %s: %s" % (rec["instance"], why))
            respond(wf, 503, page(
                "This machine could not take that request",
                "Nothing has been discarded. Try again, and tell whoever runs "
                "this machine if it keeps happening."), extra)
            return
        # BEFORE THE RESPONSE, AND THE ORDER IS THE WHOLE REPAIR. The 303 below
        # is what sends this browser somewhere else, and its OTHER tab on the
        # discarded desktop retries on its own clock -- so from the moment that
        # response leaves, a request for this letting may arrive at any time. If
        # it arrives before this line has run it is proxied into a slot that is
        # still dying -- which under the relay's old BindsTo= started a fresh
        # desktop there for nobody, and now is refused by the relay.
        own.end_session(sid, "the desktop behind %s was discarded by the "
                             "visitor who held it" % rec["instance"])
        log("a visitor discarded their own session: slot %s, session %s"
            % (rec["instance"], sid))
        # 303, not 200: the browser must not repeat the POST if the person
        # reloads the page they land on.
        respond(wf, 303, b"", [("Location", "/sessions/")] + extra)
        return

    respond(wf, 200, console_page(rows()), extra)


def assert_console_shows_only_your_own(target=None):
    """Prove the console's scope comes from the OWNERSHIP TABLE, not the page.

    Runs at every start beside the others. What it catches is a path shape that
    LOOKS like a console address and is not, and a console address that stopped
    being recognised. Anything this parser does not claim is a 404 (only the
    front door itself reaches arrival()), so the second no longer mints -- but
    it would still turn every Discard and New desktop into a dead page.
    """
    target = console_target if target is None else target
    assert target(b"/sessions") == ("list", None), "the console list moved"
    assert target(b"/sessions/") == ("list", None), "the console list moved"
    assert target(b"/sessions/abc/discard") == ("discard", "abc"), \
        "the discard action moved"
    # AND THE CREATE ADDRESS, for a sharper version of the same reason: if this
    # one stops being claimed, the fall-through does not merely mint -- it
    # mints on a GET, which is the one thing the whole surface may not do.
    assert target(b"/sessions/new") == ("create", None), \
        "the create address moved"
    # AND RESUME, whose loss would turn every row's Resume into a 404 -- and
    # which must not swallow the session address a restored tab presents.
    assert target(b"/sessions/abc/resume") == ("resume", "abc"), \
        "the resume action moved"
    # Things that must NOT be read as the console, because each of them would
    # otherwise be routed somewhere that acts.
    for path in (b"/", b"/s/abc/", b"/sessions/abc", b"/sessions/abc/",
                 b"/sessions/abc/discard/more", b"/sessionsabc/discard",
                 b"/sessions//discard", b"/sessions/abc/resume/more",
                 b"/sessions//resume", b"/s/abc/resume"):
        what, _ = target(path)
        assert what not in ("discard", "resume"), \
            "%r was read as a %s action" % (path, what)
    # A SESSION WHOSE ID IS THE WORD "new" MUST NOT BE THE CREATE ADDRESS, and
    # it cannot be, because ids are 32 hex characters -- but the collision is
    # written down here rather than assumed, since the day somebody makes ids
    # human-readable this is where it bites.
    assert target(b"/sessions/new/discard") == ("discard", "new"), \
        "the create address swallowed a discard"


# --------------------------------------------------------------------------
# A press that came from another site
# --------------------------------------------------------------------------
#
# EVERY POST THE CONSOLE ACTS ON SPENDS OR ENDS SOMETHING: /sessions/new lets a
# slot, /sessions/<sid>/resume connects without the card, and
# /sessions/<sid>/discard ends a desktop. Each was checked only for the cookie,
# so what stood between a page elsewhere and those acts was the browser's
# SameSite=Lax -- which does not hold cookies back from a SAME-SITE sibling
# (another host under the same registrable domain), and which a cookieless
# request does not need at all, because serve() mints an identity for it.
#
# The rule is the browser's own account of where the request came from, and
# the refusal is deliberately narrow in what it will judge:
#
#   Sec-Fetch-Site present   the browser says who asked. Only "same-origin"
#                            acts; "same-site", "cross-site", "none" and any
#                            value we do not know are refused. Every browser
#                            this product is accepted on sends it.
#   only Origin present      a browser that predates Sec-Fetch-Site (Safari
#                            before 16.4, Firefox before 90) but names the
#                            page that asked. Acts when that page's HOST is
#                            this request's Host; "null" and a mismatch are
#                            refused. Hostnames only, not ports: the proxy
#                            line "hdw4s nginx" prints passes $host, which
#                            carries no port.
#   neither                  ACTS. What sends neither is a client acting for
#                            itself -- curl, a test rig, a script holding its
#                            own cookie -- and refusing it would protect
#                            nobody: it can equally GET the front door, which
#                            mints. The browsers that send neither on a form
#                            POST are older than any this product supports
#                            (Firefox before 70, from 2019, sent no Origin
#                            there); for them the only protection is
#                            SameSite, as before. Read from the browsers'
#                            published behaviour, not measured here.
#
# Refused with a 403 and NO cookie. The visitor's own identity does not lapse
# over one unrefreshed response, and a page elsewhere must not be able to make
# this router hand a brand-new browser an identity either.

def _host_of(authority):
    """The lower-cased host of HOST[:PORT] or [V6]:PORT, without the port."""
    a = authority.strip().lower()
    if a.startswith(b"["):
        return a.split(b"]", 1)[0] + b"]"
    return a.rsplit(b":", 1)[0] if a.count(b":") == 1 else a


def _loggable(value, limit=80):
    """A header value as a log can carry it: printable ASCII, bounded. It came
    from whoever sent the request, so it must not be able to write a line."""
    text = value.decode("latin-1")
    text = "".join(c if " " <= c <= "~" else "?" for c in text)
    return text if len(text) <= limit else text[:limit] + "..."


def cross_site_refusal(headers):
    """None when a POST to the console may act, else why not (for the log)."""
    site = header_value(headers, "Sec-Fetch-Site")
    if site is not None:
        if site.lower() == b"same-origin":
            return None
        return "Sec-Fetch-Site: %s" % _loggable(site, 32)
    origin = header_value(headers, "Origin")
    if origin is None:
        return None
    if origin.lower() == b"null":
        return "Origin: null, and no Sec-Fetch-Site"
    host = header_value(headers, "Host")
    scheme, sep, authority = origin.partition(b"://")
    if not sep or host is None or _host_of(authority) != _host_of(host):
        return "Origin: %s, Host: %s, and no Sec-Fetch-Site" % (
            _loggable(origin), "(none)" if host is None else _loggable(host))
    return None


def refuse_cross_site(wf, what, why, identity):
    """Answer a POST that another page made, and say so ONCE for the admin."""
    say_once(("cross-site", what, why.split(",")[0][:48]),
             "refused a %s POST that another page asked this browser to make "
             "(%s); visitor %s. Nothing was done. This is said once per kind "
             "of request. If it is logged for presses made on this machine's "
             "own pages and names an Origin, the reverse proxy is not passing "
             "the browser's Host (proxy_set_header Host $host, as \"hdw4s "
             "nginx\" prints it)." % (what, why, visitor_tag(identity)))
    respond(wf, 403, card(
        "That did not come from this page",
        "<p>Another page asked this browser to act on your desktops here, so "
        "nothing was done. If you meant to, do it from your desktops page."
        "</p><div class=\"actions\"><a class=\"btn secondary\" "
        "href=\"/sessions/\">Your desktops</a></div>"))


def assert_cross_site_posts_are_refused(judge=None):
    """Prove the judge refuses what another page can send, and permits ours.

    Runs at every start beside the others. Both directions, because a judge
    that refused everything would pass every refusal below and take New
    desktop, Resume and Discard away from everybody."""
    judge = cross_site_refusal if judge is None else judge
    h = lambda *lines: [l + b"\r\n" for l in (b"Host: pool.example",) + lines]
    for bad in (b"Sec-Fetch-Site: cross-site", b"Sec-Fetch-Site: same-site",
                b"Sec-Fetch-Site: none"):
        assert judge(h(bad)) is not None, "%r was let act" % bad
    assert judge(h(b"Sec-Fetch-Site: cross-site",
                   b"Origin: https://pool.example")) is not None, \
        "a matching Origin overruled the browser's Sec-Fetch-Site"
    for bad in (b"Origin: https://evil.example", b"Origin: null",
                b"Origin: https://pool.example.evil.example"):
        assert judge(h(bad)) is not None, "%r was let act" % bad
    assert judge(h(b"Sec-Fetch-Site: same-origin")) is None, \
        "a press on this machine's own page was refused"
    assert judge(h(b"Origin: https://pool.example:8443")) is None, \
        "an older browser's press on this machine's own page was refused"
    assert judge(h()) is None, \
        "a client that sends neither header was refused"


# --------------------------------------------------------------------------
# Proxying
# --------------------------------------------------------------------------

def buffered_now(f, sock):
    """What F has ALREADY read from SOCK and not yet handed out. Never waits.

    peek(0) on a buffered reader returns its buffer when there is one -- and
    when there is none, it READS, blocking until the peer sends. After a 101
    that is the wrong question: WebRTC signalling is a WebSocket on which the
    SERVER waits for the client's HELLO, so the peer sends nothing, the peek
    sat until the socket timeout, the handler died, and the browser's HELLO
    never reached the desktop -- which logged "Invalid hello message type" and
    dropped it. Measured 2026-09-29, a real Chrome switched to WebRTC through
    the pool's front door. The websockets stream never showed it, because that
    server speaks first.

    So the socket is made non-blocking for this one look: the buffer if there
    is one, and whatever the kernel already holds, and nothing that is not here.
    """
    prev = sock.gettimeout()
    sock.settimeout(0)
    try:
        return f.peek(0)
    except (BlockingIOError, InterruptedError):
        return b""
    finally:
        sock.settimeout(prev)


def splice(a, b):
    """Copy A to B until either end goes. Then close both."""
    try:
        while True:
            try:
                chunk = a.recv(65536)
            except OSError:
                break
            if not chunk:
                break
            try:
                b.sendall(chunk)
            except OSError:
                break
    finally:
        for s in (a, b):
            try:
                s.shutdown(socket.SHUT_RDWR)
            except OSError:
                pass


def unsafe_header_line(lines):
    """Why a REQUEST's header block cannot be judged line by line, or None.

    EVERY FILTER ON A REQUEST'S HEADERS ASSUMES THE OTHER PARSERS SPLIT THE
    BLOCK WHERE THIS ROUTER DOES, and they need not. This router splits on LF;
    Chrome 153 also ends a line at a lone CR -- measured by the threat review
    on a DESKTOP'S response, where one line "Set-Cookie: a=1<CR>Set-Cookie:
    hdw4s_id=X; Path=/" was judged here as the harmless cookie "a" and
    forwarded verbatim. A desktop's response is no longer judged line by line
    at all (read_response_head() parses it and the router writes its own);
    a request still is, because the Cookie stripped on the way up and every
    Sec-Fetch-* are found line by line. So the block is refused whole:

      a CR anywhere but the line's own ending    split differently elsewhere
      a NUL                                      no browser line has one
      a line that begins with SP or HTAB         obs-fold, which RFC 9112 lets
                                                 a recipient reject.
    """
    for i, line in enumerate(lines):
        body = line[:-2] if line.endswith(b"\r\n") else \
            line[:-1] if line.endswith(b"\n") else line
        what = ("a carriage return inside a line" if b"\r" in body else
                "a NUL byte" if b"\0" in body else
                "a folded continuation line" if i and body[:1] in (b" ", b"\t")
                else None)
        if what is not None:
            return "%s (line %d of its header block)" % (what, i + 1)
    return None


# --------------------------------------------------------------------------
# A desktop's response: parsed, never relayed as it came
# --------------------------------------------------------------------------
#
# THE SHAPE, and why it is this one. Every byte that comes back up a slot's
# socket is the occupant's: a desktop runs untrusted code as its occupant, and
# the occupant controls the streaming server. The browser that receives the
# answer stores cookies and service workers for ONE origin that the router's own
# pages and every desktop in the pool share. So the router never forwards a
# desktop's response HEAD at all. It reads it with the strict grammar below,
# decides from what it read, and WRITES ITS OWN: its own status line, its own
# framing, and only fields whose effect ends with this one response.
#
# Three filters used to sit on the raw bytes, and each one was defeated by the
# next thing nobody had enumerated -- a space before the "=" of a cookie name, a
# lone CR that the browser splits on and the router did not, and an interim 1xx
# block after which the rest was relayed unread. A filter on bytes that are
# then forwarded is only as good as its model of every parser downstream. A
# response the router composes itself from parsed parts has one parser: this
# one. What it did not understand, it does not write.
#
# WHY NOT THE STANDARD LIBRARY'S PARSER (http.client). It is built to be
# lenient, which is the opposite of the job: it accepts folded lines, reads a
# header block through email.parser, which has its own ideas about line ends,
# and skips only "100 Continue" among the interim responses. Its leniency is the
# thing the browser and this router would then disagree about. The grammar
# needed is small, RFC 9112's, and is written out here where it can be read.
#
# WHY NOT A FIELD DENY-LIST on top of the old relay, which is what the three
# fixes were. A deny-list has to name every field with an effect beyond the
# response, and the browser keeps adding them: Clear-Site-Data can delete the
# router's identity cookie, Service-Worker-Allowed widens a worker's scope, and
# Strict-Transport-Security, Alt-Svc, NEL, Report-To, Accept-CH and Set-Login
# all leave state behind for the whole origin. RESPONSE_FIELDS below is the
# other way round: what reaches the browser is what somebody decided is
# confined to the response it arrived on. A field a future Selkies adds is
# DROPPED and said once in the log, which is a visible cost; a field a deny-list
# missed is an invisible one.

class Unrelayable(Exception):
    """A desktop's response the router will not turn into one of its own."""


# RFC 9110 token and field-value characters. A value may carry obs-text
# (0x80-0xFF), because a download's filename is written that way by aiohttp;
# it may not carry a control character, and CR and NUL are control characters.
_TOKEN = frozenset(b"!#$%&'*+-.^_`|~0123456789"
                   b"ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz")
_FIELD_VALUE = frozenset(b"\t") | frozenset(range(0x20, 0x7f)) \
    | frozenset(range(0x80, 0x100))
# Patterns as bytes, not compiled objects: the state sweep (STATE_INVENTORY)
# asks what every module-level mutable is for, and a constant needs no answer.
_STATUS_LINE = rb"HTTP/1\.[01] ([1-5][0-9][0-9])(?: [\t -~\x80-\xff]*)?"
_CHUNK_SIZE = rb"([0-9A-Fa-f]{1,15})[ \t]*(?:;[\t -~\x80-\xff]*)?"

HEAD_LINE_MAX = 16384
HEAD_FIELDS_MAX = 100
INTERIM_MAX = 8


def read_head_line(f):
    """One line of a head, without its ending. LF or CRLF ends it; a line that
    does not end within HEAD_LINE_MAX bytes is refused rather than read on."""
    line = f.readline(HEAD_LINE_MAX + 1)
    if not line:
        raise Closed()
    if not line.endswith(b"\n"):
        raise Unrelayable("a line longer than %d bytes, or cut short"
                          % HEAD_LINE_MAX)
    return line[:-2] if line.endswith(b"\r\n") else line[:-1]


def parse_field(body):
    """(lowercased name, value) of one field line, by RFC 9112 section 5.

    No whitespace before the colon (5.1 says a server MUST reject it), no
    folded continuation (a leading SP or HTAB is not a token character), and
    no control character in the value. A lone CR fails the last of those, so
    no line is ever split differently by a browser: the router never writes a
    received line out again anyway."""
    name, sep, value = body.partition(b":")
    if not sep or not name or not all(c in _TOKEN for c in name):
        raise Unrelayable("a field line that is not \"name: value\"")
    value = value.strip(b" \t")
    if not all(c in _FIELD_VALUE for c in value):
        raise Unrelayable("a control character in the value of %s"
                          % _loggable(name))
    return name.lower(), value


def read_response_head(f):
    """(status, [(name, value), ...]) of one response head, or Unrelayable."""
    m = re.fullmatch(_STATUS_LINE, read_head_line(f))
    if m is None:
        raise Unrelayable("a status line that is not HTTP/1.x")
    fields = []
    while True:
        body = read_head_line(f)
        if not body:
            return int(m.group(1)), fields
        if len(fields) >= HEAD_FIELDS_MAX:
            raise Unrelayable("more than %d fields" % HEAD_FIELDS_MAX)
        fields.append(parse_field(body))


def read_final_head(f, asked_upgrade):
    """The head the browser is owed an answer from, skipping every interim one.

    AN INTERIM RESPONSE IS NEVER RELAYED. 100 Continue means nothing
    downstream: this router has sent the whole request body before it reads a
    byte of the answer, and the reverse proxy runs its own Expect handshake
    with the browser. 103 Early Hints carries only preload hints, which are an
    optimisation. Relaying either is a second head the browser treats specially,
    and the measured hole was exactly that: a 103 was checked, and everything
    after it was relayed unread. Each interim head is still parsed with the
    same grammar, so a malformed one refuses the response like any other.

    101 is not interim here: it is the answer to a WebSocket upgrade, and it is
    accepted only when the request asked for one. A 101 to anything else would
    turn an ordinary exchange into a raw byte pipe from the desktop."""
    for _ in range(INTERIM_MAX + 1):
        status, fields = read_response_head(f)
        if status == 101:
            if not asked_upgrade:
                raise Unrelayable("a 101 to a request that asked for no "
                                  "upgrade")
            return status, fields
        if status >= 200:
            return status, fields
    raise Unrelayable("more than %d interim responses" % INTERIM_MAX)


def message_framing(fields):
    """(chunked, length) declared by a message's fields, or Unrelayable.

    AMBIGUITY IS REFUSED, not resolved: Content-Length together with
    Transfer-Encoding, more than one Content-Length, a length that is not
    digits, a transfer coding other than exactly "chunked". RFC 9112 lets a
    recipient pick Transfer-Encoding in the first case; this one does not,
    because whoever sent both was not writing HTTP for anybody's benefit but
    their own, and two readers of it can end the message in two places."""
    lengths = [v for n, v in fields if n == b"content-length"]
    codings = [v for n, v in fields if n == b"transfer-encoding"]
    if lengths and codings:
        raise Unrelayable("both Content-Length and Transfer-Encoding")
    if len(lengths) > 1:
        raise Unrelayable("%d Content-Length fields" % len(lengths))
    if len(codings) > 1:
        raise Unrelayable("%d Transfer-Encoding fields" % len(codings))
    length = None
    if lengths:
        if not re.fullmatch(rb"[0-9]{1,15}", lengths[0]):
            raise Unrelayable("a Content-Length that is not a number")
        length = int(lengths[0])
    if codings and codings[0].lower() != b"chunked":
        raise Unrelayable("a transfer coding other than chunked")
    return bool(codings), length


def response_framing(method, status, fields):
    """How this response's body is delimited, by RFC 9112 section 6.3.

    ("none", length) for HEAD, 204 and 304 -- no body, whatever the fields
    say; LENGTH is a valid Content-Length to repeat to a HEAD, or None.
    ("length", n), ("chunked", None), or ("close", None). Ambiguity is
    refused by message_framing()."""
    codings, length = message_framing(fields)
    if method == b"HEAD" or status in (204, 304):
        return "none", (length if method == b"HEAD" else None)
    if codings:
        return "chunked", None
    if length is not None:
        return "length", length
    return "close", None


def request_framing(headers):
    """How a request's body is delimited: ("none", None), ("length", n) or
    ("chunked", None). Unrelayable for framing two parsers could read
    differently, by message_framing()'s rule.

    A REQUEST'S BODY MUST BE ACCOUNTED FOR BY WHOEVER ANSWERS THE REQUEST, or
    it is read as the next request on the connection -- and the reverse
    proxy's connection to this router may carry another visitor's request
    next. The router's own pages never read a body; serve() closes the
    connection after answering one that had a body, rather than read it."""
    fields = []
    for h in headers:
        name, _, value = h.partition(b":")
        low = name.strip().lower()
        if low in (b"content-length", b"transfer-encoding"):
            if name != name.strip():
                raise Unrelayable("whitespace around the name %s"
                                  % _loggable(low))
            fields.append((low, value.strip(b" \t\r\n")))
    chunked, length = message_framing(fields)
    if chunked:
        return "chunked", None
    if length:
        return "length", length
    return "none", None


# WHAT A DESKTOP'S RESPONSE MAY CARRY TO THE BROWSER: fields whose effect ends
# with the response or the document it delivers. Everything else is dropped.
# The list is what upstream Selkies sends (2.0.0rc1, read in stream_server.py
# and aiohttp's file and WebSocket responses), plus the page-scoped security
# policies a later Selkies might plausibly add. Deliberately NOT here, each with
# its reason:
#
#   Set-Cookie             a cookie on this origin has one reader, the router:
#                          the Cookie header is stripped on the way up, so a
#                          desktop's cookie never reaches a desktop. Every
#                          name-based filter on it was one more parser to agree
#                          with the browser's, and the first one did not.
#   Service-Worker-Allowed widens a worker's scope over the whole origin.
#   Clear-Site-Data        deletes the router's cookies and storage.
#   Strict-Transport-Security, Alt-Svc, NEL, Report-To, Reporting-Endpoints,
#   Accept-CH, Critical-CH, Set-Login, Origin-Agent-Cluster
#                          state the browser keeps for the ORIGIN.
#   WWW-Authenticate       authentication on this origin is the router's; a
#                          desktop's prompt would leave credentials the browser
#                          then sends to every page of it.
#   Link, Refresh          fetches and navigations the router never asked for.
#   Access-Control-*       nothing of Selkies is read cross-origin.
#   Content-Length, Transfer-Encoding, Connection, Keep-Alive, Trailer, Upgrade
#                          framing and hop-by-hop: the router writes its own.
RESPONSE_FIELDS = frozenset((
    b"content-type", b"content-encoding", b"content-language",
    b"content-disposition", b"content-range", b"accept-ranges",
    b"cache-control", b"expires", b"pragma", b"etag", b"last-modified",
    b"vary", b"age", b"date", b"server", b"location", b"retry-after",
    b"sec-websocket-accept", b"sec-websocket-protocol",
    b"sec-websocket-extensions",
    b"content-security-policy", b"content-security-policy-report-only",
    b"x-content-type-options", b"x-frame-options", b"referrer-policy",
    b"permissions-policy", b"cross-origin-opener-policy",
    b"cross-origin-embedder-policy", b"cross-origin-resource-policy",
))

# Consumed by the router rather than dropped: it writes its own of each.
_FRAMING_FIELDS = frozenset((
    b"content-length", b"transfer-encoding", b"connection", b"keep-alive",
    b"trailer", b"upgrade", b"proxy-connection",
))

_REASONS = (
    (101, "Switching Protocols"), (200, "OK"), (201, "Created"),
    (202, "Accepted"), (204, "No Content"), (206, "Partial Content"),
    (301, "Moved Permanently"), (302, "Found"), (303, "See Other"),
    (304, "Not Modified"), (307, "Temporary Redirect"),
    (308, "Permanent Redirect"), (400, "Bad Request"), (401, "Unauthorized"),
    (403, "Forbidden"), (404, "Not Found"), (405, "Method Not Allowed"),
    (409, "Conflict"), (413, "Content Too Large"),
    (416, "Range Not Satisfiable"), (429, "Too Many Requests"),
    (500, "Internal Server Error"), (502, "Bad Gateway"),
    (503, "Service Unavailable"), (504, "Gateway Timeout"),
)


def response_head(instance, status, fields, framing, extra, upgrade=None):
    """The head the ROUTER writes for a desktop's response, as bytes.

    Built from parsed parts only: a status code (three digits, already
    matched), a reason phrase of our own, the fields on RESPONSE_FIELDS with
    their names re-spelled in lower case, and framing the router chose.
    Every field dropped is said once per slot and name, so a field that a
    future Selkies starts to rely on is visible in the log rather than lost
    silently -- and a desktop sending a thousand made-up names is bounded by
    say_once()'s own limit."""
    out = [b"HTTP/1.1 %d %s\r\n"
           % (status, dict(_REASONS).get(status, "Status").encode())]
    # Carrying our cookie, the response is private whatever the desktop said;
    # a desktop's "no-store" is kept, because nothing makes it weaker.
    private = carries_our_cookie(extra)
    if private:
        said = b",".join(v for n, v in fields if n == b"cache-control")
        out.append(b"Cache-Control: private%s\r\n"
                   % (b", no-store" if b"no-store" in said.lower() else b""))
    for name, value in fields:
        if private and name == b"cache-control":
            continue
        if name in RESPONSE_FIELDS:
            out.append(b"%s: %s\r\n" % (name, value))
        elif name not in _FRAMING_FIELDS:
            say_once(("dropped-field", instance, name),
                     "did not relay the field %s in a response from %s: it "
                     "is not on RESPONSE_FIELDS, the fields whose effect ends "
                     "with the response. Said once per slot and name."
                     % (_loggable(name), instance))
    kind, length = framing
    if upgrade is not None:
        out.append(b"Connection: Upgrade\r\nUpgrade: %s\r\n" % upgrade)
    elif kind == "length" or (kind == "none" and length is not None):
        out.append(b"Content-Length: %d\r\n" % length)
    elif kind == "chunked":
        out.append(b"Transfer-Encoding: chunked\r\n")
    elif kind == "close":
        out.append(b"Connection: close\r\n")
    # Ours goes on last, so the sliding window is wound on by every exchange a
    # long-lived tab has with its own desktop, not only by a visit to the front
    # door. Before this, a tab that stayed at /s/<sid>/ aged out in place.
    for k, v in extra:
        out.append(b"%s: %s\r\n" % (k.encode(), v.encode()))
    out.append(b"\r\n")
    return b"".join(out)


def relay_chunked(upf, wf, rechunk):
    """Decode a chunked body strictly and write it again, chunked by us or,
    for a downstream that speaks HTTP/1.0, bare until close.

    Chunk extensions and trailer fields are read, checked and dropped: the
    browser gets sizes this router wrote. True when the body ended properly."""
    while True:
        m = re.fullmatch(_CHUNK_SIZE, read_head_line(upf))
        if m is None:
            raise Unrelayable("a chunk size line that is not hex")
        n = int(m.group(1), 16)
        if n == 0:
            break
        left = n
        if rechunk:
            wf.write(b"%x\r\n" % n)
        while left > 0:
            data = upf.read(min(left, 65536))
            if not data:
                return False
            wf.write(data)
            left -= len(data)
        if read_head_line(upf) != b"":
            raise Unrelayable("chunk data longer than its size")
        if rechunk:
            wf.write(b"\r\n")
    for _ in range(HEAD_FIELDS_MAX + 1):
        body = read_head_line(upf)
        if not body:
            if rechunk:
                wf.write(b"0\r\n\r\n")
            wf.flush()
            return True
        parse_field(body)
    raise Unrelayable("more than %d trailer fields" % HEAD_FIELDS_MAX)


def registers_a_service_worker(headers):
    """True for a request a browser makes to fetch a service worker's script.

    The browser sends "Service-Worker: script" on exactly that fetch and on
    nothing else, so refusing it refuses the registration and nothing a page
    needs. A desktop serves pages on the pool's one origin; a worker it
    registered even at its own address outlives the desktop in that browser.
    Neither Selkies (2.0.0rc1, 2.0.0) nor anything of ours registers one --
    searched, with the search seen to find the client's WebSocket and its
    manifest link in the same trees.
    """
    return header_value(headers, "Service-Worker") is not None


def forward_request(instance, method, rest, query, headers, rf, wf, sock,
                    extra=(), navigation=False,
                    version=b"HTTP/1.1", body=("none", None),
                    refusal_ends=False):
    """One upstream connection for ONE request. Never one per downstream
    connection -- that is the pooling defect this component exists to avoid.

    Returns whether the downstream connection can carry another request, or
    STARTING when a page navigation was answered with starting_page() because
    the desktop had not answered it in time -- which is NOT the desktop
    answering, and the caller must not treat it as one."""
    path = socket_path(instance)
    up = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    up.settimeout(30)
    try:
        up.connect(path)
    except OSError as e:
        up.close()
        # ANY failure to reach the session is answered, not two named ones.
        #
        # This used to allowlist ENOENT and ECONNREFUSED and re-raise the rest.
        # The failure that actually occurs is neither: a socket left behind by an
        # earlier configuration is owned by a different user than this service
        # runs as, so connect() gives EACCES -- which fell through to the raise,
        # killed the request thread with a traceback, and left the visitor with
        # an empty reply and no page at all. Measured 2026-09-22, reachable by an
        # ordinary arrival with no crafted request: the thing this product exists
        # to serve.
        #
        # So the allowlist is gone rather than extended. Adding EACCES to it
        # would fix the case we happened to hit and leave the next errno to do
        # the same thing -- and an unhandled exception in a request thread is the
        # wrong failure mode for ANY of them, because it fails silently to the
        # person and loudly to nobody.
        #
        # The errno goes in the log because the operator needs to tell a leftover
        # file from a permission problem from a session that is down; the visitor
        # gets the same page either way, since none of those distinctions are
        # theirs to act on.
        log("cannot reach %s at %s: %s (%s)" % (
            instance, path, e.strerror or e,
            errno.errorcode.get(e.errno, e.errno)))
        respond(wf, 502, page(
            "That desktop is not answering",
            "The session behind this address is not running. Open the front "
            "door again to get a new one."), extra)
        return False

    # The connection was accepted, so this slot is in use NOW. Recorded here
    # rather than only by the periodic sweep, which cannot see a visit that
    # begins and ends between two of its samples.
    touch_slot(instance)

    target = rest + (b"?" + query if query else b"")
    out = [b"%s %s HTTP/1.1\r\n" % (method, target)]
    for h in headers:
        low = h.lower()
        # The front door's credential is for the leg between the reverse proxy
        # and this component only. It is never passed downstream: nothing below
        # needs it, and a session's own uid can read whatever it is given.
        if low.startswith(b"authorization:"):
            continue
        # Our identity cookie is ours. The session has no use for it and must
        # not be able to read other browsers' identities out of its own logs.
        if low.startswith(b"cookie:"):
            continue
        # Host and Origin go through UNCHANGED. Selkies rejects a WebSocket
        # upgrade whose Origin hostname does not match the Host header, so
        # rewriting either one here would break the stream and would do it only
        # at upgrade time, long after the page looked fine.
        out.append(h)
    out.append(b"\r\n")
    up.sendall(b"".join(out))

    upf = up.makefile("rb")

    # Request body, if any, as request_framing() read it in serve(). Chunks
    # are decoded and written again with our sizes, like a response's.
    kind, left = body
    if kind == "length":
        while left > 0:
            chunk = rf.read(min(left, 65536))
            if not chunk:
                break
            up.sendall(chunk)
            left -= len(chunk)
    elif kind == "chunked":
        upw = up.makefile("wb")
        try:
            whole = relay_chunked(rf, upw, True)
        except (Unrelayable, Closed) as e:
            whole = False
            log("refused a chunked request body for %s: %s"
                % (instance, e if isinstance(e, Unrelayable) else "cut short"))
        if not whole:
            up.close()
            respond(wf, 400, page("Bad request", "That was not HTTP."), extra)
            return False

    # A PAGE THE DESKTOP HAS NOT ANSWERED IN TIME is answered by us. The request
    # has already been sent, so the start it triggers goes on; only the reply is
    # given up, and the page we send asks for it again (starting_page()). The
    # upstream connection is simply closed: the relay, once it starts, finds a
    # request whose sender has gone, which costs nothing.
    if navigation:
        try:
            ready, _, _ = select.select([up], [], [], STARTING_PAGE_AFTER)
        except (OSError, ValueError):
            ready = [up]
        if not ready:
            up.close()
            log("%s had not answered a page request after %.1f s; sent the "
                "starting page" % (instance, STARTING_PAGE_AFTER))
            respond(wf, 200, starting_page(),
                    [("Cache-Control", "no-store")] + list(extra))
            return STARTING

    # Response. See read_response_head() and response_head(): nothing of the
    # desktop's head is written as it came, only what was parsed out of it.
    try:
        answered = upf.peek(1)
    except OSError:
        answered = None
    if answered is None:
        up.close()
        log("%s did not answer a request within %d s"
            % (instance, up.gettimeout()))
        respond(wf, 502, page("That desktop is not answering",
                              "Try again."), extra)
        return False
    if not answered:
        up.close()
        respond(wf, 502, page("That desktop closed the connection",
                              "Try again."), extra)
        return False
    asked_upgrade = header_value(headers, "Upgrade") is not None
    try:
        status, fields = read_final_head(upf, asked_upgrade)
        framing = response_framing(method, status, fields)
        upgrade = None
        if status == 101:
            upgrade = dict(fields).get(b"upgrade")
            if not upgrade or not all(c in _TOKEN or c == 0x2f
                                      for c in upgrade):
                raise Unrelayable("a 101 that names no protocol")
    except (Unrelayable, Closed, OSError) as e:
        # NOTHING OF THIS RESPONSE IS FORWARDED, not even its status line.
        up.close()
        why = str(e) if isinstance(e, Unrelayable) else \
            "the connection ended or failed inside the head (%s)" \
            % (type(e).__name__)
        say_once(("unsafe-header", instance),
                 "refused a response from %s: %s. Nothing of it was sent to "
                 "the browser, which was answered 502. Said once per slot."
                 % (instance, why))
        respond(wf, 502, page("That desktop sent something unreadable",
                              "Try again."), extra)
        return False

    # THE RELAY'S REFUSAL, for a letting whose desktop had answered: nothing of
    # it is sent, and the caller gates the visitor (REFUSED). Recognised only by
    # the whole of hdw4s-refuse's page, so a desktop's own 503 is relayed as it
    # always was -- and a desktop that forges the page can end only its own
    # visitor's letting.
    prefix = b""
    if refusal_ends and REFUSAL_PAGE and status == 503 and \
            framing == ("length", len(REFUSAL_PAGE)):
        try:
            prefix = upf.read(len(REFUSAL_PAGE))
        except OSError:
            prefix = b""
        if prefix == REFUSAL_PAGE:
            up.close()
            return REFUSED

    # A downstream that asked in HTTP/1.0 cannot read chunks: it is sent the
    # decoded body and the end of the connection instead.
    rechunk = version != b"HTTP/1.0"
    if framing[0] == "chunked" and not rechunk:
        framing = ("close", None)
        dechunk = True
    else:
        dechunk = framing[0] == "chunked"
    wf.write(response_head(instance, status, fields, framing, extra, upgrade))
    if prefix:
        wf.write(prefix)
    wf.flush()

    if status == 101:
        # The upgrade succeeded, so this pair is now dedicated. That is correct:
        # after a 101 the connection belongs to that WebSocket and carries no
        # further requests to route. What follows is WebSocket frames, which a
        # browser reads as frames and never as a head.
        pending = buffered_now(upf, up)
        if pending:
            wf.write(upf.read(len(pending)))
            wf.flush()
        t = threading.Thread(target=splice, args=(sock, up), daemon=True)
        t.start()
        splice(up, sock)
        t.join(5)
        return False

    # THE BODY. The head is already written, so a desktop that breaks its own
    # framing from here on cannot be answered 502: the connection to the
    # browser is closed instead, which ends the response short and carries no
    # further request -- nothing the desktop sends after the break is read.
    kind, length = framing
    try:
        if kind == "none":
            ended = True
        elif dechunk:
            ended = relay_chunked(upf, wf, rechunk)
        elif kind == "length":
            left = length - len(prefix)
            while left > 0:
                chunk = upf.read(min(left, 65536))
                if not chunk:
                    break
                wf.write(chunk)
                left -= len(chunk)
            ended = left == 0
        else:
            # No length and no chunks: the body runs to the end of the
            # connection, so this downstream connection cannot carry another
            # request either.
            while True:
                chunk = upf.read(65536)
                if not chunk:
                    break
                wf.write(chunk)
            ended = False
        wf.flush()
    except (Unrelayable, Closed, OSError) as e:
        say_once(("unsafe-body", instance),
                 "cut short a response from %s: %s. The browser's connection "
                 "was closed. Said once per slot."
                 % (instance, e if isinstance(e, Unrelayable)
                    else type(e).__name__))
        ended = False
    up.close()
    return ended and kind != "close"


# --------------------------------------------------------------------------
# Connection
# --------------------------------------------------------------------------

def serve(sock, own, expected_b64):
    sock.settimeout(IDLE_TIMEOUT)
    rf = sock.makefile("rb")
    wf = sock.makefile("wb")
    # A request body nobody read. See request_framing(): it is never read as
    # the next request, so the connection ends instead.
    unread = False
    try:
        while True:
            if unread:
                return
            try:
                line = read_line(rf)
            except (Closed, socket.timeout, OSError):
                return
            bits = line.split()
            if len(bits) != 3:
                respond(wf, 400, page("Bad request", "That was not HTTP."))
                return
            method, target, version = bits
            try:
                headers = read_headers(rf)
            except (Closed, OSError):
                return
            # REFUSED WHOLE, NOT JUDGED (unsafe_header_line()), because the
            # Cookie stripped on the way up and every Sec-Fetch-* judged here
            # are found line by line as THIS parser splits them. No browser
            # can send a line another parser would split differently, so this
            # refuses nobody's browser; it keeps this router's reading of a
            # request the only one there is.
            if unsafe_header_line([line] + headers) is not None:
                respond(wf, 400, page("Bad request", "That was not HTTP."))
                return
            try:
                body = request_framing(headers)
            except Unrelayable as e:
                say_once(("ambiguous-request", str(e)),
                         "refused a request with %s: two parsers could end "
                         "its body in different places (400). Said once per "
                         "reason." % e)
                respond(wf, 400, page("Bad request", "That was not HTTP."))
                return
            # Until forward_request() takes it, this body is unread.
            unread = body[0] != "none"

            if not authorized(headers, expected_b64):
                respond(wf, 401, page(
                    "Not authorised",
                    "This front door is reached through the reverse proxy."),
                    [("WWW-Authenticate", 'Basic realm="%s"' % REALM)])
                return

            # Identity is resolved BEFORE the first response that a browser
            # keeps, and that ordering is load bearing rather than tidy: the
            # trailing-slash redirect below used to be answered without one, so
            # a tab whose only traffic for a while was that redirect got no
            # cookie back and its window did not slide.
            sid, rest, query = parse_target(target)
            if registers_a_service_worker(headers):
                # BEFORE any identity is minted or any session resolved: this
                # request is answered the same whoever sends it, and it must
                # not reach a desktop, start one, or hand out a cookie.
                say_once(("service-worker", sid),
                         "refused a service worker's script under %s: a page "
                         "on this origin tried to register one, and none of "
                         "ours does. Said once per session address."
                         % (("/s/%s/" % sid) if sid else "the router's own "
                            "pages"))
                respond(wf, 403, page(
                    "Not available",
                    "This address cannot be installed as a background "
                    "worker."))
                continue
            identity = identity_of(headers)
            new_identity = False
            if identity is None:
                identity = own.mint_identity()
                new_identity = True

            if needs_trailing_slash(target):
                path, _, q = target.partition(b"?")
                loc = path.decode("latin-1") + "/" + (("?" + q.decode("latin-1")) if q else "")
                respond(wf, 302, b"", [("Location", loc)] +
                        refresh_headers(own, identity, new_identity))
                continue

            if sid is None:
                what, csid = console_target(rest)
                if what is not None:
                    # EVERY console POST, not only the three that act today:
                    # a fourth that acts would otherwise arrive unguarded.
                    why = cross_site_refusal(headers) \
                        if method == b"POST" else None
                    if why is not None:
                        refuse_cross_site(wf, what, why, identity)
                        continue
                    console(own, wf, identity, new_identity, what, csid, method)
                    continue
                # ONLY THE FRONT DOOR ITSELF REACHES arrival(), because
                # arrival() MINTS for a browser that owns nothing live, and
                # minting is a damage. Everything else not claimed above is a
                # 404. It used to be the other way round -- every unclaimed
                # path was an arrival -- and what that did was measured on a
                # test box: our pages carried no icon link, so the browser
                # asked for /favicon.ico straight after them, and a visitor
                # who discarded their last desktop was handed a new one within
                # a second. A restored tab on the ended page, a bookmark to an
                # odd path, or a mistyped console address did the same.
                #
                # Not a redirect to / either: that would be the same mint one
                # request later, for a request that asked for no desktop.
                if not is_front_door(rest):
                    respond(wf, 404, card(
                        "Nothing here",
                        "<p>This address is not a page of this machine.</p>"
                        "<div class=\"actions\"><a class=\"btn secondary\" "
                        "href=\"/sessions/\">Your desktops</a></div>"),
                        refresh_headers(own, identity, new_identity))
                    continue
                arrival(own, wf, identity, query, new_identity,
                        arrival_dest(headers))
                continue

            gone = False
            rec = own.lookup(sid)
            if rec is not None:
                # RESOLVING IS NOT ENOUGH, and that gap is why the gate below
                # was unreachable by the one visitor it was written for.
                #
                # The table knows nothing about reaping. A visitor whose desktop
                # the sweep stopped presents a sid that resolves PERFECTLY, so
                # they fell straight past the gate to the proxy -- and the slot
                # socket is still listening and socket-activated, so -- under the
                # relay's old BindsTo= -- the connect succeeded and started a
                # brand-new empty desktop under their old address, in about two
                # seconds. Not a 502, not a stall:
                # their in-memory home was gone and the screen looked fine.
                #
                # So the person the 410 page was written for was the only person
                # who could never see it, while it was shown to strangers whose
                # ids had simply expired.
                why = ("%s has been let again since this letting"
                       % rec["instance"]) if own.superseded(sid) else \
                    session_replaced(rec, rec["instance"])
                if why is not None:
                    own.forget(sid)
                    log("gated a returning visitor at %s: %s"
                        % (rec["instance"], why))
                    # Said, in the line above; the tab's next requests are the
                    # same event and are not reported again below.
                    say_once(("unknown", sid))
                    # AND THE SLOT IS RECLAIMED IF WE LET IT. Gating alone
                    # leaves a full desktop running in that slot for nobody --
                    # which is the leak: one visitor ending four sessions
                    # correctly consumed four slots in seven minutes. The
                    # qualifier is everything here; reclaim_slot() declines,
                    # out loud, for anything this router cannot say it let.
                    reclaim_slot(own, sid, rec, why)
                    rec = None
                    gone = True
            if rec is None:
                # GATE. Not a mint, and the difference is the whole point.
                #
                # A tab presenting an id that no longer exists is by definition
                # RETURNING rather than arriving -- nothing else produces that
                # state -- so this needs no clock, no age threshold and no
                # guess. And MINTING IS A DAMAGE, not a neutral default: a
                # machine whose tabs are restored lazily after a reboot presents
                # a dead id from EVERY restored tab, and minting on each one
                # hands back one unwanted desktop per tab. That is the second of
                # the two damages the gate exists for, alongside taking over
                # somebody else's session.
                #
                # It must also never fall through to whatever now holds the
                # slot, which is the recycling hazard the ownership keying
                # guards.
                #
                # The shape to keep: an input we cannot resolve produces a
                # QUESTION, never an ACTION. A failure that degrades toward
                # doing something is the same defect as a signal that degrades
                # toward "safe".
                #
                # The cookie rides on the gate. A browser whose tabs are being
                # restored after a reboot presents a dead id from every one of
                # them, and those gates may be the only thing it says to us for
                # days -- letting its identity lapse there would cost it the
                # OTHER sessions it still owns.
                #
                # The page lists THIS browser's other desktops, from its own
                # identity, so a stranger presenting a dead id sees only their
                # own list. Every pressable on it is a GET that asks (Discard),
                # a POST Resume of one of those desktops, or the directory's
                # POST create: still no mint, and no silent connect, without a
                # press.
                say_once(("unknown", sid),
                         "refused session %s: there is no letting on record "
                         "for it, so everything under it is answered with the "
                         "ended page (410); visitor %s"
                         % (sid, visitor_tag(identity)))
                respond(wf, 410, ended_page(owned_rows(own, identity), gone),
                        refresh_headers(own, identity, new_identity))
                continue
            if rec["identity"] != identity:
                # The invariant, refusing: different identities never see each
                # other's sessions. This is the negative the close is tested with.
                say_once(("foreign", sid, visitor_tag(identity)),
                         "refused session %s to visitor %s: it belongs to a "
                         "different browser (403)"
                         % (sid, visitor_tag(identity)))
                respond(wf, 403, page(
                    "Not your desktop",
                    "This address belongs to a different browser."),
                    refresh_headers(own, identity, new_identity))
                continue

            if not rec.get("live"):
                # THE LETTING'S FIRST REQUEST ASKS FOR ITS DESKTOP, and waits
                # for it. See start_for_first_request() and await_desktop():
                # connecting earlier is refused by the relay now that a
                # connection cannot start anything.
                why = start_for_first_request(own, sid)
                navigation = is_page_navigation(method, rest, headers)
                state = "gone" if why else \
                    await_desktop(rec["instance"], navigation)
                if state in ("up", "unknown"):
                    # AND ASKED AGAIN after the wait, from the table: the
                    # hold was renewed, but a letting that was ended or
                    # re-let meanwhile must not be forwarded into the slot.
                    with own.letting:
                        why = still_this_letting(own, sid, grace=False)
                    state = "gone" if why else state
                if state == "gone":
                    own.forget(sid)
                    log("gated a returning visitor at %s: %s"
                        % (rec["instance"], why))
                    say_once(("unknown", sid))
                    respond(wf, 410, ended_page(owned_rows(own, identity),
                                                True),
                            refresh_headers(own, identity, new_identity))
                    continue
                if state == "starting":
                    log("%s had not answered a page request after %.1f s; "
                        "sent the starting page"
                        % (rec["instance"], STARTING_PAGE_AFTER))
                    respond(wf, 200, starting_page(),
                            [("Cache-Control", "no-store")]
                            + refresh_headers(own, identity, new_identity))
                    continue
                if state == "late":
                    log("%s did not start listening within %d s of a request"
                        % (rec["instance"], FIRST_ANSWER_WAIT))
                    respond(wf, 502, page("That desktop is not answering",
                                          "Try again."),
                            refresh_headers(own, identity, new_identity))
                    continue

            unread = False
            served = forward_request(rec["instance"], method, rest, query,
                                     headers, rf, wf, sock,
                                     refresh_headers(own, identity,
                                                     new_identity),
                                     is_page_navigation(method, rest, headers),
                                     version=version, body=body,
                                     refusal_ends=bool(rec.get("live")))
            if served is REFUSED:
                # THE DESKTOP THIS LETTING HAD IS NOT RUNNING, on systemd's own
                # word: its relay's Requisite= was refused. Gated exactly as a
                # letting whose desktop was seen to stop -- and reclaimed if a
                # desktop nobody asked for is somehow in the slot.
                why = "the desktop behind %s is not running (its relay was " \
                    "refused)" % rec["instance"]
                own.forget(sid)
                log("gated a returning visitor at %s: %s"
                    % (rec["instance"], why))
                say_once(("unknown", sid))
                reclaim_slot(own, sid, rec, why)
                respond(wf, 410, ended_page(owned_rows(own, identity), True),
                        refresh_headers(own, identity, new_identity))
                continue
            if served is STARTING:
                # NOT AN ATTACHMENT. The desktop has not answered, so the
                # slot's published token may still be the LAST occupant's (it
                # survives a reap), and recording it now would later read as
                # "a different desktop" and gate this visitor out of their own.
                # The reload our page makes, once the desktop has answered, is
                # what attaches.
                continue
            # A DESKTOP IS NOW THERE, so there is at last a start to attach to.
            # This is the earliest moment such a thing exists: before it, the
            # slot's published token belongs to whoever held it last -- it
            # survives a reap, measured -- and the session about to start will
            # replace it. Recording here rather than at mint is the difference
            # between a check that refuses a stranger and one that refuses
            # everybody, which is what the first version did to every test at
            # once.
            #
            # ASKED OF THE AUTHORITY, not inferred from the return value above.
            # forward_request() answers False for "this downstream connection
            # cannot carry another request" AND for the 502 it writes when the
            # session could not be reached, and those must not attach alike --
            # treating a 502 as an attachment would pin a record to a desktop
            # that never existed. One stat settles it and cannot be confused.
            if occupancy_readable() and slot_occupied(rec["instance"]) and \
                    own.attach(sid, slot_incarnation(rec["instance"])):
                # The desktop has answered, so the authority now speaks for
                # this slot and is more current than we are. Our reservation
                # has nothing left to say and holding it would only delay the
                # slot's return when the session stops. ONLY FOR A LETTING
                # attach() accepted: releasing on a refused one deleted the
                # hold of whoever the slot had been let to since.
                release_slot(rec["instance"])
            if not served:
                return
    finally:
        for f in (rf, wf):
            try:
                f.close()
            except OSError:
                pass
        try:
            sock.close()
        except OSError:
            pass


def assert_an_ended_letting_is_never_proxied(factory=Ownership,
                                            replaced=session_replaced,
                                            in_use=slots_in_use,
                                            asked=teardown_requested):
    """Prove a discarded letting cannot be proxied, and that a live one still can.

    Runs at every start beside the others. WHAT IT CATCHES IS INVISIBLE FROM THE
    OUTPUT, which is why it is here and not only in a test file: a request
    proxied into a slot whose desktop is stopping started a FRESH desktop in
    that slot under the relay's old BindsTo= (now it is refused), and the visitor sees a perfectly ordinary screen while a production
    slot is consumed for the length of the idle window -- seven days on the
    shipped default. Nothing fails, nothing logs, and the reaper is right to say
    nothing.

    THE PERMIT ARM IS NOT DECORATION. A version of this gate that refused
    everything would stop the leak and also gate every living visitor, which is
    the more expensive defect of the two: [[restarting-sessions-is-usually-safe]]
    and the 503-vs-gate history both say a refusal that should have been a resume
    costs more than a leak. So the same record, with the same healthy world
    around it, must be permitted while it has not ended.

    AND THE WORLD IS BUILT TO LIE, on purpose. Every instrument the gate would
    otherwise consult is given the HEALTHY answer: the runtime directory exists,
    the token matches, and the door is stubbed open. That is the production
    state at the moment of the defect -- the teardown has been asked for and
    nothing in the world has caught up. A fixture where the directory was already
    gone would pass against the old code too, which is the arm this project has
    got wrong before.
    """
    import shutil
    import tempfile

    d = tempfile.mkdtemp(prefix="hdw4s-demux-ended-")
    try:
        rundir = os.path.join(d, "run", "hdw4s")
        web = os.path.join(d, "web")
        os.makedirs(os.path.join(rundir, "ephemeral0"))
        os.makedirs(os.path.join(web, "ephemeral0"))
        with open(os.path.join(web, "ephemeral0", "hdw4s-incarnation"), "w") as f:
            f.write("same-token")
        open_door = lambda inst: True

        def rec(ended=None):
            return {"live": True, "incarnation": "same-token", "minted": 0.0,
                    "instance": "ephemeral0", "ended": ended}

        # PERMIT ARM, first, so a gate that refuses everything cannot satisfy
        # this function by passing the arm below.
        why = replaced(rec(), "ephemeral0", rundir=rundir, webroot=web,
                       door=open_door)
        assert why is None, \
            "a live letting was gated although nothing about it had ended: %r" % why

        # REFUSE ARM. The same record, the same healthy world, and the one thing
        # that differs is the act we performed ourselves.
        why = replaced(rec("the visitor discarded it"), "ephemeral0",
                       rundir=rundir, webroot=web, door=open_door)
        assert why is not None, \
            "a DISCARDED letting was permitted to proxy. The next request for" \
            " it reaches a relay that refuses it -- under the relay's old" \
            " BindsTo=, a fresh desktop in that slot, for nobody"

        # AND IT MUST NOT NEED AN INSTRUMENT TO SAY SO. The whole point is that
        # this answer precedes the world: with the occupancy authority absent --
        # where every other reason withholds itself, correctly -- the act must
        # still speak.
        why = replaced(rec("the visitor discarded it"), "ephemeral0",
                       rundir=os.path.join(d, "no-such-rundir"), webroot=web,
                       door=open_door)
        assert why is not None, \
            "the discard was answered only when the occupancy authority could" \
            " be read, so the gate is behind an instrument rather than in front" \
            " of one"

        # THE OTHER HALF OF THE PAIR: a slot mid-teardown must not be re-let.
        # Without this, the gate above could fire on a FRESH letting that had been
        # minted onto the slot while the previous one was still being torn down.
        tdir = os.path.join(d, "teardown")
        os.makedirs(os.path.join(tdir, "ending"))
        pool = ["ephemeral0", "ephemeral1"]
        seen = asked("ephemeral1", root=tdir)
        assert seen is False, \
            "a slot with no teardown marker was reported as being torn down"
        open(os.path.join(tdir, "ending", "ephemeral1"), "w").close()
        assert asked("ephemeral1", root=tdir) is True, \
            "the in-progress marker hdw4s-teardown leaves for the WHOLE of a" \
            " teardown was not seen; the only thing this router could see was" \
            " the request file, which the teardown clears before it does any work"
        # AND IT EXPIRES, because the marker is cleared by another process and a
        # marker that outlived a SIGKILL would take the slot out of the pool
        # until the next reboot.
        assert asked("ephemeral1", root=tdir,
                     now=time.time() + TEARDOWN_MARKER_MAX + 1) is False, \
            "the in-progress marker never expires, so one killed teardown" \
            " retires a slot permanently"
        _ = pool
    finally:
        shutil.rmtree(d, ignore_errors=True)


def listening_socket():
    """systemd's fd if we were socket-activated, otherwise our own bind."""
    if os.environ.get("LISTEN_FDS") and os.environ.get("LISTEN_PID") == str(os.getpid()):
        s = socket.socket(fileno=3)
        s.setblocking(True)
        log("listening on the socket unit's fd")
        return s
    s = socket.socket(socket.AF_INET, socket.SOCK_STREAM)
    s.setsockopt(socket.SOL_SOCKET, socket.SO_REUSEADDR, 1)
    s.bind((BIND, PORT))
    s.listen(128)
    log("listening on %s:%d" % (BIND, PORT))
    return s


def main():
    global COOKIE_LIFETIME

    # Both arms, at every start, before anything can arrive.
    assert_ownership_keying(Ownership)
    assert_cookie_outlives_idle(derive_cookie_lifetime)
    # And the third, for the same reason and with a sharper history: the probe
    # this guards used to CONNECT, and a connect on a socket-activated slot is
    # not a question, it is an instruction to start a desktop. That was silent
    # for as long as it existed, because what the probe reported became true the
    # moment it asked.
    assert_probe_does_not_activate(slot_unreachable, listening_paths)
    # And the fourth, which is the routing decision itself: that occupancy is
    # observed rather than created, that a missing authority is withheld rather
    # than spent, and that the incarnation token can only ever refuse.
    assert_occupancy_is_read_not_created(slot_occupied, occupancy_readable,
                                         session_replaced)
    # And the one that DESTROYS. Every other guard here refuses somebody a
    # desktop when it fires wrongly; this one ends a desktop somebody is
    # using, with nobody watching, and the only thing standing between those
    # two outcomes is whether this router can produce the letting it is acting
    # on. Proved at every start, in both directions.
    assert_reclaim_needs_a_letting(reclaimable, Ownership)
    # And the door, which is the other half of the same leak: the reclaim ENDS
    # a desktop the slot was left running, this stops one being started. Its
    # dangerous direction is the quiet one -- a false OPEN keeps the leak while
    # looking like a working repair -- so the TIME_WAIT case is built from a
    # real fixture rather than reasoned about.
    assert_door_only_refuses_what_it_measured(listening_paths,
                                              slot_door_open, session_replaced,
                                              Ownership)
    # And the fifth, which is WHICH SLOTS EXIST at all -- the question the four
    # above all take an answer to. It was computed from a directory listing for
    # as long as this file has existed, and was sighted three times without
    # being fixed, because the function's name promised the pool while its body
    # returned filenames.
    assert_pool_is_typed(slot_table, ephemeral_slots)
    # And the newest one, which is the ORDER rather than a condition: what this
    # router DID must be asked before anything it can observe, because everything
    # it can observe is late by seconds and a request landing in those seconds is
    # proxied into a dying slot and starts a desktop there.
    assert_an_ended_letting_is_never_proxied(Ownership, session_replaced,
                                            slots_in_use, teardown_requested)
    # And the fifth: the only fact this process holds whose LOSS can permit
    # something, which is why it was written to disk first. That it holds,
    # that it expires, and that it has no way to say yes to anybody.
    assert_reservation_only_refuses(reserve_slot, reserved_slots, release_slot,
                                    reservation_fresh)
    # And the console's address parsing, for the reason given in its own
    # docstring: what this does not claim is MINTED, so a parser that quietly
    # stopped matching would turn "end my desktop" into "give me another one".
    assert_console_shows_only_your_own(console_target)
    # And the press that another page made, refused and ours permitted.
    assert_cross_site_posts_are_refused(cross_site_refusal)

    # The third guard REPORTS and does not refuse, and the asymmetry with the
    # two above is deliberate. Those two fail closed because what they catch is
    # a router that would hand somebody a stranger's desktop or lock somebody
    # out of their own. This one catches a container nobody wrote a purpose
    # for, which is a mistake made while editing this file -- no visitor and no
    # administrator can create it -- so the person who will see this line is
    # the person who just caused it, on their first run. Taking the front door
    # down for that would be a bookkeeping slip paid for with an outage, and a
    # guard that does that is removed within the week.
    #
    # It is still a real guard because the suite calls the refusing face:
    # .github/live/demux.py asserts on the refusal itself, so this cannot
    # quietly become a line nobody reads.
    examined = []
    unclassified = uninventoried_state(globals(), Ownership, STATE_INVENTORY,
                                       examined=examined)
    for complaint in unclassified:
        log("WARNING: %s" % complaint)
    # SAID OUT LOUD EVEN WHEN CLEAN, and that is not a banner. A guard whose
    # green is silence cannot be told apart from a guard nobody called -- which
    # is this project's own recorded defect, a whole suite believed green that
    # had never been invoked by anything at all. The suite asserts on this
    # line, so deleting the call above turns a test red instead of turning a
    # check into decoration.
    #
    # It counts what the sweep LOOKED AT, not what the inventory holds, and
    # that distinction was measured rather than reasoned: the first version
    # printed len(STATE_INVENTORY), and a main() with the call ripped out
    # printed the same reassuring number while the suite stayed green.
    log("state inventory: %d name(s) examined, %d unclassified"
        % (len(examined), len(unclassified)))

    expected_b64 = load_credential()
    # Made before the table is read, because the table lives in it. Normally
    # systemd has made it already (RuntimeDirectory=); this is for a router run
    # by hand or by the test rig.
    os.makedirs(STATE_DIR, mode=0o700, exist_ok=True)
    own = Ownership(OWNERSHIP_FILE)

    # DERIVED AT START, from the pool as it stands. Said out loud with both
    # halves, because the whole reason this is not a knob is the relationship
    # between the two numbers, and a reader who sees only one cannot check it.
    windows = idle_windows()
    COOKIE_LIFETIME = derive_cookie_lifetime(windows)
    log("an identity lasts %d day(s), derived from %d ephemeral slot(s): %s"
        % (COOKIE_LIFETIME // 86400, len(windows),
           ", ".join("%s=%s" % (i, describe_window(s))
                     for i, s in sorted(windows, key=lambda r: r[0]))
           or "none configured"))
    standing = cookie_policy_complaints(COOKIE_LIFETIME, windows)
    for complaint in standing:
        log("WARNING: %s" % complaint)
        log("  While that holds, a desktop can outlive the identity that owns"
            " it -- and its owner then cannot reach it or close it.")

    # AND ASKED AGAIN WHILE WE RUN. The lifetime above is pinned and the
    # configuration is not, so an administrator who widens an idle window on a
    # live box moves one clock and not the other. Until now the only thing that
    # ever noticed was log_refusal(), which fires when the pool is exhausted --
    # so on a box with a spare slot the warning had no trigger at all and the
    # gap could stand indefinitely. Seeded with what was just printed, so the
    # first thing this says is a CHANGE and not an echo.
    threading.Thread(target=watch_cookie_policy,
                     args=(COOKIE_LIFETIME, set(standing)),
                     daemon=True).start()
    # For the same reason as above: a thread that was never started is silent
    # in exactly the way a thread with nothing to report is silent.
    log("the identity lifetime is re-checked against the pool every %d minute(s)"
        % int(COOKIE_POLICY_EVERY // 60))

    # The sweep's record is the second of the two columns the refusal log
    # prints. Whether it can be read at all is a property of this process, not
    # of the sweep, so it is settled here rather than discovered by an operator
    # reading a column of question marks during an outage.
    if windows:
        probe = os.path.join(REAP_STAMP_DIR, sorted(windows)[0][0])
        _, why = stamp_age(probe)
        if why and why.startswith("unreadable"):
            log("WARNING: the idle sweep's record under %s cannot be read here"
                " (%s)." % (REAP_STAMP_DIR, why))
            log("  Refusals will still be logged, and the last-request column"
                " is unaffected, but the sweep's own column will be blank.")

    # SAID OUT LOUD, BOTH HALVES, because each degrades quietly.
    #
    # If the authority is missing, this router cannot tell an occupied slot from
    # a free one and will re-let a running desktop after a restart. That is the
    # defect this change exists to remove, so it must not be reachable by a
    # silent path -- and its symptom on a live box is somebody else's desktop,
    # which nobody traces back to a directory that was not there.
    # THE POOL, READ ONCE FOR THE WHOLE BANNER. Every line below used to call
    # the socket-directory listing again, so the banner described a set the mint
    # path does not use and re-read it four times while it did. An operator
    # sizing a pool from "routing to 4 slot(s)" was being told about a named
    # desktop's leftover socket.
    pool = ephemeral_slots()
    if pool is None:
        log("WARNING: the slot table at %s cannot be read, so this router does"
            " not know which slots are ephemeral." % SLOTS_FILE)
        log("  It will refuse every arrival until that is fixed. It will NOT"
            " fall back to the sockets under %s: every instance on this box"
            " binds into that directory, named desktops included, and handing"
            " one of those to a visitor is the defect this refuses to repeat."
            % PROXY_RUNDIR)
        pool = []
    if occupancy_readable():
        busy = [n for n in pool if slot_occupied(n)]
        log("%d of %d slot(s) already have a desktop running: %s"
            % (len(busy), len(pool), ", ".join(busy) or "none"))
        log("  Read from the sessions' own runtime directories under %s, which"
            " survive a restart of this service. Nothing was opened to find"
            " out." % SESSION_RUNDIR)
    else:
        log("WARNING: %s does not exist, so nothing here can tell a slot with a"
            " desktop behind it from a free one." % SESSION_RUNDIR)
        log("  Every slot will be treated as available. After a restart of this"
            " service that re-lets desktops that never stopped, and the visitor"
            " already using one is not told.")
        log("  It is created by hdw4s-ephemeral-slots at boot; if that has not"
            " run, this router is routing without the fact it routes on.")
    # The corroborator, reported separately because "no opinion" and "agrees"
    # are different states and only one of them is evidence.
    published = [n for n in pool if slot_incarnation(n)]
    if not published:
        log("no slot publishes an incarnation under %s, so a returning visitor"
            " is judged on occupancy alone." % WEBROOT_DIR)
        log("  That still refuses a reaped desktop. What it cannot see is a"
            " slot reaped and re-let to somebody else between two visits.")

    # THE ORPHANS, NAMED. Said before the pool rather than after it, because the
    # sighting that started this was an operator reading a socket file's name in
    # the routing line and concluding the pool had a slot it does not have. A
    # name here is either a named desktop's socket -- correct, and none of this
    # router's business -- or a leftover nothing will ever serve.
    stray = [n for n in socket_filenames() if n not in pool]
    if stray:
        log("%d socket(s) in %s are not ephemeral rows in %s and will never be"
            " offered: %s"
            % (len(stray), PROXY_RUNDIR, SLOTS_FILE, ", ".join(stray)))
        log("  A named desktop's socket belongs here and is not a fault. One"
            " that belongs to nothing is a leftover and can be removed.")

    slots = pool
    if not slots:
        log("no ephemeral slots in %s; nothing can be minted here."
            % SLOTS_FILE)
    else:
        log("routing to %d slot(s): %s" % (len(slots), ", ".join(slots)))
        # Read ONCE for the whole pool rather than once per slot, so the banner
        # describes one instant instead of N of them.
        listening = listening_paths()
        if listening is None:
            log("WARNING: /proc/net/unix could not be read, so whether anything"
                " is listening on each slot is unknown here.")
            log("  The names below are what the pool is configured with. They"
                " are not a claim that any of them can be served.")
        # A slot with its own Basic credential answers 401 to EVERYTHING that
        # comes through here, including its index -- and it does so alone, while
        # its neighbours work, which reads as a routing fault rather than as
        # configuration. Say it at startup instead of letting one slot in the
        # pool fail silently.
        for name in slots:
            # REACHABILITY, before anything about credentials. The banner above
            # names what this router will hand to visitors, and it used to
            # announce slots it could not open -- a socket left behind by an
            # earlier configuration, with nothing bound to it, was listed as
            # routable and then given to the first arrival, which got no
            # response at all.
            #
            # THIS LOOP USED TO BE THE MOST EXPENSIVE LINE IN THE FILE. It ran
            # one connect-and-close per slot, and on a socket-activated pool a
            # connect starts a desktop. Measured on a three-slot pool: every
            # session stopped, one `systemctl restart hdw4s-demux`, and eleven
            # milliseconds after this banner printed, all three incarnation
            # units and all three GNOME sessions had started -- with no arrival
            # and nobody on the box. A restart of the front door consumed the
            # whole pool, every time, and said nothing, because by the time
            # anyone read "routing to 3 slot(s)" it was true.
            #
            # NOT keyed on a particular errno. The failure measured in the field
            # was EACCES, not ENOENT or ECONNREFUSED, because the leftover socket
            # was owned by a different user than the one this runs as. Anything
            # written against "the file is missing" would have stayed silent
            # through exactly the case that produced the defect.
            why = slot_unreachable(name, listening)
            if why:
                log("WARNING: %s is listed as a slot but cannot be reached: %s"
                    % (name, why))
                log("  A visitor minted onto it gets a failed request and the"
                    " slot is consumed.")
                log("  If no session owns this name, the socket is a leftover"
                    " and can be removed.")
            elif slot_carries_own_credential(name):
                log("WARNING: %s has a credential of its own, so it will refuse"
                    " every request routed to it." % name)
                log("  On a filesystem socket that credential protects nothing:"
                    " reachability is already")
                log("  decided by the socket's mode. Turn it off with"
                    " 'hdw4s noauth %s'." % name)

    srv = listening_socket()

    while True:
        try:
            conn, _ = srv.accept()
        except OSError as e:
            log("accept failed: %s" % e)
            continue
        threading.Thread(target=serve, args=(conn, own, expected_b64),
                         daemon=True).start()


if __name__ == "__main__":
    main()
