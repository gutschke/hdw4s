def load_duration():
    """The idle window's grammar, from the one file that holds it.

    DERIVED FROM THIS FILE'S OWN LOCATION, not from a configured directory and
    not from a constant. hdw4s-duration is installed beside this script, so
    "beside me" is true in the package, in the repository and under install.sh
    --prefix alike, and it cannot select a copy belonging to some other
    installation. A constant would have been right today and wrong the first
    time somebody installed two.

    Imported rather than run: this is the component a stranger's request
    reaches, and the reader is called again on the refusal path, so a
    subprocess here would be a fork an arrival can ask for.

    NO FALLBACK, and the service fails to start without it. The whole subject
    of this file is a reader that answered a plausible number when it could not
    read the real one; a router that carried on with an internal copy of the
    grammar because the shared one was missing would be that defect with an
    apology attached.
    """
    import importlib.machinery
    import importlib.util
    # NO BYTECODE CACHE. Importing a file by path writes a __pycache__ beside
    # it, and a .pyc is a generated file that knows the path it was built from
    # -- one has already carried a home directory into this project's public
    # history. Under the shipped unit /usr is read-only and the write would
    # fail anyway, which is worse rather than better: the behaviour would then
    # differ between the package and an install.sh --prefix tree, and a stale
    # .pyc beside the source is the "which copy is running" trap with nothing
    # to warn you. Cheaper to never write one; this is imported once at start.
    sys.dont_write_bytecode = True
    path = os.path.join(os.path.dirname(os.path.abspath(__file__)),
                        "hdw4s-duration")
    loader = importlib.machinery.SourceFileLoader("hdw4s_duration", path)
    spec = importlib.util.spec_from_loader("hdw4s_duration", loader)
    mod = importlib.util.module_from_spec(spec)
    loader.exec_module(mod)
    return mod


DURATION = load_duration()

# What an idle window is when nobody has written one down. It is the value
# hdw4s.conf documents and the value the CLI's own table carries, and
# .github/checks.sh compares all three: a default that disagrees with its
# documentation is the same class of defect as a parser that disagrees with
