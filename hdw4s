#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

# shellcheck disable=SC2154  # rc is assigned inside the trap itself
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

# Exit with an explanation rather than the trap's generic complaint. The trap
# is for faults nobody anticipated; anything diagnosed here has already been
# described to the user and does not need a second, vaguer line after it.
HDW4S_VERSION='1.0'

die() {
  trap '' INT TERM QUIT HUP EXIT ERR
  printf '%s\n' "$@" >&2
  exit 1
}

CONF='/etc/hdw4s/hdw4s.conf'
SLOTS='/etc/hdw4s/instances'
DROPIN='/etc/systemd/system'

# Defaults. Every one of these may be overridden in /etc/hdw4s/hdw4s.conf.
#
# The port block is fixed and contiguous on purpose. It is reserved with the
# kernel and opened in the firewall once, at install time, so a rule can never
# lag behind which sessions happen to be running. Sessions then allocate inside
# a block that is already protected. 7300-7363 is clear of /etc/services and
# far below the ephemeral range (32768-60999), where a fixed service port would
# collide intermittently with outbound connections.
HDW4S_BASE_PORT=7300
HDW4S_BLOCK_SIZE=64

# Where an isolated session keeps its GNOME profile. Local disk by design: the
# home directory this exists to share is typically NFS, and dconf's database
# and the SQLite stores behind tracker and gvfs-metadata are documented not to
# work there.
HDW4S_PROFILE_DIR='/var/lib/hdw4s'

# shellcheck source=/dev/null
# A configuration file is a list of assignments, but nothing stops one from
# ending in a conditional that happens to be false. Sourcing then returns
# non-zero, and under -e that takes the whole program down over a file that is
# perfectly valid.
if [ -r "${CONF}" ]; then
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "${CONF}" || {
    echo "hdw4s: configuration file has a syntax error; refusing to run." >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "${CONF}" || :
fi

usage() {
  cat <<'EOF'
Usage: hdw4s <command> [arguments]

  list                    show every configured session and its current state
  show <instance>         show one session's settings and where each came from
  enable <instance>       allocate a slot for a session and start it at boot
  disable <instance>      stop a session and keep its slot reserved
  release <instance>      stop a session and give up its slot
  set [<instance>] K=V    change one setting, keeping the rest of the file
  unset [<instance>] K    comment a setting out again, restoring the default
  transport <instance> tcp|unix
                          reach a session over the network, or over a socket
  auth <instance>         require a secret from the proxy as well as an address
  noauth <instance>       stop requiring one, and say what that means
  proxy <instance>        print an nginx configuration for a session
  seed <instance> [--only <path>]...
                          copy existing settings into an isolated profile,
                          once; --only limits the copy to the named
                          home-relative paths, e.g. --only .config/dconf
  reap                    stop desktops nobody has connected to for a long time
  keyring <instance>      give a session its own keyring, unlocked at start
  --version               print the version
  firewall --apply        rewrite the package's nftables table
  firewall --check        report whether every session port is protected

An instance is a user name, optionally followed by a colon and a session
number for a second concurrent desktop belonging to the same account:

  hdw4s enable alice
  hdw4s enable alice:2

"set" and "unset" without an instance act on the defaults for every session:

  hdw4s set HDW4S_PROXIES='192.0.2.10 2001:db8::10'
  hdw4s set alice HDW4S_ISOLATION=profile

Anything the command line does not cover can still be edited by hand; these
just save a trip to an editor for the settings people change most.

See hdw4s(8) for configuration and for how to put a reverse proxy in front of
these sessions safely.
EOF
}

# --- instance names ---------------------------------------------------------

# A colon is the only separator that is safe here. systemd leaves ":" untouched
# when it escapes an instance name, so "%i" and "%I" are identical and no path
# built from either can acquire a surprise separator. A "-" would be unescaped
# by "%I" into "/", which would silently turn user "jean-luc" into "jean/luc".
# A ":" also cannot appear in a user name, because it separates the fields of
# /etc/passwd, so splitting on it can never cut a name in half.
# The name only. Split out from the account lookup below because "release" has
# to work for a session whose account has since been deleted, and must not buy
# that by giving up the check that keeps an instance name out of a file path.
split_name() {
  local inst="$1"
  user="${inst%%:*}"
  session="${inst#*:}"
  [ "${session}" != "${inst}" ] || session='1'

  case "${user}" in
    ''|*[!A-Za-z0-9._-]*)
      echo "hdw4s: '${inst}' does not name a user" >&2; return 1;;
  esac
  case "${session}" in
    ''|*[!0-9]*|0*)
      echo "hdw4s: '${inst}' has a bad session number" >&2; return 1;;
  esac
}

split_instance() {
  local inst="$1"
  split_name "${inst}" || return 1
  local uid
  uid="$(getent passwd -- "${user}" | cut -d: -f3)" || :
  [ -n "${uid}" ] || {
    echo "hdw4s: no such user: ${user}" >&2; return 1
  }
  # A session is a full desktop reachable from a browser with no
  # authentication of its own. Handing one to a system account is almost
  # certainly a mistake, and the failure mode if it is not caught is severe.
  if [ "${uid}" -lt 1000 ] && [ "${HDW4S_ALLOW_SYSTEM_USER:-}" != 'yes' ]; then
    echo "hdw4s: ${user} is a system account (uid ${uid})." >&2
    echo '  Set HDW4S_ALLOW_SYSTEM_USER=yes in the configuration if this is' >&2
    echo '  really intended.' >&2
    return 1
  fi
}

# --- slot table -------------------------------------------------------------
#
# The slot is keyed on the instance name and, once assigned, never moves. The
# obvious alternative -- deriving a port from the UID -- looks stateless but is
# not a function of the session at all: accounts that share a UID collide by
# definition, UIDs below 1000 collide after clamping, and large UIDs run off
# the end of the port range. Forty bytes of state buys a mapping that a reverse
# proxy and a firewall can both be configured against and that survives edits
# to /etc/passwd.

slot_of() {
  local inst="$1"
  [ ! -r "${SLOTS}" ] || awk -v i="${inst}" \
    '$1 !~ /^#/ && $2 == i { print $1; exit }' "${SLOTS}"
}

alloc_slot() {
  local inst="$1" idx used lock
  install -d -m0755 "$(dirname "${SLOTS}")"
  [ -e "${SLOTS}" ] || {
    printf '%s\n' \
      '# Session slots. One line per session: <index> <instance>.' \
      '# The index fixes the port (base + index); it is assigned once and does' \
      '# not move, so proxy and firewall configuration stays valid. Remove a' \
      '# line only with "hdw4s release", never by hand while a session runs.' \
      > "${SLOTS}"
  }

  # Scanning for a free slot and claiming it have to be one operation. They
  # were not, so two "hdw4s enable" runs at once -- two administrators, or a
  # configuration management pass -- read the same table, picked the same
  # index, and appended both. Every socket unit but one then failed to bind.
  exec {lock}<>"${SLOTS}"
  flock "${lock}"

  # Inside the lock, not before it: asking whether this instance already has a
  # slot and then claiming one are the same decision, and two runs for the same
  # name raced between them and were handed three different indices.
  idx="$(slot_of "${inst}")"
  if [ -n "${idx}" ]; then
    exec {lock}<&-
    echo "${idx}"
    return 0
  fi

  used="$(awk '$1 !~ /^#/ { print $1 }' "${SLOTS}" | sort -n)"
  for ((idx = 0; idx < HDW4S_BLOCK_SIZE; idx++)); do
    grep -qx "${idx}" <<<"${used}" || break
  done
  if [ "${idx}" -ge "${HDW4S_BLOCK_SIZE}" ]; then
    exec {lock}<&-
    echo "hdw4s: all ${HDW4S_BLOCK_SIZE} session slots are in use." >&2
    echo "  Raise HDW4S_BLOCK_SIZE in ${CONF} and rerun 'hdw4s firewall --apply'." >&2
    return 1
  fi
  printf '%s %s\n' "${idx}" "${inst}" >> "${SLOTS}"
  exec {lock}<&-
  echo "${idx}"
}

port_of() {
  local idx="$1"
  echo $(( HDW4S_BASE_PORT + idx ))
}

# Where the streaming server itself listens, on loopback only. The socket unit
# owns the port the outside world connects to and forwards to this one, so the
# two cannot be the same. A second block immediately above the first keeps the
# arithmetic obvious and both blocks reservable in one range.
internal_port_of() {
  local idx="$1"
  echo $(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE + idx ))
}

# --- commands ---------------------------------------------------------------

# The effective value of a setting for one session: its own file if it says
# anything, otherwise the site default, otherwise the fallback given here.
setting_of() {
  local inst="$1" key="$2" fallback="$3" v=''
  local f
  for f in "/etc/hdw4s/${inst}.conf" "${CONF}"; do
    [ -r "${f}" ] || continue
    v="$(sed -n "s/^[[:space:]]*${key}=[\"']\{0,1\}\([^\"'#]*\).*/\1/p" \
         "${f}" | tail -n1 | sed 's/[[:space:]]*$//')"
    [ -z "${v}" ] || { printf '%s' "${v}"; return 0; }
  done
  printf '%s' "${fallback}"
}

# Whether a session has a credential of its own that a proxy must present.
has_auth() {
  [ -r "/etc/hdw4s/$1.auth.cred" ] &&
  [ "$(setting_of "$1" HDW4S_AUTH none)" = 'basic' ]
}

cmd_list() {
  local idx inst port state prof auth trans unprotected=0
  printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
    INSTANCE USER PORT AUTH PROFILE TRANSPORT STATE DISPLAY
  [ -r "${SLOTS}" ] || return 0
  # Slots are reused as they are released, so the file is not in index order.
  while read -r idx inst; do
    case "${idx}" in ''|\#*) continue;; esac
    split_instance "${inst}" || continue
    port="$(port_of "${idx}")"
    state="$(systemctl show -p ActiveState --value "hdw4s@${inst}.service" \
             2>/dev/null || echo unknown)"
    [ "$(setting_of "${inst}" HDW4S_ISOLATION none)" = 'profile' ] &&
      prof='yes' || prof='no'
    trans="$(setting_of "${inst}" HDW4S_TRANSPORT tcp)"
    if has_auth "${inst}"; then
      auth='yes'
    else
      auth='NO'
      # A session on a filesystem socket is protected by permissions instead,
      # so the absence of a credential there is not the same warning.
      [ "${trans}" = 'unix' ] || unprotected=$(( unprotected + 1 ))
    fi
    printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
      "${inst}" "${user}" "${port}" "${auth}" "${prof}" "${trans}" "${state}" \
      "$(cat "/run/hdw4s/${inst}/display" 2>/dev/null || echo '-')"
  done < <(sort -n "${SLOTS}")

  [ "${unprotected}" -eq 0 ] || {
    echo
    echo "${unprotected} session(s) marked AUTH=NO have no credential of their own."
    echo '  Whatever can reach their port gets a full desktop for that'
    echo '  account, with no further question. The firewall is the only thing'
    echo '  standing in the way.'
    echo "  Add one with 'hdw4s auth <instance>'."
  }
}

cmd_show() {
  local inst="$1" idx port
  # Handled here rather than left to -e: an unhandled failure also trips the
  # ERR trap, so a mistyped name printed its own clear diagnosis and then a
  # second, vaguer line about the script failing unexpectedly.
  split_instance "${inst}" || exit 1
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] ||
    die "hdw4s: ${inst} has no slot; run 'hdw4s enable ${inst}'."
  port="$(port_of "${idx}")"
  # Say where each value came from. Guessing which of the two files won is the
  # single most common source of confusion in a layered configuration.
  echo "instance      ${inst}"
  echo "user          ${user}  (from the instance name)"
  echo "session       ${session}"
  echo "slot          ${idx}  (${SLOTS})"
  echo "port          ${port}  (${HDW4S_BASE_PORT} + slot)"
  if [ -r "/etc/hdw4s/${inst}.conf" ]; then
    echo "overrides     /etc/hdw4s/${inst}.conf"
    sed 's/^/              /' "/etc/hdw4s/${inst}.conf"
  else
    echo "overrides     none  (/etc/hdw4s/${inst}.conf does not exist)"
  fi
  local prof
  prof="$(setting_of "${inst}" HDW4S_ISOLATION none)"
  if [ "${prof}" = 'profile' ]; then
    echo "isolation     profile  (settings kept in ${HDW4S_PROFILE_DIR}/${inst})"
  else
    echo 'isolation     none  (settings kept in the home directory, shared with'
    echo '                    any other desktop using it)'
  fi
  if has_auth "${inst}"; then
    echo "auth          a credential of its own, in /etc/hdw4s/${inst}.auth.cred"
    echo "              the proxy must present it; see 'hdw4s proxy ${inst}'"
  elif [ "$(setting_of "${inst}" HDW4S_TRANSPORT tcp)" = 'unix' ]; then
    echo 'auth          none, but reached over a filesystem socket, so access'
    echo '              is decided by permissions rather than by address'
  else
    echo 'auth          NONE -- anything that can reach the port gets this'
    echo "              desktop. Add one with 'hdw4s auth ${inst}'."
  fi
  [ ! -r "/etc/hdw4s/${inst}.keyring.cred" ] ||
    echo 'keyring       its own, unlocked at start'
  echo "display       $(cat "/run/hdw4s/${inst}/display" 2>/dev/null ||
                        echo 'not running (assigned at start)')"
}

cmd_enable() {
  local inst="$1" idx
  split_instance "${inst}" || exit 1
  idx="$(alloc_slot "${inst}")"

  install -d -m0755 "${DROPIN}/hdw4s@${inst}.service.d"

  # The unit carries no User= of its own. systemd has no specifier for "the
  # part of the instance name before the colon", and "User=%i" cannot be
  # rescued by a drop-in: an invalid user name in the base unit is a fatal
  # parse error, so the unit never loads far enough for an override to apply.
  # Every instance therefore gets its account named here.
  printf '%s\n' \
    '# Written by "hdw4s enable"; edit /etc/hdw4s/'"${inst}"'.conf instead.' \
    '[Service]' \
    "User=${user}" \
    > "${DROPIN}/hdw4s@${inst}.service.d/50-user.conf"

  # ProtectSystem=strict makes the whole filesystem read-only apart from what
  # is named, and a desktop has to be able to write its own home. The unit
  # cannot name it, because there is no specifier for the home directory of the
  # account in User= -- %h is the *manager's* home, which for a system unit is
  # /root. So it is looked up here, at the one moment the account is known.
  #
  # Assuming /home would be wrong: plenty of sites keep home directories
  # somewhere else entirely, and the failure is a session that starts and then
  # cannot save anything.
  home="$(getent passwd -- "${user}" | cut -d: -f6)"
  [ -n "${home}" ] || die "hdw4s: ${user} has no home directory"
  # RequiresMountsFor belongs here too, for the same reason ReadWritePaths does.
  # The unit used to name /home, which is the one assumption this function
  # exists to avoid making: on a site with homes under /export the session was
  # not ordered after that mount and could start against an autofs stub.
  printf '%s\n' \
    '# Written by "hdw4s enable". Re-run it if the home directory moves.' \
    '[Unit]' \
    "RequiresMountsFor=${home}" \
    '' \
    '[Service]' \
    "ReadWritePaths=${home}" \
    > "${DROPIN}/hdw4s@${inst}.service.d/40-home.conf"

  # The relay forwards to wherever the session actually listens.
  install -d -m0755 "${DROPIN}/hdw4s-proxy@${inst}.service.d"
  # Only the port. The wait that goes with it lives in the unit, because a
  # multi-line ExecStartPre= is parsed as several directives and quietly
  # discarded -- systemd is not a shell and embedding one in a unit file goes
  # wrong in ways that only show up at runtime.
  printf '%s\n' \
    '# Written by "hdw4s enable".' \
    '[Service]' \
    'ExecStart=' \
    "ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:$(internal_port_of "${idx}")" \
    > "${DROPIN}/hdw4s-proxy@${inst}.service.d/50-port.conf"

  # And the session is told which loopback port to bind.
  config_write "/etc/hdw4s/${inst}.conf" 'HDW4S_PORT' "$(internal_port_of "${idx}")"

  systemctl daemon-reload
  # The socket is what gets enabled, not the session. Nothing runs until
  # somebody connects, so a desktop that is never visited never exists.
  systemctl enable --now "hdw4s-proxy@${inst}.socket"

  # Give the front door its listener. Without this the socket unit keeps the
  # filesystem socket it defaults to, while everything that reports on the
  # session -- the line below, "list", "proxy" -- describes the TCP port it
  # was assigned, and the two disagree with nobody the wiser.
  # The instance's own setting, not the global default: "enable" is documented
  # as safe to re-run, and reading the global here would quietly move a session
  # that had deliberately been put on a filesystem socket back onto the network.
  cmd_transport "${inst}" "$(setting_of "${inst}" HDW4S_TRANSPORT tcp)" >/dev/null

  echo "Session ${inst} is listening on port $(port_of "${idx}")."
  echo "Point the reverse proxy at this machine's address, port $(port_of "${idx}")."
  echo 'The desktop starts on the first connection, not now.'

  # A site can make this automatic by setting HDW4S_AUTH=basic in the shared
  # configuration; otherwise say plainly what is missing. A session with no
  # credential is not a smaller version of one with a credential -- it is one
  # where an address is the only thing between a stranger and somebody's
  # desktop, and that deserves more than a line in a manual.
  if has_auth "${inst}"; then
    :
  elif [ "$(setting_of "${inst}" HDW4S_AUTH none)" = 'basic' ]; then
    echo
    echo 'Generating the credential this session is configured to require...'
    cmd_auth "${inst}" >/dev/null
    echo "  done; see 'hdw4s proxy ${inst}' for the proxy configuration."
  else
    echo
    cat <<EOF

  This session has no credential of its own. Anything that can open a
  connection to port $(port_of "${idx}") gets a full desktop for ${user}, with no
  further question. The firewall's list of addresses is the only thing in
  the way, and an address is a weak thing to rely on by itself.

      hdw4s auth ${inst}

  adds a secret the reverse proxy presents on every request. The user never
  sees it, so there is still no login screen. Setting HDW4S_AUTH=basic in
  /etc/hdw4s/hdw4s.conf does this for every session from the start.
EOF
  fi
}

# --- editing configuration --------------------------------------------------
#
# Settings people change often should not require an editor, but the file is
# the administrator's, so an edit has to disturb as little of it as possible.
# In order of preference: change an existing assignment where it stands; else
# uncomment the documented default where it stands, so the comment above it
# still explains the value; else append. Comments, ordering, spacing and
# anything the administrator wrote are preserved in every case.

# Settings that may be set from the command line, and how to check a value.
# Anything absent from here is rejected rather than written, because a typo
# that silently does nothing is worse than an error.
declare -A SETTABLE=(
  [HDW4S_PROXIES]='any'
  [HDW4S_ISOLATION]='none|profile'
  [HDW4S_AUTH]='none|basic'
  [HDW4S_TRANSPORT]='tcp|unix'
  [HDW4S_PROXY_GROUP]='any'
  [HDW4S_ALLOW_SYSTEM_USER]='yes|no'
  [HDW4S_PROFILE_DIR]='path'
  [HDW4S_ADDR]='any'
  [HDW4S_PORT]='number'
  [HDW4S_BASE_PORT]='number'
  [HDW4S_BLOCK_SIZE]='number'
  [HDW4S_SESSION]='any'
  [HDW4S_FRAMERATE]='number'
  [HDW4S_RESIZE]='true|false'
  [HDW4S_LANG]='any'
  [HDW4S_IDLE_DAYS]='number'
  [HDW4S_MEDIA_PORTS]='proxied|direct'
  [HDW4S_ENCODER]='any'
  [SELKIES_VERSION]='any'
)

check_value() {
  local key="$1" value="$2" rule="${SETTABLE[$1]}"
  case "${rule}" in
    number) case "${value}" in ''|*[!0-9]*)
              die "hdw4s: ${key} takes a number, not '${value}'";; esac;;
    path)   case "${value}" in /*) :;;
              *) die "hdw4s: ${key} takes an absolute path, not '${value}'";; esac;;
    any)    :;;
    *)      case "|${rule}|" in
              *"|${value}|"*) :;;
              *) die "hdw4s: ${key} must be one of ${rule//|/, }, not '${value}'";;
            esac;;
  esac
}

# Quote only when the value needs it, so a file edited by hand keeps looking
# the way the administrator wrote it.
quote_value() {
  case "$1" in
    ''|*[![:alnum:]_./:-]*) printf "'%s'" "${1//\'/\'\\\'\'}";;
    *) printf '%s' "$1";;
  esac
}

config_file() {
  if [ -z "$1" ]; then echo "${CONF}"; else echo "/etc/hdw4s/$1.conf"; fi
}

config_write() {
  local file="$1" key="$2" value="$3" tmp
  install -d -m0755 /etc/hdw4s
  [ -e "${file}" ] || {
    printf '%s\n' \
      "# Settings for this session. Read after ${CONF}, and wins over it." \
      '# Edit by hand, or with "hdw4s set".' \
      '' > "${file}"
    chmod 0644 "${file}"
  }

  tmp="$(mktemp "${file}.XXXXXX")"
  chmod 0644 "${tmp}"
  KEY="${key}" VALUE="${value}" awk '
    # A note the administrator wrote at the end of the line is theirs, and
    # replacing the value is no reason to throw it away. Only treat a "#" as
    # the start of one when the text before it has balanced quotes, so a "#"
    # inside a quoted value is left alone.
    function trailing(line,   i, c, head, sq, dq) {
      for (i = length(line); i > 1; i--) {
        if (substr(line, i, 1) != "#") continue
        c = substr(line, i - 1, 1)
        if (c != " " && c != "\t") continue
        head = substr(line, 1, i - 1)
        sq = gsub(/'"'"'/, "&", head)
        dq = gsub(/"/, "&", head)
        if (sq % 2 == 0 && dq % 2 == 0) return "   " substr(line, i)
      }
      return ""
    }
    BEGIN { key = ENVIRON["KEY"]; value = ENVIRON["VALUE"]; live = 0; comment = 0 }
    # Remember the last assignment that is in effect, and the last commented
    # one, so the replacement happens where a reader would expect to find it.
    $0 ~ "^[[:space:]]*" key "=" { live = NR }
    $0 ~ "^[[:space:]]*#[[:space:]]*" key "="  { comment = NR }
    { lines[NR] = $0 }
    END {
      target = live ? live : comment
      for (i = 1; i <= NR; i++) {
        if (i == target) {
          match(lines[i], /^[[:space:]]*/)
          indent = substr(lines[i], 1, RLENGTH)
          printf "%s%s=%s%s\n", indent, key, value, trailing(lines[i])
        } else {
          print lines[i]
        }
      }
      if (!target) {
        if (NR > 0 && lines[NR] != "") print ""
        printf "%s=%s\n", key, value
      }
    }' "${file}" > "${tmp}"
  mv "${tmp}" "${file}"
}

cmd_set() {
  local inst='' file key value pair
  if [ "$#" -gt 1 ] && [ "${1#*=}" = "$1" ]; then
    inst="$1"; shift
    split_instance "${inst}"
  fi
  [ "$#" -gt 0 ] || die 'hdw4s: nothing to set'
  file="$(config_file "${inst}")"

  for pair in "$@"; do
    case "${pair}" in
      *=*) :;;
      *) die "hdw4s: '${pair}' is not KEY=VALUE";;
    esac
    key="${pair%%=*}"
    value="${pair#*=}"
    [ -n "${SETTABLE[${key}]+set}" ] ||
      die "hdw4s: ${key} cannot be set from the command line." \
          "  Settable: ${!SETTABLE[*]}" \
          "  Anything else can still be edited in ${file}."
    check_value "${key}" "${value}"
    config_write "${file}" "${key}" "$(quote_value "${value}")"
    echo "${file}: ${key}=${value}"
  done
  set_hint "${inst}" "$@"
}

cmd_unset() {
  local inst='' file key tmp
  if [ "$#" -gt 1 ]; then inst="$1"; shift; split_instance "${inst}" || exit 1; fi
  [ "$#" -eq 1 ] || die 'hdw4s: unset takes one setting'
  key="$1"
  file="$(config_file "${inst}")"
  [ -e "${file}" ] || die "hdw4s: ${file} does not exist"

  # Comment the assignment out rather than deleting the line, so the value that
  # was there stays visible and the file still documents what was tried.
  # The key goes into an awk regular expression below, so it has to be a name
  # and not a pattern. Without this, "hdw4s unset '.*'" comments out every line
  # in the file and reports success.
  case "${key}" in
    ''|*[!A-Za-z0-9_]*)
      die "hdw4s: '${key}' is not a setting name." ;;
  esac

  tmp="$(mktemp "${file}.XXXXXX")"
  chmod 0644 "${tmp}"
  KEY="${key}" awk '
    BEGIN { key = ENVIRON["KEY"] }
    $0 ~ "^[[:space:]]*" key "=" { print "#" $0; next }
    { print }' "${file}" > "${tmp}"
  if cmp -s "${file}" "${tmp}"; then
    rm -f "${tmp}"
    echo "${file}: ${key} was not set"
  else
    mv "${tmp}" "${file}"
    echo "${file}: ${key} commented out; the default applies again"
  fi
  set_hint "${inst}" "${key}="
}

# Say what has to happen for a change to take effect. Silently writing a value
# that does nothing until some unmentioned command is run is how configuration
# files get a reputation for not working.
set_hint() {
  local inst="$1" pair firewall='' session=''
  shift
  for pair in "$@"; do
    case "${pair%%=*}" in
      HDW4S_PROXIES|HDW4S_BASE_PORT|HDW4S_BLOCK_SIZE) firewall='yes';;
      *) session='yes';;
    esac
  done
  [ -z "${firewall}" ] || echo "  Run 'hdw4s firewall --apply' to use it."
  if [ -n "${session}" ]; then
    if [ -n "${inst}" ]; then
      echo "  Run 'systemctl restart hdw4s@${inst}' to use it."
    else
      echo '  Restart the affected sessions to use it.'
    fi
  fi
}

# Generate a secret, seal it to this machine, and record the drop-in that hands
# it to the session at start time. systemd keeps it in memory that is not
# swapped and exists only for the life of the unit, so it is never written to
# disk in the clear.
make_credential() {
  local inst="$1" name="$2" order="$3" cred pw
  cred="/etc/hdw4s/${inst}.${name}.cred"
  pw=''
  while [ "${#pw}" -lt 24 ]; do
    # tr removes characters before head truncates, so a single pass can come
    # out short. Loop until it is the length it is supposed to be rather than
    # hoping, because a one-in-a-thousand weak credential is the kind nobody
    # ever finds.
    pw="${pw}$(head -c48 /dev/urandom | base64 | tr -d '\n=/+')"
  done
  pw="${pw:0:24}"

  if ! ( umask 0077
         printf '%s' "${pw}" |
           systemd-creds encrypt --name="hdw4s-${name}" - "${cred}" ) 2>/dev/null
  then
    unset pw
    rm -f "${cred}"
    die 'hdw4s: could not encrypt the secret.' \
        '  systemd-creds needs to run as root and to read the machine secret' \
        '  in /var/lib/systemd/credential.secret, which it creates on first' \
        '  use. Check "systemd-creds has-tpm2" and try again as root.'
  fi

  install -d -m0755 "${DROPIN}/hdw4s@${inst}.service.d"
  printf '%s\n' \
    "# Written by \"hdw4s ${name}\"." \
    '[Service]' \
    "LoadCredentialEncrypted=hdw4s-${name}:${cred}" \
    > "${DROPIN}/hdw4s@${inst}.service.d/${order}-${name}.conf"
  systemctl daemon-reload
  printf '%s' "${pw}"
}

require_slot() {
  split_instance "$1" || exit 1
  [ -n "$(slot_of "$1")" ] ||
    die "hdw4s: $1 has no slot; run 'hdw4s enable $1' first."
  command -v systemd-creds >/dev/null ||
    die 'hdw4s: systemd-creds is not available on this system.'
}

cmd_transport() {
  local inst="$1" mode="$2" idx port group dir
  split_instance "${inst}" || exit 1
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] || die "hdw4s: ${inst} has no slot."
  port="$(port_of "${idx}")"
  dir="${DROPIN}/hdw4s-proxy@${inst}.socket.d"
  install -d -m0755 "${dir}"

  case "${mode}" in
    tcp)
      # Replace the filesystem socket the unit defaults to. An empty
      # ListenStream= first, because these accumulate rather than replace.
      printf '%s\n' \
        '# Written by "hdw4s transport".' \
        '[Socket]' \
        'ListenStream=' \
        "ListenStream=${port}" \
        > "${dir}/50-listen.conf"
      config_write "/etc/hdw4s/${inst}.conf" 'HDW4S_TRANSPORT' 'tcp'
      systemctl daemon-reload
      systemctl restart "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      echo "Session ${inst} listens on port ${port}."
      echo '  Who may connect is decided by the firewall; see HDW4S_PROXIES.'
      ;;
    unix)
      group="${HDW4S_PROXY_GROUP:-www-data}"
      getent group -- "${group}" >/dev/null ||
        die "hdw4s: no such group: ${group}" \
            '  Set HDW4S_PROXY_GROUP to the group the reverse proxy runs as.'
      # The unit already listens on the filesystem socket; only the ownership
      # has to be said, since which account runs the proxy is a local decision.
      rm -f "${dir}/50-listen.conf"
      printf '%s\n' \
        '# Written by "hdw4s transport".' \
        '[Socket]' \
        "SocketGroup=${group}" \
        > "${dir}/60-group.conf"
      config_write "/etc/hdw4s/${inst}.conf" 'HDW4S_TRANSPORT' 'unix'
      systemctl daemon-reload
      systemctl restart "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      echo "Session ${inst} is reachable at /run/hdw4s-proxy/${inst}.sock,"
      echo "readable by group ${group} only. It does not listen on the network."
      ;;
    *)
      die "hdw4s: transport must be 'tcp' or 'unix', not '${mode}'"
      ;;
  esac
}

# Stop desktops nobody has connected to for a long time.
#
# Safe to do because the socket stays listening: a stopped session is not gone,
# it is asleep, and the next connection starts it again. What is reclaimed is
# the memory of a desktop somebody opened once and never came back to.
#
# Idleness is measured by connections, not by input. A desktop with a window
# open but no typing may be running a long job somebody deliberately left; a
# desktop with nothing connected to it is not being watched by anyone. The
# browser client reconnects by itself, so an open tab counts as connected even
# across a laptop lid being shut.
cmd_reap() {
  local idx inst port established last now age stopped=0
  : "${HDW4S_IDLE_DAYS:=7}"
  [ "${HDW4S_IDLE_DAYS}" -gt 0 ] 2>/dev/null || {
    echo 'hdw4s: idle reaping is disabled (HDW4S_IDLE_DAYS=0)'
    return 0
  }
  now="$(date +%s)"
  [ -r "${SLOTS}" ] || return 0

  while read -r idx inst; do
    case "${idx}" in ''|\#*) continue;; esac
    [ "$(systemctl is-active "hdw4s@${inst}.service" 2>/dev/null)" = 'active' ] ||
      continue
    # The internal port, not the one the socket unit binds. systemd-socket-proxyd
    # holds one loopback connection to it per client, so this counts real users
    # on either transport -- whereas the external port has no connections at all
    # when the session is on a filesystem socket, which made the reaper stop
    # desktops that were in constant use.
    port="$(internal_port_of "${idx}")"
    established="$(ss -Htn state established "sport = :${port}" 2>/dev/null | wc -l)"

    local stampdir="/run/hdw4s/${inst}"
    [ -d "${stampdir}" ] || continue
    if [ "${established}" -gt 0 ]; then
      printf '%s\n' "${now}" > "${stampdir}/last-seen" 2>/dev/null || :
      continue
    fi
    if [ -r "${stampdir}/last-seen" ]; then
      last="$(cat "${stampdir}/last-seen" 2>/dev/null)"
    else
      # Never seen a connection since it started; measure from then.
      last="$(date -d "$(systemctl show -p ActiveEnterTimestamp --value \
              "hdw4s@${inst}.service")" +%s 2>/dev/null || echo "${now}")"
      printf '%s\n' "${last}" > "${stampdir}/last-seen" 2>/dev/null || :
    fi
    case "${last}" in ''|*[!0-9]*) continue;; esac
    age=$(( (now - last) / 86400 ))
    [ "${age}" -ge "${HDW4S_IDLE_DAYS}" ] || continue

    echo "hdw4s: stopping ${inst}; nothing has connected for ${age} days."
    echo '  Its files and settings are untouched, and the next connection'
    echo '  starts it again.'
    systemctl stop "hdw4s-proxy@${inst}.service" 2>/dev/null || :
    systemctl stop "hdw4s@${inst}.service" 2>/dev/null || :
    stopped=$(( stopped + 1 ))
  done < "${SLOTS}"
  [ "${stopped}" -eq 0 ] || echo "Stopped ${stopped} idle session(s)."
}

cmd_auth() {
  local inst="$1" pw
  require_slot "${inst}"
  pw="$(make_credential "${inst}" 'auth' 70)"
  config_write "/etc/hdw4s/${inst}.conf" 'HDW4S_AUTH' 'basic'

  echo "Session ${inst} will now require a credential of its own, in addition"
  echo 'to the firewall. The reverse proxy has to present it; the user never'
  echo 'sees it, so there is still no login screen.'
  echo
  echo "  hdw4s proxy ${inst}     prints an nginx block that does this"
  echo
  echo "Restart the session for this to take effect:"
  echo "  systemctl restart hdw4s@${inst}"
  unset pw
}

cmd_noauth() {
  local inst="$1"
  split_instance "${inst}" || exit 1
  [ -r "/etc/hdw4s/${inst}.auth.cred" ] ||
    [ "$(setting_of "${inst}" HDW4S_AUTH none)" = 'basic' ] || {
      echo "Session ${inst} already has no credential."
      return 0
    }
  rm -f "/etc/hdw4s/${inst}.auth.cred" \
        "${DROPIN}/hdw4s@${inst}.service.d/70-auth.conf"
  config_write "/etc/hdw4s/${inst}.conf" 'HDW4S_AUTH' 'none'
  systemctl daemon-reload
  echo "Session ${inst} no longer requires a credential."
  echo '  Whatever can reach its port now gets this desktop. That is a'
  echo '  reasonable choice when the port is reachable only over a filesystem'
  echo '  socket, or from a network nothing untrusted is on. It is not one to'
  echo '  make by accident.'
  echo "  Restart it to take effect: systemctl restart hdw4s@${inst}"
}

cmd_proxy() {
  local inst="$1" idx port cred user pw
  split_instance "${inst}" || exit 1
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] || die "hdw4s: ${inst} has no slot."
  port="$(port_of "${idx}")"
  cred="/etc/hdw4s/${inst}.auth.cred"

  # Match whichever transport the session is actually configured for; an
  # nginx block pointing at a port that is no longer listening is a confusing
  # way to spend an afternoon.
  local transport upstream
  transport='tcp'
  [ ! -r "/etc/hdw4s/${inst}.conf" ] ||
    transport="$(sed -n "s/^[[:space:]]*HDW4S_TRANSPORT=[\"']\{0,1\}\([a-z]*\).*/\1/p" \
                 "/etc/hdw4s/${inst}.conf" | tail -n1)"
  if [ "${transport}" = 'unix' ]; then
    upstream="        # A filesystem socket: who may connect is a question of
        # permissions, not of source address. Add nginx's user to the group
        # that owns it.
        proxy_pass http://unix:/run/hdw4s-proxy/${inst}.sock:;"
  else
    upstream="        proxy_pass http://HOST_RUNNING_HDW4S:${port};"
  fi

  pw=''
  if [ -r "${cred}" ]; then
    pw="$(systemd-creds decrypt --name=hdw4s-auth "${cred}" - 2>/dev/null)" || {
      echo "# Could not decrypt ${cred}; is this the machine that wrote it?" >&2
      pw=''
    }
  fi

  cat <<EOF
# nginx configuration for the hdw4s session "${inst}".
#
# Terminate TLS and authenticate your users here. Everything below assumes
# that has already happened: the session performs no user authentication and
# will hand a full desktop to whatever reaches it.

server {
    listen 443 ssl;
    server_name ${inst%%:*}.example.com;

    # ssl_certificate     /etc/ssl/certs/...;
    # ssl_certificate_key /etc/ssl/private/...;

    # ... your own authentication here: auth_request, OIDC, client certs ...

    location / {
${upstream}
        proxy_http_version 1.1;

        # The stream is a WebSocket; without these it will connect and then
        # sit there.
        proxy_set_header Upgrade    \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       \$host;
        proxy_set_header X-Real-IP  \$remote_addr;

        # A desktop is idle for long stretches and must not be timed out.
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;
EOF
  if [ -n "${pw}" ]; then
    cat <<EOF

        # Presented by the proxy, never by the user, so there is still no
        # login screen. This is what an attacker who reaches the session port
        # directly -- by spoofing the proxy's address, say -- does not have.
        proxy_set_header Authorization "Basic $(printf '%s:%s' "${user}" "${pw}" | base64 -w0)";
EOF
  else
    cat <<'EOF'

        # This session has no credential of its own, so the firewall is the
        # only thing protecting it. Run "hdw4s auth <instance>" to add one.
EOF
  fi
  cat <<'EOF'
    }
}
EOF
  unset pw
}

# Anything below these names is a cache: regenerable, frequently enormous, and
# actively unhelpful to carry across. Browsers are the reason this list is not
# just ".cache" -- Chrome keeps gigabytes of cache inside its profile
# directory, mixed in with the bookmarks and passwords that are worth keeping.
SEED_EXCLUDES=(
  'keyrings'                    # the isolated session has its own, with its own password
  'dconf/*-lock'
  '*/Cache' '*/Cache Data' '*/Code Cache' '*/GPUCache' '*/DawnCache'
  '*/GrShaderCache' '*/ShaderCache' '*/CacheStorage' '*/component_crx_cache'
  '*/Crash Reports' '*/Crashpad' '*/blob_storage'
  '*/Service Worker/CacheStorage' '*/Service Worker/ScriptCache'
  '*/optimization_guide_model_store' '*/segmentation_platform'
  # Downloaded models and component data. Regenerable, and much larger than
  # everything else put together: the on-device language model a current Chrome
  # fetches is nearly three gigabytes on its own, per profile.
  'OptGuideOnDeviceModel' '*/OptGuideOnDeviceModel'
  'OnDeviceHeadSuggestModel' '*/OnDeviceHeadSuggestModel'
  'WasmTtsEngine' '*/WasmTtsEngine'
  'Safe Browsing' '*/Safe Browsing'
  'SafetyTips' '*/SafetyTips' 'ZxcvbnData' '*/ZxcvbnData'
  'hyphen-data' '*/hyphen-data' 'SSLErrorAssistant' '*/SSLErrorAssistant'
  'Subresource Filter' '*/Subresource Filter'
  'TrustTokenKeyCommitments' '*/TrustTokenKeyCommitments'
  'MEIPreload' '*/MEIPreload' 'PKIMetadata' '*/PKIMetadata'
)

cmd_seed() {
  local inst="$1" from to pair pattern args=() copied=0 only=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --only)   [ $# -ge 2 ] || die 'hdw4s: --only needs a path.'
                only+=("$2"); shift 2;;
      --only=*) only+=("${1#--only=}"); shift;;
      *)        die "hdw4s: seed: unexpected argument '$1'";;
    esac
  done
  split_instance "${inst}" || exit 1
  [ -n "$(slot_of "${inst}")" ] ||
    die "hdw4s: ${inst} has no slot; run 'hdw4s enable ${inst}' first."

  # setting_of, not a second copy of it: reading only the instance file meant a
  # site that set HDW4S_ISOLATION=profile globally was told its sessions were
  # not isolated, which is the normal way to configure this.
  local isolation
  isolation="$(setting_of "${inst}" HDW4S_ISOLATION none)"
  [ "${isolation}" = 'profile' ] ||
    die "hdw4s: ${inst} is not an isolated session; there is nothing to seed into." \
        "  Run 'hdw4s set ${inst} HDW4S_ISOLATION=profile' first."

  # Copying out from under a running desktop would capture half-written state.
  [ "$(systemctl is-active "hdw4s@${inst}.service" 2>/dev/null)" != 'active' ] ||
    die "hdw4s: stop ${inst} first: systemctl stop hdw4s@${inst}"

  local home profile
  home="$(getent passwd -- "${user}" | cut -d: -f6)"
  profile="${HDW4S_PROFILE_DIR:-/var/lib/hdw4s}/${inst}"

  # This runs once and never merges. A profile that already has something in it
  # is a profile someone has used, and overwriting it would lose whichever of
  # the two copies happened to be newer -- silently, because nothing here can
  # tell which that is.
  for pair in config data state; do
    [ ! -d "${profile}/${pair}" ] ||
      [ -z "$(ls -A "${profile}/${pair}" 2>/dev/null)" ] ||
      die "hdw4s: ${profile}/${pair} is not empty." \
          '  Seeding copies once, into an empty profile, and never merges: there' \
          '  is no way to tell which of two copies of a setting is the newer one.' \
          "  Remove the profile first if you really mean to start it over."
  done

  for pattern in "${SEED_EXCLUDES[@]}"; do args+=(--exclude="${pattern}"); done

  echo "Copying settings from ${home} into ${profile}."
  for pair in "config:.config" "data:.local/share" "state:.local/state"; do
    to="${profile}/${pair%%:*}"
    from="${home}/${pair#*:}"
    [ -d "${from}" ] || continue

    # Without --only the whole tree is copied. With it, only the named entries
    # are, which is the usual case for an account that has been in use for
    # years: most of what has collected in there belongs to programs that will
    # never run in this session, and copying it forward just carries the
    # accumulation into a second place.
    local members=() entry rel
    if [ "${#only[@]}" -gt 0 ]; then
      for entry in "${only[@]}"; do
        rel="${entry#./}"
        case "${rel}" in "${pair#*:}"/*) ;; *) continue;; esac
        rel="${rel#"${pair#*:}"/}"
        if [ -e "${from}/${rel}" ] || [ -L "${from}/${rel}" ]; then
          members+=("./${rel}")
        else
          echo "  ${entry}: not there, skipped" >&2
        fi
      done
      [ "${#members[@]}" -gt 0 ] || continue
    else
      members=(.)
    fi

    install -d -m0700 "${to}"
    # tar rather than cp, because the exclusions are the whole point and cp has
    # no way to express them.
    if tar -C "${from}" -cf - "${args[@]}" --warning=no-file-ignored \
           "${members[@]}" 2>/dev/null |
       tar -C "${to}" -xf - 2>/dev/null; then
      printf '  %-14s %s\n' "${pair#*:}" "$(du -sh "${to}" 2>/dev/null | cut -f1)"
      copied=$(( copied + 1 ))
    else
      echo "  ${pair#*:}: copy failed" >&2
    fi
  done
  chown -R "${user}" "${profile}" 2>/dev/null || :

  [ "${copied}" -gt 0 ] || die 'hdw4s: nothing was found to copy.'
  cat <<EOF

This was a one-time snapshot, not a link. From now on the two are separate:
a change made in one will not appear in the other, and running this again is
refused rather than silently overwriting whichever copy is newer.

Caches were left behind on purpose, browser caches included -- they are
regenerable and are usually most of the size.

Saved passwords were not copied. The session has its own keyring with its own
password; see 'hdw4s keyring ${inst}'.
EOF
}

cmd_keyring() {
  local inst="$1"
  require_slot "${inst}"
  make_credential "${inst}" 'keyring' 60 >/dev/null

  echo "Session ${inst} now has its own keyring, unlocked automatically."
  echo "It is separate from the account's login keyring, so passwords saved in"
  echo "one are not visible in the other."
  echo "Restart the session for this to take effect:"
  echo "  systemctl restart hdw4s@${inst}"
}

cmd_disable() {
  local inst="$1"
  split_instance "${inst}" || exit 1
  systemctl disable --now "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
  systemctl stop "hdw4s-proxy@${inst}.service" 2>/dev/null || :
  systemctl stop "hdw4s@${inst}.service" 2>/dev/null || :
  echo "Session ${inst} stopped. Its slot is still reserved;"
  echo "use 'hdw4s release ${inst}' to give it up."
}

cmd_release() {
  local inst="$1" tmp
  # An account that has since been deleted still holds a slot, and its port
  # stays open in the firewall. Refusing to release it because the account is
  # gone leaves editing the table by hand as the only way out -- which its own
  # header tells the administrator never to do. The name is still checked: it
  # is interpolated into the paths this function removes.
  split_name "${inst}" || exit 1
  split_instance "${inst}" || :
  systemctl disable --now "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
  systemctl stop "hdw4s-proxy@${inst}.service" "hdw4s@${inst}.service" 2>/dev/null || :
  rm -rf "${DROPIN}/hdw4s@${inst}.service.d" \
         "${DROPIN}/hdw4s-proxy@${inst}.service.d" \
         "${DROPIN}/hdw4s-proxy@${inst}.socket.d"
  rm -f "/etc/hdw4s/${inst}.keyring.cred" "/etc/hdw4s/${inst}.auth.cred"
  if [ -r "${SLOTS}" ]; then
    tmp="$(mktemp "${SLOTS}.XXXXXX")"
    awk -v i="${inst}" '$1 ~ /^#/ || $2 != i' "${SLOTS}" > "${tmp}"
    chmod 0644 "${tmp}"
    mv "${tmp}" "${SLOTS}"
  fi
  systemctl daemon-reload
  echo "Session ${inst} released. Left in place: its profile under"
  echo "${HDW4S_PROFILE_DIR}/${inst}, and its settings in"
  echo "/etc/hdw4s/${inst}.conf -- so that re-enabling it restores them. The"
  echo "slot, and with it the port, is not reserved and may go to someone else;"
  echo "enabling again rewrites the port that conf file records."
}

case "${1:-}" in
  list)     shift; cmd_list "$@";;
  show)     shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_show "$@";;
  enable)   shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_enable "$@";;
  disable)  shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_disable "$@";;
  keyring)  shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_keyring "$@";;
  seed)     shift; [ $# -ge 1 ] || { usage >&2; exit 2; }; cmd_seed "$@";;
  reap)     shift; cmd_reap "$@";;
  auth)     shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_auth "$@";;
  noauth)   shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_noauth "$@";;
  transport) shift; [ $# -eq 2 ] || { usage >&2; exit 2; }; cmd_transport "$@";;
  proxy)    shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_proxy "$@";;
  set)      shift; cmd_set "$@";;
  unset)    shift; cmd_unset "$@";;
  release)  shift; [ $# -eq 1 ] || { usage >&2; exit 2; }; cmd_release "$@";;
  firewall) shift; exec /usr/lib/hdw4s/hdw4s-firewall "$@";;
  --version) echo "hdw4s ${HDW4S_VERSION}";;
  -h|--help|help|'') usage;;
  *) echo "hdw4s: unknown command '$1'" >&2; usage >&2
     trap '' INT TERM QUIT HUP EXIT ERR; exit 2;;
esac
