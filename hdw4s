#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
# errtrace, so the ERR trap below fires inside FUNCTIONS too. Without it bash
# does not inherit an ERR trap into a function body, and every command this
# program runs is in one -- so the line recorder stayed unset and the diagnosis
# read "line ?", which is what the first version of this fix actually shipped
# until it was tested against a fault injected into a function.
set -o nounset -o pipefail -o errtrace

# An unexpected fault reports itself at ERROR priority, not at the default.
#
# This used to be a plain echo to stderr, which systemd logs at info -- and
# hdw4s-reaper.service sets LogLevelMax=warning to keep several hundred routine
# lines a day out of the journal. So the reaper failed with NOTHING said about
# why: the unit's own threshold discarded the only explanation. The unit's
# comment called that an accepted cost and offered "run it by hand" as the
# mitigation, which is precisely what does not work for an INTERMITTENT fault --
# by hand it succeeds, which is what makes it intermittent.
#
# The rule this is an instance of: AN ERROR MUST NOT BE LOGGED BELOW THE
# THRESHOLD ITS OWN UNIT SETS, or the unit silences its own diagnosis. "<3>" is
# the priority systemd reads off the front of a line.
#
# The failing command is deliberately NOT included. BASH_COMMAND would carry the
# arguments with it, and this program handles credentials; a diagnostic that
# helpfully copies a secret into the journal is a worse bug than the one it is
# helping with. The line number is enough to find the command in the source.
# The failing line is captured by a trap of its OWN, because "${LINENO}" read
# inside a trap body describes the trap's own text and not the fault: measured,
# it reports line 1 for a command that failed on line 1532, which would send the
# next reader to the shebang. "${BASH_LINENO[0]}" reports 0 here and is no better.
# A separate ERR trap is the one place the real line is visible. It must not share
# a handler with the reporting trap below, since bash keeps only one per signal --
# which is why ERR is deliberately absent from that trap's list. Under "set -e" a
# failing command fires ERR and then exits, so EXIT still does the reporting.
# Latched at the FIRST ERR, not the last. With errtrace the trap fires once per
# frame as the failure propagates outward, so assigning unconditionally records
# the CALL SITE rather than the fault -- measured: line 9 for a command failing
# on line 7. Under "set -e" the first unhandled failure is the fatal one, and a
# failure that is handled ("|| :") never fires ERR at all, so the first sighting
# is the right one.
__errln='?'
trap '[ "${__errln}" != "?" ] || __errln="${LINENO}"' ERR
# shellcheck disable=SC2154  # rc is assigned inside the trap itself
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      if [ "${rc}" -ne 0 ]; then
        if [ -n "${JOURNAL_STREAM:-}" ]; then
          printf "<3>%s\n" "${0}: failed unexpectedly (status ${rc}, line ${__errln})" >&2
        else
          echo "Script ${0} failed unexpectedly" >&2
        fi
      fi
      exit "${rc}"' INT TERM QUIT HUP EXIT

# Exit with an explanation rather than the trap's generic complaint. The trap
# is for faults nobody anticipated; anything diagnosed here has already been
# described to the user and does not need a second, vaguer line after it.
HDW4S_VERSION='2.4.0'

die() {
  trap '' INT TERM QUIT HUP EXIT ERR
  printf '%s\n' "$@" >&2
  exit 1
}

# The same, for a fault that has already explained itself. A rejected instance
# name prints why and then stops; the trap's generic line underneath turned a
# refusal the user can act on into what looks like a bug in the tool.
fail() {
  trap '' INT TERM QUIT HUP EXIT ERR
  exit 1
}

# Wrong arguments are the user's mistake, not this program's fault. Without
# standing the trap down first they exited through it, so every mistyped
# command printed the usage text and then "Script hdw4s failed unexpectedly"
# underneath it -- which reads as a crash, and sends somebody looking for a bug
# in the tool instead of at the line they just typed.
# The command that does own a setting, spelled the way it is actually invoked.
# Not "hdw4s <owner> <instance> <value>" for all of them: turning authentication
# off is a different command rather than a different argument, so that form sent
# people to "hdw4s auth NAME none", which takes one argument too many and failed
# in front of them. A suggestion nobody can paste is worse than none.
owning_command() {
  case "$1:$3" in
    HDW4S_AUTH:none) printf 'hdw4s noauth %s' "$2";;
    HDW4S_AUTH:*)    printf 'hdw4s auth %s' "$2";;
    *)               printf 'hdw4s %s %s%s' "${OWNED_BY[$1]}" "$2" "${3:+ $3}";;
  esac
}

usage_error() {
  usage >&2
  trap '' INT TERM QUIT HUP EXIT ERR
  exit 2
}

# Every path this program writes goes through these, so that a test can point
# them somewhere disposable. Without that the tests read -- and would sooner or
# later write -- the real configuration of the machine they run on.
ETCDIR="${HDW4S_ETCDIR:-/etc/hdw4s}"
# Where this package's own helpers live.
CONF="${ETCDIR}/hdw4s.conf"
SLOTS="${ETCDIR}/instances"
DROPIN='/etc/systemd/system'
# Where the reaper records when it last saw a connection. Overridable for the
# same reason as the paths above, and it was the one write path that was not:
# hardcoded, it made every behaviour of cmd_reap untestable, which is why a
# message that was wrong for half the session types survived unnoticed.
REAPDIR="${HDW4S_REAP_STAMP_DIR:-/run/hdw4s-reap}"
# The router's own runtime directory, where it records the last request it
# ACCEPTED for each slot. The reaper reads that record and never writes it.
#
# Same environment variable hdw4s-demux reads, deliberately: two spellings of
# one path is two paths as soon as either is edited.
POOLDIR="${HDW4S_DEMUX_STATE:-/run/hdw4s-demux}"
# The runtime tree a session publishes its own live state in. Overridable for
# the same reason, and needed alongside REAPDIR rather than instead of it: the
# reaper reads the stamp only for an instance whose directory here exists, so
# pointing the stamps somewhere disposable and leaving this one absolute still
# leaves every reaper decision unreachable from a test. Two overrides, because
# the reaper consults two trees.
#
# Filesystem paths only. The "/run/..." that appear in text printed for an
# operator -- the nginx block, the socket named by "hdw4s show" -- stay literal:
# they describe the machine rather than this process, and a test override must
# not rewrite what a human is told to type.
RUNDIR="${HDW4S_RUNDIR:-/run}"

# Defaults. Every one of these may be overridden in /etc/hdw4s/hdw4s.conf.
#
# The port block is fixed and contiguous on purpose. It is reserved with the
# kernel and opened in the firewall once, at install time, so a rule can never
# lag behind which sessions happen to be running. Sessions then allocate inside
# a block that is already protected. 7300-7363 is clear of /etc/services and
# far below the ephemeral range (32768-60999), where a fixed service port would
# collide intermittently with outbound connections.
HDW4S_BASE_PORT=7300
HDW4S_BLOCK_SIZE=64

# Where an isolated session keeps its GNOME profile. Local disk by design: the
# home directory this exists to share is typically NFS, and dconf's database
# and the SQLite stores behind tracker and gvfs-metadata are documented not to
# work there.
HDW4S_PROFILE_DIR='/var/lib/hdw4s'

# shellcheck source=/dev/null
# A configuration file is a list of assignments, but nothing stops one from
# ending in a conditional that happens to be false. Sourcing then returns
# non-zero, and under -e that takes the whole program down over a file that is
# perfectly valid.
if [ -r "${CONF}" ]; then
  f="${CONF}"
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "${CONF}" || {
    echo "hdw4s: ${f} has a syntax error (above); refusing to run on a" >&2
    echo '  configuration that would be applied only as far as the error.' >&2
    echo '  Edit it by hand -- "hdw4s set" and "hdw4s unset" read the same' >&2
    echo '  file and are unavailable until it parses.' >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "${CONF}" || :
fi

usage() {
  cat <<'EOF'
Usage: hdw4s <command> [arguments]

  list                    show every configured session and its current state
  check                   report anything that stops this machine handing out a
                          desktop, and any running session that is not
                          publishing the identity a returning tab compares
                          against
  show <instance>         show one session's settings and where each came from
  enable <instance>       allocate a slot for a session and arm its front door
  disable <instance>      stop a session and keep its slot reserved
  release <instance>      stop a session and give up its slot
  set [<instance>] K=V    change one setting, keeping the rest of the file
  unset [<instance>] K    comment a setting out again, restoring the default
  transport <instance> tcp|unix
                          reach a session over the network, or over a socket
  auth <instance>         require a secret from the proxy as well as an address
  noauth <instance>       stop requiring one, and say what that means
  proxy <instance>        print an nginx configuration for a session
  seed <instance> [--only <path>]...
                          copy existing settings into an isolated profile,
                          once; --only limits the copy to the named
                          home-relative paths, e.g. --only .config/dconf
  reap                    stop desktops nobody has connected to for a long time
  keyring <instance>      give a session its own keyring, unlocked at start
  --version               print the version
  firewall --apply        rewrite the package's nftables table
  firewall --check        report whether every session port is protected
  firewall --print        print the ruleset that --apply would load
  firewall --restore      reload the table if something else flushed it

An instance is a user name. An account has one desktop:

  hdw4s enable alice

"set" and "unset" without an instance act on the defaults for every session:

  hdw4s set HDW4S_PROXIES='192.0.2.10 2001:db8::10'
  hdw4s set alice HDW4S_ISOLATION=profile

Anything the command line does not cover can still be edited by hand; these
just save a trip to an editor for the settings people change most.

See hdw4s(8) for configuration and for how to put a reverse proxy in front of
these sessions safely.
EOF
}

# --- instance names ---------------------------------------------------------

# An instance is an account name, and nothing else: one desktop per account.
#
# Versions up to 1.1 also accepted "<user>:<session>" for a second concurrent
# desktop belonging to the same account. That form is no longer created.
#
# It was withdrawn for what it cost to reason about rather than because it broke:
# two instances against one home directory, one keyring and one set of
# application single-instance locks, to deliver something that is better had by
# giving the account a desktop on a second machine -- a case this package
# supports properly, and the reason HDW4S_ISOLATION=profile exists.
#
# Instances created by an earlier version keep working and can still be shut
# down and released; see split_legacy_name below. Nothing creates a new one.
#
# Why a colon was the separator, kept because it still governs those instances
# and any future change here: systemd leaves ":" untouched when it escapes an
# instance name, so "%i" and "%I" are identical and no path built from either
# can acquire a surprise separator. A "-" would be unescaped by "%I" into "/",
# which would silently turn user "jean-luc" into "jean/luc". A ":" also cannot
# appear in a user name, because it separates the fields of /etc/passwd, so
# splitting on it can never cut a name in half.
#
# The name only. Split out from the account lookup below because "release" has
# to work for a session whose account has since been deleted, and must not buy
# that by giving up the check that keeps an instance name out of a file path.
split_name() {
  local inst="$1"
  case "${inst}" in
    *:*)
      echo "hdw4s: '${inst}' names a second session for one account." >&2
      echo '  An account has one desktop. Instances of the form' >&2
      echo '  "<user>:<session>" are no longer created; an existing one can' >&2
      echo "  still be shut down with 'hdw4s release ${inst}'." >&2
      return 1;;
  esac
  split_legacy_name "${inst}"
}

# The same checks, with the retired "<user>:<session>" form still accepted.
#
# Only "release" uses this, and it has to: an instance enabled by an earlier
# version owns a slot, a port the firewall opens, drop-ins and credentials, and
# a name the strict grammar rejects. Refusing it would leave editing the slot
# table by hand -- which its own header tells the administrator never to do --
# as the only way to clean the instance up. "release" stops the units itself, so
# this one exception is enough to retire such an instance completely; no other
# command needs to understand the old form.
split_legacy_name() {
  local inst="$1"
  user="${inst%%:*}"
  session="${inst#*:}"
  [ "${session}" != "${inst}" ] || session='1'

  case "${user}" in
    ''|*[!A-Za-z0-9._-]*)
      echo "hdw4s: '${inst}' does not name a user" >&2; return 1;;
  esac
  case "${session}" in
    ''|*[!0-9]*|0*)
      echo "hdw4s: '${inst}' has a bad session number" >&2; return 1;;
  esac
}

split_instance() {
  local inst="$1"
  split_name "${inst}" || return 1
  local uid
  uid="$(getent passwd -- "${user}" | cut -d: -f3)" || :
  [ -n "${uid}" ] || {
    echo "hdw4s: no such user: ${user}" >&2; return 1
  }
  # A session is a full desktop reachable from a browser with no
  # authentication of its own. Handing one to a system account is almost
  # certainly a mistake, and the failure mode if it is not caught is severe.
  if [ "${uid}" -lt 1000 ] && [ "${HDW4S_ALLOW_SYSTEM_USER:-}" != 'yes' ]; then
    echo "hdw4s: ${user} is a system account (uid ${uid})." >&2
    echo '  Set HDW4S_ALLOW_SYSTEM_USER=yes in the configuration if this is' >&2
    echo '  really intended.' >&2
    return 1
  fi
}

# --- slot table -------------------------------------------------------------
#
# The slot is keyed on the instance name and, once assigned, never moves. The
# obvious alternative -- deriving a port from the UID -- looks stateless but is
# not a function of the session at all: accounts that share a UID collide by
# definition, UIDs below 1000 collide after clamping, and large UIDs run off
# the end of the port range. Forty bytes of state buys a mapping that a reverse
# proxy and a firewall can both be configured against and that survives edits
# to /etc/passwd.

slot_of() {
  local inst="$1"
  [ ! -r "${SLOTS}" ] || awk -v i="${inst}" \
    '$1 !~ /^#/ && $2 == i { print $1; exit }' "${SLOTS}"
}

# The third column of the slot table. Every value the product writes is here,
# because a reader that tests one value against a literal cannot be audited for
# the values it does not mention -- which is how a fourth type came to mean
# "named desktop" at SEVENTEEN separate sites at once -- twelve here, one in
# the router, two in each installer. Add a type here and the
# two predicates below are the only places that decide what it behaves like.
#
#   desktop    one person's long-lived session, at their own hostname
#   ephemeral  a pooled slot a stranger is handed at the well-known hostname
#   template   the administrator's authoring slot: ephemeral in every mechanical
#              respect -- same unit, tmpfs home at /home/user, namespaced passwd,
#              filesystem socket, no per-session password -- and NOT in the pool
#
# "unreadable" is not a type. It is what type_of() answers when the table is
# there and could not be read, and it exists because the old code answered
# "desktop" to that -- a fabricated answer to a question that had none. ABSENT
# IS NOT EQUAL: every test below reads "is it ephemeral", so the fabrication
# made each one answer NO and fail open, most damagingly at cmd_transport,
# where it permits TCP for what may well be a pooled slot.
SESSION_TYPES='desktop ephemeral template'

# What kind of session an instance is. Recorded in the table rather than guessed
# from the name, because six readers need the answer long after "hdw4s enable"
# has exited, and a name prefix would make a configurable string load-bearing in
# all of them. A row written by an older version has two fields and means
# "desktop", which is what every session was when it was written.
type_of() {
  local t=''
  # -e and not -r is precisely "the table exists and I could not look at it".
  # A table that does not exist at all is a machine with no slots, and an
  # instance with no row there is untyped: "desktop" is information, not a guess.
  if [ -e "${SLOTS}" ]; then
    [ -r "${SLOTS}" ] || { echo 'unreadable'; return 0; }
    t="$(awk -v i="${1}" '$1 !~ /^#/ && $2 == i { print $3; exit }' "${SLOTS}")"
  fi
  echo "${t:-desktop}"
}

# Does this TYPE get the ephemeral machinery? Takes the type and not the
# instance, because cmd_reap already has the type in hand from its own read of
# the table and a second lookup there would be a second chance to disagree.
#
# THE QUESTION IS DELIBERATELY NOT "is it ephemeral". Seventeen call sites ask
# that, and for the authoring slot the honest answer is yes to sixteen of them
# and no to the one that matters -- pool membership, which is in_ephemeral_pool()
# below and lives in the router. Splitting them means a site added later has to
# NAME which of the two it wants, instead of inheriting the wrong one from a
# string literal.
#
# It dies rather than returning false on "unreadable" so that the refusal is
# seen. Returning false would be the fail-open this whole comment is about, and
# it would be silent. The message names the FILE, because that is where the
# repair is; naming the slot sends somebody to look at a session that is fine.
ephemeral_shaped() {
  case "${1}" in
    ephemeral|template) return 0 ;;
    unreadable)
      die "hdw4s: cannot read ${SLOTS}, so what kind of session this is is unknown." \
          '  Refusing rather than guessing: every check in this program asks' \
          '  whether a slot is ephemeral, and a guess of "desktop" would turn' \
          '  each one off at once -- putting a pooled slot on a TCP port, giving' \
          '  it a password that means nothing, and binding its relay to a unit' \
          '  that will never start. Fix the file and run this again.' ;;
    *) return 1 ;;
  esac
}

# Is this TYPE pool capacity -- a slot a visitor may be minted onto? Only
# "ephemeral". The router owns the operative copy of this question
# (hdw4s-demux's ephemeral_slots(), which is what actually decides a mint);
# this one exists so the CLI answers it the same way and so that the two
# questions have different names here as well.
in_ephemeral_pool() {
  [ "${1}" = 'ephemeral' ]
}

# The systemd unit that runs a given instance's desktop. One place, because a
# second kind of session means every "hdw4s@${inst}" spelled out by hand is a
# site that silently acts on the wrong unit -- and acting on the wrong unit is
# quiet: it starts something, so nothing reports an error.
unit_of() {
  if ephemeral_shaped "$(type_of "${1}")"; then
    echo "hdw4s-ephemeral@${1}.service"
  else
    echo "hdw4s@${1}.service"
  fi
}

# Where that unit's drop-ins live. Writing one into the other unit's directory is
# the failure this exists to prevent: it lands, systemd never reads it, and the
# session fails for a reason the file would have fixed.
dropin_of() {
  echo "${DROPIN}/$(unit_of "${1}").d"
}

# IS ANYTHING BOUND, as opposed to a file existing where a socket should be?
# The two came apart in the field: an orphaned socket file was enumerated as a
# live slot while connect() was refused, and the pool handed a visitor a name
# nothing was listening on. "ls" answers a question about the filesystem; these
# ask the kernel, which is the authority for "would a connection be accepted".
#
# Both are written as a FILTER rather than as a search through ss's output,
# because a command that greps for its own argument is a trap this tree has paid
# for more than once. An empty answer here means "nothing bound", and the empty
# answer was seen beside a known positive on the same machine before either was
# believed: /run/hdw4s-proxy/ephemeral0.sock listed, a name that does not exist
# empty.
unix_listener() {
  [ -n "$(ss -H -lx "src = $1" 2>/dev/null || :)" ]
}
tcp_listener() {
  [ -n "$(ss -H -lnt "sport = :$1" 2>/dev/null || :)" ]
}

alloc_slot() {
  local inst="$1" type="${2:-desktop}" idx used lock
  install -d -m0755 "$(dirname "${SLOTS}")"
  [ -e "${SLOTS}" ] || {
    printf '%s\n' \
      '# Session slots. One line per session: <index> <instance> <type>.' \
      '# The index fixes the port (base + index); it is assigned once and does' \
      '# not move, so proxy and firewall configuration stays valid. Remove a' \
      '# line only with "hdw4s release", never by hand while a session runs.' \
      > "${SLOTS}"
  }

  # Scanning for a free slot and claiming it have to be one operation. They
  # were not, so two "hdw4s enable" runs at once -- two administrators, or a
  # configuration management pass -- read the same table, picked the same
  # index, and appended both. Every socket unit but one then failed to bind.
  exec {lock}<>"${SLOTS}"
  flock "${lock}"

  # Inside the lock, not before it: asking whether this instance already has a
  # slot and then claiming one are the same decision, and two runs for the same
  # name raced between them and were handed three different indices.
  idx="$(slot_of "${inst}")"
  if [ -n "${idx}" ]; then
    exec {lock}<&-
    echo "${idx}"
    return 0
  fi

  used="$(awk '$1 !~ /^#/ { print $1 }' "${SLOTS}" | sort -n)"
  for ((idx = 0; idx < HDW4S_BLOCK_SIZE; idx++)); do
    grep -qx "${idx}" <<<"${used}" || break
  done
  if [ "${idx}" -ge "${HDW4S_BLOCK_SIZE}" ]; then
    exec {lock}<&-
    echo "hdw4s: all ${HDW4S_BLOCK_SIZE} session slots are in use." >&2
    echo "  Raise HDW4S_BLOCK_SIZE in ${CONF} and rerun 'hdw4s firewall --apply'." >&2
    return 1
  fi
  # The table is the authority every other reader trusts, so an unrecognised
  # type must not reach it. It would be carried verbatim by the router's parser
  # and then fall through the default arm of every reader here -- which is the
  # named-desktop arm, so a typo'd "ephemerel" would be given a real home, a
  # password that means something and a TCP port, and nothing would report it.
  # Refused at the one place that WRITES the column rather than guarded at the
  # seventeen places that read it.
  case " ${SESSION_TYPES} " in
    *" ${type} "*) ;;
    *) exec {lock}<&-
       echo "hdw4s: '${type}' is not a session type; known types are ${SESSION_TYPES}." >&2
       return 1;;
  esac
  printf '%s %s %s\n' "${idx}" "${inst}" "${type}" >> "${SLOTS}"
  exec {lock}<&-
  echo "${idx}"
}

port_of() {
  local idx="$1"
  echo $(( HDW4S_BASE_PORT + idx ))
}

# Where the streaming server itself listens, on loopback only. The socket unit
# owns the port the outside world connects to and forwards to this one, so the
# two cannot be the same. A second block immediately above the first keeps the
# arithmetic obvious and both blocks reservable in one range.
internal_port_of() {
  local idx="$1"
  echo $(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE + idx ))
}

# --- commands ---------------------------------------------------------------

# The effective value of a setting for one session: its own file if it says
# anything, otherwise the site default, otherwise the fallback given here.
# The value and the file it came from, tab-separated. Which of the two files
# won is the single most common source of confusion in a layered
# configuration, so the answer is computed once, here, and both the plain
# lookup and "show" read it from the same place.
setting_with_source() {
  local inst="$1" key="$2" fallback="$3" v=''
  local f
  # An ephemeral slot takes several of its settings from its unit rather than
  # from a conf file -- the profile directory and the isolation mode among them
  # -- and Environment= in the unit beats the EnvironmentFile= lines above it, so
  # that is the value in force. Reading only the conf files made this command
  # report a profile under /var/lib/hdw4s that has never existed for such a
  # session, and an isolation mode it does not run with. Ask systemd rather than
  # keeping a second copy of the unit's values here, which would be one more
  # thing able to disagree with it.
  if ephemeral_shaped "$(type_of "${inst}")"; then
    v="$(systemctl show "$(unit_of "${inst}")" -p Environment --value 2>/dev/null |
           tr ' ' '\n' | sed -n "s/^${key}=//p" | tail -n1)"
    [ -z "${v}" ] || { printf '%s\t%s' "${v}" "$(unit_of "${inst}")"; return 0; }
  fi
  for f in "${ETCDIR}/${inst}.conf" "${CONF}"; do
    [ -r "${f}" ] || continue
    v="$(sed -n "s/^[[:space:]]*${key}=[\"']\{0,1\}\([^\"'#]*\).*/\1/p" \
         "${f}" | tail -n1 | sed 's/[[:space:]]*$//')"
    [ -z "${v}" ] || { printf '%s\t%s' "${v}" "${f}"; return 0; }
  done
  printf '%s\t' "${fallback}"
}

setting_of() {
  local r
  r="$(setting_with_source "$1" "$2" "$3")"
  printf '%s' "${r%%$'\t'*}"
}

# Where a session's profile lives. hdw4s-session honours the instance file, so
# everything that names this directory has to read it the same way: "seed" used
# the globally sourced variable and so populated a directory the session would
# never look at, saying it had seeded the profile.
profile_dir_of() {
  setting_of "$1" HDW4S_PROFILE_DIR "${HDW4S_PROFILE_DIR:-/var/lib/hdw4s}"
}

# Whether a session has a credential of its own that a proxy must present.
#
# Existence, not readability. The credential is root-only, so asking whether we
# can read it answered "no credential" for every unprivileged caller -- and
# "list" then counted the session as unprotected and printed the warning about
# the firewall being the only thing in the way, about a session that was in fact
# authenticated. A security report that depends on who is reading it is worse
# than none. Anything that needs the value itself, rather than the fact, checks
# readability where it reads.
# Re-point an existing credential at the unit's drop-in directory, without
# rotating it. "hdw4s enable" is documented as safe to re-run, and a session that
# already has a credential must not be handed a new one -- the reverse proxy is
# configured with the old one and would start answering 401. But the drop-in can
# legitimately be absent: it was written under a different unit name before the
# session's type was recorded, or removed by "hdw4s release".
link_credential() {
  local inst="$1" name="$2" order="$3" cred="${ETCDIR}/${1}.${2}.cred"
  [ -e "${cred}" ] || return 0
  install -d -m0755 "$(dropin_of "${inst}")"
  printf '%s\n' \
    "# Written by \"hdw4s ${name}\"." \
    '[Service]' \
    "LoadCredentialEncrypted=hdw4s-${name}:${cred}" \
    > "$(dropin_of "${inst}")/${order}-${name}.conf"
}

has_auth() {
  [ -e "${ETCDIR}/$1.auth.cred" ] &&
  [ "$(setting_of "$1" HDW4S_AUTH none)" = 'basic' ]
}

cmd_list() {
  local idx inst port state prof auth trans unprotected=0 orphaned=0 legacy=0
  printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
    INSTANCE USER PORT AUTH PROFILE TRANSPORT STATE DISPLAY
  [ -r "${SLOTS}" ] || return 0
  # Slots are reused as they are released, so the file is not in index order.
  # The trailing "_" absorbs the type field, and every field after it. Without a
  # variable of its own the rest of the line lands in "inst", which does not drop
  # the type so much as rename the session -- and the name is the key every other
  # reader looks the slot up by. The type itself is read by type_of() straight
  # from the table, so nothing here needs to hold it.
  while read -r idx inst _; do
    case "${idx}" in ''|\#*) continue;; esac
    port="$(port_of "${idx}")"
    # A slot whose account has been deleted, or which names a system account,
    # used to be skipped in silence -- so it vanished from the table and from
    # the AUTH=NO count while still holding its port, which the firewall still
    # opens. This is the command an administrator uses to find out what is
    # reachable, so it has to account for every slot, including the ones it
    # cannot say much about.
    # A second session for one account, from a version that still created
    # them. It is not orphaned -- the account exists and the desktop may well
    # be running -- so saying so would send an administrator looking for a
    # deleted user. It is reported as what it is, and the footer says what to
    # do about it.
    case "${inst}" in
      *:*)
        printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
          "${inst}" "${inst%%:*}" "${port}" '-' '-' '-' 'legacy' '-'
        legacy=$(( legacy + 1 ))
        continue;;
    esac
    if ! split_instance "${inst}" 2>/dev/null; then
      printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
        "${inst}" '(none)' "${port}" '-' '-' '-' 'orphaned' '-'
      orphaned=$(( orphaned + 1 ))
      continue
    fi
    state="$(systemctl show -p ActiveState --value "$(unit_of "${inst}")" \
             2>/dev/null || echo unknown)"
    [ "$(setting_of "${inst}" HDW4S_ISOLATION none)" = 'profile' ] &&
      prof='yes' || prof='no'
    trans="$(setting_of "${inst}" HDW4S_TRANSPORT tcp)"
    if has_auth "${inst}"; then
      auth='yes'
    else
      auth='NO'
      # A session on a filesystem socket is protected by permissions instead,
      # so the absence of a credential there is not the same warning.
      [ "${trans}" = 'unix' ] || unprotected=$(( unprotected + 1 ))
    fi
    printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
      "${inst}" "${user}" "${port}" "${auth}" "${prof}" "${trans}" "${state}" \
      "$(cat "${RUNDIR}/hdw4s/${inst}/display" 2>/dev/null || echo '-')"
  done < <(sort -n "${SLOTS}")

  [ "${orphaned}" -eq 0 ] || {
    echo
    echo "${orphaned} slot(s) marked orphaned name an account that no longer"
    echo '  exists, or a system account. Nothing can start them, but the slot'
    echo '  is still allocated and the firewall still opens its port.'
    echo "  Free them with 'hdw4s release <instance>'."
  }
  [ "${legacy}" -eq 0 ] || {
    echo
    echo "${legacy} slot(s) marked legacy are a second desktop for an account"
    echo '  that already has one, created by a version that still offered'
    echo '  that. An account now has one desktop. These keep running and keep'
    echo '  their port, and no other command will accept the name -- retire'
    echo "  one with 'hdw4s release <user>:<session>', which stops it first."
  }

  [ "${unprotected}" -eq 0 ] || {
    echo
    echo "${unprotected} session(s) marked AUTH=NO have no credential of their own."
    echo '  Whatever can reach their port gets a full desktop for that'
    echo '  account, with no further question. The firewall is the only thing'
    echo '  standing in the way.'
    echo "  Add one with 'hdw4s auth <instance>'."
  }
}

# Whether every running session is publishing the identity a returning tab
# compares itself against.
#
# Written from the failure, which is duller than a bug and is why it needs a
# check rather than a fix: on 2026-09-22 ephemeral2 started at 15:08,
# hdw4s-incarnation@.service first ran at 16:26, and that slot was never
# restarted. The wiring was correct the whole time -- Wants= and After= name the
# unit on every slot -- and the slot simply predated it. "hdw4s list" called it
# active, because it was. A live thing that predates a fix goes on running
# without it, and every listing shows it healthy.
#
# Why this one is worth a check of its own. The arrival rule says an unknown
# input must GATE; in code a rule like that becomes a comparison, and
# "stored != current" resumes SILENTLY when both sides are empty. A slot
# publishing nothing is exactly that state, so the riskiest input takes the
# safest-looking path and nobody is asked anything.
#
# It reports and returns non-zero. It restarts nothing: a check that repairs
# what it finds is one nobody reads, and this one's whole value is that somebody
# is told which slot and why.
cmd_check() {
  local idx inst state served recorded live=0 bad=0 pool_bad=0 failed=''
  local incarn="${HDW4S_INCARNATION_DIR:-${RUNDIR}/hdw4s-incarnation}"
  local webroot="${HDW4S_WEBROOT_DIR:-/usr/share/hdw4s/webroot}"
  local readable='yes'
  # That directory is 0700 and owned by root, so an unprivileged caller cannot
  # see into it. Asked once, up front, because the alternative is that every
  # unreadable file reads as an absent one -- which would turn "I am not allowed
  # to look" into "the token is missing" for some callers and, worse, could turn
  # into "nothing to report" if the comparison were ever relaxed. Which way a
  # check fails is the property; this one fails toward saying so.
  [ -d "${incarn}" ] && [ -x "${incarn}" ] || readable='no'

  # A table that is not there at all describes a machine where nobody has ever
  # configured a session, and that machine is not broken. A table that EXISTS
  # and cannot be read is a different answer wearing the same shape: the router
  # refuses every visitor in exactly that state -- permanently, and with nothing
  # in its log naming the file -- so this must not pass it over. "I could not
  # look" and "there is nothing to look at" are not the same answer, which is
  # the rule the incarnation half of this command already follows one line up.
  if [ ! -r "${SLOTS}" ]; then
    if [ -e "${SLOTS}" ]; then
      printf '%s\n' \
        "hdw4s: ${SLOTS} exists and cannot be read from here." \
        '  The router reads the same file to decide who may be let into a slot,' \
        '  and answers every arrival 503 while it cannot. Re-run this as root;' \
        '  if root cannot read it either, that is the outage.' >&2
      trap '' INT TERM QUIT HUP EXIT ERR
      exit 1
    fi
    echo 'hdw4s: no slot table, so no sessions to check.'
    return 0
  fi

  # ---- is the session slice's memory brake a number this machine can reach? --
  #
  # THE DEFECT THIS EXISTS FOR, and the reason nobody caught it for months is the
  # whole justification for the check. The slice carried "MemoryHigh=75%".
  # systemd expands a percentage in a memory limit through
  # sysconf(_SC_PHYS_PAGES) -- the sysinfo() syscall -- which a container runtime
  # cannot virtualise, while /proc/meminfo, which it can and does, stays correct.
  # Measured inside a 16 GiB container on 2026-09-26: the file said 16.00 GiB,
  # sysconf said 62.11 GiB, and the directive resolved to 46.58 GiB. The brake
  # was three times the container's memory and memory.events said "high 0".
  #
  # EVERY HUMAN-FACING TOOL ON THAT MACHINE REPORTS THE RIGHT NUMBER. free, top,
  # /proc/meminfo, the monitoring: all of them say 16 GiB, correctly. The only
  # place the disagreement is visible is in what systemd resolved the percentage
  # TO, and nobody reads that. That is why the repair alone is not enough: an
  # administrator's own drop-in, a live container resize, or a future edit of
  # ours can put a percentage back, and the machine would look exactly as it does
  # now -- no log line, no refusal, no symptom, until the kernel's OOM killer
  # picks a desktop and leaves a unit reporting active behind a blank screen.
  #
  # SO IT ASKS BOTH SIDES, and the asymmetry is the point: systemd is the only
  # thing that knows what the directive resolved to, and /proc/meminfo is the
  # only thing that knows what this machine has. Asking either one for both is
  # how the defect survived.
  #
  # ONE DIRECTION ONLY, deliberately. A limit BELOW what the machine has is
  # either correct or merely conservative -- which is also what a stale value
  # looks like after a container is grown, and ours is computed at boot -- and
  # throttling sooner than necessary harms nobody. A limit at or above what the
  # machine has can never be reached by anything, so it is not a brake at all.
  local memhigh memtotal_kb memtotal
  memhigh="$(systemctl show -p MemoryHigh --value hdw4s.slice 2>/dev/null || :)"
  memtotal_kb="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || :)"
  case "${memhigh}:${memtotal_kb}" in
    # Nothing to say. An unloaded slice on a machine that has never started a
    # session is not a fault, and a machine whose own MemTotal is unreadable is
    # not one to make claims about -- both answer "cannot tell", which is not
    # the same answer as "fine" and is therefore silent rather than green.
    :*|*:) ;;
    infinity:*)
      # NOT a failure. A soft brake is a good thing to have and its absence is
      # the state every release before this one shipped, so reddening here would
      # fail on machines that are merely not yet configured -- and a check that
      # is red on a working machine is one somebody turns off. Said, and not
      # counted.
      printf '%s\n' \
        'hdw4s: the desktop slice has no memory brake.' \
        '  One session that overreaches can make every other session on this' \
        '  machine slow, and nothing will throttle it first.' >&2
      ;;
    *[!0-9]*:*|*:*[!0-9]*) ;;
    *)
      memtotal=$(( memtotal_kb * 1024 ))
      if [ "${memhigh}" -ge "${memtotal}" ]; then
        # THE OBJECT THIS IS ABOUT IS NAMED, both numbers, in the units they were
        # read in -- because the first report of this defect said "the brake is
        # broken" and the next reader could not tell whether that was about a
        # container, a host, a slice or a session.
        printf '%s\n' \
          "hdw4s: the desktop slice's memory brake cannot ever apply." \
          "  MemoryHigh on hdw4s.slice resolves to ${memhigh} bytes, and this" \
          "  machine has ${memtotal} bytes of memory in total. A limit at or" \
          '  above what the machine has is never reached, so nothing throttles a' \
          '  session that overreaches and the kernel OOM killer acts instead --' \
          '  which leaves a unit reporting active behind a blank desktop.' \
          '  The usual cause is a PERCENTAGE: systemd resolves one against the' \
          "  hypervisor's memory, not this container's. Use an absolute count." >&2
        bad=$(( bad + 1 ))
      fi
      ;;
  esac

  # ---- can this machine hand anybody a desktop? -----------------------------
  #
  # WHY THIS ARM EXISTS AT ALL, and it is not the arm below it. The incarnation
  # arm asks a question about sessions that are RUNNING; an ephemeral pool is
  # socket-activated, so a healthy machine nobody is using has none running and
  # the arm below has nothing to examine. It then reported the same clean
  # sentence, and exit 0, that it reports when everything is fine -- measured on
  # a development box on 2026-09-24 with every slot door shut and again with
  # every session start broken: the visitor got 503 at all three slots and this
  # command printed "0 running ephemeral session(s)" and exited 0 both times.
  # An operator, this command's own timer, and any monitor above it all saw a
  # pass on a machine that could not serve anybody.
  #
  # AND WHY IT IS NOT A CHECK ON THE COUNT. Zero running sessions is the NORMAL
  # state of a healthy idle pool. Reddening on the count would fail on the most
  # common correct state there is, and a check that is red on a correct machine
  # is one that gets switched off. So every predicate below is a POSITIVE
  # observation of something that is missing, and a box with no ephemeral slots
  # configured is not a pool and is not examined at all.
  #
  # WHAT IT DELIBERATELY CANNOT SEE. A slot whose door is listening, whose units
  # are all healthy, and which the ROUTER has already let to a visitor who never
  # arrived, reads as perfectly serviceable here and answers 503 to the next
  # person. Nothing in the unit layer distinguishes a let slot from a free one,
  # and the authority for that question is the router's own records, not this
  # command's reading of systemd. That state needs an instrument that belongs to
  # the router; pretending this arm covers it would be worse than the silence.
  local slot_total=0 doors=0 shut='' listen port
  while read -r idx inst _; do
    case "${idx}" in ''|\#*) continue;; esac
    case "${inst}" in *:*) continue;; esac
    [ "$(type_of "${inst}")" = 'ephemeral' ] || continue
    slot_total=$(( slot_total + 1 ))
    if unix_listener "${RUNDIR}/hdw4s-proxy/${inst}.sock"; then
      doors=$(( doors + 1 ))
    else
      shut="${shut} ${inst}"
    fi
  done < <(sort -n "${SLOTS}")

  if [ "${slot_total}" -gt 0 ]; then
    # The accounts the slots run as are minted at boot into a tmpfs. Without
    # them User= does not resolve and every start dies 217/USER, which reads as
    # a broken service rather than as a missing account.
    if [ "$(systemctl show -p ActiveState --value \
            hdw4s-ephemeral-slots.service 2>/dev/null || echo unknown)" != 'active' ]; then
      printf '%s\n' \
        'hdw4s: the ephemeral slot identities have not been minted.' \
        '  hdw4s-ephemeral-slots.service is not active, so the accounts the' \
        '  slots run as do not resolve and every session start fails 217/USER.' \
        '  Start it: systemctl start hdw4s-ephemeral-slots.service' >&2
      pool_bad=$(( pool_bad + 1 ))
    fi

    # The one TCP port on the machine. Read from the socket unit rather than
    # from the configuration, because the unit is what the kernel was asked to
    # bind, and asked of the kernel rather than of systemd, because a unit can
    # be "active" while nothing is bound.
    listen="$(systemctl show -p Listen --value hdw4s-demux.socket 2>/dev/null || :)"
    port="${listen##*:}"; port="${port%% *}"
    case "${port}" in
      ''|*[!0-9]*)
        printf '%s\n' \
          'hdw4s: the front door has no listening address.' \
          '  hdw4s-demux.socket reports nothing systemd was asked to bind, so' \
          '  nothing outside this machine can reach any ephemeral session.' >&2
        pool_bad=$(( pool_bad + 1 ));;
      *)
        if ! tcp_listener "${port}"; then
          printf '%s\n' \
            "hdw4s: nothing is listening on the front door port ${port}." \
            '  hdw4s-demux.socket names it, and the kernel has no listener on' \
            '  it, so every arrival is refused before any session is reached.' \
            '  Start it: systemctl start hdw4s-demux.socket' >&2
          pool_bad=$(( pool_bad + 1 ))
        fi;;
    esac

    # A slot listed in the table with nothing bound at its socket is not a
    # capacity shortfall, it is a trap: the router mints a visitor onto the name
    # and the request fails with the slot consumed.
    if [ "${doors}" -eq 0 ]; then
      printf '%s\n' \
        "hdw4s: none of the ${slot_total} ephemeral slot(s) has a listening door." \
        "  Nothing is bound at ${RUNDIR}/hdw4s-proxy/<slot>.sock, so no arrival" \
        '  can start a desktop and every visitor is refused. This is what a' \
        '  teardown that does not re-arm the sockets leaves behind.' \
        '  Arm them: systemctl start hdw4s-proxy@<slot>.socket' >&2
      pool_bad=$(( pool_bad + 1 ))
    elif [ -n "${shut}" ]; then
      printf '%s\n' \
        "hdw4s: ${doors} of ${slot_total} ephemeral slot(s) have a listening door." \
        "  Not listening:${shut}" \
        '  A visitor minted onto one of those gets a failed request and the' \
        '  slot is consumed. Arm them: systemctl start hdw4s-proxy@<slot>.socket' >&2
      pool_bad=$(( pool_bad + 1 ))
    fi

    # A latched unit is the shape this pool fails into: the relay's start limit
    # fires, systemd refuses to start it again, and it stays failed until
    # somebody clears it. It is reported here rather than left to "systemctl
    # --failed" because nothing on this machine runs that on a timer.
    failed="$(systemctl list-units --failed --plain --no-legend \
              'hdw4s-demux.*' 'hdw4s-ephemeral*' 'hdw4s-proxy@*' 2>/dev/null \
              | awk '{print $1}' | tr '\n' ' ' || :)"
    if [ -n "${failed% }" ]; then
      printf '%s\n' \
        "hdw4s: the pool has failed unit(s): ${failed}" \
        '  A unit that has latched into failed is not started again by an' \
        '  arrival, so whatever it serves stays unreachable until it is' \
        "  cleared: systemctl reset-failed <unit>" >&2
      pool_bad=$(( pool_bad + 1 ))
    fi
  fi

  while read -r idx inst _; do
    case "${idx}" in ''|\#*) continue;; esac
    # A legacy second session and an orphaned slot are "list"'s business: the
    # first cannot be looked up by the readers below and the second has no
    # account to run. This command is about sessions that are running now.
    case "${inst}" in *:*) continue;; esac
    # EVERY SESSION THAT IS RUNNING, named desktops included. This arm was
    # restricted to the ephemeral pool by "in_ephemeral_pool ... || continue"
    # until 2026-09-26, and the restriction was justified by a comment whose two
    # factual halves were BOTH false by then:
    #
    #   "only hdw4s-ephemeral@.service Wants= the publisher"  -- hdw4s@.service
    #   has Wants=/After=hdw4s-incarnation@%i.service since ea4f6f6.
    #   "only an ephemeral slot is given a web root of its own" -- hdw4s@.service
    #   has ExecStartPre=+hdw4s-webroot provision %i since 78e12c6.
    #
    # It also argued that the PROPERTY is an ephemeral one, because a returning
    # tab only has to ask "is this the desktop I had" for a slot that is reused
    # behind one hostname. That was wrong too, and the measurement is in
    # hdw4s@.service's own header: 2026-09-25, on the owner's named desktop, a
    # hidden tab that comes back meets the reconnect card EVERY TIME, because the
    # gate's resume path reads /hdw4s-incarnation and got a 404. A named desktop
    # needs the token for the same reason and was the one place nothing checked it.
    #
    # WHAT THE OLD COMMENT GOT RIGHT, and it is the part to keep: run this
    # unrestricted against a machine whose named desktops predate those two
    # commits and it reports every one of them as broken -- and a check that is
    # always red is read as noise, with the one row that matters lost in the
    # middle of it. The difference is that those rows are now TRUE: such a
    # desktop IS broken, and a restart repairs it, which is what each row says to
    # do. If this ever goes red on a whole machine again, restart the sessions
    # rather than narrowing this back -- and if a session type is ever added that
    # genuinely cannot publish a token, exclude THAT TYPE by name here, with the
    # reason, instead of restoring a restriction whose reason has expired.
    state="$(systemctl show -p ActiveState --value "$(unit_of "${inst}")" \
             2>/dev/null || echo unknown)"
    [ "${state}" = 'active' ] || continue
    live=$(( live + 1 ))

    served=''
    [ ! -r "${webroot}/${inst}/hdw4s-incarnation" ] ||
      served="$(head -n1 "${webroot}/${inst}/hdw4s-incarnation" 2>/dev/null || :)"
    if [ -z "${served}" ]; then
      printf '%s\n' \
        "hdw4s: ${inst} is running and publishes no incarnation token." \
        "  Nothing at ${webroot}/${inst}/hdw4s-incarnation." \
        '  A returning tab compares its saved value against this one to decide' \
        '  whether it is looking at the desktop it had. With nothing published,' \
        '  that comparison has an empty value on both sides, which reads as' \
        '  "unchanged" -- so the tab resumes into whoever is in the slot now,' \
        '  instead of being asked.' \
        "  Restart it: systemctl restart $(unit_of "${inst}")" >&2
      bad=$(( bad + 1 ))
      continue
    fi

    if [ "${readable}" = 'no' ]; then
      printf '%s\n' \
        "hdw4s: ${inst} publishes a token, and whether it is the one this start" \
        "  recorded cannot be told from here: ${incarn} is readable by root only." \
        '  Reported as a failure rather than passed over, because "I could not' \
        '  look" and "I looked and it was fine" are not the same answer.' \
        '  Re-run this as root.' >&2
      bad=$(( bad + 1 ))
      continue
    fi

    recorded=''
    [ ! -r "${incarn}/${inst}" ] ||
      recorded="$(head -n1 "${incarn}/${inst}" 2>/dev/null || :)"
    if [ -z "${recorded}" ]; then
      printf '%s\n' \
        "hdw4s: ${inst} is running and this start recorded no incarnation token." \
        "  Nothing at ${incarn}/${inst}, although a value is being served." \
        '  The served copy is what a tab reads; the recorded copy is what says' \
        '  which start published it. Without the second, a token left behind by' \
        '  the previous session cannot be told from this one.' \
        "  Restart it: systemctl restart $(unit_of "${inst}")" >&2
      bad=$(( bad + 1 ))
      continue
    fi

    if [ "${served}" != "${recorded}" ]; then
      printf '%s\n' \
        "hdw4s: ${inst} serves an incarnation token this start did not publish." \
        "  ${webroot}/${inst}/hdw4s-incarnation does not match ${incarn}/${inst}." \
        '  Every tab still holding the served value will be told this is the' \
        '  desktop it had, and it is not.' \
        "  Restart it: systemctl restart $(unit_of "${inst}")" >&2
      bad=$(( bad + 1 ))
      continue
    fi
  done < <(sort -n "${SLOTS}")

  if [ "${bad}" -gt 0 ] || [ "${pool_bad}" -gt 0 ]; then
    [ "${bad}" -eq 0 ] || printf '%s\n' '' \
      "hdw4s: ${bad} of ${live} running session(s) failed this check." >&2
    [ "${pool_bad}" -eq 0 ] || printf '%s\n' '' \
      "hdw4s: ${pool_bad} thing(s) stop this machine handing out a desktop." >&2
    trap '' INT TERM QUIT HUP EXIT ERR
    exit 1
  fi
  # Says how many were looked at, not just that nothing was wrong. A check that
  # examined nothing reports the same clean bill of health as one that examined
  # everything, and the number is the only thing that tells them apart.
  #
  # THE DOOR COUNT IS THE HALF THAT WAS MISSING. "0 running" is the honest
  # reading of an idle pool and was also the reading of a pool that could not
  # start anything; saying how many doors are listening separates the two in the
  # one line an operator actually reads.
  # "live" counts every running session, named desktops included, since
  # 2026-09-26 -- so the sentence may not call them ephemeral. The clause that
  # did has been dropped rather than reworded; the slot and door counts still
  # describe the pool alone, which is what they say.
  if [ "${slot_total}" -gt 0 ]; then
    echo "hdw4s: ${slot_total} ephemeral slot(s), ${doors} with a listening door," \
         "${live} running; each running one publishes the identity its own" \
         'start recorded.'
  else
    echo "hdw4s: no ephemeral slots configured; ${live} running session(s)."
  fi
}

cmd_show() {
  local inst="$1" idx port
  # Handled here rather than left to -e: an unhandled failure also trips the
  # ERR trap, so a mistyped name printed its own clear diagnosis and then a
  # second, vaguer line about the script failing unexpectedly.
  split_instance "${inst}" || fail
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] ||
    die "hdw4s: ${inst} has no slot; run 'hdw4s enable ${inst}'."
  port="$(port_of "${idx}")"
  # Say where each value came from. Guessing which of the two files won is the
  # single most common source of confusion in a layered configuration.
  echo "instance      ${inst}"
  echo "user          ${user}"
  echo "slot          ${idx}  (${SLOTS})"
  echo "port          ${port}  (${HDW4S_BASE_PORT} + slot)"
  if [ -r "${ETCDIR}/${inst}.conf" ]; then
    echo "overrides     ${ETCDIR}/${inst}.conf"
    sed 's/^/              /' "${ETCDIR}/${inst}.conf"
  else
    echo "overrides     none  (${ETCDIR}/${inst}.conf does not exist)"
  fi
  local prof
  prof="$(setting_of "${inst}" HDW4S_ISOLATION none)"
  if [ "${prof}" = 'profile' ]; then
    echo "isolation     profile  (settings kept in $(profile_dir_of "${inst}")/${inst})"
  else
    echo 'isolation     none  (settings kept in the home directory, shared with'
    echo '                    any other desktop using it)'
  fi
  if has_auth "${inst}"; then
    echo "auth          a credential of its own, in ${ETCDIR}/${inst}.auth.cred"
    echo "              the proxy must present it; see 'hdw4s proxy ${inst}'"
  elif [ "$(setting_of "${inst}" HDW4S_TRANSPORT tcp)" = 'unix' ]; then
    echo 'auth          none, but reached over a filesystem socket, so access'
    echo '              is decided by permissions rather than by address'
  else
    echo 'auth          NONE -- anything that can reach the port gets this'
    echo "              desktop. Add one with 'hdw4s auth ${inst}'."
  fi
  local sk skey sdef sval ssrc
  echo 'settings      effective value, and where it came from'
  for sk in "${SESSION_SETTINGS[@]}"; do
    skey="${sk%%:*}"; sdef="${sk#*:}"
    ssrc="$(setting_with_source "${inst}" "${skey}" "${sdef}")"
    sval="${ssrc%%$'\t'*}"; ssrc="${ssrc#*$'\t'}"
    printf '              %-20s %-22s %s\n' \
      "${skey}" "${sval}" "${ssrc:-built-in default}"
  done
  # LANG is not in that table because its default is not a constant: it is read
  # from /etc/default/locale at session start and only falls back to C.UTF-8.
  ssrc="$(setting_with_source "${inst}" HDW4S_LANG '')"
  sval="${ssrc%%$'\t'*}"; ssrc="${ssrc#*$'\t'}"
  printf '              %-20s %-22s %s\n' 'HDW4S_LANG' \
    "${sval:-(from /etc/default/locale)}" "${ssrc:-built-in default}"

  # Existence, not readability -- the same distinction as has_auth. The file is
  # root-only, so asking whether we can read it answered "no keyring" for every
  # unprivileged caller, about sessions that have one.
  [ ! -e "${ETCDIR}/${inst}.keyring.cred" ] ||
    echo 'keyring       its own, unlocked at start'
  echo "display       $(cat "${RUNDIR}/hdw4s/${inst}/display" 2>/dev/null ||
                        echo 'not running (assigned at start)')"
}

cmd_enable() {
  local type='desktop'
  case "${1:-}" in
    --ephemeral) type='ephemeral'; shift;;
    # The administrator's authoring slot. It takes the ephemeral machinery --
    # ephemeral_shaped() says so in one place, so nothing here repeats the
    # list -- and differs from a pooled slot in exactly one way that matters
    # to a stranger: the router's pool is the rows typed "ephemeral", so this
    # row is never minted onto. That is the whole of "it is not in the pool",
    # and it is a property of the table rather than of a filename.
    --template)  type='template';  shift;;
  esac
  local inst="$1" idx prof fresh='no'
  # An ephemeral slot is not an account anybody named: it is minted by
  # hdw4s-ephemeral-slots, and the checks below are about a human's account.
  if [ "${type}" = 'desktop' ]; then
    split_instance "${inst}" || fail
  fi
  # Whether this instance is being created rather than re-enabled, decided
  # before anything below writes the file. "enable" is documented as safe to
  # re-run, so a session that already exists must come out of it configured
  # exactly as it went in -- turning authentication on underneath a running
  # deployment would answer its reverse proxy with 401 and take the desktop
  # away from someone who changed nothing.
  [ -e "${ETCDIR}/${inst}.conf" ] || fresh='yes'
  idx="$(alloc_slot "${inst}" "${type}")"

  install -d -m0755 "$(dropin_of "${inst}")"

  # Four drop-ins below describe an account: who it is, where its home is, which
  # GPU group it needs, where its profile lives. An ephemeral slot has none of
  # those to describe -- its unit sets User=%i itself, its home is a tmpfs inside
  # its own namespace, and its profile is a RuntimeDirectory, which is writable
  # under ProtectSystem=strict without being named. Writing them anyway is not
  # merely redundant: 40-home.conf would order the session after a mount of a
  # path that exists nowhere outside the namespace, and the unit would fail
  # 226/NAMESPACE naming a directory nobody can find.
  if [ "${type}" = 'desktop' ]; then

  # The unit carries no User= of its own. systemd has no specifier for "the
  # part of the instance name before the colon", and "User=%i" cannot be
  # rescued by a drop-in: an invalid user name in the base unit is a fatal
  # parse error, so the unit never loads far enough for an override to apply.
  # Every instance therefore gets its account named here.
  printf '%s\n' \
    '# Written by "hdw4s enable"; edit /etc/hdw4s/'"${inst}"'.conf instead.' \
    '[Service]' \
    "User=${user}" \
    > "$(dropin_of "${inst}")/50-user.conf"

  # ProtectSystem=strict makes the whole filesystem read-only apart from what
  # is named, and a desktop has to be able to write its own home. The unit
  # cannot name it, because there is no specifier for the home directory of the
  # account in User= -- %h is the *manager's* home, which for a system unit is
  # /root. So it is looked up here, at the one moment the account is known.
  #
  # Assuming /home would be wrong: plenty of sites keep home directories
  # somewhere else entirely, and the failure is a session that starts and then
  # cannot save anything.
  home="$(getent passwd -- "${user}" | cut -d: -f6)"
  [ -n "${home}" ] || die "hdw4s: ${user} has no home directory"
  # RequiresMountsFor belongs here too, for the same reason ReadWritePaths does.
  # The unit used to name /home, which is the one assumption this function
  # exists to avoid making: on a site with homes under /export the session was
  # not ordered after that mount and could start against an autofs stub.
  printf '%s\n' \
    '# Written by "hdw4s enable". Re-run it if the home directory moves.' \
    '[Unit]' \
    "RequiresMountsFor=${home}" \
    '' \
    '[Service]' \
    "ReadWritePaths=${home}" \
    > "$(dropin_of "${inst}")/40-home.conf"

  # The GPU, if this machine has one. The unit binds /dev/dri in and grants the
  # device rule, but the node is group-owned and the group differs between
  # machines -- "render" on a stock host, "plugdev" inside these containers,
  # because the container config chooses it -- so the unit cannot name it and it
  # is read off the node here.
  #
  # Without it the session can see the node and not open it: the encoder says
  # "Failed to init VAAPI: Permission denied" once and then encodes every frame
  # in software, which reads as a slow machine rather than a missing group.
  #
  # Re-run "hdw4s enable" if a GPU is added or taken away.
  gpu_group=''
  for node in /dev/dri/renderD*; do
    [ -e "${node}" ] || continue
    gpu_group="$(stat -c '%G' "${node}" 2>/dev/null || :)"
    case "${gpu_group}" in ''|UNKNOWN) gpu_group='' ;; esac
    break
  done
  if [ -n "${gpu_group}" ]; then
    printf '%s\n' \
      '# Written by "hdw4s enable" from the owner of /dev/dri/renderD*.' \
      '[Service]' \
      "SupplementaryGroups=${gpu_group}" \
      > "$(dropin_of "${inst}")/45-gpu.conf"
  else
    rm -f "$(dropin_of "${inst}")/45-gpu.conf"
  fi

  # ProtectSystem=strict makes everything read-only but what is named, and the
  # unit names only /var/lib/hdw4s. Any other profile directory was therefore
  # read-only inside the session, which failed at "install -d" with a bare
  # EROFS -- so the setting parsed, passed validation, was reported back by
  # "show", and could not work. Named here for the same reason the home
  # directory is: this is the one moment the value is known.
  prof="$(profile_dir_of "${inst}")"
  if [ "${prof}" = '/var/lib/hdw4s' ]; then
    rm -f "$(dropin_of "${inst}")/45-profile.conf"
  else
    printf '%s\n' \
      '# Written by "hdw4s enable". Re-run it if HDW4S_PROFILE_DIR changes.' \
      '[Service]' \
      "ReadWritePaths=${prof}" \
      > "$(dropin_of "${inst}")/45-profile.conf"
    install -d -m0755 "${prof}"
  fi
  fi

  # The relay forwards to wherever the session actually listens.
  install -d -m0755 "${DROPIN}/hdw4s-proxy@${inst}.service.d"

  # The session unit this relay brings up. The template cannot name it: an
  # ephemeral slot is served by a different unit, and a dependency in a template
  # cannot be overridden by a drop-in -- an empty "Requires=" does not reset the
  # list. So the relay names no session unit and this supplies it.
  #
  # BindsTo=, not Requires=, and the difference is only visible on the path a
  # person actually takes. Requires= ends the relay when the session is STOPPED;
  # it does not when the session EXITS ON ITS OWN, which is what logging out of
  # GNOME does. Measured on a logout, both ways:
  #
  #   Requires=  session=failed  relay=ACTIVE    next connection: HTTP 000
  #   BindsTo=   session=failed  relay=inactive  next connection: HTTP 200 in 1s
  #
  # With Requires= the relay survives its session and goes on forwarding to a
  # loopback port nothing is listening on, so every later visitor gets a dropped
  # connection and the slot never comes back without an administrator. That is
  # the "it briefly tried, failed to connect to the stream, and brought me back
  # to the prompt" report, and no amount of work in the browser fixes it.
  #
  # An earlier test of this directive was driven by "systemctl stop", where the
  # two are indistinguishable, and concluded there was nothing to choose between
  # them. The 61-second race that test warned about does not occur on the logout
  # path; a logout is a clean exit and the slot is back in about a second, with
  # the tmpfs home wiped.
  printf '%s\n' \
    '# Written by "hdw4s enable": the session unit behind this relay.' \
    '[Unit]' \
    "BindsTo=$(unit_of "${inst}")" \
    "After=$(unit_of "${inst}")" \
    > "${DROPIN}/hdw4s-proxy@${inst}.service.d/30-session.conf"
  # Only the port. The wait that goes with it lives in the unit, because a
  # multi-line ExecStartPre= is parsed as several directives and quietly
  # discarded -- systemd is not a shell and embedding one in a unit file goes
  # wrong in ways that only show up at runtime.
  printf '%s\n' \
    '# Written by "hdw4s enable".' \
    '[Service]' \
    'ExecStart=' \
    "ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:$(internal_port_of "${idx}")" \
    > "${DROPIN}/hdw4s-proxy@${inst}.service.d/50-port.conf"

  # And the session is told which loopback port to bind.
  config_write "${ETCDIR}/${inst}.conf" 'HDW4S_PORT' "$(internal_port_of "${idx}")"

  systemctl daemon-reload
  # The socket is what gets enabled, not the session. Nothing runs until
  # somebody connects, so a desktop that is never visited never exists.
  systemctl enable --now "hdw4s-proxy@${inst}.socket"

  # Give the front door its listener. Without this the socket unit keeps the
  # filesystem socket it defaults to, while everything that reports on the
  # session -- the line below, "list", "proxy" -- describes the TCP port it
  # was assigned, and the two disagree with nobody the wiser.
  # The instance's own setting, not the global default: "enable" is documented
  # as safe to re-run, and reading the global here would quietly move a session
  # that had deliberately been put on a filesystem socket back onto the network.
  #
  # An ephemeral slot is not offered that choice, and this is the line that
  # takes it away. Nobody provisions an ephemeral session and nothing outside
  # this machine addresses one: a visitor arrives at one well-known hostname
  # and a front door running HERE decides which slot they get. So the slot has
  # no caller that a port would serve, and a port has callers the slot must not
  # serve -- every other account in the container, which is what made
  # "curl 127.0.0.1:7304" answer 200 with somebody's live desktop. A filesystem
  # socket has no such caller: reachability becomes the mode and the owner of
  # /run/hdw4s-proxy, which the session unit already hides with
  # InaccessiblePaths=. The question is removed rather than guarded.
  local want='tcp'
  if ephemeral_shaped "${type}"; then
    want='unix'
  else
    want="$(setting_of "${inst}" HDW4S_TRANSPORT tcp)"
  fi
  cmd_transport "${inst}" "${want}" >/dev/null

  if [ "${want}" = 'unix' ]; then
    echo "Session ${inst} is reachable at ${RUNDIR}/hdw4s-proxy/${inst}.sock."
    echo 'It does not listen on the network. The front door that reaches it has'
    echo "to run on this machine; see 'hdw4s proxy ${inst}' for its configuration."
  else
    echo "Session ${inst} is listening on port $(port_of "${idx}")."
    echo "Point the reverse proxy at this machine's address, port $(port_of "${idx}")."
  fi
  echo 'The desktop starts on the first connection, not now.'

  # Say plainly what is missing. There is deliberately no site-wide switch for
  # this: HDW4S_AUTH is per-session state the tool writes, and a shared default
  # for it was removed after two administrators, asked as users rather than as
  # authors, independently called it a trap -- set once, forgotten, inherited
  # silently by every session afterwards. A session with no
  # credential is not a smaller version of one with a credential -- it is one
  # where an address is the only thing between a stranger and somebody's
  # desktop, and that deserves more than a line in a manual.
  if has_auth "${inst}"; then
    # The credential is kept; only the drop-in that points at it is refreshed,
    # so a session whose type changed -- or which was released and re-enabled --
    # does not come back up refusing to start for want of a file it already
    # has the secret for.
    link_credential "${inst}" 'auth' 70
    # Kept, and said out loud, because keeping it is the right call and having
    # it is not. "enable" is documented as safe to re-run: a session that came
    # in with a credential its reverse proxy already presents must go out with
    # the same one, or re-running this takes somebody's desktop away. So the
    # existing combination is reported rather than repaired, and the repair is
    # named for whoever decides to make it.
    if auth_is_meaningless "${inst}"; then
      echo
      echo "Session ${inst} carries a credential, and nothing routes one to it: the"
      echo '  front door in front of the ephemeral slots holds only its own and has no'
      echo '  way to be given this one. Every visitor sent here gets a 401 while the'
      echo '  other slots answer.'
      echo '  It is kept rather than removed, because re-enabling a session must not'
      echo '  change what it requires underneath whoever is using it. Nothing is'
      echo "  waiting on a proxy; remove it when you are ready to: hdw4s noauth ${inst}"
    fi
  elif auth_is_meaningless "${inst}"; then
    # The producer this guard exists to close. Both branches below generate a
    # credential, and for an ephemeral slot "want" is forced to unix a few lines
    # above -- so a fresh slot came out of "enable" with HDW4S_AUTH=basic on a
    # socket where it means nothing, every time, with nothing said.
    echo
    echo 'No credential is generated for this session, and none can be added: it is'
    echo '  reachable over a filesystem socket, which is an access decision already.'
    echo '  The socket is group-owned by the reverse proxy and open to nothing'
    echo '  else, so a secret would keep nobody out and would answer that proxy'
    echo '  with 401 until it was configured with it.'
  elif [ "$(setting_of "${inst}" HDW4S_AUTH none)" = 'basic' ]; then
    echo
    echo 'Generating the credential this session is configured to require...'
    cmd_auth "${inst}" >/dev/null
    echo "  done; see 'hdw4s proxy ${inst}' for the proxy configuration."
  elif [ "${fresh}" = 'yes' ]; then
    # New sessions get a credential by default. The firewall stands between
    # this port and other machines, and nothing stands between it and the other
    # accounts on this one: the streaming server binds 127.0.0.1, and any local
    # account can open a loopback port. Since the credential is generated here,
    # handed to the proxy by "hdw4s proxy", and never shown to the user, having
    # it costs nothing that not having it saves.
    echo
    echo 'Generating a credential for this session...'
    cmd_auth "${inst}" >/dev/null
    echo "  done; see 'hdw4s proxy ${inst}' for the proxy configuration."
    echo "  Turn it off with: hdw4s noauth ${inst}"
  else
    echo
    cat <<EOF

  This session has no credential of its own. Anything that can open a
  connection to port $(port_of "${idx}") gets a full desktop for ${user}, with no
  further question. The firewall's list of addresses is the only thing in
  the way, and an address is a weak thing to rely on by itself.

  The firewall also does not stand between this session and the other
  accounts on this machine. It filters what arrives from elsewhere; the
  streaming server listens on loopback, and any local account can reach a
  loopback port. A credential is what separates them.

      hdw4s auth ${inst}

  adds a secret the reverse proxy presents on every request. The user never
  sees it, so there is still no login screen. It is a per-session choice: there
  is no shared setting that turns this on or off for every session, because one
  that is set once and inherited silently is how a session ends up without a
  credential that nobody chose to remove.
EOF
  fi
}

# --- editing configuration --------------------------------------------------
#
# Settings people change often should not require an editor, but the file is
# the administrator's, so an edit has to disturb as little of it as possible.
# In order of preference: change an existing assignment where it stands; else
# uncomment the documented default where it stands, so the comment above it
# still explains the value; else append. Comments, ordering, spacing and
# anything the administrator wrote are preserved in every case.

# Settings that may be set from the command line, and how to check a value.
# Anything absent from here is rejected rather than written, because a typo
# that silently does nothing is worse than an error.
# Settings that only ever take effect machine-wide. A session sources both the
# global file and its own, so most settings work per instance for free -- but
# these are read by the CLI, by the firewall, or by the updater, none of which
# has an instance in hand. Writing one into an instance's file parses, passes
# every check and does nothing at all, which is the quietest kind of wrong.
declare -A GLOBAL_ONLY=(
  [HDW4S_PROXIES]=1 [HDW4S_BASE_PORT]=1 [HDW4S_BLOCK_SIZE]=1
  [HDW4S_MEDIA_PORTS]=1 [HDW4S_ALLOW_SYSTEM_USER]=1 [SELKIES_VERSION]=1
  # Read by the slot-minting service, which runs once for the machine. A
  # per-instance value would be read by nothing and would look like it worked.
  [HDW4S_EPHEMERAL_SLOTS]=1 [HDW4S_EPHEMERAL_HOME_SIZE]=1
  [HDW4S_EPHEMERAL_PROFILE_SIZE]=1 [HDW4S_EPHEMERAL_SHM_SIZE]=1
  [HDW4S_EPHEMERAL_BACKGROUND]=1
)

# Settings whose effect does not live in the configuration file at all. The
# value there is read back by "show", "list" and "proxy", but what actually
# takes effect is a drop-in or a credential that only the named command
# writes. Setting one here parsed, passed every check, was echoed back, and
# changed nothing -- so "list" reported the new transport while the session
# stayed on the old one, which is the disagreement the whole slot mechanism
# exists to prevent, arriving through a different door.
# Everything a session reads that is not already reported by name in "show",
# with the default the session scripts fall back to. "show" is documented as
# reporting the settings that apply and where each came from, and it only ever
# printed the instance file -- so the values that were inherited, which are
# exactly the ones somebody runs this command to find, were the ones it did not
# show. Kept in the order an administrator is likely to want them; the defaults
# are checked against the scripts by .github/checks.sh.
SESSION_SETTINGS=(
  'HDW4S_MICROPHONE:no'
  'HDW4S_WEBCAM:no'
  'HDW4S_WEBRTC:no'
  'HDW4S_TURN_PORT:3478'
  'HDW4S_SESSION:gnome-session'
  'HDW4S_ADDR:127.0.0.1'
  'HDW4S_ENCODER:h264enc'
  'HDW4S_FRAMERATE:30,8-60'
  'HDW4S_RESIZE:true'
  'HDW4S_DPI:follow'
  'HDW4S_INDEXING:off'
  'HDW4S_THUMBNAILS:off'
  'HDW4S_HIDPI:scale'
  'HDW4S_IDLE_DAYS:7'
  'HDW4S_PROFILE_DIR:/var/lib/hdw4s'
)

declare -A OWNED_BY=(
  [HDW4S_TRANSPORT]='transport'
  [HDW4S_AUTH]='auth'
)

declare -A SETTABLE=(
  [HDW4S_PROXIES]='any'
  [HDW4S_ISOLATION]='none|profile'
  [HDW4S_AUTH]='none|basic'
  [HDW4S_TRANSPORT]='tcp|unix'
  [HDW4S_PROXY_GROUP]='any'
  [HDW4S_ALLOW_SYSTEM_USER]='yes|no'
  [HDW4S_PROFILE_DIR]='path'
  [HDW4S_ADDR]='any'
  [HDW4S_BASE_PORT]='number'
  [HDW4S_BLOCK_SIZE]='number'
  [HDW4S_EPHEMERAL_SLOTS]='number'
  [HDW4S_EPHEMERAL_HOME_SIZE]='size'
  [HDW4S_EPHEMERAL_PROFILE_SIZE]='size'
  [HDW4S_EPHEMERAL_SHM_SIZE]='size'
  [HDW4S_EPHEMERAL_BACKGROUND]='color'
  [HDW4S_MICROPHONE]='no|yes'
  [HDW4S_WEBCAM]='no|yes'
  [HDW4S_WEBRTC]='no|yes'
  [HDW4S_TURN_HOST]='any'
  [HDW4S_TURN_PORT]='number'
  [HDW4S_TURN_SECRET]='any'
  [HDW4S_SESSION]='any'
  [HDW4S_FRAMERATE]='framerate'
  [HDW4S_RESIZE]='true|false'
  [HDW4S_DPI]='dpi'
  [HDW4S_INDEXING]='off|on'
  [HDW4S_THUMBNAILS]='off|on'
  [HDW4S_HIDPI]='scale|native'
  [HDW4S_LANG]='any'
  [HDW4S_IDLE_DAYS]='duration'
  [HDW4S_MEDIA_PORTS]='proxied|direct'
  [HDW4S_ENCODER]='any'
  [SELKIES_VERSION]='any'
)

# --- the idle window --------------------------------------------------------

# HDW4S_IDLE_DAYS is a duration, and a bare number in it still means DAYS.
#
# THE GRAMMAR IS NOT HERE. It is hdw4s-duration, and this calls it. There used
# to be a copy of it in this file and another reading of it in hdw4s-demux, and
# the two disagreed: the copy here took "30d" and the router read the same line
# with int(), caught the failure and used seven days without a word. The value
# in question is the one our own sample configuration and manual tell an
# administrator to type. A repair that taught both sides the same rules would
# have been correct on the day it landed and available to drift again the day
# after, which is what had already happened once -- so there is one
# implementation and both callers reach it.
#
# .github/checks.sh refuses a second unit table anywhere in the tree, and
# .github/setting-grammar.py asks this side and the router the same values and
# compares the answers. Neither is decoration: the first red arm either has
# ever produced was the shipped defect itself.
#
# THE NAME IS DELIBERATE. DO NOT "TIDY" IT BY RENAMING THE KEY -- the reasoning
# is in hdw4s-duration, beside the grammar it is about.

# Where the grammar lives. HDW4S_LIBDIR for the test suite and for a tree that
# is not installed; the literal is what install.sh rewrites when the package is
# put somewhere else, which is why it is spelled out rather than computed.
DURATION_TOOL="${HDW4S_LIBDIR:-/usr/lib/hdw4s}/hdw4s-duration"

# The two answers from idle_seconds: the window in whole seconds when it
# succeeds, and why it refused when it does not.
#
# RETURNED IN VARIABLES RATHER THAN ON STDOUT, and that is not a style choice.
# A command substitution runs in a subshell, so a caller written as
#
#     window="$(idle_seconds "${raw}")" || echo "${IDLE_WHY}"
#
# reads the reason back as EMPTY every time -- the assignment happened in a
# child that has already exited. The refusal would print a key, a colon and
# nothing, on exactly the path nobody tests. There is no call site that can get
# this wrong now, because there is no stdout to capture.
IDLE_SECONDS=''
IDLE_WHY=''

# Sets IDLE_SECONDS to the window in whole seconds, or fails with the reason in
# IDLE_WHY.
#
# Failing rather than dying, so both callers can be loud in their own way: "set"
# dies on the spot, and the reaper has other sessions to get to and must not
# exit in the middle of the list. NEITHER may fall back to a default.
#
# THREE OUTCOMES, NOT TWO. Exit 1 from the helper is "that value cannot be
# read" and carries the reason. Any other non-zero status -- the helper missing,
# unreadable, or raising -- is "this installation is broken", and it is reported
# as that rather than folded into a refusal about the value. Conflating a parse
# failure with a policy decision is precisely the defect this replaced, and it
# would be a poor joke to reintroduce it one level up.
idle_seconds() {
  local out rc
  IDLE_SECONDS=''
  IDLE_WHY=''
  out="$("${DURATION_TOOL}" "$1" 2>&1)"; rc=$?
  case "${rc}" in
    0) # Checked rather than trusted: on success the helper prints digits and
       # nothing else, so anything else on either stream means we are talking
       # to something that is not the parser -- a python warning, a wrapper, a
       # stale file. Reading that as a number is how a window becomes a value
       # nobody wrote.
       case "${out}" in
         ''|*[!0-9]*)
           IDLE_WHY="${DURATION_TOOL} answered '${out}', which is not a number of seconds."
           return 1;;
       esac
       IDLE_SECONDS="${out}";;
    1) IDLE_WHY="${out}";;
    *) IDLE_WHY="${DURATION_TOOL} could not be run (exit ${rc}): ${out}";;
  esac
  [ "${rc}" -eq 0 ]
}

# The remedy, printed under every refusal above. It comes out of the same file
# as the rules, so a refusal cannot name a spelling the parser rejects; every
# form in it is run back through the parser by .github/tests.sh.
idle_syntax_help() {
  "${DURATION_TOOL}" --help-text 2>/dev/null ||
    printf '%s\n' \
      "  ${DURATION_TOOL} is missing, so the accepted forms cannot be named." \
      '  Reinstall the package: nothing can read an idle window without it.'
}

# How long ago, in words, for a message a person reads. Whole units only: the
# reaper is announcing that it stopped something, and "nothing has connected
# for 8 days" is the sentence, not a duration to compute against.
duration_words() {
  local s="$1"
  if   [ "${s}" -ge 172800 ]; then printf '%s days'    "$(( s / 86400 ))"
  elif [ "${s}" -ge 86400  ]; then printf '1 day'
  elif [ "${s}" -ge 7200   ]; then printf '%s hours'   "$(( s / 3600 ))"
  elif [ "${s}" -ge 3600   ]; then printf '1 hour'
  elif [ "${s}" -ge 120    ]; then printf '%s minutes' "$(( s / 60 ))"
  else                             printf '%s seconds' "${s}"
  fi
}

# Whether this machine has an ephemeral pool at all, read from the slot table
# rather than from a setting: the table is what every other reader uses to
# decide what a slot is, and a machine with the pool size configured but no
# slots minted has nothing to protect yet.
has_ephemeral_slots() {
  [ -r "${SLOTS}" ] || return 1
  # "ephemeral" and not ephemeral_shaped(): this asks whether visitors can be
  # minted, which is in_ephemeral_pool()'s question, and an authoring slot is
  # not capacity. A box carrying only a template row has nothing to hand out.
  awk '$1 !~ /^#/ && $3 == "ephemeral" { found = 1 }
       END { exit !found }' "${SLOTS}"
}

# "Never reap" is a defensible administrative choice for a named session and an
# incoherent one for an ephemeral slot, so it is refused where it is written
# rather than discovered months later.
#
# Stopping a named session is a nap: its files and settings stay, and the next
# connection starts it again. Nothing is lost by never doing it. An ephemeral
# slot has no such second state -- reaping is the ONLY thing that ever frees
# one, because a visitor who closes the tab never tells anything -- so a zero
# there means unattended desktops accumulate until the pool is full, and every
# visitor after that gets a 503 from the front door. One configuration line, no
# error anywhere, and a symptom that looks like a routing fault.
#
# Refused rather than warned about: a warning at "set" time is read once, by
# somebody who has already decided.
guard_never_reap() {
  local inst="$1" value="$2"
  # A value this cannot parse is somebody else's refusal; say nothing twice.
  idle_seconds "${value}" || return 0
  [ "${IDLE_SECONDS}" -eq 0 ] || return 0

  if [ -n "${inst}" ]; then
    # in_ephemeral_pool() and NOT ephemeral_shaped(), and the reason is the
    # sentence below: the refusal is about CAPACITY. "Never reap" is incoherent
    # for a slot a stranger is waiting for and merely unwise for the authoring
    # slot, which has no next visitor -- nobody is ever minted onto it. An
    # administrator who wants an authoring session to sit until they come back
    # to it is asking for something coherent, and this used to refuse it purely
    # because the test was spelled "is it ephemeral".
    in_ephemeral_pool "$(type_of "${inst}")" || return 0
    die "hdw4s: ${inst} is an ephemeral slot, and 0 would never free it." \
        '  Reaping is the only thing that ever frees a slot: a visitor who' \
        '  closes the tab tells nothing, so with no window the slot stays' \
        '  occupied until the machine reboots. Once every slot is held, the' \
        '  next visitor gets a 503 and nothing anywhere reports why.' \
        '  Set a long window instead of none:' \
        "    hdw4s set ${inst} HDW4S_IDLE_DAYS=30d" \
        '  0 is still accepted for a named session, where stopping one is a' \
        '  nap and the next connection starts it again.'
  fi

  # Machine-wide, and only on a machine that has a pool: without one, 0 is the
  # named-session choice above and there is nothing to protect. Derived from
  # the table rather than assumed, so this does not refuse on a machine the
  # rule does not apply to -- a check that fails on a correct state is a check
  # somebody turns off.
  has_ephemeral_slots || return 0
  die 'hdw4s: 0 here would stop this machine reaping its ephemeral slots.' \
      '  This value is read by every session, including the slots of the' \
      '  ephemeral pool, and reaping is the only thing that ever frees one.' \
      '  With no window they fill up and stay full, and every visitor after' \
      '  that gets a 503 with nothing reporting why.' \
      '  Set it on the named sessions that should never be stopped:' \
      '    hdw4s set <session> HDW4S_IDLE_DAYS=0' \
      '  or give the whole machine a long window instead of none:' \
      '    hdw4s set HDW4S_IDLE_DAYS=30d'
}

check_value() {
  local key="$1" value="$2" rule="${SETTABLE[$1]}"
  case "${rule}" in
    number) case "${value}" in ''|*[!0-9]*)
              die "hdw4s: ${key} takes a number, not '${value}'";; esac;;
    # Typed as a plain number, this setting rejected "24h" outright -- and the
    # refusal read as the parser failing rather than as the validator refusing
    # a form the parser would have taken. The type ships with the parser.
    duration)
            idle_seconds "${value}" ||
              die "hdw4s: ${key}: ${IDLE_WHY}" "$(idle_syntax_help)";;
    # A bare number, or the "N,LOW-HIGH" form. The range has to be settable:
    # hdw4s-run-session turns a bare number into "N,8-N" precisely so the
    # setting caps the rate rather than merely starting there, and passes an
    # explicit range through untouched. Typed as a plain number, the only way
    # to use the form the runner supports was to edit the file by hand.
    framerate)
            [[ "${value}" =~ ^[0-9]+(,[0-9]+-[0-9]+)?$ ]] ||
              die "hdw4s: ${key} takes a number or an 'N,LOW-HIGH' range, not '${value}'";;
    dpi)    case "${value}" in follow) :;; ''|*[!0-9]*)
              die "hdw4s: ${key} takes 'follow' or a number, not '${value}'";; esac;;
    # A tmpfs size, as mount(8) takes it: bytes, a K/M/G suffix, or a percentage
    # of physical memory. Checked here rather than at mount time because a
    # rejected option does not fail the setting, it fails the whole namespace --
    # and the message then names the mount instead of the value that caused it.
    size)   [[ "${value}" =~ ^[0-9]+[KMG]?$|^[0-9]+%$ ]] ||
              die "hdw4s: ${key} takes a size such as 512M, 2G or 10%, not '${value}'";;
    color)  [[ "${value}" =~ ^#[0-9a-fA-F]{6}$ ]] ||
              die "hdw4s: ${key} takes a colour such as #772953, not '${value}'";;
    path)   case "${value}" in /*) :;;
              *) die "hdw4s: ${key} takes an absolute path, not '${value}'";; esac;;
    any)    :;;
    *)      case "|${rule}|" in
              *"|${value}|"*) :;;
              *) die "hdw4s: ${key} must be one of ${rule//|/, }, not '${value}'";;
            esac;;
  esac
}

# Quote only when the value needs it, so a file edited by hand keeps looking
# the way the administrator wrote it.
quote_value() {
  case "$1" in
    ''|*[![:alnum:]_./:-]*) printf "'%s'" "${1//\'/\'\\\'\'}";;
    *) printf '%s' "$1";;
  esac
}

config_file() {
  if [ -z "$1" ]; then echo "${CONF}"; else echo "${ETCDIR}/$1.conf"; fi
}

config_write() {
  local file="$1" key="$2" value="$3" tmp
  install -d -m0755 "${ETCDIR}"
  [ -e "${file}" ] || {
    printf '%s\n' \
      "# Settings for this session. Read after ${CONF}, and wins over it." \
      '# Edit by hand, or with "hdw4s set".' \
      '' > "${file}"
    chmod 0644 "${file}"
  }

  tmp="$(mktemp "${file}.XXXXXX")"
  chmod 0644 "${tmp}"
  KEY="${key}" VALUE="${value}" awk '
    # A note the administrator wrote at the end of the line is theirs, and
    # replacing the value is no reason to throw it away. Only treat a "#" as
    # the start of one when the text before it has balanced quotes, so a "#"
    # inside a quoted value is left alone.
    function trailing(line,   i, c, head, sq, dq) {
      for (i = length(line); i > 1; i--) {
        if (substr(line, i, 1) != "#") continue
        c = substr(line, i - 1, 1)
        if (c != " " && c != "\t") continue
        head = substr(line, 1, i - 1)
        sq = gsub(/'"'"'/, "&", head)
        dq = gsub(/"/, "&", head)
        if (sq % 2 == 0 && dq % 2 == 0) return "   " substr(line, i)
      }
      return ""
    }
    BEGIN { key = ENVIRON["KEY"]; value = ENVIRON["VALUE"]; live = 0; comment = 0 }
    # Remember the last assignment that is in effect, and the last commented
    # one, so the replacement happens where a reader would expect to find it.
    $0 ~ "^[[:space:]]*" key "=" { live = NR }
    $0 ~ "^[[:space:]]*#[[:space:]]*" key "="  { comment = NR }
    { lines[NR] = $0 }
    END {
      target = live ? live : comment
      for (i = 1; i <= NR; i++) {
        if (i == target) {
          match(lines[i], /^[[:space:]]*/)
          indent = substr(lines[i], 1, RLENGTH)
          printf "%s%s=%s%s\n", indent, key, value, trailing(lines[i])
        } else {
          print lines[i]
        }
      }
      if (!target) {
        if (NR > 0 && lines[NR] != "") print ""
        printf "%s=%s\n", key, value
      }
    }' "${file}" > "${tmp}"
  mv "${tmp}" "${file}"
}

cmd_set() {
  local inst='' file key value pair
  if [ "$#" -gt 1 ] && [ "${1#*=}" = "$1" ]; then
    inst="$1"; shift
    split_instance "${inst}"
  fi
  [ "$#" -gt 0 ] || die 'hdw4s: nothing to set'
  file="$(config_file "${inst}")"

  for pair in "$@"; do
    case "${pair}" in
      *=*) :;;
      *) die "hdw4s: '${pair}' is not KEY=VALUE";;
    esac
    key="${pair%%=*}"
    value="${pair#*=}"
    [ -n "${SETTABLE[${key}]+set}" ] ||
      die "hdw4s: ${key} cannot be set from the command line." \
          "  Settable: ${!SETTABLE[*]}" \
          "  Anything else can still be edited in ${file}."
    # Only for a named session. Machine-wide these are read when a session is
    # created -- "hdw4s enable" asks setting_of for both, and generates the
    # credential when the answer is basic -- so the site-wide default that
    # hdw4s.conf and the manual both describe has to keep working. It is the
    # per-session write that would be recorded and then ignored, because the
    # drop-in and the credential are what actually take effect.
    [ -z "${inst}" ] || [ -z "${OWNED_BY[${key}]+set}" ] ||
      die "hdw4s: ${key} is not set this way for one session." \
          "  It takes effect through a drop-in that only 'hdw4s ${OWNED_BY[${key}]}'" \
          '  writes, so setting it here would be recorded and ignored. Run:' \
          "    $(owning_command "${key}" "${inst}" "${value}")" \
          "  Setting it without a session name applies to sessions created" \
          '  afterwards, which is what the sample configuration describes.'
    [ -z "${inst}" ] || [ -z "${GLOBAL_ONLY[${key}]+set}" ] ||
      die "hdw4s: ${key} only takes effect machine-wide." \
          "  Nothing reads it per session, so writing it into ${file}" \
          '  would parse, pass every check, and do nothing. Set it without' \
          "  an instance name: hdw4s set ${key}=${value}"
    # HDW4S_AUTH is refused machine-wide as well as per session, so it is the
    # one key with no "set" form at all. It used to be accepted here, and the
    # sample configuration and the manual both described that as the way to
    # choose authentication for a whole site.
    #
    # Two administrators, asked as USERS of this tool rather than as its
    # authors, independently called that a trap: a security-relevant switch set
    # once, inherited by every session created afterwards, and invisible at the
    # moment it takes effect -- so the session that ends up without a credential
    # is not the one anybody decided about. The owner agreed and had it removed.
    #
    # It also never worked in the direction people would reach for. A global
    # "none" was silently overridden, because "enable" writes an explicit
    # per-session value that shadows it; only "basic" appeared to take, and only
    # because new sessions already get a credential. One direction ignored, the
    # other redundant, both documented as working.
    #
    # Refused rather than ignored: a setting that parses and does nothing is how
    # this one survived unnoticed for months.
    if [ -z "${inst}" ] && [ "${key}" = 'HDW4S_AUTH' ]; then
      die "hdw4s: ${key} is per-session only; there is no machine-wide form." \
          '  A shared default for this is set once and inherited silently by' \
          '  every session made afterwards, so the session that ends up without' \
          '  a credential is not the one anybody chose. Set it per session:' \
          '    hdw4s auth <session>     to require a credential' \
          '    hdw4s noauth <session>   to remove one'
    fi
    check_value "${key}" "${value}"
    # After check_value, so an unparseable value is refused as bad syntax
    # rather than as a policy violation it is not.
    [ "${key}" != 'HDW4S_IDLE_DAYS' ] || guard_never_reap "${inst}" "${value}"
    config_write "${file}" "${key}" "$(quote_value "${value}")"
    echo "${file}: ${key}=${value}"
  done
  set_hint "${inst}" "$@"
}

cmd_unset() {
  local inst='' file key tmp
  if [ "$#" -gt 1 ]; then inst="$1"; shift; split_instance "${inst}" || fail; fi
  [ "$#" -eq 1 ] || die 'hdw4s: unset takes one setting'
  key="$1"
  file="$(config_file "${inst}")"
  [ -e "${file}" ] || die "hdw4s: ${file} does not exist"

  # Comment the assignment out rather than deleting the line, so the value that
  # was there stays visible and the file still documents what was tried.
  # The key goes into an awk regular expression below, so it has to be a name
  # and not a pattern. Without this, "hdw4s unset '.*'" comments out every line
  # in the file and reports success.
  case "${key}" in
    ''|*[!A-Za-z0-9_]*)
      die "hdw4s: '${key}' is not a setting name." ;;
  esac

  # The same guard "set" carries. Without it the refusal there was half a
  # guard: "hdw4s set alice HDW4S_AUTH=none" was refused and pointed at the
  # right command, while "hdw4s unset alice HDW4S_AUTH" commented the setting
  # out and turned authentication off in one word, leaving the credential file
  # in place and "show" reporting a session that authenticates nobody.
  [ -z "${inst}" ] || [ -z "${OWNED_BY[${key}]+set}" ] ||
    die "hdw4s: ${key} is not unset this way for one session." \
        "  Use 'hdw4s ${OWNED_BY[${key}]}' so that the drop-in it writes is" \
        '  brought back into agreement with the setting.'

  tmp="$(mktemp "${file}.XXXXXX")"
  chmod 0644 "${tmp}"
  KEY="${key}" awk '
    BEGIN { key = ENVIRON["KEY"] }
    $0 ~ "^[[:space:]]*" key "=" { print "#" $0; next }
    { print }' "${file}" > "${tmp}"
  if cmp -s "${file}" "${tmp}"; then
    rm -f "${tmp}"
    echo "${file}: ${key} was not set"
  else
    mv "${tmp}" "${file}"
    echo "${file}: ${key} commented out; the default applies again"
  fi
  set_hint "${inst}" "${key}="
}

# Say what has to happen for a change to take effect. Silently writing a value
# that does nothing until some unmentioned command is run is how configuration
# files get a reputation for not working.
set_hint() {
  local inst="$1" pair firewall='' session='' updater='' atenable='' relay='' \
        atenable2=''
  shift
  for pair in "$@"; do
    case "${pair%%=*}" in
      # Read only by hdw4s-firewall. Restarting a session does nothing for
      # these, and HDW4S_MEDIA_PORTS used to be told to do exactly that.
      HDW4S_PROXIES|HDW4S_BASE_PORT|HDW4S_BLOCK_SIZE|HDW4S_MEDIA_PORTS)
        firewall='yes';;
      # Read only by the updater.
      SELKIES_VERSION) updater='yes';;
      # Read by the CLI when a session is created, and nowhere else.
      HDW4S_ALLOW_SYSTEM_USER) atenable='yes';;
      # Written into the socket drop-in by "hdw4s transport", not read at
      # session start, so a restart does not pick it up.
      HDW4S_PROXY_GROUP) relay='yes';;
      # Takes effect through a drop-in that only "hdw4s enable" writes, the
      # ReadWritePaths for the profile directory. A restart on its own re-reads
      # the same drop-in and changes nothing, which is the advice this used to
      # give.
      HDW4S_PROFILE_DIR) atenable2='yes';;
      *) session='yes';;
    esac
  done
  [ -z "${firewall}" ] || echo "  Run 'hdw4s firewall --apply' to use it."
  [ -z "${updater}" ] || echo "  Run '/usr/lib/hdw4s/hdw4s-update' to use it."
  [ -z "${atenable}" ] || echo '  Applies to sessions created after this.'
  [ -z "${atenable2}" ] || {
    echo "  Run 'hdw4s enable ${inst:-<session>}' again to rewrite the drop-in,"
    echo "  then 'systemctl restart hdw4s@${inst:-<session>}' to use it."
  }
  [ -z "${relay}" ] ||
    echo "  Run 'hdw4s transport ${inst:-<session>} unix' again to use it."
  if [ -n "${session}" ]; then
    if [ -n "${inst}" ]; then
      echo "  Run 'systemctl restart $(unit_of "${inst}")' to use it."
    else
      echo '  Restart the affected sessions to use it.'
    fi
  fi
}

# Generate a secret, seal it to this machine, and record the drop-in that hands
# it to the session at start time. systemd keeps it in memory that is not
# swapped and exists only for the life of the unit, so it is never written to
# disk in the clear.
make_credential() {
  local inst="$1" name="$2" order="$3" cred pw
  cred="${ETCDIR}/${inst}.${name}.cred"
  pw=''
  while [ "${#pw}" -lt 24 ]; do
    # tr removes characters before head truncates, so a single pass can come
    # out short. Loop until it is the length it is supposed to be rather than
    # hoping, because a one-in-a-thousand weak credential is the kind nobody
    # ever finds.
    pw="${pw}$(head -c48 /dev/urandom | base64 | tr -d '\n=/+')"
  done
  pw="${pw:0:24}"

  if ! ( umask 0077
         printf '%s' "${pw}" |
           systemd-creds encrypt --name="hdw4s-${name}" - "${cred}" ) 2>/dev/null
  then
    unset pw
    rm -f "${cred}"
    die 'hdw4s: could not encrypt the secret.' \
        '  systemd-creds needs to run as root and to read the machine secret' \
        '  in /var/lib/systemd/credential.secret, which it creates on first' \
        '  use. Check "systemd-creds has-tpm2" and try again as root.'
  fi

  install -d -m0755 "$(dropin_of "${inst}")"
  printf '%s\n' \
    "# Written by \"hdw4s ${name}\"." \
    '[Service]' \
    "LoadCredentialEncrypted=hdw4s-${name}:${cred}" \
    > "$(dropin_of "${inst}")/${order}-${name}.conf"
  systemctl daemon-reload

  # NO RETURN CHANNEL, DELIBERATELY. This used to end by printing the secret on
  # stdout, and BOTH callers threw it away -- one captured it into a variable it
  # only ever unset, the other redirected it to /dev/null. So the plaintext
  # crossed a subshell boundary, sat in a shell variable and in a pipe, for no
  # consumer at all.
  #
  # The secret is already where it belongs by this point: encrypted into
  # ${cred} and named in the drop-in. Anything that needs it asks systemd for
  # it. Handing it back is a leak surface with nothing on the other end, and the
  # rule is to compute the property rather than move the secret around.
  #
  # Removing the substitution has a second effect worth keeping: `die` inside
  # $( ) runs in a SUBSHELL, so it printed its message and let the caller carry
  # on. Called directly, its exit reaches the shell that matters.
}

require_slot() {
  split_instance "$1" || fail
  [ -n "$(slot_of "$1")" ] ||
    die "hdw4s: $1 has no slot; run 'hdw4s enable $1' first."
  command -v systemd-creds >/dev/null ||
    die 'hdw4s: systemd-creds is not available on this system.'
}

cmd_transport() {
  local inst="$1" mode="$2" idx port group dir
  split_instance "${inst}" || fail
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] || die "hdw4s: ${inst} has no slot."
  port="$(port_of "${idx}")"
  dir="${DROPIN}/hdw4s-proxy@${inst}.socket.d"

  # The one place that could put an ephemeral slot on the network, so the
  # refusal is here rather than in the caller: "hdw4s enable" already asks for
  # 'unix' unconditionally, and a second copy of the rule there would not stop
  # an administrator typing this command. A named desktop is a different thing
  # and keeps the choice -- its reverse proxy is routinely on another machine.
  if [ "${mode}" = 'tcp' ] && ephemeral_shaped "$(type_of "${inst}")"; then
    # The noun is derived from the row rather than written in, because this
    # refusal now covers two types and "is an ephemeral slot" is false of one
    # of them. A refusal that misdescribes what it refused sends the reader to
    # look at the wrong thing.
    local what='an ephemeral slot'
    [ "$(type_of "${inst}")" != 'template' ] || what='the template-authoring slot'
    die "hdw4s: ${inst} is ${what} and cannot be put on TCP." \
        '  Nothing outside this machine addresses an ephemeral session: a' \
        '  visitor reaches one well-known hostname and a front door running' \
        '  here chooses the slot. A port would therefore serve no caller the' \
        '  slot has, and every caller it must not have -- any account in this' \
        "  container could open it. It stays on ${RUNDIR}/hdw4s-proxy/${inst}.sock."
  fi

  install -d -m0755 "${dir}"

  case "${mode}" in
    tcp)
      # STOP THE SOCKET FIRST, while the unit still knows it has a filesystem
      # address. This ordering is the whole fix for a leak that ran for months.
      #
      # It used to write the drop-in, reload, and then restart. "daemon-reload"
      # replaces the address list, so by the time the unit stopped there was no
      # UNIX path left for RemoveOnStop= to unlink and the socket file stayed on
      # disk forever. Measured to the microsecond from the journal: bind at
      # .744666, drop-in written .761 -- seventeen milliseconds later -- reload
      # at .947204, stop at .979114 with nothing to remove, rebind on the port at
      # .979369.
      #
      # The leftover is not inert. The demultiplexer builds its slot list by
      # reading that directory, so an orphan is enumerated, handed to a visitor,
      # and consumes a slot permanently. /run is a tmpfs, so every previous
      # instance was erased at boot and no check that reads configuration could
      # ever have seen it: right config, right unit, stale artefact.
      #
      # Stopping first lets systemd unlink its own socket, which is the honest
      # repair. The explicit rm afterwards is a backstop for the sockets already
      # on disk from before this change and for a stop that fails -- it is not
      # the mechanism, and removing the reorder and keeping the rm would leave
      # the bug in any path that does not come through here.
      systemctl stop "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      rm -f "${RUNDIR}/hdw4s-proxy/${inst}.sock"
      # Replace the filesystem socket the unit defaults to. An empty
      # ListenStream= first, because these accumulate rather than replace.
      printf '%s\n' \
        '# Written by "hdw4s transport".' \
        '[Socket]' \
        'ListenStream=' \
        "ListenStream=${port}" \
        > "${dir}/50-listen.conf"
      config_write "${ETCDIR}/${inst}.conf" 'HDW4S_TRANSPORT' 'tcp'
      systemctl daemon-reload
      systemctl start "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      echo "Session ${inst} listens on port ${port}."
      echo '  Who may connect is decided by the firewall; see HDW4S_PROXIES.'
      ;;
    unix)
      group="$(setting_of "${inst}" HDW4S_PROXY_GROUP www-data)"
      getent group -- "${group}" >/dev/null ||
        die "hdw4s: no such group: ${group}" \
            '  Set HDW4S_PROXY_GROUP to the group the reverse proxy runs as.'
      # The unit already listens on the filesystem socket; only the ownership
      # has to be said, since which account runs the proxy is a local decision.
      rm -f "${dir}/50-listen.conf"
      printf '%s\n' \
        '# Written by "hdw4s transport".' \
        '[Socket]' \
        "SocketGroup=${group}" \
        > "${dir}/60-group.conf"
      config_write "${ETCDIR}/${inst}.conf" 'HDW4S_TRANSPORT' 'unix'
      systemctl daemon-reload
      systemctl restart "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      echo "Session ${inst} is reachable at /run/hdw4s-proxy/${inst}.sock,"
      echo "readable by group ${group} only. It does not listen on the network."
      # The third way the combination is reached, and the only one that is not a
      # refusal. Moving a session onto the socket is the safer direction and must
      # not be blocked -- but it leaves behind a credential that was meaningful
      # on a port and is not here, and nothing else will ever mention it again.
      # Said after the success line rather than instead of it: the move happened.
      #
      # Split by session type, because one message was being given to two
      # situations that want opposite advice. A named session on a socket with a
      # credential is a SUPPORTED configuration -- the owner has ruled that the
      # admin may choose it -- so telling its operator to remove the credential
      # was advice against something deliberate. Only an ephemeral slot has
      # nobody who can present one.
      if has_auth "${inst}"; then
        echo
        if auth_is_meaningless "${inst}"; then
          echo "Session ${inst} still has a credential, and nothing can present it:"
          echo '  the front door in front of the ephemeral slots holds only its own.'
          echo '  Every visitor routed here gets a 401 while the other slots answer.'
          echo "  Remove it: hdw4s noauth ${inst}"
        else
          echo "Session ${inst} keeps its credential, which is allowed on this"
          echo '  transport and is not removed. Whatever connects to the socket must'
          echo '  still present it, so configure the proxy for this path as well --'
          echo '  otherwise this session answers 401 while its neighbours answer.'
        fi
      fi
      ;;
    *)
      die "hdw4s: transport must be 'tcp' or 'unix', not '${mode}'"
      ;;
  esac
}

# Say something the journal should keep.
#
# hdw4s-reaper.service filters itself at warning, so that running every few
# minutes does not write three lines a time about having done nothing. systemd
# reads a "<N>" prefix as a syslog priority, so anything that should survive
# that filter says so. Only when there is a journal to say it to: run by hand,
# the prefix would be rubbish on a terminal.
reap_say() {
  if [ -n "${JOURNAL_STREAM:-}" ]; then
    printf '<4>%s\n' "$*"
  else
    printf '%s\n' "$*"
  fi
}

# The router's record of the last request it ACCEPTED for a slot, or nothing.
#
# WHY A SECOND WITNESS AT ALL. The reaper's own stamp comes from a poll every
# few minutes, so a client that connects, does something and disconnects inside
# one gap is invisible to every sample taken -- and the stamp then says "nobody
# since yesterday" about a desktop somebody used twenty minutes ago, in a
# confident, well-formed, wrong sentence. Shortening the idle window is exactly
# what makes that reachable. The router writes its record where the connection
# is ACCEPTED, so it cannot miss one.
#
# The two are consulted as a MAXIMUM, never merged, and the asymmetry is the
# whole design:
#
#   * This may only ever EXTEND a life, never shorten one. It is an additional
#     reason to believe somebody was here, never a reason to believe nobody
#     was. So a router that is not running, has never run, or wrote nothing for
#     this slot contributes NOTHING to the maximum and the reaper falls back to
#     its own sample -- which is exactly the behaviour before this existed. The
#     failure mode that would matter, a stopped router making the whole pool
#     look idle and reap itself, cannot arise from a maximum.
#   * ABSENCE IS "NO OPINION", NEVER "IDLE". Returning "0" or "the epoch" for a
#     missing record would be a refusal to look wearing the shape of an
#     observation, and it would be spent as a verdict on the destruction side.
#   * The two stamps stay in SEPARATE FILES. Merged into one, a router that is
#     not running becomes indistinguishable from one reporting that nobody has
#     connected, and there is no third answer left to give.
#
# Reading, never writing: the hazard the reaper's own stamp avoids by living
# somewhere only root can write is a WRITE hazard -- root truncating whatever a
# symlink points at. This only reads. It still refuses a symlink, because this
# directory belongs to the router's dynamic user rather than to root and the
# router itself only ever os.replace()s a regular file here, so a symlink is a
# fault and not a shape we have to support. And the value is never printed,
# only classified: a diagnostic quoting the contents of a file somebody else
# chose would hand the journal whatever that file turned out to be.
# RESULT IN A VARIABLE, NOT ON STDOUT, and that is not a style choice. The first
# version printed the timestamp and called reap_say() for the faults, and was
# called in a command substitution -- which captured every one of those messages
# into the variable instead of the journal. Three arms went green while the
# diagnostic they asserted existed nowhere. Same shape as idle_seconds()/
# IDLE_WHY above, and for the same reason: a function whose answer is a value
# cannot also speak.
RLAST=''
RLAST_WHY=''
router_last_request() {
  local inst="${1}" path="${POOLDIR}/last-request/${1}" raw=''
  RLAST=''; RLAST_WHY=''
  # -L before -r: a symlink that resolves to a readable file passes -r.
  if [ -L "${path}" ]; then
    RLAST_WHY='it is a symlink'
    return 1
  fi
  [ -f "${path}" ] && [ -r "${path}" ] || return 1
  raw="$(cat "${path}" 2>/dev/null)" || return 1
  # Digits only. Anything else is not a timestamp, and guessing at one on the
  # destruction side is how a desktop gets stopped on a number nobody wrote.
  case "${raw}" in ''|*[!0-9]*)
    RLAST_WHY='it is not a timestamp'
    return 1;; esac
  # A record in the future is not an observation, it is a fault -- and CLAMPING
  # it to now would be worse than dropping it: every later run would clamp it
  # again, so the slot would never reap and the pool would never refill, with
  # no other symptom. Dropping it costs one sampling gap of accuracy, which is
  # bounded. Said out loud for the same reason.
  if [ "${raw}" -gt "${2}" ]; then
    RLAST_WHY='it is in the future'
    return 1
  fi
  RLAST="${raw}"
}

# How many clients are attached to a session.
#
# Not "established connections on the session's port", which is what this used
# to count. The streaming process is both the signalling server and two of its
# own peers, so it connects to that port twice itself and the count is never
# zero. Every session has therefore looked permanently in use -- which is why
# the reaper had never once fired, and why the updater never restarted a
# session to check that an upgrade actually worked.
#
# What marks a real client is the socket proxy: it holds one loopback
# connection to the session for each connection it is relaying, whichever
# transport its own front door uses. So count the connections that belong to
# the proxy, and nothing else.
clients_of() {
  local inst="$1" port="$2" pid out
  pid="$(systemctl show "hdw4s-proxy@${inst}.service" -p MainPID --value 2>/dev/null || echo 0)"
  # No proxy, no clients: nothing can reach the session without going through
  # it.
  case "${pid}" in ''|0|*[!0-9]*) echo 0; return 0;; esac
  out="$(ss -Htnp state established "dport = :${port}" 2>/dev/null || :)"
  # ss names the owning process only for sockets we have the privilege to see.
  # Counting nothing because we cannot look is not the same as counting nothing
  # because nobody is there, and the difference decides whether a desktop in
  # use gets stopped. Say so rather than guess.
  # Not "printf | grep -q": grep exits on the first match, the producer takes
  # SIGPIPE, and pipefail adopts that as the pipeline's status -- so a match
  # reads as a miss once the output outgrows the pipe buffer. It never does
  # here, but the failure is silent and the test is free.
  if [ -n "${out}" ] && [ "${out#*pid=}" = "${out}" ]; then
    echo 'unknown'
    return 0
  fi
  printf '%s\n' "${out}" | grep -c "pid=${pid}," || :
}

# Stop desktops nobody has connected to for a long time.
#
# Safe to do FOR A NAMED SESSION because the socket stays listening: it is not
# gone, it is asleep, its home is on disk and its settings are in StateDirectory=,
# and the next connection starts it again. What is reclaimed is the memory of a
# desktop somebody opened once and never came back to.
#
# It is NOT that for an ephemeral session, and this comment said it was. An
# ephemeral slot keeps its home and its profile on a tmpfs under the unit's
# RuntimeDirectory=, which systemd removes on stop -- on both stop paths,
# measured, and deliberately, because destruction is meant to be the platform's
# job rather than ours. Reaping one is therefore not a nap; it discards
# everything in it. That is still the right thing to do -- an ephemeral session
# that nobody has connected to for days is exactly what the timeout exists for --
# but it must not be announced as though nothing were lost. See the two messages
# below, which are now chosen by session type rather than shared.
#
# Idleness is measured by connections, not by input. A desktop with a window
# open but no typing may be running a long job somebody deliberately left; a
# desktop with nothing connected to it is not being watched by anyone. The
# browser client reconnects by itself, so an open tab counts as connected even
# across a laptop lid being shut.
cmd_reap() {
  local idx inst stype port established last now age raw window stopped=0
  now="$(date +%s)"
  [ -r "${SLOTS}" ] || return 0

  while read -r idx inst stype; do
    case "${idx}" in ''|\#*) continue;; esac
    # The type was being read into "_" and discarded, which is why one message
    # served both kinds and was wrong for one of them. Same default as type_of().
    [ -n "${stype}" ] || stype='desktop'
    [ "$(systemctl is-active "$(unit_of "${inst}")" 2>/dev/null)" = 'active' ] ||
      continue
    # Per instance, not once for the whole run: a session that should never be
    # reaped is a per-session decision, and reading the global here meant
    # setting it on an instance did nothing at all.
    raw="$(setting_of "${inst}" HDW4S_IDLE_DAYS 7)"
    # No fallback. What was here turned anything it could not read into seven
    # days without a word, which is how "30m" became a week and why nobody
    # could have noticed that "m" was ambiguous. Skipping is the cautious
    # answer and reaping on a guess is not: one leaves a desktop running, the
    # other destroys an ephemeral session on a number nobody wrote.
    if ! idle_seconds "${raw}"; then
      reap_say "hdw4s: ${inst} not considered: HDW4S_IDLE_DAYS: ${IDLE_WHY}"
      reap_say '  Nothing will stop this session until the value is fixed.'
      reap_say "  Fix it with: hdw4s set ${inst} HDW4S_IDLE_DAYS=7"
      continue
    fi
    window="${IDLE_SECONDS}"
    if [ "${window}" -eq 0 ]; then
      # Legal for a named session and refused at "set" time for a slot, so
      # reaching this with a slot means the file was edited by hand. Say so
      # every run: the pool filling up has no other symptom to trace back.
      # Pool membership again, for the same reason as the refusal at "set":
      # what this warns about is the pool filling up.
      ! in_ephemeral_pool "${stype}" ||
        reap_say "hdw4s: ${inst} has HDW4S_IDLE_DAYS=0, so this slot will never be freed."
      continue
    fi
    # The internal port, not the one the socket unit binds: the external port
    # has no connections at all when the session is on a filesystem socket,
    # which once made the reaper stop desktops that were in constant use.
    port="$(internal_port_of "${idx}")"
    established="$(clients_of "${inst}" "${port}")"

    # /run is a tmpfs, so noticing a connection costs a one-line write to
    # memory and nothing to the disk -- which is what makes it reasonable to
    # ask this every few minutes rather than once a day. There is no cheaper
    # event to hang this on: the proxy socket is Accept=no, so systemd counts
    # no connections for it, and the only other record is the session's own log,
    # which is upstream's prose and would be read by nobody but a parser.
    #
    # Not /run/hdw4s/<inst>: that is the session's RuntimeDirectory, owned by
    # the session user at mode 0700, so the user can replace this file with a
    # symlink and have the reaper -- which runs as root -- truncate whatever it
    # points at and write a timestamp into it. /etc/shadow, /etc/sudoers, take
    # your pick. The stamp is the reaper's own bookkeeping and belongs somewhere
    # only the reaper can write.
    #
    # AND IT MUST STILL BE READABLE BY THE ROUTER, which 0700 root:root was not.
    # hdw4s-demux prints two columns on every refusal -- when a slot last had a
    # request, and when the idle sweep last saw a connection on it -- and the
    # second is the one an operator sizes HDW4S_IDLE_DAYS from. The router runs
    # under DynamicUser=, so with 0700 it could not so much as traverse here:
    # measured, every start logged "the idle sweep's record under this directory
    # cannot be read here (unreadable (Permission denied))" and that column was
    # blank on every refusal, permanently. Nobody reading a 503 ever saw the
    # figure the release is actually judged on.
    #
    # 0750 root:www-data GRANTS EXACTLY ONE READER. The router is in www-data --
    # that group membership is how it reaches the slot sockets at all, and it is
    # stated in hdw4s-demux.service. A session account is NOT: it is minted into
    # its own group and nothing else, and www-data holds only the services put
    # there deliberately. So the untrusted population this stamp was moved away
    # from still cannot read it, and the write side is unchanged -- root only,
    # which was the whole reason it is not under the session's own runtime
    # directory.
    #
    # FAILS CLOSED, LOUDLY. If www-data does not exist -- a stock box with no web
    # server, which this package does not require -- the group change fails and
    # the fallback is exactly the old 0700. The router then prints the same
    # warning it prints today, so the degraded case announces itself rather than
    # producing a blank column nobody can account for. Do not turn that warning
    # off; it is the only thing that distinguishes the two.
    local stampdir="${REAPDIR}"
    install -d -m0750 -o root -g www-data "${stampdir}" 2>/dev/null ||
      install -d -m0700 -o root -g root "${stampdir}" 2>/dev/null || :
    [ -d "${RUNDIR}/hdw4s/${inst}" ] || continue
    local stamp="${stampdir}/${inst}"
    # "unknown" first: it is not a number, and treating it as one would be an
    # arithmetic error rather than the cautious answer it is meant to be.
    if [ "${established}" = 'unknown' ] || [ "${established}" -gt 0 ]; then
      printf '%s\n' "${now}" > "${stamp}" 2>/dev/null || :
      continue
    fi
    if [ -r "${stamp}" ]; then
      last="$(cat "${stamp}" 2>/dev/null)"
    else
      # No record yet, so start the clock now rather than at the session's
      # start. Backdating would mean the first run after this is installed --
      # or after a reboot clears /run -- could stop a desktop that has been up
      # for months, immediately, with no warning to the person using it. All we
      # actually know is that nobody has connected since we began looking, and
      # measuring from that is the claim the message makes.
      last="${now}"
      printf '%s\n' "${last}" > "${stamp}" 2>/dev/null || :
    fi
    case "${last}" in ''|*[!0-9]*) continue;; esac
    # THE SECOND WITNESS, and it may only ever move the deadline LATER. The
    # reaper's stamp above is a poll and can miss a whole visit between two
    # samples; the router's record is written where the connection is accepted
    # and cannot. Taking the maximum means a missing, unreadable or absent
    # router record contributes nothing and this falls back to the sample --
    # today's behaviour exactly -- while a router that did see somebody keeps
    # their desktop alive. See router_last_request() for why it is a maximum
    # over two files rather than one merged record.
    if router_last_request "${inst}" "${now}"; then
      [ "${RLAST}" -le "${last}" ] || last="${RLAST}"
    elif [ -n "${RLAST_WHY}" ]; then
      # A record that is PRESENT and unusable is a fault worth a line every run:
      # the desktop it should have protected has no other symptom, and the
      # person it gets stopped under is a visitor who will assume it broke.
      # An ABSENT record says nothing and is silent -- that is the normal state
      # of a slot nobody has opened, and of every slot when the router is not
      # running. The message names the fault and never quotes the contents: the
      # reaper runs as root, and a diagnostic repeating a file somebody else
      # chose is how a read becomes a disclosure.
      reap_say "hdw4s: ${inst}: ignoring the router's last-request record: ${RLAST_WHY}."
    fi
    # Seconds throughout. The day-granularity arithmetic this replaces was what
    # made a sub-day value truncate to zero and read as "never reap"; with
    # seconds there is nothing left to truncate.
    age=$(( now - last ))
    [ "${age}" -ge "${window}" ] || continue

    reap_say "hdw4s: stopping ${inst}; nothing has connected for $(duration_words "${age}")."
    if ephemeral_shaped "${stype}"; then
      reap_say '  This was an ephemeral session: its home and its settings lived'
      reap_say '  in memory and are now gone. The slot is free for a new session.'
    else
      reap_say '  Its files and settings are untouched, and the next connection'
      reap_say '  starts it again.'
    fi
    systemctl stop "hdw4s-proxy@${inst}.service" 2>/dev/null || :
    systemctl stop "$(unit_of "${inst}")" 2>/dev/null || :
    stopped=$(( stopped + 1 ))
  done < "${SLOTS}"
  [ "${stopped}" -eq 0 ] || reap_say "Stopped ${stopped} idle session(s)."
}

# Whether a credential can mean anything for this session, i.e. whether anything
# it does not already exclude could present one.
#
# On a filesystem socket the answer is no, and that is the owner's ruling rather
# than a judgement made here: the socket is group-owned by the reverse proxy and
# readable by nobody else, so the only caller that can open it is the one that
# would be handed the secret. Adding a credential there excludes nothing and
# costs a 401.
# A credential on this session would keep nobody out AND would break it.
#
# Keyed on the session TYPE, not the transport. It used to ask whether the
# session was on a filesystem socket, which refused a NAMED session on one too --
# and the owner ruled that wrong: "if the admin configures named sessions to run
# over a unix domain socket, because they installed the reverse proxy in the same
# container, then that's a defensible choice and we should make it possible."
# Refusing it made a supported configuration fail safely rather than work.
#
# The real reason is narrower and applies to ephemeral slots alone: the
# demultiplexer in front of them holds NO credential and cannot present one --
# measured, it loads exactly one, its own front door's, and the per-slot drop-in
# a comment used to describe exists nowhere. So a slot carrying a credential
# answers 401 to everything routed to it, alone, while its neighbours work, which
# reads as a routing fault rather than as configuration.
#
# A named session has a reverse proxy that CAN be told the secret. That the owner
# neither requires nor encourages one there is a separate matter, and it is his
# to decide per deployment rather than ours to enforce.
auth_is_meaningless() {
  ephemeral_shaped "$(type_of "$1")"
}

cmd_auth() {
  local inst="$1"
  # Refused, not warned about, and refused HERE because this is the only thing
  # in the tree that writes HDW4S_AUTH=basic for one session -- "hdw4s enable"
  # reaches the same shape by calling this function, so one refusal covers both.
  #
  # Written from the failure: ephemeral0 on the test container carried
  # HDW4S_AUTH=basic while ephemeral1 and ephemeral2 did not, all three on the
  # filesystem socket. A demultiplexer connecting to ephemeral0.sock got a 401
  # and the other two answered, so a routing test passed against one slot of a
  # pool and failed against its neighbour. That is the expensive kind of wrong:
  # the failure is real, reproducible, and attributed to the thing being tested.
  if auth_is_meaningless "${inst}"; then
    die "hdw4s: ${inst} is an ephemeral slot, and nothing can present a credential to it." \
        '  A visitor arrives at one well-known hostname and a front door on this' \
        '  machine picks the slot. That front door holds one credential -- its own,' \
        '  for the leg in front of it -- and there is no per-slot credential and no' \
        '  way to give it one. This is not a stricter setting with a missing step;' \
        '  there is no second party, and no configuration finishes it.' \
        '' \
        '  What it would do is answer 401 to every visitor routed here while the' \
        '  other slots answer, which reads as a routing fault and is not one.' \
        '' \
        '  A named desktop is a different thing: its reverse proxy is configured by' \
        "  hand and can be told a secret, so 'hdw4s auth' is available for one on" \
        '  either transport.'
  fi
  require_slot "${inst}"
  # >/dev/null although make_credential no longer prints anything: the caller
  # does not get to depend on the callee staying silent. Without it, the day
  # somebody reinstates a return channel, the plaintext lands on the user's
  # terminal -- which is exactly what the test with the printing stub
  # demonstrates. NOT a capture: $( ) would put it back in a variable, and it
  # would also put `die` in a subshell where its exit reaches nobody.
  make_credential "${inst}" 'auth' 70 >/dev/null
  config_write "${ETCDIR}/${inst}.conf" 'HDW4S_AUTH' 'basic'

  echo "Session ${inst} will now require a credential of its own, in addition"
  echo 'to the firewall. The reverse proxy has to present it; the user never'
  echo 'sees it, so there is still no login screen.'
  echo
  echo "  hdw4s proxy ${inst}     prints an nginx block that does this"
  echo
  echo "Restart the session for this to take effect:"
  echo "  systemctl restart $(unit_of "${inst}")"
}

cmd_noauth() {
  local inst="$1"
  split_instance "${inst}" || fail
  # Existence, not readability: see has_auth. Asking whether we can read a
  # root-only file makes the answer depend on who is asking.
  [ -e "${ETCDIR}/${inst}.auth.cred" ] ||
    [ "$(setting_of "${inst}" HDW4S_AUTH none)" = 'basic' ] || {
      echo "Session ${inst} already has no credential."
      return 0
    }
  rm -f "${ETCDIR}/${inst}.auth.cred" \
        "$(dropin_of "${inst}")/70-auth.conf"
  config_write "${ETCDIR}/${inst}.conf" 'HDW4S_AUTH' 'none'
  systemctl daemon-reload
  echo "Session ${inst} no longer requires a credential."
  echo '  Whatever can reach its port now gets this desktop. That is a'
  echo '  reasonable choice when the port is reachable only over a filesystem'
  echo '  socket, or from a network nothing untrusted is on. It is not one to'
  echo '  make by accident.'
  echo "  Restart it to take effect: systemctl restart $(unit_of "${inst}")"
}

# The port the front door listens on, read from the socket unit rather than
# printed as a constant. A comment in that unit promises "hdw4s demux port" for
# changing it; that command has never existed, so a constant here would be a
# number nobody can change and nothing would say so.
demux_port() {
  local v
  # systemd prints this as "[::]:7280 (Stream)" -- address first, kind in
  # parentheses after. The first version of this matched "^Stream (.*)$", which
  # is neither the order nor the syntax, so it silently fell through to the
  # placeholder and shipped a config block naming no port at all. Measured on a
  # live unit; do not rewrite this from memory of what systemd "should" print.
  v="$(systemctl show 'hdw4s-demux.socket' -p Listen --value 2>/dev/null |
       grep -F '(Stream)' | tail -n1)"
  v="${v%% *}"          # drop " (Stream)"
  v="${v##*:}"        # drop [::] or an address, keep the port
  case "${v}" in ''|*[!0-9]*) echo 'THE_FRONT_DOOR_PORT';; *) echo "${v}";; esac
}

cmd_proxy() {
  local inst="$1" idx port cred user pw
  split_instance "${inst}" || fail

  # BEFORE the slot lookup, deliberately. A slot that has been minted but not
  # yet enabled has no row, and that is exactly the machine whose operator most
  # needs this answer -- so looking the row up first would kill the command on
  # the only occasion it matters.
  #
  # And this is a REDIRECTION, not a refusal. What it used to print was a
  # working server block that proxy_pass'd straight at one slot's socket,
  # bypassing the front door that picks slots and enforces the arrival rule,
  # together with the instruction to add nginx's user to the group that owns
  # it -- the precise change that opens the bypass. That text was correct when
  # a session's socket was the only kind there was; it became a recipe the day
  # the pool shipped, and nothing failed and no test noticed.
  # type_of() reads the slot table, so it cannot answer for a slot that has been
  # minted and not yet enabled -- which is the very case this branch was moved up
  # to serve. So ask the MACHINE as well: minting creates a runtime profile
  # directory per slot, and that exists before any row does.
  local looks_ephemeral='no' whatitis
  ! ephemeral_shaped "$(type_of "${inst}")" || looks_ephemeral='yes'
  [ ! -d "/run/hdw4s-profile/${inst}" ] || looks_ephemeral='yes'
  # What it IS, derived from the row, because the guidance below is the same for
  # both and the first sentence is not: an authoring slot is reached through the
  # pool's front door and still is not one slot of the pool. Saying it is would
  # be a comment in a generated file asserting something untrue about the very
  # slot it was generated for.
  # Keyed on "template" itself rather than on the negation of pool membership,
  # because looks_ephemeral is also set by the runtime-profile probe above for a
  # slot minted and not yet enabled -- which is typed "desktop" and is not the
  # authoring slot. A negation would have called that one a template.
  if [ "$(type_of "${inst}")" = 'template' ]; then
    whatitis="is the template-authoring slot, reached through the same front door
# as the pool and never handed to a visitor, so it is not configured slot by slot
# either"
  else
    whatitis="is one slot of the ephemeral pool, and a pool is not configured slot
# by slot"
  fi
  if [ "${looks_ephemeral}" = 'yes' ]; then
    cat <<EOF
# ${inst} ${whatitis}. Visitors arrive at ONE hostname for the whole pool; the pool chooses
# which slot each visitor gets, and gives a returning visitor back the session
# they already have. A block pointing nginx at this slot's own socket would bypass
# that -- every visitor would land on ${inst}, and the arrival rule that decides
# whether to resume, gate or mint would never run.
#
# So the configuration below is for the POOL. It is the same for every slot, and
# running this command against a different slot prints the same thing.
#
# The facts behind it, which outlive this block:
#
#   * one hostname serves the whole pool; slots have no hostnames of their own
#   * the pool answers on 127.0.0.1:$(demux_port), and that is the ONLY
#     address a visitor may be sent to
#   * the credential belongs to the pool, not to a slot; slots have none and
#     cannot be given one
#   * a slot's own socket under /run/hdw4s-proxy must NOT be reached directly,
#     by nginx or by anything else
#
# See hdw4s(8), "THE EPHEMERAL POOL".

server {
    listen 443 ssl;
    server_name ephemeral.example.com;

    # ssl_certificate     /etc/ssl/certs/...;
    # ssl_certificate_key /etc/ssl/private/...;

    # ... your own authentication here: auth_request, OIDC, client certs ...
    # The pool performs none. Whatever reaches it gets a desktop.

    location / {
        proxy_pass http://127.0.0.1:$(demux_port);
        proxy_http_version 1.1;

        # The stream is a WebSocket; without these it will connect and then
        # sit there.
        proxy_set_header Upgrade    \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       \$host;
        proxy_set_header X-Real-IP  \$remote_addr;

        # A desktop is idle for long stretches and must not be timed out.
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;

        # REVALIDATE THE SERVED CLIENT. Do not drop these two lines. The page
        # carries the arrival gate, and a cached copy silently serves a client
        # without one -- invisible from the server, which is busy serving the
        # correct page to everyone whose cache happens to be cold.
        proxy_hide_header   Cache-Control;
        add_header          Cache-Control "no-cache" always;

        # The pool's credential goes here. It is the proxy's, not a
        # user's, so there is still no login screen.
        # proxy_set_header Authorization "Basic <see /etc/hdw4s/demux.auth.cred>";
    }
}
EOF
    return 0
  fi

  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] || die "hdw4s: ${inst} has no slot."
  port="$(port_of "${idx}")"
  cred="${ETCDIR}/${inst}.auth.cred"

  # Match whichever transport the session is actually configured for; an
  # nginx block pointing at a port that is no longer listening is a confusing
  # way to spend an afternoon.
  local transport upstream
  transport='tcp'
  [ ! -r "${ETCDIR}/${inst}.conf" ] ||
    transport="$(sed -n "s/^[[:space:]]*HDW4S_TRANSPORT=[\"']\{0,1\}\([a-z]*\).*/\1/p" \
                 "${ETCDIR}/${inst}.conf" | tail -n1)"
  # An ephemeral slot has no other answer -- "hdw4s transport" refuses to put
  # one on TCP -- so it is decided here rather than read, and it overrides the
  # file rather than defaulting under it. Two cases the file gets wrong: a slot
  # minted but not yet enabled has no file at all, and one enabled by an older
  # version has a file still saying "tcp". Either would print a port block for
  # a session that does not listen on one.
  ! ephemeral_shaped "$(type_of "${inst}")" || transport='unix'
  if [ "${transport}" = 'unix' ]; then
    upstream="        # A filesystem socket: who may connect is a question of
        # permissions, not of source address. Add nginx's user to the group
        # that owns it.
        proxy_pass http://unix:/run/hdw4s-proxy/${inst}.sock:;"
  else
    upstream="        proxy_pass http://HOST_RUNNING_HDW4S:${port};"
  fi

  pw=''
  if [ -e "${cred}" ] && [ ! -r "${cred}" ]; then
    die "hdw4s: ${cred} exists but is not readable by $(id -un).
  It holds the credential this block has to carry, so the block would be
  wrong rather than merely incomplete. Run this as root."
  fi
  if [ -r "${cred}" ]; then
    pw="$(systemd-creds decrypt --name=hdw4s-auth "${cred}" - 2>/dev/null)" || {
      echo "# Could not decrypt ${cred}; is this the machine that wrote it?" >&2
      pw=''
    }
  fi

  cat <<EOF
# nginx configuration for the hdw4s session "${inst}".
#
# Terminate TLS and authenticate your users here. Everything below assumes
# that has already happened: the session performs no user authentication and
# will hand a full desktop to whatever reaches it.

server {
    listen 443 ssl;
    server_name ${inst}.example.com;

    # ssl_certificate     /etc/ssl/certs/...;
    # ssl_certificate_key /etc/ssl/private/...;

    # ... your own authentication here: auth_request, OIDC, client certs ...

    # Give this desktop its own name in the browser tab. The client sets
    # document.title from the "name" in manifest.json -- it hardcodes "Selkies"
    # and then overwrites it from the manifest -- so serving a manifest here is
    # the supported way to tell two desktops apart, and needs no patched
    # client. The exact match wins over the "location /" below.
    location = /manifest.json {
        default_type application/json;
        return 200 '{"name":"Desktop: ${inst}","short_name":"${inst}","display":"fullscreen","background_color":"#000000","theme_color":"#000000","icons":[{"src":"icon-512.png","type":"image/png","sizes":"512x512"}],"start_url":"."}';
    }

    location / {
${upstream}
        proxy_http_version 1.1;

        # The stream is a WebSocket; without these it will connect and then
        # sit there.
        proxy_set_header Upgrade    \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       \$host;
        proxy_set_header X-Real-IP  \$remote_addr;

        # A desktop is idle for long stretches and must not be timed out.
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;

        # REVALIDATE THE SERVED CLIENT. Do not drop these two lines.
        #
        # The streaming server sends an ETag and a Last-Modified and no
        # Cache-Control at all, so a browser applies heuristic freshness and
        # reuses index.html without asking. That page carries the takeover gate,
        # so a cached copy SILENTLY SERVES A CLIENT WITH NO GATE -- and it is
        # invisible from the server, which is busy serving the correct page to
        # everyone whose cache happens to be cold. Found the day the gate
        # shipped, by a person whose own browser kept the pre-gate client while
        # every test against a fresh profile passed.
        #
        # "no-cache" rather than "no-store": the browser may keep its copy, it
        # just may not use it without revalidating. With the ETag above, an
        # unchanged asset costs a 304 and no bytes, so this buys correctness
        # without giving up the cache.
        proxy_hide_header   Cache-Control;
        add_header          Cache-Control "no-cache" always;

        # If you add a Content-Security-Policy here -- and a hardened proxy
        # usually does -- script-src must allow blob:. The streaming server
        # plays audio through an AudioWorklet it loads from a blob URL, and a
        # policy without it takes the sound away and nothing else: the picture,
        # the input and the resizing all keep working, the audio packets go on
        # arriving, and the page retries loading the worklet for as long as it
        # is open. Allowing blob: under default-src is not enough, because
        # script-src overrides it for worklets.
        #
        #   add_header Content-Security-Policy "... script-src 'self' blob: ...";
EOF
  if [ -n "${pw}" ]; then
    cat <<EOF

        # Presented by the proxy, never by the user, so there is still no
        # login screen. This is what an attacker who reaches the session port
        # directly -- by spoofing the proxy's address, say -- does not have.
        # This line carries the session's credential. Whatever file you paste
        # it into is readable by every account on that machine at the usual
        # 0644, which is the audience the credential exists to keep out --
        # so give the file 0640 root:www-data, or whatever group nginx runs as.
        proxy_set_header Authorization "Basic $(printf '%s:%s' "${user}" "${pw}" | base64 -w0)";
EOF
  else
    cat <<'EOF'

        # This session has no credential of its own, so the firewall is the
        # only thing protecting it. Run "hdw4s auth" on this session to add
        # one. (An ephemeral slot never reaches this line: it cannot be given
        # a credential, and its configuration is printed above instead.)
EOF
  fi
  cat <<'EOF'
    }
}
EOF
  unset pw
}

# Anything below these names is a cache: regenerable, frequently enormous, and
# actively unhelpful to carry across. Browsers are the reason this list is not
# just ".cache" -- Chrome keeps gigabytes of cache inside its profile
# directory, mixed in with the bookmarks and passwords that are worth keeping.
SEED_EXCLUDES=(
  'keyrings'                    # the isolated session has its own, with its own password
  'dconf/*-lock'
  '*/Cache' '*/Cache Data' '*/Code Cache' '*/GPUCache' '*/DawnCache'
  '*/GrShaderCache' '*/ShaderCache' '*/CacheStorage' '*/component_crx_cache'
  '*/Crash Reports' '*/Crashpad' '*/blob_storage'
  '*/Service Worker/CacheStorage' '*/Service Worker/ScriptCache'
  '*/optimization_guide_model_store' '*/segmentation_platform'
  # Downloaded models and component data. Regenerable, and much larger than
  # everything else put together: the on-device language model a current Chrome
  # fetches is nearly three gigabytes on its own, per profile.
  'OptGuideOnDeviceModel' '*/OptGuideOnDeviceModel'
  'OnDeviceHeadSuggestModel' '*/OnDeviceHeadSuggestModel'
  'WasmTtsEngine' '*/WasmTtsEngine'
  'Safe Browsing' '*/Safe Browsing'
  'SafetyTips' '*/SafetyTips' 'ZxcvbnData' '*/ZxcvbnData'
  'hyphen-data' '*/hyphen-data' 'SSLErrorAssistant' '*/SSLErrorAssistant'
  'Subresource Filter' '*/Subresource Filter'
  'TrustTokenKeyCommitments' '*/TrustTokenKeyCommitments'
  'MEIPreload' '*/MEIPreload' 'PKIMetadata' '*/PKIMetadata'
)

cmd_seed() {
  local inst="$1" from to pair pattern args=() copied=0 only=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --only)   [ $# -ge 2 ] || die 'hdw4s: --only needs a path.'
                only+=("$2"); shift 2;;
      --only=*) only+=("${1#--only=}"); shift;;
      *)        die "hdw4s: seed: unexpected argument '$1'";;
    esac
  done
  split_instance "${inst}" || fail
  [ -n "$(slot_of "${inst}")" ] ||
    die "hdw4s: ${inst} has no slot; run 'hdw4s enable ${inst}' first."

  # setting_of, not a second copy of it: reading only the instance file meant a
  # site that set HDW4S_ISOLATION=profile globally was told its sessions were
  # not isolated, which is the normal way to configure this.
  local isolation
  isolation="$(setting_of "${inst}" HDW4S_ISOLATION none)"
  [ "${isolation}" = 'profile' ] ||
    die "hdw4s: ${inst} is not an isolated session; there is nothing to seed into." \
        "  Run 'hdw4s set ${inst} HDW4S_ISOLATION=profile' first."

  # Copying out from under a running desktop would capture half-written state.
  [ "$(systemctl is-active "$(unit_of "${inst}")" 2>/dev/null)" != 'active' ] ||
    die "hdw4s: stop ${inst} first: systemctl stop $(unit_of "${inst}")"

  local home profile
  home="$(getent passwd -- "${user}" | cut -d: -f6)"
  profile="$(profile_dir_of "${inst}")/${inst}"

  # This runs once and never merges. A profile that already has something in it
  # is a profile someone has used, and overwriting it would lose whichever of
  # the two copies happened to be newer -- silently, because nothing here can
  # tell which that is.
  for pair in config data state; do
    [ ! -d "${profile}/${pair}" ] ||
      [ -z "$(ls -A "${profile}/${pair}" 2>/dev/null)" ] ||
      die "hdw4s: ${profile}/${pair} is not empty." \
          '  Seeding copies once, into an empty profile, and never merges: there' \
          '  is no way to tell which of two copies of a setting is the newer one.' \
          "  Remove the profile first if you really mean to start it over."
  done

  # Checked before anything is opened. The prefix test below is a string test,
  # so ".config/../../../etc/shadow" passes it; tar then strips the leading
  # "./../../../" from the member name and the file lands in the profile under
  # a harmless-looking path. Nothing about a seeded path should ever leave the
  # home directory.
  local entry
  for entry in "${only[@]:-}"; do
    [ -n "${entry}" ] || continue
    case "/${entry}/" in
      */../*) die "hdw4s: '${entry}' leaves the home directory." \
                  '  A seeded path may not contain "..".';;
    esac
  done

  # The profile is created by systemd as StateDirectory and is owned by the
  # session user, who can therefore replace one of these with a symlink and
  # have root extract into whatever it points at.
  for pair in config data state; do
    [ ! -L "${profile}/${pair}" ] ||
      die "hdw4s: ${profile}/${pair} is a symbolic link; refusing to write through it."
  done
  [ ! -L "${profile}" ] ||
    die "hdw4s: ${profile} is a symbolic link; refusing to write through it."

  for pattern in "${SEED_EXCLUDES[@]}"; do args+=(--exclude="${pattern}"); done

  echo "Copying settings from ${home} into ${profile}."
  # An --only path that names none of the three trees below matched nothing and
  # said nothing, so "--only .mozilla" -- the case the manual singles out --
  # copied silently less than the administrator asked for.
  local -A matched=()
  for pair in "config:.config" "data:.local/share" "state:.local/state"; do
    to="${profile}/${pair%%:*}"
    from="${home}/${pair#*:}"
    [ -d "${from}" ] || continue

    # Without --only the whole tree is copied. With it, only the named entries
    # are, which is the usual case for an account that has been in use for
    # years: most of what has collected in there belongs to programs that will
    # never run in this session, and copying it forward just carries the
    # accumulation into a second place.
    local members=() entry rel
    if [ "${#only[@]}" -gt 0 ]; then
      for entry in "${only[@]}"; do
        rel="${entry#./}"
        case "${rel}" in "${pair#*:}"/*) matched["${entry}"]=1;; *) continue;; esac
        rel="${rel#"${pair#*:}"/}"
        if [ -e "${from}/${rel}" ] || [ -L "${from}/${rel}" ]; then
          members+=("./${rel}")
        else
          echo "  ${entry}: not there, skipped" >&2
        fi
      done
      [ "${#members[@]}" -gt 0 ] || continue
    else
      members=(.)
    fi

    install -d -m0700 "${to}"
    # tar rather than cp, because the exclusions are the whole point and cp has
    # no way to express them.
    # Read as the account that owns the home directory, not as root. ~/.config
    # belongs to the session user, who can replace it with a link to /root or
    # /etc; root would follow it, copy what it found, and then chown the copies
    # to that user. Dropping to the user first means the kernel refuses instead.
    if runuser -u "${user}" -- tar -C "${from}" -cf - "${args[@]}" \
           --warning=no-file-ignored "${members[@]}" 2>/dev/null |
       tar -C "${to}" -xf - 2>/dev/null; then
      printf '  %-14s %s\n' "${pair#*:}" "$(du -sh "${to}" 2>/dev/null | cut -f1)"
      copied=$(( copied + 1 ))
    else
      echo "  ${pair#*:}: copy failed" >&2
    fi
  done
  for entry in "${only[@]:-}"; do
    [ -n "${entry}" ] || continue
    [ -n "${matched[${entry}]:-}" ] || {
      echo "  ${entry}: outside .config, .local/share and .local/state; not copied" >&2
    }
  done

  chown -R "${user}" "${profile}" 2>/dev/null || :

  [ "${copied}" -gt 0 ] || die 'hdw4s: nothing was found to copy.'
  cat <<EOF

This was a one-time snapshot, not a link. From now on the two are separate:
a change made in one will not appear in the other, and running this again is
refused rather than silently overwriting whichever copy is newer.

Caches were left behind on purpose, browser caches included -- they are
regenerable and are usually most of the size.

Saved passwords were not copied. The session has its own keyring with its own
password; see 'hdw4s keyring ${inst}'.
EOF
}

cmd_keyring() {
  local inst="$1"
  require_slot "${inst}"

  # A keyring is only separate if the data directory holding it is. Without
  # isolation, XDG_DATA_HOME is the account's own ~/.local/share, so this would
  # point gnome-keyring at the login keyring and try to unlock it with a
  # freshly generated password. That fails, leaving one line on stderr -- after
  # telling the administrator the two are separate, which they are not.
  if [ "$(setting_of "${inst}" HDW4S_ISOLATION none)" != 'profile' ]; then
    die "hdw4s: ${inst} shares the account's home directory." \
        '  A separate keyring needs a separate data directory. Set' \
        "  'hdw4s set ${inst} HDW4S_ISOLATION=profile' first, or the keyring" \
        "  this would create could not be reached and the account's own login" \
        '  keyring would be the one unlocked.'
  fi

  make_credential "${inst}" 'keyring' 60 >/dev/null

  echo "Session ${inst} now has its own keyring, unlocked automatically."
  echo "It is separate from the account's login keyring, so passwords saved in"
  echo "one are not visible in the other."
  echo "Restart the session for this to take effect:"
  echo "  systemctl restart $(unit_of "${inst}")"
}

cmd_disable() {
  local inst="$1"
  split_instance "${inst}" || fail
  systemctl disable --now "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
  systemctl stop "hdw4s-proxy@${inst}.service" 2>/dev/null || :
  systemctl stop "$(unit_of "${inst}")" 2>/dev/null || :
  echo "Session ${inst} stopped. Its slot is still reserved;"
  echo "use 'hdw4s release ${inst}' to give it up."
}

cmd_release() {
  local inst="$1" tmp
  # An account that has since been deleted still holds a slot, and its port
  # stays open in the firewall. Refusing to release it because the account is
  # gone leaves editing the table by hand as the only way out -- which its own
  # header tells the administrator never to do. The name is still checked: it
  # is interpolated into the paths this function removes.
  #
  # The legacy spelling for the same reason: an instance named "<user>:<session>"
  # by a version that still created them is exactly the instance an administrator
  # now needs to be able to retire, so this is the one command that accepts the
  # name the rest of the tool refuses.
  split_legacy_name "${inst}" || fail
  systemctl disable --now "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
  systemctl stop "hdw4s-proxy@${inst}.service" "$(unit_of "${inst}")" 2>/dev/null || :
  # The filesystem socket, which systemd will not remove for a unit that is
  # listening on a port: its address list no longer names a path, so there is
  # nothing for RemoveOnStop= to unlink. Measured -- releasing a session left
  # its socket behind and the demultiplexer went on enumerating it, now for an
  # instance with no configuration, no slot row and no unit at all, which is
  # worse than the orphan it started as because nothing keyed on instance
  # identity has anything left to match.
  rm -f "${RUNDIR}/hdw4s-proxy/${inst}.sock"
  rm -rf "$(dropin_of "${inst}")" \
         "${DROPIN}/hdw4s-proxy@${inst}.service.d" \
         "${DROPIN}/hdw4s-proxy@${inst}.socket.d"
  rm -f "${ETCDIR}/${inst}.keyring.cred" "${ETCDIR}/${inst}.auth.cred"
  if [ -r "${SLOTS}" ]; then
    tmp="$(mktemp "${SLOTS}.XXXXXX")"
    awk -v i="${inst}" '$1 ~ /^#/ || $2 != i' "${SLOTS}" > "${tmp}"
    chmod 0644 "${tmp}"
    mv "${tmp}" "${SLOTS}"
  fi
  systemctl daemon-reload
  echo "Session ${inst} released. Its credentials were removed with it, so a"
  echo 'keyring in the profile below can no longer be unlocked. Left in place:'
  echo "its profile under"
  echo "$(profile_dir_of "${inst}")/${inst}, and its settings in"
  echo "${ETCDIR}/${inst}.conf."
  case "${inst}" in
    # Nothing can enable this name again, so saying the leftovers are there to
    # be restored would be an offer that cannot be taken up. Say what they
    # actually are: rubbish, and safe to delete once anything wanted out of the
    # profile has been taken.
    *:*)
      echo 'Nothing can enable that name again -- an account has one desktop --'
      echo 'so both are now only a copy to salvage settings from, and can be'
      echo 'deleted once you are done with them.';;
    *)
      echo 'Re-enabling the session restores them. The slot, and with it the'
      echo 'port, is not reserved and may go to someone else; enabling again'
      echo 'rewrites the port that conf file records.';;
  esac
}

# REFUSE AN UNREADABLE SLOT TABLE HERE, ONCE, BEFORE ANY COMMAND RUNS.
#
# Every predicate below asks the table what kind of session a slot is, and
# type_of answers "unreadable" when it cannot read it. ephemeral_shaped then
# refuses rather than guessing -- which is right, and which FAILS OPEN at the
# only place it matters: unit_of() consults it, and all nineteen callers of
# unit_of use $(unit_of ...). A die inside a command substitution kills the
# SUBSHELL, so the message is printed in full and the caller carries on with an
# empty string.
#
# MEASURED on this tree, table at mode 000, before this guard existed:
#
#     type_of eph0   -> unreadable
#     unit_of eph0   -> ""            <- the die was printed and swallowed
#     dropin_of eph0 -> ${DROPIN}/.d
#
# So "systemctl stop ''", a BindsTo= written into a drop-in directory named
# ".d", and hdw4s set writing there. That is this project's own recorded trap --
# die inside $(...) fails OPEN, loud and stopping nothing -- reproduced inside
# the commit whose own message warns about it.
#
# The repair is not to make the predicate die harder; a predicate that dies is
# the trap. It is to ensure NOTHING EVER SEES "unreadable" THROUGH A
# SUBSTITUTION. The table is read by every command that takes a slot, so one
# refusal here covers all of them and leaves the predicate's own die as an
# unreachable backstop rather than the load-bearing check.
#
# Absence is NOT this case: a missing table is a box with no slots yet, which
# several commands handle and which "hdw4s enable" exists to fix. Only a table
# that is PRESENT AND UNREADABLE is refused, because that is the state where
# every answer below would be a guess.
if [ -e "${SLOTS}" ] && [ ! -r "${SLOTS}" ]; then
  die "hdw4s: ${SLOTS} exists but cannot be read." \
      '  Every command here asks that file what kind of session a slot is, so' \
      '  continuing would mean guessing -- and a wrong guess puts a pooled slot' \
      '  on a TCP port and binds its relay to a unit that will never start.' \
      '  Check its permissions and run this again.'
fi

case "${1:-}" in
  list)     shift; cmd_list "$@";;
  check)    shift; [ $# -eq 0 ] || usage_error; cmd_check "$@";;
  show)     shift; [ $# -eq 1 ] || usage_error; cmd_show "$@";;
  enable)   shift
            case "${1:-}" in --ephemeral|--template) [ $# -eq 2 ] || usage_error;;
                         *)           [ $# -eq 1 ] || usage_error;; esac
            cmd_enable "$@";;
  disable)  shift; [ $# -eq 1 ] || usage_error; cmd_disable "$@";;
  keyring)  shift; [ $# -eq 1 ] || usage_error; cmd_keyring "$@";;
  seed)     shift; [ $# -ge 1 ] || usage_error; cmd_seed "$@";;
  reap)     shift; cmd_reap "$@";;
  auth)     shift; [ $# -eq 1 ] || usage_error; cmd_auth "$@";;
  noauth)   shift; [ $# -eq 1 ] || usage_error; cmd_noauth "$@";;
  transport) shift; [ $# -eq 2 ] || usage_error; cmd_transport "$@";;
  proxy)    shift; [ $# -eq 1 ] || usage_error; cmd_proxy "$@";;
  set)      shift; cmd_set "$@";;
  unset)    shift; cmd_unset "$@";;
  release)  shift; [ $# -eq 1 ] || usage_error; cmd_release "$@";;
  firewall) shift; exec /usr/lib/hdw4s/hdw4s-firewall "$@";;
  --version) echo "hdw4s ${HDW4S_VERSION}";;
  -h|--help|help|'') usage;;
  *) echo "hdw4s: unknown command '$1'" >&2; usage >&2
     trap '' INT TERM QUIT HUP EXIT ERR; exit 2;;
esac
