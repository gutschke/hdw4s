#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

# shellcheck disable=SC2154  # rc is assigned inside the trap itself
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

# Exit with an explanation rather than the trap's generic complaint. The trap
# is for faults nobody anticipated; anything diagnosed here has already been
# described to the user and does not need a second, vaguer line after it.
HDW4S_VERSION='2.2.0'

die() {
  trap '' INT TERM QUIT HUP EXIT ERR
  printf '%s\n' "$@" >&2
  exit 1
}

# The same, for a fault that has already explained itself. A rejected instance
# name prints why and then stops; the trap's generic line underneath turned a
# refusal the user can act on into what looks like a bug in the tool.
fail() {
  trap '' INT TERM QUIT HUP EXIT ERR
  exit 1
}

# Wrong arguments are the user's mistake, not this program's fault. Without
# standing the trap down first they exited through it, so every mistyped
# command printed the usage text and then "Script hdw4s failed unexpectedly"
# underneath it -- which reads as a crash, and sends somebody looking for a bug
# in the tool instead of at the line they just typed.
# The command that does own a setting, spelled the way it is actually invoked.
# Not "hdw4s <owner> <instance> <value>" for all of them: turning authentication
# off is a different command rather than a different argument, so that form sent
# people to "hdw4s auth NAME none", which takes one argument too many and failed
# in front of them. A suggestion nobody can paste is worse than none.
owning_command() {
  case "$1:$3" in
    HDW4S_AUTH:none) printf 'hdw4s noauth %s' "$2";;
    HDW4S_AUTH:*)    printf 'hdw4s auth %s' "$2";;
    *)               printf 'hdw4s %s %s%s' "${OWNED_BY[$1]}" "$2" "${3:+ $3}";;
  esac
}

usage_error() {
  usage >&2
  trap '' INT TERM QUIT HUP EXIT ERR
  exit 2
}

# Every path this program writes goes through these, so that a test can point
# them somewhere disposable. Without that the tests read -- and would sooner or
# later write -- the real configuration of the machine they run on.
ETCDIR="${HDW4S_ETCDIR:-/etc/hdw4s}"
# Where this package's own helpers live.
CONF="${ETCDIR}/hdw4s.conf"
SLOTS="${ETCDIR}/instances"
DROPIN='/etc/systemd/system'

# Defaults. Every one of these may be overridden in /etc/hdw4s/hdw4s.conf.
#
# The port block is fixed and contiguous on purpose. It is reserved with the
# kernel and opened in the firewall once, at install time, so a rule can never
# lag behind which sessions happen to be running. Sessions then allocate inside
# a block that is already protected. 7300-7363 is clear of /etc/services and
# far below the ephemeral range (32768-60999), where a fixed service port would
# collide intermittently with outbound connections.
HDW4S_BASE_PORT=7300
HDW4S_BLOCK_SIZE=64

# Where an isolated session keeps its GNOME profile. Local disk by design: the
# home directory this exists to share is typically NFS, and dconf's database
# and the SQLite stores behind tracker and gvfs-metadata are documented not to
# work there.
HDW4S_PROFILE_DIR='/var/lib/hdw4s'

# shellcheck source=/dev/null
# A configuration file is a list of assignments, but nothing stops one from
# ending in a conditional that happens to be false. Sourcing then returns
# non-zero, and under -e that takes the whole program down over a file that is
# perfectly valid.
if [ -r "${CONF}" ]; then
  f="${CONF}"
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "${CONF}" || {
    echo "hdw4s: ${f} has a syntax error (above); refusing to run on a" >&2
    echo '  configuration that would be applied only as far as the error.' >&2
    echo '  Edit it by hand -- "hdw4s set" and "hdw4s unset" read the same' >&2
    echo '  file and are unavailable until it parses.' >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "${CONF}" || :
fi

usage() {
  cat <<'EOF'
Usage: hdw4s <command> [arguments]

  list                    show every configured session and its current state
  show <instance>         show one session's settings and where each came from
  enable <instance>       allocate a slot for a session and arm its front door
  disable <instance>      stop a session and keep its slot reserved
  release <instance>      stop a session and give up its slot
  set [<instance>] K=V    change one setting, keeping the rest of the file
  unset [<instance>] K    comment a setting out again, restoring the default
  transport <instance> tcp|unix
                          reach a session over the network, or over a socket
  auth <instance>         require a secret from the proxy as well as an address
  noauth <instance>       stop requiring one, and say what that means
  proxy <instance>        print an nginx configuration for a session
  seed <instance> [--only <path>]...
                          copy existing settings into an isolated profile,
                          once; --only limits the copy to the named
                          home-relative paths, e.g. --only .config/dconf
  reap                    stop desktops nobody has connected to for a long time
  keyring <instance>      give a session its own keyring, unlocked at start
  --version               print the version
  firewall --apply        rewrite the package's nftables table
  firewall --check        report whether every session port is protected
  firewall --print        print the ruleset that --apply would load
  firewall --restore      reload the table if something else flushed it

An instance is a user name. An account has one desktop:

  hdw4s enable alice

"set" and "unset" without an instance act on the defaults for every session:

  hdw4s set HDW4S_PROXIES='192.0.2.10 2001:db8::10'
  hdw4s set alice HDW4S_ISOLATION=profile

Anything the command line does not cover can still be edited by hand; these
just save a trip to an editor for the settings people change most.

See hdw4s(8) for configuration and for how to put a reverse proxy in front of
these sessions safely.
EOF
}

# --- instance names ---------------------------------------------------------

# An instance is an account name, and nothing else: one desktop per account.
#
# Versions up to 1.1 also accepted "<user>:<session>" for a second concurrent
# desktop belonging to the same account. That form is no longer created.
#
# It was withdrawn for what it cost to reason about rather than because it broke:
# two instances against one home directory, one keyring and one set of
# application single-instance locks, to deliver something that is better had by
# giving the account a desktop on a second machine -- a case this package
# supports properly, and the reason HDW4S_ISOLATION=profile exists.
#
# Instances created by an earlier version keep working and can still be shut
# down and released; see split_legacy_name below. Nothing creates a new one.
#
# Why a colon was the separator, kept because it still governs those instances
# and any future change here: systemd leaves ":" untouched when it escapes an
# instance name, so "%i" and "%I" are identical and no path built from either
# can acquire a surprise separator. A "-" would be unescaped by "%I" into "/",
# which would silently turn user "jean-luc" into "jean/luc". A ":" also cannot
# appear in a user name, because it separates the fields of /etc/passwd, so
# splitting on it can never cut a name in half.
#
# The name only. Split out from the account lookup below because "release" has
# to work for a session whose account has since been deleted, and must not buy
# that by giving up the check that keeps an instance name out of a file path.
split_name() {
  local inst="$1"
  case "${inst}" in
    *:*)
      echo "hdw4s: '${inst}' names a second session for one account." >&2
      echo '  An account has one desktop. Instances of the form' >&2
      echo '  "<user>:<session>" are no longer created; an existing one can' >&2
      echo "  still be shut down with 'hdw4s release ${inst}'." >&2
      return 1;;
  esac
  split_legacy_name "${inst}"
}

# The same checks, with the retired "<user>:<session>" form still accepted.
#
# Only "release" uses this, and it has to: an instance enabled by an earlier
# version owns a slot, a port the firewall opens, drop-ins and credentials, and
# a name the strict grammar rejects. Refusing it would leave editing the slot
# table by hand -- which its own header tells the administrator never to do --
# as the only way to clean the instance up. "release" stops the units itself, so
# this one exception is enough to retire such an instance completely; no other
# command needs to understand the old form.
split_legacy_name() {
  local inst="$1"
  user="${inst%%:*}"
  session="${inst#*:}"
  [ "${session}" != "${inst}" ] || session='1'

  case "${user}" in
    ''|*[!A-Za-z0-9._-]*)
      echo "hdw4s: '${inst}' does not name a user" >&2; return 1;;
  esac
  case "${session}" in
    ''|*[!0-9]*|0*)
      echo "hdw4s: '${inst}' has a bad session number" >&2; return 1;;
  esac
}

split_instance() {
  local inst="$1"
  split_name "${inst}" || return 1
  local uid
  uid="$(getent passwd -- "${user}" | cut -d: -f3)" || :
  [ -n "${uid}" ] || {
    echo "hdw4s: no such user: ${user}" >&2; return 1
  }
  # A session is a full desktop reachable from a browser with no
  # authentication of its own. Handing one to a system account is almost
  # certainly a mistake, and the failure mode if it is not caught is severe.
  if [ "${uid}" -lt 1000 ] && [ "${HDW4S_ALLOW_SYSTEM_USER:-}" != 'yes' ]; then
    echo "hdw4s: ${user} is a system account (uid ${uid})." >&2
    echo '  Set HDW4S_ALLOW_SYSTEM_USER=yes in the configuration if this is' >&2
    echo '  really intended.' >&2
    return 1
  fi
}

# --- slot table -------------------------------------------------------------
#
# The slot is keyed on the instance name and, once assigned, never moves. The
# obvious alternative -- deriving a port from the UID -- looks stateless but is
# not a function of the session at all: accounts that share a UID collide by
# definition, UIDs below 1000 collide after clamping, and large UIDs run off
# the end of the port range. Forty bytes of state buys a mapping that a reverse
# proxy and a firewall can both be configured against and that survives edits
# to /etc/passwd.

slot_of() {
  local inst="$1"
  [ ! -r "${SLOTS}" ] || awk -v i="${inst}" \
    '$1 !~ /^#/ && $2 == i { print $1; exit }' "${SLOTS}"
}

# What kind of session an instance is. Recorded in the table rather than guessed
# from the name, because six readers need the answer long after "hdw4s enable"
# has exited, and a name prefix would make a configurable string load-bearing in
# all of them. A row written by an older version has two fields and means
# "desktop", which is what every session was when it was written.
type_of() {
  local t=''
  [ ! -r "${SLOTS}" ] ||
    t="$(awk -v i="${1}" '$1 !~ /^#/ && $2 == i { print $3; exit }' "${SLOTS}")"
  echo "${t:-desktop}"
}

# The systemd unit that runs a given instance's desktop. One place, because a
# second kind of session means every "hdw4s@${inst}" spelled out by hand is a
# site that silently acts on the wrong unit -- and acting on the wrong unit is
# quiet: it starts something, so nothing reports an error.
unit_of() {
  case "$(type_of "${1}")" in
    ephemeral) echo "hdw4s-ephemeral@${1}.service";;
    *)         echo "hdw4s@${1}.service";;
  esac
}

# Where that unit's drop-ins live. Writing one into the other unit's directory is
# the failure this exists to prevent: it lands, systemd never reads it, and the
# session fails for a reason the file would have fixed.
dropin_of() {
  echo "${DROPIN}/$(unit_of "${1}").d"
}

alloc_slot() {
  local inst="$1" type="${2:-desktop}" idx used lock
  install -d -m0755 "$(dirname "${SLOTS}")"
  [ -e "${SLOTS}" ] || {
    printf '%s\n' \
      '# Session slots. One line per session: <index> <instance> <type>.' \
      '# The index fixes the port (base + index); it is assigned once and does' \
      '# not move, so proxy and firewall configuration stays valid. Remove a' \
      '# line only with "hdw4s release", never by hand while a session runs.' \
      > "${SLOTS}"
  }

  # Scanning for a free slot and claiming it have to be one operation. They
  # were not, so two "hdw4s enable" runs at once -- two administrators, or a
  # configuration management pass -- read the same table, picked the same
  # index, and appended both. Every socket unit but one then failed to bind.
  exec {lock}<>"${SLOTS}"
  flock "${lock}"

  # Inside the lock, not before it: asking whether this instance already has a
  # slot and then claiming one are the same decision, and two runs for the same
  # name raced between them and were handed three different indices.
  idx="$(slot_of "${inst}")"
  if [ -n "${idx}" ]; then
    exec {lock}<&-
    echo "${idx}"
    return 0
  fi

  used="$(awk '$1 !~ /^#/ { print $1 }' "${SLOTS}" | sort -n)"
  for ((idx = 0; idx < HDW4S_BLOCK_SIZE; idx++)); do
    grep -qx "${idx}" <<<"${used}" || break
  done
  if [ "${idx}" -ge "${HDW4S_BLOCK_SIZE}" ]; then
    exec {lock}<&-
    echo "hdw4s: all ${HDW4S_BLOCK_SIZE} session slots are in use." >&2
    echo "  Raise HDW4S_BLOCK_SIZE in ${CONF} and rerun 'hdw4s firewall --apply'." >&2
    return 1
  fi
  printf '%s %s %s\n' "${idx}" "${inst}" "${type}" >> "${SLOTS}"
  exec {lock}<&-
  echo "${idx}"
}

port_of() {
  local idx="$1"
  echo $(( HDW4S_BASE_PORT + idx ))
}

# Where the streaming server itself listens, on loopback only. The socket unit
# owns the port the outside world connects to and forwards to this one, so the
# two cannot be the same. A second block immediately above the first keeps the
# arithmetic obvious and both blocks reservable in one range.
internal_port_of() {
  local idx="$1"
  echo $(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE + idx ))
}

# --- commands ---------------------------------------------------------------

# The effective value of a setting for one session: its own file if it says
# anything, otherwise the site default, otherwise the fallback given here.
# The value and the file it came from, tab-separated. Which of the two files
# won is the single most common source of confusion in a layered
# configuration, so the answer is computed once, here, and both the plain
# lookup and "show" read it from the same place.
setting_with_source() {
  local inst="$1" key="$2" fallback="$3" v=''
  local f
  # An ephemeral slot takes several of its settings from its unit rather than
  # from a conf file -- the profile directory and the isolation mode among them
  # -- and Environment= in the unit beats the EnvironmentFile= lines above it, so
  # that is the value in force. Reading only the conf files made this command
  # report a profile under /var/lib/hdw4s that has never existed for such a
  # session, and an isolation mode it does not run with. Ask systemd rather than
  # keeping a second copy of the unit's values here, which would be one more
  # thing able to disagree with it.
  if [ "$(type_of "${inst}")" = 'ephemeral' ]; then
    v="$(systemctl show "$(unit_of "${inst}")" -p Environment --value 2>/dev/null |
           tr ' ' '\n' | sed -n "s/^${key}=//p" | tail -n1)"
    [ -z "${v}" ] || { printf '%s\t%s' "${v}" "$(unit_of "${inst}")"; return 0; }
  fi
  for f in "${ETCDIR}/${inst}.conf" "${CONF}"; do
    [ -r "${f}" ] || continue
    v="$(sed -n "s/^[[:space:]]*${key}=[\"']\{0,1\}\([^\"'#]*\).*/\1/p" \
         "${f}" | tail -n1 | sed 's/[[:space:]]*$//')"
    [ -z "${v}" ] || { printf '%s\t%s' "${v}" "${f}"; return 0; }
  done
  printf '%s\t' "${fallback}"
}

setting_of() {
  local r
  r="$(setting_with_source "$1" "$2" "$3")"
  printf '%s' "${r%%$'\t'*}"
}

# Where a session's profile lives. hdw4s-session honours the instance file, so
# everything that names this directory has to read it the same way: "seed" used
# the globally sourced variable and so populated a directory the session would
# never look at, saying it had seeded the profile.
profile_dir_of() {
  setting_of "$1" HDW4S_PROFILE_DIR "${HDW4S_PROFILE_DIR:-/var/lib/hdw4s}"
}

# Whether a session has a credential of its own that a proxy must present.
#
# Existence, not readability. The credential is root-only, so asking whether we
# can read it answered "no credential" for every unprivileged caller -- and
# "list" then counted the session as unprotected and printed the warning about
# the firewall being the only thing in the way, about a session that was in fact
# authenticated. A security report that depends on who is reading it is worse
# than none. Anything that needs the value itself, rather than the fact, checks
# readability where it reads.
# Re-point an existing credential at the unit's drop-in directory, without
# rotating it. "hdw4s enable" is documented as safe to re-run, and a session that
# already has a credential must not be handed a new one -- the reverse proxy is
# configured with the old one and would start answering 401. But the drop-in can
# legitimately be absent: it was written under a different unit name before the
# session's type was recorded, or removed by "hdw4s release".
link_credential() {
  local inst="$1" name="$2" order="$3" cred="${ETCDIR}/${1}.${2}.cred"
  [ -e "${cred}" ] || return 0
  install -d -m0755 "$(dropin_of "${inst}")"
  printf '%s\n' \
    "# Written by \"hdw4s ${name}\"." \
    '[Service]' \
    "LoadCredentialEncrypted=hdw4s-${name}:${cred}" \
    > "$(dropin_of "${inst}")/${order}-${name}.conf"
}

has_auth() {
  [ -e "${ETCDIR}/$1.auth.cred" ] &&
  [ "$(setting_of "$1" HDW4S_AUTH none)" = 'basic' ]
}

cmd_list() {
  local idx inst port state prof auth trans unprotected=0 orphaned=0 legacy=0
  printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
    INSTANCE USER PORT AUTH PROFILE TRANSPORT STATE DISPLAY
  [ -r "${SLOTS}" ] || return 0
  # Slots are reused as they are released, so the file is not in index order.
  # The trailing "_" absorbs the type field, and every field after it. Without a
  # variable of its own the rest of the line lands in "inst", which does not drop
  # the type so much as rename the session -- and the name is the key every other
  # reader looks the slot up by. The type itself is read by type_of() straight
  # from the table, so nothing here needs to hold it.
  while read -r idx inst _; do
    case "${idx}" in ''|\#*) continue;; esac
    port="$(port_of "${idx}")"
    # A slot whose account has been deleted, or which names a system account,
    # used to be skipped in silence -- so it vanished from the table and from
    # the AUTH=NO count while still holding its port, which the firewall still
    # opens. This is the command an administrator uses to find out what is
    # reachable, so it has to account for every slot, including the ones it
    # cannot say much about.
    # A second session for one account, from a version that still created
    # them. It is not orphaned -- the account exists and the desktop may well
    # be running -- so saying so would send an administrator looking for a
    # deleted user. It is reported as what it is, and the footer says what to
    # do about it.
    case "${inst}" in
      *:*)
        printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
          "${inst}" "${inst%%:*}" "${port}" '-' '-' '-' 'legacy' '-'
        legacy=$(( legacy + 1 ))
        continue;;
    esac
    if ! split_instance "${inst}" 2>/dev/null; then
      printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
        "${inst}" '(none)' "${port}" '-' '-' '-' 'orphaned' '-'
      orphaned=$(( orphaned + 1 ))
      continue
    fi
    state="$(systemctl show -p ActiveState --value "$(unit_of "${inst}")" \
             2>/dev/null || echo unknown)"
    [ "$(setting_of "${inst}" HDW4S_ISOLATION none)" = 'profile' ] &&
      prof='yes' || prof='no'
    trans="$(setting_of "${inst}" HDW4S_TRANSPORT tcp)"
    if has_auth "${inst}"; then
      auth='yes'
    else
      auth='NO'
      # A session on a filesystem socket is protected by permissions instead,
      # so the absence of a credential there is not the same warning.
      [ "${trans}" = 'unix' ] || unprotected=$(( unprotected + 1 ))
    fi
    printf '%-18s %-10s %-6s %-5s %-8s %-10s %-9s %s\n' \
      "${inst}" "${user}" "${port}" "${auth}" "${prof}" "${trans}" "${state}" \
      "$(cat "/run/hdw4s/${inst}/display" 2>/dev/null || echo '-')"
  done < <(sort -n "${SLOTS}")

  [ "${orphaned}" -eq 0 ] || {
    echo
    echo "${orphaned} slot(s) marked orphaned name an account that no longer"
    echo '  exists, or a system account. Nothing can start them, but the slot'
    echo '  is still allocated and the firewall still opens its port.'
    echo "  Free them with 'hdw4s release <instance>'."
  }
  [ "${legacy}" -eq 0 ] || {
    echo
    echo "${legacy} slot(s) marked legacy are a second desktop for an account"
    echo '  that already has one, created by a version that still offered'
    echo '  that. An account now has one desktop. These keep running and keep'
    echo '  their port, and no other command will accept the name -- retire'
    echo "  one with 'hdw4s release <user>:<session>', which stops it first."
  }

  [ "${unprotected}" -eq 0 ] || {
    echo
    echo "${unprotected} session(s) marked AUTH=NO have no credential of their own."
    echo '  Whatever can reach their port gets a full desktop for that'
    echo '  account, with no further question. The firewall is the only thing'
    echo '  standing in the way.'
    echo "  Add one with 'hdw4s auth <instance>'."
  }
}

cmd_show() {
  local inst="$1" idx port
  # Handled here rather than left to -e: an unhandled failure also trips the
  # ERR trap, so a mistyped name printed its own clear diagnosis and then a
  # second, vaguer line about the script failing unexpectedly.
  split_instance "${inst}" || fail
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] ||
    die "hdw4s: ${inst} has no slot; run 'hdw4s enable ${inst}'."
  port="$(port_of "${idx}")"
  # Say where each value came from. Guessing which of the two files won is the
  # single most common source of confusion in a layered configuration.
  echo "instance      ${inst}"
  echo "user          ${user}"
  echo "slot          ${idx}  (${SLOTS})"
  echo "port          ${port}  (${HDW4S_BASE_PORT} + slot)"
  if [ -r "${ETCDIR}/${inst}.conf" ]; then
    echo "overrides     ${ETCDIR}/${inst}.conf"
    sed 's/^/              /' "${ETCDIR}/${inst}.conf"
  else
    echo "overrides     none  (${ETCDIR}/${inst}.conf does not exist)"
  fi
  local prof
  prof="$(setting_of "${inst}" HDW4S_ISOLATION none)"
  if [ "${prof}" = 'profile' ]; then
    echo "isolation     profile  (settings kept in $(profile_dir_of "${inst}")/${inst})"
  else
    echo 'isolation     none  (settings kept in the home directory, shared with'
    echo '                    any other desktop using it)'
  fi
  if has_auth "${inst}"; then
    echo "auth          a credential of its own, in ${ETCDIR}/${inst}.auth.cred"
    echo "              the proxy must present it; see 'hdw4s proxy ${inst}'"
  elif [ "$(setting_of "${inst}" HDW4S_TRANSPORT tcp)" = 'unix' ]; then
    echo 'auth          none, but reached over a filesystem socket, so access'
    echo '              is decided by permissions rather than by address'
  else
    echo 'auth          NONE -- anything that can reach the port gets this'
    echo "              desktop. Add one with 'hdw4s auth ${inst}'."
  fi
  local sk skey sdef sval ssrc
  echo 'settings      effective value, and where it came from'
  for sk in "${SESSION_SETTINGS[@]}"; do
    skey="${sk%%:*}"; sdef="${sk#*:}"
    ssrc="$(setting_with_source "${inst}" "${skey}" "${sdef}")"
    sval="${ssrc%%$'\t'*}"; ssrc="${ssrc#*$'\t'}"
    printf '              %-20s %-22s %s\n' \
      "${skey}" "${sval}" "${ssrc:-built-in default}"
  done
  # LANG is not in that table because its default is not a constant: it is read
  # from /etc/default/locale at session start and only falls back to C.UTF-8.
  ssrc="$(setting_with_source "${inst}" HDW4S_LANG '')"
  sval="${ssrc%%$'\t'*}"; ssrc="${ssrc#*$'\t'}"
  printf '              %-20s %-22s %s\n' 'HDW4S_LANG' \
    "${sval:-(from /etc/default/locale)}" "${ssrc:-built-in default}"

  # Existence, not readability -- the same distinction as has_auth. The file is
  # root-only, so asking whether we can read it answered "no keyring" for every
  # unprivileged caller, about sessions that have one.
  [ ! -e "${ETCDIR}/${inst}.keyring.cred" ] ||
    echo 'keyring       its own, unlocked at start'
  echo "display       $(cat "/run/hdw4s/${inst}/display" 2>/dev/null ||
                        echo 'not running (assigned at start)')"
}

cmd_enable() {
  local type='desktop'
  if [ "${1:-}" = '--ephemeral' ]; then type='ephemeral'; shift; fi
  local inst="$1" idx prof fresh='no'
  # An ephemeral slot is not an account anybody named: it is minted by
  # hdw4s-ephemeral-slots, and the checks below are about a human's account.
  if [ "${type}" = 'desktop' ]; then
    split_instance "${inst}" || fail
  fi
  # Whether this instance is being created rather than re-enabled, decided
  # before anything below writes the file. "enable" is documented as safe to
  # re-run, so a session that already exists must come out of it configured
  # exactly as it went in -- turning authentication on underneath a running
  # deployment would answer its reverse proxy with 401 and take the desktop
  # away from someone who changed nothing.
  [ -e "${ETCDIR}/${inst}.conf" ] || fresh='yes'
  idx="$(alloc_slot "${inst}" "${type}")"

  install -d -m0755 "$(dropin_of "${inst}")"

  # Four drop-ins below describe an account: who it is, where its home is, which
  # GPU group it needs, where its profile lives. An ephemeral slot has none of
  # those to describe -- its unit sets User=%i itself, its home is a tmpfs inside
  # its own namespace, and its profile is a RuntimeDirectory, which is writable
  # under ProtectSystem=strict without being named. Writing them anyway is not
  # merely redundant: 40-home.conf would order the session after a mount of a
  # path that exists nowhere outside the namespace, and the unit would fail
  # 226/NAMESPACE naming a directory nobody can find.
  if [ "${type}" = 'desktop' ]; then

  # The unit carries no User= of its own. systemd has no specifier for "the
  # part of the instance name before the colon", and "User=%i" cannot be
  # rescued by a drop-in: an invalid user name in the base unit is a fatal
  # parse error, so the unit never loads far enough for an override to apply.
  # Every instance therefore gets its account named here.
  printf '%s\n' \
    '# Written by "hdw4s enable"; edit /etc/hdw4s/'"${inst}"'.conf instead.' \
    '[Service]' \
    "User=${user}" \
    > "$(dropin_of "${inst}")/50-user.conf"

  # ProtectSystem=strict makes the whole filesystem read-only apart from what
  # is named, and a desktop has to be able to write its own home. The unit
  # cannot name it, because there is no specifier for the home directory of the
  # account in User= -- %h is the *manager's* home, which for a system unit is
  # /root. So it is looked up here, at the one moment the account is known.
  #
  # Assuming /home would be wrong: plenty of sites keep home directories
  # somewhere else entirely, and the failure is a session that starts and then
  # cannot save anything.
  home="$(getent passwd -- "${user}" | cut -d: -f6)"
  [ -n "${home}" ] || die "hdw4s: ${user} has no home directory"
  # RequiresMountsFor belongs here too, for the same reason ReadWritePaths does.
  # The unit used to name /home, which is the one assumption this function
  # exists to avoid making: on a site with homes under /export the session was
  # not ordered after that mount and could start against an autofs stub.
  printf '%s\n' \
    '# Written by "hdw4s enable". Re-run it if the home directory moves.' \
    '[Unit]' \
    "RequiresMountsFor=${home}" \
    '' \
    '[Service]' \
    "ReadWritePaths=${home}" \
    > "$(dropin_of "${inst}")/40-home.conf"

  # The GPU, if this machine has one. The unit binds /dev/dri in and grants the
  # device rule, but the node is group-owned and the group differs between
  # machines -- "render" on a stock host, "plugdev" inside these containers,
  # because the container config chooses it -- so the unit cannot name it and it
  # is read off the node here.
  #
  # Without it the session can see the node and not open it: the encoder says
  # "Failed to init VAAPI: Permission denied" once and then encodes every frame
  # in software, which reads as a slow machine rather than a missing group.
  #
  # Re-run "hdw4s enable" if a GPU is added or taken away.
  gpu_group=''
  for node in /dev/dri/renderD*; do
    [ -e "${node}" ] || continue
    gpu_group="$(stat -c '%G' "${node}" 2>/dev/null || :)"
    case "${gpu_group}" in ''|UNKNOWN) gpu_group='' ;; esac
    break
  done
  if [ -n "${gpu_group}" ]; then
    printf '%s\n' \
      '# Written by "hdw4s enable" from the owner of /dev/dri/renderD*.' \
      '[Service]' \
      "SupplementaryGroups=${gpu_group}" \
      > "$(dropin_of "${inst}")/45-gpu.conf"
  else
    rm -f "$(dropin_of "${inst}")/45-gpu.conf"
  fi

  # ProtectSystem=strict makes everything read-only but what is named, and the
  # unit names only /var/lib/hdw4s. Any other profile directory was therefore
  # read-only inside the session, which failed at "install -d" with a bare
  # EROFS -- so the setting parsed, passed validation, was reported back by
  # "show", and could not work. Named here for the same reason the home
  # directory is: this is the one moment the value is known.
  prof="$(profile_dir_of "${inst}")"
  if [ "${prof}" = '/var/lib/hdw4s' ]; then
    rm -f "$(dropin_of "${inst}")/45-profile.conf"
  else
    printf '%s\n' \
      '# Written by "hdw4s enable". Re-run it if HDW4S_PROFILE_DIR changes.' \
      '[Service]' \
      "ReadWritePaths=${prof}" \
      > "$(dropin_of "${inst}")/45-profile.conf"
    install -d -m0755 "${prof}"
  fi
  fi

  # The relay forwards to wherever the session actually listens.
  install -d -m0755 "${DROPIN}/hdw4s-proxy@${inst}.service.d"

  # The session unit this relay brings up. The template cannot name it: an
  # ephemeral slot is served by a different unit, and a dependency in a template
  # cannot be overridden by a drop-in -- an empty "Requires=" does not reset the
  # list. So the relay names no session unit and this supplies it.
  #
  # BindsTo=, not Requires=, and the difference is only visible on the path a
  # person actually takes. Requires= ends the relay when the session is STOPPED;
  # it does not when the session EXITS ON ITS OWN, which is what logging out of
  # GNOME does. Measured on a logout, both ways:
  #
  #   Requires=  session=failed  relay=ACTIVE    next connection: HTTP 000
  #   BindsTo=   session=failed  relay=inactive  next connection: HTTP 200 in 1s
  #
  # With Requires= the relay survives its session and goes on forwarding to a
  # loopback port nothing is listening on, so every later visitor gets a dropped
  # connection and the slot never comes back without an administrator. That is
  # the "it briefly tried, failed to connect to the stream, and brought me back
  # to the prompt" report, and no amount of work in the browser fixes it.
  #
  # An earlier test of this directive was driven by "systemctl stop", where the
  # two are indistinguishable, and concluded there was nothing to choose between
  # them. The 61-second race that test warned about does not occur on the logout
  # path; a logout is a clean exit and the slot is back in about a second, with
  # the tmpfs home wiped.
  printf '%s\n' \
    '# Written by "hdw4s enable": the session unit behind this relay.' \
    '[Unit]' \
    "BindsTo=$(unit_of "${inst}")" \
    "After=$(unit_of "${inst}")" \
    > "${DROPIN}/hdw4s-proxy@${inst}.service.d/30-session.conf"
  # Only the port. The wait that goes with it lives in the unit, because a
  # multi-line ExecStartPre= is parsed as several directives and quietly
  # discarded -- systemd is not a shell and embedding one in a unit file goes
  # wrong in ways that only show up at runtime.
  printf '%s\n' \
    '# Written by "hdw4s enable".' \
    '[Service]' \
    'ExecStart=' \
    "ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:$(internal_port_of "${idx}")" \
    > "${DROPIN}/hdw4s-proxy@${inst}.service.d/50-port.conf"

  # And the session is told which loopback port to bind.
  config_write "${ETCDIR}/${inst}.conf" 'HDW4S_PORT' "$(internal_port_of "${idx}")"

  systemctl daemon-reload
  # The socket is what gets enabled, not the session. Nothing runs until
  # somebody connects, so a desktop that is never visited never exists.
  systemctl enable --now "hdw4s-proxy@${inst}.socket"

  # Give the front door its listener. Without this the socket unit keeps the
  # filesystem socket it defaults to, while everything that reports on the
  # session -- the line below, "list", "proxy" -- describes the TCP port it
  # was assigned, and the two disagree with nobody the wiser.
  # The instance's own setting, not the global default: "enable" is documented
  # as safe to re-run, and reading the global here would quietly move a session
  # that had deliberately been put on a filesystem socket back onto the network.
  cmd_transport "${inst}" "$(setting_of "${inst}" HDW4S_TRANSPORT tcp)" >/dev/null

  echo "Session ${inst} is listening on port $(port_of "${idx}")."
  echo "Point the reverse proxy at this machine's address, port $(port_of "${idx}")."
  echo 'The desktop starts on the first connection, not now.'

  # A site can make this automatic by setting HDW4S_AUTH=basic in the shared
  # configuration; otherwise say plainly what is missing. A session with no
  # credential is not a smaller version of one with a credential -- it is one
  # where an address is the only thing between a stranger and somebody's
  # desktop, and that deserves more than a line in a manual.
  if has_auth "${inst}"; then
    # The credential is kept; only the drop-in that points at it is refreshed,
    # so a session whose type changed -- or which was released and re-enabled --
    # does not come back up refusing to start for want of a file it already
    # has the secret for.
    link_credential "${inst}" 'auth' 70
  elif [ "$(setting_of "${inst}" HDW4S_AUTH none)" = 'basic' ]; then
    echo
    echo 'Generating the credential this session is configured to require...'
    cmd_auth "${inst}" >/dev/null
    echo "  done; see 'hdw4s proxy ${inst}' for the proxy configuration."
  elif [ "${fresh}" = 'yes' ]; then
    # New sessions get a credential by default. The firewall stands between
    # this port and other machines, and nothing stands between it and the other
    # accounts on this one: the streaming server binds 127.0.0.1, and any local
    # account can open a loopback port. Since the credential is generated here,
    # handed to the proxy by "hdw4s proxy", and never shown to the user, having
    # it costs nothing that not having it saves.
    echo
    echo 'Generating a credential for this session...'
    cmd_auth "${inst}" >/dev/null
    echo "  done; see 'hdw4s proxy ${inst}' for the proxy configuration."
    echo '  Set HDW4S_AUTH=none in /etc/hdw4s/'"${inst}"'.conf to turn it off.'
  else
    echo
    cat <<EOF

  This session has no credential of its own. Anything that can open a
  connection to port $(port_of "${idx}") gets a full desktop for ${user}, with no
  further question. The firewall's list of addresses is the only thing in
  the way, and an address is a weak thing to rely on by itself.

  The firewall also does not stand between this session and the other
  accounts on this machine. It filters what arrives from elsewhere; the
  streaming server listens on loopback, and any local account can reach a
  loopback port. A credential is what separates them.

      hdw4s auth ${inst}

  adds a secret the reverse proxy presents on every request. The user never
  sees it, so there is still no login screen. Setting HDW4S_AUTH=basic in
  /etc/hdw4s/hdw4s.conf does this for every session from the start.
EOF
  fi
}

# --- editing configuration --------------------------------------------------
#
# Settings people change often should not require an editor, but the file is
# the administrator's, so an edit has to disturb as little of it as possible.
# In order of preference: change an existing assignment where it stands; else
# uncomment the documented default where it stands, so the comment above it
# still explains the value; else append. Comments, ordering, spacing and
# anything the administrator wrote are preserved in every case.

# Settings that may be set from the command line, and how to check a value.
# Anything absent from here is rejected rather than written, because a typo
# that silently does nothing is worse than an error.
# Settings that only ever take effect machine-wide. A session sources both the
# global file and its own, so most settings work per instance for free -- but
# these are read by the CLI, by the firewall, or by the updater, none of which
# has an instance in hand. Writing one into an instance's file parses, passes
# every check and does nothing at all, which is the quietest kind of wrong.
declare -A GLOBAL_ONLY=(
  [HDW4S_PROXIES]=1 [HDW4S_BASE_PORT]=1 [HDW4S_BLOCK_SIZE]=1
  [HDW4S_MEDIA_PORTS]=1 [HDW4S_ALLOW_SYSTEM_USER]=1 [SELKIES_VERSION]=1
  # Read by the slot-minting service, which runs once for the machine. A
  # per-instance value would be read by nothing and would look like it worked.
  [HDW4S_EPHEMERAL_SLOTS]=1 [HDW4S_EPHEMERAL_HOME_SIZE]=1
  [HDW4S_EPHEMERAL_PROFILE_SIZE]=1 [HDW4S_EPHEMERAL_SHM_SIZE]=1
  [HDW4S_EPHEMERAL_BACKGROUND]=1
)

# Settings whose effect does not live in the configuration file at all. The
# value there is read back by "show", "list" and "proxy", but what actually
# takes effect is a drop-in or a credential that only the named command
# writes. Setting one here parsed, passed every check, was echoed back, and
# changed nothing -- so "list" reported the new transport while the session
# stayed on the old one, which is the disagreement the whole slot mechanism
# exists to prevent, arriving through a different door.
# Everything a session reads that is not already reported by name in "show",
# with the default the session scripts fall back to. "show" is documented as
# reporting the settings that apply and where each came from, and it only ever
# printed the instance file -- so the values that were inherited, which are
# exactly the ones somebody runs this command to find, were the ones it did not
# show. Kept in the order an administrator is likely to want them; the defaults
# are checked against the scripts by .github/checks.sh.
SESSION_SETTINGS=(
  'HDW4S_MICROPHONE:no'
  'HDW4S_WEBCAM:no'
  'HDW4S_WEBRTC:no'
  'HDW4S_TURN_PORT:3478'
  'HDW4S_SESSION:gnome-session'
  'HDW4S_ADDR:127.0.0.1'
  'HDW4S_ENCODER:h264enc'
  'HDW4S_FRAMERATE:30,8-60'
  'HDW4S_RESIZE:true'
  'HDW4S_DPI:follow'
  'HDW4S_INDEXING:off'
  'HDW4S_THUMBNAILS:off'
  'HDW4S_HIDPI:scale'
  'HDW4S_IDLE_DAYS:7'
  'HDW4S_PROFILE_DIR:/var/lib/hdw4s'
)

declare -A OWNED_BY=(
  [HDW4S_TRANSPORT]='transport'
  [HDW4S_AUTH]='auth'
)

declare -A SETTABLE=(
  [HDW4S_PROXIES]='any'
  [HDW4S_ISOLATION]='none|profile'
  [HDW4S_AUTH]='none|basic'
  [HDW4S_TRANSPORT]='tcp|unix'
  [HDW4S_PROXY_GROUP]='any'
  [HDW4S_ALLOW_SYSTEM_USER]='yes|no'
  [HDW4S_PROFILE_DIR]='path'
  [HDW4S_ADDR]='any'
  [HDW4S_BASE_PORT]='number'
  [HDW4S_BLOCK_SIZE]='number'
  [HDW4S_EPHEMERAL_SLOTS]='number'
  [HDW4S_EPHEMERAL_HOME_SIZE]='size'
  [HDW4S_EPHEMERAL_PROFILE_SIZE]='size'
  [HDW4S_EPHEMERAL_SHM_SIZE]='size'
  [HDW4S_EPHEMERAL_BACKGROUND]='color'
  [HDW4S_MICROPHONE]='no|yes'
  [HDW4S_WEBCAM]='no|yes'
  [HDW4S_WEBRTC]='no|yes'
  [HDW4S_TURN_HOST]='any'
  [HDW4S_TURN_PORT]='number'
  [HDW4S_TURN_SECRET]='any'
  [HDW4S_SESSION]='any'
  [HDW4S_FRAMERATE]='framerate'
  [HDW4S_RESIZE]='true|false'
  [HDW4S_DPI]='dpi'
  [HDW4S_INDEXING]='off|on'
  [HDW4S_THUMBNAILS]='off|on'
  [HDW4S_HIDPI]='scale|native'
  [HDW4S_LANG]='any'
  [HDW4S_IDLE_DAYS]='number'
  [HDW4S_MEDIA_PORTS]='proxied|direct'
  [HDW4S_ENCODER]='any'
  [SELKIES_VERSION]='any'
)

check_value() {
  local key="$1" value="$2" rule="${SETTABLE[$1]}"
  case "${rule}" in
    number) case "${value}" in ''|*[!0-9]*)
              die "hdw4s: ${key} takes a number, not '${value}'";; esac;;
    # A bare number, or the "N,LOW-HIGH" form. The range has to be settable:
    # hdw4s-run-session turns a bare number into "N,8-N" precisely so the
    # setting caps the rate rather than merely starting there, and passes an
    # explicit range through untouched. Typed as a plain number, the only way
    # to use the form the runner supports was to edit the file by hand.
    framerate)
            [[ "${value}" =~ ^[0-9]+(,[0-9]+-[0-9]+)?$ ]] ||
              die "hdw4s: ${key} takes a number or an 'N,LOW-HIGH' range, not '${value}'";;
    dpi)    case "${value}" in follow) :;; ''|*[!0-9]*)
              die "hdw4s: ${key} takes 'follow' or a number, not '${value}'";; esac;;
    # A tmpfs size, as mount(8) takes it: bytes, a K/M/G suffix, or a percentage
    # of physical memory. Checked here rather than at mount time because a
    # rejected option does not fail the setting, it fails the whole namespace --
    # and the message then names the mount instead of the value that caused it.
    size)   [[ "${value}" =~ ^[0-9]+[KMG]?$|^[0-9]+%$ ]] ||
              die "hdw4s: ${key} takes a size such as 512M, 2G or 10%, not '${value}'";;
    color)  [[ "${value}" =~ ^#[0-9a-fA-F]{6}$ ]] ||
              die "hdw4s: ${key} takes a colour such as #772953, not '${value}'";;
    path)   case "${value}" in /*) :;;
              *) die "hdw4s: ${key} takes an absolute path, not '${value}'";; esac;;
    any)    :;;
    *)      case "|${rule}|" in
              *"|${value}|"*) :;;
              *) die "hdw4s: ${key} must be one of ${rule//|/, }, not '${value}'";;
            esac;;
  esac
}

# Quote only when the value needs it, so a file edited by hand keeps looking
# the way the administrator wrote it.
quote_value() {
  case "$1" in
    ''|*[![:alnum:]_./:-]*) printf "'%s'" "${1//\'/\'\\\'\'}";;
    *) printf '%s' "$1";;
  esac
}

config_file() {
  if [ -z "$1" ]; then echo "${CONF}"; else echo "${ETCDIR}/$1.conf"; fi
}

config_write() {
  local file="$1" key="$2" value="$3" tmp
  install -d -m0755 "${ETCDIR}"
  [ -e "${file}" ] || {
    printf '%s\n' \
      "# Settings for this session. Read after ${CONF}, and wins over it." \
      '# Edit by hand, or with "hdw4s set".' \
      '' > "${file}"
    chmod 0644 "${file}"
  }

  tmp="$(mktemp "${file}.XXXXXX")"
  chmod 0644 "${tmp}"
  KEY="${key}" VALUE="${value}" awk '
    # A note the administrator wrote at the end of the line is theirs, and
    # replacing the value is no reason to throw it away. Only treat a "#" as
    # the start of one when the text before it has balanced quotes, so a "#"
    # inside a quoted value is left alone.
    function trailing(line,   i, c, head, sq, dq) {
      for (i = length(line); i > 1; i--) {
        if (substr(line, i, 1) != "#") continue
        c = substr(line, i - 1, 1)
        if (c != " " && c != "\t") continue
        head = substr(line, 1, i - 1)
        sq = gsub(/'"'"'/, "&", head)
        dq = gsub(/"/, "&", head)
        if (sq % 2 == 0 && dq % 2 == 0) return "   " substr(line, i)
      }
      return ""
    }
    BEGIN { key = ENVIRON["KEY"]; value = ENVIRON["VALUE"]; live = 0; comment = 0 }
    # Remember the last assignment that is in effect, and the last commented
    # one, so the replacement happens where a reader would expect to find it.
    $0 ~ "^[[:space:]]*" key "=" { live = NR }
    $0 ~ "^[[:space:]]*#[[:space:]]*" key "="  { comment = NR }
    { lines[NR] = $0 }
    END {
      target = live ? live : comment
      for (i = 1; i <= NR; i++) {
        if (i == target) {
          match(lines[i], /^[[:space:]]*/)
          indent = substr(lines[i], 1, RLENGTH)
          printf "%s%s=%s%s\n", indent, key, value, trailing(lines[i])
        } else {
          print lines[i]
        }
      }
      if (!target) {
        if (NR > 0 && lines[NR] != "") print ""
        printf "%s=%s\n", key, value
      }
    }' "${file}" > "${tmp}"
  mv "${tmp}" "${file}"
}

cmd_set() {
  local inst='' file key value pair
  if [ "$#" -gt 1 ] && [ "${1#*=}" = "$1" ]; then
    inst="$1"; shift
    split_instance "${inst}"
  fi
  [ "$#" -gt 0 ] || die 'hdw4s: nothing to set'
  file="$(config_file "${inst}")"

  for pair in "$@"; do
    case "${pair}" in
      *=*) :;;
      *) die "hdw4s: '${pair}' is not KEY=VALUE";;
    esac
    key="${pair%%=*}"
    value="${pair#*=}"
    [ -n "${SETTABLE[${key}]+set}" ] ||
      die "hdw4s: ${key} cannot be set from the command line." \
          "  Settable: ${!SETTABLE[*]}" \
          "  Anything else can still be edited in ${file}."
    # Only for a named session. Machine-wide these are read when a session is
    # created -- "hdw4s enable" asks setting_of for both, and generates the
    # credential when the answer is basic -- so the site-wide default that
    # hdw4s.conf and the manual both describe has to keep working. It is the
    # per-session write that would be recorded and then ignored, because the
    # drop-in and the credential are what actually take effect.
    [ -z "${inst}" ] || [ -z "${OWNED_BY[${key}]+set}" ] ||
      die "hdw4s: ${key} is not set this way for one session." \
          "  It takes effect through a drop-in that only 'hdw4s ${OWNED_BY[${key}]}'" \
          '  writes, so setting it here would be recorded and ignored. Run:' \
          "    $(owning_command "${key}" "${inst}" "${value}")" \
          "  Setting it without a session name applies to sessions created" \
          '  afterwards, which is what the sample configuration describes.'
    [ -z "${inst}" ] || [ -z "${GLOBAL_ONLY[${key}]+set}" ] ||
      die "hdw4s: ${key} only takes effect machine-wide." \
          "  Nothing reads it per session, so writing it into ${file}" \
          '  would parse, pass every check, and do nothing. Set it without' \
          "  an instance name: hdw4s set ${key}=${value}"
    check_value "${key}" "${value}"
    config_write "${file}" "${key}" "$(quote_value "${value}")"
    echo "${file}: ${key}=${value}"
    # Sessions that already exist have no credential, and a session configured
    # to require one that does not have one refuses to start. Say so here
    # rather than let it be discovered the next time one of them is used.
    if [ -z "${inst}" ] && [ "${key}" = 'HDW4S_AUTH' ] && [ "${value}" = 'basic' ]; then
      echo "  Sessions created from now on get a credential from 'hdw4s enable'."
      echo "  Existing ones do not have one yet, and will refuse to start until"
      echo "  they do. 'hdw4s list' marks them AUTH=NO; give each one:"
      echo '    hdw4s auth <session>'
    fi
  done
  set_hint "${inst}" "$@"
}

cmd_unset() {
  local inst='' file key tmp
  if [ "$#" -gt 1 ]; then inst="$1"; shift; split_instance "${inst}" || fail; fi
  [ "$#" -eq 1 ] || die 'hdw4s: unset takes one setting'
  key="$1"
  file="$(config_file "${inst}")"
  [ -e "${file}" ] || die "hdw4s: ${file} does not exist"

  # Comment the assignment out rather than deleting the line, so the value that
  # was there stays visible and the file still documents what was tried.
  # The key goes into an awk regular expression below, so it has to be a name
  # and not a pattern. Without this, "hdw4s unset '.*'" comments out every line
  # in the file and reports success.
  case "${key}" in
    ''|*[!A-Za-z0-9_]*)
      die "hdw4s: '${key}' is not a setting name." ;;
  esac

  # The same guard "set" carries. Without it the refusal there was half a
  # guard: "hdw4s set alice HDW4S_AUTH=none" was refused and pointed at the
  # right command, while "hdw4s unset alice HDW4S_AUTH" commented the setting
  # out and turned authentication off in one word, leaving the credential file
  # in place and "show" reporting a session that authenticates nobody.
  [ -z "${inst}" ] || [ -z "${OWNED_BY[${key}]+set}" ] ||
    die "hdw4s: ${key} is not unset this way for one session." \
        "  Use 'hdw4s ${OWNED_BY[${key}]}' so that the drop-in it writes is" \
        '  brought back into agreement with the setting.'

  tmp="$(mktemp "${file}.XXXXXX")"
  chmod 0644 "${tmp}"
  KEY="${key}" awk '
    BEGIN { key = ENVIRON["KEY"] }
    $0 ~ "^[[:space:]]*" key "=" { print "#" $0; next }
    { print }' "${file}" > "${tmp}"
  if cmp -s "${file}" "${tmp}"; then
    rm -f "${tmp}"
    echo "${file}: ${key} was not set"
  else
    mv "${tmp}" "${file}"
    echo "${file}: ${key} commented out; the default applies again"
  fi
  set_hint "${inst}" "${key}="
}

# Say what has to happen for a change to take effect. Silently writing a value
# that does nothing until some unmentioned command is run is how configuration
# files get a reputation for not working.
set_hint() {
  local inst="$1" pair firewall='' session='' updater='' atenable='' relay='' \
        atenable2=''
  shift
  for pair in "$@"; do
    case "${pair%%=*}" in
      # Read only by hdw4s-firewall. Restarting a session does nothing for
      # these, and HDW4S_MEDIA_PORTS used to be told to do exactly that.
      HDW4S_PROXIES|HDW4S_BASE_PORT|HDW4S_BLOCK_SIZE|HDW4S_MEDIA_PORTS)
        firewall='yes';;
      # Read only by the updater.
      SELKIES_VERSION) updater='yes';;
      # Read by the CLI when a session is created, and nowhere else.
      HDW4S_ALLOW_SYSTEM_USER) atenable='yes';;
      # Written into the socket drop-in by "hdw4s transport", not read at
      # session start, so a restart does not pick it up.
      HDW4S_PROXY_GROUP) relay='yes';;
      # Takes effect through a drop-in that only "hdw4s enable" writes, the
      # ReadWritePaths for the profile directory. A restart on its own re-reads
      # the same drop-in and changes nothing, which is the advice this used to
      # give.
      HDW4S_PROFILE_DIR) atenable2='yes';;
      *) session='yes';;
    esac
  done
  [ -z "${firewall}" ] || echo "  Run 'hdw4s firewall --apply' to use it."
  [ -z "${updater}" ] || echo "  Run '/usr/lib/hdw4s/hdw4s-update' to use it."
  [ -z "${atenable}" ] || echo '  Applies to sessions created after this.'
  [ -z "${atenable2}" ] || {
    echo "  Run 'hdw4s enable ${inst:-<session>}' again to rewrite the drop-in,"
    echo "  then 'systemctl restart hdw4s@${inst:-<session>}' to use it."
  }
  [ -z "${relay}" ] ||
    echo "  Run 'hdw4s transport ${inst:-<session>} unix' again to use it."
  if [ -n "${session}" ]; then
    if [ -n "${inst}" ]; then
      echo "  Run 'systemctl restart $(unit_of "${inst}")' to use it."
    else
      echo '  Restart the affected sessions to use it.'
    fi
  fi
}

# Generate a secret, seal it to this machine, and record the drop-in that hands
# it to the session at start time. systemd keeps it in memory that is not
# swapped and exists only for the life of the unit, so it is never written to
# disk in the clear.
make_credential() {
  local inst="$1" name="$2" order="$3" cred pw
  cred="${ETCDIR}/${inst}.${name}.cred"
  pw=''
  while [ "${#pw}" -lt 24 ]; do
    # tr removes characters before head truncates, so a single pass can come
    # out short. Loop until it is the length it is supposed to be rather than
    # hoping, because a one-in-a-thousand weak credential is the kind nobody
    # ever finds.
    pw="${pw}$(head -c48 /dev/urandom | base64 | tr -d '\n=/+')"
  done
  pw="${pw:0:24}"

  if ! ( umask 0077
         printf '%s' "${pw}" |
           systemd-creds encrypt --name="hdw4s-${name}" - "${cred}" ) 2>/dev/null
  then
    unset pw
    rm -f "${cred}"
    die 'hdw4s: could not encrypt the secret.' \
        '  systemd-creds needs to run as root and to read the machine secret' \
        '  in /var/lib/systemd/credential.secret, which it creates on first' \
        '  use. Check "systemd-creds has-tpm2" and try again as root.'
  fi

  install -d -m0755 "$(dropin_of "${inst}")"
  printf '%s\n' \
    "# Written by \"hdw4s ${name}\"." \
    '[Service]' \
    "LoadCredentialEncrypted=hdw4s-${name}:${cred}" \
    > "$(dropin_of "${inst}")/${order}-${name}.conf"
  systemctl daemon-reload
  printf '%s' "${pw}"
}

require_slot() {
  split_instance "$1" || fail
  [ -n "$(slot_of "$1")" ] ||
    die "hdw4s: $1 has no slot; run 'hdw4s enable $1' first."
  command -v systemd-creds >/dev/null ||
    die 'hdw4s: systemd-creds is not available on this system.'
}

cmd_transport() {
  local inst="$1" mode="$2" idx port group dir
  split_instance "${inst}" || fail
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] || die "hdw4s: ${inst} has no slot."
  port="$(port_of "${idx}")"
  dir="${DROPIN}/hdw4s-proxy@${inst}.socket.d"
  install -d -m0755 "${dir}"

  case "${mode}" in
    tcp)
      # Replace the filesystem socket the unit defaults to. An empty
      # ListenStream= first, because these accumulate rather than replace.
      printf '%s\n' \
        '# Written by "hdw4s transport".' \
        '[Socket]' \
        'ListenStream=' \
        "ListenStream=${port}" \
        > "${dir}/50-listen.conf"
      config_write "${ETCDIR}/${inst}.conf" 'HDW4S_TRANSPORT' 'tcp'
      systemctl daemon-reload
      systemctl restart "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      echo "Session ${inst} listens on port ${port}."
      echo '  Who may connect is decided by the firewall; see HDW4S_PROXIES.'
      ;;
    unix)
      group="$(setting_of "${inst}" HDW4S_PROXY_GROUP www-data)"
      getent group -- "${group}" >/dev/null ||
        die "hdw4s: no such group: ${group}" \
            '  Set HDW4S_PROXY_GROUP to the group the reverse proxy runs as.'
      # The unit already listens on the filesystem socket; only the ownership
      # has to be said, since which account runs the proxy is a local decision.
      rm -f "${dir}/50-listen.conf"
      printf '%s\n' \
        '# Written by "hdw4s transport".' \
        '[Socket]' \
        "SocketGroup=${group}" \
        > "${dir}/60-group.conf"
      config_write "${ETCDIR}/${inst}.conf" 'HDW4S_TRANSPORT' 'unix'
      systemctl daemon-reload
      systemctl restart "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
      echo "Session ${inst} is reachable at /run/hdw4s-proxy/${inst}.sock,"
      echo "readable by group ${group} only. It does not listen on the network."
      ;;
    *)
      die "hdw4s: transport must be 'tcp' or 'unix', not '${mode}'"
      ;;
  esac
}

# Say something the journal should keep.
#
# hdw4s-reaper.service filters itself at warning, so that running every few
# minutes does not write three lines a time about having done nothing. systemd
# reads a "<N>" prefix as a syslog priority, so anything that should survive
# that filter says so. Only when there is a journal to say it to: run by hand,
# the prefix would be rubbish on a terminal.
reap_say() {
  if [ -n "${JOURNAL_STREAM:-}" ]; then
    printf '<4>%s\n' "$*"
  else
    printf '%s\n' "$*"
  fi
}

# How many clients are attached to a session.
#
# Not "established connections on the session's port", which is what this used
# to count. The streaming process is both the signalling server and two of its
# own peers, so it connects to that port twice itself and the count is never
# zero. Every session has therefore looked permanently in use -- which is why
# the reaper had never once fired, and why the updater never restarted a
# session to check that an upgrade actually worked.
#
# What marks a real client is the socket proxy: it holds one loopback
# connection to the session for each connection it is relaying, whichever
# transport its own front door uses. So count the connections that belong to
# the proxy, and nothing else.
clients_of() {
  local inst="$1" port="$2" pid out
  pid="$(systemctl show "hdw4s-proxy@${inst}.service" -p MainPID --value 2>/dev/null || echo 0)"
  # No proxy, no clients: nothing can reach the session without going through
  # it.
  case "${pid}" in ''|0|*[!0-9]*) echo 0; return 0;; esac
  out="$(ss -Htnp state established "dport = :${port}" 2>/dev/null || :)"
  # ss names the owning process only for sockets we have the privilege to see.
  # Counting nothing because we cannot look is not the same as counting nothing
  # because nobody is there, and the difference decides whether a desktop in
  # use gets stopped. Say so rather than guess.
  # Not "printf | grep -q": grep exits on the first match, the producer takes
  # SIGPIPE, and pipefail adopts that as the pipeline's status -- so a match
  # reads as a miss once the output outgrows the pipe buffer. It never does
  # here, but the failure is silent and the test is free.
  if [ -n "${out}" ] && [ "${out#*pid=}" = "${out}" ]; then
    echo 'unknown'
    return 0
  fi
  printf '%s\n' "${out}" | grep -c "pid=${pid}," || :
}

# Stop desktops nobody has connected to for a long time.
#
# Safe to do because the socket stays listening: a stopped session is not gone,
# it is asleep, and the next connection starts it again. What is reclaimed is
# the memory of a desktop somebody opened once and never came back to.
#
# Idleness is measured by connections, not by input. A desktop with a window
# open but no typing may be running a long job somebody deliberately left; a
# desktop with nothing connected to it is not being watched by anyone. The
# browser client reconnects by itself, so an open tab counts as connected even
# across a laptop lid being shut.
cmd_reap() {
  local idx inst port established last now age days stopped=0
  now="$(date +%s)"
  [ -r "${SLOTS}" ] || return 0

  while read -r idx inst _; do
    case "${idx}" in ''|\#*) continue;; esac
    [ "$(systemctl is-active "$(unit_of "${inst}")" 2>/dev/null)" = 'active' ] ||
      continue
    # Per instance, not once for the whole run: a session that should never be
    # reaped is a per-session decision, and reading the global here meant
    # setting it on an instance did nothing at all.
    days="$(setting_of "${inst}" HDW4S_IDLE_DAYS 7)"
    case "${days}" in ''|*[!0-9]*) days=7;; esac
    [ "${days}" -gt 0 ] || continue
    # The internal port, not the one the socket unit binds: the external port
    # has no connections at all when the session is on a filesystem socket,
    # which once made the reaper stop desktops that were in constant use.
    port="$(internal_port_of "${idx}")"
    established="$(clients_of "${inst}" "${port}")"

    # /run is a tmpfs, so noticing a connection costs a one-line write to
    # memory and nothing to the disk -- which is what makes it reasonable to
    # ask this every few minutes rather than once a day. There is no cheaper
    # event to hang this on: the proxy socket is Accept=no, so systemd counts
    # no connections for it, and the only other record is the session's own log,
    # which is upstream's prose and would be read by nobody but a parser.
    #
    # Not /run/hdw4s/<inst>: that is the session's RuntimeDirectory, owned by
    # the session user at mode 0700, so the user can replace this file with a
    # symlink and have the reaper -- which runs as root -- truncate whatever it
    # points at and write a timestamp into it. /etc/shadow, /etc/sudoers, take
    # your pick. The stamp is the reaper's own bookkeeping and belongs somewhere
    # only the reaper can write.
    local stampdir="/run/hdw4s-reap"
    install -d -m0700 -o root -g root "${stampdir}" 2>/dev/null || :
    [ -d "/run/hdw4s/${inst}" ] || continue
    local stamp="${stampdir}/${inst}"
    # "unknown" first: it is not a number, and treating it as one would be an
    # arithmetic error rather than the cautious answer it is meant to be.
    if [ "${established}" = 'unknown' ] || [ "${established}" -gt 0 ]; then
      printf '%s\n' "${now}" > "${stamp}" 2>/dev/null || :
      continue
    fi
    if [ -r "${stamp}" ]; then
      last="$(cat "${stamp}" 2>/dev/null)"
    else
      # No record yet, so start the clock now rather than at the session's
      # start. Backdating would mean the first run after this is installed --
      # or after a reboot clears /run -- could stop a desktop that has been up
      # for months, immediately, with no warning to the person using it. All we
      # actually know is that nobody has connected since we began looking, and
      # measuring from that is the claim the message makes.
      last="${now}"
      printf '%s\n' "${last}" > "${stamp}" 2>/dev/null || :
    fi
    case "${last}" in ''|*[!0-9]*) continue;; esac
    age=$(( (now - last) / 86400 ))
    [ "${age}" -ge "${days}" ] || continue

    reap_say "hdw4s: stopping ${inst}; nothing has connected for ${age} days."
    reap_say '  Its files and settings are untouched, and the next connection'
    reap_say '  starts it again.'
    systemctl stop "hdw4s-proxy@${inst}.service" 2>/dev/null || :
    systemctl stop "$(unit_of "${inst}")" 2>/dev/null || :
    stopped=$(( stopped + 1 ))
  done < "${SLOTS}"
  [ "${stopped}" -eq 0 ] || reap_say "Stopped ${stopped} idle session(s)."
}

cmd_auth() {
  local inst="$1" pw
  require_slot "${inst}"
  pw="$(make_credential "${inst}" 'auth' 70)"
  config_write "${ETCDIR}/${inst}.conf" 'HDW4S_AUTH' 'basic'

  echo "Session ${inst} will now require a credential of its own, in addition"
  echo 'to the firewall. The reverse proxy has to present it; the user never'
  echo 'sees it, so there is still no login screen.'
  echo
  echo "  hdw4s proxy ${inst}     prints an nginx block that does this"
  echo
  echo "Restart the session for this to take effect:"
  echo "  systemctl restart $(unit_of "${inst}")"
  unset pw
}

cmd_noauth() {
  local inst="$1"
  split_instance "${inst}" || fail
  # Existence, not readability: see has_auth. Asking whether we can read a
  # root-only file makes the answer depend on who is asking.
  [ -e "${ETCDIR}/${inst}.auth.cred" ] ||
    [ "$(setting_of "${inst}" HDW4S_AUTH none)" = 'basic' ] || {
      echo "Session ${inst} already has no credential."
      return 0
    }
  rm -f "${ETCDIR}/${inst}.auth.cred" \
        "$(dropin_of "${inst}")/70-auth.conf"
  config_write "${ETCDIR}/${inst}.conf" 'HDW4S_AUTH' 'none'
  systemctl daemon-reload
  echo "Session ${inst} no longer requires a credential."
  echo '  Whatever can reach its port now gets this desktop. That is a'
  echo '  reasonable choice when the port is reachable only over a filesystem'
  echo '  socket, or from a network nothing untrusted is on. It is not one to'
  echo '  make by accident.'
  echo "  Restart it to take effect: systemctl restart $(unit_of "${inst}")"
}

cmd_proxy() {
  local inst="$1" idx port cred user pw
  split_instance "${inst}" || fail
  idx="$(slot_of "${inst}")"
  [ -n "${idx}" ] || die "hdw4s: ${inst} has no slot."
  port="$(port_of "${idx}")"
  cred="${ETCDIR}/${inst}.auth.cred"

  # Match whichever transport the session is actually configured for; an
  # nginx block pointing at a port that is no longer listening is a confusing
  # way to spend an afternoon.
  local transport upstream
  transport='tcp'
  [ ! -r "${ETCDIR}/${inst}.conf" ] ||
    transport="$(sed -n "s/^[[:space:]]*HDW4S_TRANSPORT=[\"']\{0,1\}\([a-z]*\).*/\1/p" \
                 "${ETCDIR}/${inst}.conf" | tail -n1)"
  if [ "${transport}" = 'unix' ]; then
    upstream="        # A filesystem socket: who may connect is a question of
        # permissions, not of source address. Add nginx's user to the group
        # that owns it.
        proxy_pass http://unix:/run/hdw4s-proxy/${inst}.sock:;"
  else
    upstream="        proxy_pass http://HOST_RUNNING_HDW4S:${port};"
  fi

  pw=''
  if [ -e "${cred}" ] && [ ! -r "${cred}" ]; then
    die "hdw4s: ${cred} exists but is not readable by $(id -un).
  It holds the credential this block has to carry, so the block would be
  wrong rather than merely incomplete. Run this as root."
  fi
  if [ -r "${cred}" ]; then
    pw="$(systemd-creds decrypt --name=hdw4s-auth "${cred}" - 2>/dev/null)" || {
      echo "# Could not decrypt ${cred}; is this the machine that wrote it?" >&2
      pw=''
    }
  fi

  cat <<EOF
# nginx configuration for the hdw4s session "${inst}".
#
# Terminate TLS and authenticate your users here. Everything below assumes
# that has already happened: the session performs no user authentication and
# will hand a full desktop to whatever reaches it.

server {
    listen 443 ssl;
    server_name ${inst}.example.com;

    # ssl_certificate     /etc/ssl/certs/...;
    # ssl_certificate_key /etc/ssl/private/...;

    # ... your own authentication here: auth_request, OIDC, client certs ...

    # Give this desktop its own name in the browser tab. The client sets
    # document.title from the "name" in manifest.json -- it hardcodes "Selkies"
    # and then overwrites it from the manifest -- so serving a manifest here is
    # the supported way to tell two desktops apart, and needs no patched
    # client. The exact match wins over the "location /" below.
    location = /manifest.json {
        default_type application/json;
        return 200 '{"name":"Desktop: ${inst}","short_name":"${inst}","display":"fullscreen","background_color":"#000000","theme_color":"#000000","icons":[{"src":"icon-512.png","type":"image/png","sizes":"512x512"}],"start_url":"."}';
    }

    location / {
${upstream}
        proxy_http_version 1.1;

        # The stream is a WebSocket; without these it will connect and then
        # sit there.
        proxy_set_header Upgrade    \$http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host       \$host;
        proxy_set_header X-Real-IP  \$remote_addr;

        # A desktop is idle for long stretches and must not be timed out.
        proxy_read_timeout  86400s;
        proxy_send_timeout  86400s;
        proxy_buffering     off;

        # If you add a Content-Security-Policy here -- and a hardened proxy
        # usually does -- script-src must allow blob:. The streaming server
        # plays audio through an AudioWorklet it loads from a blob URL, and a
        # policy without it takes the sound away and nothing else: the picture,
        # the input and the resizing all keep working, the audio packets go on
        # arriving, and the page retries loading the worklet for as long as it
        # is open. Allowing blob: under default-src is not enough, because
        # script-src overrides it for worklets.
        #
        #   add_header Content-Security-Policy "... script-src 'self' blob: ...";
EOF
  if [ -n "${pw}" ]; then
    cat <<EOF

        # Presented by the proxy, never by the user, so there is still no
        # login screen. This is what an attacker who reaches the session port
        # directly -- by spoofing the proxy's address, say -- does not have.
        # This line carries the session's credential. Whatever file you paste
        # it into is readable by every account on that machine at the usual
        # 0644, which is the audience the credential exists to keep out --
        # so give the file 0640 root:www-data, or whatever group nginx runs as.
        proxy_set_header Authorization "Basic $(printf '%s:%s' "${user}" "${pw}" | base64 -w0)";
EOF
  else
    cat <<'EOF'

        # This session has no credential of its own, so the firewall is the
        # only thing protecting it. Run "hdw4s auth <instance>" to add one.
EOF
  fi
  cat <<'EOF'
    }
}
EOF
  unset pw
}

# Anything below these names is a cache: regenerable, frequently enormous, and
# actively unhelpful to carry across. Browsers are the reason this list is not
# just ".cache" -- Chrome keeps gigabytes of cache inside its profile
# directory, mixed in with the bookmarks and passwords that are worth keeping.
SEED_EXCLUDES=(
  'keyrings'                    # the isolated session has its own, with its own password
  'dconf/*-lock'
  '*/Cache' '*/Cache Data' '*/Code Cache' '*/GPUCache' '*/DawnCache'
  '*/GrShaderCache' '*/ShaderCache' '*/CacheStorage' '*/component_crx_cache'
  '*/Crash Reports' '*/Crashpad' '*/blob_storage'
  '*/Service Worker/CacheStorage' '*/Service Worker/ScriptCache'
  '*/optimization_guide_model_store' '*/segmentation_platform'
  # Downloaded models and component data. Regenerable, and much larger than
  # everything else put together: the on-device language model a current Chrome
  # fetches is nearly three gigabytes on its own, per profile.
  'OptGuideOnDeviceModel' '*/OptGuideOnDeviceModel'
  'OnDeviceHeadSuggestModel' '*/OnDeviceHeadSuggestModel'
  'WasmTtsEngine' '*/WasmTtsEngine'
  'Safe Browsing' '*/Safe Browsing'
  'SafetyTips' '*/SafetyTips' 'ZxcvbnData' '*/ZxcvbnData'
  'hyphen-data' '*/hyphen-data' 'SSLErrorAssistant' '*/SSLErrorAssistant'
  'Subresource Filter' '*/Subresource Filter'
  'TrustTokenKeyCommitments' '*/TrustTokenKeyCommitments'
  'MEIPreload' '*/MEIPreload' 'PKIMetadata' '*/PKIMetadata'
)

cmd_seed() {
  local inst="$1" from to pair pattern args=() copied=0 only=()
  shift
  while [ $# -gt 0 ]; do
    case "$1" in
      --only)   [ $# -ge 2 ] || die 'hdw4s: --only needs a path.'
                only+=("$2"); shift 2;;
      --only=*) only+=("${1#--only=}"); shift;;
      *)        die "hdw4s: seed: unexpected argument '$1'";;
    esac
  done
  split_instance "${inst}" || fail
  [ -n "$(slot_of "${inst}")" ] ||
    die "hdw4s: ${inst} has no slot; run 'hdw4s enable ${inst}' first."

  # setting_of, not a second copy of it: reading only the instance file meant a
  # site that set HDW4S_ISOLATION=profile globally was told its sessions were
  # not isolated, which is the normal way to configure this.
  local isolation
  isolation="$(setting_of "${inst}" HDW4S_ISOLATION none)"
  [ "${isolation}" = 'profile' ] ||
    die "hdw4s: ${inst} is not an isolated session; there is nothing to seed into." \
        "  Run 'hdw4s set ${inst} HDW4S_ISOLATION=profile' first."

  # Copying out from under a running desktop would capture half-written state.
  [ "$(systemctl is-active "$(unit_of "${inst}")" 2>/dev/null)" != 'active' ] ||
    die "hdw4s: stop ${inst} first: systemctl stop $(unit_of "${inst}")"

  local home profile
  home="$(getent passwd -- "${user}" | cut -d: -f6)"
  profile="$(profile_dir_of "${inst}")/${inst}"

  # This runs once and never merges. A profile that already has something in it
  # is a profile someone has used, and overwriting it would lose whichever of
  # the two copies happened to be newer -- silently, because nothing here can
  # tell which that is.
  for pair in config data state; do
    [ ! -d "${profile}/${pair}" ] ||
      [ -z "$(ls -A "${profile}/${pair}" 2>/dev/null)" ] ||
      die "hdw4s: ${profile}/${pair} is not empty." \
          '  Seeding copies once, into an empty profile, and never merges: there' \
          '  is no way to tell which of two copies of a setting is the newer one.' \
          "  Remove the profile first if you really mean to start it over."
  done

  # Checked before anything is opened. The prefix test below is a string test,
  # so ".config/../../../etc/shadow" passes it; tar then strips the leading
  # "./../../../" from the member name and the file lands in the profile under
  # a harmless-looking path. Nothing about a seeded path should ever leave the
  # home directory.
  local entry
  for entry in "${only[@]:-}"; do
    [ -n "${entry}" ] || continue
    case "/${entry}/" in
      */../*) die "hdw4s: '${entry}' leaves the home directory." \
                  '  A seeded path may not contain "..".';;
    esac
  done

  # The profile is created by systemd as StateDirectory and is owned by the
  # session user, who can therefore replace one of these with a symlink and
  # have root extract into whatever it points at.
  for pair in config data state; do
    [ ! -L "${profile}/${pair}" ] ||
      die "hdw4s: ${profile}/${pair} is a symbolic link; refusing to write through it."
  done
  [ ! -L "${profile}" ] ||
    die "hdw4s: ${profile} is a symbolic link; refusing to write through it."

  for pattern in "${SEED_EXCLUDES[@]}"; do args+=(--exclude="${pattern}"); done

  echo "Copying settings from ${home} into ${profile}."
  # An --only path that names none of the three trees below matched nothing and
  # said nothing, so "--only .mozilla" -- the case the manual singles out --
  # copied silently less than the administrator asked for.
  local -A matched=()
  for pair in "config:.config" "data:.local/share" "state:.local/state"; do
    to="${profile}/${pair%%:*}"
    from="${home}/${pair#*:}"
    [ -d "${from}" ] || continue

    # Without --only the whole tree is copied. With it, only the named entries
    # are, which is the usual case for an account that has been in use for
    # years: most of what has collected in there belongs to programs that will
    # never run in this session, and copying it forward just carries the
    # accumulation into a second place.
    local members=() entry rel
    if [ "${#only[@]}" -gt 0 ]; then
      for entry in "${only[@]}"; do
        rel="${entry#./}"
        case "${rel}" in "${pair#*:}"/*) matched["${entry}"]=1;; *) continue;; esac
        rel="${rel#"${pair#*:}"/}"
        if [ -e "${from}/${rel}" ] || [ -L "${from}/${rel}" ]; then
          members+=("./${rel}")
        else
          echo "  ${entry}: not there, skipped" >&2
        fi
      done
      [ "${#members[@]}" -gt 0 ] || continue
    else
      members=(.)
    fi

    install -d -m0700 "${to}"
    # tar rather than cp, because the exclusions are the whole point and cp has
    # no way to express them.
    # Read as the account that owns the home directory, not as root. ~/.config
    # belongs to the session user, who can replace it with a link to /root or
    # /etc; root would follow it, copy what it found, and then chown the copies
    # to that user. Dropping to the user first means the kernel refuses instead.
    if runuser -u "${user}" -- tar -C "${from}" -cf - "${args[@]}" \
           --warning=no-file-ignored "${members[@]}" 2>/dev/null |
       tar -C "${to}" -xf - 2>/dev/null; then
      printf '  %-14s %s\n' "${pair#*:}" "$(du -sh "${to}" 2>/dev/null | cut -f1)"
      copied=$(( copied + 1 ))
    else
      echo "  ${pair#*:}: copy failed" >&2
    fi
  done
  for entry in "${only[@]:-}"; do
    [ -n "${entry}" ] || continue
    [ -n "${matched[${entry}]:-}" ] || {
      echo "  ${entry}: outside .config, .local/share and .local/state; not copied" >&2
    }
  done

  chown -R "${user}" "${profile}" 2>/dev/null || :

  [ "${copied}" -gt 0 ] || die 'hdw4s: nothing was found to copy.'
  cat <<EOF

This was a one-time snapshot, not a link. From now on the two are separate:
a change made in one will not appear in the other, and running this again is
refused rather than silently overwriting whichever copy is newer.

Caches were left behind on purpose, browser caches included -- they are
regenerable and are usually most of the size.

Saved passwords were not copied. The session has its own keyring with its own
password; see 'hdw4s keyring ${inst}'.
EOF
}

cmd_keyring() {
  local inst="$1"
  require_slot "${inst}"

  # A keyring is only separate if the data directory holding it is. Without
  # isolation, XDG_DATA_HOME is the account's own ~/.local/share, so this would
  # point gnome-keyring at the login keyring and try to unlock it with a
  # freshly generated password. That fails, leaving one line on stderr -- after
  # telling the administrator the two are separate, which they are not.
  if [ "$(setting_of "${inst}" HDW4S_ISOLATION none)" != 'profile' ]; then
    die "hdw4s: ${inst} shares the account's home directory." \
        '  A separate keyring needs a separate data directory. Set' \
        "  'hdw4s set ${inst} HDW4S_ISOLATION=profile' first, or the keyring" \
        "  this would create could not be reached and the account's own login" \
        '  keyring would be the one unlocked.'
  fi

  make_credential "${inst}" 'keyring' 60 >/dev/null

  echo "Session ${inst} now has its own keyring, unlocked automatically."
  echo "It is separate from the account's login keyring, so passwords saved in"
  echo "one are not visible in the other."
  echo "Restart the session for this to take effect:"
  echo "  systemctl restart $(unit_of "${inst}")"
}

cmd_disable() {
  local inst="$1"
  split_instance "${inst}" || fail
  systemctl disable --now "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
  systemctl stop "hdw4s-proxy@${inst}.service" 2>/dev/null || :
  systemctl stop "$(unit_of "${inst}")" 2>/dev/null || :
  echo "Session ${inst} stopped. Its slot is still reserved;"
  echo "use 'hdw4s release ${inst}' to give it up."
}

cmd_release() {
  local inst="$1" tmp
  # An account that has since been deleted still holds a slot, and its port
  # stays open in the firewall. Refusing to release it because the account is
  # gone leaves editing the table by hand as the only way out -- which its own
  # header tells the administrator never to do. The name is still checked: it
  # is interpolated into the paths this function removes.
  #
  # The legacy spelling for the same reason: an instance named "<user>:<session>"
  # by a version that still created them is exactly the instance an administrator
  # now needs to be able to retire, so this is the one command that accepts the
  # name the rest of the tool refuses.
  split_legacy_name "${inst}" || fail
  systemctl disable --now "hdw4s-proxy@${inst}.socket" 2>/dev/null || :
  systemctl stop "hdw4s-proxy@${inst}.service" "$(unit_of "${inst}")" 2>/dev/null || :
  rm -rf "$(dropin_of "${inst}")" \
         "${DROPIN}/hdw4s-proxy@${inst}.service.d" \
         "${DROPIN}/hdw4s-proxy@${inst}.socket.d"
  rm -f "${ETCDIR}/${inst}.keyring.cred" "${ETCDIR}/${inst}.auth.cred"
  if [ -r "${SLOTS}" ]; then
    tmp="$(mktemp "${SLOTS}.XXXXXX")"
    awk -v i="${inst}" '$1 ~ /^#/ || $2 != i' "${SLOTS}" > "${tmp}"
    chmod 0644 "${tmp}"
    mv "${tmp}" "${SLOTS}"
  fi
  systemctl daemon-reload
  echo "Session ${inst} released. Its credentials were removed with it, so a"
  echo 'keyring in the profile below can no longer be unlocked. Left in place:'
  echo "its profile under"
  echo "$(profile_dir_of "${inst}")/${inst}, and its settings in"
  echo "${ETCDIR}/${inst}.conf."
  case "${inst}" in
    # Nothing can enable this name again, so saying the leftovers are there to
    # be restored would be an offer that cannot be taken up. Say what they
    # actually are: rubbish, and safe to delete once anything wanted out of the
    # profile has been taken.
    *:*)
      echo 'Nothing can enable that name again -- an account has one desktop --'
      echo 'so both are now only a copy to salvage settings from, and can be'
      echo 'deleted once you are done with them.';;
    *)
      echo 'Re-enabling the session restores them. The slot, and with it the'
      echo 'port, is not reserved and may go to someone else; enabling again'
      echo 'rewrites the port that conf file records.';;
  esac
}

case "${1:-}" in
  list)     shift; cmd_list "$@";;
  show)     shift; [ $# -eq 1 ] || usage_error; cmd_show "$@";;
  enable)   shift
            case "${1:-}" in --ephemeral) [ $# -eq 2 ] || usage_error;;
                         *)           [ $# -eq 1 ] || usage_error;; esac
            cmd_enable "$@";;
  disable)  shift; [ $# -eq 1 ] || usage_error; cmd_disable "$@";;
  keyring)  shift; [ $# -eq 1 ] || usage_error; cmd_keyring "$@";;
  seed)     shift; [ $# -ge 1 ] || usage_error; cmd_seed "$@";;
  reap)     shift; cmd_reap "$@";;
  auth)     shift; [ $# -eq 1 ] || usage_error; cmd_auth "$@";;
  noauth)   shift; [ $# -eq 1 ] || usage_error; cmd_noauth "$@";;
  transport) shift; [ $# -eq 2 ] || usage_error; cmd_transport "$@";;
  proxy)    shift; [ $# -eq 1 ] || usage_error; cmd_proxy "$@";;
  set)      shift; cmd_set "$@";;
  unset)    shift; cmd_unset "$@";;
  release)  shift; [ $# -eq 1 ] || usage_error; cmd_release "$@";;
  firewall) shift; exec /usr/lib/hdw4s/hdw4s-firewall "$@";;
  --version) echo "hdw4s ${HDW4S_VERSION}";;
  -h|--help|help|'') usage;;
  *) echo "hdw4s: unknown command '$1'" >&2; usage >&2
     trap '' INT TERM QUIT HUP EXIT ERR; exit 2;;
esac
