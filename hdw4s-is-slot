#!/bin/sh
# Exit 0 if the account named $1 is an ephemeral slot this machine minted.
#
# Asked by polkit (60-hdw4s-slots.rules), which runs this as its own
# unprivileged user and only for the few actions that rule is about, so it must
# be cheap and must never guess yes.
#
# THE EVIDENCE IS AN ARTEFACT ONLY THE MINTER MAKES, not the name: pool slots
# follow a prefix but template rows are named by the administrator, and a
# pattern would either miss those or catch a real person called "ephemeral3".
# hdw4s-ephemeral-slots writes the slot's own passwd view under
# /run/hdw4s-ns/<name>/ as root, for slots and nothing else, and /run is empty
# after every boot, so a stale answer cannot outlive the slot table.
#
# Group membership would be the textbook test (subject.isInGroup), and it was
# tried first: on Ubuntu 24.04 neither a userdb membership file nor memberOf in
# the slot's record made the group appear in the account's groups (measured
# 2026-09-30), so polkit could not have seen it either.
case "${1:-}" in
  ''|*/*|.*|*[!A-Za-z0-9._-]*) exit 1;;
esac
[ -f "/run/hdw4s-ns/$1/passwd" ]
