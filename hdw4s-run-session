#!/bin/bash -e
export LC_ALL='C'
set -o nounset -o pipefail

# The inside of the private D-Bus session created by hdw4s-session. Everything
# here shares one bus, and that bus is what separates this desktop from any
# other one belonging to the same account.

instance="${1:?usage: hdw4s-run-session <instance>}"

: "${DISPLAY:?}" "${XDG_RUNTIME_DIR:?}" "${HDW4S_STREAM_SOCKET:?}"

# The desktop to run. This is the one line that has to change to outlive GNOME
# on X11: GNOME 50 removes the X11 session that the streaming server needs,
# while Xorg and the lighter desktops have no such plan. Everything else here
# -- the X server, the streaming, the audio, the isolation -- is unaffected by
# which of them is started.
: "${HDW4S_SESSION:=gnome-session}"
: "${HDW4S_MICROPHONE:=no}"
: "${HDW4S_WEBCAM:=no}"
: "${HDW4S_WEBRTC:=no}"
: "${HDW4S_TURN_HOST:=}"
: "${HDW4S_TURN_PORT:=3478}"
: "${HDW4S_FRAMERATE:=30,8-60}"
: "${HDW4S_DPI:=follow}"
: "${HDW4S_INDEXING:=off}"
: "${HDW4S_THUMBNAILS:=off}"
: "${HDW4S_DEBUG_DESKTOP:=off}"
: "${HDW4S_HIDPI:=scale}"
: "${HDW4S_ENCODER:=h264enc}"
: "${HDW4S_STARTUP_HOLD:=on}"

# The streaming server now defaults this to true and implements resizing itself,
# so this is no longer a workaround for anything -- it is kept as an explicit
# statement of intent, because a desktop that does not follow the browser window
# is the single most noticeable way this product feels wrong.
#
# It governs the primary display only; any second display follows its own page.
: "${HDW4S_RESIZE:=true}"

# hdw4s-session already chose the session locale and cleared LC_ALL before
# creating the bus. This script sets LC_ALL=C again at the top for its own
# parsing, so drop it once more before anything user-facing is started.
unset LC_ALL

# "stopping" is how the code after a long wait learns that the unit is being
# stopped: the trap kills the children but does not exit, so without it a wait
# that is interrupted would carry on and start the stream on a dying unit.
children=()
stopping=''
trap 'stopping=1
      trap "" INT TERM QUIT HUP EXIT
      [ "${#children[@]}" -eq 0 ] || kill "${children[@]}" 2>/dev/null || :' \
     INT TERM QUIT HUP EXIT

# Only touch a key if its schema is actually installed, and never wait long. A
# missing schema makes gsettings abort, and every write below goes to the
# settings service over the session bus, where a service that is slow to
# activate -- or that is never going to answer -- would otherwise block with no
# timeout of its own.
#
# THE SHAPE THESE TWO USED TO HAVE, and the three separate defects in it,
# because a reader who does not know them will simplify this back:
#
#     timeout 10 gsettings writable "$schema" "$key" >/dev/null 2>&1 || return 0
#     timeout 10 gsettings set "$schema" "$key" "$value" 2>/dev/null ||
#       echo "hdw4s: could not set ..." >&2
#
#  1. `gsettings set` EXITS 0 ON A LOST BUS, with the value unchanged. Measured,
#     and written up in private/in-session.sh's own header after four straight
#     measurements were void because of it: "a guessed or globbed
#     DBUS_SESSION_BUS_ADDRESS makes `gsettings set` print 'failed to commit
#     changes to dconf' AND EXIT 0". So the "|| echo" diagnostic was unreachable
#     for exactly the failure the `timeout 10` in front of it exists to
#     anticipate. A write that vanished looked identical to one that landed.
#  2. `gsettings writable` prints true or false ON STDOUT and exits 0 either
#     way. ">/dev/null 2>&1 || return 0" threw the verdict in the bin and
#     branched on a status that carries none, so the early return could only
#     fire when the command itself failed to run. Measured: it never once fired.
#  3. That same line talks to the bus, so on a dead bus the function returned 0
#     -- a silent skip indistinguishable from "the schema is not installed",
#     which is the one thing it was written to detect.
#
# DEFECT 3 IS THE ONE A REVIEWER WILL THINK IS ALREADY FIXED, so it is spelled
# out. Reading point 2 on its own suggests the repair is to stop throwing the
# verdict away -- capture `gsettings writable`'s stdout and branch on true or
# false. THAT CHANGES NOTHING ABOUT POINT 3. A dead bus makes that improved test
# fail in exactly the way an absent schema makes it fail: no verdict, non-zero
# or empty, return 0, nothing written and nothing said. The two causes are
# indistinguishable AT THAT CALL, so no test applied to it can tell them apart,
# however good the test is.
#
# The only thing that separates them is asking about the RESULT rather than
# about the permission: did the value change to what was asked for. That is why
# the repair is a read-back and not a better test, and this paragraph is here so
# that a reviewer who thinks a better test would do can see why it would not.
#
# A BETTER EXIT-STATUS TEST FIXES NONE OF THEM, because there is no status to
# test: the failing command returns success. Set, read back, compare against
# what was asked for. That is the only primitive that survives all three, and
# unlike the two above it rests on no stdout-or-status contract measured on one
# box with one version of GLib.
#
# AND THE READ STILL WORKS WHERE THE WRITE DOES NOT, which is what makes it a
# check rather than a second guess. dconf(7) serves a READ out of a memory map
# of the databases; only a WRITE needs dconf-service on the session bus. So the
# read-back answers precisely in the case where the write silently did nothing,
# and it is also why it can be the presence test: a bus that is gone can no
# longer disguise itself as a schema that is not installed.
#
# MEASURED, as the positive control for the whole repair: inside a live session
# with DBUS_SESSION_BUS_ADDRESS pointing at nothing, "gsettings set" exited 0 and
# a following "gsettings get" returned THE OLD VALUE. The write vanished and the
# read-back saw that it had.
#
# THE READ MUST BE A SEPARATE PROCESS FROM THE WRITE, and that is the one thing
# here somebody will tidy away. GSettings keeps an in-process cache: a read-back
# sharing a process with the write can be answered from the writer's own memory
# and return the value it just asked for, having committed nothing. That is a
# verification built out of the defect it verifies -- it cannot fail. Two
# separate "gsettings" invocations re-derive from the database, which is why this
# is written as two commands and not as one helper, one Gio.Settings object or
# one loop holding a handle. Collapsing them does not look like a behaviour
# change and silently stops this checking anything.
#
# A LOCKED KEY IS AGREEMENT, NOT AN ERROR, and that one sentence is the shortest
# statement of why the read-back is the right primitive.
#
# A key the administrator has locked in the dconf system database does not take
# our write, and reads back with the value the lock enforces -- which is the
# value we asked for, for every key this file writes, because dconf/10-policy
# sets what dconf/locks/10-policy locks. The screensaver keys are all three.
#
# So an exit-status check does not merely fail to catch the defect: MADE FATAL,
# IT WOULD KILL EVERY SESSION ON A CORRECTLY CONFIGURED BOX. The better the
# administrator's configuration, the more of the pool it takes down. That is not
# a judgement about how loud a lost write should be; it is a fact about the
# option, and it is the reason the comparison is against the VALUE and never
# against a status.

# The value a key has RIGHT NOW, or nothing and non-zero if there is no such
# schema or key here. One command, used for the presence test and for the
# read-back, so the two cannot disagree about what they are looking at.
gsettings_value() {
  timeout 10 gsettings get "$1" "$2" 2>/dev/null
}

# Said in one place so that every one of these lines is greppable as one thing,
# and so that the next person changing what a lost write costs changes it once.
#
# NOT FATAL, AND THAT IS A DECISION THIS SEAT DID NOT MAKE. The block below
# carries a recorded ruling in the opposite direction -- "None is worth delaying
# a desktop for, let alone preventing one from starting -- which is exactly what
# happened when the settings service did not answer" -- and the screensaver
# keys carry Markus's ruling that they are a footgun with no legitimate use.
# Those two pull opposite ways for the same keys, and choosing between them
# quietly here would be the wrong place to do it. What this does NOT do is claim
# to be a guard while permitting everything: it reports, loudly, in a fixed
# form, and nothing anywhere says the write was verified.
settings_write_lost() {
  local schema="$1" key="$2" want="$3" got="$4"
  echo "hdw4s: SETTING NOT IN FORCE: ${schema} ${key}" >&2
  echo "hdw4s:   asked for [${want}], the session has [${got}]" >&2
  echo "hdw4s:   The write returned success. gsettings set exits 0 on a lost" \
       'session bus with the value unchanged, so this was read back rather' \
       'than believed.' >&2
  # THE TWO CAUSES, both of them, because naming one invites the reader to stop
  # there. The first live mismatch this reported was the second cause -- a value
  # written as 'nothing' rather than "'nothing'" -- and a message that had named
  # only the lost write would have sent somebody looking at the bus.
  echo 'hdw4s:   Either the write did not reach the settings database, or the' \
       'value above is spelled differently from the way gsettings prints it.' \
       'Compare the two forms first; they are not always the same fault.' >&2
}

set_if_present() {
  local schema="$1" key="$2" value="$3" got
  # PRESENCE, from a read. See point 3 above: this is the line that used to
  # turn a dead bus into a silent skip.
  gsettings_value "${schema}" "${key}" >/dev/null || return 0
  # The status is deliberately ignored. It is 0 for the failure that matters and
  # non-zero for a locked key that is already correct, so it is not evidence in
  # either direction; the read below is.
  timeout 10 gsettings set "${schema}" "${key}" "${value}" 2>/dev/null || :
  got=$(gsettings_value "${schema}" "${key}") || {
    # The key was readable a moment ago and is not now. Nothing in normal
    # operation does that, so it is reported rather than folded into "absent".
    echo "hdw4s: ${schema} ${key} could not be read back after writing it" >&2
    return 0
  }
  # TEXTUAL, on the GVariant printing, and said out loud because it is the one
  # soft spot left. Every value this file writes prints back byte-identical to
  # what it passes -- false, 'nothing', 'never', uint32 0, @as [] -- and that is
  # checked on a real session rather than assumed. A future key whose printing
  # differs from its input would report a mismatch that is not one; the repair
  # then is to write the key in the form gsettings prints, not to weaken this.
  [ "${got}" = "${value}" ] || settings_write_lost "${schema}" "${key}" \
                                                   "${value}" "${got}"
}

# The other half of set_if_present, and not optional. A setting this session
# writes into the profile's own database stays written: turning the setting
# back off in the configuration does not undo it, because nothing goes back to
# look. Without this, HDW4S_INDEXING=on left the indexer with an empty list of
# directories and no way to recover short of editing dconf by hand.
#
# WEAKER THAN THE ABOVE, AND THE ASYMMETRY IS REAL RATHER THAN AN OVERSIGHT
# that a later reader should close by copying the comparison down here. "Set"
# knows the value it is aiming at and can compare against it. "Reset" aims at
# whatever the layers underneath happen to say, and the only way to learn that
# is to read the key after resetting it -- which is the answer itself, so the
# comparison would be a value against itself and could not fail. That shape is
# named in the project's own rules as one of the three ways a check passes while
# proving nothing, and writing it here would be worse than leaving the gap.
#
# WHAT THIS DOES GET, and it is the same two defects as above: the presence test
# is a read, so a dead bus can no longer disguise itself as an absent schema,
# and a key that stops being readable between the two calls is reported instead
# of passed over. WHAT IT DOES NOT GET: a reset that vanished on a dead bus,
# which still looks exactly like a key that was already at its default. Closing
# that needs one probe of the write path per session rather than a per-key
# check, and that is not built -- see the handback, not a TODO nobody reads.
reset_if_present() {
  local schema="$1" key="$2"
  gsettings_value "${schema}" "${key}" >/dev/null || return 0
  timeout 10 gsettings reset "${schema}" "${key}" 2>/dev/null || :
  gsettings_value "${schema}" "${key}" >/dev/null ||
    echo "hdw4s: ${schema} ${key} could not be read back after resetting it" >&2
}

# Applied in the background, once the desktop is on its way up. These three are
# conveniences: nobody can unlock a screen with no keyboard attached to it, and
# a blanked screen would stop the stream updating with no way to wake it. None
# is worth delaying a desktop for, let alone preventing one from starting --
# which is exactly what happened when the settings service did not answer.
(
  set_if_present org.gnome.desktop.screensaver  lock-enabled     false
  set_if_present org.gnome.desktop.session      idle-delay       'uint32 0'
  # "'nothing'" AND NOT 'nothing'. The shell strips the outer quotes, so the
  # second form passes the bare word and gsettings parses it as the string
  # "nothing" -- the right value, written in a spelling gsettings does not print
  # back. The read-back below compares text, so it reported a mismatch on a
  # session whose setting was perfectly correct: "asked for [nothing], the
  # session has ['nothing']". Found by the read-back itself on its first live
  # start, which is the only reason anybody looked; nothing else in the file
  # distinguishes the two spellings and the value they produce is identical.
  #
  # The repair is to write the value the way gsettings prints it, never to
  # loosen the comparison -- a comparison that forgives a quoting difference
  # also forgives the next real difference. show-image-thumbnails below is
  # already written this way; this was the one call site that was not.
  set_if_present org.gnome.settings-daemon.plugins.power \
                                              sleep-inactive-ac-type "'nothing'"
) &
children+=($!)

# The unit is a system service, so this account has no systemd user manager of
# its own and nothing has started the audio stack. On a current Ubuntu that is
# PipeWire; calling pulseaudio here as well would leave two servers racing for
# the same socket.
#
# This has to happen inside the D-Bus session rather than before it. PipeWire
# and WirePlumber both reach for the session bus at startup, and started any
# earlier they find nothing there and spend the session complaining about it.
if [ -x /usr/bin/pipewire ]; then
  install -d -m0700 "${PULSE_RUNTIME_PATH}"
  /usr/bin/pipewire &            children+=($!)
  /usr/bin/wireplumber &         children+=($!)
  /usr/bin/pipewire-pulse &      children+=($!)
elif [ -x /usr/bin/pulseaudio ]; then
  /usr/bin/pulseaudio --start --exit-idle-time=-1 || :
fi

# Unlock this session's own keyring, if one was set up with "hdw4s keyring".
# The password arrives from systemd in a read-only, non-swappable file that
# exists only for the lifetime of the unit, so it is never written to disk here
# and never appears in the process table.
if [ -n "${CREDENTIALS_DIRECTORY:-}" ] &&
   [ -r "${CREDENTIALS_DIRECTORY}/hdw4s-keyring" ] &&
   command -v gnome-keyring-daemon >/dev/null; then
  gnome-keyring-daemon --start --components=secrets,pkcs11,ssh --unlock \
    < "${CREDENTIALS_DIRECTORY}/hdw4s-keyring" >/dev/null 2>&1 || {
    echo 'hdw4s: could not unlock the session keyring' >&2
  }
elif [ "${HDW4S_SESSION_TYPE:-}" = 'ephemeral' ] &&
     command -v gnome-keyring-daemon >/dev/null; then
  # An ephemeral session gets a keyring with no password, created here so that
  # nothing has to ask for one later.
  #
  # Without this the profile has no keyring at all, and the first program to
  # store a secret -- a browser saving a password is the usual one -- raises
  # "choose a password for the new keyring". That is a bad question to be asked
  # here: there is no password for this session, the keyring is destroyed with
  # the profile when the connection ends, and anything it protected dies with
  # it. A password would protect data that cannot outlive the session from an
  # attacker who would have to be inside it.
  #
  # An empty password is what makes the collection open without a prompt.
  # Measured: --unlock on its own does NOT create the keyring, and asking the
  # Secret Service to create a collection returns a prompt object instead. The
  # daemon has to be started with --daemonize and given the password on stdin;
  # then login.keyring and user.keystore appear and the default alias resolves.
  printf '\n' | gnome-keyring-daemon --daemonize --unlock \
    --components=secrets,pkcs11,ssh >/dev/null 2>&1 || {
    echo 'hdw4s: could not create the session keyring; programs that store a' >&2
    echo '  secret will ask for a keyring password' >&2
  }
fi

# Tell the bus what a program it launches should inherit. Without this, a
# service started by D-Bus activation gets almost nothing -- no DISPLAY, no
# XAUTHORITY -- and simply exits. On a normal login the session manager does
# this via the systemd user instance; there is no such instance here, so the
# job falls to us. It is not a terminal-specific fix: everything launched by
# activation depends on it.
#
# The variables are listed rather than passed with --all, because this
# environment also holds the session's proxy credential, and everything on the
# bus can read what is uploaded here.
# Keep the readiness notification to ourselves.
#
# NotifyAccess=all is required because the process that reports ready is a
# helper rather than the main one -- but it also lets anything else in the
# control group report ready, and gnome-session does exactly that when it
# reaches its running phase. That is earlier than the stream is listening, so
# the unit went active while nothing could yet be connected to, and units
# ordered After= it started against a promise that had not been kept.
#
# Removing the variable from the environment the desktop inherits leaves the
# notification to the one place that knows what it means.
HDW4S_NOTIFY_SOCKET="${NOTIFY_SOCKET:-}"
unset NOTIFY_SOCKET

dbus-update-activation-environment \
  DISPLAY XAUTHORITY ICEAUTHORITY \
  XDG_RUNTIME_DIR XDG_SESSION_TYPE XDG_SESSION_CLASS XDG_CURRENT_DESKTOP \
  XDG_CONFIG_HOME XDG_DATA_HOME XDG_STATE_HOME XDG_CACHE_HOME \
  GNOME_SHELL_SESSION_MODE PATH HOME LANG \
  PULSE_SERVER PULSE_RUNTIME_PATH PIPEWIRE_RUNTIME_DIR \
  GVFS_DISABLE_FUSE \
  DCONF_PROFILE \
  2>/dev/null || echo 'hdw4s: could not publish the activation environment' >&2

# The desktop's file indexer, off by default. On a home shared between machines
# it is work without an answer: each machine crawls the same tree over the
# network, keeps its own copy of the result on local disk, and cannot see a
# change made from another machine, because the only change notification it has
# is inotify and inotify does not cross NFS. One real account here keeps 107GB
# of photographs in a directory the indexer is configured to crawl.
#
# Not removed and not masked. The package is a hard dependency of the file
# manager, and masking the user units would reach the account's real login
# session on this machine, which nothing here is allowed to do. These are the
# keys Settings -> Search -> Search Locations writes, so the change is visible
# where a user would look for it and they can undo it there for their own
# session. The daemon still starts and still answers; it has nothing to crawl.
#
# Applied here rather than in the background block below, because the miner
# reads them once at startup and "probably wins the race" is not a mechanism.
#
# What was here before was "export TRACKER_DISABLE_MINERS=all", which no
# Tracker 3 binary reads -- it was a Tracker 2 control. It had been believed for
# long enough that a test was skipped on the strength of it while the miner ran.
if [ "${HDW4S_INDEXING}" = 'off' ] && [ "${HDW4S_ISOLATION:-none}" = 'profile' ]
then
  set_if_present org.freedesktop.Tracker3.Miner.Files \
                 index-recursive-directories '@as []'
  set_if_present org.freedesktop.Tracker3.Miner.Files \
                 index-single-directories    '@as []'
  set_if_present org.freedesktop.Tracker3.Miner.Files \
                 index-removable-devices     false
  set_if_present org.freedesktop.Tracker3.Miner.Files \
                 index-optical-discs         false
  # Belt and braces with nothing configured to crawl, but this is the key that
  # stops inotify watches being taken out at all, and those are a per-user
  # kernel limit shared with everything else the account is running.
  set_if_present org.freedesktop.Tracker3.Miner.Files enable-monitors false
elif [ "${HDW4S_INDEXING}" = 'off' ]; then
  echo 'hdw4s: HDW4S_INDEXING=off needs HDW4S_ISOLATION=profile; the indexer' \
       'belongs to the account rather than to this session, so it has been' \
       'left alone.' >&2
elif [ "${HDW4S_ISOLATION:-none}" = 'profile' ]; then
  # Put back whatever a previous "off" wrote. These keys live in the profile's
  # own database, so they survive the setting changing underneath them.
  for _k in index-recursive-directories index-single-directories \
            index-removable-devices index-optical-discs enable-monitors; do
    reset_if_present org.freedesktop.Tracker3.Miner.Files "${_k}"
  done
  rm -f "${XDG_CONFIG_HOME}/autostart/tracker-miner-fs-3.desktop"
fi

# Image thumbnails, off by default for the same reason and with a caveat.
#
# The file manager's own setting for this is "local-only", which sounds like
# the protection a network home wants and is not: "local" there means the
# kernel calls the filesystem native, and it calls NFS native. So the default
# thumbnails a network home exactly as eagerly as a local disk, reading each
# image in full over the network to do it.
#
# Weaker grounds than the indexer, and worth saying so. The result is cached in
# the profile, which persists, so it is a cost per machine rather than per
# session; the file manager skips anything over its own size limit anyway; and
# unlike the indexer this is something the user can see and probably wants.
# What tips it is the delivery: a desktop reaching a browser as a video stream
# pays for a wall of thumbnails twice, once over NFS and again in the encoder.
#
# HDW4S_THUMBNAILS=on gives them back.
if [ "${HDW4S_THUMBNAILS}" = 'off' ] && [ "${HDW4S_ISOLATION:-none}" = 'profile' ]
then
  set_if_present org.gnome.nautilus.preferences show-image-thumbnails "'never'"
elif [ "${HDW4S_THUMBNAILS}" = 'off' ]; then
  echo 'hdw4s: HDW4S_THUMBNAILS=off needs HDW4S_ISOLATION=profile; the setting' \
       'belongs to the account rather than to this session, so it has been' \
       'left alone.' >&2
elif [ "${HDW4S_ISOLATION:-none}" = 'profile' ]; then
  reset_if_present org.gnome.nautilus.preferences show-image-thumbnails
fi

# Whether these desktops may see a camera.
#
# The same shape as the microphone, plus one moving part. The virtual camera is
# created on the first frame from the browser, and applications reach it
# through the V4L2 interposer the streaming server's package ships: a shared
# object that intercepts the calls a program makes to open a camera and answers
# them from the session's own socket. So the interposer has to be in the
# environment of the session's *applications*, and the uplink has to be running
# for there to be anything behind it.
#
# It must not be in the environment of the streaming server, which is the thing
# on the other end of that socket. Preloading it there would have the producer
# of the frames intercepting its own camera calls. Hence two launches with
# different environments rather than one setting for both; lockdown.py asserts
# the streaming server's environment stays clear of it.
webcam_preload=''
# A capture device starts when something in the session actually reads it, not
# when the page connects. With on-start the browser is asked for the camera as
# the session connects, so the indicator light on the user's own machine comes
# on and stays on for the whole session whether or not anything reads it -- and
# a light that is always on tells nobody anything.
#
# There is no probe for this and no fallback to on-start. There used to be, for
# a --webcam-on-demand flag that only ever existed on the branch proposing it.
# Upstream took the feature and spelled it differently -- a third value on the
# setting that was already there -- so that flag now exists nowhere, and a
# fallback would be a branch for a spelling no release will ever carry.
#
# What replaces it is the version floor. hdw4s requires Selkies 2.0, which is
# still a release candidate with no production installations, so there is no
# installed base whose camera a hard requirement could break: the only thing a
# runtime probe would protect is a deployment nobody has. The requirement
# belongs where the version is chosen -- KNOWN_GOOD in hdw4s-update -- stated
# once, rather than rediscovered on every session start.
#
# The failure mode against an older server is measured, not assumed: "demand"
# goes through parse_bool, whose rule is "everything else is false", so the
# server starts and the uplink stays off. For the microphone that leaves no
# capture device in the session at all, because the virtual source is created
# inside the data path. It is silent, which is why the floor is a release
# blocker and not a note.

case "${HDW4S_WEBCAM}" in
  yes)
    # Enabled, but deliberately NOT locked. The dashboard hides a control
    # whose setting is locked -- isRenderable() in the sidebar returns false on
    # locked regardless of the value -- so "true|locked" leaves the camera
    # working and takes away the only way for the person sitting there to turn
    # it off. Locking a camera on is not pinning a preference, it is removing a
    # privacy control. Unlocked, the value is still what this session starts
    # with; the difference is that its owner can stop it.
    webcam=(--webcam-enabled=true --webcam-on-start=demand)
    # The streaming server's package ships the interposer for several
    # architectures -- on this machine x86_64 and i386 -- and they are plain
    # .so files with no soname, so ldconfig does not index them and a bare
    # LD_PRELOAD name does not resolve. The path has to be spelled out, and it
    # has to be the one matching this machine: a glob picks i386 first, and the
    # loader then declines to preload a 32-bit object into a 64-bit process,
    # warns once to stderr, and carries on with no camera. That failure looks
    # exactly like the feature not working.
    for so in "/usr/lib/$(uname -m)-linux-gnu/selkies_v4l2_interposer.so" \
              /usr/lib/*/selkies_v4l2_interposer.so; do
      [ -e "${so}" ] || continue
      webcam_preload="env LD_PRELOAD=${so}"
      break
    done
    if [ -z "${webcam_preload}" ]; then
      echo 'hdw4s: HDW4S_WEBCAM=yes but the V4L2 interposer was not found, so' \
           '  applications will not see a camera. It ships with the streaming' \
           '  server; check that package is installed.' >&2
    fi
    ;;
  *) webcam=(--webcam-enabled='false|locked') ;;
esac

# The per-session desktop background, written before the desktop starts. GNOME
# reads picture-uri as it comes up; a file that arrives afterwards is a
# wallpaper nobody sees appear.
#
# WHY IT IS WRITTEN HERE AND NOWHERE ELSE. The image has to be per session, and
# the file has to be inside the session: /home/user is a tmpfs that exists only
# in this unit's mount namespace, so nothing outside it can write there at all.
# hdw4s-ephemeral-slots runs once at boot, as root, outside every namespace --
# it can set the dconf value and it cannot produce the file. hdw4s-incarnation
# runs at the right moment and still in the wrong namespace. This script is the
# first thing that is inside, running as the occupant, before the desktop.
#
# DERIVED, NEVER ASSUMED: it asks dconf what picture-uri is ACTUALLY in force
# and writes only when the answer is the path this product owns. One line, and
# it buys three things. An administrator with a template (hdw4s template) keeps their
# wallpaper -- that layer outranks ours, measured with a control -- because the
# value read back is theirs and not ours, and nothing here has to know the
# template exists. An administrator who set HDW4S_EPHEMERAL_BACKGROUND to a
# flat colour or to an image of their own gets no file written. And the setting
# keeps exactly ONE parser, in hdw4s-ephemeral-slots, rather than gaining a
# second one here to disagree with it the way the idle window's setting did.
#
# A dconf READ needs no session bus -- the system database is a direct memory
# map, which is the whole reason this profile is a system-db -- so this answers
# correctly even on a session whose settings service never came up. What it
# reads is the layer in force, which is the question being asked.
if [ "${HDW4S_SESSION_TYPE:-}" = 'ephemeral' ]; then
  background_file="${HOME}/.hdw4s/background.svg"
  if [ "$(gsettings_value org.gnome.desktop.background picture-uri)" = \
       "'file://${background_file}'" ]; then
    "${HDW4S_LIBDIR:-/usr/lib/hdw4s}/hdw4s-background" write \
        "${instance}" "${background_file}" || {
      # Reported and not fatal. A desktop nobody can tell apart is a worse
      # product; a desktop that will not start is a worse outcome.
      echo 'hdw4s: no per-session background was written, so this desktop' >&2
      echo '  comes up on the flat fallback colour and looks exactly like' >&2
      echo '  every other ephemeral desktop on this machine.' >&2
    }
  fi
fi

# INSTRUMENTING THE DESKTOP LAYER, off unless asked for.
#
# WHY IT EXISTS. On 2026-09-26 a desktop came up black on a production box with
# every ordinary sign healthy: the shell had started, all three of its startup
# lines were in the journal, it was burning no CPU, and the desktop-icons
# process was idle and indistinguishable from a working one. The only thing that
# differed was the size of the desktop-icons WINDOW -- 66x32 instead of 904x1118
# -- and the geometry the shell extension published on the bus was correct at
# the time it was read. So the data was right, the processes were healthy, and
# nothing anywhere recorded what the desktop layer did with either. An evening
# of archaeology ended with "static inspection is exhausted".
#
# These three variables are the only way that component says anything at all.
# gjs is silent by default: without GJS_DEBUG_TOPICS an exception inside the
# desktop-icons app reaches nobody, which is why the journals of a broken and a
# working session were identical in the part that mattered.
#
# WHY IT IS OFF BY DEFAULT rather than always on. G_MESSAGES_DEBUG=all is loud
# enough to be its own problem on a box running thirty desktops -- it would push
# the interesting lines out of the journal, which is the failure this is meant
# to prevent. An administrator turns it on for the session they are chasing.
#
# WHY NOT A GLOBAL DEBUG SWITCH. "Debug" that means everything means nobody can
# turn on the part they need, so the next person adds a second switch. This one
# names the layer it instruments and nothing else.
if [ "${HDW4S_DEBUG_DESKTOP}" = 'on' ]; then
  export GJS_DEBUG_TOPICS='JS ERROR;JS LOG'
  export GJS_DEBUG_OUTPUT='stderr'
  export SHELL_DEBUG='backtrace-warnings'
  # G_MESSAGES_DEBUG=all IS DELIBERATELY NOT SET, having been measured.
  # With it, one session wrote 14769 journal lines against 416 for a session
  # without it -- thirty-five times the volume, written synchronously during the
  # startup window a visitor is waiting through. The owner reported desktops
  # feeling slower within the hour of it being switched on, which made his own
  # reports evidence about the instrument rather than about the product. The
  # observer was in the log. What it bought was dconf watch_fast chatter;
  # what it cost was the measurement. GJS_DEBUG_TOPICS above is the line that
  # actually carries ding's own errors, and it is quiet.

  # THE GEOMETRY CONVERSATION, captured while it happens.
  #
  # The desktop's size is published as a GAction state on the session bus and
  # changes as monitors and work areas change. Reading it AFTERWARDS -- which is
  # what was available on 2026-09-26 -- answers what it is now, never what
  # arrived during startup or in what order, and startup is the whole window in
  # which this goes wrong.
  #
  # BOUNDED BY CONSTRUCTION, not by rotation. It runs for a fixed time and
  # stops, so it cannot fill a runtime directory that lives in RAM on an
  # ephemeral session. Three minutes covers a start that normally takes ten
  # seconds and was seen taking ninety.
  #
  # IT SAYS WHETHER IT RAN. dbus-monitor is not a dependency of this package and
  # need not be installed. A capture that silently did not happen is the shape
  # this project keeps being bitten by -- an empty file reads as "nothing was
  # sent", which is the opposite of "nobody was listening" -- so the absence is
  # written INTO the file it would have written.
  debug_dir="/run/hdw4s/${instance}"
  if [ -d "${debug_dir}" ]; then
    if command -v dbus-monitor >/dev/null 2>&1; then
      {
        echo "# desktop geometry traffic on the session bus"
        echo "# started $(date -Is), capture window 180s"
        echo "# an empty body below means NOTHING WAS SENT, not that nothing ran"
      } > "${debug_dir}/desktop-geometry.log"
      # THREE MATCH RULES, AND THE SECOND ONE IS THE REPAIR. Filtering on the
      # interface alone captured ding ASKING for the geometry and never the
      # answer, because a D-Bus method RETURN carries no interface at all -- so
      # the one message that says what ding was actually told was the one
      # message excluded. Measured 2026-09-26: a captured failure showed the
      # question at t+0 and a correction 33s later, and the reply in between,
      # which decides whether the extension answered wrongly or ding mishandled
      # a good answer, was absent. Two theories, opposite repairs, and no way to
      # choose. Errors are captured for the same reason: a refused call is an
      # answer too, and its absence reads identically to silence.
      #
      # It is noisier -- every method return on the bus, not only ding's. That
      # is affordable because the window is bounded at 180s and this is off
      # unless somebody is chasing a specific desktop.
      timeout 180 dbus-monitor --session \
        "interface='org.gtk.Actions'" \
        "type='method_return'" \
        "type='error'" >> "${debug_dir}/desktop-geometry.log" 2>&1 &
      children+=($!)
    else
      echo "# dbus-monitor IS NOT INSTALLED -- no capture was taken." \
        > "${debug_dir}/desktop-geometry.log"
      echo 'hdw4s: HDW4S_DEBUG_DESKTOP=on but dbus-monitor is not installed;' >&2
      echo '  the environment variables are set, the bus capture is not taken.' >&2
    fi
  fi
fi

# THE STARTUP HOLD, part one: arm the watcher BEFORE the desktop starts.
#
# GNOME 46 has two defects that leave a starting desktop black for good, and
# the stream sets off both: it injects the visitor's pointer, and resizes the
# screen to the browser, the moment a browser connects -- which is usually
# while the desktop is still starting.
#
#   mutter 46: one input event queued before the stage is first shown makes
#   clutter refuse every later update. Fixed in mutter 47.3 (GNOME issue 3804).
#   gnome-shell 46: a screen size change between the stage being shown and
#   the end of startup leaves the whole interface hidden. Fixed in gnome-shell
#   50 (GNOME issue 9018).
#
# So the stream starts only once startup has finished (part two, below), as
# hdw4s-stage-wait sees it, and with deadlines of its own for when that is not
# seen. Holding only until the stage was SHOWN was tried first and made the
# second defect more likely: it moved the resize into exactly its span.
#
# The watcher has to be listening before the stage window is CREATED, not
# merely before it is shown: that is when it can first select on it, and a
# walk from the root cannot find it later. Hence the order: arm, wait for
# "armed", then start the desktop.
#
# EVERY PATH FAILS OPEN, and the reads and the arithmetic are the reason for
# the shape. This script runs under -e and nounset: a bare "read -t" that
# times out returns 142 and would end the session, an arithmetic expansion on
# a value that is not a number ends it too, and a named session would then
# restart in a loop. So each read sits in an "if", the verdict is judged by
# its text, and every number is checked before any arithmetic sees it. The
# watcher is a process substitution, not a coproc: bash unsets a finished
# coproc's variables, which nounset turns into the same crash.
#
# REMOVE THIS when Ubuntu 24.04 leaves the supported set, or when the
# supported releases carry BOTH fixes and the reproducer no longer goes black,
# for a motion arm or a resize arm, with HDW4S_STARTUP_HOLD=off. It does NOT
# cover gnome-shell restarting while the stream is already live; a new stage
# then starts with input flowing.

# A whole number of seconds, short enough that the arithmetic cannot overflow.
# Anything else -- empty, "60s", garbage -- is not one.
is_seconds() {
  case "${1}" in ''|*[!0-9]*) return 1 ;; esac
  [ "${#1}" -le 12 ]
}
# Uptime in whole seconds, or a failure. Truncated, so it can read up to a
# second EARLY: a deadline compared against it can be overshot by under a
# second, which the start-deadline margin below absorbs.
uptime_s() {
  local up _
  read -r up _ 2>/dev/null < /proc/uptime || return 1
  up="${up%%.*}"
  is_seconds "${up}" || return 1
  echo "$(( 10#${up} ))"
}
# For log lines that quote a value from outside: nothing but what a number or
# a word needs, so a hostile value cannot write a line of its own.
quoted() {
  local v="${1//[!0-9a-zA-Z.]/}"
  echo "${v:0:24}"
}

# THE BOUND. Once the stage has been shown for this long without the shell
# signalling that startup has finished, the stream starts anyway. It is a
# FALLBACK: an ordinary start gives the signal a second or two after it is
# shown and never reaches it. A shell that starts into the overview, or with a
# dialog up, never gives the signal and always waits it out.
#
#   B = ceil(2 x the slowest measured time from the stage being shown to the
#       end of startup) = ceil(2 x 8.91 s) = 18 s.
#
# The 8.91 s was one of nine desktops started together on a machine loaded to
# twice its CPU count. The base is the END OF STARTUP, not the signal, because
# on a start that never signals only the end of startup makes a release safe.
# What else protects a release is that no resize can reach the desktop until
# the stream has started and a browser has connected, about a second under
# load. Re-derive B if a slower start is ever measured; do not tune it by hand.
#
# NOT COVERED: with HDW4S_DPI set to anything but 96, the streaming server
# rewrites the screen's physical size before any browser connects, and that
# reaches the same rebuild as a resize. A start released by this bound can
# then still go black.
hold_bound=18

# THE START DEADLINE, for a desktop that is never shown at all. The unit's
# ExecStartPost waits HDW4S_ANNOUNCED_GATE_WAIT seconds (the same variable, and
# the same default, as hdw4s-webroot reads) for the stream to announce itself,
# counted from about when the X server is up -- after this session began. The
# stream takes up to about 1.6 s from being started to announcing (measured
# under load), so the hold ends 6 s before that wait would: twice that, plus
# two seconds for this clock's rounding.
hold_margin=6

stage_fd=''
stage_pid=''
stage_armed=''
hold_outer=''
# HOW THE HOLD ENDED, as one word, for the page (see "startup hold outcome"
# below). Anything that does not reach a verdict leaves it "unknown".
hold_outcome='unknown'
if [ "${HDW4S_STARTUP_HOLD}" = 'on' ]; then
  hold_skip=''
  hold_gate="${HDW4S_ANNOUNCED_GATE_WAIT:-60}"
  hold_t0="${HDW4S_T0:-}"
  if ! is_seconds "${hold_t0}"; then
    # Unset when an older hdw4s-session started this script, across an upgrade.
    hold_skip="the session's start time ($(quoted "${hold_t0:-unset}"))"
  elif ! is_seconds "${hold_gate}"; then
    hold_skip="HDW4S_ANNOUNCED_GATE_WAIT ($(quoted "${hold_gate}"))"
  elif ! hold_now="$(uptime_s)"; then
    hold_skip='the clock (/proc/uptime)'
  fi
  if [ -n "${hold_skip}" ]; then
    echo "hdw4s: startup hold skipped: ${hold_skip} is not a whole number of seconds; starting the stream unheld" >&2
  else
    hold_outer=$(( 10#${hold_t0} + 10#${hold_gate} - hold_margin ))
    if [ $(( hold_outer - hold_now )) -lt 1 ]; then
      echo "hdw4s: startup hold skipped: no time left before the start deadline ($(( hold_now - 10#${hold_t0} )) s since the session began, of ${hold_gate})" >&2
    else
      # Its stderr is left on the journal: when it fails open, its one line
      # there is the only record of why (a missing module looks like a slow
      # start).
      exec {stage_fd}< <(exec /usr/lib/hdw4s/hdw4s-stage-wait 3 "${hold_bound}")
      stage_pid="$!"
      children+=("${stage_pid}")
      stage_line=''
      if read -r -t 5 -u "${stage_fd}" stage_line && [ "${stage_line}" = 'armed' ]; then
        stage_armed=1
      fi
    fi
  fi
  # A stop during that read would otherwise go on to start the desktop into a
  # dying unit; the trap only killed what had been started so far.
  if [ -n "${stopping}" ]; then
    echo 'hdw4s: stopped before the desktop started' >&2
    exit 0
  fi
fi

# The watcher's pipe is closed in the desktop, so nothing started under it
# inherits the descriptor or can read the verdict meant for this script.
if [ -n "${stage_fd}" ]; then
  # shellcheck disable=SC2086
  ${webcam_preload} ${HDW4S_SESSION} {stage_fd}<&- &
else
  # shellcheck disable=SC2086
  ${webcam_preload} ${HDW4S_SESSION} &
fi
children+=($!)
session_pid="$!"

# A session normally authenticates nobody, because the reverse proxy in front
# already has. Where the proxy cannot be reached over a filesystem socket and
# an address is all that distinguishes it, HDW4S_AUTH=basic adds a secret the
# proxy must present as well: an attacker who reaches the port directly, by
# spoofing the proxy's address or by being on the same network, still does not
# have it. The user never sees it, so there is still no login screen.
#
# The secret is passed in the environment rather than on the command line,
# where it would be visible to every account on the machine through ps.
#
# It is ALSO readable by this session's own user, and whether that is a concern
# depends on which session type this is -- the sentence that used to stand here
# said it was not, and that stopped being true when hdw4s-ephemeral@ was added:
#
#   hdw4s@          their desktop, their proxy credential. Not a concern.
#   hdw4s-ephemeral@ the occupant is a stranger and runs as this uid. He can
#                   read it out of /proc/<pid>/environ and straight out of
#                   $CREDENTIALS_DIRECTORY/hdw4s-auth, which is mode 0400 owned
#                   by him. Both were measured, not reasoned about.
#
# There is no way to keep it from him: the streaming server has no interface for
# this credential other than SELKIES_BASIC_AUTH_PASSWORD in its environment, and
# it runs as him. So the property this credential can still have is not secrecy
# from the occupant but a SHORT LIFE -- it must not open the next occupant's
# session. "hdw4s auth" mints once and deliberately never rotates, which means
# today it does. That is recorded as the repair; this comment is the warning
# until it lands.
#
# What is fixed here is only the gratuitous copy: no credential goes in argv.
if [ "${HDW4S_AUTH:-none}" = 'basic' ] &&
   [ -n "${CREDENTIALS_DIRECTORY:-}" ] &&
   [ -r "${CREDENTIALS_DIRECTORY}/hdw4s-auth" ]; then
  # An instance is the account name; the strip keeps the user name right for an
  # instance named "<user>:<session>" by a version that still created them,
  # which can still be running.
  SELKIES_BASIC_AUTH_USER="${instance%%:*}"
  SELKIES_BASIC_AUTH_PASSWORD="$(cat "${CREDENTIALS_DIRECTORY}/hdw4s-auth")"
  export SELKIES_BASIC_AUTH_USER SELKIES_BASIC_AUTH_PASSWORD
  auth='--enable_basic_auth=true'
else
  if [ "${HDW4S_AUTH:-none}" = 'basic' ]; then
    echo 'hdw4s: HDW4S_AUTH=basic but no credential was supplied;' >&2
    echo "  run 'hdw4s auth ${instance}'. Refusing to start unauthenticated." >&2
    exit 1
  fi
  auth='--enable_basic_auth=false'
fi

# The streaming server ships with a third party's TURN relay and a shared
# secret published in its own source, and uses them unless told otherwise --
# routing a desktop's video, keystrokes and clipboard through a machine nobody
# here controls, silently, as a default. Passed empty so it falls back to its
# own STUN-only configuration.
#
# These are not settings. A relay needs credentials, and there is nowhere to
# put them: hdw4s-session sources the configuration files as the session user,
# so anything written there is readable by every desktop on the machine.
# Supporting a relay properly means sealing its secret the way "hdw4s auth"
# seals the proxy credential, and until that exists, offering a knob that
# cannot be used safely would be worse than offering nothing.
export SELKIES_TURN_HOST=''
export SELKIES_TURN_PORT=''
export SELKIES_TURN_SHARED_SECRET=''
export SELKIES_TURN_USERNAME=''
export SELKIES_TURN_PASSWORD=''
export SELKIES_TURN_REST_URI=''

# Read at startup and documented as overriding every other STUN and TURN
# setting. It defaults to /tmp/rtc.json, and PrivateTmp gives the session its
# own /tmp owned by the session user -- so anything running in the desktop
# could drop a file there and point its own media at a relay of its choosing.
# An empty value never exists, so the override can never be taken.
export SELKIES_RTC_CONFIG_JSON=''

# Upstream's own entry point, run directly. There is nothing of ours between
# the unit and the streaming server: 2.0 ships a distribution package with a
# console script, so there is no venv to find, no module to import, and no
# subclass to stand up. Everything this package wants from the server is asked
# for on the command line below.
stream=(/opt/selkies/bin/selkies)
# EXCEPT WITH WebRTC. Selkies' WebRTC mode connects to its own signalling endpoint
# as a client, over TCP to localhost whatever the listener is, carrying the
# session's credential and the server's master token -- and nothing of ours
# listens on that port any more, so whoever binds it first would be answering.
# hdw4s-selkies-webrtc sends that one connection through the stream's unix socket
# instead, and refuses to start rather than fall back if it no longer recognises
# the code it adapts. Only here: a websockets-only session keeps nothing of ours
# between the unit and the server.
if [ "${HDW4S_WEBRTC}" = 'yes' ]; then
  stream=(/opt/selkies/bin/python /usr/lib/hdw4s/hdw4s-selkies-webrtc)
fi

# HDW4S_FRAMERATE is a range: where a session starts, and how far a client may
# move it from the video settings panel.
#
# The default is "30,8-60" -- start at 30, and let someone who wants smoother
# motion ask for up to 60. Measured on one session, 1280x656, over 25 seconds:
#
#   hardware encoding (VAAPI)     30fps -> 16% of a core   60fps -> 19%
#   software encoding (x264)      30fps -> 34% of a core   60fps -> 49%
#
# So on a machine with a GPU the second half of that range is nearly free, and
# on one without it costs about half a core per session that asks for it. Both
# reached the rate they were given. 120 was also measured on hardware, at 27%,
# and is available to anyone who sets it.
#
# A bare number still means a hard ceiling -- "30" is "30,8-30" -- so an
# administrator who pinned a rate keeps exactly what they pinned.
#
# The server changed this meaning underneath us once already: a bare number
# sets only the *initial* value while leaving the span at its own default of 8
# to 240, so a client could raise itself to 240 from the sidebar and the setting
# would look like it had been honoured.
#
# Passed as "N,8-N" instead: start at N, and refuse anything above it, while
# still letting a client drop lower on a bad link. A value that already names a
# range is passed through untouched, so this cannot fight an explicit one.
case "${HDW4S_FRAMERATE}" in
  *[!0-9]*) framerate="${HDW4S_FRAMERATE}" ;;
  *)        framerate="${HDW4S_FRAMERATE},8-${HDW4S_FRAMERATE}" ;;
esac

# What the streaming server is told to switch off.
#
# The security contract of this package is that a session authenticates nobody,
# because the proxy in front already did, and that the only thing it offers is a
# desktop. The streaming server no longer agrees with the second half of that by
# default: out of the box it also serves a file manager over the user's Desktop
# directory, accepts uploads into it, lets any caller restart the media stack in
# WebRTC mode, and admits extra viewers and gamepad players to a live session.
#
# None of that is wrong for its own audience. It is wrong for a session whose
# front door is an address on a list. So everything that widens the surface is
# named here and turned off, rather than left to a default that may change.
#
# Two of these read oddly and are deliberate. An empty value no longer means
# "off": the server treats an empty override as absent and restores its own
# default, so every switch has to carry a literal false. And the microphone and
# webcam gates only refuse when a setting is *locked* off, so "false|locked" is
# the form that actually keeps them shut.
# The streaming server applies a client's display density to the desktop, and
# applying it means writing ~/.Xresources and ~/.xsettingsd -- top-level
# dotfiles that no XDG variable has ever covered, so profile isolation does not
# move them and a shared home sees them on every machine the account touches.
# ~/.Xresources keeps the user's own lines and loses only their Xft.dpi;
# ~/.xsettingsd is rewritten whole. Pinning the density here makes the server
# ignore what a client asks for, and pinning it to 96 means it writes nothing
# at all.
#
# Left following by default, because the alternative is worse for most people:
# every HiDPI screen and every zoomed window would get an unscaled desktop,
# permanently and visibly, to prevent one line and a file that nothing on a
# GNOME system reads.
dpi=()
[ "${HDW4S_DPI}" = 'follow' ] || dpi=(--scaling-dpi="${HDW4S_DPI}")

# How a high-density client is handled.
#
# "native" is upstream's default and is wrong on GNOME. The client asks for a
# framebuffer at its device resolution -- a 2x screen on a 1600x900 window gets
# 3200x1800 -- and the desktop is still drawn at scale 1, so every control and
# all text come out at half the intended size. Crisp and unusable.
#
# It is not a setting we failed to turn on. GNOME would scale this itself, but
# mutter derives the scale from the monitor's physical size, and the virtual
# monitor reports 0mm x 0mm, at which point mutter returns 1.0 and stops. The
# DPI the streaming server can be told is inert here too: it reaches GNOME only
# through xrdb, and gnome-settings-daemon owns that value. Sending 192 writes
# Xft.dpi into the user's home and changes nothing on screen.
#
# "scale" asks the client for the CSS resolution instead and lets the browser
# stretch it. Correct size on a 2x screen, byte-identical on a 1x one, and a
# quarter of the pixels through a software H.264 encoder. The cost is that the
# image is smoothed rather than pixel-exact.
#
# A user who prefers the sharper picture can switch it back for their own
# browser from the sidebar, with no restart; the pick outranks this default.
#
# The better answer is to give the virtual monitor a physical size that tracks
# the client's density, the way Chrome Remote Desktop does, which would let
# GNOME scale natively and crisply. That needs code upstream does not have, and
# is on the list to offer them.
case "${HDW4S_HIDPI}" in
  native) hidpi=(--use-css-scaling=false) ;;
  *)      hidpi=(--use-css-scaling=true)  ;;
esac

# Whether the accounts behind these sessions may be heard.
case "${HDW4S_MICROPHONE}" in
  # Unlocked for the same reason as the webcam below: a locked setting has
  # no control in the dashboard, and a microphone nobody can mute is worse
  # than one that starts off.
  # Present, and started by something opening it: the browser is not asked for
  # the microphone until a program in the session wants one.
  yes) microphone=(--microphone-enabled=true --microphone-on-start=demand) ;;
  *)   microphone=(--microphone-enabled='false|locked') ;;
esac

# WebRTC, and the reason turning it on is not simply a flag. The streaming
# server's TURN defaults name a live third-party relay
# (staticauth.openrelay.metered.ca) with a published shared secret, so a session
# that switches to WebRTC without saying otherwise hands the browser a working
# credential for a stranger's relay.
#
# Two things make that hard to switch off. A setting overridden to the empty
# string is treated as not overridden at all and reverts to its default, so
# blanking a TURN setting restores the relay rather than removing it. And the
# shared-secret path emits a TURN entry unconditionally -- there is no value of
# turn_host that produces none. So a concrete host is always passed here, and it
# is an RFC 2606 `.invalid` name, which by standard can never resolve: the
# client's relay candidate fails at DNS, on IPv4 and IPv6 alike, with no
# dependence on a firewall or on what the network routes. The secret is random so
# no credential for a real host is ever minted, and it travels in the environment
# rather than argv, where any process could read it.
#
# The other route to the same place has now been measured, and it went the wrong
# way: rtc_config_json outranks the shared-secret path, it defaults to
# /tmp/rtc.json, and /tmp is private to the session and writable by whoever is
# sitting in it. An occupant who writes that file replaces the whole ICE
# configuration -- the pin above included -- at the next transport switch, and
# the session logs "overrides all other STUN/TURN settings" while doing it.
# Upstream does check the file, but it trusts one "owned by root or the current
# user", and in a desktop the current user IS the occupant.
#
# So the path is pinned somewhere the occupant cannot reach. /usr is read-only
# inside the session's namespace under ProtectSystem=strict -- measured from
# inside a live session, not assumed -- and no such file is ever shipped, so the
# lookup fails at "does it exist" and the shared-secret path below is what
# decides. An admin who wants a real relay says so with HDW4S_TURN_HOST, which
# is the supported way and does not involve a file the desktop can write.
#
# Google and Cloudflare STUN stay. The config generator appends them whatever is
# configured, they reflect an address rather than carrying media, and
# `webrtc-ice-lite` keeps this server from contacting either: only the user's own
# browser does.
# A path under a read-only prefix that is never shipped, so it cannot exist and
# cannot be created from inside a session. Passed in both branches: the "no"
# branch has no ICE today, and a pin that only holds while a second setting
# happens to be off is not a pin.
rtc_config_none='/usr/lib/hdw4s/rtc-config.disabled'

case "${HDW4S_WEBRTC}" in
  yes)
    webrtc=(--enable-dual-mode='true|locked' --webrtc-ice-lite='true|locked'
            --rtc-config-json="${rtc_config_none}")
    if [ -n "${HDW4S_TURN_HOST}" ]; then
      if [ -z "${HDW4S_TURN_SECRET:-}" ]; then
        echo 'hdw4s: HDW4S_TURN_HOST is set but HDW4S_TURN_SECRET is empty, so the' \
             'credential would be signed with a guessable secret. Refusing to start.' >&2
        exit 1
      fi
      webrtc+=(--turn-host="${HDW4S_TURN_HOST}" --turn-port="${HDW4S_TURN_PORT}")
      export SELKIES_TURN_SHARED_SECRET="${HDW4S_TURN_SECRET}"
    else
      webrtc+=(--turn-host='turn.invalid' --turn-port="${HDW4S_TURN_PORT}")
      turn_secret="$(head -c 18 /dev/urandom | base64)"
      export SELKIES_TURN_SHARED_SECRET="${turn_secret}"
    fi
    ;;
  *)
    # No client-initiated switch to WebRTC, so no ICE, STUN, TURN or mDNS socket
    # ever appears, and nothing to hand out if one ever did.
    webrtc=(--enable-dual-mode='false|locked' --webrtc-ice-lite='true|locked'
            --rtc-config-json="${rtc_config_none}")
    ;;
esac

lockdown=(
  # Every boolean below carries "|locked". Without it the value is only a
  # default: a bool the server reads back out of a client's SETTINGS frame is
  # whatever that client last asked for, and only the lock makes the server
  # keep its own answer. Binary clipboard is the one upstream wires into that
  # path today, so whichever way it is set, only the lock makes the setting
  # mean anything -- a client frame moved it in both directions while the
  # settings the server publishes went on reporting the old value. The others
  # are not reachable that way today. They are locked anyway, so that the day
  # one of them is wired up is not the day a control silently stops holding.
  "${webrtc[@]}"
  --file-transfers='upload,download'
  # Files move in both directions, and they land in the account's Downloads
  # folder rather than anywhere this tool invents. The directory is created
  # when the module is imported, before any flag is consulted, so pointing it
  # at a path that already exists is what stops a stray folder appearing on a
  # home that is shared across every machine -- which is why this is not simply
  # the home itself. It also bounds what the browser can read: the file API
  # serves this directory, not the account.
  --file-manager-path="${HOME}/Downloads"
  --enable-binary-clipboard='true|locked'
  # The one control here that is a policy rather than a refusal. The server
  # refuses microphone data on exactly one condition -- "not enabled and
  # locked" (selkies.py, the MICROPHONE_DISABLED path) -- so 'false|locked' is
  # a hard no and 'true|locked' is a yes that the client still has to act on.
  # It does not switch anyone's microphone on: the uplink starts off
  # (microphone_on_start defaults false), the browser asks for the device, and
  # muting is the client's toggle. The lock keeps the choice the operator's
  # without taking the moment-to-moment decision away from the user.
  #
  # "on" also starts the uplink, and that is what makes the device exist: the
  # virtual source the session's own applications see is created inside the
  # *data* path, so until the browser is actually sending there is no capture
  # device in the session at all and anything enumerating devices finds none.
  #
  # ⚠ It has a sharp edge, measured rather than guessed. Starting the uplink
  # makes the client ask the browser for the device as the session connects,
  # and when that request cannot be satisfied -- the prompt declined, no
  # microphone on the machine, an automated client -- the *video* stream never
  # starts either. The page loads and stays blank with nothing said. One
  # session, one flag: 18 of 18 walkthrough checks without it, 4 of 18 with
  # either one alone.
  #
  # It is kept on anyway, because a desktop whose camera and microphone simply
  # work is the point, and because the failure needs a client that cannot grant
  # the permission at all. The walkthrough now grants it the way a person does
  # -- see browser.py -- so the suite exercises the configuration that ships
  # rather than a quieter one.
  #
  # The real fix belongs upstream: a refused or impossible permission must not
  # block the video path. Filed in the tally.
  "${microphone[@]}"
  "${webcam[@]}"
  --gamepad-enabled='false|locked'
  # Every form of second viewer. These do not widen who can reach a session:
  # a viewer still needs a credential, and the view-only one is a separate
  # password that cannot match while it is unset -- measured, not assumed.
  # What they widen is what a second viewer may do once here, which in this
  # deployment is anyone the proxy has already let through.
  #
  # That reasoning is conditioned on the session type and says so, because it
  # was nearly reused where it is false: it holds where each person has their
  # own front door and their own credential, so "past the proxy" means "is that
  # person". It does NOT hold for a session type reached from one front door
  # with no identity in front of it, where "past the proxy" means "is on the
  # network".
  #
  # Which of the three is actually consumed is transport-dependent, and it was
  # got wrong once in the other direction -- a note claiming all three are dead
  # on the websockets path, generalised from one build, and it is not true of
  # the tree below. Measured by reading the code at upstream
  # selkies-project/selkies 2.0.0rc0-188-g8fd2aaef, whole-word matches:
  #
  # That revision cannot be read again: upstream squashed and force-pushed the
  # branch it names. WHICH file reads which flag was re-checked against
  # 2.0.0rc1, the release the updater now installs, and still holds -- the
  # WebRTC/websockets split below is right. WHAT each flag then does was not
  # re-read there, so those three sentences are from the vanished build and are
  # unverified against rc1.
  #
  #   enable_sharing  WebRTC ONLY. Nothing on the websockets path reads it, so
  #                   where websockets is the configured transport this switch
  #                   is inert and must not be described as a control.
  #   enable_shared   read on BOTH. On websockets it refuses a client asking for
  #                   the viewer role. Turning it off does not make sharing
  #                   read-only -- it removes view-only viewers and leaves the
  #                   interactive ones, which is the opposite of the intent a
  #                   reader brings to the name.
  #   enable_collab   read on BOTH. It is the switch that decides whether a
  #                   non-controller may hold an input context at all, so it is
  #                   the one that genuinely separates watching from driving.
  #
  # So "turn the sharing flags off" is neither a no-op nor a way to get
  # read-only sharing, and the flag names do not predict which it is. Check the
  # transport that is configured before reasoning from any of them.
  --enable-sharing='true|locked'
  --enable-shared='true|locked'
  --enable-collab='true|locked'
  --enable-player2='false|locked'
  --enable-player3='false|locked'
  --enable-player4='false|locked'
  --command-enabled='false|locked'    # already the default; pinned so a change
                                      # of default cannot quietly hand out a
                                      # shell
  --enable-metrics-http='false|locked'
  # X11 mints a RandR monitor on demand, so a second display needs no hardware
  # on this side at all: it appears as another browser window to put on
  # whatever monitor the viewer has.
  --second-screen='true|locked'
  # Branding, partially. This names the sidebar heading and nothing else.
  #
  # The browser TAB and an installed app are named by the web root below, which
  # EVERY session gets -- named desktops too, since the gate became universal --
  # and without which it does not start: hdw4s-gate-index writes the title
  # element and inlines hdw4s-title.js, which keeps the client's own word out of
  # the tab, and hdw4s-webroot rewrites the manifest the page links. There used
  # to be a sentence here saying a session with no web root keeps the packaged
  # manifest and reads "Selkies"; no such session exists any more, and the
  # sentence was being read as a live gap. An administrator who wants each
  # named desktop told apart serves a manifest of their own at the proxy (the
  # "hdw4s proxy" sample does), and the title keeper reads its name.
  --ui-title=Desktop
)

# EVERY session is served a GATED client: one that does not connect, and
# therefore does not take the desktop away from whoever already has it, until a
# person presses a button. Both transports evict on connect, so withholding the
# connection is the whole mechanism -- there is nothing to undo afterwards and
# nothing to ask upstream for.
#
# NAMED SESSIONS TOO, since 2026-09-22, and the comment that used to stand here
# said the opposite: that a named desktop "is meant to follow its user between
# machines and take itself over on arrival, which is the opposite requirement."
# That was ruled against. The owner opened one named session in two tabs, watched
# the second take the desktop and freeze-frame the first with no warning, and
# ruled: gate wherever automatic action could do damage, and stealing a session
# is damage. It is kept here as a deleted claim rather than silently replaced,
# because it was the stated justification for withholding the gate and somebody
# reading only the old line would restore the behaviour.
#
# What the gate costs a named session is ONE CLICK PER FRESH TAB, and that was
# accepted knowingly. It cannot be made cheaper: the gate's arrival decision is
# per-tab browser storage, so a reload never asks and a new tab always does.
# There is no signal that removes the click, because any added precision can only
# push a case TOWARDS asking -- silence has to gate.
#
# Note what is NOT consulted: this gate makes no server request, and reads no
# incarnation token. A long analysis of whether we could prove "nobody else is
# attached" turned out not to bear on it at all, because the shipped mechanism
# never asks that question.
#
# If the web root cannot be built, the session does NOT start. Selkies' own
# behaviour on a missing web root is to log one warning and serve the packaged
# client, which would come up healthy in every check this product has while
# silently missing the only thing the gate is for.
webroot="${HDW4S_WEBROOT_DIR:-/usr/share/hdw4s/webroot}/${instance}"
# BUILT ELSEWHERE, ON PURPOSE. This script runs inside the session unit, where
# ProtectSystem=strict makes /usr read-only -- so generating the tree here
# fails, and generating it somewhere the session CAN write would hand the
# occupant its own served client to edit. hdw4s-ephemeral-slots builds it as
# root, once per slot, before any session can start; this only verifies it and
# points the server at it.
# The instance is passed so the check can also assert this start's published identity
# (see layer 4 in hdw4s-webroot): present, this generation's, and different from the
# last one. Without it a returning tab cannot tell a respawned desktop from the one it
# was using, and connects silently to somebody else's.
# THE GATE IS NOT RUN HERE, AND IT CANNOT BE. It used to be, and the call was
# unsatisfiable by construction -- which went unnoticed because the incarnation
# layer had never actually run on any machine until 2026-09-22.
#
# Layer 4 asserts that hdw4s-incarnation published an identity for THIS start,
# by reading /run/hdw4s-incarnation/<instance>. That record is root-owned and
# mode 0600 on purpose: the occupant must not be able to forge it. But this
# script is the session, and the unit sets User=%i, so everything here runs AS
# the occupant -- which cannot read it. Measured, with a control: as the slot
# uid the read is EACCES; as root it succeeds. The unit also listed that path in
# InaccessiblePaths= at the time, so the namespace hid it as well -- two
# independent barriers, both deliberate, both aimed at the same process that
# had to pass. That second barrier is gone now: it was redundant with the 0700
# mode and is no longer in the unit.
#
# So the gate moved to "ExecStartPre=!hdw4s-webroot gate %i" in the unit, which
# runs as root with the session's own mount namespace intact. It still runs at
# this start and after the incarnation unit, so it still proves this generation
# rather than a stale one -- which was the property the in-session call was
# reaching for and never achieved. Do not move it back here to "test what the
# session sees": the session cannot see the evidence, and a check the occupant
# could satisfy is not a gate against the occupant. Do not change that "!" to a
# "+" either; the unit says at length what that cost.
# CAN THIS UID ACTUALLY OPEN THE INDEX? Asked HERE, and nowhere else can ask it.
#
# Selkies decides whether to use a web root with os.path.isdir() and
# os.path.isfile() -- two stat calls. A directory it cannot traverse fails them
# and is announced as a refusal, which the unit's "hdw4s-webroot
# announced-gate" catches. But an index.html that STATS and will not OPEN
# passes both: the server announces acceptance, and then serves an error for
# every request while every check in this product reports health. That case was
# the one thing the HTTP fetch of the front door uniquely caught, and it is not
# dropped silently just because the fetch is gone.
#
# It cannot be asked from the unit's Exec lines, and this is not the same
# argument as the one above about layer 4. Those lines run as root with "!", and
# root opens a file the session's uid cannot -- so a root check would report
# green on exactly the fault. This script is the session: the unit sets User=%i,
# so the uid here IS the uid that is about to exec the streaming server, derived
# by construction rather than looked up or assumed.
#
# An open, not "[ -r ]": access(2) answers about the permission bits, and the
# question is whether the read succeeds.
head -c 1 < "${webroot}/index.html" > /dev/null 2>&1 || {
  echo "hdw4s: cannot read '${webroot}/index.html' as $(id -un). The streaming" >&2
  echo '  server tests its web root with stat, so it would ACCEPT this tree and' >&2
  echo '  then fail every request -- coming up healthy with no gate in it.' >&2
  exit 1
}
stream+=(--web-root="${webroot}")

# THE STARTUP HOLD, part two: do not start the stream until startup is over.
#
# The watcher reports "shown" when the stage is mapped, then one verdict:
# "ready" (the shell signalled the end of its startup), "bound" (it has been
# shown for hold_bound seconds without that signal), or "none" (nothing to
# watch). "lost" means the stage was destroyed; a new "shown" may follow. None
# of this says whether the desktop is healthy -- a black desktop is released
# by "bound" too. Do not turn this into a health check.
#
# Two deadlines of this script's own, so a watcher that dies or hangs costs a
# bounded wait: the START deadline while nothing has been shown, and hold_bound
# + 2 seconds after a "shown" (never later than the start deadline). A "lost"
# puts the start deadline back, so the old stage's bound cannot release the
# stream inside the new stage's startup. Reaching either deadline only means
# the old behaviour: the stream starts anyway.
#
# Stops: systemd holds back "systemctl stop" until the unit's start job has
# finished, so a stop requested during this wait arrives after it. Only a
# start timeout or a signal sent directly reaches the trap here, and "stopping"
# is how this loop learns of one.
#
# One line is logged on every start, naming which way the hold ended: that is
# the field's measurement of what it costs and how often the signal is missing.
if [ -n "${stage_fd}" ]; then
  if [ -n "${stage_armed}" ]; then
    hold_deadline="${hold_outer}"
    hold_shown=''     # ms after "armed", from the watcher, of the current stage
    hold_ever_shown=''
    hold_replaced=0
    hold_end=''
    stage_line=''
    while :; do
      if ! hold_now="$(uptime_s)"; then hold_end='clock'; break; fi
      hold_rem=$(( hold_deadline - hold_now ))
      if [ "${hold_rem}" -lt 1 ]; then hold_end='deadline'; break; fi
      stage_rc=0
      if read -r -t "${hold_rem}" -u "${stage_fd}" stage_line; then :; else stage_rc="$?"; fi
      if [ -n "${stopping}" ]; then hold_end='stopping'; break; fi
      if [ "${stage_rc}" -ne 0 ]; then
        # More than 128 is read's own timeout, which the loop's next pass
        # names; 1 is end of file: the watcher died without a verdict.
        [ "${stage_rc}" -gt 128 ] && continue
        hold_end='eof'; break
      fi
      case "${stage_line}" in
        shown\ *)
          hold_shown="${stage_line#shown }"; hold_shown="${hold_shown%% *}"
          is_seconds "${hold_shown}" || hold_shown='?'
          hold_ever_shown=1
          if hold_now="$(uptime_s)"; then
            [ $(( hold_now + hold_bound + 2 )) -ge "${hold_outer}" ] ||
              hold_deadline=$(( hold_now + hold_bound + 2 ))
          fi ;;
        lost\ *)
          hold_replaced=$(( hold_replaced + 1 ))
          hold_shown=''
          hold_deadline="${hold_outer}" ;;
        ready\ *|bound\ *|none\ *)
          hold_end="${stage_line%% *}"; break ;;
        *)
          # Not a line this script knows: fail open rather than guess.
          hold_end='garbled'; break ;;
      esac
    done
    hold_ms="${stage_line#* }"; hold_ms="${hold_ms%% *}"
    is_seconds "${hold_ms}" || hold_ms='?'
    hold_note=''
    [ "${hold_replaced}" -eq 0 ] ||
      hold_note=" after ${hold_replaced} stage replacement(s)"
    case "${hold_end}" in
      stopping) ;;
      ready)
        hold_outcome='started'
        echo "hdw4s: held the stream ${hold_ms} ms: the desktop signalled that it had started (shown after ${hold_shown} ms)${hold_note}" >&2 ;;
      bound)
        hold_outcome='bound'
        echo "hdw4s: held the stream ${hold_ms} ms: released ${hold_bound} s after the desktop was shown, with no signal that it had started (a start into the overview, a dialog, or a slow or already-black start)${hold_note}" >&2 ;;
      none)
        hold_outcome='none'
        echo "hdw4s: nothing to hold the stream for: ${stage_line#none }" >&2 ;;
      deadline)
        hold_outcome='deadline'
        if [ -n "${hold_shown}" ] && [ "${hold_deadline}" -lt "${hold_outer}" ]; then
          echo "hdw4s: the stage watcher gave no verdict within $(( hold_bound + 2 )) s of the desktop being shown; starting the stream anyway${hold_note}" >&2
        elif [ -n "${hold_shown}" ]; then
          echo "hdw4s: held the stream to the start deadline: the desktop was shown after ${hold_shown} ms, but the deadline (${hold_gate} s less ${hold_margin}) came before the bound${hold_note}" >&2
        else
          echo "hdw4s: held the stream to the start deadline: the desktop was not shown within ${hold_gate} s less ${hold_margin}${hold_note}" >&2
        fi ;;
      eof)
        echo "hdw4s: the stage watcher ended without a verdict ($([ -n "${hold_ever_shown}" ] && echo 'after' || echo 'before') the desktop was shown); starting the stream anyway${hold_note}" >&2 ;;
      clock)
        echo 'hdw4s: the clock (/proc/uptime) could not be read while holding the stream; starting it now' >&2 ;;
      *)
        echo "hdw4s: the stage watcher said something unexpected ($(quoted "${stage_line}")); starting the stream anyway" >&2 ;;
    esac
  else
    echo 'hdw4s: the stage watcher did not start; starting the stream without waiting' >&2
  fi
  # The watcher has usually exited by now and been reaped, and kill then
  # fails: under -e a bare kill here would end every start.
  kill "${stage_pid}" 2>/dev/null || :
  exec {stage_fd}<&-
elif [ "${HDW4S_STARTUP_HOLD}" != 'on' ]; then
  hold_outcome='off'
  echo 'hdw4s: startup hold disabled (HDW4S_STARTUP_HOLD=off)' >&2
fi
# THE OUTCOME, ONCE, IN ONE WORD, for the page that decides whether to fit the
# desktop to the tab. "started" means the hold was released by the desktop's
# own end-of-startup signal; every other word -- a bound, a deadline, a watcher
# that died, a hold that was off or skipped -- means nobody knows that startup
# is over. The owner's rule is "first, do no harm": a screen size change inside
# GNOME 46's startup can leave the desktop black for good (gnome-shell issue
# 9018, the defect this hold exists for), a wrong size cannot, so the page
# resizes on "started" and on nothing else.
#
# It is a line in this start's journal rather than a file this script writes,
# because the only place a page can read it is the web root, and this script
# runs as the occupant, who must never be able to write the tree its own page is
# served from. The unit's announced-gate reads this line as root and publishes
# the word -- see "hdw4s-webroot announced-gate". The occupant CAN print a line
# like this one too; all that buys is a resize of their own desktop.
echo "hdw4s: startup hold outcome: ${hold_outcome}" >&2
# A stop that arrived during the wait already killed the children; starting
# the stream now would put it on a dying unit, holding the port with nothing
# left to stop it.
if [ -n "${stopping}" ]; then
  echo 'hdw4s: stopped while waiting for the desktop; not starting the stream' >&2
  exit 0
fi
if ! kill -0 "${session_pid}" 2>/dev/null; then
  echo 'hdw4s: the GNOME session exited' >&2
  wait "${session_pid}" 2>/dev/null || :
  exit 1
fi

"${stream[@]}" \
  --unix-socket="${HDW4S_STREAM_SOCKET}" \
  "${auth}" \
  --enable-resize="${HDW4S_RESIZE}" \
  --encoder="${HDW4S_ENCODER}" \
  --framerate="${framerate}" \
  "${dpi[@]}" "${hidpi[@]}" "${lockdown[@]}" &
children+=($!)
stream_pid="$!"

# THE THIRD CHECK IS NOT HERE ANY MORE, and since 2026-09-26 it is not a request
# either. It is "ExecStartPost=!/usr/lib/hdw4s/hdw4s-webroot announced-gate" in
# the session units, and both changes were forced rather than chosen.
#
# WHAT IT DOES NOW: it reads the streaming server's own startup announcement out
# of this invocation's journal and compares the directory it names against the one
# this session was given. Selkies decides at startup whether to use the configured
# web root and, if it declines, logs one warning and serves the packaged client --
# after which the session comes up, notifies ready, and every health check in this
# product reports health while the gate is simply absent. Do not narrow it without
# narrowing the file check above it; withholding the web root without this ships a
# feature that is GREEN AND ABSENT.
#
# WHAT IT USED TO DO, and why that is gone: it fetched this session's own front
# door over HTTP and looked for the gate marker in the body. On an instance with
# basic auth that needs a credential, and in the position it ran from there is
# none -- in a unit with mount namespacing the first ExecStartPost= gets a
# namespace without the unit's credential directory. It asked anyway and reported
# the 401 as though the server were unreachable, which tore a healthy desktop down
# 55 times in an hour. The owner ruled that reading the server's own decision is
# fine, to be revisited if it stops being trustworthy.
#
# WHY IT STILL CANNOT RUN HERE, and the reason CHANGED with it. It was that a
# desktop may no longer open a connection to a session port on this machine, and
# the fetch had exactly the shape the firewall refuses. There is no connection
# now; what it needs instead is to read the unit's own journal, and this script
# runs as the occupant, who is in no group that may. Do not move it back.
#
# The sixty-second /dev/tcp wait that used to stand here went with it into
# hdw4s-webroot and became a wait for the announcement, for the same reason and
# with the same budget: the first version of the move dropped the wait, on the
# reasoning that ExecStartPost= runs after the readiness notification below and
# that notification is sent only once the port is bound. Measured false on the
# first run. NotifyAccess=all lets anything in this cgroup send READY=, and
# something does, so "started" is not the claim it reads as -- do not rebuild an
# ordering argument on it here.
#
# And what it CANNOT see is asserted above instead, next to the web root: an
# index.html that stats but will not open for this uid is announced as accepted.
# The fetch caught that; reading the announcement cannot.
#
# Failure is still fatal to the session, and now more simply: a failing
# ExecStartPost= stops the unit, where this code had to kill the streaming
# server from a background subshell and hope the main loop noticed.

# Report ready only once the stream is actually accepting connections, so that
# "systemctl start" blocks until the session can be reached and a dependent
# unit or a provisioning script has something real to wait on.
#
# LISTENING is asked of the kernel (ss), not of the filesystem: a socket file is
# not a listener, and the one this server will bind can exist before it listens.
#
# And the socket is then opened to the relay's group, which is the whole of who
# may connect: the unit's UMask=0077 creates it 0700, and the directory it is in
# (setgid, group hdw4s-relay, 2750) already decides who can reach it at all. Done
# here, by this account, which owns it -- and before READY, because the relay is
# ordered after this session and connects the moment it is told it may.
(
  for _ in $(seq 1 60); do
    if [ -n "$(ss -Hlx src "${HDW4S_STREAM_SOCKET}" 2>/dev/null)" ]; then
      if [ -L "${HDW4S_STREAM_SOCKET}" ] || [ ! -S "${HDW4S_STREAM_SOCKET}" ] ||
         ! chmod 0660 -- "${HDW4S_STREAM_SOCKET}"; then
        NOTIFY_SOCKET="${HDW4S_NOTIFY_SOCKET}" systemd-notify \
          --status="stream socket ${HDW4S_STREAM_SOCKET} is not a socket we can open"
        exit 1
      fi
      NOTIFY_SOCKET="${HDW4S_NOTIFY_SOCKET}" systemd-notify --ready \
        --status="display ${DISPLAY}, stream ${HDW4S_STREAM_SOCKET}, instance ${instance}"
      exit 0
    fi
    sleep 1
  done
  NOTIFY_SOCKET="${HDW4S_NOTIFY_SOCKET}" \
    systemd-notify --status="stream did not listen on ${HDW4S_STREAM_SOCKET}"
) &
children+=($!)

# A LOGOUT ENDS AN EPHEMERAL DESKTOP, AND THAT IS NOT A FAILURE. The GNOME
# session exits with status 0 when its occupant logs out, and this script used
# to answer every exit of it with status 1 -- so the unit was left "failed"
# after an ordinary logout and "hdw4s check" reported the machine unhealthy
# until somebody ran reset-failed (measured twice, 2026-09-27). An ephemeral
# desktop has Restart=no and is over when its occupant leaves, so a clean exit
# is a clean end. Anything else -- a non-zero status, a signal -- is still a
# failure, and still visible as one.
#
# A NAMED desktop keeps status 1 on purpose: its unit restarts on failure, and
# that restart is what gives its person a fresh desktop after logging out.
gnome_exited() {
  local rc=0
  wait "${session_pid}" 2>/dev/null || rc="$?"
  if [ "${rc}" -eq 0 ] && [ "${HDW4S_SESSION_TYPE:-}" = 'ephemeral' ]; then
    echo 'hdw4s: the GNOME session ended cleanly (a logout); this ephemeral desktop is over' >&2
    exit 0
  fi
  echo "hdw4s: the GNOME session exited (status ${rc})" >&2
  exit 1
}

# Wait on the stream, but notice if the desktop underneath it dies. Without
# this the unit stays "active" while serving a session that no longer has a
# GNOME in it, which is worse than failing.
while :; do
  if ! kill -0 "${session_pid}" 2>/dev/null; then
    gnome_exited
  fi
  if ! kill -0 "${stream_pid}" 2>/dev/null; then
    wait "${stream_pid}" && rc=0 || rc="$?"
    echo "hdw4s: the streaming server exited with status ${rc}" >&2
    exit "${rc}"
  fi
  sleep 2
done
