#!/bin/bash -e
export LC_ALL='C'
set -o nounset -o pipefail

# The inside of the private D-Bus session created by hdw4s-session. Everything
# here shares one bus, and that bus is what separates this desktop from any
# other one belonging to the same account.

instance="${1:?usage: hdw4s-run-session <instance>}"

: "${DISPLAY:?}" "${XDG_RUNTIME_DIR:?}" "${HDW4S_PORT:?}"
: "${HDW4S_ADDR:=0.0.0.0}"
: "${HDW4S_FRAMERATE:=30}"
: "${HDW4S_ENCODER:=x264enc}"

children=()
trap 'trap "" INT TERM QUIT HUP EXIT
      [ "${#children[@]}" -eq 0 ] || kill "${children[@]}" 2>/dev/null || :' \
     INT TERM QUIT HUP EXIT

# Only set a key if its schema is actually installed. A missing schema makes
# gsettings abort, and which extensions are present varies between installs.
set_if_present() {
  local schema="$1" key="$2" value="$3"
  gsettings writable "${schema}" "${key}" >/dev/null 2>&1 || return 0
  gsettings set "${schema}" "${key}" "${value}" 2>/dev/null || :
}

# Nobody can unlock a screen that has no keyboard attached to it, and a blanked
# screen would stop the stream updating with no way to wake it.
set_if_present org.gnome.desktop.screensaver  lock-enabled     false
set_if_present org.gnome.desktop.session      idle-delay       'uint32 0'
set_if_present org.gnome.settings-daemon.plugins.power \
                                              sleep-inactive-ac-type 'nothing'

gnome-session &
children+=($!)
session_pid="$!"

/opt/selkies/bin/selkies-gstreamer \
  --addr="${HDW4S_ADDR}" \
  --port="${HDW4S_PORT}" \
  --enable_basic_auth=false \
  --encoder="${HDW4S_ENCODER}" \
  --framerate="${HDW4S_FRAMERATE}" &
children+=($!)
stream_pid="$!"

# Report ready only once the stream is actually accepting connections, so that
# "systemctl start" blocks until the session can be reached and a dependent
# unit or a provisioning script has something real to wait on.
(
  for _ in $(seq 1 60); do
    if ss -Hltn "sport = :${HDW4S_PORT}" 2>/dev/null | grep -q .; then
      systemd-notify --ready \
        --status="display ${DISPLAY}, port ${HDW4S_PORT}, instance ${instance}"
      exit 0
    fi
    sleep 1
  done
  systemd-notify --status="stream did not bind port ${HDW4S_PORT}"
) &
children+=($!)

# Wait on the stream, but notice if the desktop underneath it dies. Without
# this the unit stays "active" while serving a session that no longer has a
# GNOME in it, which is worse than failing.
while :; do
  if ! kill -0 "${session_pid}" 2>/dev/null; then
    echo 'hdw4s: the GNOME session exited' >&2
    wait "${session_pid}" 2>/dev/null || :
    exit 1
  fi
  if ! kill -0 "${stream_pid}" 2>/dev/null; then
    wait "${stream_pid}" && rc=0 || rc="$?"
    echo "hdw4s: the streaming server exited with status ${rc}" >&2
    exit "${rc}"
  fi
  sleep 2
done
