#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o pipefail

# shellcheck disable=SC2154  # rc is assigned inside the trap itself
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

# Upstream moved from "selkies-gstreamer" to "selkies" and the old API path now
# answers with a 301, so always talk to the current name. The GitHub API is
# unauthenticated here and therefore rate limited; one call a day stays well
# inside the limit.
API='https://api.github.com/repos/selkies-project/selkies'
DL='https://github.com/selkies-project/selkies/releases/download'

# Where the release is unpacked. /opt/selkies is a virtualenv holding the
# Python package; /opt/gst-web is the browser client that goes with it.
PREFIX='/opt/selkies'
WEBROOT='/opt/gst-web'

# The last release whose asset layout this script understands. Upstream has
# published nothing since v1.6.2 (August 2024) while landing hundreds of commits
# on a rewrite that renames the wheel, drops the separate web bundle and renames
# the executable. When that lands, every assumption below stops holding, so the
# script refuses to install a release it does not recognise rather than
# half-upgrading a working machine. Raise this only together with the code that
# handles the new layout.
KNOWN_GOOD='1.6.2'

# Set SELKIES_VERSION in /etc/hdw4s/hdw4s.conf to pin a specific release and
# stop tracking upstream entirely.
# shellcheck source=/dev/null
if [ -r /etc/hdw4s/hdw4s.conf ]; then
  bash -n /etc/hdw4s/hdw4s.conf || {
    echo 'hdw4s: /etc/hdw4s/hdw4s.conf has a syntax error (above); refusing' >&2
    echo '  to run on a configuration that would be applied only as far as' >&2
    echo '  the error. Edit it by hand.' >&2
    exit 1
  }
  . /etc/hdw4s/hdw4s.conf || :
fi

[ "$(id -u)" -eq 0 ] || {
  echo 'This script must be run as "root"' >&2
  exit 1
}

# Everything is downloaded into a private directory that is removed on the way
# out. A systemd oneshot service has no working directory of its own, so a bare
# "curl -O" would otherwise litter the root filesystem.
workdir="$(mktemp -d -t hdw4s-update.XXXXXXXX)"
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      rm -rf "${workdir}"
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

current=''
# "pip show" exits non-zero when the package is not installed, which is the
# normal state after a run that created the environment and then failed. Under
# -e that turned a recoverable half-install into one the updater could never
# repair, reporting only that the script had failed unexpectedly.
if [ -x "${PREFIX}/bin/pip" ]; then
  current="$("${PREFIX}/bin/pip" show selkies-gstreamer 2>/dev/null |
             sed -n 's/^Version: //p')" || :
fi

if [ -n "${SELKIES_VERSION:-}" ]; then
  wanted="${SELKIES_VERSION}"
  echo "Selkies pinned to v${wanted} by /etc/hdw4s/hdw4s.conf."
else
  echo -n 'Checking for Selkies updates...'
  release="${workdir}/release.json"
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 -o "${release}" "${API}/releases/latest" || {
    echo ' failed.'
    echo 'Could not reach the GitHub release API; leaving the installation alone.' >&2
    exit 0
  }
  wanted="$(sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' "${release}" |
            head -n1)"
  echo ' done.'

  # jq prints the literal string "null" for a missing key, so an empty test on
  # its own would let a malformed response through and build a download URL for
  # version "null".
  case "${wanted}" in
    ''|null)
      echo 'Upstream returned no usable release tag; nothing to do.' >&2
      exit 0
      ;;
  esac

  # Refuse to follow upstream past the layout this script was written against.
  # Failing loudly here turns a future breaking release into a log entry rather
  # than a fleet of desktops that no longer start.
  if [ "${wanted}" != "${KNOWN_GOOD}" ]; then
    printf '%s\n' \
      "NOTICE: upstream release v${wanted} is newer than v${KNOWN_GOOD}, the last" \
      "  release whose layout this version of hdw4s understands. Staying on" \
      "  v${KNOWN_GOOD}. Upgrade hdw4s, or set SELKIES_VERSION=${wanted} in" \
      "  /etc/hdw4s/hdw4s.conf to install it anyway." >&2
    wanted="${KNOWN_GOOD}"
  fi
fi

wheel="selkies_gstreamer-${wanted}-py3-none-any.whl"
web="selkies-gstreamer-web_v${wanted}.tar.gz"

if [ "${current}" != "${wanted}" ]; then
  echo "Upgrading Selkies from v${current:-none} to v${wanted}..."

  # Fetch both artifacts before touching the installed copy. Upstream publishes
  # no checksums or signatures for release assets, so "the download completed
  # and is a plausible file" is the only integrity check available; do at least
  # that much before overwriting anything.
  echo -n '  Downloading...'
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 -o "${workdir}/${wheel}" "${DL}/v${wanted}/${wheel}"
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 -o "${workdir}/${web}"   "${DL}/v${wanted}/${web}"
  echo ' done.'

  echo -n '  Verifying...'
  python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).testzip()' \
    "${workdir}/${wheel}" >/dev/null 2>&1 || {
    echo ' failed.'
    echo "Downloaded wheel is not a valid archive; aborting." >&2
    exit 1
  }
  tar -tzf "${workdir}/${web}" >/dev/null 2>&1 || {
    echo ' failed.'
    echo "Downloaded web bundle is not a valid archive; aborting." >&2
    exit 1
  }
  echo ' done.'

  echo -n '  Backing up the current installation...'
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  [ ! -d "${PREFIX}" ]  || cp -a "${PREFIX}"  "${PREFIX}.bak"
  [ ! -d "${WEBROOT}" ] || cp -a "${WEBROOT}" "${WEBROOT}.bak"
  echo ' done.'

  echo -n '  Installing...'
  # --system-site-packages lets the venv see the apt-installed GStreamer and
  # PyGObject bindings, which are not on PyPI and cannot be installed into a
  # sealed virtualenv. It is also what lets python-xlib come from the distro.
  [ -x "${PREFIX}/bin/pip" ] ||
    python3 -m venv --system-site-packages "${PREFIX}"

  # The wheel asks for python-xlib from a GitHub *branch*, not a release:
  # "python-xlib@ .../selkies-project/python-xlib/archive/master.zip". Whatever
  # that branch says on the day this runs is what executes here, as root, and
  # pinning SELKIES_VERSION does not cover it. The fork exists for one
  # three-line change in Xlib/ext/randr.py -- making the BadRR* classes inherit
  # XError rather than Exception -- and Debian's python3-xlib already carries
  # exactly that change. So the dependency comes from the distro and the branch
  # is never fetched.
  #
  # Removed by path rather than with "pip uninstall": pip in a venv built with
  # --system-site-packages can see the distro package, and uninstalling that
  # would take files out from under dpkg.
  rm -rf "${PREFIX}"/lib/python*/site-packages/Xlib \
         "${PREFIX}"/lib/python*/site-packages/python_xlib-*.dist-info
  # --no-deps on pynput as well as on the wheel. pynput requires
  # python-xlib>=0.17, so without it pip installs the PyPI 0.33 release --
  # which does not have the randr fix -- into the venv, where it shadows the
  # distro copy and breaks resizing silently.
  "${PREFIX}/bin/pip" install --quiet --upgrade --no-deps \
    "${workdir}/${wheel}" pynput
  # Everything else the wheel asks for, plus pynput's own two. All ordinary
  # PyPI releases, which cannot change under a version once published.
  # evdev is not here: it ships no wheel and has to be compiled, which needs a
  # toolchain and kernel headers that a machine running a desktop has no other
  # reason to carry. The distro package provides it, and pynput is satisfied by
  # it the same way it is satisfied by the distro python-xlib. Everything left
  # is a pure-Python wheel.
  "${PREFIX}/bin/pip" install --quiet --upgrade \
    'websockets<14' basicauth gputil prometheus-client msgpack psutil \
    watchdog Pillow six

  # --no-deps means pip no longer notices when upstream adds a dependency, and
  # the failure would be an ImportError in a session rather than an error here.
  # Compare what the installed wheel asks for against what is handled above.
  unhandled="$("${PREFIX}/bin/python" - <<'DEPCHECK' 2>/dev/null || :
import glob, re, sys
handled = {'websockets','basicauth','gputil','prometheus-client','msgpack',
           'pynput','psutil','watchdog','pillow','python-xlib','evdev','six'}
out = []
for m in glob.glob('/opt/selkies/lib/python*/site-packages/'
                   'selkies_gstreamer-*.dist-info/METADATA'):
    for line in open(m, encoding='utf-8', errors='replace'):
        if not line.startswith('Requires-Dist:'):
            continue
        req = line.split(':', 1)[1].strip()
        if ';' in req:                      # environment marker
            req, marker = req.split(';', 1)
            if 'linux' not in marker and 'platform' in marker:
                continue
        name = re.split(r'[\s<>=!~\[@(]', req.strip(), 1)[0]
        if name and name.strip().lower() not in handled:
            out.append(name.strip())
print(' '.join(sorted(set(out))))
DEPCHECK
)"
  [ -z "${unhandled}" ] || {
    echo
    echo "hdw4s: Selkies v${wanted} asks for dependencies this updater does" >&2
    echo "  not install:${unhandled}" >&2
    echo '  They were not installed, because the dependency list is explicit' >&2
    echo '  here so that no dependency is fetched from a moving git branch.' >&2
    echo '  Add them to hdw4s-update, or sessions will fail on import.' >&2
  }

  # The tarball unpacks into a single top-level directory whose name has changed
  # between releases, so glob for whatever it turned out to be instead of
  # guessing. Extracting into a scratch directory first keeps a failed unpack
  # from leaving a half-populated web root behind.
  rm -rf "${workdir}/web" "${WEBROOT}.new"
  mkdir -p "${workdir}/web" "${WEBROOT}.new"
  tar -xzf "${workdir}/${web}" -C "${workdir}/web"
  # Assembled complete, beside the live one, and only then swapped in. The old
  # order removed the web root as soon as pip had succeeded, so a failure in
  # the unpack left it empty -- and permanently, because the version file had
  # already moved on and every later run reported the release as already
  # installed and skipped this block entirely.
  if [ "$(find "${workdir}/web" -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1 ] &&
     [ "$(find "${workdir}/web" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ]; then
    mv "${workdir}"/web/*/* "${WEBROOT}.new/"
  else
    mv "${workdir}"/web/* "${WEBROOT}.new/"
  fi
  rm -rf "${WEBROOT}"
  mv "${WEBROOT}.new" "${WEBROOT}"
  echo ' done.'
  upgraded='yes'
else
  echo "Selkies v${wanted} is already installed."
  upgraded=''
fi

# --- BRANDING PATCH ---------------------------------------------------------
# The stock client puts the upstream project name in the browser tab. Rewriting
# the shipped index.html is unavoidable because the page is a build artifact
# with no configuration hook, but keep the edit to a marked block that is
# removed and re-added every run, so it stays idempotent and leaves no trace
# once the file is replaced by an upgrade.
index="${WEBROOT}/index.html"
if [ -f "${index}" ]; then
  echo -n 'Applying branding patch...'
  sed -i '/<!-- HDW4S_PATCH_START -->/,/<!-- HDW4S_PATCH_END -->/d' "${index}"
  if grep -qi '</head>' "${index}"; then
    inject="$(cat <<'HTML_EOF'
<!-- HDW4S_PATCH_START -->
<script>
  (function() {
    // Where the reverse proxy gives each session its own hostname, the first
    // label is the only thing distinguishing one open tab from another.
    var host = window.location.hostname.split('.')[0] || 'desktop';
    var title = 'Desktop: ' + host.charAt(0).toUpperCase() + host.slice(1);

    function applyTitle() {
      var el = document.querySelector('title');
      if (!el) { el = document.createElement('title'); document.head.appendChild(el); }
      if (el.textContent !== title) el.textContent = title;
    }
    applyTitle();

    // Refuse the write rather than undo it. Watching for the change and
    // putting it back leaves the client's own title visible for the moment
    // between the two, which is a flash of someone else's branding on every
    // reload. Overriding the property means the write never lands.
    try {
      Object.defineProperty(document, 'title', {
        configurable: true,
        get: function() { return title; },
        set: function() { applyTitle(); }
      });
    } catch (e) { /* fall through to the observer below */ }

    // Kept as a fallback for the case where the property cannot be redefined,
    // and for anything that edits the title element directly.
    new MutationObserver(applyTitle)
      .observe(document.head, { childList: true, subtree: true, characterData: true });

    // Make the desktop fill the window on the first connection.
    //
    // The client only asks the server to resize from a browser "resize" event,
    // and nothing fires one when a tab is first opened. So the desktop keeps
    // whatever size the X server started at and the client letterboxes it --
    // the black bars above and below.
    //
    // Forcing the stored "resize" setting to true, which is the obvious fix,
    // makes it worse: the client assigns that value to a property already
    // initialised to true, and the watcher that would send the request is
    // guarded on the value having changed. Setting it to what it already is
    // guarantees the request is never sent. That is why toggling the setting
    // by hand fixes it -- toggling is the only thing that produces a change.
    //
    // So do not touch the setting. Call the client's own end-of-resize
    // handler once, as soon as the stream is actually running, which is
    // exactly what dragging the window edge would do.

    // Bounds on what may be asked for. The server accepts any WxH matching a
    // digits-x-digits pattern and only rounds it up to an even number, so
    // nothing else stops a window a few pixels tall, or one shaped like a
    // hair, from becoming the desktop. A desktop that cannot be clamped into
    // the window is not a disaster: the client already letterboxes or scrolls,
    // which is the right outcome for a request that made no sense.
    var MIN_W = 640, MIN_H = 480;      // below this GNOME is unusable
    var MAX_W = 7680, MAX_H = 4320;    // matches the X server's VideoRam ceiling
    var MAX_PIXELS = MAX_W * MAX_H;
    var MAX_ASPECT = 6;                // 32:9 ultrawide is 3.6; portrait is 0.6

    function clampResolution(w, h) {
      if (!(w > 0) || !(h > 0)) return null;
      // Shape first. An absurd ratio is not something to scale down, it is
      // something to refuse, so pull the long side in to the widest ratio a
      // real monitor has.
      if (w / h > MAX_ASPECT) w = Math.round(h * MAX_ASPECT);
      if (h / w > MAX_ASPECT) h = Math.round(w * MAX_ASPECT);
      // Then each side.
      w = Math.min(Math.max(w, MIN_W), MAX_W);
      h = Math.min(Math.max(h, MIN_H), MAX_H);
      // Then the total, keeping the shape. Each side can be in range while
      // the area is not.
      if (w * h > MAX_PIXELS) {
        var k = Math.sqrt(MAX_PIXELS / (w * h));
        w = Math.max(MIN_W, Math.round(w * k));
        h = Math.max(MIN_H, Math.round(h * k));
      }
      // The encoder needs even dimensions. Round down, because the server
      // rounds up and that could push a clamped value back over a bound.
      return [w - (w % 2), h - (h % 2)];
    }

    var clamped = false, asked = false, tries = 0;

    function askForResize() {
      if (asked) return;
      // Respect someone who has deliberately turned remote resizing off.
      if (typeof app !== 'undefined' && app.resizeRemote === false) return;
      if (!webrtc.input || typeof webrtc.input.onresizeend !== 'function') return;
      asked = true;
      try { webrtc.input.onresizeend(); } catch (e) { asked = false; }
    }

    // Poll often enough to be in place before the connection completes. The
    // handler below is chained onto an event, and an event that has already
    // fired cannot be chained onto -- which is the whole reason the desktop
    // sometimes came up letterboxed on a first connection and was fine after a
    // reload. So the request is triggered by whichever of the two happens
    // first, and asked-once guards against sending it twice.
    var timer = setInterval(function() {
      if (++tries > 600) { clearInterval(timer); return; }
      try {
        if (typeof webrtc === 'undefined' || !webrtc.input) return;

        // Every resize request leaves through this one function, whether it
        // came from here or from the user dragging the window, so it is the
        // only place the bounds have to be applied.
        if (!clamped && typeof webrtc.sendDataChannelMessage === 'function') {
          var send = webrtc.sendDataChannelMessage.bind(webrtc);
          webrtc.sendDataChannelMessage = function(msg) {
            var m = (typeof msg === 'string') && msg.match(/^r,(\d+)x(\d+)$/);
            if (!m) return send(msg);
            var c = clampResolution(parseInt(m[1], 10), parseInt(m[2], 10));
            if (!c) return;
            var out = 'r,' + c[0] + 'x' + c[1];
            if (out !== msg) {
              console.log('hdw4s: clamped requested desktop size ' +
                          m[1] + 'x' + m[2] + ' to ' + c[0] + 'x' + c[1]);
            }
            return send(out);
          };
          clamped = true;

          // Path one: the channel has not opened yet, so chain onto the event.
          var prev = webrtc.ondatachannelopen;
          webrtc.ondatachannelopen = function() {
            if (typeof prev === 'function') {
              try { prev.apply(this, arguments); } catch (e) {}
            }
            setTimeout(askForResize, 250);
          };
        }

        // Path two: it opened already, and the event is gone. Frames arriving
        // means the channel is up, whether or not we saw it happen.
        if (webrtc.element && webrtc.element.videoWidth) {
          askForResize();
          clearInterval(timer);
          setTimeout(verifyFits, 3000);

          // A hidden tab has no useful size to report, and browsers throttle
          // its timers besides, so a desktop opened in a background tab is
          // sized for whatever the window happened to be. Check again when
          // someone actually looks at it.
          document.addEventListener('visibilitychange', function() {
            if (!document.hidden) setTimeout(verifyFits, 500);
          });
        }
      } catch (e) { /* not ready yet; the next tick will try again */ }
    }, 100);

    // Last line of defence. If the desktop still does not match the window a
    // few seconds in -- a request lost, a race nobody anticipated -- ask once
    // more rather than leaving the user to reload the tab. Compares against
    // the video's own intrinsic size, which is the resolution the server
    // actually settled on.
    function verifyFits() {
      try {
        if (typeof app !== 'undefined' && app.resizeRemote === false) return;
        var v = webrtc.element;
        if (!v || !v.videoWidth) return;
        var want = webrtc.input.getWindowResolution();
        var w = clampResolution(parseInt(want[0], 10), parseInt(want[1], 10));
        if (!w) return;
        if (Math.abs(v.videoWidth - w[0]) > 2 || Math.abs(v.videoHeight - w[1]) > 2) {
          console.log('hdw4s: desktop is ' + v.videoWidth + 'x' + v.videoHeight +
                      ' but the window wants ' + w[0] + 'x' + w[1] + '; asking again');
          asked = false;
          askForResize();
        }
      } catch (e) {}
    }
  })();
</script>
<!-- HDW4S_PATCH_END -->
HTML_EOF
)"
    export inject
    awk 'BEGIN { done = 0 }
         !done && tolower($0) ~ /<\/head>/ { print ENVIRON["inject"]; done = 1 }
         { print }' "${index}" > "${index}.tmp"
    mv "${index}.tmp" "${index}"
    echo ' done.'
  else
    echo ' skipped (no </head> found).'
  fi
fi

# Import what a session imports, and build the two elements whose absence is
# invisible until a browser connects. This runs on every upgrade, whatever the
# sessions are doing: it needs no display and no session, and the alternative
# is what used to happen -- a machine where every desktop was in use discarded
# its rollback backups and reported success without executing any of the new
# code.
smoke_test() {
  "${PREFIX}/bin/python" - <<'SMOKE' 2>&1
import importlib, importlib.util
import gi
for ns in ("Gst", "GstWebRTC", "GstSdp", "GstRtp"):
    gi.require_version(ns, "1.0")
from gi.repository import Gst
Gst.init(None)

# webrtcbin comes from plugins-bad and the ICE agent from gstreamer1.0-nice.
# A missing plugin is invisible until the element is actually made.
for el in ("webrtcbin", "nicesrc"):
    assert Gst.ElementFactory.make(el, None) is not None, "missing element: " + el

# The distro python-xlib carries the fix the upstream fork exists for. A copy
# without it landing in the venv shadows this one and breaks resizing.
import Xlib
from Xlib.error import XError
from Xlib.ext.randr import BadRROutputError
assert issubclass(BadRROutputError, XError), \
    "python-xlib lacks the randr fix: %s" % Xlib.__file__

# Importing the package proves almost nothing -- its __init__ pulls in only the
# standard library, so it succeeds against an installation whose dependencies
# were never installed at all. These are the modules that actually reach
# websockets, msgpack, basicauth, GPUtil, prometheus_client, psutil, watchdog
# and Pillow, and they are the ones a session loads.
for m in ("signalling_web", "webrtc_signalling", "gpu_monitor", "metrics",
          "system_monitor", "gstwebrtc_app", "resize", "gamepad"):
    importlib.import_module("selkies_gstreamer." + m)

# webrtc_input and __main__ are deliberately not imported: pynput picks its
# backend at import time and needs an X connection, which there is no reason
# to have here. Checking that they can be found proves they are installed
# without running them.
for m in ("pynput", "evdev"):
    assert importlib.util.find_spec(m) is not None, "not installed: " + m
SMOKE
}

restore_backup() {
  [ ! -d "${PREFIX}.bak" ]  || { rm -rf "${PREFIX}";  mv "${PREFIX}.bak"  "${PREFIX}"; }
  [ ! -d "${WEBROOT}.bak" ] || { rm -rf "${WEBROOT}"; mv "${WEBROOT}.bak" "${WEBROOT}"; }
}

# --- VERIFY AND ROLL BACK ---------------------------------------------------
[ -n "${upgraded}" ] || exit 0

echo -n '  Checking that the new installation loads...'
if out="$(smoke_test)"; then
  echo ' done.'
else
  echo ' failed.'
  echo 'CRITICAL: the new installation cannot be loaded.' >&2
  printf '%s\n' "${out}" | tail -5 >&2
  if [ -d "${PREFIX}.bak" ] || [ -d "${WEBROOT}.bak" ]; then
    echo '  Rolling back...' >&2
    restore_backup
    echo "  Rolled back to v${current:-none}." >&2
  else
    echo '  No previous installation to restore.' >&2
  fi
  exit 1
fi

# No --all. Instances stay loaded but inactive because the proxy unit requires
# them, and restarting those started a full desktop for somebody who had not
# asked for one -- undoing both socket activation and the reaper on every
# upgrade.
mapfile -t units < <(systemctl list-units --plain --no-legend --state=active 'hdw4s@*' |
                     awk '{print $1}')
# Sessions are socket-activated and are not started at boot, so this list is
# normally empty and this is the branch nearly every upgrade takes. It used to
# discard both backups and exit 0 without having executed a single byte of the
# new installation -- the verification and rollback below were dead code in the
# ordinary case. Import what the streaming server imports first: that is what a
# missing GStreamer typelib or a broken dependency actually breaks, and it
# breaks it in a way nothing else here would notice until a user saw a desktop
# that never appeared.
[ "${#units[@]}" -gt 0 ] || {
  echo 'Upgrade complete; no sessions were running.'
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  exit 0
}

# Restart only sessions nobody is using. A daily timer that reboots a desktop
# somebody is working in -- unsaved editors, a half-written mail -- turns an
# auto-updater from an asset into the reason it gets switched off. Sessions in
# use keep the old code until they next stop on their own, which is exactly
# when picking up the new version costs nothing.
idle=()
busy=()
for unit in "${units[@]}"; do
  inst="${unit#hdw4s@}"; inst="${inst%.service}"
  port="$(sed -n 's/^[[:space:]]*HDW4S_PORT=\([0-9]\{1,\}\).*/\1/p' \
          "/etc/hdw4s/${inst}.conf" 2>/dev/null | tail -n1)"
  if [ -z "${port}" ]; then
    idx="$(awk -v i="${inst}" '$1 !~ /^#/ && $2 == i { print $1; exit }' \
           /etc/hdw4s/instances 2>/dev/null)"
    # Digits only before it reaches an arithmetic context. The slot table is
    # root-owned, so this is not a way in today, but $(( )) evaluates what it
    # is given -- a stray word there is a command substitution, not a syntax
    # error -- and a file parsed by three scripts should not rely on all of
    # them being careful.
    case "${idx}" in *[!0-9]*) idx='';; esac
    # The internal port, as the reaper uses: a session on a filesystem socket
    # has no connections on the external one and would look idle when busy.
    [ -z "${idx}" ] ||
      port=$(( ${HDW4S_BASE_PORT:-7300} + ${HDW4S_BLOCK_SIZE:-64} + idx ))
  fi
  if [ -n "${port}" ] &&
     ss -Htn state established "sport = :${port}" 2>/dev/null | grep -q .; then
    busy+=("${unit}")
  else
    idle+=("${unit}")
  fi
done

[ "${#busy[@]}" -eq 0 ] || {
  echo "Leaving ${#busy[@]} session(s) in use on v${current:-none}:"
  printf '  %s\n' "${busy[@]}"
  echo '  They will pick up the new version when they next restart.'
}

[ "${#idle[@]}" -gt 0 ] || {
  echo 'Every session is in use; nothing to restart.'
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  exit 0
}

units=("${idle[@]}")
echo -n "Restarting ${#units[@]} idle session(s)..."
systemctl restart "${units[@]}" || :

# A unit that crashes on the new version is put into auto-restart by
# Restart=on-failure, and spends most of its time in "activating" rather than
# "failed". Polling is-active for a fixed window and then asking whether the
# unit restarted at all catches that; a single sleep followed by a check for
# "failed" almost never does.
sleep 15
healthy='yes'
for unit in "${units[@]}"; do
  state="$(systemctl show -p ActiveState --value "${unit}")"
  restarts="$(systemctl show -p NRestarts --value "${unit}")"
  if [ "${state}" != 'active' ] || [ "${restarts:-0}" -ne 0 ]; then
    echo " ${unit} is ${state} after ${restarts:-0} restart(s)."
    healthy=''
  fi
done

if [ -n "${healthy}" ]; then
  echo ' done.'
  echo "Upgrade to v${wanted} successful."
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  exit 0
fi

echo 'CRITICAL: sessions did not come back up. Rolling back...' >&2
if [ -d "${PREFIX}.bak" ] || [ -d "${WEBROOT}.bak" ]; then
  # Each side guarded by its own backup. Removing both and restoring one left
  # the half with no backup deleted and unrecoverable, while the script
  # reported that it had rolled back.
  restore_backup
  systemctl restart "${units[@]}" || :
  echo "Rolled back to v${current:-none}." >&2
else
  # Nothing to roll back to means this was a first install. Leave the new files
  # in place; removing them would only guarantee the next run starts over.
  echo 'No previous installation to restore.' >&2
fi
exit 1
