#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o pipefail

# shellcheck disable=SC2154  # rc is assigned inside the trap itself
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

# Upstream moved from "selkies-gstreamer" to "selkies" and the old API path now
# answers with a 301, so always talk to the current name. The GitHub API is
# unauthenticated here and therefore rate limited; one call a day stays well
# inside the limit.
API='https://api.github.com/repos/selkies-project/selkies'
DL='https://github.com/selkies-project/selkies/releases/download'

# Where the release is unpacked. /opt/selkies is a virtualenv holding the
# Python package; /opt/gst-web is the browser client that goes with it.
PREFIX='/opt/selkies'
WEBROOT='/opt/gst-web'

# The last release whose asset layout this script understands. Upstream has
# published nothing since v1.6.2 (August 2024) while landing hundreds of commits
# on a rewrite that renames the wheel, drops the separate web bundle and renames
# the executable. When that lands, every assumption below stops holding, so the
# script refuses to install a release it does not recognise rather than
# half-upgrading a working machine. Raise this only together with the code that
# handles the new layout.
KNOWN_GOOD='1.6.2'

# Set SELKIES_VERSION in /etc/hdw4s/hdw4s.conf to pin a specific release and
# stop tracking upstream entirely.
# shellcheck source=/dev/null
[ ! -r /etc/hdw4s/hdw4s.conf ] || . /etc/hdw4s/hdw4s.conf

[ "$(id -u)" -eq 0 ] || {
  echo 'This script must be run as "root"' >&2
  exit 1
}

# Everything is downloaded into a private directory that is removed on the way
# out. A systemd oneshot service has no working directory of its own, so a bare
# "curl -O" would otherwise litter the root filesystem.
workdir="$(mktemp -d -t hdw4s-update.XXXXXXXX)"
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      rm -rf "${workdir}"
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

current=''
[ ! -x "${PREFIX}/bin/pip" ] ||
  current="$("${PREFIX}/bin/pip" show selkies-gstreamer 2>/dev/null |
             sed -n 's/^Version: //p')"

if [ -n "${SELKIES_VERSION:-}" ]; then
  wanted="${SELKIES_VERSION}"
  echo "Selkies pinned to v${wanted} by /etc/hdw4s/hdw4s.conf."
else
  echo -n 'Checking for Selkies updates...'
  release="${workdir}/release.json"
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 -o "${release}" "${API}/releases/latest" || {
    echo ' failed.'
    echo 'Could not reach the GitHub release API; leaving the installation alone.' >&2
    exit 0
  }
  wanted="$(sed -n 's/.*"tag_name": *"v\{0,1\}\([^"]*\)".*/\1/p' "${release}" |
            head -n1)"
  echo ' done.'

  # jq prints the literal string "null" for a missing key, so an empty test on
  # its own would let a malformed response through and build a download URL for
  # version "null".
  case "${wanted}" in
    ''|null)
      echo 'Upstream returned no usable release tag; nothing to do.' >&2
      exit 0
      ;;
  esac

  # Refuse to follow upstream past the layout this script was written against.
  # Failing loudly here turns a future breaking release into a log entry rather
  # than a fleet of desktops that no longer start.
  if [ "${wanted}" != "${KNOWN_GOOD}" ]; then
    printf '%s\n' \
      "NOTICE: upstream release v${wanted} is newer than v${KNOWN_GOOD}, the last" \
      "  release whose layout this version of hdw4s understands. Staying on" \
      "  v${KNOWN_GOOD}. Upgrade hdw4s, or set SELKIES_VERSION=${wanted} in" \
      "  /etc/hdw4s/hdw4s.conf to install it anyway." >&2
    wanted="${KNOWN_GOOD}"
  fi
fi

wheel="selkies_gstreamer-${wanted}-py3-none-any.whl"
web="selkies-gstreamer-web_v${wanted}.tar.gz"

if [ "${current}" != "${wanted}" ]; then
  echo "Upgrading Selkies from v${current:-none} to v${wanted}..."

  # Fetch both artifacts before touching the installed copy. Upstream publishes
  # no checksums or signatures for release assets, so "the download completed
  # and is a plausible file" is the only integrity check available; do at least
  # that much before overwriting anything.
  echo -n '  Downloading...'
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 -o "${workdir}/${wheel}" "${DL}/v${wanted}/${wheel}"
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 -o "${workdir}/${web}"   "${DL}/v${wanted}/${web}"
  echo ' done.'

  echo -n '  Verifying...'
  python3 -c 'import sys, zipfile; zipfile.ZipFile(sys.argv[1]).testzip()' \
    "${workdir}/${wheel}" >/dev/null 2>&1 || {
    echo ' failed.'
    echo "Downloaded wheel is not a valid archive; aborting." >&2
    exit 1
  }
  tar -tzf "${workdir}/${web}" >/dev/null 2>&1 || {
    echo ' failed.'
    echo "Downloaded web bundle is not a valid archive; aborting." >&2
    exit 1
  }
  echo ' done.'

  echo -n '  Backing up the current installation...'
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  [ ! -d "${PREFIX}" ]  || cp -a "${PREFIX}"  "${PREFIX}.bak"
  [ ! -d "${WEBROOT}" ] || cp -a "${WEBROOT}" "${WEBROOT}.bak"
  echo ' done.'

  echo -n '  Installing...'
  # --system-site-packages lets the venv see the apt-installed GStreamer and
  # PyGObject bindings, which are not on PyPI and cannot be installed into a
  # sealed virtualenv.
  [ -x "${PREFIX}/bin/pip" ] ||
    python3 -m venv --system-site-packages "${PREFIX}"
  "${PREFIX}/bin/pip" install --quiet --upgrade \
    "${workdir}/${wheel}" psutil

  # The tarball unpacks into a single top-level directory whose name has changed
  # between releases, so glob for whatever it turned out to be instead of
  # guessing. Extracting into a scratch directory first keeps a failed unpack
  # from leaving a half-populated web root behind.
  rm -rf "${workdir}/web"
  mkdir -p "${workdir}/web"
  tar -xzf "${workdir}/${web}" -C "${workdir}/web"
  rm -rf "${WEBROOT}"
  mkdir -p "${WEBROOT}"
  if [ "$(find "${workdir}/web" -mindepth 1 -maxdepth 1 -type d | wc -l)" -eq 1 ] &&
     [ "$(find "${workdir}/web" -mindepth 1 -maxdepth 1 | wc -l)" -eq 1 ]; then
    mv "${workdir}"/web/*/* "${WEBROOT}/"
  else
    mv "${workdir}"/web/* "${WEBROOT}/"
  fi
  echo ' done.'
  upgraded='yes'
else
  echo "Selkies v${wanted} is already installed."
  upgraded=''
fi

# --- BRANDING PATCH ---------------------------------------------------------
# The stock client puts the upstream project name in the browser tab. Rewriting
# the shipped index.html is unavoidable because the page is a build artifact
# with no configuration hook, but keep the edit to a marked block that is
# removed and re-added every run, so it stays idempotent and leaves no trace
# once the file is replaced by an upgrade.
index="${WEBROOT}/index.html"
if [ -f "${index}" ]; then
  echo -n 'Applying branding patch...'
  sed -i '/<!-- HDW4S_PATCH_START -->/,/<!-- HDW4S_PATCH_END -->/d' "${index}"
  if grep -qi '</head>' "${index}"; then
    inject="$(cat <<'HTML_EOF'
<!-- HDW4S_PATCH_START -->
<script>
  (function() {
    // Where the reverse proxy gives each session its own hostname, the first
    // label is the only thing distinguishing one open tab from another.
    var host = window.location.hostname.split('.')[0] || 'desktop';
    var title = 'Desktop: ' + host.charAt(0).toUpperCase() + host.slice(1);
    document.title = title;
    // The client rewrites document.title once it connects, so put it back.
    new MutationObserver(function() {
      if (document.title !== title) document.title = title;
    }).observe(document.head, { childList: true, subtree: true });

    // Make the desktop follow the browser window by default. The client reads
    // this from localStorage under a key prefixed with a name derived from the
    // URL path, so the prefix is not known here; match the suffix instead.
    // Only this one setting is touched. "scaleLocal", the other half of the
    // pair, already defaults to the inverse of it and needs no help.
    var get = Storage.prototype.getItem;
    Storage.prototype.getItem = function(key) {
      if (typeof key === 'string' &&
          (key === 'resize' || key.endsWith('_resize'))) {
        return 'true';
      }
      return get.call(this, key);
    };
  })();
</script>
<!-- HDW4S_PATCH_END -->
HTML_EOF
)"
    export inject
    awk 'BEGIN { done = 0 }
         !done && tolower($0) ~ /<\/head>/ { print ENVIRON["inject"]; done = 1 }
         { print }' "${index}" > "${index}.tmp"
    mv "${index}.tmp" "${index}"
    echo ' done.'
  else
    echo ' skipped (no </head> found).'
  fi
fi

# --- VERIFY AND ROLL BACK ---------------------------------------------------
[ -n "${upgraded}" ] || exit 0

mapfile -t units < <(systemctl list-units --plain --no-legend --all 'hdw4s@*' |
                     awk '{print $1}')
[ "${#units[@]}" -gt 0 ] || {
  echo 'Upgrade complete; no sessions were running.'
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  exit 0
}

# Restart only sessions nobody is using. A daily timer that reboots a desktop
# somebody is working in -- unsaved editors, a half-written mail -- turns an
# auto-updater from an asset into the reason it gets switched off. Sessions in
# use keep the old code until they next stop on their own, which is exactly
# when picking up the new version costs nothing.
idle=()
busy=()
for unit in "${units[@]}"; do
  inst="${unit#hdw4s@}"; inst="${inst%.service}"
  port="$(sed -n 's/^[[:space:]]*HDW4S_PORT=\([0-9]\{1,\}\).*/\1/p' \
          "/etc/hdw4s/${inst}.conf" 2>/dev/null | tail -n1)"
  if [ -z "${port}" ]; then
    idx="$(awk -v i="${inst}" '$1 !~ /^#/ && $2 == i { print $1; exit }' \
           /etc/hdw4s/instances 2>/dev/null)"
    [ -z "${idx}" ] || port=$(( ${HDW4S_BASE_PORT:-7300} + idx ))
  fi
  if [ -n "${port}" ] &&
     ss -Htn state established "sport = :${port}" 2>/dev/null | grep -q .; then
    busy+=("${unit}")
  else
    idle+=("${unit}")
  fi
done

[ "${#busy[@]}" -eq 0 ] || {
  echo "Leaving ${#busy[@]} session(s) in use on v${current:-none}:"
  printf '  %s\n' "${busy[@]}"
  echo '  They will pick up the new version when they next restart.'
}

[ "${#idle[@]}" -gt 0 ] || {
  echo 'Every session is in use; nothing to restart.'
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  exit 0
}

units=("${idle[@]}")
echo -n "Restarting ${#units[@]} idle session(s)..."
systemctl restart "${units[@]}" || :

# A unit that crashes on the new version is put into auto-restart by
# Restart=on-failure, and spends most of its time in "activating" rather than
# "failed". Polling is-active for a fixed window and then asking whether the
# unit restarted at all catches that; a single sleep followed by a check for
# "failed" almost never does.
sleep 15
healthy='yes'
for unit in "${units[@]}"; do
  state="$(systemctl show -p ActiveState --value "${unit}")"
  restarts="$(systemctl show -p NRestarts --value "${unit}")"
  if [ "${state}" != 'active' ] || [ "${restarts:-0}" -ne 0 ]; then
    echo " ${unit} is ${state} after ${restarts:-0} restart(s)."
    healthy=''
  fi
done

if [ -n "${healthy}" ]; then
  echo ' done.'
  echo "Upgrade to v${wanted} successful."
  rm -rf "${PREFIX}.bak" "${WEBROOT}.bak"
  exit 0
fi

echo 'CRITICAL: sessions did not come back up. Rolling back...' >&2
if [ -d "${PREFIX}.bak" ] || [ -d "${WEBROOT}.bak" ]; then
  rm -rf "${PREFIX}" "${WEBROOT}"
  [ ! -d "${PREFIX}.bak" ]  || mv "${PREFIX}.bak"  "${PREFIX}"
  [ ! -d "${WEBROOT}.bak" ] || mv "${WEBROOT}.bak" "${WEBROOT}"
  systemctl restart "${units[@]}" || :
  echo "Rolled back to v${current:-none}." >&2
else
  # Nothing to roll back to means this was a first install. Leave the new files
  # in place; removing them would only guarantee the next run starts over.
  echo 'No previous installation to restore.' >&2
fi
exit 1
