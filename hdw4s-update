#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o pipefail

# shellcheck disable=SC2154  # rc is assigned inside the trap itself
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || [ -n "${refused:-}" ] ||
        echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

# Upstream moved from "selkies-gstreamer" to "selkies" and the old API path now
# answers with a 301, so always talk to the current name. The GitHub API is
# unauthenticated here and therefore rate limited; one call a day stays well
# inside the limit.
API='https://api.github.com/repos/selkies-project/selkies'

# Selkies 2.0 is a distribution package. Until 1.6.2 it was a wheel this script
# installed into a virtualenv it built here, and everything about the old
# updater followed from that: it created the venv, worked around a dependency
# that came from a moving git branch, unpacked a separate browser client into
# /opt/gst-web, patched that client on disk, and rolled back by renaming
# directories. None of that survives. Upstream now ships a .deb that owns
# /opt/selkies outright, with no maintainer scripts, so dpkg's only record of
# it is its file list -- which is exactly why nothing here may move, copy or
# delete anything under that prefix. Every change to it goes through dpkg.
PREFIX='/opt/selkies'
PKG='selkies'

# The previous .deb, kept so a failed upgrade has something to go back to.
# Renaming the prefix aside is no longer available: dpkg would still believe
# its files were in place, and the next upgrade would act on that belief. The
# bytes have to be on disk before the new ones are unpacked, because a release
# asset can be withdrawn, and GitHub is not a rollback plan.
CACHE='/var/lib/hdw4s/selkies'

# Two updaters, or an updater and a hand-run apt, must not interleave. dpkg has
# its own lock and will refuse the second caller, but by then this script has
# already downloaded, decided and possibly removed the pre-2.0 tree; the useful
# place to stop is before any of that.
LOCKFILE='/run/lock/hdw4s-update.lock'

# Where a 1.6-era installation is moved before dpkg is allowed near the prefix.
# Installing the .deb straight over the old virtualenv is not a clean upgrade
# and not a clean failure either: it deletes nothing, so the venv's own files
# stay behind unowned, but it overwrites pyvenv.cfg and flips
# include-system-site-packages to false, which breaks the old installation
# without removing a file. Removing the package afterwards then deletes the
# interpreter symlinks dpkg has since taken ownership of, so what is left is
# neither version. Moving it aside first is the only order in which both
# outcomes are recoverable.
LEGACY="${PREFIX}.pre-2.0"

# The last release whose packaging this script understands, as upstream's own
# version string -- what "selkies --version" prints. Raise it only together
# with the code, and record the hash below in the same commit.
KNOWN_GOOD='2.0.0rc0'

# What the release asset must hash to, and which asset that is.
#
# One hash, for one platform: the package is built per distribution and per
# architecture, and the maintainer can only have seen the bytes of the one that
# was actually tested. On any other platform the recorded hash does not apply
# and the digest GitHub publishes for the asset is used instead -- for this
# release GitHub publishes one for every asset. If neither is available the
# download is refused rather than installed with nothing checked, because an
# integrity check that quietly does not run is worse than none.
#
# Be clear about what this is worth: it pins the bytes to what the maintainer
# saw, so an asset replaced under an existing tag is caught. It is not a
# signature and it does not establish that upstream's release was honest when
# it was made.
KNOWN_GOOD_ASSET='selkies_2.0.0.rc0-1.ubuntu24.04_amd64.deb'
KNOWN_GOOD_SHA256_DEB='5d4ce06caa9ba251747384207da4450f33e4c2fd2b214846dba8cb946fadeaca'

# Set SELKIES_VERSION in /etc/hdw4s/hdw4s.conf to pin a specific release and
# stop tracking upstream entirely.
# shellcheck source=/dev/null
if [ -r /etc/hdw4s/hdw4s.conf ]; then
  bash -n /etc/hdw4s/hdw4s.conf || {
    echo 'hdw4s: /etc/hdw4s/hdw4s.conf has a syntax error (above); refusing' >&2
    echo '  to run on a configuration that would be applied only as far as' >&2
    echo '  the error. Edit it by hand.' >&2
    die
  }
  . /etc/hdw4s/hdw4s.conf || :
fi

# Every non-zero exit below is a decision: a configuration that cannot be
# satisfied, a hash that did not match, a package state this must not build on.
# The trap above exists for the other kind -- a command that failed where
# nothing anticipated it -- and "Script ... failed unexpectedly" printed after a
# message that carefully explained the problem sends the reader looking for a
# second fault that is not there. Worse, a refusal that reaches the trap looks
# identical in the journal to a crash, and the two want different responses.
#
# The status stays 1. A pin that can never be satisfied, or a dpkg state nobody
# has repaired, is a condition that will not fix itself overnight, and a timer
# that quietly exits 0 on it is how a machine stops updating without anyone
# noticing. The unit is meant to show as failed; it is meant to say why.
refused=''
die() { refused='yes'; exit 1; }

[ "$(id -u)" -eq 0 ] || {
  echo 'This script must be run as "root"' >&2
  die
}

# Held for the whole run, including the download. Non-blocking: the timer fires
# daily and a second run has nothing to add to the one already in progress.
exec 9>"${LOCKFILE}"
flock -n 9 || {
  echo 'hdw4s: another hdw4s-update is already running; leaving it to finish.'
  exit 0
}

# Everything is downloaded into a private directory that is removed on the way
# out. A systemd oneshot service has no working directory of its own, so a bare
# "curl -O" would otherwise litter the root filesystem.
workdir="$(mktemp -d -t hdw4s-update.XXXXXXXX)"
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      rm -rf "${workdir}"
      [ "${rc}" -eq 0 ] || [ -n "${refused:-}" ] ||
        echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

# --- VERSION STRINGS --------------------------------------------------------
# The same release is named four different ways and no two of them are equal:
#
#   git tag            v2.0.0rc0
#   package version    2.0.0~rc0-1~ubuntu24.04
#   asset filename     selkies_2.0.0.rc0-1.ubuntu24.04_amd64.deb
#   selkies --version  2.0.0rc0
#
# Compare the tag with the package version as they stand and the updater either
# reinstalls every night -- because they never match -- or, with a comparison
# loose enough to stop that, never installs anything again. So everything is
# reduced to the one form upstream itself prints, and the asset filename is
# never constructed at all: it is picked out of the release GitHub published,
# by platform and architecture, which is the only place that spelling is
# authoritative.

# The upstream version behind a Debian package version: drop the Debian
# revision, which is everything after the last hyphen when what follows starts
# with a digit, then drop the tildes that make a release candidate sort before
# its final. "2.0.0~rc0-1~ubuntu24.04" -> "2.0.0rc0".
version_from_package() {
  local v="$1"
  case "${v}" in *-[0-9]*) v="${v%-*}";; esac
  printf '%s' "${v//\~/}"
}

# The upstream version behind a git tag. Upstream has used both "v2.0.0rc0" and
# a bare "1.6.2" over the years, so the prefix is optional.
version_from_tag() { printf '%s' "${1#v}"; }

# --- PACKAGE STATE ----------------------------------------------------------

# "not-installed", or dpkg's own word for the state: installed, unpacked,
# half-installed, half-configured, config-files, triggers-pending...
pkg_status() {
  local s
  s="$(dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null)" || s=''
  printf '%s' "${s:-not-installed}"
}

pkg_version() {
  dpkg-query -W -f='${Version}' "$1" 2>/dev/null || :
}

# Compare a file against an expected sha256, and say which is which on failure.
# A mismatch is never a transient fault, so this aborts rather than retrying.
verify_sha256() {
  local path="$1" want="$2" what="$3" got
  got="$(sha256sum "${path}" | cut -d' ' -f1)"
  [ "${got}" = "${want}" ] && return 0
  echo ' failed.'
  echo "Downloaded ${what} does not match the expected checksum; aborting." >&2
  echo "  expected ${want}" >&2
  echo "  got      ${got}" >&2
  echo '  Nothing has been changed. If upstream re-published this release, the' >&2
  echo '  hash in hdw4s-update has to be updated deliberately.' >&2
  return 1
}

# The sha256 GitHub records for a release asset, or empty if it records none.
#
# Whitespace is stripped and the text split into one record per asset, because
# the same endpoint is served pretty-printed to one client and compact to
# another, and a parser that assumed a space after the colon found nothing and
# reported "no digest published" for an asset that had one -- a check that
# silently does not run. Only the assets array is considered, so nothing a
# release body happens to contain can be read as an asset.
asset_digest() {
  [ -r "${release:-}" ] || return 0
  local span
  # Bounded to the span between this asset's name and the next asset's name.
  # Splitting the array on braces does not work: each asset embeds an uploader
  # object, so the name and the digest land in different pieces. And without
  # the upper bound, an asset whose digest is null silently borrows the next
  # asset's -- which is worse than reporting none.
  span="$(tr -d ' \t\n' < "${release}" |
          sed 's/.*"assets":\[//' |
          sed "s|.*\"name\":\"$1\"||" |
          sed 's/"name":".*//')"
  printf '%s' "${span}" |
    sed -n 's/.*"digest":"sha256:\([0-9a-f]\{64\}\)".*/\1/p' |
    head -n1
}

# The .deb built for this machine, named out of the release rather than guessed
# from the version. Upstream spells the same release "2.0.0rc0" in the tag and
# "2.0.0.rc0-1.ubuntu24.04" in the filename, and no rule turns one into the
# other without knowing where the release-candidate suffix begins.
asset_for_platform() {
  local platform='' arch
  arch="$(dpkg --print-architecture)"
  # shellcheck source=/dev/null disable=SC1091
  . /etc/os-release
  case "${ID:-}" in
    ubuntu) platform="ubuntu${VERSION_ID:-}" ;;
    debian) platform="${VERSION_CODENAME:-}" ;;
  esac
  [ -n "${platform}" ] || return 0
  # "|| :" around the whole pipeline, not decoration. A release that publishes
  # no package for this platform is an ordinary answer to an ordinary question,
  # and the caller below is written to handle it -- but grep exits 1 on no
  # match, pipefail turns that into a failed pipeline, and a failed command
  # substitution under errexit ends the script through the ERR trap before the
  # caller is ever reached. A pin to 1.6.2, which predates upstream's
  # distribution packages, did exactly that: "Script ... failed unexpectedly"
  # and a timer in permanent failure, with none of the explanation below shown.
  { tr -d ' \t\n' < "${release}" |
      sed 's/.*"assets":\[//' |
      grep -o '"name":"[^"]*"' |
      sed 's/^"name":"//; s/"$//' |
      grep -E "^selkies_.*\.${platform}_${arch}\.deb\$" |
      head -n1; } || :
}

# Fetch one release document. "latest" or a tag; empty output is the caller's
# signal that upstream could not be reached, which is never fatal here -- the
# machine keeps what it has and the timer tries again tomorrow.
fetch_release() {
  curl -fsSL --proto '=https' --proto-redir '=https' --max-time 300 --retry 3 \
       -o "$2" "${API}/releases/$1"
}

# --- WHAT THE INSTALLED COPY MUST BE ABLE TO DO -----------------------------
# Extracted and run by .github/clean-install-test.sh, which sets PREFIX and
# nothing else, so this must stand on its own.
#
# What it asserts is deliberately not "the program starts": an interrupted
# unpack leaves "selkies --version" answering perfectly while dpkg has the
# package marked half-installed, so the binary running proves nothing about the
# installation. Package state, file integrity and the extension modules are
# three independent signals and all three are checked.
smoke_test() {
  local status version home rc=0
  status="$(dpkg-query -W -f='${db:Status-Status}' selkies 2>/dev/null || :)"
  if [ "${status}" != 'installed' ]; then
    echo "selkies is ${status:-not installed}, not installed and configured"
    return 1
  fi
  # dpkg's own md5sums, which is the alarm for anything that edited the prefix
  # behind its back -- this updater included, if it ever grows a patch again.
  # Costs under a second for the 5000-odd files in the package.
  local verify
  verify="$(dpkg --verify selkies 2>&1)" || :
  if [ -n "${verify}" ]; then
    echo 'dpkg --verify selkies reports files that no longer match:'
    head -10 <<<"${verify}"
    return 1
  fi
  version="$("${PREFIX}/bin/selkies" --version 2>&1)" || {
    echo "selkies --version failed: ${version}"
    return 1
  }
  # The two extension modules carry the encoders, and both are linked against
  # libraries that live outside the package. A missing libva-x11-2 does not
  # stop the server starting: it logs one line about striped encoding being
  # unavailable and serves a desktop that cannot encode. Importing them is how
  # that becomes an error instead of a log line.
  #
  # HOME is redirected because importing the selkies package creates
  # $HOME/Desktop as an upload directory at import time, and a check has no
  # business writing into anybody's home. "selkies --version" exits before that
  # happens; the import does not.
  #
  # Both streams are captured. The package logs three INFO lines to stderr on
  # import -- including the one naming the upload directory, which is how the
  # HOME redirect above is seen to work -- and they belong in the report a
  # failure prints, not in the output of a run that succeeded.
  local log
  home="$(mktemp -d -t hdw4s-smoke.XXXXXXXX)"
  log="$(HOME="${home}" "${PREFIX}/bin/python" - 2>&1 <<'SMOKE'
import sys
import pixelflux        # video encoders; links libva-x11, libva-drm, libdrm
import pcmflux          # audio capture and playback; links libpulse
import selkies
import selkies.input_handler, selkies.stream_server, selkies.signaling_server
import selkies.webrtc_signaling, selkies.audio_control, selkies.display_utils

# Shelled out to at runtime, so nothing above notices them missing. xdotool is
# the fallback for every keysym XTEST cannot inject directly, and xset and
# xrandr are read and driven by the input and resize paths.
import shutil
missing = [p for p in ("xdotool", "xset", "xrandr")
           if shutil.which(p) is None]
if missing:
    sys.exit("missing programs: " + " ".join(missing))
SMOKE
)" || rc=1
  rm -rf "${home}"
  [ "${rc}" -eq 0 ] || {
    echo 'the installed package does not load:'
    printf '%s\n' "${log}" | sed 's/^/  /'
    return 1
  }
  printf 'selkies %s, dpkg clean\n' "${version#selkies }"
  return 0
}

# --- REFUSING TO START ON A MESS --------------------------------------------
# An updater that installs over a broken dpkg state does not produce one
# failure, it produces two, and the second hides the first. "dpkg --audit"
# names every package that is unpacked but not configured, half-installed, or
# otherwise mid-operation. It exits 0 whatever it finds, so it is the output
# that has to be tested, not the status.
#
# Foreign dirt is refused outright: repairing somebody else's package is not
# this script's business, and the desktop is not the reason it is broken.
# Selkies' own dirt is the one case this can do something about, and it is a
# state this script can produce itself -- a machine powered off during an
# unpack leaves exactly that -- so it is repaired, from the cached .deb, with
# bytes whose hash was recorded when they were installed.
preflight() {
  local audit dirty
  audit="$(dpkg --audit 2>&1)" || :
  [ -n "${audit}" ] || return 0

  # The package names in an audit report are the lines that start with a space.
  dirty="$(printf '%s\n' "${audit}" | sed -n 's/^ \([^ ]*\) .*/\1/p' | sort -u)"
  if [ -n "$(printf '%s\n' "${dirty}" | grep -vx "${PKG}" || :)" ]; then
    echo 'hdw4s: dpkg has packages in a broken state, and not only ours:' >&2
    printf '%s\n' "${dirty}" | sed 's/^/  /' >&2
    echo '  Refusing to install anything on top of that. Fix it with' >&2
    echo '    dpkg --configure -a' >&2
    echo '    apt-get -f install' >&2
    echo '  and this will carry on by itself at the next daily run.' >&2
    return 1
  fi

  echo "NOTICE: ${PKG} is in dpkg state '$(pkg_status "${PKG}")'." >&2
  echo '  An interrupted install leaves the streaming server present enough' >&2
  echo '  to answer --version and not present enough to work. Repairing it' >&2
  echo '  from the recorded copy before doing anything else.' >&2
  local cached
  cached="$(cached_deb_for "$(version_from_package "$(pkg_version "${PKG}")")")"
  if [ -z "${cached}" ]; then
    echo '  There is no recorded copy of that version under' >&2
    echo "    ${CACHE}" >&2
    echo '  so this cannot repair it without guessing. Run' >&2
    echo "    apt-get -f install" >&2
    echo '  or reinstall the package by hand.' >&2
    return 1
  fi
  install_deb "${cached}" || return 1
  # If it is still not clean the repair did not work, and going on would layer
  # the upgrade on top of the state that defeated it.
  audit="$(dpkg --audit 2>&1)" || :
  [ -z "${audit}" ] || {
    echo 'hdw4s: the repair did not take; dpkg still reports:' >&2
    printf '%s\n' "${audit}" | sed 's/^/  /' >&2
    return 1
  }
  echo '  Repaired.' >&2
  return 0
}

# dpkg's frontend lock is an fcntl lock, which flock(1) cannot see, so this
# asks the same way dpkg does. Acquired and released immediately: the point is
# only to find out whether somebody is in the middle of an apt run.
dpkg_busy() {
  [ -e /var/lib/dpkg/lock-frontend ] || return 1
  python3 - <<'LOCK' 2>/dev/null && return 1 || return 0
import fcntl, sys
with open("/var/lib/dpkg/lock-frontend", "r+") as f:
    fcntl.lockf(f, fcntl.LOCK_EX | fcntl.LOCK_NB)
LOCK
}

# Wait a while rather than giving up at once. The usual caller is the timer, for
# which an apt run in progress means "not now"; but the package's own postinst
# starts this service the moment it is installed, and at that moment dpkg is
# still finishing the very transaction that started it. Giving up there means a
# fresh install has no streaming server until the timer happens to fire, which
# on a machine installed at noon is most of a day.
#
# Bounded, because the unit allows thirty minutes in total and the download has
# to fit in what is left, and because an apt run that is still going after five
# minutes is a big one that this should stay out of.
wait_for_dpkg() {
  local waited=0
  while dpkg_busy; do
    [ "${waited}" -lt 300 ] || return 1
    [ "${waited}" -gt 0 ] || echo -n 'Waiting for apt or dpkg to finish...'
    sleep 5
    waited=$(( waited + 5 ))
  done
  [ "${waited}" -eq 0 ] || echo " done (${waited}s)."
  return 0
}

# --- THE CACHE --------------------------------------------------------------
# One .deb per upstream version, with the hash it was verified against beside
# it. The hash is written after the file, and read back before the file is
# used, so a cache entry truncated by a full disk or a power cut is caught
# rather than installed.
cached_deb_for() {
  local v="$1" f
  [ -n "${v}" ] || return 0
  f="${CACHE}/${v}/$(cat "${CACHE}/${v}/asset" 2>/dev/null || :)"
  [ -f "${f}" ] || return 0
  [ -s "${CACHE}/${v}/sha256" ] || return 0
  verify_sha256 "${f}" "$(cat "${CACHE}/${v}/sha256")" "the cached v${v} package" \
    >/dev/null 2>&1 || return 0
  printf '%s' "${f}"
}

cache_deb() {
  local new="$1" path="$2" sum="$3" prev="$4" d="${CACHE}/$1" base old name
  base="$(basename "${path}")"
  mkdir -p "${d}"
  cp -f "${path}" "${d}/${base}"
  printf '%s' "${base}" > "${d}/asset"
  printf '%s' "${sum}" > "${d}/sha256"
  # Two versions are worth keeping: the one just installed and the one it
  # replaced. Anything older is a version this machine can no longer be asked
  # to return to, and each of these is 54MB.
  for old in "${CACHE}"/*/; do
    [ -d "${old}" ] || continue
    name="$(basename "${old}")"
    [ "${name}" != "${new}" ] || continue
    [ -z "${prev}" ] || [ "${name}" != "${prev}" ] || continue
    rm -rf "${old}"
  done
}

# --- INSTALLING -------------------------------------------------------------
# dpkg, not apt. The dependencies are declared by hdw4s itself, so there is
# nothing for a solver to work out, and asking apt to install a local file
# hands it permission to remove whatever it decides is in the way -- on a
# machine whose whole job is to keep three desktops running.
#
# What dpkg does on failure is the reason the caller needs a rollback at all:
# a dependency it cannot satisfy leaves the package unpacked, which means the
# files are already on disk and the old ones are already gone.
install_deb() {
  local deb="$1" out rc=0
  out="$(dpkg -i "${deb}" 2>&1)" || rc="$?"
  if [ "${rc}" -ne 0 ]; then
    printf '%s\n' "${out}" | sed 's/^/  /' >&2
    return 1
  fi
  return 0
}

# Everything the .deb declares that is not installed. Run before the download,
# because the first thing dpkg does with an unsatisfiable package is unpack it
# anyway -- so "it will fail cleanly" is not true and the check has to happen
# while failing is still free.
#
# Version constraints are not evaluated: upstream declares none today, and a
# wrong answer here would be worse than no answer, so a constrained dependency
# counts as satisfied and is left to dpkg. Virtual packages are: upstream
# depends on libglib2.0-0, which on Ubuntu 24.04 nothing installs -- the real
# package is libglib2.0-0t64 and it Provides the old name. A check that reads
# only ${db:Status-Status} calls that missing and refuses every install on
# every machine, which is what the first version of this did.
installed_names() {
  dpkg-query -W -f='${db:Status-Status}\t${Package}\t${Provides}\n' 2>/dev/null |
    awk -F'\t' '$1 == "installed" {
                   print $2
                   p = $3
                   gsub(/\([^)]*\)/, "", p)
                   gsub(/,/, " ", p)
                   n = split(p, a, " ")
                   for (i = 1; i <= n; i++) if (a[i] != "") print a[i]
                 }' | sort -u
}

# Answered out of a table rather than by asking grep once per dependency, and
# that is not an optimisation.
#
# The version this replaces piped the installed names into "grep -qxF". grep -q
# exits the instant it matches, which closes the pipe, which kills the producer
# with SIGPIPE, which is status 141 -- and under "set -o pipefail" 141 is the
# status of the whole pipeline. So a dependency that IS installed reported as
# missing, and did so only when the match came early enough for grep to exit
# before the producer finished writing. On a container with a few hundred
# packages the list was short enough that it never happened; on a real desktop
# with 4681 of them it reported all twenty as missing and refused the install.
#
# The general rule, since the same shape was in four other places here: a
# consumer that can exit early -- grep -q, head -- must not end a pipeline in a
# script that sets pipefail unless the producer is known to be tiny. Everything
# below reads from a variable or a file instead.
unmet_depends() {
  local deb="$1" dep alt name ok n
  declare -A have
  while read -r n; do
    [ -n "${n}" ] || continue
    have["${n}"]=1
  done < <(installed_names)

  # "read" with one variable and the default IFS trims the surrounding
  # whitespace, which is why nothing here has to.
  while read -r dep; do
    [ -n "${dep}" ] || continue
    ok=''
    # "a | b" is satisfied by either, so every alternative has to be asked.
    for alt in ${dep//|/ }; do
      case "${alt}" in '('*|*')') continue;; esac
      name="${alt%%:*}"
      [ -z "${have["${name}"]:-}" ] || { ok='yes'; break; }
    done
    [ -n "${ok}" ] || printf '%s\n' "${dep}"
  done < <(dpkg-deb -f "${deb}" Depends | tr ',' '\n')
}

# --- ROLLING BACK -----------------------------------------------------------
# Three cases, and the third is the one that is easy to get wrong.
#
#   * There was a package here before: install its .deb back over the new one.
#     dpkg downgrades without complaint; apt would refuse without
#     --allow-downgrades, which is one more reason not to involve it.
#   * There was nothing here before: remove the package. Leaving a broken
#     install in place because "there is nothing to go back to" leaves the
#     machine one state worse than it started.
#   * There was a 1.6-era virtualenv here, moved aside rather than deleted for
#     exactly this moment. Put it back.
rollback() {
  local to_deb="$1"
  if [ -n "${to_deb}" ]; then
    echo "  Rolling back to v${current:-none}..." >&2
    install_deb "${to_deb}" || {
      echo '  The rollback itself failed. The machine is left with a package' >&2
      echo '  dpkg cannot configure; fix it with "apt-get -f install".' >&2
      return 1
    }
    echo "  Rolled back to v${current:-none}." >&2
    return 0
  fi
  echo '  No previous package to restore; removing the one just installed.' >&2
  dpkg -P "${PKG}" >/dev/null 2>&1 || {
    echo "  Removing ${PKG} failed as well." >&2
    return 1
  }
  if [ -d "${LEGACY}" ]; then
    mv "${LEGACY}" "${PREFIX}"
    echo "  Put the pre-2.0 installation back at ${PREFIX}." >&2
  fi
  return 0
}

# --- WHAT IS INSTALLED, AND WHAT SHOULD BE ----------------------------------
if ! wait_for_dpkg; then
  echo
  echo 'hdw4s: apt or dpkg is still busy; leaving this run to the next one.'
  exit 0
fi

preflight || die

status="$(pkg_status "${PKG}")"
current=''
[ "${status}" != 'installed' ] ||
  current="$(version_from_package "$(pkg_version "${PKG}")")"

release="${workdir}/release.json"
pinned=''
if [ -n "${SELKIES_VERSION:-}" ]; then
  wanted="$(version_from_tag "${SELKIES_VERSION}")"
  pinned='yes'
  echo "Selkies pinned to v${wanted} by /etc/hdw4s/hdw4s.conf."
else
  echo -n 'Checking for Selkies updates...'
  # curl's own diagnosis is worth keeping -- "could not resolve" and "connection
  # refused" send somebody to different places -- but it goes to stderr the
  # moment it happens, which lands it in the middle of the line above. Held
  # back and printed under the explanation instead.
  why="$(fetch_release latest "${release}" 2>&1)" || {
    echo ' failed.'
    echo 'Could not reach the GitHub release API; leaving the installation alone.' >&2
    [ -z "${why}" ] || printf '  %s\n' "${why}" >&2
    exit 0
  }
  # The address, then the substitution, then "q" -- rather than a "head -n1" on
  # the end of a pipe. sed stops itself at the first match, so there is no
  # early-exiting consumer to SIGPIPE the producer. A block cannot hang off an
  # "s" command directly; written that way sed refuses the expression, prints
  # nothing, and the tag comes back empty -- which the guard below then reports
  # as "upstream returned no usable release tag" and, until this was changed,
  # exited 0 on. A broken parser that looks like a quiet night is exactly the
  # failure this file is meant not to have.
  wanted="$(version_from_tag "$(sed -n '/"tag_name"/{
              s/.*"tag_name": *"\([^"]*\)".*/\1/p;q
            }' "${release}")")"
  echo ' done.'

  # Not exit 0. Upstream always names its releases, so no tag means either the
  # API changed shape or the parser above is broken, and neither is a thing
  # that comes right by waiting. Exiting 0 here is how a machine stops updating
  # while its timer goes on reporting success every night.
  #
  # "null" is spelled out because jq prints that literal for a missing key, and
  # an emptiness test alone would let it through and build a download URL for
  # version "null".
  case "${wanted}" in
    ''|null)
      echo 'hdw4s: upstream returned a release document this cannot read: no' >&2
      echo '  usable tag name in it. Nothing has been changed. If the GitHub' >&2
      echo '  API has changed shape, hdw4s-update has to be taught the new' >&2
      echo '  one; pin SELKIES_VERSION meanwhile to stop this repeating.' >&2
      die
      ;;
  esac

  # Refuse to follow upstream past the packaging this script was written
  # against. Failing loudly here turns a future breaking release into a log
  # entry rather than a fleet of desktops that no longer start.
  #
  # Note what this does NOT do: it does not ask whether the release is newer.
  # "releases/latest" today answers v2.0.0rc0 with prerelease false, so a gate
  # that skipped pre-releases would never install the only 2.0 there is, and a
  # gate that compared version numbers would have to order "2.0.0rc0" against
  # "2.0.0" -- which it would get wrong in the direction that matters. The
  # question worth asking is the narrow one: is this the release whose layout
  # was tested?
  if [ "${wanted}" != "${KNOWN_GOOD}" ]; then
    printf '%s\n' \
      "NOTICE: upstream now offers v${wanted}, which is not v${KNOWN_GOOD}, the" \
      "  release this version of hdw4s was built and tested against. Staying" \
      "  on v${KNOWN_GOOD}. Upgrade hdw4s, or set SELKIES_VERSION=${wanted} in" \
      "  /etc/hdw4s/hdw4s.conf to install it anyway." >&2
    wanted="${KNOWN_GOOD}"
  fi
fi

# The release document for whatever version was settled on, which is where both
# the asset name and its published digest come from. For the unpinned path
# above it has already been fetched, unless the gate moved the target back.
if [ ! -s "${release}" ] ||
   ! grep -q "\"tag_name\": *\"v\{0,1\}${wanted}\"" "${release}"; then
  # Both spellings, because upstream has tagged releases "v2.0.0rc0" and
  # "1.6.2". The first of the two is expected to fail half the time, so neither
  # is allowed to print curl's own 404 on the way past.
  frc=0
  fetch_release "tags/v${wanted}" "${release}" 2>/dev/null ||
    fetch_release "tags/${wanted}" "${release}" 2>/dev/null || frc="$?"
  if [ "${frc}" -ne 0 ]; then
    # 22 is curl's status for an HTTP error under --fail, which here means
    # there is no such release. Anything else -- a timeout, no route, a name
    # that would not resolve -- is the network, and the network is not a
    # reason to do anything but try again tomorrow.
    #
    # The two are separated because the consequences differ. An unreachable
    # GitHub fixes itself; a pin naming a release that does not exist does not,
    # and exiting 0 on it would leave a machine that has silently stopped
    # updating and a timer that says everything is fine. This is the same
    # decision as the unsatisfiable pin further down and it has to agree with
    # it.
    if [ "${frc}" -eq 22 ] && [ -n "${pinned}" ]; then
      echo "hdw4s: upstream publishes no release v${wanted}." >&2
      echo "  SELKIES_VERSION=${SELKIES_VERSION} in /etc/hdw4s/hdw4s.conf names a" >&2
      echo '  release that does not exist, so nothing will ever be installed' >&2
      echo '  while it stands. Correct it, or remove it to follow upstream.' >&2
      echo '  Nothing has been changed.' >&2
      die
    fi
    echo "Could not read upstream's release v${wanted}; leaving the" >&2
    echo '  installation alone.' >&2
    exit 0
  fi
fi

# Whether the right version is installed is one question; whether the files are
# still the ones dpkg put there is another, and a session that fails because
# somebody edited the prefix reports neither. Ask both, and reinstall on either
# answer.
if [ "${current}" = "${wanted}" ]; then
  damage="$(dpkg --verify "${PKG}" 2>&1)" || :
  if [ -z "${damage}" ]; then
    echo -n "Selkies v${wanted} is already installed; checking it still loads..."
    # The nightly run is the only thing that looks at this machine every day,
    # and nearly every night it has nothing to install. Checking anyway is what
    # turns "a library was removed three weeks ago" into a failed timer that
    # night instead of a desktop that will not start whenever somebody next
    # asks for one.
    #
    # Nothing is rolled back here: nothing was changed, so there is nothing to
    # go back to, and reinstalling a package dpkg still verifies would not
    # repair whatever was taken away from around it. Failing loudly is the
    # whole contribution.
    if out="$(smoke_test)"; then
      echo " yes (${out})."
      exit 0
    fi
    echo ' no.'
    echo 'CRITICAL: Selkies is installed and does not work.' >&2
    printf '%s\n' "${out}" | tail -10 | sed 's/^/  /' >&2
    echo '  Nothing was changed, because nothing here would repair it.' >&2
    die
  fi
  echo "Selkies v${wanted} is installed but has been modified since:" >&2
  head -10 <<<"${damage}" | sed 's/^/  /' >&2
  echo '  Reinstalling it.' >&2
fi

asset="$(asset_for_platform)"
[ -n "${asset}" ] || {
  # shellcheck source=/dev/null
  this="$(. /etc/os-release; echo "${ID}-${VERSION_ID}") $(dpkg --print-architecture)"
  echo "hdw4s: upstream's v${wanted} publishes no package for this system" >&2
  echo "  (${this})." >&2
  if [ -n "${pinned}" ]; then
    # Worth separating from a release that simply skipped one platform,
    # because this one can never come right on its own. Every release before
    # 2.0 shipped a Python wheel and a browser bundle and no .deb at all, so a
    # pin to any of them asks for something that does not exist and will not
    # start existing; the timer would otherwise report the same failure every
    # night for ever.
    echo "  SELKIES_VERSION=${SELKIES_VERSION} in /etc/hdw4s/hdw4s.conf asks for" >&2
    echo '  a release this cannot install. Releases before v2.0.0rc0 shipped a' >&2
    echo '  Python wheel rather than a distribution package, and this hdw4s' >&2
    echo '  installs only the package. Remove the pin to follow upstream, or' >&2
    echo '  pin a release that publishes a .deb for this system.' >&2
  fi
  echo '  Nothing has been changed.' >&2
  die
}

echo "Upgrading Selkies from v${current:-none} to v${wanted} (${asset})..."

# The bytes to go back to, on disk and verified, before the new ones are
# fetched. A rollback target that is only a URL is not a rollback target: the
# asset can be withdrawn, and the moment it is needed is the moment the network
# is least worth depending on.
previous=''
if [ -n "${current}" ]; then
  previous="$(cached_deb_for "${current}")"
  if [ -z "${previous}" ]; then
    echo "  NOTE: there is no verified copy of the installed v${current} under" >&2
    echo "    ${CACHE}, so a failed upgrade can only be rolled back by" >&2
    echo '    removing the package, not by restoring that version.' >&2
  fi
fi

echo -n '  Downloading...'
url="$(tr -d ' \t\n' < "${release}" |
       sed 's/.*"assets":\[//' |
       sed "s|.*\"name\":\"${asset}\"||" |
       sed 's/"name":".*//' |
       sed -n '/"browser_download_url"/{
                 s|.*"browser_download_url":"\([^"]*\)".*|\1|p;q
               }')"
[ -n "${url}" ] || {
  echo ' failed.'
  echo "Upstream lists ${asset} with no download URL; aborting." >&2
  die
}
curl -fsSL --proto '=https' --proto-redir '=https' --max-time 900 --retry 3 \
     -o "${workdir}/${asset}" "${url}"
echo ' done.'

echo -n '  Verifying...'
sum="$(sha256sum "${workdir}/${asset}" | cut -d' ' -f1)"
if [ "${asset}" = "${KNOWN_GOOD_ASSET}" ] && [ "${wanted}" = "${KNOWN_GOOD}" ]; then
  verify_sha256 "${workdir}/${asset}" "${KNOWN_GOOD_SHA256_DEB}" 'package' || die
  checked='the hash recorded in hdw4s'
else
  published="$(asset_digest "${asset}")"
  [ -n "${published}" ] || {
    echo ' failed.'
    echo "hdw4s: ${asset} is not the asset this hdw4s records a hash for," >&2
    echo '  and GitHub publishes no digest for it either, so what was' >&2
    echo '  downloaded cannot be checked against anything. Refusing to' >&2
    echo '  install it. Nothing has been changed.' >&2
    die
  }
  verify_sha256 "${workdir}/${asset}" "${published}" 'package' || die
  checked="the digest GitHub publishes for ${asset}"
fi

# The asset is named by the release, so a wrong one is unlikely; the point of
# reading the control fields back is that being unlikely is not the same as
# being checked, and installing a package that turns out to be something else
# is not recoverable by anything below.
got_pkg="$(dpkg-deb -f "${workdir}/${asset}" Package)"
got_ver="$(version_from_package "$(dpkg-deb -f "${workdir}/${asset}" Version)")"
got_arch="$(dpkg-deb -f "${workdir}/${asset}" Architecture)"
if [ "${got_pkg}" != "${PKG}" ] || [ "${got_ver}" != "${wanted}" ] ||
   { [ "${got_arch}" != "$(dpkg --print-architecture)" ] &&
     [ "${got_arch}" != 'all' ]; }; then
  echo ' failed.'
  echo "Downloaded ${asset} is ${got_pkg} ${got_ver} (${got_arch}), not" >&2
  echo "  ${PKG} ${wanted} ($(dpkg --print-architecture)); aborting." >&2
  die
fi
echo " done, against ${checked}."

missing="$(unmet_depends "${workdir}/${asset}" | tr '\n' ' ')"
[ -z "${missing# }" ] || {
  echo "hdw4s: Selkies v${wanted} needs packages this machine does not have:" >&2
  echo "  ${missing}" >&2
  echo '  dpkg would unpack it over the working copy and then refuse to' >&2
  echo '  configure it, so this stops here instead. Install them, or upgrade' >&2
  echo '  hdw4s -- its own dependencies are what put them there.' >&2
  die
}

# --- THE 1.6 PREFIX ---------------------------------------------------------
# A virtualenv this script built, before upstream shipped a package. dpkg knows
# nothing about it, so nothing under it is anybody's property and moving it is
# safe -- which is not true in the other direction, and is why this is asked
# with dpkg-query rather than by looking for a file.
if [ -d "${PREFIX}" ] && ! dpkg-query -S "${PREFIX}/bin/python" >/dev/null 2>&1; then
  echo '  A pre-2.0 Selkies is in the way. It was installed by an older hdw4s'
  echo '  as a virtualenv, not as a package, and dpkg cannot unpack over it'
  echo "  cleanly, so it is moved to ${LEGACY} first."
  rm -rf "${LEGACY}"
  mv "${PREFIX}" "${LEGACY}"
  # The 1.6 browser client. Selkies 2.0 serves its own from inside the package
  # and hdw4s no longer passes --web-root, so nothing reads this again.
  rm -rf /opt/gst-web /opt/gst-web.bak "${PREFIX}.bak"
  legacy_moved='yes'
fi

echo -n '  Installing...'
if ! install_deb "${workdir}/${asset}"; then
  echo 'CRITICAL: dpkg could not install the new package.' >&2
  rollback "${previous}" || die
  die
fi
echo ' done.'

echo -n '  Checking that the new installation loads...'
if out="$(smoke_test)"; then
  echo " done (${out})."
else
  echo ' failed.'
  echo 'CRITICAL: the new installation does not work.' >&2
  printf '%s\n' "${out}" | tail -10 | sed 's/^/  /' >&2
  rollback "${previous}" || die
  die
fi

# Only now, with a package that installs and loads, are the bytes worth
# keeping: caching a .deb that has never worked would give the next failure a
# rollback target that is itself broken.
cache_deb "${wanted}" "${workdir}/${asset}" "${sum}" "${current}"
[ -z "${legacy_moved:-}" ] || {
  echo "  The pre-2.0 installation is still at ${LEGACY}. Nothing reads it;"
  echo '  remove it once this release has been in use for a while.'
}

# --- RESTART WHAT IS SAFE TO RESTART ----------------------------------------
# No --all. Instances stay loaded but inactive because the proxy unit requires
# them, and restarting those started a full desktop for somebody who had not
# asked for one -- undoing both socket activation and the reaper on every
# upgrade.
mapfile -t units < <(systemctl list-units --plain --no-legend --state=active 'hdw4s@*' |
                     awk '{print $1}')
# Sessions are socket-activated and are not started at boot, so this list is
# normally empty and this is the branch nearly every upgrade takes. That is why
# the smoke test above runs unconditionally and before this point: an upgrade
# on a machine where nobody happened to be logged in used to reach the end
# without having executed a single byte of the new installation, and report
# success.
[ "${#units[@]}" -gt 0 ] || {
  echo 'Upgrade complete; no sessions were running.'
  exit 0
}

# Restart only sessions nobody is using. A daily timer that reboots a desktop
# somebody is working in -- unsaved editors, a half-written mail -- turns an
# auto-updater from an asset into the reason it gets switched off. Sessions in
# use keep the old code until they next stop on their own, which is exactly
# when picking up the new version costs nothing.
idle=()
busy=()
for unit in "${units[@]}"; do
  inst="${unit#hdw4s@}"; inst="${inst%.service}"
  port="$(sed -n 's/^[[:space:]]*HDW4S_PORT=\([0-9]\{1,\}\).*/\1/p' \
          "/etc/hdw4s/${inst}.conf" 2>/dev/null | tail -n1)"
  if [ -z "${port}" ]; then
    idx="$(awk -v i="${inst}" '$1 !~ /^#/ && $2 == i { print $1; exit }' \
           /etc/hdw4s/instances 2>/dev/null)"
    # Digits only before it reaches an arithmetic context. The slot table is
    # root-owned, so this is not a way in today, but $(( )) evaluates what it
    # is given -- a stray word there is a command substitution, not a syntax
    # error -- and a file parsed by three scripts should not rely on all of
    # them being careful.
    case "${idx}" in *[!0-9]*) idx='';; esac
    # The internal port, as the reaper uses: a session on a filesystem socket
    # has no connections on the external one and would look idle when busy.
    [ -z "${idx}" ] ||
      port=$(( ${HDW4S_BASE_PORT:-7300} + ${HDW4S_BLOCK_SIZE:-64} + idx ))
  fi
  # Count only what the socket proxy is relaying. The streaming process is both
  # the signalling server and two of its own peers, so it connects to this port
  # twice itself and a plain count of established connections is never zero.
  # That is how every running session was classified "in use" -- so no session
  # was ever restarted, the check below that a restarted session comes up
  # healthy was never reached, and the backups it would have rolled back to were
  # deleted on the way out.
  #
  # This has to stay in step with clients_of() in hdw4s, which answers the same
  # question for the reaper and had the same bug.
  attached='0'
  proxy_pid="$(systemctl show "hdw4s-proxy@${inst}.service" -p MainPID --value \
               2>/dev/null || echo 0)"
  # Looked at more than once, a few seconds apart. A browser that reconnects --
  # after a network blip, or when a stream is renegotiated -- is genuinely
  # disconnected for several seconds at a time, and one instant's sample taken
  # inside that gap reads zero while somebody is at the keyboard. Restarting
  # then costs them their desktop and anything unsaved in it, which is the one
  # outcome worth real effort to avoid; a few seconds' delay costs nothing.
  case "${proxy_pid}" in
    ''|0|*[!0-9]*) ;;
    *)
      for _sample in 1 2 3; do
        conns="$(ss -Htnp state established "dport = :${port}" 2>/dev/null || :)"
        # Asked with a pattern rather than a pipe into grep -q, which would
        # come back 141 on a busy machine and take this branch exactly when it
        # should not: a session whose owners are perfectly visible classified
        # as one whose owners are not.
        if [ -n "${conns}" ] && [[ "${conns}" != *pid=* ]]; then
          # Connections exist but we cannot see who owns them, so we cannot tell
          # a user from the session talking to itself.
          attached='1'
        else
          attached="$(printf '%s\n' "${conns}" | grep -c "pid=${proxy_pid}," || :)"
        fi
        [ "${attached:-0}" -eq 0 ] || break
        [ "${_sample}" -eq 3 ] || sleep 4
      done ;;
  esac
  # The reaper writes a stamp whenever it sees a client, every few minutes. A
  # recent one means somebody was here even if all three samples above happened
  # to land in a gap, so treat it as in use and let the session pick the new
  # version up when it next stops on its own.
  stamp="/run/hdw4s-reap/${inst}"
  if [ "${attached:-0}" -eq 0 ] && [ -r "${stamp}" ]; then
    last="$(cat "${stamp}" 2>/dev/null || echo 0)"
    case "${last}" in
      ''|*[!0-9]*) ;;
      *) [ "$(( $(date +%s) - last ))" -gt 900 ] || attached='1' ;;
    esac
  fi
  if [ -n "${port}" ] && [ "${attached:-0}" -gt 0 ]; then
    busy+=("${unit}")
  else
    idle+=("${unit}")
  fi
done

[ "${#busy[@]}" -eq 0 ] || {
  echo "Leaving ${#busy[@]} session(s) in use on v${current:-none}:"
  printf '  %s\n' "${busy[@]}"
  echo '  They will pick up the new version when they next restart.'
}

[ "${#idle[@]}" -gt 0 ] || {
  echo 'Every session is in use; nothing to restart.'
  exit 0
}

units=("${idle[@]}")
echo -n "Restarting ${#units[@]} idle session(s)..."
systemctl restart "${units[@]}" || :

# A unit that crashes on the new version is put into auto-restart by
# Restart=on-failure, and spends most of its time in "activating" rather than
# "failed". Polling is-active for a fixed window and then asking whether the
# unit restarted at all catches that; a single sleep followed by a check for
# "failed" almost never does.
sleep 15
healthy='yes'
for unit in "${units[@]}"; do
  state="$(systemctl show -p ActiveState --value "${unit}")"
  restarts="$(systemctl show -p NRestarts --value "${unit}")"
  if [ "${state}" != 'active' ] || [ "${restarts:-0}" -ne 0 ]; then
    echo " ${unit} is ${state} after ${restarts:-0} restart(s)."
    healthy=''
  fi
done

if [ -n "${healthy}" ]; then
  echo ' done.'
  echo "Upgrade to v${wanted} successful."
  exit 0
fi

echo 'CRITICAL: sessions did not come back up. Rolling back...' >&2
if rollback "${previous}"; then
  systemctl restart "${units[@]}" || :
fi
die
