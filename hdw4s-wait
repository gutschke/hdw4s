#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

# Waits until a session's streaming server is accepting connections.
#
# Run before the relay that fronts a session. The session unit is ordered
# first and reports ready only once the stream is listening, but if that is
# ever wrong the relay refuses the connection -- and with a chain of reverse
# proxies in front, a refusal on the first visit becomes an error page from
# whichever of them is outermost, long before any browser retry could help.
# Checking is cheap and a few seconds are invisible next to the time a desktop
# takes to start.

instance="${1:?usage: hdw4s-wait <instance> [seconds]}"
deadline="${2:-120}"

# The path the relay's own ExecStart= names; see hdw4s-proxy@.service. Inside the
# relay's namespace this is the only stream directory that exists.
sock="/run/hdw4s-stream/${instance}/s/stream.sock"

# A CONNECT, the question the relay will ask, rather than a look at the file: a
# socket file is not a listener. python3 because bash's /dev/tcp has no AF_UNIX
# counterpart, and it is already a dependency.
#
# The symlink test is a sanity check and NOT a defence: the directory belongs to
# the session's occupant, who can swap the file between this test and the relay's
# connect. What stops a swapped-in symlink reaching anything is the relay's mount
# namespace, which contains no other stream directory to point at.
for _ in $(seq 1 "${deadline}"); do
  if [ ! -L "${sock}" ] &&
     python3 -c 'import socket, sys
s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
s.connect(sys.argv[1])' "${sock}" 2>/dev/null; then
    exit 0
  fi
  sleep 1
done

echo "hdw4s: ${instance} never began listening on ${sock}" >&2
exit 1
