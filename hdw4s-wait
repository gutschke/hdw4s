#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

# Waits until a session's streaming server is accepting connections.
#
# Run before the relay that fronts a session. The session unit is ordered
# first and reports ready only once the stream is listening, but if that is
# ever wrong the relay refuses the connection -- and with a chain of reverse
# proxies in front, a refusal on the first visit becomes an error page from
# whichever of them is outermost, long before any browser retry could help.
# Checking is cheap and a few seconds are invisible next to the time a desktop
# takes to start.

instance="${1:?usage: hdw4s-wait <instance> [seconds]}"
deadline="${2:-120}"

CONF='/etc/hdw4s/hdw4s.conf'
SLOTS='/etc/hdw4s/instances'
HDW4S_BASE_PORT=7300
HDW4S_BLOCK_SIZE=64
# shellcheck source=/dev/null
if [ -r "${CONF}" ]; then
  f="${CONF}"
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "${CONF}" || {
    echo "hdw4s: ${f} has a syntax error (above); refusing to run on a" >&2
    echo '  configuration that would be applied only as far as the error.' >&2
    echo '  Edit it by hand -- "hdw4s set" and "hdw4s unset" read the same' >&2
    echo '  file and are unavailable until it parses.' >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "${CONF}" || :
fi
# shellcheck source=/dev/null
if [ -r "/etc/hdw4s/${instance}.conf" ]; then
  f="/etc/hdw4s/${instance}.conf"
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "/etc/hdw4s/${instance}.conf" || {
    echo "hdw4s: ${f} has a syntax error (above); refusing to run on a" >&2
    echo '  configuration that would be applied only as far as the error.' >&2
    echo '  Edit it by hand -- "hdw4s set" and "hdw4s unset" read the same' >&2
    echo '  file and are unavailable until it parses.' >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "/etc/hdw4s/${instance}.conf" || :
fi

if [ -n "${HDW4S_PORT:-}" ]; then
  port="${HDW4S_PORT}"
else
  # awk exits non-zero when the file is not there, and the assignment carries
  # that status out, so under errexit the script died here and the diagnostic
  # below -- the one that says what to do about it -- never printed.
  slot=''
  if [ -r "${SLOTS}" ]; then
    slot="$(awk -v i="${instance}" \
            '$1 !~ /^#/ && $2 == i { print $1; exit }' "${SLOTS}")" || :
  fi
  [ -n "${slot}" ] || {
    echo "hdw4s: ${instance} has no slot; nothing to wait for." >&2
    exit 1
  }
  port=$(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE + slot ))
fi

for _ in $(seq 1 "${deadline}"); do
  if (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null; then
    exit 0
  fi
  sleep 1
done

echo "hdw4s: ${instance} never began listening on port ${port}" >&2
exit 1
