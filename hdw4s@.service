[Unit]
Description=HDW4S headless desktop for %i
Documentation=man:hdw4s(8)
After=network-online.target hdw4s-firewall.service
Wants=network-online.target
# Deliberately a hard requirement. Stopping the firewall unit runs its
# ExecStop=, which deletes the table that is the only thing standing
# between this session and the network, so a session must not outlive it.
# The package is careful never to stop it during an upgrade.
Requires=hdw4s-firewall.service

# WHICH INCARNATION OF THIS DESKTOP IS RUNNING, published where the occupant
# cannot forge it and any page this session serves can read it -- exactly as the
# ephemeral unit does, and for a reason a named desktop turns out to share.
#
# MEASURED 2026-09-25, by the owner on his own named desktop: a tab that is
# hidden and comes back meets the reconnect card EVERY TIME. Its console shows
# `/hdw4s-incarnation 404` on the first line. The gate's resume path compares
# the identity this tab connected to against the one published in the web root,
# and a MISSING file is a refusal -- failing closed, which is right, into a card
# shown on every single return with nothing behind it.
#
# So the repair that fixed this for the pool could not work here, and nothing
# said so: every rig ran against ephemeral slots, and the one thing a named
# desktop has that an ephemeral one does not is the ABSENCE of this file.
#
# Wants=, deliberately, not Requires=, for the reason the ephemeral unit states
# at length: the postcondition in "hdw4s-webroot check" already refuses to start
# a session whose token is missing, unchanged, or not the one this generation
# wrote, which catches more cases than Requires= would -- and Requires= would
# charge a stop-propagation footgun for it, where stopping a dead oneshot takes
# a live desktop down with it. After= is what actually orders it.
Wants=hdw4s-incarnation@%i.service
After=hdw4s-incarnation@%i.service

# WHERE THE STREAMING SERVER LISTENS: a directory only this session's account may
# create in and only it and the relay's group may enter -- hdw4s-stream-dir says
# why a directory and not a port. Requires=, not Wants=: a session with no stream
# directory can be reached by nobody, and starting it anyway only hides why.
Requires=hdw4s-stream@%i.service
After=hdw4s-stream@%i.service
# A home directory that arrives over the network has to be there before a
# desktop tries to read settings out of it.

# IN [Unit] AND NOT [Service], which is where this went first. StartLimitIntervalSec=
# and StartLimitBurst= are [Unit] directives; systemd parses them nowhere else and a
# copy in [Service] is a line that looks like a guard and is not one.
#
# THE RESTART LOOP HAD NO LATCH, and that is what turned one broken check into an
# hour of a healthy desktop being torn down 55 times on 2026-09-25. Nothing would
# ever have stopped it; a person noticed.
#
# systemd's start limit is the only thing that latches, and its default window is
# 10 seconds. This unit takes up to ninety seconds to fail and then waits five, so
# a failure cycle is about ninety-five seconds and NRestarts went 1, 2, back to 1
# for ever -- the burst was never reached inside the window, so the window is the
# bug and not the burst.
#
# SINCE 2026-10-03 THIS IS ONLY THE OUTER FUSE, and the reason is that it counts
# STARTS, not failures -- more of them than anybody sees. Measured on systemd
# 255: every dispatch of a start job is charged, so a tab that reconnects while
# the desktop is still stopping costs 2 charges per logout and revisit, and 3
# while a logout was itself a failure that restarted. The limit that stood here
# (5 in 20 minutes) latched the owner out of his own desktop after TWO logouts.
#
# What latches a desktop that cannot start is now hdw4s-ledger: it counts runs
# that ended without success, three in twenty minutes, and the session refuses
# before READY with status 75 (RestartPreventExitStatus= below). A logout is a
# clean end and counts nowhere. This fuse remains for a loop that never reaches
# that check -- an ExecStartPre= that always fails -- and is sized from both ends:
#
#   It must trip: one charge per cycle at the least, and the slowest cycle is
#   TimeoutStartSec= + RestartSec= = 125 s, so 25 cycles take at most about 52
#   minutes, inside the hour. A fast failure (about 5 s a cycle) trips in about
#   two minutes. tests.sh derives this from the lines below.
#
#   Ordinary use must not reach it: at 3 charges per logout and revisit -- the
#   larger measured figure, as margin -- six logouts in the hour cost 19 of the
#   25, and the ledger's three failures cost about 10 before it refuses.
#
# THE COST: a desktop whose refusals keep being knocked on -- a tab left open
# retries -- charges one per refused start, so the fuse can trip AFTER the ledger
# has, and then holds for up to an hour from its first charge rather than the
# ledger's twenty minutes. Both lift by themselves; reset-failed clears the fuse.
# If this latches on somebody's ordinary use, re-measure the charges rather than
# raising the numbers blind: the 2026-09-25 loop is what an unreachable limit is.
StartLimitIntervalSec=1h
StartLimitBurst=25

[Service]
# There is deliberately no User= here. The instance name is the account name,
# so "User=%i" would be correct as far as it goes -- but an invalid user name in
# a base unit is a fatal parse error, and the unit then never loads far enough
# for a drop-in to override it. An instance named for an account that does not
# exist would become unloadable rather than failing with something an
# administrator can read. So "hdw4s enable" writes User= into a drop-in for
# every instance, and hdw4s-session refuses to run as root, which is what a
# missing drop-in would otherwise mean.

# A narrow bounding set, and three capabilities in it.
#
# CAP_NET_RAW is here because an empty set breaks ping in a way that takes a
# long time to understand: the distribution ships /usr/bin/ping with
# cap_net_raw=ep, and the kernel refuses to execve a binary whose effective
# capabilities cannot be granted, so the session gets "Operation not permitted"
# from exec with nothing said about sockets. Allowing a capability into the
# bounding set does not hand it to anything: a process still needs it on its own
# file to use it, and setting that needs CAP_SETFCAP, which is not here. Packet
# capture stays impossible regardless, because AF_PACKET is not in
# RestrictAddressFamilies below.
#
# CAP_SETUID and CAP_SETGID are here because leaving them out does not do what
# it looks like it does. Without them a setuid-root program cannot change its
# gid, so sudo fails at "unable to change to root gid: Operation not permitted"
# -- before sudoers is consulted and before anyone is asked for a password. It
# reads as a security control and is not one. Measured, on a setuid-root binary
# run with exactly the bounding set that omitted them:
#
#     euid=0  caps=cap_net_raw=ep
#     /etc/shadow                       r : OK
#     /etc/sudoers                      r : OK
#     /root/canary                      w : OK
#     /etc/systemd/system/probe.service w : OK
#
# euid 0 is granted by the kernel at execve whatever the bounding set says, and
# a process with euid 0 owns every root-owned file by the ordinary permission
# bits -- no capability is involved. What the omission blocked was the gid
# change, which is the legitimate path (sudo, su) and not the attack path. It
# could not deny root to anyone sudoers denies it to, only to the administrators
# sudoers allows.
#
# What keeps a session from acting on that is the sandbox below -- ProtectSystem=
# strict makes the writes above fail inside this unit -- and sudoers, which is
# where "who may become root" belongs and where an administrator will look for
# it. The rest of the bounding set still does real work: CAP_SYS_ADMIN,
# CAP_SYS_MODULE, CAP_NET_ADMIN and everything else remain out, so mounting,
# module loading and network reconfiguration stay impossible for uid 0 here.
# NO DAC CAPABILITY HERE, and the reason is worth more than the line.
#
# For several hours on 2026-09-25 this granted one (first CAP_DAC_READ_SEARCH,
# then CAP_DAC_OVERRIDE) to let the front-door fetch that stood at this unit's
# ExecStartPost= until 2026-09-26 -- "hdw4s-webroot serving-gate" -- read this
# unit's own credential, on a diagnosis that the mode-0000 staging directory
# could not be traversed by a uid-0 process without it. THAT WAS WRONG, and the
# comment that stood here asserted the opposite with a "Measured" stamp --
# which is the more dangerous artefact of the two, because the next reader
# believes a comment.
#
# What was actually measured, in production shape (nothing ahead of the gate,
# Restart=no, three starts): it fails 3/3 WITH the capability, and succeeds 3/3
# with a bare "ExecStartPost=!/bin/true" placed AHEAD of the gate. The deciding
# fact is the gate's POSITION -- each Exec line is built with its own mount
# namespace and the FIRST ExecStartPost does not have this unit's credential
# directory mounted in it at all. The capability only turned EACCES into ENOENT:
# it opened the placeholder and found an empty directory.
#
# So a capability bought nothing and granted real privilege for it. The earlier
# reading that seemed to confirm it came from a diagnostic whose own probe sat in
# first position and thereby pushed the gate to second, where it passes -- the
# instrument changed the answer.
#
# The remaining fault is an ORDERING/OWNERSHIP one and is not repaired here; see
# private/SESSION-STATE.md. Do not re-add a DAC capability to make this pass:
# it has been tried twice and measured failing both times.
CapabilityBoundingSet=CAP_NET_RAW CAP_SETUID CAP_SETGID
DevicePolicy=closed
# The GPU, where the machine has one. Both lines are inert on a machine without
# one -- the "-" makes the bind optional, and a device rule for a class of nodes
# that do not exist grants nothing -- so this is set unconditionally rather than
# made an administrator's decision to get wrong.
#
# Both are needed, and neither alone does anything. PrivateDevices= gives the
# session a private /dev holding only pseudo-devices, so the render node is not
# there to open: DeviceAllow= grants the cgroup permission and BindPaths= puts
# the node in the namespace. Without the bind the session reports "No such file
# or directory"; without the allow it reports "Permission denied" -- and the
# encoder quietly falls back to software in both cases, which looks like a slow
# machine rather than a missing device.
#
# The group that owns the node is the third piece and cannot be named here,
# because it differs between machines -- render on a stock host, plugdev inside
# these containers. "hdw4s enable" reads it off the node and writes it into a
# drop-in.
DeviceAllow=char-drm rw
BindPaths=-/dev/dri
Environment=LIBGL_ALWAYS_SOFTWARE=1
# Not /run/user/<uid>, even though this unit now runs one desktop per account
# and could name it. That directory belongs to logind, which creates it for a
# login session and removes it with the last one; this unit has no PAM session
# and so no claim on it. RuntimeDirectory= below makes systemd the owner of
# whatever XDG_RUNTIME_DIR names, so pointing it at /run/user/<uid> would have
# stopping the desktop delete the runtime directory out from under an ssh login
# by the same account. A directory of its own costs nothing and cannot do that.
Environment=XDG_RUNTIME_DIR=%t/hdw4s/session/%i
# Put the application wrappers ahead of the real binaries. They are what
# redirects programs that ignore the XDG variables, Firefox above all.
Environment=PATH=/usr/lib/hdw4s/wrappers:/usr/local/bin:/usr/bin:/bin
EnvironmentFile=-/etc/hdw4s/hdw4s.conf
EnvironmentFile=-/etc/hdw4s/%i.conf
# PrivateTmp= gives this unit an empty /tmp, and systemd-tmpfiles only
# populates the host's, so the socket directory has to be created in
# here. ExecStartPre runs inside the namespace, so this is the private
# one and no other session can see it.
# The gated web client this session is served from, built before the session can
# start. "+" is load-bearing and is NOT a convenience: the build writes under
# /usr, which ProtectSystem=strict makes read-only for everything else in this
# unit, and it must run as root because a tree the occupant can write is a tree
# the occupant can un-gate.
#
# Rebuilt at every start rather than once when the account was enabled, because
# the tree embeds the packaged client: after an upgrade a session provisioned
# once would serve the previous release's bytes, gated but stale, with nothing
# saying so. It costs about a fifth of a second.
#
# If this fails the session does not start, which is deliberate. Selkies' own
# answer to a missing web root is one warning and the stock ungated client --
# healthy in every check this product has, with the gate silently absent.
ExecStartPre=+/usr/lib/hdw4s/hdw4s-webroot provision %i
# AND THEN CHECKED, which this unit did not do and the ephemeral one always has.
#
# It asserts three things about the tree provision just built: that it carries the
# gate marker and no auto-loading module, that every asset its index names is
# present, and that the identity published for THIS start is the one
# hdw4s-incarnation recorded and is not the previous start's.
#
# The comment at the head of this unit says why the third of those matters here
# and not only in the pool: MEASURED 2026-09-25 on the owner's own named desktop,
# a hidden tab that comes back meets the reconnect card every time because
# /hdw4s-incarnation 404s. A named desktop now publishes one -- so it can now be
# checked, and until this line existed nothing checked it.
#
# "!" and NOT "+": "+" drops ProtectHome= while KEEPING BindPaths= and
# TemporaryFileSystem=, so a drop-in's /home mount lands on the REAL /home. The
# ExecStartPost below says what that costs. What this needs is root -- the /run
# record is 0600 root-owned so the occupant cannot forge it -- with the
# namespace intact, and "!" is exactly that.
ExecStartPre=!/usr/lib/hdw4s/hdw4s-webroot gate %i
ExecStartPre=/usr/bin/install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix
ExecStart=/usr/lib/hdw4s/hdw4s-session %i
# THE FAILURE LEDGER'S WRITER: one line per run that ended without success, read
# by the session's own check before its next start (see hdw4s-ledger). It takes
# only what systemd hands it -- $SERVICE_RESULT, $EXIT_CODE, $EXIT_STATUS -- and
# never a file the session can write.
#
# "!" and NOT "+", for the reason the gate lines above give, and one more: "+"
# keeps TemporaryFileSystem=, so a write meant for the host's /run could land in
# a namespace and the ledger would never latch -- failing OPEN, silently. "!" is
# root in this namespace, which sees the host's /run/hdw4s/ledger (a writable
# mount here, as all of /run is: see ReadWritePaths= below).
#
# "-": a ledger that cannot be written must never turn a clean end into a
# failure. The writer says so at error priority instead.
#
# NOT IN hdw4s-ephemeral@.service, deliberately: a pool slot is reused, and one
# visitor's crashes must not refuse the next visitor.
ExecStopPost=-!/usr/lib/hdw4s/hdw4s-ledger record %i

# WHICH WEB ROOT THE STREAMING SERVER ACCEPTED, read from what the server itself
# announced at startup. It decides at startup whether to use the configured web root,
# and if it declines it logs one warning and serves the stock ungated client -- after
# which this session comes up, notifies ready, and every health check reports health
# while the gate is simply absent. Failing here stops the session, which is the point.
#
# THIS WAS AN HTTP FETCH OF THE SESSION'S OWN FRONT DOOR UNTIL 2026-09-26, and every
# reason the old comment here gave has gone with it. It needed a credential on any
# instance with basic auth and could not get one in this position -- see the
# CapabilityBoundingSet= note above, and hdw4s-webroot for the measurement -- which
# tore a HEALTHY desktop down 55 times in an hour. The owner ruled that reading the
# server's own decision is fine, to be revisited if it stops being trustworthy.
#
# Two things about the new shape are worth keeping straight:
#
# "!" and still NOT nothing, but for a DIFFERENT reason than before. The old reason was
# the firewall's sessions_out chain, which refuses a desktop opening a connection to a
# session port; there is no connection now. The reason now is that this reads the unit's
# own journal, and the occupant's uid is in no group that may.
#
# "!" and NOT "+", unchanged: "+" keeps BindPaths= and TemporaryFileSystem= while
# dropping ProtectHome=, which lands this unit's /home/user mount on the real /home --
# fatal on an NFS home and a silent stray directory on a local one.
#
# It does not depend on running in any particular position. It needs no credential, and
# systemd puts INVOCATION_ID in the environment of every Exec line, so it can name THIS
# start rather than reading a journal that a restart loop has interleaved. It waits for
# the announcement and reports the expiry as a failure that says WHICH thing it could not
# establish -- never as a pass.
ExecStartPost=!/usr/lib/hdw4s/hdw4s-webroot announced-gate %i
KillMode=control-group
LockPersonality=yes
# Readiness is reported once the stream is accepting connections, so that
# "systemctl start" blocks until the desktop can actually be reached. The
# notification comes from a helper rather than the main process, which is why
# NotifyAccess has to be "all".
NotifyAccess=all
OOMPolicy=continue
PrivateDevices=yes
# Gives this session its own /tmp, so the X11 socket and lock file cannot
# collide with another account's desktop on this machine and there is nothing
# left to clean up when the unit stops, however it stops.
PrivateTmp=yes
# ITS OWN /run/lock, a tmpfs that dies with the session. The machine's /run/lock
# is one directory every session and the host share, writable by all (1777):
# measured on a development box from inside a pool seat, a file planted there was
# visible on the host and so to every later occupant of every seat -- state that
# outlives the session, which this design assumes cannot happen. Not read-only:
# what uses it is the old lock-file convention for serial lines (lockdev and its
# descendants, e.g. an Arduino IDE probing /var/lock -> /run/lock), and such a
# program may refuse to run where it cannot write a lock; with PrivateDevices=
# there is no serial line in here to coordinate over, so a private lock
# directory loses nothing. Measured (systemd 255, a unit with ProtectSystem=
# strict and this line): a file written inside appears on the private tmpfs and
# not on the host's. Nothing else in this unit mounts beneath /run/lock, so the
# ordering of namespace mounts by destination has nothing to reorder; and no
# "+" command here uses /run/lock (the web root's build lock is beside the web
# root), so that "+" keeps this mount changes nothing for them.
TemporaryFileSystem=/run/lock:mode=1777,nosuid,nodev,noexec,size=1M
ProtectClock=yes
ProtectControlGroups=yes
# The session IS the home directory; it cannot be hidden or made read-only.
ProtectHome=no
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
# Stops one session from seeing another session's processes, which matters on a
# machine that hosts desktops for several people.
ProtectProc=invisible
ProtectSystem=strict
# The session's own home is added by "hdw4s enable", which is the only
# point at which the account -- and so its home directory -- is known. A
# unit cannot name it: there is no specifier for the home of the account in
# User=, and %h is the manager's home, which here is /root.
ReadWritePaths=/var/lib/hdw4s
# /run IS NOT READ-ONLY HERE. ProtectSystem=strict leaves /run writable --
# measured inside a running desktop of each kind, 2026-10-04: /run is a
# read-write mount in the session's namespace -- so what keeps the occupant out
# of root's entries under /run is their PERMISSIONS, not a mount. This line is a
# no-op today, kept so that a later read-only /run (filed, not done) does not
# take away the one directory this session must create in. It names the
# session's stream directory, where <instance> is root's and 0711 and only "s"
# beneath it is the session's own. No "-": hdw4s-stream@ has made it by now, and
# a session that cannot listen should fail naming the path.
ReadWritePaths=/run/hdw4s/stream/%i
# The failure ledger, for its root writer above. Like the line above it, a no-op
# while /run is writable here, and kept for a later read-only /run. It grants the
# occupant nothing either way: the directory is root's 0711 (tmpfiles) and each
# file root's 0644, so the session can read a record by name, list none and
# write none -- permissions, which hold today. "-" because a missing directory
# must not stop a desktop starting; the writer reports it.
ReadWritePaths=-/run/hdw4s/ledger
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes
# A soak of fifty browser reconnects against one session left the streaming
# server holding 645 descriptors, from 14 at the start: roughly thirteen per
# reconnect that are never returned, mostly /proc handles and eventfds belonging
# to monitor threads it starts again each time. The default soft limit is 1024,
# so a long-lived session that has been reconnected to often enough runs out and
# starts failing in ways that look like anything but a descriptor limit.
#
# Raising the soft limit is a mitigation, not a fix; the accumulation is in the
# streaming server and is not ours to repair on this line. The hard limit was
# already 524288, so this only stops the process tripping over a default that
# was never chosen for it.
LimitNOFILE=65536

# A failure is restarted; a logout is not one (hdw4s-run-session exits 0 for it),
# so a desktop its owner logged out of stays down until the next visit starts it.
Restart=on-failure
RestartSec=5
# 75 is the session refusing to start because hdw4s-ledger says this desktop
# keeps failing. Restarting that would be the loop the refusal exists to stop.
# The check is advisory to the occupant's own uid -- an owner can defeat their
# own refusal, and the start limit above still holds -- so it needs, and must be
# given, no capability.
RestartPreventExitStatus=75
RuntimeDirectory=hdw4s/session/%i
RuntimeDirectoryMode=0700
Slice=hdw4s-%i.slice
StateDirectory=hdw4s/%i
StateDirectoryMode=0700
TimeoutStartSec=120
Type=notify
UMask=0077
WorkingDirectory=~

# Deliberately NOT set, because each of these breaks a working desktop:
#
#   NoNewPrivileges=yes       sudo, pkexec, fusermount3 and chrome-sandbox are
#                             all setuid, and with unprivileged user namespaces
#                             restricted by default on current Ubuntu, Chrome
#                             depends on its setuid helper to start at all.
#   RestrictNamespaces=yes    breaks Chrome and Electron's sandbox, flatpak,
#                             bubblewrap and snap.
#   SystemCallFilter=...      the @system-service set excludes @mount, which
#                             gvfs and flatpak need, and @privileged, which
#                             sudo needs from a terminal in the session.
#   MemoryDenyWriteExecute=   gnome-shell is JavaScript; denying writable
#                             executable memory stops its engine from starting.
#   PrivateUsers=yes          maps every other account to "nobody", which ruins
#                             group-shared files and is worse over NFS.
#   PAMName=<stack>           would give the session a logind session, and does
#                             create one. It breaks this unit in two separate
#                             ways, both measured rather than guessed.
#
#                             pam_systemd sets XDG_RUNTIME_DIR to
#                             /run/user/<uid>, overriding the per-instance
#                             directory set above -- and RuntimeDirectory=
#                             below makes systemd the owner of whatever that
#                             names, so stopping the desktop would delete the
#                             runtime directory of any ssh login the same
#                             account has open at the time, taking that
#                             person's dbus session and gvfs mounts with it.
#
#                             And logind moves the session's processes into a
#                             session-NN.scope of its own, out of this unit's
#                             cgroup, so KillMode=control-group reaps nothing:
#                             stopping the unit left a full desktop running and
#                             the logind session stuck in "closing" forever. A
#                             short experiment accumulated twenty of them.
#
#                             None of this is needed for sudo, which works the
#                             ordinary way -- see CapabilityBoundingSet= above.

# Deliberately no [Install] section. A session is not started at boot and is
# not enabled directly: "hdw4s enable" enables hdw4s-proxy@<instance>.socket,
# and the first connection to it starts the desktop. A desktop nobody has
# connected to therefore never exists, rather than being started at boot and
# reaped later for having been idle since.
