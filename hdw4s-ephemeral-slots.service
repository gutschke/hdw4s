[Unit]
Description=Mint the hdw4s ephemeral slot identities
Documentation=man:hdw4s(8)
# The records must exist before anything can start a session as one of these
# accounts. systemd resolves User= when it starts a unit, and a socket-activated
# session unit whose User= does not resolve fails with 217/USER -- measured --
# which reads as a broken service rather than a missing account. Ordering this
# ahead of the sockets is what keeps that from being anybody's 2 a.m. puzzle.
DefaultDependencies=no
After=local-fs.target
Before=sockets.target shutdown.target
Conflicts=shutdown.target
# /run is tmpfs, so the records are gone at every boot and this is what puts
# them back.
#
# RefuseManualStop is load-bearing, not tidiness. hdw4s-ephemeral@.service has
# Requires= on this unit, and Requires= propagates a stop: "systemctl stop
# hdw4s-ephemeral-slots" would take down every live ephemeral desktop on the
# machine, which is not what anybody typing it expects from a unit that only
# writes some records. An earlier version of this comment said there was
# nothing to clean up on the way down, which is true and beside the point.
#
# The consequence is that the minter cannot be restarted either -- restart is
# stop plus start -- so a package upgrade cannot refresh what it writes through
# systemd at all. debian/postinst runs the script directly instead; see the
# paragraph there.
RefuseManualStop=yes

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/lib/hdw4s/hdw4s-ephemeral-slots

[Install]
WantedBy=sysinit.target
