"""Start Selkies with WebRTC signalling carried over the stream's unix socket.

Run as "/opt/selkies/bin/python /usr/lib/hdw4s/hdw4s-selkies-webrtc <selkies args>"
by hdw4s-run-session, and ONLY for a session with HDW4S_WEBRTC=yes (the default).
A session set to "no" runs upstream's own entry point with nothing of ours in
between.

WHY THIS EXISTS. A session's streaming server listens on a unix socket
(--unix-socket; hdw4s-stream-dir says why never a port). Selkies' WebRTC mode then
reaches its own signalling endpoint as a CLIENT, and that client ignores the unix
socket: webrtc_mode.WebRTCService.create_signaling_client builds
"ws://localhost:<port>/api/ws" and webrtc_signaling_client.connect_and_listen opens
it with a plain aiohttp.ClientSession -- TCP. It sends, on that connection, the
session's Basic credential (when the session has one) and the server's master
token in its HELLO. Nothing of ours listens on that port, so the first process on
the machine to bind it -- another desktop's occupant among them -- would be the
signalling server this desktop trusts. Read in Selkies 2.0.0rc1, 2.0.0 and a later dev
build; the connection is measured by .github/live and the box tier, not assumed.

WHAT IT DOES. Before handing over to upstream's main(), it replaces the aiohttp
that the signalling client module sees with one whose ClientSession connects
through the stream's unix socket (aiohttp.UnixConnector). The URL is untouched:
over a UnixConnector host and port name nothing, so there is no TCP connection at
all and no port to squat.

THREE OUTCOMES, per the project's rule for changes it would offer upstream:
  * upstream grows the support (WebRTCSignalingClient.SUPPORTS_UNIX_SOCKET): stand
    down and run stock. SAFE ONLY IF upstream's support switches on by itself
    whenever --unix-socket is given -- a marker for support that must be enabled
    separately would stand this down onto the TCP path. That condition is part of
    what we offer upstream, not an assumption to make about what they merge;
  * the code is still the code this was written against: apply;
  * anything else: DEGRADE, loudly, to a desktop on websockets alone. Running stock
    WITH WebRTC is not a safe degradation -- it is the squattable TCP connection
    with the token on it -- so the WebRTC half is taken away rather than left to
    upstream: dual mode is relocked off and the start mode pinned to websockets,
    which is exactly what HDW4S_WEBRTC=no asks for. Nothing then ever creates the
    signalling client this adapter exists to reroute.

WHY DEGRADE AND NOT REFUSE. This used to refuse to start the session, which was
right while WebRTC was an opt-in: the administrator who set it would read why.
Once "yes" is the default, refusing means every desktop on every machine stops
starting at the next streaming server version raise, for the sake of a transport
nobody is using until they ask for it. A websockets-only desktop is the
configuration every session ran for most of this package's life; losing the
optional transport is the proportionate cost. What is NOT given up is being told:
the reason goes to the session journal on every start, and into the session's
runtime directory, where "hdw4s check" reads it and fails.

WHY THE REWRITE CAN BE TRUSTED. The arguments are hdw4s-run-session's own, every
spelling of the two settings that could reach WebRTC is removed rather than
matched exactly, the replacement is appended last, and the SELKIES_ environment
spellings are dropped, which the server ranks below the command line anyway. The
TURN pin (turn host, random secret, ice-lite, rtc-config path) stays on the
command line untouched, so it would still hold if anything did reach WebRTC.
"""

import sys

MARKER = "SUPPORTS_UNIX_SOCKET"

# THE WHOLE MODULE, not only the two functions: a second ClientSession, or one
# reached by another name ("from aiohttp import ClientSession", "import aiohttp
# as ..."), anywhere in the signalling client would open a connection this
# replacement never sees. 2.0.0rc1, 2.0.0 and the dev build all name it exactly twice:
# the attribute's annotation and the one call.
EXPECTED_CLIENTSESSION = 2
ALLOWED_FROM_AIOHTTP = {"ClientWebSocketResponse", "WSMsgType"}


def module_source_problem(src):
    """Why the signalling client's module is not the code this adapts, or None."""
    n = src.count("ClientSession")
    if n != EXPECTED_CLIENTSESSION:
        return "it names ClientSession %d time(s), not %d" % (n, EXPECTED_CLIENTSESSION)
    if src.count("aiohttp.ClientSession()") != 1:
        return "it does not open exactly one aiohttp.ClientSession()"
    for other in ("import aiohttp as", "from aiohttp."):
        if other in src:
            return "it reaches aiohttp another way (%r)" % other
    # Names imported directly from aiohttp are WHITELISTED: the two the installed
    # module takes, neither of which opens a connection. Anything else -- a
    # session, a connector, a request helper -- could reach the network by a
    # route this replacement does not cover.
    for line in src.splitlines():
        line = line.strip()
        if line.startswith("from aiohttp import"):
            names = {n.strip().split(" as ")[0] for n in
                     line[len("from aiohttp import"):].strip(" ()").split(",") if n.strip()}
            extra = names - ALLOWED_FROM_AIOHTTP
            if extra:
                return "it imports %s from aiohttp directly" % ", ".join(sorted(extra))
    return None


class NotAdaptable(Exception):
    """The installed streaming server is not the code this adapts."""


def refuse(why):
    raise NotAdaptable(why)


# The two settings through which a session can come to serve WebRTC: the mode it
# starts in, and whether a client may switch it later. Upstream's defaults are
# "websockets" and TRUE, so leaving either unsaid is not the same as saying no.
DEGRADED = ["--enable-dual-mode=false|locked", "--mode=websockets"]
DEGRADED_NAMES = ("enable_dual_mode", "mode")


def websockets_only(argv):
    """argv with every way of asking for WebRTC replaced by a refusal of it.

    WHAT MAKES IT HOLD is that the refusal is APPENDED: the server parses with
    argparse, where the last occurrence of a setting wins, so ours decides
    whatever came before it -- an abbreviation argparse would also accept
    included. Removing the earlier copies is so that the command line says one
    thing; it is not what the guarantee rests on.

    Removal still has to be careful, because a bool flag given bare means
    "true" and does NOT consume the next token: "--enable-dual-mode
    --webrtc-ice-lite=true|locked" is two settings, and eating the second would
    drop a pin. So a following token is taken as the value only when it is not
    itself a flag. Everything else, the TURN pin included, passes unchanged.
    """
    out = []
    i = 0
    while i < len(argv):
        a = argv[i]
        i += 1
        if a.startswith("--"):
            name = a[2:].split("=", 1)[0].replace("-", "_")
            if name in DEGRADED_NAMES:
                if "=" not in a and i < len(argv) and not argv[i].startswith("-"):
                    i += 1
                continue
        out.append(a)
    return out + DEGRADED


def degrade(why, environ, marker_dir):
    """Say why WebRTC is off for this session, as loudly as a session can."""
    msg = ("hdw4s-selkies-webrtc: WEBRTC IS OFF FOR THIS SESSION. %s, so "
           "WebRTC signalling cannot be kept off TCP. The desktop starts on "
           "websockets alone with the transport switch locked off. Update hdw4s, "
           "or set HDW4S_WEBRTC=no to silence this." % why)
    print(msg, file=sys.stderr)
    for k in ("SELKIES_ENABLE_DUAL_MODE", "SELKIES_MODE"):
        environ.pop(k, None)
    if marker_dir:
        try:
            with open(marker_dir + "/" + MARKER_FILE, "w") as fh:
                fh.write(why + "\n")
        except OSError as e:
            print("hdw4s-selkies-webrtc: could not record this for 'hdw4s check' "
                  "(%s); the journal line above is the only record." % e,
                  file=sys.stderr)


# In the session's runtime directory, which systemd creates empty for each start
# and removes at the end of it, so a stale copy cannot outlive the session that
# wrote it. "hdw4s check" reads it under the same name.
MARKER_FILE = "webrtc-degraded"


def unix_socket_from_argv(argv):
    for i, a in enumerate(argv):
        if a.startswith("--unix-socket="):
            return a.split("=", 1)[1]
        if a == "--unix-socket" and i + 1 < len(argv):
            return argv[i + 1]
    return ""


def adapt(path):
    import inspect
    import types
    import aiohttp
    from selkies import webrtc_signaling_client as sc
    from selkies import webrtc_mode as wm

    if getattr(sc.WebRTCSignalingClient, MARKER, False):
        return "upstream carries unix-socket signalling; standing down"

    try:
        why = module_source_problem(inspect.getsource(sc))
    except (OSError, TypeError) as e:
        refuse("cannot read the signalling client module (%s)" % e)
    if why:
        refuse("Selkies' signalling client module is not the code this adapts: " + why)
    try:
        client_src = inspect.getsource(sc.WebRTCSignalingClient.connect_and_listen)
        make_src = inspect.getsource(wm.WebRTCService.create_signaling_client)
    except (AttributeError, OSError, TypeError) as e:
        refuse("cannot read the signalling code this adapts (%s)" % e)
    # The anchors: the client opens exactly one plain session through the module's
    # own "aiohttp" name, and the URL it is given is the loopback one. If either
    # has moved, this adapter no longer knows what it would be changing.
    if client_src.count("aiohttp.ClientSession()") != 1 or "ws_connect(" not in client_src:
        refuse("Selkies' signalling client is not the code this adapts")
    if "localhost:{self.args.port}" not in make_src:
        refuse("Selkies' signalling URL is not the one this adapts")
    if getattr(sc, "aiohttp", None) is not aiohttp:
        refuse("the signalling client does not reach aiohttp by that name")

    def unix_session(*args, **kwargs):
        if "connector" in kwargs:
            raise RuntimeError("hdw4s-selkies-webrtc: the signalling client now "
                               "chooses its own connector; not overriding it")
        kwargs["connector"] = aiohttp.UnixConnector(path=path)
        return aiohttp.ClientSession(*args, **kwargs)

    # A namespace that is aiohttp in every respect but one. Only the signalling
    # client module is given it; every other caller keeps the real module.
    shim = types.SimpleNamespace(**{k: getattr(aiohttp, k) for k in dir(aiohttp)
                                    if not k.startswith("__")})
    shim.ClientSession = unix_session
    sc.aiohttp = shim
    return "WebRTC signalling goes through %s" % path


def main():
    import os
    args = sys.argv[1:]
    marker_dir = os.environ.get("XDG_RUNTIME_DIR", "")
    try:
        path = unix_socket_from_argv(args)
        if not path:
            refuse("no --unix-socket was given")
        print("hdw4s-selkies-webrtc: %s" % adapt(path), file=sys.stderr)
    # ANY failure, not only the ones named above: an import that no longer
    # exists, an attribute that moved. adapt() changes nothing until its last
    # line, so whatever was raised before it, nothing has been rerouted and the
    # only safe thing left is not to serve WebRTC at all.
    except Exception as e:  # noqa: BLE001 -- every failure degrades the same way
        why = str(e) if isinstance(e, NotAdaptable) else \
            "the adapter failed (%s: %s)" % (type(e).__name__, e)
        degrade(why, os.environ, marker_dir)
        args = websockets_only(args)
    else:
        # A previous run of the server in this same session may have degraded.
        if marker_dir:
            try:
                os.unlink(marker_dir + "/" + MARKER_FILE)
            except OSError:
                pass
    sys.argv[1:] = args
    sys.argv[0] = "selkies"
    from selkies.__main__ import main as selkies_main
    sys.exit(selkies_main())


if __name__ == "__main__":
    main()
