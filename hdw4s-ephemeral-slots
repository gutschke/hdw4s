#!/bin/bash -e
# Mint the pool of ephemeral slot identities, once, before anything can start a
# session as one of them.
#
# Why a fixed pool rather than an identity per session. The session unit is
# socket-activated, and systemd resolves User= when it starts the unit -- before
# any ExecStartPre= of ours could run. A record written by the unit itself is
# therefore written too late: measured, such a unit fails with 217/USER, and a
# failure at that point reads as "the service is broken" rather than "the account
# does not exist yet". So the records exist before the sockets do, and this runs
# ordered ahead of them.
#
# The uid is consequently REUSED by successive sessions in the same slot. That is
# only safe because nothing owned by it outlives a session: the home and the
# profile are tmpfs under the unit's RuntimeDirectory, RemoveIPC=yes clears
# shared memory and semaphores, PrivateTmp= clears /tmp, and StateDirectory= is
# absent. Each of those was measured rather than assumed; if any is ever dropped,
# the reuse stops being harmless.
#
# TWO KINDS OF SLOT ARE MINTED HERE, and they are minted from different
# authorities, which is worth knowing before reading anything below:
#
#   the pool        _hdw4s_0.._hdw4s_N-1, from the ENVIRONMENT
#                   (HDW4S_EPHEMERAL_SLOTS), uids counting UP from
#                   HDW4S_EPHEMERAL_UID_BASE. A collision here stops the boot.
#   template rows   named in the SLOT TABLE and typed "template" -- the
#                   administrator's authoring seat, which is not pool capacity
#                   and is never handed to a visitor. Uids count DOWN from
#                   UID_MAX. A failure here warns and leaves the pool alone.
#
# "--template NAME" mints exactly one of the second kind and is what "hdw4s"
# calls when "hdw4s template edit" provisions its authoring slot, so that a
# freshly provisioned slot works without waiting for a reboot. "--seat NAME"
# mints one seat of the first kind, for "hdw4s pool size" growing the pool
# without a reboot; it reads the size from the configuration like the boot run
# does, so it can only mint a seat the next boot will mint too. The five
# artefacts a slot needs have ONE implementation, shared by both callers; see
# the note above the loop.
#
# The records live in /run/userdb, which nss-systemd reads directly -- no
# systemd-userdbd needed. /run is tmpfs, so they never touch disk and are minted
# fresh at every boot, which is the property this feature wants anyway.
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

# shellcheck disable=SC2154  # rc is assigned in the trap body below; the other
# scripts here escape this warning only because they happen to use `rc` elsewhere.
trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

ETCDIR="${HDW4S_ETCDIR:-/etc/hdw4s}"
USERDB="${HDW4S_USERDB_DIR:-/run/userdb}"
# Derived per-boot state, so /run rather than /etc -- and all of it under ONE
# directory, which every path below is derived from. Each session's own runtime
# directory is "session/<instance>" beneath it (systemd's RuntimeDirectory=), and
# everything made here is a sibling of "session", never of the sessions: their
# names are account names, and an account called "proxy" would otherwise be a
# directory root depends on.
RUNDIR="${HDW4S_RUNDIR:-/run/hdw4s}"
NSDIR="${HDW4S_NS_DIR:-${RUNDIR}/ns}"
PROFILEDIR="${HDW4S_PROFILE_ROOT:-${RUNDIR}/profile}"
DROPDIR="${HDW4S_DROPIN_DIR:-/run/systemd/system}"
# The two directories the session unit hides with InaccessiblePaths=. They are named
# here, and not only where each is otherwise used, because InaccessiblePaths= without
# a "-" prefix is FATAL when the path is absent: the session dies 226/NAMESPACE naming
# a directory, which points at neither the unit nor whatever was supposed to create it.
#
# They belong to this script for the same reason USERDB does -- it is the one thing
# ordered early enough that nothing can run before it. See the install -d below.
PROXYDIR="${HDW4S_PROXY_RUNDIR:-${RUNDIR}/proxy}"
# Where a visitor's request to end their own desktop is recorded. Created here
# for the same reason PROXYDIR is: nothing else creates it, and a path unit
# watching a directory that does not exist reports active and can never fire.
TEARDOWNDIR="${HDW4S_TEARDOWN_DIR:-${RUNDIR}/teardown}"
STARTDIR="${HDW4S_START_DIR:-${RUNDIR}/start}"
INVITEDIR="${HDW4S_INVITE_DIR:-${RUNDIR}/invite}"
INCARNDIR="${HDW4S_INCARNATION_DIR:-${RUNDIR}/incarnation}"
# Where each session's streaming server listens: one directory per instance,
# prepared at every session start by hdw4s-stream-dir. Named here because it is
# machine-wide and must exist before any session can start, for NAMED sessions
# as much as for the pool -- see the install -d below.
STREAMDIR="${HDW4S_STREAM_DIR:-${RUNDIR}/stream}"
RELAY_GROUP='hdw4s-relay'
# shellcheck source=/dev/null
[ ! -r "${ETCDIR}/hdw4s.conf" ] || . "${ETCDIR}/hdw4s.conf"

: "${HDW4S_EPHEMERAL_SLOTS:=1}"
: "${HDW4S_EPHEMERAL_UID_BASE:=60900}"
: "${HDW4S_EPHEMERAL_HOME_SIZE:=1G}"
: "${HDW4S_EPHEMERAL_PROFILE_SIZE:=2G}"
: "${HDW4S_EPHEMERAL_SHM_SIZE:=512M}"
# What an ephemeral session's desktop background is. Three forms, and the
# default is the third:
#
#   #RRGGBB        a flat colour
#   /path/to/file  an image of the administrator's choosing
#   generated      a field generated per session, so that two desktops on one
#                  machine are not pixel-for-pixel identical
#
# GENERATED IS THE DEFAULT BECAUSE THE FLAT COLOUR MADE TWO DESKTOPS
# INDISTINGUISHABLE. Every ephemeral session read this same database, so the
# perceptual distance between any two live desktops was exactly zero and the
# only thing that differed was the browser's address bar -- which a screenshot
# reader resolved one time in four. A field costs nothing at rest and is the
# one cue a visitor with two tabs open does not have to read.
#
# The flat colour is still here and still Canonical aubergine when it is asked
# for. On brand without being the desktop's own colour: Yaru paints orange
# (#e95420, in 22 files on a stock install) and the aubergines appear in none
# of them, so it reads as part of the family while still not looking like an
# ordinary desktop -- which is the whole job of a cue.
: "${HDW4S_EPHEMERAL_BACKGROUND:=generated}"

# Where the generated field is written, INSIDE the session, and the one place
# this path is spelled. The value in the dconf database is a constant string,
# identical for every slot, because HOME is /home/user in every slot and each
# session has its own mount namespace: the same URI resolves to a different
# file in each of them. That is what buys no per-slot dconf database and no
# per-session "dconf update" -- which recompiles EVERY database on the machine.
BACKGROUND_FILE='/home/user/.hdw4s/background.svg'

# The window these identities may occupy. Nothing outside it is ever written, and
# nothing inside it is expected to exist in /etc/passwd: a collision means the
# machine is not what this feature assumes, and guessing past it would hand a
# session somebody else's uid.
UID_MIN=60900
UID_MAX=60999

die() { echo "hdw4s-ephemeral-slots: $*" >&2; exit 1; }

# Which uids are slots, for the one other program that has to know: the firewall
# refuses the machine's CUPS to these uids (hdw4s-firewall, chain slots_out). Asked
# here rather than copied there, so the window has exactly one home.
if [ "${1:-}" = '--uid-window' ]; then
  echo "${UID_MIN} ${UID_MAX}"
  exit 0
fi

# THE ROOT NAMESPACE'S /shared. Desktops bind /run/hdw4s/shared there; in the
# root namespace it is a bind of that same PLAIN directory, made read-only and a
# SLAVE of /run, so that the table the expose service binds onto
# /run/hdw4s/shared arrives at /shared too, and leaves with it. Root then finds
# the table where every desktop does, and finds nothing -- and cannot write --
# while no table is shown (measured in a user namespace, every ordering).
#
# THE ONE TRAP IS ORDER. Made while a table is ALREADY bound at
# /run/hdw4s/shared, the bind takes the table itself, and PINS it: it stays in
# root after the expose service took it away -- after a drift, a dead store, a
# withdrawn tmpfs -- and nothing in the guard notices (it accepts a pinned
# view: measured). So this is never a .mount unit or an fstab line (a restart
# of either is a late bind), it is refused while the exposure carries a mount,
# and it is checked after it is made and taken away at once if it is pinned:
# that closes the race against an expose run between the look and the bind.
#
# THE SHAPE IS POSITIVE, derived from /run's OWN line in the mount table, never
# from a stat of /run/hdw4s/shared (which reports the table whenever one is
# bound). The bottom mount at /shared -- the one whose parent is not itself
# at /shared, by parent id, not by position: propagation can tuck a mount
# beneath -- must be on /run's device with /run's root plus "/hdw4s/shared",
# read-only, and a slave of /run's peer group. Everything above it must be a
# copy of something mounted at the exposure. ANYTHING else is wrong, including
# shapes nobody listed: on NFS a pin has root "/", not "/table".
#
# The mark in /var/lib records that this feature made /shared; at the boot that
# turns it off, /run no longer remembers it was on. It goes ONLY when /shared
# did: dropped while the directory stays, every later run reads /shared as the
# administrator's and never touches it again.
#
# NEVER TAKEN AWAY WHILE A DESKTOP RUNS. /shared is the mount point of every
# desktop's BindPaths=, and removing a directory that is a mount point in
# ANOTHER mount namespace succeeds -- and DETACHES the mount there (measured):
# each running desktop silently loses /shared. An upgrade runs this
# live, after HDW4S_SHARED=off was written and before the reboot that was to
# apply it.
#
# ONE IMPLEMENTATION, for the boot run, "hdw4s check" (--shared-view check),
# an administrator (--shared-view release), and debian/prerm and uninstall.sh
# (--shared-view release-for-removal). postrm runs after this
# file is gone, so it cannot; a copy anywhere is how the mark once came to be
# removed before the directory.
SHARED_MARK="${HDW4S_SHARED_MARK:-/var/lib/hdw4s/.shared-mountpoint}"
# What takes /shared away later, when it is kept now: the boot run, unless this
# is the package going (prerm, uninstall.sh), after which nothing runs at boot.
SHARED_LATER='The next boot with HDW4S_SHARED off removes it; or, once they have stopped:'
SHARED_POINT="${HDW4S_SHARED_MOUNTPOINT:-/shared}"
SHARED_EXPOSE="${HDW4S_SHARED_EXPOSE:-${RUNDIR}/shared}"
# What the last run did about the bind: "bound <mount id>", the identity it is
# taken away by, or "declined <reason>". /run, because the bind does not
# survive a boot either.
SHARED_VIEW_STATE="${HDW4S_SHARED_VIEW_STATE:-${RUNDIR}/shared-view}"
MOUNTINFO="${HDW4S_MOUNTINFO:-/proc/self/mountinfo}"

# The desktop instances that are in any state but inactive or failed, one per
# line; empty when none. Non-zero when systemd cannot be asked, which is not
# "none". systemctl puts a bullet before a failed unit even with --plain.
desktops_running() {
  local out
  out="$(systemctl list-units --all --plain --no-legend 'hdw4s@*' 'hdw4s-ephemeral@*' \
         2>/dev/null)" || return 1
  printf '%s\n' "${out}" |
    awk '{ sub(/^[^A-Za-z0-9_]+/, "") }
         NF >= 3 && $3 != "inactive" && $3 != "failed" { print $1 }'
}

# Is anything mounted at this exact path? From the mount table only.
mounted_at() { awk -v p="$1" '$5 == p { f = 1 } END { exit !f }' "${MOUNTINFO}"; }

# THE SHAPE OF /shared, as one line: "<verdict> <bottom mount id or -> <detail>".
#   good       the bind described above
#   none       nothing is mounted at /shared
#   deleted    the bind's source was removed and remade: it shows nothing
#   foreign    the bottom is not /run's /hdw4s/shared: pinned, or not ours
#   rw         the bottom is writable: root's writes land in the plain directory
#   unshared   /run is not a shared mount, so nothing can arrive at /shared
#   not-slave  the bottom sends mounts back to /run instead of only receiving
#   stray      something above the bottom is not a copy of the exposure
#   unknown    the table cannot be read, or a path in it is escaped
view_shape() {
  case "${SHARED_POINT}${SHARED_EXPOSE}" in
    # The table escapes space, tab, newline and backslash; such a path is
    # refused rather than unescaped, as hdw4s-shared-expose does.
    *[[:space:]\\]*) echo 'unknown - a path the mount table would escape'; return;;
  esac
  [ -r "${MOUNTINFO}" ] || { echo "unknown - cannot read ${MOUNTINFO}"; return; }
  awk -v p="${SHARED_POINT}" -v e="${SHARED_EXPOSE}" '
    { j = 7; tags = ""; while (j < NF && $j != "-") { tags = tags " " $j; j++ }
      id[NR] = $1; par[NR] = $2; dev[NR] = $3; root[NR] = $4; mp[NR] = $5
      opts[NR] = $6; tag[NR] = tags " " }
    # The mount on top at a path: the one no other mount at that path sits on.
    function top(m,   n, k, t) {
      t = 0
      for (n = 1; n <= NR; n++) if (mp[n] == m) {
        for (k = 1; k <= NR; k++) if (mp[k] == m && par[k] == id[n]) break
        if (k > NR) t = n }
      return t }
    END {
      # The filesystem the exposure directory itself lives on: the longest
      # mount point above it, not counting whatever is mounted AT it.
      best = ""
      for (n = 1; n <= NR; n++)
        if (mp[n] != e && (mp[n] == "/" || index(e, mp[n] "/") == 1) &&
            length(mp[n]) > length(best)) best = mp[n]
      r = top(best)
      if (!r) { print "unknown - no mount holds " e; exit }
      rel = (best == "/") ? e : substr(e, length(best) + 1)
      want = (root[r] == "/") ? rel : root[r] rel
      grp = ""; if (match(tag[r], / shared:[0-9]+ /)) grp = substr(tag[r], RSTART + 8, RLENGTH - 9)
      cnt = 0
      for (n = 1; n <= NR; n++) if (mp[n] == p) { at[id[n]] = n; cnt++ }
      if (!cnt) { print "none -"; exit }
      b = 0; nb = 0
      for (n = 1; n <= NR; n++) if (mp[n] == p && !(par[n] in at)) { b = n; nb++ }
      if (nb != 1) { print "unknown - " nb " mounts at the bottom of " p; exit }
      if (root[b] ~ /\/\/deleted$/) { print "deleted " id[b] " root " root[b]; exit }
      if (dev[b] != dev[r] || root[b] != want) {
        print "foreign " id[b] " device " dev[b] " root " root[b] ", not " dev[r] " " want; exit }
      if (opts[b] !~ /^ro(,|$)/) { print "rw " id[b] " options " opts[b]; exit }
      if (grp == "") { print "unshared " id[b] " " best " is not a shared mount"; exit }
      if (tag[b] ~ / shared:/ || index(tag[b], " master:" grp " ") == 0) {
        print "not-slave " id[b] " propagation" tag[b] "not master:" grp; exit }
      for (n = 1; n <= NR; n++) if (mp[n] == p && n != b) {
        ok = 0
        for (k = 1; k <= NR; k++) if (mp[k] == e && dev[k] == dev[n] && root[k] == root[n]) ok = 1
        if (!ok) { print "stray " id[n] " device " dev[n] " root " root[n] " is not at " e; exit } }
      print "good " id[b]
    }' "${MOUNTINFO}"
}

say_declined() {
  printf 'declined %s\n' "$1" > "${SHARED_VIEW_STATE}" 2>/dev/null || :
}

# MAKE THE BIND, when it is safe to: /shared is ours, nothing is mounted there,
# the exposure directory exists and carries no mount. Gated on that observable
# state and never on "this is a boot", so a fresh install and an off -> on
# upgrade are the same safe ordering. Never fails: what it declined, it says,
# and "hdw4s check" says it again.
shared_view_bind() {
  local shape made
  if [ ! -e "${SHARED_MARK}" ]; then
    # An administrator's /shared is never touched; "hdw4s check" says that
    # desktops mount the table over it and root does not see the table there.
    { [ -e "${SHARED_POINT}" ] || [ -L "${SHARED_POINT}" ]; } && return 0
    install -d -m 0755 "${SHARED_MARK%/*}"
    : > "${SHARED_MARK}"
  fi
  if [ -L "${SHARED_POINT}" ] || { [ -e "${SHARED_POINT}" ] && [ ! -d "${SHARED_POINT}" ]; }; then
    echo "hdw4s: ${SHARED_POINT} is marked as this feature's but is not a directory; left alone." >&2
    return 0
  fi
  [ -d "${SHARED_POINT}" ] || install -d -m 0755 "${SHARED_POINT}"
  shape="$(view_shape)"
  case "${shape}" in
    good\ *) printf 'bound %s\n' "$(echo "${shape}" | cut -d' ' -f2)" > "${SHARED_VIEW_STATE}" || :
             return 0;;
    none\ *) ;;
    *) echo "hdw4s: something else is at ${SHARED_POINT} (${shape}); it is left alone, and
  root does not see the table there. \"hdw4s check\" reports it." >&2
       say_declined "${shape%% *}"
       return 0;;
  esac
  # Never on a missing source: the bind would fail and leave root's /shared
  # the root filesystem's own directory, writable and not the table.
  if [ ! -d "${SHARED_EXPOSE}" ] || [ -L "${SHARED_EXPOSE}" ]; then
    echo "hdw4s: ${SHARED_EXPOSE} does not exist, so ${SHARED_POINT} is not bound in the root
  namespace. Recreate it: systemd-tmpfiles --create; it is bound at the next boot." >&2
    say_declined 'no-source'
    return 0
  fi
  if mounted_at "${SHARED_EXPOSE}"; then
    echo "hdw4s: a table is already shown at ${SHARED_EXPOSE}, so ${SHARED_POINT} is not bound in
  the root namespace now -- made now, it would keep the table after it is taken
  away. It takes effect at the next boot; desktops are not affected." >&2
    say_declined 'exposed'
    return 0
  fi
  if [ -n "$(ls -A -- "${SHARED_POINT}" 2>/dev/null)" ]; then
    echo "hdw4s: ${SHARED_POINT} is not empty, so it is not bound in the root namespace: the
  bind would hide what is there. Move it away; it is bound at the next boot." >&2
    say_declined 'not-empty'
    return 0
  fi
  # NEVER A PEER OF /run WHILE ATTACHED. A bind of /run/hdw4s/shared made with
  # mount(8) is attached first and made a slave and read-only afterwards, BY
  # PATH; in between it is a peer of /run, and a table bound at the exposure in
  # that instant lands ON it -- after which the remount and the make-slave act
  # on that copy, and unmounting it from /shared propagates back to /run and
  # takes the table off /run/hdw4s/shared itself, from every desktop (measured).
  # So the bind is cloned DETACHED (open_tree), made read-only and a slave
  # while it is attached nowhere (mount_setattr), and only then attached at
  # /shared (move_mount): from its first instant there it receives from /run
  # and sends nothing back. Nothing is attached at all if any step fails.
  if ! python3 - "${SHARED_EXPOSE}" "${SHARED_POINT}" <<'PY'
import ctypes, os, sys
libc = ctypes.CDLL(None, use_errno=True)
libc.syscall.restype = ctypes.c_long
class MountAttr(ctypes.Structure):
    _fields_ = [("attr_set", ctypes.c_uint64), ("attr_clr", ctypes.c_uint64),
                ("propagation", ctypes.c_uint64), ("userns_fd", ctypes.c_uint64)]
# The same numbers on every architecture: the new mount API came after the
# syscall tables were unified.
OPEN_TREE, MOVE_MOUNT, MOUNT_SETATTR = 428, 429, 442
AT_FDCWD, AT_EMPTY_PATH, OPEN_TREE_CLONE = -100, 0x1000, 1
MOVE_MOUNT_F_EMPTY_PATH, MOUNT_ATTR_RDONLY, MS_SLAVE = 0x4, 0x1, 1 << 19
def call(what, *args):
    r = libc.syscall(*args)
    if r < 0:
        e = ctypes.get_errno()
        sys.exit("hdw4s: %s: %s" % (what, os.strerror(e)))
    return r
src, dst = (os.fsencode(a) for a in sys.argv[1:3])
fd = call("open_tree", OPEN_TREE, AT_FDCWD, src, OPEN_TREE_CLONE | os.O_CLOEXEC)
attr = MountAttr(MOUNT_ATTR_RDONLY, 0, MS_SLAVE, 0)
call("mount_setattr", MOUNT_SETATTR, fd, b"", AT_EMPTY_PATH, ctypes.byref(attr), ctypes.sizeof(attr))
call("move_mount", MOVE_MOUNT, fd, b"", AT_FDCWD, dst, MOVE_MOUNT_F_EMPTY_PATH)
# Under a SHARED parent -- / on a stock systemd host and in LXC -- attaching
# makes the mount shared again, in a new peer group of its own, still a slave
# of /run: never a peer of /run, but sending to its own group. Made a slave
# again THROUGH THE SAME FD, so it is this mount that changes, never whatever
# a race may have stacked on top of it at the path. Measured: it then ends
# master of /run's group only. Without this the shape check rejects it and the
# bind is never made on any real machine.
again = MountAttr(0, 0, MS_SLAVE, 0)
call("mount_setattr", MOUNT_SETATTR, fd, b"", AT_EMPTY_PATH, ctypes.byref(again), ctypes.sizeof(again))
PY
  then
    echo "hdw4s: could not bind ${SHARED_EXPOSE} at ${SHARED_POINT}; root does not see the table there." >&2
    say_declined 'mount-failed'
    return 0
  fi
  # Nothing was mounted at /shared a moment ago, so the bottom is this bind.
  shape="$(view_shape)"
  made="$(echo "${shape}" | cut -d' ' -f2)"
  case "${shape}" in
    good\ *)
      # A table shown at the exposure that has no copy here arrived before the
      # clone and after the look: root would see an empty /shared beside a
      # shown table until it is next bound. Taken away, and left for the next
      # boot, as when it was shown before the look.
      if ! mounted_at "${SHARED_EXPOSE}" ||
         [ "$(awk -v p="${SHARED_POINT}" '$5 == p { n++ } END { print n + 0 }' "${MOUNTINFO}")" -gt 1 ]; then
        printf 'bound %s\n' "${made}" > "${SHARED_VIEW_STATE}" || :; return 0
      fi
      shape="behind ${made} a table was shown at ${SHARED_EXPOSE} before the bind, and none arrived on it";;
  esac
  # WRONG, OR PINNED: taken away again -- only when the one mount at /shared is
  # the one this run attached. Its parent is the root filesystem and it is a
  # slave, so unmounting it reaches nothing of /run's. Anything stacked on it
  # is left, and said.
  if [ "$(awk -v p="${SHARED_POINT}" '$5 == p { n++ } END { print n + 0 }' "${MOUNTINFO}")" -eq 1 ] &&
     awk -v p="${SHARED_POINT}" -v m="${made}" '$5 == p && $1 == m { f = 1 } END { exit !f }' "${MOUNTINFO}" &&
     umount -- "${SHARED_POINT}" 2>/dev/null && ! mounted_at "${SHARED_POINT}"; then
    echo "hdw4s: the bind of ${SHARED_POINT} came out wrong (${shape}) and was taken away
  again; root does not see the table there until the next boot." >&2
  else
    echo "hdw4s: the bind of ${SHARED_POINT} came out wrong (${shape}) and could NOT be taken
  away: what is mounted there now is $(view_shape). Root may see, or write into,
  something that is not the table; \"hdw4s check\" is red until a reboot." >&2
  fi
  if mounted_at "${SHARED_EXPOSE}"; then say_declined 'exposed'; else say_declined "${shape%% *}"; fi
  return 0
}

# Take /shared away if this feature made it and nothing holds it. Says what it
# kept and why; non-zero when it kept anything, so a caller can tell.
shared_release() {
  local busy shape rec
  [ -e "${SHARED_MARK}" ] || return 0
  if ! busy="$(desktops_running)"; then
    echo "hdw4s: could not ask systemd which desktops are running, so ${SHARED_POINT} and
  its mark (${SHARED_MARK}) are kept: removing it under a running desktop takes
  /shared away from that desktop." >&2
    return 1
  fi
  if [ -n "${busy}" ]; then
    echo "hdw4s: ${SHARED_POINT} is kept, with its mark, while these desktops are running:
$(printf '%s\n' "${busy}" | sed 's/^/    /')
  Removing it now would take /shared away from each of them. ${SHARED_LATER}
    umount ${SHARED_POINT}; rmdir ${SHARED_POINT} && rm ${SHARED_MARK}" >&2
    return 1
  fi
  # The bind, by the identity recorded when it was made AND the shape: never an
  # unmount by path of whatever happens to be there. Not while a table is
  # shown on it: that is the expose service's to take away first.
  shape="$(view_shape)"
  if [ "${shape%% *}" != 'none' ]; then
    rec="$(sed -n 's/^bound \([0-9][0-9]*\)$/\1/p' "${SHARED_VIEW_STATE}" 2>/dev/null || :)"
    if [ "${shape%% *}" != 'good' ] || [ -z "${rec}" ] ||
       [ "$(echo "${shape}" | cut -d' ' -f2)" != "${rec}" ]; then
      echo "hdw4s: ${SHARED_POINT} is kept, with its mark: what is mounted there (${shape})
  is not the bind this feature recorded making${rec:+ (mount ${rec})}." >&2
      return 1
    fi
    if [ "$(awk -v p="${SHARED_POINT}" '$5 == p { n++ } END { print n + 0 }' "${MOUNTINFO}")" -ne 1 ]; then
      echo "hdw4s: ${SHARED_POINT} is kept, with its mark, while a table is shown on it; it
  goes at the next boot with HDW4S_SHARED off." >&2
      return 1
    fi
    if ! umount -- "${SHARED_POINT}" 2>/dev/null ||
       [ "$(view_shape | cut -d' ' -f1)" != 'none' ]; then
      echo "hdw4s: the bind at ${SHARED_POINT} could not be taken away; it and its mark are kept." >&2
      return 1
    fi
    rm -f -- "${SHARED_VIEW_STATE}"
  fi
  if [ -e "${SHARED_POINT}" ] || [ -L "${SHARED_POINT}" ]; then
    # rmdir, never rm: one that is not empty is somebody's and stays.
    if ! rmdir -- "${SHARED_POINT}" 2>/dev/null; then
      echo "hdw4s: ${SHARED_POINT} could not be removed (it is not an empty directory, or
  something is mounted there), so it and its mark (${SHARED_MARK}) are kept." >&2
      return 1
    fi
  fi
  rm -f -- "${SHARED_MARK}"
}

# FOR "hdw4s check": exit 0 with nothing or an information line, 3 with a
# warning, 1 when it is wrong. Every shape that is not the bind is wrong, the
# ones nobody listed included: the guard accepts a pinned /shared, so this is
# the only thing that would ever notice one.
shared_view_check() {
  local shape why on=''
  case "${HDW4S_SHARED:-off}" in tmpfs|source) on='yes';; esac
  if [ ! -e "${SHARED_MARK}" ]; then
    if [ -n "${on}" ] && { [ -e "${SHARED_POINT}" ] || [ -L "${SHARED_POINT}" ]; }; then
      echo "hdw4s: ${SHARED_POINT} in the root namespace is not this feature's (there is no
  ${SHARED_MARK}), so it is left as it is: desktops see the table there, root
  does not. Use ${SHARED_EXPOSE}."
    elif [ -n "${on}" ]; then
      echo "hdw4s: ${SHARED_POINT} in the root namespace is made at the next boot." >&2
      return 3
    fi
    return 0
  fi
  shape="$(view_shape)"
  case "${shape}" in
    good\ *) [ -n "${on}" ] && return 0
             echo "hdw4s: /shared is off, and ${SHARED_POINT} is still bound in the root namespace;
  it goes at the next boot with no desktop running." >&2
             return 3;;
    none\ *)
             # UNMOUNTED BY HAND. Nothing of this feature unmounts a bind it
             # recorded without removing the record. Every desktop and every
             # namespaced service holds a copy of the bind; unmounted in root
             # while a table was shown, the table copy on each is left behind
             # in those namespaces and no longer leaves with the exposure --
             # and nothing can see it from here (measured).
             if grep -q '^bound ' "${SHARED_VIEW_STATE}" 2>/dev/null; then
               echo "hdw4s: ${SHARED_POINT} in the root namespace was bound and has been unmounted
  by hand. If a table was shown at the time, every desktop and service started
  since the boot may keep a view of it that no longer goes away with the table:
  restart them, or reboot. Never unmount ${SHARED_POINT} by hand; to take it away,
  turn /shared off and reboot." >&2
               return 1
             fi
             [ -n "${on}" ] || return 0
             why="$(sed -n 's/^declined //p' "${SHARED_VIEW_STATE}" 2>/dev/null || :)"
             if [ "${why}" = 'exposed' ]; then
               echo "hdw4s: ${SHARED_POINT} in the root namespace is bound at the next boot (it was turned
  on while a table was already shown); until then root sees an empty directory there." >&2
               return 3
             fi
             echo "hdw4s: /shared is on and ${SHARED_POINT} in the root namespace is not bound to the
  table${why:+ (${why})}: root sees a directory there that is not the table. The
  boot run says why: journalctl -u hdw4s-ephemeral-slots.service" >&2
             return 1;;
    *) echo "hdw4s: ${SHARED_POINT} in the root namespace is not the bind of ${SHARED_EXPOSE}:
  ${shape}
  Root may be seeing, or writing into, something that is not the table. A
  reboot makes it again; until then use ${SHARED_EXPOSE}." >&2
       return 1;;
  esac
}

if [ "${1:-}" = '--shared-view' ]; then
  [ "$#" -eq 2 ] || die "--shared-view takes one of: release, release-for-removal, check."
  case "$2" in
    # "release" by hand: the boot run with /shared off still comes. The
    # package going away says so, because after it nothing runs at boot.
    release) shared_release || :; exit 0;;
    release-for-removal)
             SHARED_LATER='Nothing removes it once the package is gone; once they have stopped:'
             shared_release || :; exit 0;;
    check) rc=0; shared_view_check || rc=$?
           trap '' INT TERM QUIT HUP EXIT ERR; exit "${rc}";;
    *) die "--shared-view takes one of: release, release-for-removal, check, not '$2'.";;
  esac
fi

case "${HDW4S_EPHEMERAL_SLOTS}" in
  ''|*[!0-9]*) die "HDW4S_EPHEMERAL_SLOTS must be a number, not '${HDW4S_EPHEMERAL_SLOTS}'." ;;
esac
# ZERO IS A POOL, not an error. "hdw4s pool size 0" is how a machine that serves
# only named desktops says so, and a floor of one minted an identity the router
# could never hand out -- harmless, but it made "how big is the pool" have two
# answers on every such machine.

# WHAT THE POOL'S SEATS ARE CALLED: this and a number, _hdw4s_0, _hdw4s_1, ...
# A name adduser refuses for a person, so a seat can never be mistaken for
# somebody's account, or collide with one; "_" and not "-", so that systemd's
# escaping leaves it alone and "hdw4s-%i.slice" stays one level below
# hdw4s.slice. The authoring slot, _hdw4s_author, has run under the same shape
# end to end: unit, journal namespace, userdb record, slice and socket.
#
# NOT A SETTING: a configurable spelling of a name nobody types would be an
# internal detail the administrator was made to own. Spelled again in "hdw4s",
# which has no other way to know it; .github/tests.sh holds the copies together.
SEAT_PREFIX='_hdw4s_'

case "${HDW4S_EPHEMERAL_UID_BASE}" in
  ''|*[!0-9]*) die "HDW4S_EPHEMERAL_UID_BASE must be a number." ;;
esac

# Goes into a mount option, so it is checked rather than passed through: a
# rejected option makes the whole namespace fail to build, and the message names
# the mount rather than the setting that caused it.
case "${HDW4S_EPHEMERAL_HOME_SIZE}" in
  ''|*[!0-9KMG%]*|[!0-9]*)
    die "HDW4S_EPHEMERAL_HOME_SIZE must be a size like 1G, 512M or 10%, not '${HDW4S_EPHEMERAL_HOME_SIZE}'." ;;
esac
case "${HDW4S_EPHEMERAL_PROFILE_SIZE}" in
  ''|*[!0-9KMG%]*|[!0-9]*)
    die "HDW4S_EPHEMERAL_PROFILE_SIZE must be a size like 2G, 512M or 10%, not '${HDW4S_EPHEMERAL_PROFILE_SIZE}'." ;;
esac
case "${HDW4S_EPHEMERAL_SHM_SIZE}" in
  ''|*[!0-9KMG%]*|[!0-9]*)
    die "HDW4S_EPHEMERAL_SHM_SIZE must be a size like 512M, 1G or 10%, not '${HDW4S_EPHEMERAL_SHM_SIZE}'." ;;
esac

# Checked here because it is interpolated into a dconf value: an unbalanced
# quote would not fail this script, it would fail "dconf update" later, and a
# database that will not compile falls back to schema defaults in silence.
#
# ONE READER, DELIBERATELY. The session also has to know whether a field is
# wanted, and the obvious way to tell it is to let it read this setting too --
# which is how the idle window came to be parsed two ways that disagreed. It
# asks dconf what is actually in force instead, so this grammar has exactly one
# parser and the administrator's template layer is honoured for free.
case "${HDW4S_EPHEMERAL_BACKGROUND}" in
  generated) ;;
  '#'[0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F][0-9a-fA-F]) ;;
  /*[!\'\"]|/*[!\'\"][!\'\"]*) ;;
  *) die "HDW4S_EPHEMERAL_BACKGROUND must be 'generated', a colour like
  #772953, or an absolute path to an image -- not '${HDW4S_EPHEMERAL_BACKGROUND}'." ;;
esac
# The lowest uid the template rows hold, counting down from UID_MAX by their
# position among the template rows -- the derivation --template uses below, and
# it has to be the same one, so it is computed once here for both readers.
# A table with NO template row still reserves one: "hdw4s template edit"
# provisions the authoring slot on first use, and a pool already grown into its
# uid would make that first use fail.
template_rows="$(awk '$1 !~ /^#/ && $3 == "template" { n += 1 } END { print n + 0 }' \
  "${ETCDIR}/instances" 2>/dev/null || echo 0)"
[ "${template_rows}" -ge 1 ] || template_rows=1
TEMPLATE_LOW=$(( UID_MAX - template_rows + 1 ))

# THE LARGEST POOL THIS MACHINE CAN MINT, for "hdw4s pool size", which asks
# before it writes anything rather than finding out from a boot that dies. Asked
# here, as --uid-window is, so that the window and the template arithmetic have
# exactly one home. Before the size checks below on purpose: the question is
# what N may be, and a configuration whose CURRENT N is out of range must still
# be able to get an answer, or the command that would repair it cannot run.
if [ "${1:-}" = '--pool-max' ]; then
  max=$(( TEMPLATE_LOW - HDW4S_EPHEMERAL_UID_BASE ))
  [ "${max}" -ge 0 ] || max=0
  echo "${max}"
  exit 0
fi

last=$(( HDW4S_EPHEMERAL_UID_BASE + HDW4S_EPHEMERAL_SLOTS - 1 ))
if [ "${HDW4S_EPHEMERAL_UID_BASE}" -lt "${UID_MIN}" ] || [ "${last}" -gt "${UID_MAX}" ]; then
  die "uids ${HDW4S_EPHEMERAL_UID_BASE}-${last} fall outside the ${UID_MIN}-${UID_MAX} window."
fi

# THE ARGUMENTS ARE SETTLED BEFORE ANYTHING IS WRITTEN. Every refusal below is
# about which slot to mint, and a refusal that comes after the run directories
# have been made has already changed the machine it is refusing to change.

# WHICH SLOTS THIS RUN MINTS, as a list built before the loop rather than as a
# counter inside it. The body below is unchanged and does not know which caller
# it is serving, which is the whole point: the five artefacts a slot needs --
# the userdb records, the namespaced passwd, the profile mount point, the gated
# web root and the numeric-uid drop-in -- have exactly ONE implementation. A
# second one written elsewhere would be a copy of a rule, and it would drift the
# first time either was edited.
#
# TWO CALLERS, and the difference between them is which list they build:
#
#   (no arguments)        the pool, at boot, exactly as this unit always has
#   --template NAME  one named slot, for a row that is NOT in the pool --
#                         today that is the administrator's authoring slot,
#                         typed "template" in the slot table
#
# THE ORDERING CONSTRAINT IS THE SAME FOR BOTH, and it is why --template exists here
# rather than in the caller: as the header of this file says, systemd resolves
# User= before any ExecStartPre= of ours could run, so a unit CANNOT mint its
# own identity -- measured, it fails 217/USER. Whoever calls --template must call it
# before that slot's socket can fire. "hdw4s" does, in enable_slot; its socket is
# enabled last.
ONE_SHOT=''
TEMPLATE_NAME=''
# Rows typed "ephemeral" under names that are not seats; see the boot run below.
RETIRED=''
# Whether this run mints POOL seats -- the boot run, or one --seat. Gates the
# teardown and start watchers below, which a pool seat needs and the authoring
# slot must never have. A separate flag from ONE_SHOT because the two questions
# ("is this the whole machine" and "is this the pool") stopped having the same
# answer when --seat arrived.
POOL_RUN='yes'
if [ "${1:-}" = '--seat' ]; then
  # ONE POOL SEAT, LIVE, for "hdw4s pool size" raising the pool without a
  # reboot. The same five artefacts the boot run makes, for one name, by the
  # same loop body -- which is the reason this is a flag here and not a copy in
  # the caller.
  #
  # THE CONFIGURATION IS THE AUTHORITY, AND IS READ HERE, not trusted from the
  # caller: the seat must be _hdw4s_<i> with i below HDW4S_EPHEMERAL_SLOTS as
  # the file says NOW. So the caller writes the new size first and mints after,
  # and the next boot -- which mints from that same file -- makes exactly the
  # seats this made. A seat minted outside that range would be a seat the next
  # boot does not make, with a row the router goes on offering: the one
  # disagreement between rows and identities that costs a visitor a desktop.
  ONE_SHOT='yes'
  [ "$#" -eq 2 ] || die "--seat takes exactly one seat name."
  seatidx="${2#"${SEAT_PREFIX}"}"
  case "${seatidx}" in
    "$2"|''|*[!0-9]*|0?*)
      die "$2 is not a seat of this pool; seats are ${SEAT_PREFIX}0, ${SEAT_PREFIX}1, ..." ;;
  esac
  [ "${seatidx}" -lt "${HDW4S_EPHEMERAL_SLOTS}" ] ||
    die "$2 is beyond HDW4S_EPHEMERAL_SLOTS=${HDW4S_EPHEMERAL_SLOTS}; raise the
  setting first, so the next boot mints it too."
  # THE TEMPLATE'S END OF THE WINDOW, which the boot run does not check for the
  # pool: there a "die" would take every seat down, and the template mint after
  # it warns instead. Here one seat is being added on purpose, so refusing it
  # costs one command and saves the authoring slot its uid.
  [ $(( HDW4S_EPHEMERAL_UID_BASE + HDW4S_EPHEMERAL_SLOTS - 1 )) -lt "${TEMPLATE_LOW}" ] ||
    die "a pool of ${HDW4S_EPHEMERAL_SLOTS} reaches uid ${TEMPLATE_LOW}, which the
  template-authoring slot holds. The largest pool here is
  $(( TEMPLATE_LOW - HDW4S_EPHEMERAL_UID_BASE ))."
  SLOT_SPECS="$(printf '%s\t%s\t%s' "$2" \
    "$(( HDW4S_EPHEMERAL_UID_BASE + seatidx ))" 'Desktop')"
  SEAT_NAME="$2"
elif [ "${1:-}" = '--template' ]; then
  POOL_RUN=''
  ONE_SHOT='yes'
  [ "$#" -eq 2 ] || die "--template takes exactly one instance name."
  TEMPLATE_NAME="$2"

  # THE ROW IS THE AUTHORITY, and it is read here rather than trusted from the
  # caller. "--template foo" on a row that is not typed "template" would mint a
  # uid and a web root for a NAMED desktop or, far worse, for a pool member --
  # and the slot table has no validator, so nothing downstream would catch it.
  # A caller that already knows the type still has to prove it to this script.
  rowtype="$(awk -v i="${TEMPLATE_NAME}" \
    '$1 !~ /^#/ && $2 == i { print ($3 == "" ? "desktop" : $3); exit }' \
    "${ETCDIR}/instances" 2>/dev/null)"
  [ -n "${rowtype}" ] ||
    die "${TEMPLATE_NAME} has no row in ${ETCDIR}/instances."
  [ "${rowtype}" = 'template' ] ||
    die "${TEMPLATE_NAME} is typed '${rowtype}', not 'template'; refusing to mint it."

  # THE UID IS DERIVED HERE AND NOWHERE ELSE. An earlier shape had the caller
  # pass it, and that is wrong in a way that is silent rather than loud: these
  # records live in /run, so after a reboot the template's record does not exist
  # when the pool is minted. The pool would take the uid unopposed, the template
  # would be re-minted onto it afterwards, and the two would then disagree about
  # who owns it with nothing anywhere complaining. One derivation, in the one
  # script that owns the window, is what removes that.
  #
  # DOWN FROM THE TOP, while the pool grows UP from the bottom, which is the
  # allocation this estate already uses where two things share a range. The
  # ordinal is the row's position among the TEMPLATE rows of the table. That is
  # stable because alloc_slot APPENDS -- go and check it -- and not because the
  # derivation is independent of command order: inserting a template row above
  # an existing one would move the existing one's uid. Benign while the records
  # are re-minted from scratch at every boot; it would not be if they persisted.
  ordinal="$(awk -v i="${TEMPLATE_NAME}" \
    '$1 !~ /^#/ && $3 == "template" { n += 1; if ($2 == i) { print n - 1; exit } }' \
    "${ETCDIR}/instances" 2>/dev/null)"
  [ -n "${ordinal}" ] || die "could not place ${TEMPLATE_NAME} among the template rows."
  id=$(( UID_MAX - ordinal ))

  # THE TWO ENDS MUST NOT MEET, and this refusal is here rather than only in the
  # collision check inside the loop because THAT one is a "die" in a oneshot unit
  # every session Requires=. Reached at boot it does not decline the template, it
  # takes the WHOLE POOL down with 217/USER. So the arithmetic is refused early,
  # where it costs one command instead of every desktop on the machine.
  high=$(( HDW4S_EPHEMERAL_UID_BASE + HDW4S_EPHEMERAL_SLOTS - 1 ))
  [ "${id}" -gt "${high}" ] ||
    die "uid ${id} for ${TEMPLATE_NAME} meets the pool, which reaches ${high}.
  The pool grows up from ${HDW4S_EPHEMERAL_UID_BASE} and template rows grow down
  from ${UID_MAX}; with ${HDW4S_EPHEMERAL_SLOTS} slot(s) there is no room for
  this one. Make the pool smaller (hdw4s pool size N) or remove a template row."
  { [ "${id}" -ge "${UID_MIN}" ] && [ "${id}" -le "${UID_MAX}" ]; } ||
    die "derived uid ${id} is outside the ${UID_MIN}-${UID_MAX} window."

  # CAPTURED HERE, and not read back off ${id} at the end. The minting loop is a
  # "while read", and read CLEARS the variables it assigns when it finally hits
  # EOF -- so ${id} is empty by the time the closing message runs, and the first
  # version of that message printed "(uid )". Derive it once, name it, and let
  # the loop variable be the loop's business.
  TEMPLATE_UID="${id}"
  SLOT_SPECS="$(printf '%s\t%s\t%s' "${TEMPLATE_NAME}" "${id}" 'Template')"
elif [ "$#" -gt 0 ]; then
  die "unknown argument '$1'; this takes no arguments, --template NAME or --seat NAME."
else
  SLOT_SPECS=''
  # ROWS THAT ARE NOT SEATS: the table offers visitors a row typed
  # "ephemeral" whose name is not a seat. Nothing below mints an identity for
  # such a row, so the router would go on sending visitors to a desktop that
  # dies 217/USER, while the seats, which have no rows, would be minted for
  # nobody. That is the half-working shape, and it is REFUSED rather than
  # repaired: rewriting the table at boot would change it behind the
  # administrator's back.
  #
  # NOT REFUSED HERE AND NOW, though. A "die" at this point would skip
  # everything else this run does for the WHOLE machine -- the run
  # directories above are already made, but the slice's memory brake below
  # holds named desktops too, and the authoring slot is minted from the table
  # after the pool. So the pool alone is not minted, everything else is done,
  # and the run fails at the END, loudly, naming the rows and the repair. Not
  # minting the new seats is deliberate too: on a machine upgraded without a
  # reboot the old seats still hold the same uids in /run, and minting over
  # them would die with a collision that names neither the cause nor the fix.
  # Exact shape, as seat_index() in "hdw4s" judges it: the prefix, then a
  # number written the one way the loop below writes it.
  RETIRED="$(awk -v p="${SEAT_PREFIX}" '
    $1 !~ /^#/ && $3 == "ephemeral" {
      n = substr($2, length(p) + 1)
      if (substr($2, 1, length(p)) != p || n !~ /^(0|[1-9][0-9]*)$/)
        printf " %s", $2
    }' "${ETCDIR}/instances" 2>/dev/null || :)"
  i=0
  [ -z "${RETIRED}" ] || i="${HDW4S_EPHEMERAL_SLOTS}"
  while [ "${i}" -lt "${HDW4S_EPHEMERAL_SLOTS}" ]; do
    SLOT_SPECS="${SLOT_SPECS}$(printf '%s\t%s\t%s\n' \
      "${SEAT_PREFIX}${i}" \
      "$(( HDW4S_EPHEMERAL_UID_BASE + i ))" \
      'Desktop')
"
    i=$(( i + 1 ))
  done
fi

# Everything the session needs to ALREADY EXIST, made in one place, at boot, before
# any socket can listen -- this unit is WantedBy=sysinit.target, and sockets.target is
# two targets later, so nothing can accept a connection before this line has run.
#
# /run/hdw4s/proxy is here because nothing else creates it, which is not what its own
# unit says. Measured on systemd 255, three arms with a positive control: a socket unit
# declaring RuntimeDirectory= and carrying no Exec= line creates NOTHING -- the
# directive is a systemd.exec setting and there is no execution context to attach it
# to -- while the same directive on a service with an ExecStart= works. What actually
# made the directory was the UNIX ListenStream= binding a socket INSIDE it, measured
# again with the directive removed entirely. So "hdw4s transport ... tcp", which
# replaces that bind with a port, silently removes the only thing that was creating it,
# and the feature then works until the next reboot.
#
# /run/hdw4s/incarnation is a different failure with the same symptom, and is here so
# that it cannot happen at all: hdw4s-incarnation makes it itself, but at the END of a
# script that exits early when the web root is missing, and the session only Wants=
# that unit -- so the script failing for any reason leaves the session to die on the
# directory instead of on the thing that failed.
install -d -m 0755 "${USERDB}" "${NSDIR}" "${DROPDIR}" "${PROFILEDIR}" "${PROXYDIR}"
# THE SAME ACCESS STORY THE SLOT SOCKETS ALREADY HAVE, rather than a second one:
# root owns it, www-data may write into it, and the router is in www-data for
# exactly this class of reason. 0770 and not 0777 -- what may be written here is
# a request to destroy somebody's desktop, and the group is the whole of who may
# ask. The name inside it is a slot and nothing else; see hdw4s-teardown@.path.
install -d -m 0770 -g www-data "${TEARDOWNDIR}"
# AND THE ONE WAY A POOL DESKTOP IS STARTED, with the same access story: the
# router writes "start this slot" here and hdw4s-start@<slot> does it as root.
# A connection cannot start one any more (the relay is Requisite= on the
# session), so this directory is the whole of who can.
install -d -m 0770 -g www-data "${STARTDIR}"
# THE TEMPLATE INVITES: root writes one file per "hdw4s template edit", named by
# the hash of the token it prints, and the router only reads it. 0711: nobody
# may list it, and entering it by name takes the token. Writable by root alone,
# so nothing sharing the router's group can plant an invite of its own.
install -d -m 0711 "${INVITEDIR}"
# 0700, not 0755: this one holds a token per live slot, so its listing is a list of
# which slots exist. Made separately rather than loosened into the line above.
install -d -m 0700 "${INCARNDIR}"
# THE STREAM ROOT: root-owned, group hdw4s-relay, 0711. Search for everyone and
# a listing for nobody -- the names inside are account names, and an occupant
# may reach its own directory by name without learning anyone else's. The GROUP
# is not for access (the mode gives the group nothing the world lacks); it is
# where hdw4s-stream-dir and hdw4s-session READ the relay's gid from, so that
# neither has to resolve a group name inside a session's namespace, where the
# ephemeral unit binds its own /etc/group over the real one.
#
# No group, no stream root, and said so: without it no session on this machine
# can be reached, and the relay would fail on SupplementaryGroups= with a
# status code that names neither this file nor the package step that was missed.
getent group "${RELAY_GROUP}" >/dev/null ||
  die "the system group ${RELAY_GROUP} does not exist, so no desktop on this
  machine can be reached. It is created by systemd-sysusers from
  hdw4s-sysusers.conf in a sysusers.d directory; run 'systemd-sysusers' and
  start this unit again."
install -d -m 0711 -g "${RELAY_GROUP}" "${STREAMDIR}"

# Set when a slot's unit has already been loaded, which is the only case that
# needs a reload; see the note beside the drop-in below.
reload=''

# IFS is a literal tab and read is -r, because a label may carry spaces. The
# list is fed from a here-document rather than a pipe so that the loop runs in
# THIS shell: "reload" is set inside it, and a subshell would
# discard it -- leaving a drop-in written that nothing ever reads.
while IFS="$(printf '\t')" read -r name id label; do
  [ -n "${name}" ] || continue

  # A real account of that name or uid means this machine already uses the
  # window, and minting over it would give a session an identity that owns
  # somebody's files. Refuse rather than repair.
  # Compared by field rather than by grepping getent's output: a pipe out of
  # getent under `pipefail` turns a match into SIGPIPE, and 141 reads as failure.
  row="$(getent passwd "${name}" 2>/dev/null || true)"
  if [ -n "${row}" ]; then
    row="${row#*:}"; row="${row#*:}"       # drop name and password fields
    [ "${row%%:*}" = "${id}" ] ||
      die "an account named '${name}' already exists with uid ${row%%:*}, not ${id}."
  fi
  byuid="$(getent passwd "${id}" 2>/dev/null || true)"
  if [ -n "${byuid}" ] && [ "${byuid%%:*}" != "${name}" ]; then
    die "uid ${id} already belongs to '${byuid%%:*}'."
  fi

  # The same home every slot reports, matching the namespaced passwd below and
  # the unit's HOME=. It does not exist out here and is not meant to: the
  # directory is a tmpfs inside the session's own namespace. Naming a per-slot
  # path instead would be worse than useless -- nothing creates one, and
  # anything that believed it (`hdw4s enable` writes RequiresMountsFor= from
  # exactly this field) would order a session after a mount that never appears.
  home='/home/user'
  # realName is read by accounts-daemon, which runs OUTSIDE the session's
  # namespace and answers gnome-shell over the system bus, so it is one of the
  # few fields a desktop can still show. Keep it free of the slot's name.
  #
  # The shell below is load-bearing for the same reason, which is not obvious:
  # a nologin shell is what makes accounts-daemon mark the slot SystemAccount,
  # and that is what keeps it out of ListCachedUsers and out of every user list
  # a desktop draws from it. Measured 2026-09-16. Give the slot a real shell
  # here and the outside name starts appearing in user pickers, with nothing
  # else in the tree changed and no test failing. The session's own shell is
  # set in the namespaced passwd below and is unaffected.
  rec='{"userName":"'"${name}"'","uid":'"${id}"',"gid":'"${id}"',
        "realName":"Ephemeral session",
        "homeDirectory":"'"${home}"'","shell":"/usr/sbin/nologin",
        "disposition":"dynamic"}'
  grp='{"groupName":"'"${name}"'","gid":'"${id}"',"disposition":"dynamic"}'

  # Both spellings of each record: nss-systemd looks a user up by name and by
  # uid, and a record filed under only one of them resolves only one way.
  printf '%s\n' "${rec}" > "${USERDB}/${name}.user"
  printf '%s\n' "${rec}" > "${USERDB}/${id}.user"
  printf '%s\n' "${grp}" > "${USERDB}/${name}.group"
  printf '%s\n' "${grp}" > "${USERDB}/${id}.group"
  chmod 0644 "${USERDB}/${name}.user" "${USERDB}/${id}.user" \
             "${USERDB}/${name}.group" "${USERDB}/${id}.group"

  getent passwd "${name}" >/dev/null ||
    die "wrote a record for '${name}' and it still does not resolve."

  # A passwd and group the session sees instead of the machine's. Inside, the
  # slot is called "user" and lives in /home/user, whichever slot it is.
  #
  # That is cosmetic in the security sense -- a session that learned its real
  # name could do nothing extra with it, since the isolation is the uid, the
  # namespace and the empty /home. It earns its place for a different reason: a
  # template profile encodes absolute paths all over it, in dconf values, browser
  # profiles, recently-used lists and wallpaper URIs. A home that is always
  # /home/user makes one template correct in every slot, and keeps the account it
  # was built from out of every session that starts from it.
  #
  # Only system accounts are carried over. Real people are left out on purpose:
  # ProtectHome=tmpfs already hides their directories, and this hides their names
  # to match.
  ns="${NSDIR}/${name}"
  install -d -m 0755 "${ns}"
  awk -F: '$3 < 1000 || $3 == 65534' /etc/passwd > "${ns}/passwd"
  printf 'user:x:%s:%s:ephemeral session:/home/user:/bin/bash\n' "${id}" "${id}" \
    >> "${ns}/passwd"
  # Field 4 -- the member list -- is dropped, because it names real people:
  # `sudo`, `audio` and `plugdev` routinely list every human on the machine, and
  # copying the line wholesale put three of them inside the session on the first
  # box this was measured on. Nothing is lost by dropping it: a group the unit
  # grants arrives as a kernel credential, and the name still resolves from the
  # gid on the line.
  awk -F: 'BEGIN { OFS = ":" } $3 < 1000 || $3 == 65534 { $4 = ""; print }' \
    /etc/group > "${ns}/group"
  printf 'user:x:%s:\n' "${id}" >> "${ns}/group"
  chmod 0644 "${ns}/passwd" "${ns}/group"

  # The home, as a tmpfs the namespace owns outright. It is mounted where the
  # passwd entry above promises rather than bound there from /run, because
  # systemd orders its mounts by destination and "/home" sorts before "/run":
  # the bind ran first and published the uncapped /run filesystem at /home/user,
  # measured, with no error anywhere. Mounting it directly has no order to get
  # wrong, and nothing to clean up either -- the mount lives in the session's
  # namespace and is gone with the last process on every stop path.
  #
  # This cannot live in the template, which is why it is generated here: `uid=`
  # must be a number, and a unit template has no way to turn %i into one. The
  # script that assigns the uid is the one place that already knows it.
  # The mount point for the profile tmpfs. Made here rather than with
  # RuntimeDirectory=, which conflicts with TemporaryFileSystem= on the same
  # path and wins without saying so. It stays empty on the host for the life of
  # the machine: what the session writes goes to the tmpfs mounted over it
  # inside the namespace, and /run is cleared at boot.
  install -d -m 0755 "${PROFILEDIR}/${name}"

  # The gated web client this slot is served from. Built here rather than in the
  # session because the session's own namespace has /usr read-only -- and because a
  # tree the occupant could write is a tree the occupant could un-gate. Per slot, as
  # root, before any socket can fire.
  #
  # The name reaches the browser tab through the manifest, which is the only
  # per-session string the packaged client will read. For a pool slot it is the
  # plain word, NOT the slot's number: a slot is reused, and a number a visitor
  # sees again after being told the desktop is gone reads as the same desktop
  # (three novices of three, 2026-09-27). Telling one's own desktops apart is the
  # browser's job -- hdw4s-names.js keeps a per-browser number and an optional
  # name, replacing this word on the session page and in the directory.
  #
  # "--directory" is a claim about the DOOR, not about the slot: these slots are
  # reached through hdw4s-demux, which serves /sessions/, so the boot card may
  # offer the visitor a way back to their own list. This function builds the
  # pool and only the pool -- a named desktop's tree is built by
  # hdw4s@.service, which passes no flag and whose door answers 404 there.
  webroot="${HDW4S_WEBROOT_DIR:-/usr/share/hdw4s/webroot}/${name}"
  if ! "${HDW4S_LIBDIR:-/usr/lib/hdw4s}/hdw4s-webroot" build --directory \
         "${name}" "${webroot}" "${label}" >/dev/null; then
    die "could not build the gated web client for ${name}; refusing to mint a slot
  whose sessions would serve an ungated client and be taken over on arrival."
  fi

  drop="${DROPDIR}/hdw4s-ephemeral@${name}.service.d"
  install -d -m 0755 "${drop}"
  if [ "${name}" != "${TEMPLATE_NAME}" ]; then
  cat > "${drop}/10-home.conf" <<EOF
# Generated by hdw4s-ephemeral-slots; edits are lost at the next boot.
[Service]
TemporaryFileSystem=/home/user:size=${HDW4S_EPHEMERAL_HOME_SIZE},mode=0700,uid=${id},gid=${id}
TemporaryFileSystem=/run/hdw4s/profile/${name}:size=${HDW4S_EPHEMERAL_PROFILE_SIZE},mode=0700,uid=${id},gid=${id}
TemporaryFileSystem=/dev/shm:mode=1777,size=${HDW4S_EPHEMERAL_SHM_SIZE}
EOF
  else
  # THE AUTHORING SLOT KEEPS ITS HOME AND PROFILE OUTSIDE ITS NAMESPACE, and
  # that is the one way it differs from a pool slot. "hdw4s template edit"
  # harvests both AFTER the desktop has stopped -- the only moment the files
  # are consistent -- and a tmpfs would be gone by then. The HOME matters as
  # much as the profile: programs that ignore XDG (the Arduino IDE's
  # ~/.arduino15, say) keep their settings there, and "hdw4s template keep"
  # names them. Both directories are made, seeded and wiped by that command and
  # nothing else, so a template desktop started any other way fails on the
  # missing path instead of running with state nobody will harvest or clean up.
  # Their parent is root's and 0711; each is this slot's uid's and 0700.
  #
  # The dconf profile leaves the template's own database out: the command seeds
  # the user database from it instead, so a key the author resets is REMOVED
  # from the template rather than falling back to the old template's value.
  # Chrome gets one more policy file, over a placeholder of the same name,
  # refusing sign-in: visitors may sign in, but an account signed in HERE would
  # be harvested into every visitor's desktop.
  author="${HDW4S_AUTHOR_DIR:-${RUNDIR}/author}"
  cat > "${drop}/10-home.conf" <<EOF
# Generated by hdw4s-ephemeral-slots; edits are lost at the next boot.
[Service]
BindPaths=${author}/${name}.home:/home/user
TemporaryFileSystem=/dev/shm:mode=1777,size=${HDW4S_EPHEMERAL_SHM_SIZE}
ReadWritePaths=${author}/${name}
Environment=HDW4S_EPHEMERAL_PROFILE_ROOT=${author}
Environment=DCONF_PROFILE=hdw4s-author
BindReadOnlyPaths=/etc/hdw4s/chrome-author-policy.json:/etc/opt/chrome/policies/managed/hdw4s-author.json
EOF
  fi

  # THE SLOT'S OWN JOURNAL (the unit's LogNamespace=hdw4s-%i), configured here
  # rather than in /etc: these are drop-ins in the documented /run locations for
  # a namespace, so the machine's own journald settings are never touched and
  # nothing is left behind after a reboot. Measured 2026-09-30 on a stock
  # (persistent) journal: with them the store is one system.journal in /run,
  # the slot's uid cannot read it, nothing reaches the default journal, and no
  # /var directory appears; without them the namespace is persistent and split
  # per uid, which is the very leak it exists to close.
  #   Storage=volatile   a namespace other than the default is persistent unless
  #                      told otherwise, and the store belongs to the reused slot
  #   SplitMode=none     one file, root's -- never one per uid with an ACL
  #   RuntimeMaxUse=     without it each namespace may take 10% of /run, which
  #                      is sized from the host here
  #   LogsDirectory=     the stock systemd-journald@.service creates an empty
  #                      /var/log/journal/<id>.<ns> regardless; a check that
  #                      tests for the directory then reads "persistent"
  jns="hdw4s-${name}"
  install -d -m 0755 "/run/systemd/journald@${jns}.conf.d" \
                     "/run/systemd/system/systemd-journald@${jns}.service.d"
  printf '%s\n' '# Generated by hdw4s-ephemeral-slots; edits are lost at the next boot.' \
    '[Journal]' 'Storage=volatile' 'SplitMode=none' 'RuntimeMaxUse=32M' \
    > "/run/systemd/journald@${jns}.conf.d/10-hdw4s.conf"
  printf '%s\n' '# Generated by hdw4s-ephemeral-slots; edits are lost at the next boot.' \
    '[Service]' 'LogsDirectory=' \
    > "/run/systemd/system/systemd-journald@${jns}.service.d/10-hdw4s.conf"

  # systemd caches a unit once it has loaded it, so a drop-in written afterwards
  # is not read until a reload. At boot there is nothing to reload: this runs
  # before the sockets that could start a session, so no instance has been
  # loaded. Only a re-mint on a running system needs one, and asking for a
  # reload from inside a unit systemd is still starting is a documented way to
  # deadlock -- so it is asked for when it is needed and not otherwise.
  [ "$(systemctl show -p LoadState --value "hdw4s-ephemeral@${name}.service" \
         2>/dev/null)" != 'loaded' ] || reload='yes'

done <<SPECS
${SLOT_SPECS}
SPECS


# THE SESSION SLICE'S MEMORY BRAKE, AS A NUMBER THIS MACHINE AGREES WITH.
#
# hdw4s.slice used to carry "MemoryHigh=75%". systemd expands a percentage in a
# memory limit through sysconf(_SC_PHYS_PAGES) -- the sysinfo() syscall -- and a
# container runtime can virtualise /proc/meminfo but not a syscall. Measured
# inside a 16 GiB container on 2026-09-26: the file said 16.00 GiB, sysconf said
# 62.11 GiB, and the directive resolved to 46.58 GiB, which is 75% of the
# second. The brake was three times the container's memory and the cgroup's
# memory.events said "high 0" for as long as it shipped.
#
# THE ACCURATE NUMBER WAS ALWAYS AVAILABLE, which is why this is a repair and
# not a workaround: /proc/meminfo is virtualised and correct. The fraction is
# unchanged; only the door it is read through has moved.
#
# WHY IT IS COMPUTED HERE. This script is the one thing ordered early enough that
# nothing can start before it -- the same reason USERDB, the run directories and
# the slot identities are here -- and the value cannot be known at packaging
# time, because it is a fact about the machine. It is not ephemeral-specific and
# does not pretend to be: the slice holds NAMED sessions too, which is why the
# block sits outside the per-slot loop above.
#
# THE SHARE IS THE ONE THAT ALREADY SHIPPED. 75% is not a new judgement and is
# not derived from any measurement of this project's desktops -- it is the number
# this unit has carried since it was written, now expressed so that it means the
# same thing inside a container as outside. A different share is an
# administrator's decision about their machine, taken by dropping their own file
# into /etc/systemd/system/hdw4s.slice.d/, which wins over this one.
#
# SOFT, still: MemoryHigh reclaims and throttles. A session that overreaches gets
# slow rather than killed, and stops making everyone else slow.
MEMHIGH_PERCENT=75
# SKIPPED FOR --template, and this is a scope statement rather than an optimisation.
# Everything from here down is machine-wide: the slice's memory brake and the
# ephemeral background database are facts about the BOX, computed once at boot
# by the run that has no arguments. A --template run is adding a single slot to a
# machine that has already booted, so recomputing them would either write the
# same bytes or -- worse -- quietly re-derive a machine-wide setting from
# whatever environment the CALLER happened to have. The per-slot work above is
# the whole of what --template is for.
# Spelled exactly as the background block below spells it. An earlier version
# folded this guard into the "case" subject, which worked but left one "case"
# answering two unrelated questions, and the SAME guard written two ways in one
# file. Two spellings of one rule is the drift, whether or not either is wrong.
if [ -z "${ONE_SHOT}" ]; then
memtotal_kb="$(awk '/^MemTotal:/ { print $2; exit }' /proc/meminfo 2>/dev/null || :)"
case "${memtotal_kb}" in
  ''|*[!0-9]*)
    # NOT silently skipped, and not defaulted either. A machine whose own
    # /proc/meminfo cannot be read is not a machine to guess a memory limit for,
    # and a guess here is exactly the class of confident wrong number this whole
    # block exists to remove. Left with no brake and said out loud; "hdw4s check"
    # reports the absence separately.
    echo "hdw4s: /proc/meminfo gave no MemTotal, so hdw4s.slice gets no memory brake." >&2
    ;;
  *)
    # Multiply before dividing: the other order loses up to 99 kB of precision
    # and the linter says so. A 64-bit shell holds a terabyte's worth either way.
    memhigh=$(( memtotal_kb * 1024 * MEMHIGH_PERCENT / 100 ))
    slicedrop="${DROPDIR}/hdw4s.slice.d"
    install -d -m 0755 "${slicedrop}"
    want="$(printf '%s\n' \
      '# Generated by hdw4s-ephemeral-slots at boot; edits are lost.' \
      "# ${MEMHIGH_PERCENT}% of this machine's own MemTotal, as an absolute count." \
      '# A percentage here would be resolved against the HYPERVISOR under LXC.' \
      '# Override with your own file in /etc/systemd/system/hdw4s.slice.d/.' \
      '[Slice]' \
      "MemoryHigh=${memhigh}")"
    # Compared before writing, for the reason the background database below is:
    # rewriting a file systemd is watching costs a reload for nothing.
    if [ "$(cat "${slicedrop}/10-memory-high.conf" 2>/dev/null || :)" != "${want}" ]; then
      printf '%s\n' "${want}" > "${slicedrop}/10-memory-high.conf"
      # A drop-in written after the slice has been loaded needs a reload to take.
      # At boot it has not been -- this unit is WantedBy=sysinit.target and the
      # slice is Before=slices.target -- so the common path costs nothing; the
      # reload is for a re-run, which is the case that would otherwise write a
      # correct file that nothing reads.
      [ "$(systemctl show -p LoadState --value hdw4s.slice 2>/dev/null)" \
        != 'loaded' ] || reload='yes'
    fi
    ;;
esac

# /SHARED, A PICNIC TABLE EVERY DESKTOP CAN REACH -- only when the administrator
# asks for it with HDW4S_SHARED, and removed again when they stop asking. What
# this run does is the part that has to exist before any desktop starts: the
# desktops' drop-ins, the sweep's arguments, and starting the expose timer.
# Everything that touches a store -- mounting, judging, binding, unbinding --
# is hdw4s-shared-expose's, re-run every 30 seconds, because a store can come
# and go while the machine is up and this runs once.
#
# THE DESKTOPS BIND /run/hdw4s/shared, NEVER THE STORE, AND NEVER OPTIONALLY.
# That directory is made by tmpfiles at every boot, unconditionally, so the bind
# source always exists: an empty root-owned directory until a store is judged
# good and bound onto it. "BindPaths=-..." with a missing source is the trap
# this layout exists to avoid -- measured on systemd 255, it exempts an existing
# /shared on the root filesystem from ProtectSystem=strict and leaves it
# WRITABLE from every desktop. If somebody deletes the directory by hand, a
# desktop fails to start (226/NAMESPACE), loudly, which is the safe way round.
#
# OFF MEANS NONE OF THESE FILES EXIST. A stale drop-in is a /shared that nobody
# turned on.
shared_mode="${HDW4S_SHARED-}"
case "${shared_mode:=off}" in
  off|tmpfs|source) ;;
  *)
    # Not a die: the pool is minted by this same run, and a typo in an optional
    # feature must not take every ephemeral desktop down with it. Off, said
    # out loud, and "hdw4s check" goes red on the same value.
    echo "hdw4s: WARNING: HDW4S_SHARED must be off, tmpfs or source, not '${shared_mode}';
  /shared is OFF until it is." >&2
    shared_mode='off'
    ;;
esac
shared_drop="$(printf '%s\n' \
  "# Generated by hdw4s-ephemeral-slots at boot from HDW4S_SHARED=${shared_mode}." \
  '# Never "BindPaths=-...": see hdw4s-ephemeral-slots.' \
  '[Service]' \
  'BindPaths=/run/hdw4s/shared:/shared')"
for unit in hdw4s@.service hdw4s-ephemeral@.service; do
  f="${DROPDIR}/${unit}.d/50-shared.conf"
  if [ "${shared_mode}" != 'off' ]; then
    install -d -m 0755 "${DROPDIR}/${unit}.d"
    if [ "$(cat "${f}" 2>/dev/null || :)" != "${shared_drop}" ]; then
      printf '%s\n' "${shared_drop}" > "${f}"; reload='yes'
    fi
  elif [ -e "${f}" ]; then
    rm -f "${f}"; reload='yes'
  fi
done
# /shared ON THE ROOT FILESYSTEM: the desktops' mount point, and in the root
# namespace the read-only view of the table (shared_view_bind, above). Made
# here, with the mark that says this feature made it; removed when the feature
# is turned off, and only then (shared_release). A /shared that existed before
# (an administrator's own, or a mount point in fstab) is never touched, and one
# that is not empty is never touched either.
if [ "${shared_mode}" != 'off' ]; then
  # Before the expose timer is started below: at boot nothing can have shown a
  # table yet, because this run is what starts the service that does. Never
  # fails the run that mints the pool: what it declined, it says.
  shared_view_bind || :
else
  # Never fails the run that mints the pool: what it kept, it says.
  shared_release || :
fi

# THE SWEEP'S SETTINGS, when this machine sweeps its own table
# (HDW4S_SHARED_SWEEP=local, the default). Its units are templates named after
# the escaped path of the store root and read the two settings from their
# environment; this writes them, VERBATIM -- the tool parses them, with the one
# grammar every duration here has -- into a drop-in for that one instance. The
# units are started by hdw4s-shared-expose once the store is mounted, because
# they are BindsTo= its mount -- and started again by every later run that
# finds them stopped, for as long as the table is exposed.
#
# Only characters a duration can have reach a unit file: anything else could be
# a "%" specifier or a quote, and is refused here, loudly, leaving the unit's
# own defaults (30m, 7d) -- which "hdw4s check" then reports as a value it
# cannot read.
shared_store=''
if [ "${shared_mode}" != 'off' ] && [ "${HDW4S_SHARED_SWEEP:-local}" = 'local' ]; then
  shared_store="$("${HDW4S_LIBDIR:-/usr/lib/hdw4s}/hdw4s-shared-expose" --store 2>/dev/null || :)"
fi
shared_knobs=''
if [ -n "${shared_store}" ]; then
  shared_inst="$(systemd-escape --path -- "${shared_store}")"
  shared_knobs="${DROPDIR}/hdw4s-shared-sweep@${shared_inst}.service.d/50-knobs.conf"
  shared_env=''
  for kv in "HDW4S_SHARED_IDLE=${HDW4S_SHARED_IDLE:-30m}" \
            "HDW4S_SHARED_MAX_AGE=${HDW4S_SHARED_MAX_AGE:-7d}"; do
    case "${kv#*=}" in
      ''|*[!0-9A-Za-z]*)
        echo "hdw4s: WARNING: ${kv%%=*}='${kv#*=}' is not a duration; the sweep of /shared
  uses its own default instead until it is." >&2;;
      *) shared_env="${shared_env}Environment=${kv}
";;
    esac
  done
  want="$(printf '%s\n' \
    '# Generated by hdw4s-ephemeral-slots at boot from /etc/hdw4s/hdw4s.conf.' \
    '[Service]' "${shared_env%
}")"
  install -d -m 0755 "${shared_knobs%/*}"
  if [ "$(cat "${shared_knobs}" 2>/dev/null || :)" != "${want}" ]; then
    printf '%s\n' "${want}" > "${shared_knobs}"; reload='yes'
  fi
fi
# A drop-in for any OTHER store -- a re-run after the store or the sweep
# setting changed -- would configure a sweep of something no longer ours.
for f in "${DROPDIR}"/hdw4s-shared-sweep@*.service.d/50-knobs.conf; do
  if [ -e "${f}" ] && [ "${f}" != "${shared_knobs}" ]; then
    rm -f "${f}"; rmdir "${f%/*}" 2>/dev/null || :; reload='yes'
  fi
done

# THE EXPOSE TIMER AND ITS FIRST RUN: started, never enabled, so that a machine
# with /shared off runs nothing every 30 seconds. The service is started here
# once, because the timer counts only from its last run (OnUnitActiveSec=; see
# the timer for why it has nothing else). --no-block, because this runs at boot
# ahead of everything either waits for.
if [ "${shared_mode}" != 'off' ]; then
  systemctl start --no-block hdw4s-shared-expose.timer hdw4s-shared-expose.service 2>/dev/null ||
    echo 'hdw4s: WARNING: could not start hdw4s-shared-expose.timer; /shared stays empty.' >&2
fi
fi

# NOT inside the guard above: a --template run writes 10-home.conf, and a
# drop-in systemd has not re-read is a file that changes nothing.
[ -z "${reload}" ] || systemctl daemon-reload

# ONE WATCHER PER SLOT, started here rather than enabled in the package, for the
# same reason the slots themselves are minted here: how many there are is a
# setting, so the set of instances cannot be known at packaging time. Started
# and not enabled, because /run is a tmpfs -- the directory these watch does not
# survive a boot, and neither should a watcher for a slot that may not exist in
# the next configuration.
# THE POOL ONLY, AND THE TEMPLATE DELIBERATELY NOT. This loop reads the same
# spec list as the minting loop above, and that is a trap rather than a
# convenience: a teardown watcher is how a VISITOR ends their own desktop.
# /run/hdw4s/teardown is mode 0770 group www-data and the router runs in
# www-data, so the watcher's whole authorisation model is "the file's name is
# the slot". Pointing one at the administrator's authoring seat would put their
# unsaved work one filename away from anything that can reach that directory.
#
# So this loop is gated and the minting loop is not. DO NOT RE-UNIFY THE TWO
# for tidiness: that is the exact edit this comment exists to stop, and it was
# made once already by the change that introduced the shared list.
if [ -n "${POOL_RUN}" ]; then
  while IFS="$(printf '\t')" read -r name id label; do
    [ -n "${name}" ] || continue
    # --no-block: this runs at boot, before the pool is servable, and a path unit
    # that is slow to come up must not hold the rest of it.
    systemctl start --no-block "hdw4s-teardown@${name}.path" 2>/dev/null || :
    # And the start watcher, under the same gate: the router only ever mints a
    # pool slot, and the authoring slot is started by its administrator.
    systemctl start --no-block "hdw4s-start@${name}.path" 2>/dev/null || :
  done <<SPECS
${SLOT_SPECS}
SPECS
fi

# The desktop background every ephemeral session starts with, generated because
# the colour is the administrator's to choose. Rewritten only when it changes:
# "dconf update" recompiles every database on the machine, which is not work to
# do at every boot for nothing.
# A variable, as every other path this run writes is, so that a test running the
# whole boot run in a sandbox cannot reach the machine's own database.
DBDIR="${HDW4S_DCONF_DB_DIR:-/etc/dconf/db/hdw4s-ephemeral.d}"
if [ -z "${ONE_SHOT}" ] && [ -d "${DBDIR}" ]; then
  # The flat colour underneath, whatever the form. When a picture is asked for
  # it is still set, because it is what GNOME falls back to if the picture
  # cannot be loaded -- MEASURED on 2026-09-25, not assumed; see
  # private/measure-picture-uri-missing.sh. So a generation that failed on one
  # session degrades to today's behaviour on that session alone.
  colour="${HDW4S_EPHEMERAL_BACKGROUND}"
  uri=''
  options='none'
  case "${HDW4S_EPHEMERAL_BACKGROUND}" in
    generated) colour='#772953'; uri="file://${BACKGROUND_FILE}"; options='zoom' ;;
    /*)        colour='#772953'; uri="file://${HDW4S_EPHEMERAL_BACKGROUND}"
               options='zoom' ;;
  esac
  want="$(printf '%s\n' \
    '# Generated by hdw4s-ephemeral-slots from HDW4S_EPHEMERAL_BACKGROUND.' \
    '# Edits are lost at the next boot; change the setting instead.' \
    '[org/gnome/desktop/background]' \
    "primary-color='${colour}'" \
    "secondary-color='${colour}'" \
    "color-shading-type='solid'" \
    "picture-options='${options}'" \
    "picture-uri='${uri}'" \
    "picture-uri-dark='${uri}'")"
  if [ "$(cat "${DBDIR}/20-background" 2>/dev/null || :)" != "${want}" ]; then
    printf '%s\n' "${want}" > "${DBDIR}/20-background"
    dconf update 2>/dev/null || :
  fi
fi

# THE TEMPLATE ROWS, AT BOOT, READ FROM THE SLOT TABLE.
#
# WHY THIS BLOCK EXISTS AT ALL. Everything a slot needs except the web root
# lives in /run, so it is gone after a reboot. The loop above covers only
# _hdw4s_<i>, so before this block a row typed "template" came back from a
# reboot as the WORST HALF OF ITSELF: the /etc row, the enabled socket, its
# www-data group and the web root under /usr all persist, while the identity
# does not -- leaving a live, router-reachable door in front of a unit that dies
# 217/USER and latches failed. "Re-run the enable command after a reboot" was
# considered and rejected for exactly that asymmetry: the half that survives is
# the reachable half.
#
# THIS IS THE FIRST THING HERE THAT READS THE SLOT TABLE. Until now this script
# minted purely from environment variables and never opened the table -- which
# is why the table was not, in fact, the authority the rest of the product
# describes it as. Note the asymmetry deliberately if you are tempted to fold
# the two together: the POOL is configuration and a collision there must stop
# the boot, because a pool minted wrong hands a stranger somebody's uid. A
# TEMPLATE row is one administrator's authoring seat, and a bad one must NOT
# take the pool down with it.
#
# WARN AND CONTINUE, and a SUBPROCESS rather than a function call, which is the
# mechanism that makes that true. The per-slot body dies on a uid collision, and
# a "die" reached from here would exit this script with the pool already minted
# but the memory brake, the teardown watchers and the background database not
# yet written. Re-invoking this script isolates that exit to the one row.
if [ -z "${ONE_SHOT}" ] && [ -r "${ETCDIR}/instances" ]; then
  _minted=0
  while read -r _idx _name _type _rest; do
    # The same skip every other reader of this file performs. A reader that
    # disagrees with the others about which lines are data is how a fourth type
    # came to mean "named desktop" at seventeen sites at once.
    case "${_idx}" in ''|\#*) continue ;; esac
    [ "${_type:-}" = 'template' ] || continue
    # </dev/null, AND IT IS NOT DEFENSIVE. The child inherits this loop's stdin,
    # which IS the instances file: a child that reads stdin for any reason eats
    # the rest of the table, the loop ends early, and the run exits 0 having
    # minted only the FIRST template row. That is this project's recorded
    # "ssh in a loop eats the list" trap arriving through a different door, and
    # it fails silently in the direction that looks like success. Whether
    # today's children happen to read stdin is a constant that is right today.
    if "$0" --template "${_name}" </dev/null; then
      _minted=$(( _minted + 1 ))
    else
      echo "hdw4s: could not mint the authoring slot ${_name}; the pool is unaffected." >&2
    fi
  done < "${ETCDIR}/instances"
  # SAID OUT LOUD, because "did the authoring slot come back after this reboot"
  # is the exact question this block exists to answer, and a block that reports
  # only its failures cannot answer it.
  [ "${_minted}" -eq 0 ] ||
    echo "hdw4s: minted ${_minted} authoring slot(s) from the slot table."
fi

if [ -n "${SEAT_NAME:-}" ]; then
  echo "hdw4s: minted the pool seat ${SEAT_NAME}."
elif [ -n "${ONE_SHOT}" ]; then
  # Names both, because the uid is DERIVED here rather than supplied: the slot
  # is what the administrator asked for and the uid is what they got, and the
  # two are worth reading together the first time a template row is minted.
  echo "hdw4s: minted the authoring slot ${TEMPLATE_NAME} (uid ${TEMPLATE_UID})."
elif [ -n "${RETIRED}" ]; then
  die "the slot table offers visitors rows the minter never mints:${RETIRED}
  The pool's seats are named ${SEAT_PREFIX}0, ${SEAT_PREFIX}1, ...; nothing makes
  an account for any other name. NO SEAT OF THE POOL WAS MINTED, so no visitor
  can be served. Named desktops are unaffected; the template-authoring slot
  needs this unit, and waits with the pool. Replace the rows with seats, then
  run this again:
    hdw4s pool size ${HDW4S_EPHEMERAL_SLOTS}
    systemctl start hdw4s-ephemeral-slots.service"
else
  echo "hdw4s: minted ${HDW4S_EPHEMERAL_SLOTS} ephemeral slot(s) from ${SEAT_PREFIX}0."
fi
