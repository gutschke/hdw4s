[Unit]
Description=HDW4S ephemeral desktop for slot %i
Documentation=man:hdw4s(8)
# An ephemeral session is a desktop that keeps nothing. It starts from a fresh
# profile, and when the connection ends the profile goes with it. What that
# promises is narrow and deliberate: no artefact of a previous session is left
# on the filesystem. It says nothing about copies the machine makes for its own
# reasons -- page cache, swap, a hibernation image, a snapshot of the host --
# and it must never be documented as though it did.
After=network-online.target hdw4s-firewall.service
Wants=network-online.target
# A hard requirement for the same reason as the base unit, and more so here:
# stopping the firewall unit runs its ExecStop=, which deletes the table that is
# the only thing between this session and the network. This is the session type
# that exists to run code nobody trusts, so it is the last one that should be
# able to start without that table.
Requires=hdw4s-firewall.service
# Not merely ordering: User=%i resolves at start, and the record that makes it
# resolve is minted by this unit. Without it the session fails with 217/USER,
# which reads as a broken service rather than a missing account. It also writes
# the per-slot drop-in that mounts this session's home.
Requires=hdw4s-ephemeral-slots.service
After=hdw4s-ephemeral-slots.service

# Which incarnation of this slot is running, published where the occupant cannot forge
# it and any page this session serves can read it. Wants=, deliberately, not Requires=:
# what makes this safe is the postcondition in "hdw4s-webroot check", which refuses to
# start a session whose token is missing, unchanged, or not the one this generation
# wrote -- and that catches the unit failing, the unit writing nothing, the unit being
# skipped, and the file being removed afterwards. Requires= would catch one of those
# four and charge a stop-propagation footgun for it: stopping a dead RemainAfterExit=no
# oneshot still propagates, so "systemctl stop hdw4s-incarnation@_hdw4s_0" -- which
# reads as a no-op -- would take down a live desktop.
#
# After= is what actually orders it. Type=oneshot means systemd will not run this unit's
# first ExecStartPre until the publisher has exited, so the file is on disk before the
# streaming server can serve a page that asks for it.
Wants=hdw4s-incarnation@%i.service
After=hdw4s-incarnation@%i.service

# WHERE THE STREAMING SERVER LISTENS: a directory only this session's account may
# create in and only it and the relay's group may enter -- hdw4s-stream-dir says
# why a directory and not a port. Requires=, not Wants=: a session with no stream
# directory can be reached by nobody, and starting it anyway only hides why.
Requires=hdw4s-stream@%i.service
After=hdw4s-stream@%i.service
# NOT StopWhenUnneeded=, which this unit carried while the relay's BindsTo= was
# what kept it needed. A desktop is now started on purpose -- by the router's
# start request, through hdw4s-start@ -- and nothing else holds it: the relay is
# Requisite= on it, which starts nothing and pins nothing until a connection
# exists. With StopWhenUnneeded= a desktop started that way is stopped as
# unneeded within seconds, before its visitor's first request (measured
# 2026-09-28, a direct start deactivated in 6 s). A desktop ends by its own
# logout, by a teardown, or by the reaper, each of which stops this unit
# explicitly.

[Service]
# ---- identity -------------------------------------------------------------
# Resolved at service START, not at unit load, which is what lets one template
# serve a pool of slots whose accounts are minted just before the unit runs.
User=%i
# NOT under system.slice, and that also keeps apport from writing crash reports
# for this desktop: it skips a crash in a foreign mount namespace unless the
# process's cgroup is under /system.slice (read in /usr/share/apport/apport).
# That is an accident, not a design -- moving this slice would re-enable
# /var/crash/*.<uid>.crash, readable by the next visitor of the slot -- so
# hdw4s-slot-scrub removes any such file at every start and stop regardless.
Slice=hdw4s-%i.slice
# THE DESKTOP LOGS INTO A JOURNAL OF ITS OWN, kept in memory and emptied when
# the visit ends (hdw4s-slot-scrub stop). On a stock install the default journal
# is persistent and journald gives every regular uid its own file, readable by
# that uid -- and slot uids are reused, so the next visitor read the previous
# one's log (measured 2026-09-30). The namespace's settings are /run drop-ins
# written per slot by hdw4s-ephemeral-slots; nothing about the machine's own
# journal changes. That the desktop exists and runs still appears in the
# default journal, which systemd itself writes; what happens inside it does not.
LogNamespace=hdw4s-%i
Type=notify
NotifyAccess=all
TimeoutStartSec=120
UMask=0077

# Inside, every slot is "user" in /home/user. The slot's outside name and uid
# are what the machine schedules; they are not what the session is shown.
#
# Hiding the name is cosmetic, and says so plainly: a session that learned it
# was "_hdw4s_3" could do nothing with the knowledge, because the isolation is
# the uid, the namespace and the empty /home, none of which a name unlocks.
#
# The fixed HOME is not cosmetic. A profile used as a template encodes absolute
# paths throughout -- dconf values, the browser profile, recently-used lists,
# wallpaper URIs -- so a home that moved per slot would need every one of them
# rewritten, and would carry the name of the account the template was built from
# into every session started from it. One path, and that whole class of problem
# does not arise.
#
# Both of these are namespace-local. The files below name the slot uid "user"
# and nothing else; getent inside reads them, because nss falls back to `files`
# for a uid these do carry.
BindReadOnlyPaths=%t/hdw4s-ns/%i/passwd:/etc/passwd
BindReadOnlyPaths=%t/hdw4s-ns/%i/group:/etc/group
# nss-systemd reads these records directly, with no daemon to ask, so the bound
# passwd above does not hide them: without this, `getent passwd ephemeral0`
# answers from inside. Measured 2026-09-16.
InaccessiblePaths=%t/userdb
# The names of everyone else with a desktop on this machine. ProtectSystem=strict
# makes the filesystem read-only, not invisible, so without this a session can
# list /etc/hdw4s, /var/lib/hdw4s and /run/hdw4s-proxy and read off every real
# account by file name -- the same names this unit goes to the trouble of
# stripping out of the passwd and group files it binds over. Contents were never
# reachable (another profile is 0700 and owned by its user); the names were.
#
# /run/hdw4s is NOT in this list and cannot be: it is the parent of this unit's
# own RuntimeDirectory, and covering it makes the session's own runtime directory
# inaccessible -- measured. Closing that one means moving XDG_RUNTIME_DIR out of
# the shared parent, which is where "hdw4s list" reads a session's display from.
# %t/hdw4s-incarnation is deliberately NOT in this list, though it was until the
# measurement below. It is created "install -d -m0700" by root, and each record
# inside it is 0600 root, so an occupant -- who is never root here -- can neither
# list it nor read it: measured on a test container with a control, an unprivileged uid gets EACCES on
# both the directory and the file while uid 0 reads both. The entry therefore
# added nothing that the mode did not already provide, and it cost the gate: it
# applies to the namespace rather than to a uid, so the one command that has to
# read that record was locked out by it too.
InaccessiblePaths=/etc/hdw4s /var/lib/hdw4s %t/hdw4s-proxy
# PRINTING GOES ONLY THROUGH SELKIES: its queue hands the document to the
# visitor's own browser (hdw4s-run-session points CUPS_SERVER at it). The
# machine's CUPS socket is hidden so an application cannot fall back to the
# system's printers -- which, measured 2026-09-30, a visitor saw as its DEFAULT
# destination. CUPS also listens on 127.0.0.1:631, which this does not close;
# reaching it means an application ignoring the configured server on purpose.
InaccessiblePaths=-/run/cups
# systemd fills these from the slot account, which resolves OUTSIDE the
# namespace and so carries the outside name. They are the last two leaks.
Environment=USER=user
Environment=LOGNAME=user

# The pool's own settings ("hdw4s pool set") between the machine's and the
# seat's: every desktop of the pool reads the same file, so a visitor gets the
# same desktop whichever seat they are handed. The seat's own file is still
# read, last, for what hdw4s writes there itself and for what an install
# configured seat by seat before; "hdw4s pool show" lists any such setting.
EnvironmentFile=-/etc/hdw4s/hdw4s.conf
EnvironmentFile=-/etc/hdw4s/_hdw4s_pool.conf
EnvironmentFile=-/etc/hdw4s/%i.conf

# The same reasoning as the base unit: not /run/user/<uid>, which belongs to
# logind and which this unit has no PAM session to claim. A directory of its own
# costs nothing, and RuntimeDirectory= below makes systemd its owner.
Environment=XDG_RUNTIME_DIR=%t/hdw4s/%i
# The application wrappers go ahead of the real binaries; they are what redirects
# programs that ignore the XDG variables.
Environment=PATH=/usr/lib/hdw4s/wrappers:/usr/local/bin:/usr/bin:/bin
Environment=LIBGL_ALWAYS_SOFTWARE=1
# The settings layer this session starts from. It names a profile in
# /etc/dconf/profile, whose system-db line is a direct memory map -- no service
# has to answer for a setting to be read, which is what makes it usable here at
# all. hdw4s-run-session publishes this to the session bus alongside the XDG
# variables, or the writer and the reader would disagree about which database
# they are using.
Environment=DCONF_PROFILE=hdw4s-ephemeral
# What kind of session this is, for the parts of the session script that have to
# differ. One variable rather than a test against the profile name or the unit
# name, so there is one thing to grep for.

# A Chrome policy that exists only inside this session. The directory is bound
# over the one Chrome reads, so a normal session on the same machine sees the
# empty original and keeps every feature the policy turns off -- which is the
# whole reason this is a mount rather than a file placed on the host.
#
# The mount point has to exist on the host or the namespace fails to build;
# the package creates it empty and never puts a policy in it.
BindReadOnlyPaths=/etc/hdw4s/chrome-policies:/etc/opt/chrome/policies/managed

# ---- where the session lives, and why it vanishes --------------------------
# The profile is the session: with isolation on it holds the settings, the dconf
# database, the GNOME state, the keyring and the browser profile. Measured on
# 2026-09-16, it is the dominant artefact a stopped session leaves behind, and
# it survives a clean stop, a SIGKILL and a hard container stop alike.
#
# So it is moved off the disk entirely, using a setting the product already has
# rather than new machinery: HDW4S_PROFILE_DIR points at this unit's own
# RuntimeDirectory, which systemd creates for the session user and removes when
# the unit stops -- on both stop paths, measured. Destruction becomes the
# platform's job instead of ours.
#
# Two further notes for whoever edits this. The directory must be one systemd
# already creates for the session user: hdw4s-session builds the profile AS that
# user, and a root-owned directory under /run fails with "Permission denied".
# And StateDirectory= is deliberately absent, which is only safe BECAUSE of the
# redirect above: removing the directive alone does not remove the directory,
# since hdw4s-session creates the profile unconditionally.
RuntimeDirectory=hdw4s/%i
RuntimeDirectoryMode=0700

# The profile is deliberately NOT under XDG_RUNTIME_DIR, though it was and the
# two were the same directory. They are split because they want opposite things.
#
# XDG_RUNTIME_DIR has to stay visible from outside: the session writes its
# display number there and "hdw4s list" and "hdw4s show" read it from the host to
# report what is running. It is small -- sockets and a couple of files.
#
# The profile is the opposite on both counts. It holds the dconf database, the
# GNOME state, the keyring and the browser profile with its cache, which is the
# largest thing a session accumulates and the one that actually grows; and
# nothing outside has any business reading it. So it gets a tmpfs of its own,
# sized, mounted inside the namespace, and gone with the last process rather than
# waiting for systemd to remove a directory.
#
# Sized, because a tmpfs with no size takes half of the HOST's memory: /run here
# is around 100 GB on a 16 GB container, so the session with the browser cache in
# it had no bound at all while the home beside it was capped at 1 GB. That is the
# wrong half to protect.
#
# The mount line is not here for the same reason the home's is not: it needs the
# slot's uid as a number, which a template cannot derive from %i. Its mount point
# is made by the same script, and deliberately NOT by RuntimeDirectory=: the two
# conflict on one path and RuntimeDirectory wins silently. Measured -- with both
# set, the session's mount at this path was a bind of the host's /run subtree,
# 13 GB of it, while `systemctl show` cheerfully reported the 2 GB
# TemporaryFileSystem= it had been given and never applied.

# The home is the session's own, not an account's on a shared filesystem, so it
# needs no mount to wait for and gets no 40-home.conf -- the drop-in `hdw4s
# enable` writes, which bakes an account's home path into RequiresMountsFor= and
# fails with 226/NAMESPACE if that path later changes.
#
# The home is a tmpfs mounted at the path the passwd entry above promises, and
# the mount itself is NOT here: it needs the slot's uid as a number, which a
# template cannot derive from %i, so hdw4s-ephemeral-slots writes it as a
# per-slot drop-in. A session whose drop-in is missing fails to start rather
# than running without a home, which is the failure worth having.
#
# The size lives in that drop-in too (HDW4S_EPHEMERAL_HOME_SIZE, default 1G) and
# is not left unset, because a tmpfs takes half of memory by default and /run is
# sized from the HOST's memory rather than the container's: on a 16 GiB
# container that is around 100 GiB, so the cgroup OOM killer would fire long
# before the filesystem filled, which is not a bound anybody chose.
#
# HOME and the working directory are stated rather than left to systemd, which
# reads both from the account as it resolves OUTSIDE the namespace and would
# name the slot's own path.
Environment=HOME=/home/user
WorkingDirectory=/home/user

# ---- what the session must not see or leave --------------------------------
# An empty /home, into which the drop-in mounts the single directory the session
# is allowed: it cannot tell that other accounts exist. Measured against
# the alternative of merely not mounting them, which leaves the names.
ProtectHome=tmpfs
# Its own /tmp and /var/tmp. The /var/tmp private tree turned out NOT to survive
# any stop path we could produce, so this is defence in depth rather than the
# load-bearing line an earlier draft of the plan called it.
PrivateTmp=yes
TemporaryFileSystem=/var/tmp
# ITS OWN /run/lock, a tmpfs that dies with the session. The machine's /run/lock
# is one directory every session and the host share, writable by all (1777):
# measured on a development box from inside a pool seat, a file planted there was
# visible on the host and so to every later occupant of every seat -- state that
# outlives the session, which this design assumes cannot happen. Not read-only:
# what uses it is the old lock-file convention for serial lines (lockdev and its
# descendants, e.g. an Arduino IDE probing /var/lock -> /run/lock), and such a
# program may refuse to run where it cannot write a lock; with PrivateDevices=
# there is no serial line in here to coordinate over, so a private lock
# directory loses nothing. Measured (systemd 255, a unit with ProtectSystem=
# strict and this line): a file written inside appears on the private tmpfs and
# not on the host's. Nothing else in this unit mounts beneath /run/lock, so the
# ordering of namespace mounts by destination has nothing to reorder; and no
# "+" command here uses /run/lock (the web root's build lock is beside the web
# root), so that "+" keeps this mount changes nothing for them.
TemporaryFileSystem=/run/lock:mode=1777,nosuid,nodev,noexec,size=1M
# And its own /dev/shm, which neither of the two lines above provides:
# PrivateTmp= covers /tmp and /var/tmp only, and PrivateDevices= builds a private
# /dev that still carries the machine's shared /dev/shm through.
#
# Measured 2026-09-16, with RemoveIPC=yes already set: a file written to
# /dev/shm from inside survived the unit's exit -- both when it was owned by the
# session uid and, as a control, when it was owned by root. RemoveIPC= is
# documented to cover POSIX shared memory as well as System V, so why it did not
# remove either is NOT established here, and nothing below depends on the
# answer. Do not replace this paragraph with a mechanism unless you have one you
# measured.
#
# The directive earns its place twice over regardless. A shared /dev/shm is also
# a live surface, not only a remanence question: it is a writable filesystem the
# session would hold in common with every real user's desktop on the machine for
# as long as it runs.
#
# The mount itself is generated with the other two sizes, so that every
# per-session limit is set in one place and by one setting each. mode=1777 is
# what /dev/shm is everywhere and the sticky bit is load-bearing; this mount is
# seen by nobody but the session.

# Shared memory and semaphores outlive the session otherwise. logind's default
# would remove them, but it acts on logind sessions and this product has none:
# measured 2026-09-16, a segment owned by the session uid survived a clean stop
# and cleared only when the container rebooted. The directive is therefore not
# redundant with the default -- it is the only thing doing the job.
RemoveIPC=yes

# ---- lifetime --------------------------------------------------------------
# No resurrection. Restart= must stay "no": with the base unit's on-failure a
# SIGKILL brings the session straight back, which during testing silently
# replaces the thing being measured -- that happened once, and a whole set of
# readings turned out to describe the replacement.
Restart=no
# There is deliberately NO absolute cap here, and the reason is not that one was
# forgotten. RuntimeMaxSec= would not be a cap on this unit: NotifyAccess=all
# lets any process in the session's cgroup send EXTEND_TIMEOUT_USEC= and push
# past it indefinitely, which is no use on a session type whose premise is that
# the occupant is untrusted. And the socket stays enabled, so a client that
# reconnects gets a new session in the same slot -- the contents rotate and the
# slot is never freed. A number here would read as a guarantee and behave as a
# recycler, so the value is left to the measurement that sets the idle window
# with it.

# ---- privilege -------------------------------------------------------------
# NoNewPrivileges is NOT set, and the reason originally recorded for that is
# measured false. It was kept off to preserve the Chrome sandbox; Chrome uses the
# namespace sandbox, which needs no capability and no setuid binary, and the
# setuid helper it would otherwise fall back to cannot work under the bounding
# set below in any case. Measured: the renderers run in a user namespace of their
# own, with a PID namespace each.
#
# So turning it on looks close to free for this session type. It is left off
# because that is the decision on record and re-taking it belongs to whoever made
# it, not to whoever noticed -- the question is pending, not answered. Becoming
# root is blocked meanwhile by the simpler thing: the slot account is in no
# sudo-capable group, so there is nothing for sudo to authorise.
#
# The bounding set is the ceiling on what a setuid-root binary here can obtain,
# and while NoNewPrivileges stays off it is the only remaining ceiling.
#
# One capability, where the base unit has three, and the difference is the point.
# CAP_SETUID and CAP_SETGID let a process change identity after exec; nothing on
# a desktop does that except sudo and its relatives, which a named user may
# legitimately run and this account may not -- it is in no sudo-capable group by
# design. Measured with .github/live/privileges.py: every operation a session
# performs behaves identically with and without them, and sudo fails either way,
# reaching "a password is required" with them and "unable to change to root gid"
# without. So they buy this session type nothing, while being exactly what would
# turn a bug in some future setuid binary into a session running as a real user
# of this machine -- with that user's mail, their on-disk profile, and an
# autostart file that runs at their next login.
#
# CAP_NET_RAW stays and is not decoration: ping carries cap_net_raw as a FILE
# capability, which the kernel grants only if it is inside this set, and
# net.ipv4.ping_group_range excludes the slot. Drop it and ping and traceroute
# stop working, measured. Everything else -- CAP_SYS_ADMIN above all -- stays out,
# so mounting, module loading and network reconfiguration remain impossible even
# for uid 0 inside.
CapabilityBoundingSet=CAP_NET_RAW
LockPersonality=yes
# This also sets DevicePolicy=closed, so the base unit's separate line is not
# repeated here -- verified with `systemctl show -p DevicePolicy`, not assumed.
PrivateDevices=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictRealtime=yes
RestrictSUIDSGID=yes

# See the base unit for the measurement behind this; it applies unchanged.
LimitNOFILE=65536
# A core dump is a file the session did not choose to write. On both machines
# measured, `kernel.core_pattern` is "core", so a dump lands in the working
# directory -- inside the tmpfs home, and destroyed with it. That is luck, not
# design: core_pattern is host-global, and a machine with systemd-coredump or
# apport writes the dump to /var/lib/systemd/coredump or /var/crash instead,
# outside every namespace this unit builds. Refusing the dump makes the promise
# independent of a setting this product does not own.
LimitCORE=0
# Defence in depth, and deliberately not load-bearing: the threat model puts RAM
# and swap out of scope, so nothing here rests on this. It is set because it is
# free, not because a claim needs it.
MemorySwapMax=0
OOMPolicy=continue
KillMode=control-group
# THIS SESSION TYPE TAKES THE FULL STOP TIMEOUT TO DIE -- 91 seconds, measured
# from the journal, not estimated: "Stopping" to "State 'final-sigterm' timed
# out. Killing." against the default TimeoutStopUSec of 1min 30s. The cause is
# not a systemd subtlety and not an ordering bug: several of GNOME's gsd-*
# helpers do not exit on SIGTERM and have to be SIGKILLed, so the timeout is
# reached in full every time.
#
# Three consequences, all of which have been reasoned about wrongly here
# before, which is why they are written down rather than left to be re-derived:
#
#   - "Logging out destroys the session immediately" is FALSE by up to ninety
#     seconds. No user-facing string may say "immediately" until this changes.
#     For that minute and a half everything is still resident and the slot is
#     neither usable nor free.
#   - A grace window shorter than the stop timeout cannot free a slot inside
#     the window, so tuning the window below it buys nothing.
#   - Anything that reports capacity will report "full" during teardown, i.e. a
#     state that clears on a timer with no visible cause.
#
# An earlier 1.8 s measurement of this path does NOT contradict the above and
# must not be cited against it: it was taken by stopping the unit explicitly,
# which is the one path where the interesting directives are indistinguishable,
# so it never met the case it was written for.

# The gate, and the "!" is load-bearing rather than stylistic -- as is the fact
# that it is "!" and NOT "+". It lived inside hdw4s-run-session until 2026-09-22
# and was unsatisfiable the whole time, unnoticed because the incarnation layer
# had never run anywhere: layer 4 reads /run/hdw4s-incarnation/%i, that record is
# root-owned 0600 so the occupant cannot forge it, and User= above means every
# unprivileged part of this unit runs AS the occupant.
#
# "!" raises privilege and nothing else: measured, it runs as uid 0 with the
# unit's mount namespace intact, which is both what the check needs and what it
# should want -- layer 4 is asserting what the session's own namespace will
# serve, so checking it from a different namespace would verify the wrong tree.
#
# "+" was tried first and is WRONG here, for a reason worth recording because it
# is not what the manual leads you to expect. "+" is documented to skip "the
# various file system namespacing options", and it does skip ProtectHome= and
# ProtectSystem= -- but it does NOT skip BindPaths= or TemporaryFileSystem=.
# Measured on systemd 255.4-1ubuntu8.17 with findmnt from inside: under "+" this
# unit's /home is the real one while the per-slot drop-in's
# TemporaryFileSystem=/home/user is still applied, so systemd has to create that
# mount point on the REAL /home. Where /home is an NFS mount that squashes root
# -- which is how every machine in this estate gets its homes -- it cannot, and
# every start dies before the desktop exists:
#
#   (-webroot)[...]: Failed to set up mount namespacing: /home/user: No such
#                    file or directory
#   Control process exited, code=exited, status=226/NAMESPACE
#
# Where /home IS writable the same line succeeds and quietly leaves an empty
# /home/user behind on the host, which is its own defect on a session type whose
# whole promise is that it leaves no filesystem trace. Reproduced and cleared
# deliberately, in transient units, on both kinds of machine.
#
# Ordering: After= on the incarnation unit is above, so the record exists before
# this line runs. Refusing here rather than in the session is also strictly
# better -- nothing of the desktop has been started yet when it fails.
ExecStartPre=!/usr/lib/hdw4s/hdw4s-webroot gate %i
# What daemons outside the session keep under the slot's reused name and uid;
# see hdw4s-slot-scrub. Before (a crash can skip the stop) and after every visit,
# through a unit of its own because these lines run inside this sandbox, where
# the scrub cannot see the account or write /var. The start is "-": a failed
# scrub at start must never keep a visitor out -- it did, the first time -- and
# the stop is the one that empties the journal.
ExecStartPre=-!/usr/bin/systemctl start hdw4s-slot-scrub@start-%i.service
ExecStopPost=!/usr/bin/systemctl start hdw4s-slot-scrub@stop-%i.service
ExecStartPre=/usr/bin/install -d -m 1777 /tmp/.X11-unix /tmp/.ICE-unix
# The session type arrives as an ARGUMENT, not as an environment variable.
# EnvironmentFile= overrides Environment= regardless of the order they appear in
# -- measured, and the opposite of what an earlier comment here claimed -- so
# anything this unit exports can be overwritten by a machine-wide setting in
# /etc/hdw4s/hdw4s.conf. A session that quietly stopped being isolated would
# still come up and look right while doing none of what this unit exists to do.
# An argument cannot be overridden by a configuration file.
ExecStart=/usr/lib/hdw4s/hdw4s-session %i --ephemeral

# WHICH WEB ROOT THE STREAMING SERVER ACCEPTED, read from what the server itself
# announced at startup. It decides at startup whether to use the configured web root,
# and if it declines it logs one warning and serves the stock ungated client -- after
# which this session comes up, notifies ready, and every health check reports health
# while the gate is simply absent. Failing here stops the session, which is the point.
#
# THIS WAS AN HTTP FETCH OF THE SLOT'S OWN FRONT DOOR UNTIL 2026-09-26. No ephemeral
# slot has a credential -- "hdw4s auth" refuses one for a slot by design -- so the
# credential defect that broke every NAMED desktop never showed here; the fetch also
# cost a root process and a firewall exemption for a request the firewall exists to
# refuse, and it has been replaced on both unit types together rather than leaving two
# checks that answer the same question differently. That divergence is what made the
# named defect invisible in the first place.
#
# "!" and still NOT nothing, but for a DIFFERENT reason than before: the old reason was
# the firewall's sessions_out chain, and there is no connection now. The reason now is
# that this reads the unit's own journal, and the occupant of a slot is in no group that
# may -- which is the same reason it is not moved into the session.
#
# "!" and NOT "+", for the reason the ExecStartPre above sets out at length: "+" keeps
# BindPaths= and TemporaryFileSystem= while dropping ProtectHome=, which lands this
# unit's /home/user mount on the real /home.
#
# It depends on no position in this sequence, needs no credential, and names THIS start
# by INVOCATION_ID so that a journal holding other starts cannot be misread. Its wait
# expiring is a failure that says which thing it could not establish, never a pass.
ExecStartPost=!/usr/lib/hdw4s/hdw4s-webroot announced-gate %i
# WHERE THAT SAME LINE PUBLISHES HOW THE STARTUP HOLD ENDED, for the page to decide
# whether it may fit the desktop to the tab (hdw4s-webroot, publish_outcome). One
# directory of the web root, made writable inside this namespace and nothing else:
# ProtectSystem=strict keeps the rest of /usr read-only, and the directory is root's
# and 0755, so root (the "!" line above) can write it and the occupant cannot. The
# occupant writing anything the pool's one origin serves is the thing to never allow.
#
# "-" because a tree built by an older package has no such directory, and the
# answer then is that nobody publishes and the page does not resize -- never a
# session that fails to start. The path is the default HDW4S_WEBROOT_DIR, which a
# unit cannot expand; a tree elsewhere degrades the same way.
#
# NOT on the named unit, deliberately: its "ExecStartPre=+... provision" rebuilds the
# tree with "rm -rf", and "+" keeps this unit's mounts, so the directory would be a
# mount point there and the rebuild -- and the start -- would fail. A named desktop
# publishes nothing and its page does not resize.
ReadWritePaths=-/usr/share/hdw4s/webroot/%i/hdw4s-startup
# The one place in /run this session may create anything, and only because the
# directory beneath it is its own: ProtectSystem=strict makes the rest of /run
# read-only here, and <instance> itself is root's and 0711, so this lifts the
# read-only MOUNT and leaves the permissions to decide. No "-": hdw4s-stream@ has
# made it by now, and a session that cannot listen should fail naming the path.
ReadWritePaths=/run/hdw4s-stream/%i

[Install]
WantedBy=multi-user.target
