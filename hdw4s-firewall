#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

CONF='/etc/hdw4s/hdw4s.conf'
RULES='/etc/hdw4s/nftables.conf'

HDW4S_BASE_PORT=7300
HDW4S_BLOCK_SIZE=64
HDW4S_PROXIES=''
# shellcheck source=/dev/null
if [ -r "${CONF}" ]; then
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "${CONF}" || {
    echo "hdw4s: configuration file has a syntax error; refusing to run." >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "${CONF}" || :
fi

first="${HDW4S_BASE_PORT}"
last=$(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE - 1 ))
# A second block immediately above holds the loopback ports the sessions
# themselves listen on. The firewall has no need to cover those -- nothing off
# this machine can reach 127.0.0.1 -- but the kernel must still be told not to
# hand them out as ephemeral ports.
internal_last=$(( HDW4S_BASE_PORT + 2 * HDW4S_BLOCK_SIZE - 1 ))

# The rules cover the whole port block, not the ports that happen to be in use.
# A rule written per session goes stale the moment a session moves, which is
# exactly how a firewall ends up guarding a port nothing listens on while the
# live sessions sit unprotected next to it. Covering the block means the
# ruleset is correct before any session starts and stays correct afterwards.
generate() {
  local v4='' v6='' addr
  for addr in ${HDW4S_PROXIES}; do
    case "${addr}" in
      *:*) v6="${v6}${v6:+, }${addr}";;
      *)   v4="${v4}${v4:+, }${addr}";;
    esac
  done

  # The streaming server opens connection-candidate sockets on every address
  # it can find, in the ephemeral range, and offers no way to confine them.
  # They are not a way in on their own -- reaching one usefully needs
  # credentials exchanged over the signalling channel, which is authenticated
  # -- but they are unauthenticated listeners on whatever addresses the machine
  # has, including public ones, and that is not a thing to leave unmentioned.
  #
  # A new inbound connection to an ephemeral port is almost never legitimate:
  # that range belongs to the outgoing connections of local programs, whose
  # replies are already accepted above as established traffic. Dropping new
  # ones closes the candidate sockets without touching anything else.
  #
  # Set HDW4S_MEDIA_PORTS=direct for a deployment where the browser really does
  # reach the streaming server directly rather than through a proxy, which
  # needs those sockets reachable.
  local media_chain=''
  if [ "${HDW4S_MEDIA_PORTS:-proxied}" != 'direct' ]; then
    # Match the sockets themselves, not the ports they happen to be on. The
    # first version of this guessed by port range, on the reasoning that a new
    # inbound connection to an ephemeral port is rarely legitimate. That holds
    # for TCP and does not hold for UDP: WireGuard, mosh, Tailscale and NFSv3's
    # lock callbacks all take new inbound UDP on ports in that range, and a drop
    # in this table cannot be undone by any rule elsewhere. Since NFS-mounted
    # home directories are the case this package exists for, breaking lock
    # recovery to close a media socket was a bad trade.
    #
    # "socket cgroupv2" resolves the packet to its destination socket and looks
    # at the cgroup owning it, so this closes exactly the sockets belonging to a
    # session and nothing else on the machine, whatever port they picked. Level
    # 1 is the slice: sessions live at /hdw4s.slice/hdw4s-<name>.slice/... while
    # the relay that fronts the public port sits under system.slice, so the
    # front door stays open.
    # The slice has to exist before a rule can name it: nft resolves the path
    # to an inode at parse time and rejects the ruleset if it is not there.
    # Nothing creates it on its own -- it appears when the first session starts,
    # and this runs before any session can exist -- so without this the probe
    # failed on every boot and quietly installed the fallback instead.
    # Starting it explicitly also pins it, so the inode does not change when the
    # last session stops and the slice would otherwise be garbage collected.
    systemctl start hdw4s.slice >/dev/null 2>&1 || :

    # Probed against a slice that is always present, so a failure here means
    # what the message says it means rather than "the slice was missing".
    # Matching a cgroup by namespace-relative level was broken until kernel
    # 6.11 (nft_socket_cgroup_subtree_level). Below that, inside a container,
    # the level this rule names points at the container's own top slice instead
    # of ours -- the path exists, nft accepts the expression, and the rule then
    # matches nothing while looking perfectly healthy. A guard that cannot tell
    # you it is not guarding is worse than no guard, so where that combination
    # holds, use the port range and say why.
    local kmaj kmin kver cgroup_ok='yes'
    kver="$(uname -r)"; kmaj="${kver%%.*}"; kmin="${kver#*.}"; kmin="${kmin%%.*}"
    case "${kmaj}${kmin}" in
      *[!0-9]*) cgroup_ok='no';;
      *) if [ "${kmaj}" -lt 6 ] || { [ "${kmaj}" -eq 6 ] && [ "${kmin}" -lt 11 ]; }; then
           [ "$(systemd-detect-virt --container 2>/dev/null)" = 'none' ] || cgroup_ok='no'
         fi;;
    esac

    if [ "${cgroup_ok}" = 'yes' ] && [ -d /sys/fs/cgroup/hdw4s.slice ] &&
       nft -c -f - >/dev/null 2>&1 <<'PROBE'
table inet hdw4s_probe {
        chain c { type filter hook input priority filter; policy accept;
                socket cgroupv2 level 1 "system.slice" drop; }
}
PROBE
    then
      media_chain="$(cat <<'CHAIN'

        # Candidate sockets the streaming server opens on every address.
        chain media {
                type filter hook input priority filter; policy accept;

                # Everything that is not TCP or UDP leaves here. Socket lookup
                # resolves an ICMP error to the socket of the flow it refers
                # to, so without this an unreachable or fragmentation-needed
                # message for a session's own connection reaches the drop once
                # conntrack has forgotten the flow -- an intermittent path MTU
                # black hole, and a miserable one to diagnose.
                meta l4proto != { tcp, udp } accept
                ct state established,related accept
                iifname "lo" accept
                ip  saddr @proxies4 accept
                ip6 saddr @proxies6 accept
                socket cgroupv2 level 1 "hdw4s.slice" counter drop
        }
CHAIN
)"
    else
      # Older nftables or a kernel without socket matching. Fall back to the
      # port range, and say so, because the fallback has the side effects
      # described above.
      echo 'hdw4s: cannot match a session by its cgroup here; falling back to' >&2
      echo '       the ephemeral port range, which also drops new inbound UDP' >&2
      echo '       for anything else using that range (WireGuard, mosh, NFSv3' >&2
      echo '       lock callbacks). Set HDW4S_MEDIA_PORTS=direct to disable.' >&2
      local elo ehi
      read -r elo ehi < /proc/sys/net/ipv4/ip_local_port_range
      media_chain="$(cat <<CHAIN

        # Candidate sockets the streaming server opens on every address.
        chain media {
                type filter hook input priority filter; policy accept;

                meta l4proto != { tcp, udp } accept
                th dport != ${elo}-${ehi} accept
                ct state established,related accept
                iifname "lo" accept
                ip  saddr @proxies4 accept
                ip6 saddr @proxies6 accept
                counter drop
        }
CHAIN
)"
    fi
  fi

  cat <<EOF
#!/usr/sbin/nft -f
#
# Written by "hdw4s firewall --apply". Edit HDW4S_PROXIES in
# ${CONF} and run that command again rather than editing this file.
#
# This table restricts; it cannot grant. A drop here overrides any other
# table's accept, so the block can be closed reliably. An accept here is only
# advisory: if ufw or another firewall drops the packet first, nothing in this
# table can bring it back. Opening the block to a reverse proxy may therefore
# need a rule in whatever else manages this machine's firewall.

table inet hdw4s {}
delete table inet hdw4s

table inet hdw4s {
        set proxies4 {
                type ipv4_addr
                flags interval$( [ -z "${v4}" ] || printf '\n                elements = { %s }' "${v4}" )
        }

        set proxies6 {
                type ipv6_addr
                flags interval$( [ -z "${v6}" ] || printf '\n                elements = { %s }' "${v6}" )
        }

        chain input {
                type filter hook input priority filter; policy accept;

                # Leave immediately unless this is TCP addressed to a
                # session port. Both tests are needed: "tcp dport" cannot match
                # a packet that has no TCP header, so without the first line
                # every UDP and ICMP packet would fall past the port test and
                # reach the drop at the bottom. Getting out of the way quickly
                # is also what lets this table coexist with whatever else
                # filters the machine.
                meta l4proto != tcp accept
                tcp dport != ${first}-${last} accept

                ct state established,related accept
                iifname "lo" accept
                ip  saddr @proxies4 accept
                ip6 saddr @proxies6 accept

                # Addressed to a session, from somewhere not allowed.
                counter drop
        }
${media_chain}
}
EOF
}

cmd_apply() {
  install -d -m0755 "$(dirname "${RULES}")"

  # Tell the kernel never to hand these out as ephemeral ports. Without this a
  # session can fail to bind because an outgoing connection from anything else
  # on the machine happened to be holding its port, which is intermittent and
  # close to impossible to reproduce. The default ephemeral range starts at
  # 32768, so the block only has to stay below that; the reservation makes it
  # true even if an administrator widens the range later.
  printf '%s\n' \
    '# Written by "hdw4s firewall --apply". Do not edit.' \
    "net.ipv4.ip_local_reserved_ports = ${first}-${internal_last}" \
    > /etc/sysctl.d/60-hdw4s.conf
  sysctl -q -p /etc/sysctl.d/60-hdw4s.conf || :

  generate > "${RULES}.tmp"
  chmod 0644 "${RULES}.tmp"
  mv "${RULES}.tmp" "${RULES}"
  # nft applies a whole file as one transaction, so the table is never
  # half-replaced and a syntax error changes nothing.
  nft -f "${RULES}"
  if [ -z "${HDW4S_PROXIES}" ]; then
    echo "Sessions on ports ${first}-${last} accept loopback connections only."
    echo "Set HDW4S_PROXIES in ${CONF} to the reverse proxy's addresses."
  else
    echo "Sessions on ports ${first}-${last} accept connections from:"
    echo "  ${HDW4S_PROXIES}"
  fi
}

# Put the table back only if it is actually gone. Reapplying unconditionally
# every quarter of an hour would churn the ruleset and reset the counters for
# no reason; the point is to notice a table that vanished, not to keep
# rewriting one that is already correct.
cmd_restore() {
  if nft list table inet hdw4s >/dev/null 2>&1; then
    return 0
  fi
  echo 'hdw4s: the firewall table was missing; restoring it.' >&2
  echo '  Something flushed the ruleset -- ufw, netfilter-persistent and some' >&2
  echo '  configuration-management tools all do. Until now every session was' >&2
  echo '  reachable from anywhere this machine is.' >&2
  cmd_apply
}

# Addresses as the kernel would store them: lower-cased, and a prefix reduced
# to its network address, so that two spellings of one thing compare equal.
canon_addrs() {
  printf '%s' "$1" | tr '[:blank:]' '\n' | sed '/^$/d' |
    "${PYTHON:-python3}" -c '
import sys, ipaddress
out = []
for line in sys.stdin.read().split():
    try:
        out.append(str(ipaddress.ip_network(line, strict=False)))
    except ValueError:
        out.append(line.lower())
print(" ".join(sorted(set(out))))' 2>/dev/null ||
    # Without python3 the addresses cannot be canonicalised, but they can still
    # be ordered and de-duplicated, which is most of what the comparison needs.
    printf '%s' "$1" | tr '[:blank:]' '\n' | sed '/^$/d' | sort -u | tr '\n' ' '
}

cmd_check() {
  local rc=0 exposed='' state have_table='no'

  if nft list table inet hdw4s >/dev/null 2>&1; then
    have_table='yes'
    echo 'table       present'
  else
    echo "table       MISSING -- run 'hdw4s firewall --apply'"
    rc=1
  fi

  # What matters is not which port a session was allocated -- the socket unit
  # binds that, and it is inside the block by construction. It is whether
  # anything reachable from off this machine is listening outside the block,
  # where these rules do not apply. A session binds loopback and is fronted by
  # its socket; if one is bound to a real address instead, an override has put
  # it somewhere nothing is filtering.
  # UDP as well as TCP: the candidate sockets are mostly UDP, so a TCP-only
  # census reported a handful of sockets as the whole picture and called the
  # range covered on that basis. Two invocations rather than "-tu", because
  # asking for both at once prepends a Netid column and shifts the address one
  # field to the right, which silently turns the queue length into a port.
  # A failed census must not read as a clean one: empty output from a crashed
  # or missing ss would otherwise take the "nothing exposed" branch and report
  # success from a check that never ran.
  if ! { ss -Hltnp; ss -Hlunp; } >/dev/null 2>&1; then
    echo "ports       UNKNOWN -- could not list sockets"
    rc=1
  fi
  exposed="$({ ss -Hltnp; ss -Hlunp; } 2>/dev/null |
    awk -v a="${first}" -v b="${last}" '
      {
        addr = $4
        port = addr; sub(/.*:/, "", port)
        host = addr; sub(/:[^:]*$/, "", host)
        sub(/%.*/, "", host)                               # strip any %iface scope
        if (host ~ /^127\./ || host == "[::1]") next       # loopback is fine
        if (port + 0 >= a && port + 0 <= b) next            # inside the block
        if ($0 ~ /selkies|systemd-socket-|Xorg/) print port
      }' | sort -un | tr '\n' ' ')"

  # Most of what turns up here is the streaming server's connection-candidate
  # sockets, which it scatters across the ephemeral range on every address. They
  # are covered by the media chain unless that was turned off, so say which case
  # this is rather than printing thirty port numbers and leaving it to the
  # reader.
  local elo ehi ephemeral='' other=''
  read -r elo ehi < /proc/sys/net/ipv4/ip_local_port_range
  local p
  for p in ${exposed}; do
    if [ "${p}" -ge "${elo}" ] && [ "${p}" -le "${ehi}" ]; then
      ephemeral="${ephemeral} ${p}"
    else
      other="${other} ${p}"
    fi
  done

  if [ -n "${other}" ]; then
    echo "ports       NOT COVERED --${other}"
    echo "            reachable from off this machine and outside" \
         "${first}-${last},"
    echo '            so these rules do not apply to them'
    rc=1
  elif [ -z "${ephemeral}" ]; then
    echo "ports       nothing of ours is reachable outside ${first}-${last}"
  fi

  if [ -n "${ephemeral}" ]; then
    local n; n="$(echo "${ephemeral}" | wc -w)"
    if [ "${HDW4S_MEDIA_PORTS:-proxied}" = 'direct' ]; then
      echo "media       ${n} candidate socket(s) reachable by design"
      echo '            (HDW4S_MEDIA_PORTS=direct)'
    elif nft list chain inet hdw4s media >/dev/null 2>&1; then
      # nft prints the cgroup by resolving the number the kernel stored back to
      # a path. If the slice was destroyed and recreated -- a reboot, a stop, a
      # garbage collection of an empty slice -- the number no longer resolves
      # and prints as a bare integer, while the rule silently matches nothing.
      # Reading it back is the only way to tell a working rule from a dead one.
      local cg
      cg="$(nft -j list chain inet hdw4s media 2>/dev/null |
            "${PYTHON:-python3}" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
def walk(o):
    if isinstance(o,dict):
        if o.get("meta",{}).get("key")=="cgroupv2": return True
        for v in o.values():
            if walk(v): return True
    elif isinstance(o,list):
        for v in o:
            if walk(v): return True
    return False
for o in d.get("nftables",[]):
    r=o.get("rule")
    if r and walk(r.get("expr",[])):
        for e in r["expr"]:
            m=e.get("match")
            if m and walk(m.get("left")): print(m.get("right","")); sys.exit(0)' 2>/dev/null)"
      if [ -n "${cg}" ] && [ "${cg}" != 'hdw4s.slice' ]; then
        echo "media       STALE -- the rule no longer names hdw4s.slice (${cg});"
        echo "            it matches nothing. Run 'hdw4s firewall --apply'."
        rc=1
      else
        echo "media       ${n} candidate socket(s), covered by the media chain"
      fi
    else
      echo "media       ${n} candidate socket(s) NOT covered"
      echo "            run 'hdw4s firewall --apply' to add the media chain"
      rc=1
    fi
  fi

  state="$({ ss -Hltn; ss -Hlun; } 2>/dev/null |
           awk -v a="${first}" -v b="${last}" \
               '{ n = $4; sub(/.*:/, "", n)
                  if (n + 0 >= a && n + 0 <= b) print n }' |
           sort -un | tr '\n' ' ')"
  echo "listening  ${state:- (nothing in the block)}"

  # Read back what is loaded, not what the configuration says. Printing the
  # configured list meant editing HDW4S_PROXIES and forgetting to re-apply
  # produced a check that agreed with the file and told the administrator
  # nothing, while the running set still admitted the address that had just
  # been removed.
  local live=''
  if [ "${have_table}" = 'yes' ]; then
    live="$(nft -j list table inet hdw4s 2>/dev/null |
            "${PYTHON:-python3}" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
out=[]
for o in d.get("nftables",[]):
    st=o.get("set")
    if st and st.get("name") in ("proxies4","proxies6"):
        for e in st.get("elem",[]) or []:
            if isinstance(e,dict) and "prefix" in e:
                p=e["prefix"]; out.append("%s/%s"%(p["addr"],p["len"]))
            elif isinstance(e,dict) and "range" in e:
                out.append("-".join(e["range"]))
            elif isinstance(e,dict):
                continue
            else: out.append(str(e))
print(" ".join(out))' 2>/dev/null)"
  fi
  if [ -z "${live}" ]; then
    echo 'sources     loopback only'
  else
    echo "sources     ${live}"
  fi
  # Say so when the two disagree, rather than reporting either as the truth.
  # Both sides through the same normaliser. Comparing the strings directly
  # reported a difference between 2001:DB8::/32 and 2001:db8::/32, and between
  # 192.168.0.1/24 as written and 192.168.0.0/24 as the kernel stores it --
  # crying wolf on the one check an administrator is meant to believe.
  local want got
  want="$(canon_addrs "${HDW4S_PROXIES}")"
  got="$(canon_addrs "${live}")"
  if [ "${want}" != "${got}" ]; then
    echo "            CONFIGURED differs: ${HDW4S_PROXIES:-(none)}"
    echo "            run 'hdw4s firewall --apply' to load it"
    rc=1
  fi
  return "${rc}"
}

case "${1:-}" in
  --apply) cmd_apply;;
  --restore) cmd_restore;;
  --check)
    # A failing check is a result, not a fault: it means the table is missing
    # or a session is outside it, which is exactly what this is for. Report the
    # status without the error trap adding a line implying something went
    # wrong with the script itself.
    cmd_check && rc=0 || rc="$?"
    trap '' INT TERM QUIT HUP EXIT ERR
    exit "${rc}"
    ;;
  --print) generate;;
  *) echo 'Usage: hdw4s firewall --apply | --check | --print' >&2; exit 2;;
esac
