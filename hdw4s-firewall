#!/bin/bash -e
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

trap 'rc="$?"
      trap "" INT TERM QUIT HUP EXIT ERR
      [ "${rc}" -eq 0 ] || echo "Script ${0} failed unexpectedly" >&2
      exit "${rc}"' INT TERM QUIT HUP EXIT ERR

ETCDIR="${HDW4S_ETCDIR:-/etc/hdw4s}"
CONF="${ETCDIR}/hdw4s.conf"
# The slot table, so that --check can say whether every session that exists is
# one these rules cover. It lives with the configuration and is written by the
# CLI; nothing here modifies it.
SLOTS="${ETCDIR}/instances"
# Relocates with ETCDIR like everything else here, so that a sandboxed run
# writes its ruleset beside its own configuration instead of over the real one.
RULES="${ETCDIR}/nftables.conf"
# In /run, not beside the configuration: a lock file is state, not settings,
# and a machine running etckeeper commits every appearance of one in /etc.
LOCK='/run/hdw4s-firewall.lock'

HDW4S_BASE_PORT=7300
HDW4S_BLOCK_SIZE=64
HDW4S_PROXIES=''
# shellcheck source=/dev/null
if [ -r "${CONF}" ]; then
  f="${CONF}"
  # Checked before it is run. Sourcing a file with a syntax error
  # applies every assignment before the error and none after, and
  # the "|| :" below would hide that -- leaving the program running
  # on a configuration that is half the administrator's and half
  # the defaults, with nothing said.
  bash -n "${CONF}" || {
    echo "hdw4s: ${f} has a syntax error (above); refusing to run on a" >&2
    echo '  configuration that would be applied only as far as the error.' >&2
    echo '  Edit it by hand -- "hdw4s set" and "hdw4s unset" read the same' >&2
    echo '  file and are unavailable until it parses.' >&2
    exit 1
  }
  # A valid file may still end in a conditional that happens to be
  # false, which is not an error worth dying over.
  . "${CONF}" || :
fi

first="${HDW4S_BASE_PORT}"
last=$(( HDW4S_BASE_PORT + HDW4S_BLOCK_SIZE - 1 ))
# A second block immediately above holds the loopback ports the sessions
# themselves listen on. The firewall has no need to cover those -- nothing off
# this machine can reach 127.0.0.1 -- but the kernel must still be told not to
# hand them out as ephemeral ports.
internal_last=$(( HDW4S_BASE_PORT + 2 * HDW4S_BLOCK_SIZE - 1 ))

# The rules cover the whole port block, not the ports that happen to be in use.
# A rule written per session goes stale the moment a session moves, which is
# exactly how a firewall ends up guarding a port nothing listens on while the
# live sessions sit unprotected next to it. Covering the block means the
# ruleset is correct before any session starts and stays correct afterwards.
# Can this kernel match a socket's cgroup at all? Two callers now depend on the
# answer -- the media chain and the cross-reach chain -- so it is asked once,
# here, rather than twice in two places that would drift apart.
#
# Matching a cgroup by namespace-relative level was broken until kernel 6.11
# (nft_socket_cgroup_subtree_level). Below that, inside a container, the level a
# rule names points at the container's own top slice instead of ours -- the path
# exists, nft accepts the expression, and the rule then matches nothing while
# looking perfectly healthy. A guard that cannot tell you it is not guarding is
# worse than no guard, so where that combination holds we say so and do
# something else.
cgroup_level_usable() {
  local kmaj kmin kver
  kver="$(uname -r)"; kmaj="${kver%%.*}"; kmin="${kver#*.}"; kmin="${kmin%%.*}"
  case "${kmaj}${kmin}" in
    *[!0-9]*) return 1;;
  esac
  if [ "${kmaj}" -lt 6 ] || { [ "${kmaj}" -eq 6 ] && [ "${kmin}" -lt 11 ]; }; then
    [ "$(systemd-detect-virt --container 2>/dev/null)" = 'none' ] || return 1
  fi
  [ -d /sys/fs/cgroup/hdw4s.slice ]
}

generate() {
  local v4='' v6='' addr
  for addr in ${HDW4S_PROXIES}; do
    case "${addr}" in
      *:*) v6="${v6}${v6:+, }${addr}";;
      *)   v4="${v4}${v4:+, }${addr}";;
    esac
  done

  # The streaming server opens connection-candidate sockets on every address
  # it can find, in the ephemeral range, and offers no way to confine them.
  # They are not a way in on their own -- reaching one usefully needs
  # credentials exchanged over the signalling channel, which is authenticated
  # -- but they are unauthenticated listeners on whatever addresses the machine
  # has, including public ones, and that is not a thing to leave unmentioned.
  #
  # A new inbound connection to an ephemeral port is almost never legitimate:
  # that range belongs to the outgoing connections of local programs, whose
  # replies are already accepted above as established traffic. Dropping new
  # ones closes the candidate sockets without touching anything else.
  #
  # Set HDW4S_MEDIA_PORTS=direct for a deployment where the browser really does
  # reach the streaming server directly rather than through a proxy, which
  # needs those sockets reachable.
  local media_chain=''
  if [ "${HDW4S_MEDIA_PORTS:-proxied}" != 'direct' ]; then
    # Match the sockets themselves, not the ports they happen to be on. The
    # first version of this guessed by port range, on the reasoning that a new
    # inbound connection to an ephemeral port is rarely legitimate. That holds
    # for TCP and does not hold for UDP: WireGuard, mosh, Tailscale and NFSv3's
    # lock callbacks all take new inbound UDP on ports in that range, and a drop
    # in this table cannot be undone by any rule elsewhere. Since NFS-mounted
    # home directories are the case this package exists for, breaking lock
    # recovery to close a media socket was a bad trade.
    #
    # "socket cgroupv2" resolves the packet to its destination socket and looks
    # at the cgroup owning it, so this closes exactly the sockets belonging to a
    # session and nothing else on the machine, whatever port they picked. Level
    # 1 is the slice: sessions live at /hdw4s.slice/hdw4s-<name>.slice/... while
    # the relay that fronts the public port sits under system.slice, so the
    # front door stays open.
    # The slice has to exist before a rule can name it: nft resolves the path
    # to an inode at parse time and rejects the ruleset if it is not there.
    # Nothing creates it on its own -- it appears when the first session starts,
    # and this runs before any session can exist -- so without this the probe
    # failed on every boot and quietly installed the fallback instead.
    # Starting it explicitly also pins it, so the inode does not change when the
    # last session stops and the slice would otherwise be garbage collected.
    # Probed against a slice that is always present, so a failure here means
    # what the message says it means rather than "the slice was missing".
    # Matching a cgroup by namespace-relative level was broken until kernel
    # 6.11 (nft_socket_cgroup_subtree_level). Below that, inside a container,
    # the level this rule names points at the container's own top slice instead
    # of ours -- the path exists, nft accepts the expression, and the rule then
    # matches nothing while looking perfectly healthy. A guard that cannot tell
    # you it is not guarding is worse than no guard, so where that combination
    # holds, use the port range and say why.
    if cgroup_level_usable &&
       nft -c -f - >/dev/null 2>&1 <<'PROBE'
table inet hdw4s_probe {
        chain c { type filter hook input priority filter; policy accept;
                socket cgroupv2 level 1 "system.slice" drop; }
}
PROBE
    then
      media_chain="$(cat <<'CHAIN'

        # Candidate sockets the streaming server opens on every address.
        chain media {
                type filter hook input priority filter; policy accept;

                # Everything that is not TCP or UDP leaves here. Socket lookup
                # resolves an ICMP error to the socket of the flow it refers
                # to, so without this an unreachable or fragmentation-needed
                # message for a session's own connection reaches the drop once
                # conntrack has forgotten the flow -- an intermittent path MTU
                # black hole, and a miserable one to diagnose.
                meta l4proto != { tcp, udp } accept
                ct state established,related accept
                iifname "lo" accept
                ip  saddr @proxies4 accept
                ip6 saddr @proxies6 accept
                socket cgroupv2 level 1 "hdw4s.slice" counter drop
        }
CHAIN
)"
    else
      # Older nftables or a kernel without socket matching. Fall back to the
      # port range, and say so, because the fallback has the side effects
      # described above.
      echo 'hdw4s: cannot match a session by its cgroup here; falling back to' >&2
      echo '       the ephemeral port range, which also drops new inbound UDP' >&2
      echo '       for anything else using that range (WireGuard, mosh, NFSv3' >&2
      echo '       lock callbacks). Set HDW4S_MEDIA_PORTS=direct to disable.' >&2
      local elo ehi
      read -r elo ehi < /proc/sys/net/ipv4/ip_local_port_range
      media_chain="$(cat <<CHAIN

        # Candidate sockets the streaming server opens on every address.
        chain media {
                type filter hook input priority filter; policy accept;

                meta l4proto != { tcp, udp } accept
                th dport != ${elo}-${ehi} accept
                ct state established,related accept
                iifname "lo" accept
                ip  saddr @proxies4 accept
                ip6 saddr @proxies6 accept
                counter drop
        }
CHAIN
)"
    fi
  fi

  # ---- one desktop must not reach another --------------------------------
  #
  # A desktop is reached through its own front door, which is where
  # authentication happens. Nothing else on this machine has any business
  # opening a connection to a session port -- and a session least of all: an
  # ephemeral occupant is a stranger running untrusted code, and every other
  # visitor's desktop was one unauthenticated request away over loopback.
  # Measured, twice, at two depths, before this chain existed.
  #
  # WHY THE SENDER AND NOT THE PORT. The three obvious shapes were all wrong
  # here. Closing the port breaks the relay, which is the one caller that must
  # get through. Giving a session a credential is not available: a slot has none
  # and cannot be given one by design, and the standing ruling is that the repair
  # for a reachability problem is the transport rather than a secret. Naming each
  # session in a rule of its own goes stale the moment a slot moves -- the same
  # reasoning that keeps the input chain covering the whole block. What is left
  # is the property that actually distinguishes the two callers: the relay runs
  # under system.slice and a desktop runs under hdw4s.slice, whatever port,
  # whatever uid, and however many sessions exist. Nothing per-session is
  # recorded here, so nothing here can go stale.
  #
  # WHY uid 0 IS LET THROUGH, and it is not a hole. The session verifies its own
  # front door at startup -- "is this server really serving the gated client" --
  # and that request comes from inside the session's own cgroup. It is run as
  # root by the unit (ExecStartPost=!), which is a privilege the occupant does
  # not have: an ephemeral slot account is in no sudo-capable group, and on a
  # named session anyone who can become root can flush this table outright, so
  # the exception concedes nothing that was being defended. Measured before the
  # change: with a counting-only copy of this chain loaded, a session start
  # produced 11 packets from the occupant's uid to its own port and 0 from uid 0
  # -- which is exactly why moving that check is part of this change and not a
  # tidy-up. A drop without it stops every session from starting.
  #
  # BOTH BLOCKS, not just the internal one. The public block is what a named
  # session on the TCP transport listens on, and reaching it over loopback
  # bypasses the reverse proxy that enforces SSO -- the owner's own description
  # of this defect.
  #
  # "fib daddr type local" rather than a list of loopback addresses: the question
  # is "a session port on THIS machine", and that is what it asks. A session
  # whose HDW4S_ADDR was pointed at a real interface is covered without anyone
  # having to remember to widen an address list.
  #
  # reject, not drop: a refusal that hangs presents as a broken desktop and is
  # diagnosed for hours; a reset is immediate and reads as what it is, nothing
  # listening here for you.
  #
  # "meta skuid 0-4294967295" looks like a tautology and is not: a uid match
  # fails when the packet has no local sending socket at all, so the full range
  # is how the rule says "this really was sent by something on this machine".
  # Measured, and it is the difference between a refusal counter that means
  # something and one that does not. The socket expression falls back to a
  # lookup by address when the packet carries no sender, and on loopback that
  # lookup finds the DESTINATION -- a session's own listener, which is in
  # hdw4s.slice -- so two ownerless packets per session start were being
  # attributed to the sender's cgroup and refused. Nothing depended on them, but
  # a guard whose counter moves for traffic it was not built to stop cannot be
  # read, and this project reads that counter.
  local xreach_chain='' xreach_counters=''
  if cgroup_level_usable &&
     nft -c -f - >/dev/null 2>&1 <<'PROBE'
table inet hdw4s_probe {
	chain c {
		type filter hook output priority filter; policy accept;
		socket cgroupv2 level 1 "system.slice" fib daddr type local drop
	}
}
PROBE
  then
    xreach_counters="$(cat <<'COUNTERS'

        # Two counters, because one cannot answer the question. A rule that
        # matches nothing looks exactly like a rule that is never reached, and
        # the refusal counter is silent in both cases. "seen" moves for every
        # packet that reaches this chain, including the ones it then allows, so a
        # reading can tell a quiet guard from an absent one.
        counter hdw4s_xreach_seen {
        }

        counter hdw4s_xreach_refused {
        }
COUNTERS
)"
    xreach_chain="$(cat <<CHAIN

        # Connections from a desktop to a session port on this machine.
        chain sessions_out {
                type filter hook output priority filter; policy accept;

                meta l4proto != tcp accept
                tcp dport != ${first}-${internal_last} accept
                counter name "hdw4s_xreach_seen"

                # The session's own startup checks; see above.
                meta skuid 0 accept

                meta skuid 0-4294967295 socket cgroupv2 level 1 "hdw4s.slice" \
                        fib daddr type local \
                        counter name "hdw4s_xreach_refused" reject with tcp reset
        }
CHAIN
)"
  else
    echo 'hdw4s: this kernel cannot match a socket by its cgroup, so one' >&2
    echo '       desktop can reach another desktop on this machine directly,' >&2
    echo '       without passing the front door that authenticates. There is' >&2
    echo '       no port-range fallback for this one: the relay that serves' >&2
    echo '       every session talks to the same ports, so a range rule would' >&2
    echo '       either close the product or close nothing. Run sessions of' >&2
    echo '       one trust domain only on this machine, or move to a kernel' >&2
    echo '       6.11 or newer.' >&2
  fi

  cat <<EOF
#!/usr/sbin/nft -f
#
# Written by "hdw4s firewall --apply". Edit HDW4S_PROXIES in
# ${CONF} and run that command again rather than editing this file.
#
# This table restricts; it cannot grant. A drop here overrides any other
# table's accept, so the block can be closed reliably. An accept here is only
# advisory: if ufw or another firewall drops the packet first, nothing in this
# table can bring it back. Opening the block to a reverse proxy may therefore
# need a rule in whatever else manages this machine's firewall.

table inet hdw4s {}
delete table inet hdw4s

table inet hdw4s {${xreach_counters}

        set proxies4 {
                type ipv4_addr
                flags interval$( [ -z "${v4}" ] || printf '\n                elements = { %s }' "${v4}" )
        }

        set proxies6 {
                type ipv6_addr
                flags interval$( [ -z "${v6}" ] || printf '\n                elements = { %s }' "${v6}" )
        }

        chain input {
                type filter hook input priority filter; policy accept;

                # Leave immediately unless this is TCP addressed to a
                # session port. Both tests are needed: "tcp dport" cannot match
                # a packet that has no TCP header, so without the first line
                # every UDP and ICMP packet would fall past the port test and
                # reach the drop at the bottom. Getting out of the way quickly
                # is also what lets this table coexist with whatever else
                # filters the machine.
                meta l4proto != tcp accept
                tcp dport != ${first}-${last} accept

                ct state established,related accept
                iifname "lo" accept
                ip  saddr @proxies4 accept
                ip6 saddr @proxies6 accept

                # Addressed to a session, from somewhere not allowed.
                counter drop
        }
${media_chain}
${xreach_chain}
}
EOF
}

# The session-port range the loaded table really covers, as "low high", or
# nothing if the table is absent or its shape is not the one generate() writes.
# Recomputing this from the configuration would compare the configuration
# against itself; the whole point of the check is to catch a table that no
# longer matches the configuration it was built from.
live_range() {
  nft -j list chain inet hdw4s input 2>/dev/null |
  "${PYTHON:-python3}" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for o in d.get("nftables",[]):
    r=o.get("rule")
    if not r: continue
    for e in r.get("expr",[]):
        m=e.get("match")
        if not m: continue
        l=m.get("left",{})
        if not isinstance(l,dict): continue
        pl=l.get("payload",{})
        if pl.get("protocol")!="tcp" or pl.get("field")!="dport": continue
        rt=m.get("right")
        if isinstance(rt,dict) and "range" in rt:
            a,b=rt["range"][:2]
            print("%d %d"%(int(a),int(b))); sys.exit(0)
        if isinstance(rt,int):
            print("%d %d"%(rt,rt)); sys.exit(0)
' 2>/dev/null
}

# The cgroup a chain's socket-match rule actually names, as the kernel resolves
# it back to a path. nft stores the number, not the string: if the slice was
# destroyed and recreated -- a reboot, a stop, a garbage collection of an empty
# slice -- the number no longer resolves, it prints as a bare integer, and the
# rule silently matches nothing while looking perfectly healthy. Reading it back
# is the only way to tell a working rule from a dead one.
#
# One function for both chains. It was written twice before this, once per
# chain, which is two things to keep in step and one of them to forget.
rule_cgroup() {
  nft -j list chain inet hdw4s "$1" 2>/dev/null |
  "${PYTHON:-python3}" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
def walk(o):
    if isinstance(o,dict):
        if o.get("socket",{}).get("key")=="cgroupv2": return True
        for v in o.values():
            if walk(v): return True
    elif isinstance(o,list):
        for v in o:
            if walk(v): return True
    return False
for o in d.get("nftables",[]):
    r=o.get("rule")
    if r and walk(r.get("expr",[])):
        for e in r["expr"]:
            m=e.get("match")
            if m and walk(m.get("left")): print(m.get("right","")); sys.exit(0)' 2>/dev/null
}

# A named counter's packet count, or nothing if the object is not there.
counter_packets() {
  nft -j list counters 2>/dev/null |
  "${PYTHON:-python3}" -c '
import json,sys
want=sys.argv[1]
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
for o in d.get("nftables",[]):
    c=o.get("counter")
    if c and c.get("name")==want: print(c.get("packets")); sys.exit(0)' "$1" 2>/dev/null
}

cmd_apply() {
  # Here rather than in generate(), which "--print" also calls: printing a
  # ruleset is documented as showing what would be loaded without loading it,
  # and starting a unit is not that. Starting the slice explicitly also pins
  # it, so the cgroup the rule names is not garbage collected when the last
  # session stops.
  systemctl start hdw4s.slice >/dev/null 2>&1 || :

  install -d -m0755 "$(dirname "${RULES}")"

  # Tell the kernel never to hand these out as ephemeral ports. Without this a
  # session can fail to bind because an outgoing connection from anything else
  # on the machine happened to be holding its port, which is intermittent and
  # close to impossible to reproduce. The default ephemeral range starts at
  # 32768, so the block only has to stay below that; the reservation makes it
  # true even if an administrator widens the range later.
  printf '%s\n' \
    '# Written by "hdw4s firewall --apply". Do not edit.' \
    "net.ipv4.ip_local_reserved_ports = ${first}-${internal_last}" \
    > /etc/sysctl.d/60-hdw4s.conf
  sysctl -q -p /etc/sysctl.d/60-hdw4s.conf || :

  # nft applies a whole file as one transaction, so the table is never
  # half-replaced and a syntax error changes nothing. That is true of the
  # kernel and false of the file, which is why the check comes before the move
  # rather than after it: HDW4S_PROXIES accepts a hostname, nft does not
  # resolve one, and committing that ruleset leaves a file that fails to load
  # at every boot -- with hdw4s@.service requiring this unit, that is every
  # desktop on the machine, from one accepted setting.
  local tmp
  tmp="$(mktemp "${RULES}.XXXXXX")"
  generate > "${tmp}" || { rm -f "${tmp}"; return 1; }
  nft -c -f "${tmp}" || {
    rm -f "${tmp}"
    echo 'hdw4s: the generated ruleset was rejected; the firewall is' >&2
    echo '       unchanged. Check HDW4S_PROXIES in '"${CONF}"'; nft needs' >&2
    echo '       addresses, and does not resolve host names.' >&2
    return 1
  }
  chmod 0644 "${tmp}"
  mv "${tmp}" "${RULES}"
  nft -f "${RULES}"
  if [ -z "${HDW4S_PROXIES}" ]; then
    echo "Sessions on ports ${first}-${last} accept loopback connections only."
    echo "Set HDW4S_PROXIES in ${CONF} to the reverse proxy's addresses."
  else
    echo "Sessions on ports ${first}-${last} accept connections from:"
    echo "  ${HDW4S_PROXIES}"
  fi
}

# Put the table back only if it is actually gone. Reapplying unconditionally
# every quarter of an hour would churn the ruleset and reset the counters for
# no reason; the point is to notice a table that vanished, not to keep
# rewriting one that is already correct.
cmd_restore() {
  if nft list table inet hdw4s >/dev/null 2>&1; then
    return 0
  fi
  echo 'hdw4s: the firewall table was missing; restoring it.' >&2
  echo '  Something flushed the ruleset -- ufw, netfilter-persistent and some' >&2
  echo '  configuration-management tools all do. Until now every session was' >&2
  echo '  reachable from anywhere this machine is.' >&2
  cmd_apply
}

# Addresses as the kernel would store them: lower-cased, and a prefix reduced
# to its network address, so that two spellings of one thing compare equal.
canon_addrs() {
  printf '%s' "$1" | tr '[:blank:]' '\n' | sed '/^$/d' |
    "${PYTHON:-python3}" -c '
import sys, ipaddress
out = []
for line in sys.stdin.read().split():
    try:
        out.append(str(ipaddress.ip_network(line, strict=False)))
    except ValueError:
        out.append(line.lower())
print(" ".join(sorted(set(out))))' 2>/dev/null ||
    # Without python3 the addresses cannot be canonicalised, but they can still
    # be ordered and de-duplicated, which is most of what the comparison needs.
    printf '%s' "$1" | tr '[:blank:]' '\n' | sed '/^$/d' | sort -u | tr '\n' ' '
}

cmd_check() {
  local rc=0 exposed='' state have_table='no' p

  if nft list table inet hdw4s >/dev/null 2>&1; then
    have_table='yes'
    echo 'table       present'
  else
    echo "table       MISSING -- run 'hdw4s firewall --apply'"
    rc=1
  fi

  # Every session that has been allocated a slot, and whether the port it was
  # given is one these rules actually cover. The comment below is right that a
  # slot's port is inside the block by construction -- but only while the block
  # is the one the table was built from. Raise HDW4S_BLOCK_SIZE, allocate a
  # slot beyond the old range, and forget to re-apply, and the session listens
  # on a port with nothing in front of it. Reading the table is the only way to
  # say "every session is filtered" and mean it.
  local sfirst slast n_sessions=0 n_outside=0 idx inst
  sfirst=''; slast=''
  read -r sfirst slast <<<"$(live_range)" || :
  if [ -z "${sfirst:-}" ]; then
    # No table, or one this version does not recognise. Say so rather than
    # falling back to the configured range, which would answer the question
    # with the very number the check exists to verify.
    echo 'sessions    cannot tell -- the loaded table has no recognisable'
    echo "            session-port rule; run 'hdw4s firewall --apply'"
    rc=1
  elif [ -r "${SLOTS}" ]; then
    while read -r idx inst _; do
      case "${idx}" in ''|\#*) continue;; esac
      case "${idx}" in *[!0-9]*) continue;; esac
      n_sessions=$(( n_sessions + 1 ))
      p=$(( HDW4S_BASE_PORT + idx ))
      if [ "${p}" -lt "${sfirst}" ] || [ "${p}" -gt "${slast}" ]; then
        echo "sessions    ${inst} was allocated port ${p}, outside ${sfirst}-${slast}"
        n_outside=$(( n_outside + 1 ))
      fi
    done < "${SLOTS}"
  fi
  if [ "${n_outside}" -gt 0 ]; then
    echo "            ${n_outside} of ${n_sessions} not covered -- run 'hdw4s firewall --apply'"
    rc=1
  elif [ "${n_sessions}" -gt 0 ]; then
    echo "sessions    ${n_sessions}, all within the loaded range ${sfirst}-${slast}"
  elif [ -n "${sfirst}" ]; then
    echo 'sessions    none allocated'
  fi

  # What matters is not which port a session was allocated -- the socket unit
  # binds that, and it is inside the block by construction. It is whether
  # anything reachable from off this machine is listening outside the block,
  # where these rules do not apply. A session binds loopback and is fronted by
  # its socket; if one is bound to a real address instead, an override has put
  # it somewhere nothing is filtering.
  # UDP as well as TCP: the candidate sockets are mostly UDP, so a TCP-only
  # census reported a handful of sockets as the whole picture and called the
  # range covered on that basis. Two invocations rather than "-tu", because
  # asking for both at once prepends a Netid column and shifts the address one
  # field to the right, which silently turns the queue length into a port.
  # A failed census must not read as a clean one: empty output from a crashed
  # or missing ss would otherwise take the "nothing exposed" branch and report
  # success from a check that never ran.
  if ! { ss -Hltnp; ss -Hlunp; } >/dev/null 2>&1; then
    echo "ports       UNKNOWN -- could not list sockets"
    rc=1
  fi
  exposed="$({ ss -Hltnp; ss -Hlunp; } 2>/dev/null |
    awk -v a="${first}" -v b="${last}" '
      {
        addr = $4
        port = addr; sub(/.*:/, "", port)
        host = addr; sub(/:[^:]*$/, "", host)
        sub(/%.*/, "", host)                               # strip any %iface scope
        if (host ~ /^127\./ || host == "[::1]") next       # loopback is fine
        if (port + 0 >= a && port + 0 <= b) next            # inside the block
        if ($0 ~ /selkies|systemd-socket-|Xorg/) print port
      }' | sort -un | tr '\n' ' ')"

  # Most of what turns up here is the streaming server's connection-candidate
  # sockets, which it scatters across the ephemeral range on every address. They
  # are covered by the media chain unless that was turned off, so say which case
  # this is rather than printing thirty port numbers and leaving it to the
  # reader.
  local elo ehi ephemeral='' other=''
  read -r elo ehi < /proc/sys/net/ipv4/ip_local_port_range
  local p
  for p in ${exposed}; do
    if [ "${p}" -ge "${elo}" ] && [ "${p}" -le "${ehi}" ]; then
      ephemeral="${ephemeral} ${p}"
    else
      other="${other} ${p}"
    fi
  done

  if [ -n "${other}" ]; then
    echo "ports       NOT COVERED --${other}"
    echo "            reachable from off this machine and outside" \
         "${first}-${last},"
    echo '            so these rules do not apply to them'
    rc=1
  elif [ -z "${ephemeral}" ]; then
    echo "ports       nothing of ours is reachable outside ${first}-${last}"
  fi

  if [ -n "${ephemeral}" ]; then
    local n; n="$(echo "${ephemeral}" | wc -w)"
    if [ "${HDW4S_MEDIA_PORTS:-proxied}" = 'direct' ]; then
      echo "media       ${n} candidate socket(s) reachable by design"
      echo '            (HDW4S_MEDIA_PORTS=direct)'
    elif nft list chain inet hdw4s media >/dev/null 2>&1; then
      # nft prints the cgroup by resolving the number the kernel stored back to
      # a path. If the slice was destroyed and recreated -- a reboot, a stop, a
      # garbage collection of an empty slice -- the number no longer resolves
      # and prints as a bare integer, while the rule silently matches nothing.
      # Reading it back is the only way to tell a working rule from a dead one.
      local cg
      cg="$(rule_cgroup media)"
      # The two forms have opposite blind spots, so which one is loaded is
      # the answer an administrator actually needs. Naming the form is also
      # the only way to notice that a machine fell back to the port range
      # without anyone reading the boot log the day it happened.
      if [ -z "${cg}" ]; then
        echo "media       ${n} candidate socket(s), covered by port range"
        echo '            (fallback form: also drops new inbound UDP in the'
        echo '            ephemeral range for everything else on this machine)'
      elif [ "${cg}" != 'hdw4s.slice' ]; then
        echo "media       STALE -- the rule no longer names hdw4s.slice (${cg});"
        echo "            it matches nothing. Run 'hdw4s firewall --apply'."
        rc=1
      else
        echo "media       ${n} candidate socket(s), covered by cgroup match"
        echo '            (matches session sockets only, whatever port)'
      fi
    else
      echo "media       ${n} candidate socket(s) NOT covered"
      echo "            run 'hdw4s firewall --apply' to add the media chain"
      rc=1
    fi
  fi

  # Whether one desktop can reach another. Read from the loaded table and from
  # the counters, never from this script's own opinion of what it would have
  # generated -- a check that recomputes the answer compares the configuration
  # against itself.
  if nft list chain inet hdw4s sessions_out >/dev/null 2>&1; then
    local xcg seen refused
    xcg="$(rule_cgroup sessions_out)"
    if [ "${xcg}" != 'hdw4s.slice' ]; then
      echo "cross-reach  STALE -- the rule no longer names hdw4s.slice (${xcg:-none});"
      echo "            one desktop can reach another. Run 'hdw4s firewall --apply'."
      rc=1
    else
      seen="$(counter_packets hdw4s_xreach_seen)"
      refused="$(counter_packets hdw4s_xreach_refused)"
      # The pair, not either alone. "refused 0" means the guard has never
      # refused anything, which is the expected state of a machine nobody has
      # attacked -- and also the state of a rule that is never reached. "seen"
      # is what separates them: every session that starts moves it.
      echo "cross-reach  closed (seen ${seen:-?}, refused ${refused:-?} since the table was loaded)"
      if [ "${seen:-0}" = '0' ]; then
        echo '            nothing has reached this chain yet, so the refusal'
        echo '            count says nothing; start a session and look again'
      fi
    fi
  else
    echo 'cross-reach  NOT CLOSED -- a desktop can open a connection to another'
    echo "            desktop on this machine. Run 'hdw4s firewall --apply',"
    echo '            and read its output: on a kernel that cannot match a'
    echo '            socket by cgroup there is no fallback for this.'
    rc=1
  fi

  state="$({ ss -Hltn; ss -Hlun; } 2>/dev/null |
           awk -v a="${first}" -v b="${last}" \
               '{ n = $4; sub(/.*:/, "", n)
                  if (n + 0 >= a && n + 0 <= b) print n }' |
           sort -un | tr '\n' ' ')"
  echo "listening  ${state:- (nothing in the block)}"

  # Read back what is loaded, not what the configuration says. Printing the
  # configured list meant editing HDW4S_PROXIES and forgetting to re-apply
  # produced a check that agreed with the file and told the administrator
  # nothing, while the running set still admitted the address that had just
  # been removed.
  local live=''
  if [ "${have_table}" = 'yes' ]; then
    live="$(nft -j list table inet hdw4s 2>/dev/null |
            "${PYTHON:-python3}" -c '
import json,sys
try: d=json.load(sys.stdin)
except Exception: sys.exit(0)
out=[]
for o in d.get("nftables",[]):
    st=o.get("set")
    if st and st.get("name") in ("proxies4","proxies6"):
        for e in st.get("elem",[]) or []:
            if isinstance(e,dict) and "prefix" in e:
                p=e["prefix"]; out.append("%s/%s"%(p["addr"],p["len"]))
            elif isinstance(e,dict) and "range" in e:
                out.append("-".join(e["range"]))
            elif isinstance(e,dict):
                continue
            else: out.append(str(e))
print(" ".join(out))' 2>/dev/null)"
  fi
  if [ -z "${live}" ]; then
    echo 'sources     loopback only'
  else
    echo "sources     ${live}"
  fi
  # Say so when the two disagree, rather than reporting either as the truth.
  # Both sides through the same normaliser. Comparing the strings directly
  # reported a difference between 2001:DB8::/32 and 2001:db8::/32, and between
  # 192.168.0.1/24 as written and 192.168.0.0/24 as the kernel stores it --
  # crying wolf on the one check an administrator is meant to believe.
  local want got
  want="$(canon_addrs "${HDW4S_PROXIES}")"
  got="$(canon_addrs "${live}")"
  if [ "${want}" != "${got}" ]; then
    echo "            CONFIGURED differs: ${HDW4S_PROXIES:-(none)}"
    echo "            run 'hdw4s firewall --apply' to load it"
    rc=1
  fi
  return "${rc}"
}

case "${1:-}" in
  --apply|--restore)
    # The 15-minute check timer can call --restore while an administrator is
    # running --apply. Both write the same ruleset file and both load a table;
    # letting them interleave means one truncating the file the other is
    # reading. The lock is held for the whole operation, not just the write.
    install -d -m0755 "$(dirname "${LOCK}")"
    exec 9>"${LOCK}"
    flock 9
    case "$1" in --apply) cmd_apply;; *) cmd_restore;; esac
    ;;
  --check)
    # A failing check is a result, not a fault: it means the table is missing
    # or a session is outside it, which is exactly what this is for. Report the
    # status without the error trap adding a line implying something went
    # wrong with the script itself.
    cmd_check && rc=0 || rc="$?"
    trap '' INT TERM QUIT HUP EXIT ERR
    exit "${rc}"
    ;;
  --print) generate;;
  *) echo 'Usage: hdw4s firewall --apply | --check | --print' >&2; exit 2;;
esac
