[Unit]
Description=Connection relay for the HDW4S session %i
Documentation=man:hdw4s(8)
# Which session unit stands behind this relay is deliberately NOT named here.
# There is more than one kind of session now, and a dependency cannot be undone
# by a drop-in: an empty "Requires=" does not reset the list -- measured on
# systemd 255, the original was still there afterwards -- so a template naming
# one unit could never be pointed at another. "hdw4s enable" writes it per
# instance, exactly as it already writes the port, and for the same reason.
Requires=hdw4s-proxy@%i.socket
After=hdw4s-proxy@%i.socket

[Service]
# systemd's own relay, so there is no new daemon and nothing of ours in the
# data path. The session listens on loopback only; this is what the outside
# world reaches, and the port it forwards to comes from a drop-in written by
# "hdw4s enable", because a template unit cannot work it out from %i.
ExecStartPre=/usr/lib/hdw4s/hdw4s-wait %i
ExecStart=/usr/lib/systemd/systemd-socket-proxyd 127.0.0.1:1
CapabilityBoundingSet=
DynamicUser=yes
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
Type=notify
# A cold start waits for the desktop to come up behind it.
TimeoutStartSec=180
