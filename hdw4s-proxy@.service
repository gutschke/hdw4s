[Unit]
Description=Connection relay for the HDW4S session %i
Documentation=man:hdw4s(8)
# Which session unit stands behind this relay is deliberately NOT named here.
# There is more than one kind of session now, and a dependency cannot be undone
# by a drop-in: an empty "Requires=" does not reset the list -- measured on
# systemd 255, the original was still there afterwards -- so a template naming
# one unit could never be pointed at another. "hdw4s enable" writes it per
# instance, exactly as it already writes the port, and for the same reason.
Requires=hdw4s-proxy@%i.socket
After=hdw4s-proxy@%i.socket
# A relay that fails to start leaves the connection that woke it in the accept
# queue, so systemd starts the relay again at once, and keeps doing so until a
# rate limit fires and the front door latches off -- after which that desktop is
# unreachable until an admin intervenes. Measured: sixty arrivals at a slot whose
# relay fails instantly ended in "failed / service-start-limit-hit", and with the
# service's start limit disarmed the socket's trigger limit latches it instead,
# so raising either one only moves the latch.
#
# The queue therefore has to be drained rather than rate-limited, and draining it
# is the same act as telling the person on the other end what happened. With this
# line the same sixty arrivals each got a 503 page and the socket stayed active.
OnFailure=hdw4s-refuse@%i.service

[Service]
# systemd's own relay, so there is no new daemon and nothing of ours in the
# data path. The session listens on loopback only; this is what the outside
# world reaches, and the port it forwards to comes from a drop-in written by
# "hdw4s enable", because a template unit cannot work it out from %i.
#
# Two measured facts for anyone who replaces this with a front door of ours,
# because both were expensive and both are counter-intuitive. Kept here rather
# than in a design note: this is the file whose claim they revise.
#
# 1. A CONNECTION-LEVEL SPLICER CANNOT CARRY IDENTITY; A PER-REQUEST ROUTER CAN.
#    The obvious cheap shape -- read the first request's headers, pick a
#    backend, then become a byte pipe -- is unsound, and not by a little.
#    HTTP/1.1 pools connections per ORIGIN, so two sessions on one hostname
#    under different paths are the same origin and request 2 is delivered to
#    request 1's backend. Measured with two stand-in backends, one connection
#    per request as the control: the control routed both correctly and the
#    pooled case mis-routed, so the failure is the pooling and not a broken rig.
#    That is a cross-session read, not a cosmetic mis-render.
#    A second run then bounded the finding, because the first wording had grown
#    into a general law ("only the address the connection was made to survives
#    pooling") that would have ruled out the one-hostname model on a false
#    premise. Three arms, the splicer kept in as a control so a pass could not
#    come from a broken rig: splicer mis-routed; a per-request router routed
#    both correctly; an upgrade on one path followed by a plain request on
#    another connection also routed correctly. So pooling defeats SPLICING, not
#    path identity. Anything that parses every request sees the path on every
#    request.
#    The price is not correctness, it is availability: a component of ours that
#    parses everything is one component whose failure takes every session, where
#    a socket-proxyd failure takes exactly one. Keep the listening socket in a
#    socket unit, as it is today, so a crash loses in-flight connections and
#    systemd hands the next one to a restarted router.
#    THE FALSE GREEN THIS NEARLY PRODUCED, and it will catch the next person: a
#    stand-in reverse proxy at its DEFAULTS opens a fresh upstream connection
#    per request and does not reproduce this at all. A test of any router that
#    does not explicitly enable upstream keep-alive passes while the defect is
#    live behind proxies that pool by default.
#
# 2. A PATH PREFIX IS A ROUTING KEY AND A REFUSAL. IT IS NOT A SECRET.
#    Giving each session its own URL prefix does buy a real refusal, and it is
#    worth having: a visitor with the hostname but not the prefix gets 404
#    immediately, where otherwise they get a long hang or somebody's live
#    desktop. Measured.
#    But it cannot be the capability. The streaming server runs AS the session's
#    own uid inside the session's namespace, so every setting it is given sits
#    in its own /proc/<pid>/environ, which that uid may read by definition, and
#    which hiding other processes does not touch -- that hides other processes,
#    not your own. Measured, both the prefix and the proxy credential beside it.
#    Code running in the desktop can therefore read its own share link and hand
#    it out, and a path carries no role, so whoever takes it gets interactive
#    control. Sound where the occupant owns the session; wrong for a session
#    type whose premise is that the code inside it is untrusted.
#    So the capability is held and validated by the router, BEFORE any byte
#    reaches a session, and nothing secret is passed downstream.
ExecStartPre=/usr/lib/hdw4s/hdw4s-wait %i
# THE UPSTREAM IS A PATH, AND THE SAME ONE FOR EVERY INSTANCE, so it is written here
# and not per instance: /run/hdw4s/stream/<instance>/s/stream.sock, made for each
# session start by hdw4s-stream@ (see hdw4s-stream-dir for why a path and not a
# port). A per-instance "ExecStart=" drop-in naming a loopback port is the shape
# this replaced; the installer removes the ones it wrote.
ExecStart=/usr/lib/systemd/systemd-socket-proxyd /run/hdw4s/stream/%i/s/stream.sock
# The group that may enter a stream directory. The relay is its only member.
SupplementaryGroups=hdw4s-relay

# THIS RELAY CAN SEE ONE STREAM DIRECTORY AND NOTHING ELSE UNDER /run, and that is
# what stops a desktop redirecting it. The directory "s" belongs to the session's
# occupant, who may replace stream.sock with a SYMLINK -- to another slot's
# stream.sock, to another slot's front door in /run/hdw4s/proxy, to anything that
# accepts -- and connect() follows symlinks. Permissions cannot refuse that: this
# relay is in the group that enters EVERY stream directory, by design. So the
# namespace refuses it instead: an empty /run, with only this instance's directory
# bound back in. A symlink to anywhere else in /run resolves to nothing here.
#
# Outside /run it sees what every namespaced service on the machine sees,
# /shared included: the table, mounted nosymfollow. So stream.sock may be pointed
# at a socket somebody bound in the table -- which every desktop can already
# connect to directly, and which the sweep removes -- so it opens no path between
# desktops. The barrier above is about /run, where the other desktops' streams are.
#
# <instance>, not <instance>/s: "s" is removed at every stop and remade at every
# start, and a pool relay outlives its session, so a bind of "s" would go on showing
# the removed one. <instance> is root's and permanent.
#
# /run/systemd/notify is bound back for Type=notify. /run/hdw4s/proxy needs no line:
# the front socket arrives as a file descriptor, and under the empty /run the
# directory is simply absent. Mounts apply sorted by destination, so the empty /run
# goes down before the two paths bound into it.
TemporaryFileSystem=/run
BindReadOnlyPaths=/run/hdw4s/stream/%i
BindReadOnlyPaths=/run/systemd/notify
CapabilityBoundingSet=
DynamicUser=yes
NoNewPrivileges=yes
# Nothing of another process is this relay's business, and its DynamicUser= uid
# is shared by no one else -- so none of /proc need be visible to it.
ProtectProc=invisible
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectSystem=strict
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallFilter=@system-service
Type=notify
# A cold start waits for the desktop to come up behind it.
TimeoutStartSec=180
