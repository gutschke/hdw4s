#!/bin/bash -e
# Build the web root an ephemeral session is served from, and refuse to hand over one
# that is not gated.
#
# The product needs a handful of things the packaged web client cannot be asked for: a
# session that is not taken over the instant a second tab loads, a name in the browser
# tab, and something to say when a session is taken away. Selkies has a supported seam
# for this -- "--web-root <dir>" serves that directory instead of the packaged one -- so
# none of it needs a patched package or an upstream change.
#
# THE TREE IS BUILT BY COPY-PLUS-OVERLAY, NEVER BY HAND. The packaged tree carries files
# this script does not know about -- icons, a manifest, jsdb/ -- and upstream adds more.
# A handcrafted directory silently drops whatever was not enumerated, and breaks one
# release later when something new appears. So: copy all of it, then replace exactly two
# files.
#
# The gate itself is made by SUBTRACTION. Upstream's index.html is taken as-is and only
# its module <script> is removed; that removal IS the gate, because both transports evict
# on connect and a client that never loads never connects. Everything else upstream ships
# stays byte for byte.
#
# WHY SELKIES' OWN FALLBACK IS NOT ENOUGH. If the directory is missing or unreadable,
# stream_server.py logs one warning and serves the packaged client. The session then
# starts, notifies ready, the relay comes up, and every state check in this product
# reports health -- while the gate is simply absent and the next arrival silently takes
# somebody's desktop, which is the whole thing it exists to prevent. A feature that fails
# open to the defect it fixes has to be checked by us, loudly, before the session is
# declared up. That is what --check is for.
export LC_ALL='C'
export PATH='/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin'
set -o nounset -o pipefail

MARKER='hdw4s-gate'
# Where hdw4s-incarnation records the identity of the current start. A tmpfs, so
# the record dies with the session while the copy published into the web root
# does not -- which is the asymmetry the carry-across below depends on.
# Overridable for the same reason every other written path in this package is:
# otherwise a test asserting "the session is running" can only simulate it by
# leaving a token lying about, which is the very conflation that produced the
# bug this variable exists to let us test.
INCARNATION_DIR="${HDW4S_INCARNATION_DIR:-/run/hdw4s-incarnation}"
die() { echo "hdw4s-webroot: $*" >&2; exit 1; }

usage() {
  cat >&2 <<EOF
usage: hdw4s-webroot build     [--directory] <instance> <web-root> [<session name>]
       hdw4s-webroot provision [--directory] <instance> [<session name>]
       hdw4s-webroot check     <web-root> [<instance>]
       hdw4s-webroot gate      <instance>
       hdw4s-webroot serving <url> [--auth-stdin] [<curl args>...]
       hdw4s-webroot serving-gate <instance>

  --directory   this instance is reached through a door that ALSO serves
                /sessions/, the session directory, so the boot card may offer a
                link to it. Only the ephemeral pool's door does; a named
                desktop's door is systemd-socket-proxyd in front of Selkies and
                answers 404 there. Absent means no link, which is the safe way
                round: a card that stays quiet is never wrong.

  --auth-stdin  read a curl config line ("user = <user>:<password>") from stdin
                and hand it to curl as its own config. Never pass a credential
                as an argument: /proc/<pid>/cmdline is readable by every process
                of this uid, and in an ephemeral session that is the occupant.
EOF
  exit 2
}

# The packaged client, asked of the interpreter that will serve it rather than guessed
# from a path: a venv, a distribution package and a wheel put it in different places, and
# the one that matters is the one the running server imports.
packaged_web() {
  "${HDW4S_SELKIES_PY:-/opt/selkies/bin/python3}" - <<'PY' 2>/dev/null
import os, selkies
print(os.path.join(os.path.dirname(selkies.__file__), "selkies_web"))
PY
}

cmd_build() {
  # PASSED BY THE CALLER, NOT LOOKED UP HERE, and that is deliberate. The slot
  # table already has three parsers that agree by coincidence, and a fourth one
  # in this script would be a fourth chance to disagree about what a row means.
  # It does not need one: there are exactly two callers that build a web root
  # and each of them knows by construction which kind it is building --
  # hdw4s@.service provisions one named desktop, hdw4s-ephemeral-slots builds
  # the pool. So the fact travels from the only places that already hold it.
  local directory='no'
  if [ "${1:-}" = '--directory' ]; then directory='yes'; shift; fi
  local inst="$1" root="$2" name="${3:-Desktop}" src
  src="$(packaged_web)" || die 'could not locate the packaged web client'
  [ -d "${src}" ] || die "packaged web client not found at '${src}'"
  [ -r "${src}/index.html" ] || die "no index.html in '${src}'"

  # Built beside the live tree and swapped into place, never over it. A re-mint on a
  # running system rebuilds slots that are already serving, and "rm -rf" first means a
  # generator that fails for any reason leaves a slot with no client at all -- fail-closed
  # at the cost of a working tree it had no reason to destroy.
  #
  # Under a lock, because the swap below is not atomic against a second builder and there
  # is more than one caller: the slot minter rebuilds every slot, and an upgrade now runs
  # the minter on a system where a slot may already be building. Two unsynchronised
  # builders are not a race that loses an update -- "rm -rf" then "mv" means the second
  # one's "mv" finds the directory back in place and moves the staging tree INSIDE it, so
  # the slot ends up with no index.html at all and refuses to start for a reason nothing
  # in the message points at.
  mkdir -p "$(dirname "${root}")"
  exec 9>"$(dirname "${root}")/.hdw4s-webroot.lock" || die 'could not open the build lock'
  flock 9 || die 'could not take the build lock'

  local stage="${root}.new.$$"
  rm -rf "${stage}"
  cp -a "${src}" "${stage}"

  # Carry the running session's published identity across the swap. The packaged tree
  # has no hdw4s-incarnation, so the copy above silently drops the one the live tree is
  # serving -- measured on a live slot, where a re-mint had stripped it and nothing
  # noticed for a day.
  #
  # Preserved rather than regenerated, and that is the whole point: a re-mint rebuilds
  # the CLIENT, it does not restart the session, so the incarnation has not changed and
  # the old value is still the true one. Minting a new value here would tell every
  # returning tab that its desktop had been replaced when it had not. Dropping it
  # instead leaves a returning tab unable to tell this desktop from a different one,
  # which is the entire reason the token exists.
  #
  # Nothing fails when it goes missing: hdw4s-webroot check only looks for the token
  # when it is given an instance, which the builder never does, and the next session
  # start republishes one. So this is silent in both directions and has to be held
  # here, at the one place that can destroy it.
  #
  # CARRY IT ONLY IF THE SESSION IT DESCRIBES IS STILL RUNNING, and the /run
  # record is how that is known: hdw4s-incarnation writes it at each start and
  # /run is a tmpfs, so the record dies with the session while the published
  # copy on disk does not. Measured across a reboot on 2026-09-22: two slots
  # served tokens minted before the boot, with no record left to contradict
  # them. The published copy is the one a tab reads to decide "this is the
  # desktop I had" -- so a returning tab compares its remembered token against a
  # stale one, finds them equal, and takes the silent-resume path for a desktop
  # that no longer exists. That is the logged-out row collapsing into the resume
  # row, which is the one outcome the arrival design exists to prevent.
  #
  # The reason above is still true and still applies: a rebuild does not restart
  # the session. It simply stops being true at a boot, and nothing here
  # distinguished the two because when it was written only one existed.
  #
  # "check" below already treats the record as authoritative and dies when the
  # served token does not match it. This is the same dependency, in the one
  # place that can create the mismatch rather than the one that reports it.
  if [ -s "${root}/hdw4s-incarnation" ] &&
     { [ -z "${inst}" ] || [ -s "${INCARNATION_DIR}/${inst}" ]; }; then
    cp -a "${root}/hdw4s-incarnation" "${stage}/hdw4s-incarnation" ||
      die 'could not carry the published identity across the rebuild'
  fi

  HDW4S_SESSION_NAME="${name}" HDW4S_DIRECTORY="${directory}" \
    "${HDW4S_LIBDIR:-/usr/lib/hdw4s}/hdw4s-gate-index" \
      "${src}/index.html" "${stage}/index.html" || die 'could not build the gated index'

  # The tab's name comes from the manifest, which the client fetches and applies to
  # document.title. It is a generated JSON file in the packaged tree, so a per-session
  # name costs one rewrite and no client change at all.
  if [ -r "${stage}/manifest.json" ]; then
    python3 - "${stage}/manifest.json" "${name}" <<'PY' || die 'could not set the manifest name'
import json, sys
p, name = sys.argv[1], sys.argv[2]
m = json.load(open(p))
m["name"] = m["short_name"] = name
json.dump(m, open(p, "w"))
PY
  fi
  # The upstream document is the generator's INPUT and is not left where the server can
  # reach it: an ungated copy served beside the gated one hands the next arrival exactly
  # what the gate exists to prevent, to anyone who knows the filename.
  rm -f "${stage}/index.upstream.html"
  # Checked while it is still a staging tree, so a tree that fails never becomes the
  # one being served.
  cmd_check "${stage}"
  rm -rf "${root}"
  # -T, so that a "${root}" which is somehow still there is an error rather than a
  # staging tree quietly nested one level down inside it.
  mv -T "${stage}" "${root}"
  echo "hdw4s-webroot: built ${root} for ${inst} (${name})"
}

# Layer 1: the file we generated. Runs before the session is declared up, and its exit
# status fails the unit -- so a session that would serve an ungated client does not start
# at all, rather than starting healthy and quietly missing its only safety property.
cmd_check() {
  local root="$1" idx="${1}/index.html" inst="${2:-}"
  [ -d "${root}" ]  || die "web root '${root}' does not exist"
  [ -s "${idx}" ]   || die "'${idx}' is missing or empty"
  grep -q "${MARKER}" "${idx}" ||
    die "'${idx}' carries no ${MARKER} marker: this is not a gated client"
  # The REMOVAL is the gate, so its absence is the property to assert. Checking only for
  # the marker would pass a file that had both -- gated markup and an auto-loading
  # module -- which is an ungated client wearing the marker.
  if grep -qE '<script[^>]*type=["'"'"']module["'"'"'][^>]*src=' "${idx}"; then
    die "'${idx}' still auto-loads the client module: the gate would not hold"
  fi
  # Layer 3: every asset the document names must exist. Not a file COUNT -- upstream's
  # asset names are content-hashed and a patched deployment legitimately carries extras,
  # so counting produces a false alarm on every supported configuration. References are
  # the thing that breaks across an upgrade, so references are what is asserted.
  local ref missing=0
  while read -r ref; do
    [ -n "${ref}" ] || continue
    [ -e "${root}/${ref}" ] || { echo "hdw4s-webroot: missing asset '${ref}'" >&2; missing=1; }
  done < <(grep -oE '(src|href)="[^"]*"' "${idx}" |
           sed -E 's/^(src|href)="//; s/"$//' |
           grep -vE '^(https?:|//|data:|#|/)' | sed 's|^\./||' | sort -u)
  [ "${missing}" -eq 0 ] ||
    die "the gated index references assets this tree does not contain (upgrade drift?)"

  # Layer 4: this generation's identity. Checked HERE, inside the session, after the
  # ordering edge and in the namespace the streaming server will actually use -- so it
  # verifies the layer that matters rather than the layer the writer built. A writer
  # verifying its own write proves the write; it cannot prove it ran for this start, or
  # that the file survived until now (a slot re-mint swaps the whole tree).
  #
  # Skipped when no instance is named, because "hdw4s-webroot check <dir>" is also run
  # by hand and by the builder against a staging tree that no session has started yet.
  [ -n "${inst}" ] || return 0
  local tok="${root}/hdw4s-incarnation" state="${INCARNATION_DIR}/${inst}"
  [ -s "${tok}" ] ||
    die "'${tok}' is missing or empty: this session has no published identity, so a
returning tab cannot tell it apart from the one it was using"
  [ -s "${state}" ] ||
    die "no record at '${state}': hdw4s-incarnation did not run for this start"
  [ "$(cat "${tok}")" = "$(cat "${state}")" ] ||
    die "'${tok}' is not what this start published: the served token is stale"
  # Changed since last time. The first start of a slot legitimately has no predecessor,
  # and that case is NAMED rather than left to a comparison against an empty string that
  # happens to be unequal -- an absent operand passing by luck is how a check that cannot
  # run reports green.
  if [ -e "${state}.prev" ]; then
    [ "$(cat "${state}")" != "$(cat "${state}.prev")" ] ||
      die "the published identity did not change on this start: a returning tab would
be told this is the desktop it was using, which is the bug this file exists to prevent"
  else
    echo "hdw4s-webroot: first start of ${inst}; no previous identity to compare against"
  fi
}

# Layer 2: what is actually SERVED. A correct file is the layer we built; the bytes on
# the wire are the layer a person gets, and Selkies' fallback is a place where the two
# can differ -- it declines a web root it does not like and serves the packaged client
# with one line in a log.
#
# Honest limit: the case usually cited for this -- a web root the session cannot read --
# is caught by "check" instead, which runs in the same namespace as the server and sees
# what it sees. No divergence between the file and the served bytes has been reproduced.
# This is cheap insurance against a silent one, not a check with a catch to its name.
cmd_serving() {
  local url="$1"; shift
  local auth=()
  # --auth-stdin: this process's stdin is a pipe carrying a curl config line
  # ("user = <user>:<password>"). It is handed to curl as ITS config, on ITS
  # stdin, which curl already inherits -- so this script never reads the bytes
  # and never names them. The alternative interfaces all publish the secret to
  # every process of this uid, which in an ephemeral session includes the
  # occupant: "-u" and "-H" put it in /proc/<pid>/cmdline, "--netrc-file" and
  # "--config <path>" put a readable path there and the secret on a filesystem,
  # and a here-string would make bash materialise a temp file for it.
  if [ "${1:-}" = '--auth-stdin' ]; then shift; auth=(--config -); fi
  # THE STATUS, NOT JUST THE FAILURE. "could not fetch" is true of a refused
  # connection, a timeout and a 401 alike, and on 2026-09-25 it described a 401
  # for a day while the cause was looked for in the network. curl's own
  # "(22) ... error: 401" goes to stderr and into the journal, but the line this
  # script prints is the one anybody reads first, so it carries the number.
  #
  # ONE REQUEST, not two. The obvious shape -- a --write-out call for the code
  # beside the real one for the body -- is WRONG HERE and was written that way
  # first: with --auth-stdin the credential arrives on this process's stdin, a
  # pipe, and the first curl CONSUMES it, so the second would run
  # unauthenticated and report a 401 caused by the measurement itself. So the
  # code is appended to the body in a single call and split off afterwards, and
  # -f is dropped because the status is now judged here rather than by curl.
  local out body code
  # --max-filesize, because THIS CLIENT DISTRUSTS THE THING IT IS FETCHING. The
  # whole point of the check is that the server may be serving something other
  # than what we built; a root process buffering an unbounded body from it into a
  # shell variable is the checker handing the subject a lever. 4 MiB is far above
  # any gated index.html and far below anything worth worrying about. Raised in
  # response to a security review, 2026-09-25 -- nothing was exploited, and the
  # absence of a bound was simply never considered.
  out="$(curl -sS --max-time 30 --max-filesize 4194304 \
              -w '\n%{http_code}' "${auth[@]}" "$@" "${url}" 2>/dev/null)" ||
    out=''
  code="${out##*$'\n'}"
  body="${out%$'\n'*}"
  case "${code}" in
    2??) ;;
    *) die "could not fetch '${url}' to verify what is served (HTTP ${code:-000}).
A 401 here means the request carried no usable credential; an empty status means
nothing answered" ;;
  esac
  case "${body}" in
    *"${MARKER}"*) ;;
    *) die "'${url}' is serving a client with no ${MARKER} marker: the web root is not in effect" ;;
  esac
}

# "serving" with the URL and the credential derived, run by the unit as root.
#
# IT RUNS AS ROOT ON PURPOSE, and that is the whole reason this subcommand
# exists rather than the four lines it replaces inside hdw4s-run-session. A
# desktop may no longer open a connection to a session port on this machine --
# the firewall's sessions_out chain refuses it, because every other visitor's
# desktop used to be one unauthenticated request away. The session's own check
# of its own front door is the one connection of that shape that is legitimate,
# and the way it is told apart from the occupant's is that it is made by root:
# the occupant of an ephemeral slot is in no sudo-capable group and cannot
# become root, and on a named session anyone who can would be able to flush the
# table anyway.
#
# So: do not move this back inside the session, and do not run it without the
# "!" prefix in the unit. Either one puts it back on the occupant's uid, where
# the firewall refuses it -- and it fails CLOSED, so the symptom is every
# session on the machine refusing to start, with this file's message.
#
# The port comes from the environment, which systemd fills from
# /etc/hdw4s/<instance>.conf OUTSIDE the namespace. It cannot be read from that
# file here: the session unit hides /etc/hdw4s with InaccessiblePaths=, and "!"
# keeps the mount namespace.
cmd_serving_gate() {
  local inst="$1" port="${HDW4S_PORT:-}"
  [ -n "${port}" ] ||
    die "HDW4S_PORT is not set: this must be run from the session unit, which
takes it from /etc/hdw4s/${inst}.conf"

  # Wait for the server to bind. An earlier version of this did not, on the
  # reasoning that ExecStartPost= runs after the readiness notification and the
  # session notifies ready only once the port is bound. MEASURED FALSE on the
  # first run: the check fired a second BEFORE "Selkies server running on
  # http://127.0.0.1:<port>" appeared in the journal, failed to connect, and
  # took the session down with it. The unit sets NotifyAccess=all, so anything
  # in the desktop's cgroup can send READY= and something evidently does --
  # which makes "started" a claim about the wrong thing and makes any ordering
  # argument here worthless. So the wait is explicit and this check depends on
  # no ordering at all.
  #
  # Sixty seconds, the same budget the equivalent loop inside the session had.
  # A refusal from the firewall arrives instantly and repeatedly, so a guard
  # that wrongly refuses this costs a minute per session and then says so
  # loudly, rather than passing quietly.
  for _ in $(seq 1 60); do
    (exec 3<>"/dev/tcp/127.0.0.1/${port}") 2>/dev/null && break
    sleep 1
  done

  # No credential configured -- every ephemeral slot, because "hdw4s auth"
  # refuses one for a slot by design. Ask plainly.
  # THREE CONDITIONS THAT ARE NOT THE SAME THING, and conflating them cost a
  # day. "No credential is configured" is a positive, complete statement about
  # this instance -- every ephemeral slot, because "hdw4s auth" refuses one for
  # a slot by design -- and it is the other branch, not a fallback. The other
  # two are FAILURES: under HDW4S_AUTH=basic they mean "a credential is required
  # and I cannot get it", and answering that by quietly asking anyway verifies a
  # weaker property and then reports the consequence -- a 401 -- as though the
  # server were unreachable. That is a check that stopped checking and blamed
  # the subject. Its sibling in hdw4s-run-session already refuses to start
  # unauthenticated for exactly these conditions; this diverged from it, and the
  # divergence is what made the defect invisible.
  if [ "${HDW4S_AUTH:-none}" != 'basic' ]; then
    cmd_serving "http://127.0.0.1:${port}/"
    return
  fi
  [ -n "${CREDENTIALS_DIRECTORY:-}" ] ||
    die "this instance is configured for basic auth but no credential was
passed to this check, so what is served cannot be verified as the gated client"
  # ABSENT AND FORBIDDEN ARE DIFFERENT FAILURES AND NEED DIFFERENT REPAIRS, and
  # "[ -r ]" is one bit for two errnos. Saying the wrong one is not a cosmetic
  # fault: the first version of this message asserted "this process lacks the
  # privilege to traverse to it", which sent a day of work down a capability
  # path -- two capabilities granted, both measured not to help, because the
  # path was never there to be forbidden. So the two are tested separately and
  # the message names which one happened.
  if [ ! -e "${CREDENTIALS_DIRECTORY}/hdw4s-auth" ]; then
    die "this instance is configured for basic auth, but the credential
directory is NOT MOUNTED in this context: '${CREDENTIALS_DIRECTORY}' does not
contain hdw4s-auth. This is not a permission problem and no capability fixes
it -- in a unit with mount namespacing the FIRST ExecStartPost= is given a
namespace without the unit's own credential directory, while ExecStartPre= and
a SECOND ExecStartPost= both have it. Reproduce in one second, with no desktop
involved: private/diagnose-401.sh <target> <instance> R."
  fi
  [ -r "${CREDENTIALS_DIRECTORY}/hdw4s-auth" ] ||
    die "this instance is configured for basic auth and
'${CREDENTIALS_DIRECTORY}/hdw4s-auth' EXISTS but will not open for this process.
That is a genuine permission problem, unlike the absent case above -- the
credential is staged owned by the instance user (0400, in a 0500 directory),
so a reader that is neither that user nor privileged cannot read it."

  # The same derivation the session itself uses, and it has to stay the same:
  # an instance is the account name, stripped at the colon for an instance named
  # "<user>:<session>" by a version that still created them.
  local user pass
  user="${inst%%:*}"
  pass="$(cat "${CREDENTIALS_DIRECTORY}/hdw4s-auth")"
  # curl's config format reads an unquoted value to end of line, which is right
  # for what "hdw4s auth" mints -- base64 with "=/+" removed, so [A-Za-z0-9]
  # only -- and wrong for anything carrying a quote, a backslash or whitespace,
  # which it would re-interpret. Refuse rather than authenticate with a silently
  # mangled credential: a 401 from a mangled secret looks identical to an
  # ungated client and would stop the session for the wrong reason.
  case "${user}${pass}" in
    *[!A-Za-z0-9_.-]*)
      die "the basic-auth credential contains characters this check cannot pass
to curl without quoting ambiguity, so the served client cannot be verified" ;;
  esac
  # Down a pipe, never in argv: /proc/<pid>/cmdline is readable by every process
  # of this uid. cmd_serving hands its own stdin straight to curl without
  # reading it, so the bytes live in one pipe and one process.
  printf 'user = %s:%s\n' "${user}" "${pass}" |
    cmd_serving "http://127.0.0.1:${port}/" --auth-stdin
}

[ "$#" -ge 1 ] || usage
case "$1" in
  # The flag is counted out of the argument check as well as passed through:
  # "build --directory x y" has three arguments and two of them are the pair
  # this command needs, so a count that ignored the flag would accept
  # "build --directory x" and then build a web root at the empty path.
  build)   shift
           case "${1:-}" in --directory) [ "$#" -ge 3 ] || usage ;;
                            *) [ "$#" -ge 2 ] || usage ;; esac
           cmd_build "$@" ;;
  check)   shift; [ "$#" -ge 1 ] || usage; cmd_check "$@" ;;
  # "gate" is "check" with the web root derived rather than passed, and it exists
  # because the only caller that CAN run it is a systemd ExecStartPre= line, which
  # has no shell and therefore no ${VAR:-default}. Deriving it here keeps the
  # default in one place instead of duplicating it into a unit file, where it
  # would silently diverge the first time it moved.
  gate)    shift; [ "$#" -ge 1 ] || usage
           cmd_check "${HDW4S_WEBROOT_DIR:-/usr/share/hdw4s/webroot}/${1}" "${1}" ;;
  # "provision" is "build" with the web root derived, for the same reason "gate"
  # exists: its caller is an ExecStartPre= line with no shell to expand a default.
  #
  # It runs on EVERY start rather than once at provisioning time, because the tree
  # it builds embeds the packaged client -- so a client that changes under an
  # upgrade would leave a named session serving last release's bytes, gated but
  # stale, with nothing saying so. A build costs a fifth of a second, which is
  # cheaper than the class of bug that staleness creates.
  provision) shift
           dir_flag=''
           if [ "${1:-}" = '--directory' ]; then dir_flag='--directory'; shift; fi
           [ "$#" -ge 1 ] || usage
           cmd_build ${dir_flag} "${1}" \
                     "${HDW4S_WEBROOT_DIR:-/usr/share/hdw4s/webroot}/${1}" \
                     "${2:-Desktop}" ;;
  serving) shift; [ "$#" -ge 1 ] || usage; cmd_serving "$@" ;;
  serving-gate) shift; [ "$#" -ge 1 ] || usage; cmd_serving_gate "$1" ;;
  *) usage ;;
esac
