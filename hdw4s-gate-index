#!/usr/bin/env python3
"""Build the gated index.html from upstream's, by SUBTRACTION.

    hdw4s-gate-index <upstream index.html> <output index.html>
    HDW4S_SESSION_NAME names the session on the card and in the tab.
    HDW4S_GATE_MODE   takeover (default) | mint | off -- what arrival does.
    HDW4S_SHARE_MODE  off (default) | view | control  -- what sharing offers.

Those two are DEFAULTS, not settings. Each is also readable from the query string
("?gate=off", "?share=view"), and the query string wins. That is deliberate and it is
the cheaper carrier of the two: changing a baked default means re-running
"hdw4s-webroot build", which copies a fresh tree from the packaged client and therefore
removes the live tree's "hdw4s-incarnation" file until the next session start
republishes it. A URL costs nothing and lets two arms be open side by side, which is
what comparing them requires.

The two knobs were built to settle two questions by use rather than by argument --
whether arrival should ask before handing over a desktop, and what a sharing link says
it grants -- and this paragraph used to end "remove them once each is settled".

THE FIRST IS SETTLED AND THE ANSWER WAS "KEEP IT". Ruled 2026-09-22: gate wherever
automatic action could do damage, and stealing a session is damage. That makes the gate
a permanent per-session-type setting rather than scaffolding -- ask on a fresh tab for
both session kinds, at a cost of one click, accepted knowingly. So DO NOT delete the
gate arm as tidying-up: the instruction to do so outlived its question, and following it
would remove a control the owner asked to keep.

The sharing knob is still open and the original reasoning still applies to it: a knob
kept past its decision is a decision nobody made.

Upstream's document is taken as-is; only the module <script> is removed -- that removal
IS the gate, because both transports evict on connect and a client that never loads
never connects -- and an overlay is appended. Nothing else upstream ships is touched.

Not a fork and not a monkey patch: upstream publishes this as a host-page seam, and the
re-entry the card uses, window.selkiesCoreInitialize(), is its documented entry point.

Every behaviour here was put in by a test that caught it missing; the comments say which,
because each one looks like an unnecessary special case until it is not.
"""
import json, os, re, sys
from html import escape as html_escape
src, dst = sys.argv[1], sys.argv[2]
html = open(src, encoding="utf-8").read()
mods = re.findall(r'<script\b[^>]*type=["\']module["\'][^>]*></script>', html)
if len(mods) != 1:
    raise SystemExit("expected exactly one module script, found %d -- refusing to guess"
                     % len(mods))
src_attr = re.search(r'src=["\']([^"\']+)["\']', mods[0]).group(1)
html = html.replace(mods[0], "<!-- hdw4s: module deferred behind the boot gate -->")

OVERLAY = r"""
<style>
 /* The [hidden] rule MUST come with the display rule and MUST win. An author
    `display:flex` beats the user-agent `[hidden]{display:none}` in the cascade, so
    without this `gate.hidden = true` sets the property, reads back true in every DOM
    probe, and leaves the card on the screen forever. A 20-case matrix passed against
    that, because every assertion asked the DOM instead of the picture. */
 #hdw4s-gate[hidden]{display:none !important}
 #hdw4s-gate{position:fixed;inset:0;z-index:2147483647;display:flex;align-items:center;
   justify-content:center;background:#141414;color:#eee;font:16px/1.55 system-ui,sans-serif}
 #hdw4s-gate .card{max-width:36rem;padding:2rem 2.25rem;background:#242424;
   border-radius:12px;box-shadow:0 10px 40px #000a}
 #hdw4s-gate h1{font-size:1.3rem;margin:0 0 .6rem}
 #hdw4s-gate p{margin:.45rem 0;color:#b9b9b9}
 #hdw4s-gate button{margin-top:1.3rem;padding:.65rem 1.15rem;font:inherit;border:0;
   border-radius:8px;background:#772953;color:#fff;cursor:pointer}
 #hdw4s-gate .err{color:#ff8a80;white-space:pre-wrap}
 /* Same cascade trap as the gate above, and for the same reason: every one of these
    is toggled with .hidden and every one of them sets its own display. Without the
    !important rule the property reads back true in the DOM and the element stays on
    the screen -- which is the exact defect a 20-case matrix once passed against. */
 #hdw4s-share[hidden],#hdw4s-panel[hidden],#hdw4s-role[hidden]{display:none !important}
 #hdw4s-share{position:fixed;right:12px;bottom:12px;z-index:2147483646;
   font:13px/1.5 system-ui,sans-serif}
 #hdw4s-share>button{padding:.4rem .8rem;border:0;border-radius:6px;background:#772953;
   color:#fff;font:inherit;cursor:pointer;opacity:.85}
 #hdw4s-panel{position:absolute;right:0;bottom:2.4rem;width:24rem;padding:.9rem 1rem;
   background:#242424;color:#ddd;border-radius:10px;box-shadow:0 8px 30px #000b}
 #hdw4s-panel p{margin:.4rem 0}
 #hdw4s-panel .lnk{display:block;width:100%;margin:.3rem 0;padding:.35rem;font:12px/1.4
   ui-monospace,monospace;background:#111;color:#eee;border:1px solid #444;border-radius:4px}
 #hdw4s-panel .warn{color:#ffcc80}
 #hdw4s-panel .blind{color:#ff8a80}
 #hdw4s-panel button{margin-top:.5rem;padding:.3rem .7rem;border:0;border-radius:5px;
   background:#444;color:#fff;font:inherit;cursor:pointer}
 #hdw4s-role{position:fixed;left:12px;bottom:12px;z-index:2147483646;max-width:26rem;
   padding:.45rem .8rem;border-radius:8px;background:#242424e6;color:#ddd;
   font:13px/1.45 system-ui,sans-serif}
 #hdw4s-role b{color:#fff}
</style>
<div id="hdw4s-gate" hidden><div class="card">
  <h1>__NAME__</h1><div id="hdw4s-body"></div>
  <button id="hdw4s-go">Connect</button>
  <p class="err" id="hdw4s-err"></p>
</div></div>
<div id="hdw4s-share" hidden>
  <div id="hdw4s-panel" hidden></div>
  <button id="hdw4s-share-btn">Share</button>
</div>
<div id="hdw4s-role" hidden></div>
<script>
(() => {
  var SRC = __SRC__;
  var KEY = 'hdw4s_booted_' + location.pathname;
  var EXPECT = KEY + ':expect-reload';
  var INC = KEY + ':incarnation';
  // WHETHER ANYONE WAS LOOKING AT THIS TAB WHEN IT LOADED, read at the first
  // statement of the overlay and never again: by the time the arrival decision
  // is taken the answer may have changed, and the question is about the load.
  //
  // This is the whole discriminator the repair below rests on, so it is worth
  // saying why it is one. A person pressing F5 is LOOKING at the tab, so their
  // load is visible. The streaming client's own recovery reload happens while
  // the tab is in the background, because that is the only state that produces
  // it: the client sends STOP_VIDEO when the document hides, goes quiet, the
  // server's thirty-second heartbeat finds the socket gone, and the client
  // reloads the page to reconnect. Measured 2026-09-25 on the owner's own
  // session: STOP_VIDEO at 11:36:41, disconnect at 11:37:11, three times in
  // five minutes, thirty seconds apart to the second each time.
  var LOADED_HIDDEN = (document.visibilityState === 'hidden');
  var gate = document.getElementById('hdw4s-gate');
  var body = document.getElementById('hdw4s-body');
  var go   = document.getElementById('hdw4s-go');
  var booted = false;

  // --- the two knobs, and why a bad one is loud -------------------------------------
  // CFG is baked at generation; the query string wins over it. A value that is not one
  // of the arms does NOT quietly fall back: it falls back AND says so, on the screen.
  // An instrument that ignores its own knob reports on an arm nobody chose, and this
  // project has already shipped a QA matrix that tested one transport twice because a
  // mis-set knob was silently ignored.
  var CFG = __CFG__;
  var BADKNOB = [];
  function pick(name, allowed){
    var v = null;
    try { v = new URLSearchParams(location.search).get(name); } catch(e){}
    if (v === null || v === '') return CFG[name];
    if (allowed.indexOf(v) >= 0) return v;
    BADKNOB.push(name + '=' + v + ' (not one of ' + allowed.join('/') + ')');
    return CFG[name];
  }
  var GATE  = pick('gate',  ['takeover','mint','off']);
  var SHARE = pick('share', ['off','view','control']);

  // WHAT AN EVICTED PAGE ACTUALLY DOES, measured on both transports at upstream
  // selkies-project/selkies 2.0.0rc0-188-g8fd2aaef. This differs sharply between the
  // two, at exactly the moment this overlay depends on, so nothing here may assume one.
  //
  // NOT RE-MEASURED, AND NO LONGER RE-MEASURABLE AT THAT BUILD. It was a branch tip
  // upstream has since squashed and force-pushed, so that revision exists nowhere any
  // more. What the updater now installs is 2.0.0rc1, which renamed webrtc_mode.py and
  // websockets_mode.py and moved selkies-ws-core.js -- exactly the files this paragraph
  // is about. Nobody has watched a page get evicted on rc1. Read the two behaviours
  // below as the reason this code has the shape it has, not as a statement about the
  // build in front of you; measure them again before relying on either.
  //
  //   websockets  the last frame is RETAINED. The video element is still present,
  //               srcObject still set, same dimensions, and the picture survives with
  //               and without upstream's status bar, which is drawn on top of it.
  //   WebRTC      upstream raises a NATIVE alert() on this ordinary lifecycle event
  //               ("Disconnected: ... Please try again."). A native modal blocks the
  //               page's main thread, so nothing in the page can respond -- including
  //               this wrapper -- until a person clicks OK. After dismissal the page is
  //               completely alive, and upstream's own status then reads "Connected"
  //               for a session it has just been evicted from.
  //
  // RETRACTION, kept because it cost an afternoon and the wrong answer is the reachable
  // one: that unresponsive WebRTC tab was diagnosed as WEDGED, by three separate probes
  // that each ruled something out and were each correct in what they measured. They all
  // asked the page, and the page was behind a modal. There is no wedge. The screenshot
  // was captured at the start and not looked at. Count nothing you have not looked at.
  //
  // AND THE TRANSPORT IS NOT A PROPERTY OF THE SESSION TYPE. It is whatever the
  // administrator configured; either choice is legitimate. So "named sessions behave
  // this way and ephemeral ones that way" is false -- both behaviours are reachable for
  // any session. This overlay must therefore work WITHOUT depending on either
  // mechanism, which is why it is markup placed behind the video at page load rather
  // than anything that has to run at the moment of eviction. That is a requirement, not
  // a convenience: on WebRTC the modal appears before our code gets a turn.
  //
  // Two states, kept apart on purpose. Cold: this tab has never connected and cannot
  // know what is open elsewhere, so the consequence is conditional. Lost: this tab WAS
  // connected and was disconnected, which is a fact and is stated as one.
  var COLD = '<p>This tab is not connected.</p>'
    + '<p>If this desktop is open in another tab or on another device, connecting here '
    + 'will take it over. That tab will stop streaming and keep showing its last '
    + 'picture until it is closed.</p>';
  var LOST = '<p>This tab was disconnected: the desktop was opened somewhere else.</p>'
    + '<p>Nothing has been lost. The desktop is still running, and you can bring it '
    + 'back here.</p>';

  // The button's words are part of the state, not decoration around it. It used to
  // read "Take over and disconnect other sessions" in static markup, on every state
  // including COLD -- where the comment four lines above says this tab CANNOT know
  // what is open elsewhere. So the button asserted as fact the one thing the body
  // was careful to state as a condition, and it did so on the common path.
  //
  // Each label reuses the verb its own body text just used: COLD says "connecting
  // here", LOST says "bring it back here". That is what makes this screen and the
  // session directory siblings -- shared vocabulary, not a shared palette.
  var COLD_GO = 'Connect';
  var LOST_GO = 'Bring it back here';

  // The THIRD arrival arm, and the reason there are three rather than two. The
  // committed shape for this product is that arriving always mints a fresh desktop
  // and never resumes one -- at which point COLD's whole body, a warning about taking
  // a desktop away from another tab, is a warning about something that will not
  // happen. Offering only "COLD or nothing" would ask him to rule on a card the design
  // has already retired. This arm is what arrival says once R1 holds; it is text, it
  // costs nothing, and without it the comparison is between the wrong two things.
  //
  // WHAT THIS CARD SAYS ABOUT LIFETIME IS THE PRODUCT'S ONLY STATEMENT ABOUT IT, and
  // it was false in the dangerous direction until 2026-09-23. It read "nothing in it
  // survives being closed". Closing the tab does not stop the desktop: the session is
  // held alive and is reclaimed later, after a period with nobody connected, so a
  // person who signed into webmail and closed the tab believing it was gone was still
  // signed in. A promise that something is destroyed is the one kind of promise where
  // being wrong costs the reader rather than us, so it is now stated the other way
  // round -- the desktop OUTLIVES the tab -- and the sign-out is named as the act that
  // actually ends the exposure, because it is the only one the person can perform.
  //
  // NO NUMBER APPEARS HERE, DELIBERATELY. The reclaim period is a per-instance setting
  // an administrator changes with "set", the page is generated once per web-root build,
  // and a rebuild is not triggered by changing the setting. A figure baked in here
  // would therefore be a claim that goes stale silently and breaks nothing -- and it
  // would be wrong for every instance that overrides the default, since one built tree
  // is served for the name it was built for. "for a while" is weaker and stays true.
  // If a number is ever wanted on this card it has to arrive at page load from the
  // session that is actually serving it, not from generation time.
  //
  // THE LAST LINE IS NOT DECORATION. Reachability is per browser per device, so a
  // person who starts a desktop on a phone and opens the same address on a laptop gets
  // a different one. Unexplained that is a fault report; stated once in advance it is
  // a rule, and rules are forgivable.
  //
  // NOTHING HERE TELLS THE PERSON TO CLOSE THE DESKTOP THEMSELVES: measured on this
  // tree, no visitor-facing control ends a session, so that instruction would be a
  // documented act that cannot be performed. Signing out can be.
  var MINT = '<p>This will start a fresh desktop. Nothing from anyone else is in it.</p>'
    + '<p><b>Closing this tab does not end it.</b> It keeps running, still signed in to '
    + 'whatever you sign in to, and you can come back to it in this browser. Sign out of '
    + 'anything that matters before you walk away.</p>'
    + '<p>It is not kept: once nobody has connected to it for a while it ends by itself, '
    + 'and everything in it is destroyed then. Nothing in it is backed up.</p>'
    + '<p>This browser on this device is what reaches it. Another browser, or another '
    + 'device, gets a different desktop.</p>';
  var MINT_GO = 'Start a fresh desktop';

  // The desktop's published identity, read from the tree that is serving THIS page
  // rather than from anything the tab remembers about the world. A session start
  // republishes it, so two desktops behind one address never share a value.
  // Every failure -- not served, not readable, empty -- answers null, and null is a
  // refusal everywhere it is used. A resume that cannot establish which desktop it is
  // resuming must not happen: that is the logged-out row collapsing into the resume
  // row, which is the one outcome the arrival design exists to prevent.
  function fetchIncarnation(cb){
    var done = false;
    function once(v){ if (!done) { done = true; cb(v); } }
    // A hidden tab's timers are throttled but its network is not; the timeout is
    // here so a hung request cannot leave the person looking at a blank page.
    setTimeout(function(){ once(null); }, 5000);
    try {
      fetch('hdw4s-incarnation', {cache: 'no-store'}).then(function(r){
        if (!r.ok) return once(null);
        return r.text().then(function(t){ once((t || '').trim() || null); },
                             function(){ once(null); });
      }, function(){ once(null); });
    } catch(e) { once(null); }
  }

  function show(k, label){
    body.innerHTML = k;
    go.textContent = label;
    if (BADKNOB.length)
      document.getElementById('hdw4s-err').textContent = 'ignored: ' + BADKNOB.join('; ');
    gate.hidden = false;
  }

  // Second monitors and shared viewers are NEVER offered a takeover. They are not the
  // primary display, so being closed by the server does not mean somebody took the
  // desktop -- on this deployment #player2 is refused outright
  // (--enable-player2=false|locked) and the server KILLs it, which a QA run caught
  // being rendered as "the desktop was opened somewhere else" with a takeover button.
  var SECONDARY = /^#(shared|player[2-4]|display2)/.test(location.hash);

  function quietBanner(){
    // Upstream writes a terminated message and never clears it -- its overlay hides only
    // on a FIRST painted frame, and this page has had one. Left alone it would sit over
    // a live desktop after we reconnect. This is a TERMINAL-state substitution, the one
    // case where covering upstream's status is safe: v2 hid this banner on a timer and
    // raced its own detector, which is why detection now comes from the transport
    // instead.
    //
    // CORRECTION, and it is the sentence that hid a bug for a week: this comment used
    // to end "and nothing we detect depends on it." That stopped being true when
    // checkStatus() was added below, which detects on exactly this element -- and
    // because what follows only adds a CLASS, the text it reads is left behind for the
    // poller to find again. clearStaleStatus() is the other half; see boot().
    var s = document.getElementById('status-display');
    if (s && /terminated|superseded|disconnected/i.test(s.textContent||''))
      s.classList.add('hidden');
  }

  // The previous loss's residue, cleared before the card comes down.
  //
  // Measured, end to end: the recovery button works. selkiesCoreInitialize() is
  // present, the branch runs, the stream returns -- 179 decoded chunks in six seconds.
  // What fails is what the person sees. quietBanner() adds a class; checkStatus()
  // reads textContent, which a class does not touch, and upstream never clears that
  // text on a successful reconnect. So the poller, twice a second, reads the old
  // "Connection Terminated" the instant boot() sets gate.hidden = true -- at which
  // point lost() no longer no-ops, because the card is down -- and puts the card
  // straight back over a desktop that is streaming perfectly.
  //
  // CLEARED, not ignored, and the difference is the whole safety of it. A flag saying
  // "disregard the status for a while" would also disregard a REAL second loss
  // arriving inside that window, which is the defect this file exists to prevent. An
  // empty element cannot be read as a terminal state, and the next real terminal
  // message writes into it and is detected exactly as before.
  //
  // The class quietBanner() added is deliberately left on. Our card is what tells a
  // person their session ended; re-showing upstream's banner is a second change with
  // its own reasons, and doing two things here would make the test's verdict say
  // nothing about which one worked.
  function clearStaleStatus(){
    var s = document.getElementById('status-display');
    if (s) s.textContent = '';
  }
  function lost(why){
    if (SECONDARY) { window.__hdw4sLost = why; return; }   // recorded, never rendered
    if (!booted || !gate.hidden) return;
    window.__hdw4sLost = why; quietBanner(); show(LOST, LOST_GO);
  }

  // --- deterministic detection, from the transport, not from upstream's UI ----------
  // websockets: a "KILL " text frame. webrtc: the signalling socket closes 4001.
  var NativeWS = window.WebSocket;
  function WrappedWS(url, protocols){
    var ws = (protocols === undefined) ? new NativeWS(url) : new NativeWS(url, protocols);
    ws.addEventListener('message', function(ev){
      if (typeof ev.data === 'string' && ev.data.lastIndexOf('KILL ', 0) === 0) lost('kill');
    });
    ws.addEventListener('close', function(ev){ if (ev.code === 4001) lost('close4001'); });
    return ws;
  }
  WrappedWS.prototype = NativeWS.prototype;
  ['CONNECTING','OPEN','CLOSING','CLOSED'].forEach(function(k){ WrappedWS[k] = NativeWS[k]; });
  window.WebSocket = WrappedWS;

  // The WebRTC core announces an eviction with a NATIVE alert(), which blocks the main
  // thread until somebody clicks OK -- so nothing of ours can draw while it is up, and
  // to a person the tab looks frozen. Supplying our own alert() is providing a platform
  // function, not suppressing upstream's UI, and it turns that modal into our card.
  window.alert = function(msg){
    window.__hdw4sAlert = String(msg);
    if (/superseded|disconnected/i.test(String(msg))) lost('alert');
    else { try { console.warn('hdw4s: suppressed alert:', msg); } catch(e){} }
  };

  // The socket is in a WORKER by default (socket_worker=true), where the WebSocket
  // patch above cannot see the KILL frame -- measured: the card came back in ~15 s via
  // the backstop instead of ~3 s. Upstream writes its terminated text into
  // #status-display on every transport, so observing that element is the one signal
  // available in both configurations. Note this does NOT race the banner-hiding any
  // more: quietBanner() is called only from lost(), after the decision, never on a
  // timer -- which is what made v2 miss a takeover.
  //
  // Polled as well as observed, and the polling is the part that matters. A
  // MutationObserver only fires on a CHANGE, and upstream does not clear this text
  // on a successful reconnect: after a tab takes the session back, #status-display
  // still reads "Connection Terminated: ...". So when that same tab loses the
  // session a SECOND time, the text it would be set to is the text already there --
  // no mutation, no callback, and the card came back only via the ~10 s stall
  // backstop. Measured across two losses of one tab: first lost=status, second
  // lost=stalled, sameElement=True both times, so this is not a detached observer.
  // It is a signal that only exists on the edge, used to detect a level.
  var statusEl = null;
  function checkStatus(){
    if (!statusEl) return;
    var t = statusEl.textContent || '';
    if (/terminated|superseded|opened elsewhere/i.test(t)) lost('status');
  }
  function watchStatus(){
    statusEl = document.getElementById('status-display');
    if (!statusEl) return setTimeout(watchStatus, 500);
    new MutationObserver(checkStatus).observe(statusEl,
      {childList:true, characterData:true, subtree:true, attributes:true});
    checkStatus();
  }
  watchStatus();

  // Backstop, for a transport that announces nothing. Two guards, both learned from a
  // QA run where this fired on a page that was working perfectly:
  //   - never on a secondary viewer. #shared, #player2-4 and #display2 legitimately
  //     receive no video of their own, so "no frames" is their normal state, and the
  //     backstop was showing them a takeover button they must never see;
  //   - never before the stream has moved at least once, so a slow first frame is not
  //     read as a disconnection.
  var last = -1, still = 0, everMoved = false;
  setInterval(function(){
    if (SECONDARY || !booted || !gate.hidden) { still = 0; return; }
    // Cheap, and it is what makes a repeat loss show the card at once rather than
    // ten seconds later: lost() no-ops once the card is up, so this costs one
    // regexp against a short string twice a second.
    checkStatus();
    var n = window.videoChunksReceived || 0;
    if (n > 0) everMoved = true;
    still = (n === last) ? still + 1 : 0; last = n;
    if (everMoved && still >= 20) lost('stalled');   // ~10 s with no frames at all
  }, 500);

  // --- what a page is, said on the page --------------------------------------------
  // Measured, and every line below is a measurement rather than an intention:
  //   #shared    cannot type or point -- refused by the SERVER's input authority, not
  //              by its own page -- and RECEIVES the desktop's clipboard.
  //   #display2  full pointer, keyboard and clipboard both ways, with no card.
  //   both       are invisible to the primary, and outlive both the primary's tab and
  //              the desktop being replaced. There is no revocation.
  // Today a viewer is told none of this: those fragments boot ungated and the page
  // looks like any other. The badge is the half of "show an overlay when a session is
  // shared" that can honestly be done in the client. The other half -- telling the
  // PRIMARY somebody is there -- is measured NOT available to a page, and the panel
  // below says so instead of pretending.
  var ROLES = {
    shared:  '<b>You are watching someone’s desktop.</b> You cannot type or move '
           + 'the pointer. What they copy is shared with you. They are not told you '
           + 'are here.',
    display2:'<b>You have full control of someone’s desktop.</b> Keyboard, pointer '
           + 'and clipboard, both ways. They are not told you are here.',
    other:   '<b>You are a second display for someone’s desktop.</b>'
  };
  function roleOf(){
    var m = /^#(shared|display2|player[2-4])/.exec(location.hash);
    if (!m) return null;
    return ROLES[m[1]] || ROLES.other;
  }
  function notice(html){
    var el = document.getElementById('hdw4s-role');
    el.innerHTML = html; el.hidden = false;
  }

  var PANELS = {
    view: {
      frag: '#shared',
      html: '<p>Anyone with this link can <b>watch</b> this desktop.</p>'
          + '<p>They cannot type or move the pointer: the server refuses their input, '
          + 'not just their page.</p>'
          + '<p class="warn">They <b>do</b> receive this desktop’s clipboard. '
          + 'Everything you copy goes to them.</p>'
    },
    control: {
      frag: '#display2',
      html: '<p>Anyone with this link gets the <b>keyboard, pointer and clipboard</b> '
          + 'of this desktop, both ways.</p>'
          + '<p class="warn">They arrive with no announcement and no card.</p>'
    }
  };
  // Said on both panels, because it is the thing he is actually being asked to rule
  // on and it is the thing a screenshot of a working share would hide.
  var PANEL_TAIL =
      '<p class="blind">This tab cannot tell you whether anyone is connected, or who. '
    + 'That is measured, not an omission.</p>'
    + '<p class="blind">The link keeps working after you close this tab and after this '
    + 'desktop is replaced. Nothing takes it back.</p>'
    + '<p>Copying puts the link on your own clipboard — which this desktop also '
    + 'syncs, so the link can reach anyone already watching. Read it here instead if '
    + 'that matters.</p>';

  function mountShare(){
    if (SHARE === 'off' || roleOf()) return;   // never offered to a viewer
    var wrap  = document.getElementById('hdw4s-share');
    var panel = document.getElementById('hdw4s-panel');
    var btn   = document.getElementById('hdw4s-share-btn');
    var spec  = PANELS[SHARE];
    var url   = location.origin + location.pathname + location.search + spec.frag;
    panel.innerHTML = spec.html
      + '<input class="lnk" readonly value="' + url.replace(/"/g,'&quot;') + '">'
      + PANEL_TAIL
      + '<button type="button" id="hdw4s-copy">Copy link</button>';
    panel.querySelector('#hdw4s-copy').addEventListener('click', function(){
      var i = panel.querySelector('.lnk');
      i.select();
      var ok = false;
      try { ok = document.execCommand('copy'); } catch(e){}
      if (!ok && navigator.clipboard) navigator.clipboard.writeText(url).catch(function(){});
      this.textContent = 'Copied';
    });
    btn.addEventListener('click', function(){ panel.hidden = !panel.hidden; });
    wrap.hidden = false;
  }

  function boot(){
    try { sessionStorage.setItem(KEY,'1'); } catch(e){}
    // Which desktop this tab is connecting to, remembered so that a later
    // silent resume can refuse to resume a DIFFERENT one. Asynchronous and
    // unchecked on purpose: nothing here depends on it, and the resume path
    // treats a missing value as a refusal rather than as permission.
    fetchIncarnation(function(v){
      try { if (v) sessionStorage.setItem(INC, v); else sessionStorage.removeItem(INC); } catch(e){}
    });
    // Before the card comes down, never after: between hiding it and clearing the
    // text there is a window the 500 ms poller can land in.
    clearStaleStatus();
    gate.hidden = true;
    if (!booted) {
      booted = true;
      // The client picks its transport from window.__SELKIES_STREAMING_MODE__, then
      // localStorage, then defaults to websockets -- so a fresh browser profile is
      // ALWAYS websockets. A QA matrix labelled "webrtc" therefore tested websockets
      // twice and looked green; the colour counts being byte-identical across the two
      // runs is what gave it away. Honouring an explicit override makes the transport a
      // variable a test can set.
      var want = new URLSearchParams(location.search).get('hdw4s_mode');
      if (want === 'webrtc' || want === 'websockets') window.__SELKIES_STREAMING_MODE__ = want;
      var s = document.createElement('script');
      s.type='module'; s.src=SRC; document.body.appendChild(s);
    } else {
      // RELOAD, rather than re-initialising in place.
      //
      // This used to call selkiesCoreInitialize() on the already-loaded client,
      // with the reasoning that re-entry without a reload moves a session between
      // tabs INSTANTLY. It is instant-looking and then wrong: measured across a
      // real handover, the desktop came back at HALF HEIGHT -- 1280x328 against a
      // 1280x656 window -- and stayed wrong for about sixteen seconds before
      // correcting itself. The recovery coincides exactly with an orphaned canvas
      // being disposed: re-entry leaves FOUR canvases where a fresh load has
      // three, and the size negotiated while the extra one exists is the wrong
      // one. The owner reported this as "the geometry is all wonky".
      //
      // A reload starts from one clean set of elements and is correct from the
      // first frame: 1280x656 immediately, unchanged at +6s and +16s, three
      // canvases. It costs a page load, which is the honest version of the wait
      // that was happening anyway.
      //
      // DO NOT "FIX" THIS BY DISPATCHING A RESIZE. That was tried: it makes the
      // client latch the transient size PERMANENTLY, turning a sixteen-second
      // annoyance into a defect that never corrects and only appears after a
      // handover. Measured, not assumed.
      //
      // Marked as OURS before it happens, so the reloaded page knows this reload
      // was the product's own doing and not a person pressing F5. See the arrival
      // check below: a reload nobody asked for must not walk through the gate.
      try { sessionStorage.setItem(EXPECT,'1'); } catch(e){}
      location.reload();
      return;
    }
    window.__hdw4sBooted = true; window.__hdw4sLost = null;
    var r = roleOf();
    if (r) notice(r); else mountShare();
    if (BADKNOB.length && !r) notice('ignored: ' + BADKNOB.join('; '));
  }

  // THE GATE'S OWN IDENTITY, so nobody has to remember which version they tested.
  //
  // A page already open keeps running the JavaScript it loaded; a deploy does not
  // reach it, and revalidation only helps the NEXT fetch. That produced a round of
  // bug reports nobody could place -- the owner's words: "i am not sure if i tested
  // your final version or an interim state". This makes the question mechanical.
  //
  // Read it in a browser console as __hdw4sGate, or from a terminal against the
  // SERVED page; a harness can compare the two and refuse to report on a stale tab.
  window.__hdw4sGate = __GATEID__;
  window.__hdw4sContract = {module: SRC};
  // Published so a check can assert which arm is in force against the bytes the
  // browser actually ran, rather than against the file somebody meant to serve.
  window.__hdw4sArms = {gate: GATE, share: SHARE, bad: BADKNOB};
  go.addEventListener('click', boot);

  // AN ARRIVAL IS GATED UNLESS WE OURSELVES CAUSED IT.
  //
  // This used to boot whenever sessionStorage said the tab had passed the gate
  // once, on the reasoning that a self-reload keeps the tab and re-gating the
  // client's own recovery paths would turn every recovery into a button nobody is
  // watching. That reasoning holds for a reload the PRODUCT performs. It does not
  // hold for one a PERSON performs, and the two were not distinguished.
  //
  // The owner found the consequence immediately: "i force a reload of the page.
  // and while i presumably now have the most recent html, i also managed to steal
  // the session without a gate." A tab that had been through the gate at some
  // point in its life could take the desktop from whoever held it now, silently,
  // with a keypress -- which is precisely the damage the gate exists to prevent.
  //
  // So the flag is no longer "has this tab ever passed the gate" but "did WE just
  // reload this tab". It is consumed on read, so it authorises exactly one
  // arrival and cannot accumulate.
  //
  // That consequence used to be accepted here in one sentence: a recovery reload the
  // client performs by itself is not marked, so it shows the card rather than
  // reconnecting silently -- "a click where there used to be none, ON A PATH THAT IS
  // RARE, and the safe direction of the two."
  //
  // THE PATH IS NOT RARE. It is every visitor who looks away for thirty seconds, and
  // the reason is in the streaming client's design rather than in any fault: it stops
  // the stream when the document hides, which is right and saves real bandwidth, and
  // it reconnects by itself when the tab comes back, which is why nobody using the
  // stock client ever notices. We were the ones turning that invisible optimisation
  // into a card. The owner found it in an hour of ordinary use -- four times in forty
  // minutes -- and re-ruled it with the true frequency in front of him: a client that
  // reconnects because its window got focus again does not warrant the gate.
  //
  // So there is a second marked arrival below, and it is marked by facts about THIS
  // TAB rather than by a moment in time: see AN UNWATCHED LOAD IS NOT AN ARRIVAL.
  var expected=false;
  try {
    expected = sessionStorage.getItem(EXPECT)==='1';
    sessionStorage.removeItem(EXPECT);
  } catch(e){}
  if (expected) return boot();
  // Second monitors and shared viewers must never be shown a takeover button.
  if (/^#(shared|player[2-4]|display2)/.test(location.hash)) return boot();
  // gate=off is about ARRIVAL and nothing else. lost() still shows its card: a tab
  // that is taken away silently is worse than one that was never asked, and that is
  // not the question being decided here.
  if (GATE === 'off') return boot();

  // AN UNWATCHED LOAD IS NOT AN ARRIVAL.
  //
  // Three conditions, ALL of them facts about this tab and this desktop, and none of
  // them a time or a sequence. A "reconnect shortly after a STOP_VIDEO" inference was
  // considered and rejected: a stranger arriving with a stale address shortly after
  // somebody else's legitimate pause satisfies it, and the whole danger here is a
  // stranger being let in silently.
  //
  //   1. NOBODY WAS LOOKING when this page loaded. A person pressing F5 is watching
  //      the tab they pressed it in, so their load is visible; the client's recovery
  //      reload happens in a backgrounded one. This is the condition that keeps the
  //      owner's own steal -- "i force a reload of the page ... i also managed to
  //      steal the session without a gate" -- gated, and it is why the flag below can
  //      be the per-tab one that was retired for exactly that defect.
  //   2. THIS TAB HAS BEEN THROUGH THE GATE for this address. sessionStorage is per
  //      tab and per origin, so a stranger's tab, a new tab, and a tab on another
  //      device all have nothing here and all meet the card. It cannot be minted by
  //      anybody except the person who was already connected in this tab.
  //   3. IT IS THE SAME DESKTOP. The identity published in the web root is compared
  //      against the one this tab connected to; anything else -- a different value, a
  //      missing file, an unreadable one -- is a refusal, so the resume fails CLOSED
  //      into the ordinary card. A tab that resumed a desktop it had never been in
  //      would be the minting damage wearing a resume's clothes.
  //
  // WHAT IT DOES NOT ESTABLISH, said plainly because it is the cost of the ruling:
  // whether somebody else is connected RIGHT NOW. Measured, and stated on the share
  // panel already: a page cannot tell. So a tab that resumes on focus can take the
  // desktop back from another tab without the warning the card would have given. What
  // that replaces is a card the returning person clicked through every time anyway --
  // four times in forty minutes, measured -- so the warning was already being spent
  // on the wrong event.
  //
  // The verdict is published rather than merely acted on: a probe must be able to
  // assert that a tab came back through THIS path and not because the card failed to
  // draw, which is the same failure this file has shipped once before.
  window.__hdw4sResume = {loadedHidden: LOADED_HIDDEN, verdict: null};

  // SAY WHAT THIS PAGE DECIDED, IN THE CONSOLE, EVERY TIME.
  //
  // The stamp above is readable only while the gate is on screen: boot() hands
  // the document to the client and the global goes with it. So a person who
  // resumes has nothing left to inspect, and a resume and a click-through leave
  // an IDENTICAL trace -- both end in a page load that connects.
  //
  // Measured cost of that, 2026-09-25: the owner sent two full console logs of a
  // hide-and-return, and neither could establish whether he had met the card,
  // because every line in them came from the streaming client and this file said
  // nothing at all. A gate that decides silently cannot be debugged by the only
  // person who can see it decide.
  //
  // Deliberately console.log rather than a UI element: it is for whoever is
  // reading a console at the time, costs a visitor nothing, and says what was
  // DECIDED rather than what was shown -- which is the distinction a screenshot
  // cannot make either.
  var announce = function(what, extra){
    try {
      console.log('[hdw4s gate] ' + what,
                  Object.assign({loadedHidden: LOADED_HIDDEN}, extra || {}));
    } catch(e){}
  };
  var knownInc = null;
  try { knownInc = sessionStorage.getItem(INC); } catch(e){}
  if (LOADED_HIDDEN && knownInc) {
    var decide = function(){
      fetchIncarnation(function(served){
        var same = !!served && served === knownInc;
        window.__hdw4sResume.served = !!served;
        window.__hdw4sResume.verdict = same ? 'resumed' : 'refused';
        announce(same ? 'resumed silently: this tab owns the running desktop'
                      : 'card shown: the desktop is not the one this tab left',
                 {served: !!served, knownIncarnation: !!knownInc});
        if (same) return boot();
        return (GATE === 'mint') ? show(MINT, MINT_GO) : show(COLD, COLD_GO);
      });
    };
    // Never while hidden: reconnecting an unwatched tab would evict whoever IS
    // watching, and the ruling is about a window getting focus, not about a window
    // being in the background. The card is not drawn in the meantime because there is
    // nobody to read it; the decision happens when somebody arrives to see it.
    if (!document.hidden) return decide();
    var onVisible = function(){
      if (document.hidden) return;
      document.removeEventListener('visibilitychange', onVisible);
      decide();
    };
    document.addEventListener('visibilitychange', onVisible);
    return;
  }

  if (GATE === 'mint') return show(MINT, MINT_GO);
  show(COLD, COLD_GO);
})();
</script>
"""

# Refused at GENERATION, not clamped. A default nobody chose is how a whole build
# quietly serves the wrong arm, and the person who mistyped it is standing right here
# with the message, whereas at page-load time they are not.
ARMS = {"gate": ("takeover", "mint", "off"), "share": ("off", "view", "control")}
cfg = {}
for knob, allowed in ARMS.items():
    env = "HDW4S_%s_MODE" % knob.upper()
    cfg[knob] = os.environ.get(env) or allowed[0]
    if cfg[knob] not in allowed:
        raise SystemExit("%s=%r is not one of %s" % (env, cfg[knob], "/".join(allowed)))

# The identity is a hash of THIS generator, which is where the gate's behaviour
# lives -- not the package version, which does not change when the logic does, and
# not a timestamp, which changes when nothing does. Two pages agree if and only if
# they were built from the same gate.
import hashlib
_gate_id = hashlib.sha256(
    open(__file__, "rb").read()).hexdigest()[:12]

OVERLAY = OVERLAY.replace("__SRC__", json.dumps(src_attr)) \
     .replace("__GATEID__", json.dumps(_gate_id)) \
     .replace("__CFG__", json.dumps(cfg)) \
     .replace("__NAME__", html_escape(os.environ.get("HDW4S_SESSION_NAME", "Desktop")))
html = html.replace("</body>", OVERLAY + "</body>") if "</body>" in html else html + OVERLAY

# THE LIFETIME STATEMENT IS GUARDED HERE, IN BOTH DIRECTIONS, AND THE GUARD RUNS ON THE
# BYTES THAT ARE ABOUT TO BE WRITTEN rather than on the template above -- a check that
# passes at the layer we authored says nothing about what the browser is handed.
#
# Why a guard at all, when this is prose and prose cannot be proved true by a machine:
# the defect being prevented is not a wrong word, it is a SILENT DELETION. The sentence
# this replaced was false for as long as it shipped and nothing failed, because a page
# that promises destruction and does not destroy behaves identically to a correct one.
# Nothing in the suite, the build or the runtime could have gone red. The one mechanical
# thing available is this: if the warning that the desktop outlives the tab is taken out
# of the card, or if the retracted promise comes back, refuse to build the page at all,
# where the person who did it is standing.
#
# Its direction is worth stating, because a checker that only ever fires one way has
# already landed a defect on this project: this catches the clause going MISSING and the
# old claim RETURNING. It cannot catch the clause being reworded into something equally
# false, and it is not evidence that the card is true -- only that it still says the
# thing a person decided was true.
#
# The span is DERIVED from the generated document, not asserted about the file as a
# whole. Checking the whole page would make the retraction comment a few hundred lines
# above -- which quotes the old sentence on purpose, so that grepping for it finds the
# reason it went -- trip the guard against itself, and the repair for that would be to
# stop quoting it, which is the wrong half to give up.
_card = re.search(r"var MINT = (.*?);\n", html, re.S)
if _card is None:
    raise SystemExit("hdw4s-gate-index: the fresh-desktop card could not be found in the "
                     "generated page, so its wording cannot be checked -- refusing to "
                     "ship a lifetime claim nothing has read")
_card = _card.group(1)
if "Closing this tab does not end it" not in _card:
    raise SystemExit("hdw4s-gate-index: the fresh-desktop card no longer warns that the "
                     "desktop outlives the tab. Closing a tab does not stop a session, "
                     "and a person who believes otherwise leaves a logged-in desktop "
                     "running -- refusing to build")
if re.search(r"survives? being closed|survive being closed", _card):
    raise SystemExit("hdw4s-gate-index: the fresh-desktop card promises again that "
                     "nothing survives being closed. That was measured false on this "
                     "build and is false in the dangerous direction -- refusing to build")

open(dst, "w", encoding="utf-8").write(html)
print("hdw4s-gate-index: built %s (deferred %s)" % (dst, src_attr))
