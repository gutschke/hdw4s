if _body.index("streamPaused()") > _body.index("still >= 20"):
    raise SystemExit("hdw4s-gate-index: the stall backstop counts before it asks "
                     "whether the stream was stopped on purpose. The question has to "
                     "come first or the count is already wrong -- refusing to build")

# THE CARD MAY NOT POINT AT A DOOR THAT DOES NOT SERVE THE PAGE, checked on the bytes
# about to be written rather than on the template, for the same reason the two guards
# above are: a pass at the layer we authored says nothing about what the browser gets.
#
# It fires in BOTH directions on purpose. A guard that can only catch one is how this
# project has already landed a defect: the interesting failure here is not the link
# coming back by hand -- it is __MORE__ being "tidied" back into the static markup by
# somebody who sees a placeholder and an empty string and concludes the condition was
# scaffolding. That edit puts the 404 back on every named desktop and changes nothing
# a test looks at, because a link is not exercised by anything that does not click it.
#
# WHAT IT CANNOT SEE, and this is the honest limit: it checks that the page offers the
# directory exactly when the BUILDER SAID the door serves one. It has no way to reach
# the door and ask. If a caller passes HDW4S_DIRECTORY=yes for a door with no session
# directory behind it, this passes and the page is wrong again -- so the claim lives
# with the two callers, which are hdw4s@.service (named: silent) and
# hdw4s-ephemeral-slots (pool: --directory), and nowhere else.
# THE STARTING VEIL MUST HAVE EVERY WAY OUT IT CLAIMS TO HAVE, checked on the bytes
# about to be written for the same reason the guards above are.
#
# WHY A BUILD REFUSAL RATHER THAN A TEST. This veil covers the whole screen. Its
# failure mode is not a wrong pixel: it is a visitor sitting behind a reassuring
# sentence with a working desktop underneath, or worse, behind it forever on a session
# whose compositor really is wedged -- the one case where black is the truth and the
# only recovery is to start another desktop. Every one of the three exits is a line
# that looks like defensive clutter to a reader tidying up, and nothing in the suite
# runs a browser against a half-painted desktop, so a test would not notice their
# removal. What is available mechanically is to refuse to build a page that has lost
# one, at the moment somebody removes it.
#
# WHAT IT CANNOT SEE: whether paintedColours() reads the element the client actually
# draws into on this build of Selkies. It checks that the three exits are present, not
# that the measurement is right -- and if the measurement is wrong, exit 1 is what
# carries it, which is why "returns null" is checked rather than assumed.
_veil = re.search(r"function veilUp\(\)\{(.*?)\n  \}", html, re.S)
if _veil is None:
    raise SystemExit("hdw4s-gate-index: the starting veil's poller could not be found "
                     "in the page about to be written -- refusing to build, because a "
                     "full-screen overlay whose exits nothing has read is a visitor "
                     "locked behind a sentence")
_veil = _veil.group(1)
for _needle, _why in (
        ("=== null", "the veil no longer reveals when it CANNOT SAMPLE the picture. "
                     "A veil that cannot measure must not hold a visitor behind "
                     "itself; 'could not look' is not 'still black'"),
        # THE NEEDLE CHANGED AND SO DID WHAT IT DEFENDS, 2026-09-26, and the second
        # half is the part not to lose. This used to look for VEIL_DEADLINE, whose
        # exit REVEALED the desktop on a clock -- and the clock was 90 seconds
        # against a measured healthy cold start of 89.0 on the production box, so
        # the guard was protecting an exit that would have torn the card away one
        # second before a working desktop arrived. The exit is now a change of
        # WORDS rather than a reveal, which is what makes the threshold safe to be
        # wrong about. What still has to exist is that the card STOPS PROMISING on
        # a clock: a wedged compositor is black forever and only a restart recovers
        # it, and a card that goes on saying "it is coming up now" for ever is a
        # permanent reassuring message nobody would report.
        # AND THE NEEDLE IS THE COMPARISON, NOT THE FUNCTION. The first version of
        # this looked for "veilPatience", which also appears where the threshold is
        # merely COMPUTED -- so a red arm that deleted the whole give-up block built
        # cleanly, and the guard would have reported health for ever. Caught by
        # running the arm, which is the only reason it is not still wrong. The
        # comparison is the exit; nothing else in this file mentions it.
        (">= patience", "the veil no longer gives up on a clock. A wedged "
                         "compositor is black forever and only a restart recovers "
                         "it, so a card that keeps promising is a permanent "
                         "reassuring message nobody would report"),
        ("streamPaused()", "the veil no longer asks whether the stream was stopped on "
                           "purpose before counting. Hiding a tab sends STOP_VIDEO and "
                           "no frames arrive, and reading that quiet as black keeps the "
                           "veil up on a desktop that is working")):
    if _needle not in _veil:
        raise SystemExit("hdw4s-gate-index: %s -- refusing to build" % _why)
# AND THE THIRD OUTCOME MUST STILL EXIST WHERE IT IS PRODUCED. Checked against
# paintedColours() itself rather than against the poller, because the first version of
# this guard looked for the word in the POLLER -- where it also appears -- and passed
# against a red arm that had removed it from the function that produces it. A guard
# pointed at the wrong subject reports health forever; it was caught only because the
# red arm was run.
_pc = re.search(r"function paintedColours\(\)\{(.*?)\n  \}", html, re.S)
if _pc is None:
    raise SystemExit("hdw4s-gate-index: paintedColours() could not be found in the page "
                     "about to be written -- refusing to build, because the guard below "
                     "would otherwise pass by not looking")
if "'waiting'" not in _pc.group(1):
    raise SystemExit(
        "hdw4s-gate-index: paintedColours() no longer separates 'the client has not "
        "made its surface yet' from 'a surface exists and cannot be read'. Collapsing "
        "those into one null makes the veil's fail-open fire on the FIRST tick of every "
        "start, because the client creates its canvas a moment after the module loads. "
        "Measured: the veil flashed for under a second and the visitor got the black "
        "screen anyway, five runs out of five, while every assertion passed -- refusing "
        "to build")

if _veil.index("visibilityState") > _veil.index("paintedColours()"):
    raise SystemExit("hdw4s-gate-index: the starting veil samples the picture before "
                     "asking whether anyone is looking at it. The question has to come "
                     "first or the reading is already about a stopped stream -- "
                     "refusing to build")

# ASKED OF EACH OBJECT SEPARATELY, and that is not tidiness. This used to be one
# boolean over the whole page -- '"/sessions/" in html' -- and there was exactly one
# object that could put that string there. A SECOND one arrived on 2026-09-26 (the
# starting card's "Start another desktop" form), and with two contributors a single
# boolean stops being able to notice either of them going missing: deleting the
# directory link left the form's "/sessions/new" behind and the guard read health.
# Caught by the red arm in tests.sh that deletes __MORE__, which is the only reason
# this is not still one boolean. A guard over a DISJUNCTION cannot see one term.
for _label, _needle in (("link to the session directory", 'href="/sessions/"'),
                        ("form asking for another desktop",
                         'action="/sessions/new"')):
    _offers = _needle in html
    if _offers != (_dir == "yes"):
        raise SystemExit(
            "hdw4s-gate-index: HDW4S_DIRECTORY=%s but the generated page %s %s. "
            "Those addresses are served by hdw4s-demux, the ephemeral "
            "front door; a named desktop's door is systemd-socket-proxyd in front of "
            "Selkies, which answers 404 to them and hands the person a blank page. "
            "Refusing to build a card that promises a page its own door cannot serve."
            % (_dir, "carries" if _offers else "carries no", _label))

open(dst, "w", encoding="utf-8").write(html)
print("hdw4s-gate-index: built %s (deferred %s)" % (dst, src_attr))
