[Unit]
Description=Demultiplexer routing the front door to ephemeral HDW4S sessions
Documentation=man:hdw4s(8)
Requires=hdw4s-demux.socket
After=hdw4s-demux.socket hdw4s-ephemeral-slots.service
# The slot sockets live in a directory that hdw4s-ephemeral-slots creates at
# boot. Ordering after it rather than requiring it: a box with no ephemeral
# slots configured should get a router that says so, not a failed unit.

[Service]
ExecStart=/usr/lib/hdw4s/hdw4s-demux
Type=simple
Restart=on-failure
RestartSec=1s

# Runs as its own account, in the www-data group, because that is what the slot
# sockets are owned by: /run/hdw4s-proxy/<instance>.sock is root:www-data 0660.
# Connecting to one is a filesystem-permission question, and this group
# membership is the whole of the answer -- there is no credential below this
# point and there does not need to be one.
DynamicUser=yes
SupplementaryGroups=www-data

# The front-door credential, and the per-slot credentials for slots that were
# configured with one. Read at start; a live router does not notice a rotation,
# so rotating one means restarting this unit -- the same three-step shape the
# per-session credential already has.
# LoadCredential, not a readable file: systemd opens these AS ROOT before the
# service drops to its dynamic user, then exposes them in $CREDENTIALS_DIRECTORY
# readable by that user alone. Loosening the files to a group instead would make
# every credential on the box readable by anything in www-data, which on this
# machine includes the thing the ephemeral sessions exist to contain.
# The DIRECTORY form does not work here and the failure is opaque: pointing
# LoadCredential= at /etc/hdw4s exits 243 before the service runs, because the
# import refuses the subdirectory in there. Measured on this build, after this
# comment had first asserted the opposite. So credentials are named one file at
# a time.
#
# ONE credential is loaded here: the front door's. This used to go on to say
# "and the slots' in a drop-in written by hdw4s-ephemeral-slots", which was read
# as an inventory of what the router holds and is FALSE -- no such drop-in is
# written anywhere in this package, and the service has no drop-in directory at
# all. Measured 2026-09-22: DropInPaths empty, no .d directory on disk.
#
# The correction matters beyond tidiness, because a reader who believes that
# sentence draws the wrong conclusion about credentials on slots: the router
# holds NO per-slot secret and cannot present one, so a slot configured with its
# own credential answers 401 to everything routed to it, alone, while its
# neighbours work. That is the field failure the startup warning exists for.
#
# No "-" on this one. A front door with no credential must not start.
LoadCredential=demux.auth.cred:/etc/hdw4s/demux.auth.cred
RuntimeDirectory=hdw4s-demux
RuntimeDirectoryMode=0700
# WITHOUT THIS, EVERYTHING THIS DIRECTORY HOLDS IS DELETED AT THE MOMENT IT IS
# NEEDED, and the default is the deleting one. RuntimeDirectory= removes the
# tree when the unit stops unless told otherwise, and a restart is a stop --
# so the three things kept here are all erased by the event they exist for:
#
#   ownership.json       which browser owns which desktop. Lost, every visitor
#                        is cut off from a desktop that goes on running, and it
#                        runs unowned until the idle window ends -- measured on
#                        production when a deploy restarted this service.
#   last-request/<slot>  the router's record of a connection it ACCEPTED, which
#                        the reaper takes as a second witness to idleness. Lost,
#                        every slot reads "no record", which is the same thing a
#                        slot nobody has ever opened reads -- so an operator
#                        setting the idle window from the refusal log cannot tell
#                        a lost record from an idle desktop. Two router-suite
#                        arms were already failing on exactly this before this
#                        line was added; they named the cause and the cause was
#                        this default.
#   reserved/<slot>      a mint held while its session starts. SURVIVING THE
#                        ROUTER'S DEATH IS THE ENTIRE PURPOSE of that file: it
#                        exists so a crash inside the grace window cannot hand a
#                        second visitor a slot the first is still walking to.
#                        Deleted on restart it is strictly worse than useless --
#                        it looks like a guard and refuses nothing.
#
# THE REQUIREMENT IS A PROPERTY, NOT THIS DIRECTIVE, and stating it as the
# directive is how it gets moved back. What the reservation needs of its home is
# exactly this:
#
#   it must outlive the router process, and it must not outlive the boot.
#
# Anything with those two lifetimes will do. This directive is one way to get
# them and not the only one -- a directory created by something that outlives
# the router would also qualify, and was the alternative considered here. It was
# rejected because it needs a second unit to own a directory for a component
# that already has one, and because the ownership of that directory then has to
# be arranged by hand for a DynamicUser= service, which is the part this
# directive does correctly and silently.
#
# "yes" rather than "restart", and the reason is evidence rather than taste.
# "restart" is the narrower grant and would be the better fit on paper, since
# Restart=on-failure above is a restart and a deliberate stop could then clear
# the tree. It is not used because what has actually been measured on this
# estate is "yes": the tree relocates to /run/private/<name> at root:root 0700,
# and the surviving directory PINS THE DYNAMIC UID across a stop and start,
# with a control arm that saw a different uid when preservation was off. Nobody
# has measured "restart", and picking the tidier value on the strength of a
# measurement of a different value is the whole class of error this file keeps
# warning about. Narrow it when somebody measures it.
#
# /run is a tmpfs, so none of this survives a boot, which is correct: these
# records describe a machine that is currently up.
#
# AND THE LESSON THAT COST THE MOST, because the next person will make the same
# move for the same good reasons. The reservation code deliberately refuses
# flock, on the grounds that the kernel releases a lock when the holder dies and
# surviving the holder's death is the entire purpose. That reflex was correctly
# refused -- and then the file was put in a directory that systemd deletes when
# the holder dies, which fails for the IDENTICAL reason one level down. The
# wipe had been measured, in this same round, by people who had read the
# measurement. Refusing the obvious primitive is not the same as checking the
# lifetime of the place you put the result.
RuntimeDirectoryPreserve=yes

# Hardened deliberately rather than maximally. This is a small stdlib HTTP
# router with no desktop behind it, so it tolerates far more than a session
# unit does -- but AF_UNIX is not optional here and neither is AF_INET, which is
# the pairing that makes this component what it is: TCP in, filesystem sockets
# out, and no TCP between any two of our own components.
CapabilityBoundingSet=
NoNewPrivileges=yes
PrivateDevices=yes
PrivateTmp=yes
ProtectClock=yes
ProtectControlGroups=yes
ProtectHome=yes
ProtectHostname=yes
ProtectKernelLogs=yes
ProtectKernelModules=yes
ProtectKernelTunables=yes
ProtectProc=invisible
ProtectSystem=strict
# THE ONE PLACE OUTSIDE ITS OWN RuntimeDirectory= THIS SERVICE MAY WRITE, and
# the write is one empty file whose NAME is a slot. That is the entirety of what
# the router can say about tearing a desktop down: it cannot name a unit, a pid,
# a cgroup or a command, and everything privileged happens in
# hdw4s-teardown@<slot>.service, keyed by the instance name systemd fills in
# rather than by anything written here.
#
# WITHOUT THIS LINE THE WRITE FAILS AND THE FAILURE IS THE GOOD KIND: strict
# makes the whole filesystem read-only except the runtime directory, so the
# router would answer a visitor "this machine could not take that request" and
# log the errno, rather than reporting success and ending nothing. That is the
# right way round, and it is why the console reports the error instead of
# assuming the write worked.
ReadWritePaths=/run/hdw4s-teardown
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
MemoryDenyWriteExecute=yes
LockPersonality=yes

# No [Install] section, deliberately. This service is started by its socket and
# by nothing else, so there is nothing to enable: enabling it would start a
# second router at boot competing for the same port. The absence is load
# bearing -- the suite derives "which units must be enabled" from exactly this
# section, so adding one here would silently require an enable line that must
# not exist.
