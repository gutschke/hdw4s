[Unit]
Description=Front door for the HDW4S session %i
Documentation=man:hdw4s(8)

[Socket]
# Every session is reached through this socket, whichever transport it uses.
# The address is not set here: "hdw4s enable" writes it into a drop-in, because
# it depends on the port the session was allocated and on whether the reverse
# proxy reaches it over the network or over the filesystem.
#
# Owning the address here rather than in the session is what lets a session
# exist only while someone is using it. Nothing is started at boot; the first
# connection brings the desktop up, and a desktop that has been stopped for
# being idle comes back the same way, so stopping one costs the user nothing
# but the time it takes to start.
#
# A socket unit with no Listen setting is refused at parse time, and a drop-in
# cannot rescue a unit that will not load -- so the filesystem socket is the
# default here, and "hdw4s transport ... tcp" replaces it with an empty
# ListenStream= followed by the port. Nothing binds this path when it does.
#
# An EPHEMERAL instance never takes that branch: "hdw4s transport" refuses tcp
# for one, so the line below is the address every ephemeral slot is reached at.
# That is not a hardening option, it is the shape -- nothing outside the machine
# addresses an ephemeral session, so a port would serve no caller it has and
# every caller it must not have.
ListenStream=/run/hdw4s-proxy/%i.sock
# RETRACTION, and it is the defect this file caused. Three lines used to stand here:
#
#     RuntimeDirectoryPreserve=yes
#     RuntimeDirectory=hdw4s-proxy
#     RuntimeDirectoryMode=0755
#
# with a comment explaining that they kept the shared parent directory alive across
# one instance stopping. NONE OF IT DID ANYTHING. RuntimeDirectory= is a systemd.exec
# setting: it is applied while building an execution environment for a command, and a
# socket unit with no Exec= line never builds one. Measured on systemd 255, with a
# service carrying the same directive as the positive control -- the service got its
# directory, this unit never got one.
#
# What created /run/hdw4s-proxy was the ListenStream= below it, binding a socket
# INSIDE the directory: measured again with the directive deleted outright, and the
# directory still appeared. The directive was being credited with work the bind was
# doing, which is why nobody questioned it for as long as every deployment was on the
# filesystem transport.
#
# The consequence is the sentence four lines down, which was written here and never
# followed through: "hdw4s transport ... tcp" replaces this bind with a port, and
# NOTHING then creates the directory. The session unit hides it with
# InaccessiblePaths=, which is fatal when the path is absent, so every ephemeral
# session on a TCP deployment dies 226/NAMESPACE after the first reboot -- naming a
# directory, and pointing at neither this unit nor anything that failed.
#
# The directory is now made by hdw4s-ephemeral-slots, at boot, beside the four it
# already made. Stopping a unit does not remove it: measured both with and without
# the old directive, before and after stop, and it survived every time -- so the
# hazard the deleted comment described is not one this shape has.
# RemoveOnStop= below takes care of the one socket that really is per-instance, and
# that one is real: it is the bound socket file, not a directory.
SocketMode=0660
RemoveOnStop=yes
# A desktop takes a while to come up, and the browser reconnects on its own, so
# there is no need to hold the first connection open waiting for it.
Accept=no

[Install]
WantedBy=sockets.target
