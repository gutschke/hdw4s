# BASE is what moves between slots. Pinning the top rather than the lift is the
# repair for a version of this that varied the lift and reached L* 49.3, which
# private/redarm-background-band.py caught by rasterising and measuring.
TOP_L = 48.5

# The highest lightness any stop colour may be SPECIFIED at, as an input bound.
# Slack above TOP_L, because compositing can only darken here -- every blob
