# So the sweep was optimising hue separation while the thing hue separation
# stands for -- still reading as Ubuntu -- got worse, and no amount of the
# metric would have said so. 102 degrees is the widest that still looks like the
# brand to me; the owner is the judge of "physiologically feels related", so the
# span is offered to him rather than settled here.
COOL_EXTENSION = 26.9                # degrees past the bluest published aubergine
ARC_LO = swatch("Light aubergine")[2] - COOL_EXTENSION      # ~321.9
ARC_HI = swatch("Ubuntu Orange")[2] + 360.0                 # ~406.0
RUNGS = 8                            # distinct rungs on the arc
STRIDE = 3                           # coprime with RUNGS: consecutive slots
                                     # land three rungs apart, not one

# HOW DARK THE WHOLE FIELD IS, on a ladder of its own. WHITE AND BLACK ARE IN
