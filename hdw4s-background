# two desktops that look the same.
WEIGHTS = 5


def arc(t):
    """A hue at fractional position t along the brand arc, wrapped to 0-360."""
    return (ARC_LO + (ARC_HI - ARC_LO) * (t % 1.0)) % 360.0


