ARC_LO = None
ARC_HI = None


def arc_ends():
    """(cool end, warm end) of the arc in degrees, warm end unwrapped past 360
    so that the interval is increasing. Today about 296.0 .. 406.0."""
    lo = (swatch("Light aubergine")[2] - COOL_EXTENSION
          if ARC_LO is None else ARC_LO)
    hi = (swatch("Ubuntu Orange")[2] + 360.0 + WARM_EXTENSION
          if ARC_HI is None else ARC_HI)
    return lo, hi


