# Settings every ephemeral session starts from. Package-owned: edit the file,
# run "dconf update", and the next session reads the compiled database.
#
# The 50-template layer sits above this one and is NOT generated yet. Its
# position is reserved deliberately: a session that resets a key falls back to
# the administrator's template rather than to stock GNOME, and that only works
# if the template is a layer rather than a seeded copy of the user database.
# Do not renumber these files to close the gap.

# ---- the session cannot be locked, because nobody can unlock it ------------
# There is no password to type: the session has no PAM, and the account has no
# usable one. A locked screen here is a session that has to be killed by an
# administrator, and the user cannot tell that from a hung desktop.
[org/gnome/desktop/screensaver]
lock-enabled=false
idle-activation-enabled=false

[org/gnome/desktop/session]
idle-delay=uint32 0

# ---- the screen must not sleep, because nothing can wake it ----------------
# A remote desktop has no keyboard attached to the machine running it. When the
# power plugin blanks or suspends the display, the stream stops updating and the
# visitor has no input that reaches the thing that would wake it: they see a
# frozen picture and cannot tell it from a crash.
#
# THIS IS HERE RATHER THAN IN A RUNTIME WRITE because the write is not reliable.
# hdw4s-run-session sets it at session start, and that write reports success
# whether or not it happened -- measured. This key was its ONLY mechanism, so a
# settings bus that was not answering left a desktop that would freeze with
# nothing anywhere going red. The two keys above it were already here and were
# therefore never at risk; this one was.
#
# Markus, 2026-09-24, on why this is not the policy we refuse to enforce: "this
# is exactly the thing that is required for technical reasons and thus doesn't
# fall under our 'no policy, only tools' ruling." NOT LOCKED, deliberately -- a
# default delivers it, and a visitor who wants their screen to sleep may still
# say so.
[org/gnome/settings-daemon/plugins/power]
sleep-inactive-ac-type='nothing'

# ---- nothing follows the user out of the session ---------------------------
# All of this would otherwise be written into a profile that is destroyed
# anyway, so the point is not storage: it is that a fresh session must not
# inherit a previous occupant's traces through a service that outlives it.
[org/gnome/desktop/privacy]
remember-recent-files=false
remember-app-usage=false
report-technical-problems=false
send-software-usage-stats=false

[org/gnome/desktop/search-providers]
disable-external=true

# ---- the indexer ----------------------------------------------------------
# This is the dconf half only. The autostart entry is a different mechanism and
# is handled per-profile by hdw4s-session; believing a key here disables a
# .desktop file is a mistake this project has already made once.
[org/freedesktop/Tracker3/Miner/Files]
enable-monitors=false
index-recursive-directories=@as []
index-single-directories=@as []

# The visual cue that this session keeps nothing is NOT here: the colour is an
# administrator's choice, so hdw4s-ephemeral-slots generates it into
# 20-background from HDW4S_EPHEMERAL_BACKGROUND. The lock file beside this one
# still names every background key, because gnome-control-center rewrites all of
# them together when a stock wallpaper is picked.

[org/gnome/desktop/interface]
enable-hot-corners=false
